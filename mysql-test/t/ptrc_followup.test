--echo # PTRC commercial follow-up crash regressions

--source include/elide_costs.inc

let $elide_ptrc_analyze = /[(]cost=[0-9.e+-]+ rows=[0-9.e+-]+[)]/(...)/ /[(]actual time=[0-9.e+-]+ rows/(actual rows/ /Cache Hits: [0-9]+/Cache Hits: #/ /Cache Misses: [0-9]+/Cache Misses: #/ /Cache Evictions: [0-9]+/Cache Evictions: #/ /Cache Overflows: [0-9]+/Cache Overflows: #/ /Memory Usage: [0-9]+/Memory Usage: #/;

SET @saved_optimizer_switch=@@optimizer_switch;
SET @saved_ptrc_cost_threshold=@@rds_partial_result_cache_cost_threshold;
SET optimizer_switch='partial_result_cache=on,hash_join=off,batched_key_access=off,semijoin=off,materialization=off';
SET rds_partial_result_cache_cost_threshold=0;

--echo # BUGFIX: TABLE::in_use may be null while building PTRC key tables.
CREATE TABLE ptrc_fu_t1 (a SMALLINT) ENGINE=InnoDB;
CREATE TABLE ptrc_fu_t2 (a SMALLINT) ENGINE=InnoDB;
SELECT col2
FROM (SELECT a AS col2 FROM ptrc_fu_t2 GROUP BY a) AS b
WHERE b.col2 = ALL (SELECT a FROM ptrc_fu_t1);
PREPARE stmt0 FROM
'SELECT col2 FROM (SELECT a AS col2 FROM ptrc_fu_t2 GROUP BY a) AS b WHERE b.col2 = ALL (SELECT a FROM ptrc_fu_t1)';
EXECUTE stmt0;
DEALLOCATE PREPARE stmt0;
DROP TABLE ptrc_fu_t1, ptrc_fu_t2;

--echo # BUGFIX: eliminated LEFT JOIN table must not be used as a PTRC cache key.
CREATE TABLE ptrc_fu_lj_t1 (medal_now INT) ENGINE=InnoDB;
CREATE TABLE ptrc_fu_lj_t2 (id INT) ENGINE=InnoDB;
CREATE TABLE ptrc_fu_lj_t3 (medal_now INT) ENGINE=InnoDB;
INSERT INTO ptrc_fu_lj_t1 VALUES (1);
INSERT INTO ptrc_fu_lj_t2 VALUES (1), (2), (3);
INSERT INTO ptrc_fu_lj_t3 VALUES (1), (2), (NULL);
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=TREE
SELECT DISTINCT
       (CASE WHEN EXISTS (SELECT ref_49.medal_now FROM ptrc_fu_lj_t1)
             THEN 1 ELSE 0 END) IS NULL
FROM ptrc_fu_lj_t2
LEFT JOIN ptrc_fu_lj_t3 AS ref_49 ON TRUE;
SELECT DISTINCT
       (CASE WHEN EXISTS (SELECT ref_49.medal_now FROM ptrc_fu_lj_t1)
             THEN 1 ELSE 0 END) IS NULL
FROM ptrc_fu_lj_t2
LEFT JOIN ptrc_fu_lj_t3 AS ref_49 ON TRUE;
DROP TABLE ptrc_fu_lj_t1, ptrc_fu_lj_t2, ptrc_fu_lj_t3;

--echo # BUGFIX: const-table PTRC keys must use initialized NULL flags.
CREATE TABLE ptrc_fu_ct_t1 (
  id INT PRIMARY KEY AUTO_INCREMENT,
  taskid INT NOT NULL,
  dbid INT NOT NULL,
  create_date DATETIME NOT NULL,
  KEY(taskid, dbid)
) ENGINE=InnoDB;
CREATE TABLE ptrc_fu_ct_t2 (
  db_id INT PRIMARY KEY,
  name VARCHAR(40) NOT NULL,
  primary_uid INT NOT NULL,
  KEY(primary_uid)
) ENGINE=InnoDB;
CREATE TABLE ptrc_fu_ct_t3 (
  taskgenid INT PRIMARY KEY AUTO_INCREMENT,
  dbid INT NOT NULL,
  taskid INT NOT NULL,
  how_often INT NOT NULL
) ENGINE=InnoDB;
CREATE TABLE ptrc_fu_ct_t4 (
  task_id INT NOT NULL,
  description VARCHAR(40) NOT NULL
) ENGINE=InnoDB;
INSERT INTO ptrc_fu_ct_t1 (id, taskid, dbid, create_date) VALUES
  (1, 1, 15, '2003-09-29 10:31:36'),
  (2, 1, 21, '2003-09-29 10:31:36');
INSERT INTO ptrc_fu_ct_t2 VALUES
  (18, 'Not Set 1', 0), (19, 'Valid', 1), (20, 'Valid 2', 1),
  (21, 'Should Not Return', 1), (26, 'Not Set 2', 0), (-1, 'All DB', 0);
INSERT INTO ptrc_fu_ct_t3 (taskgenid, dbid, taskid, how_often) VALUES
  (1, -1, 1, 1);
INSERT INTO ptrc_fu_ct_t4 VALUES (1, 'Daily Check List'), (2, 'Weekly Status');
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=TREE
SELECT a.dbid, b.name,
       CAST('2003-09-28' AS DATE) >=
       IFNULL((SELECT /*+ PRC_SUBQUERY() */ DATE(MAX(c.create_date))
               FROM ptrc_fu_ct_t1 AS c
               WHERE c.dbid = b.db_id AND c.taskid = a.taskgenid),
              CAST('1950-01-01' AS DATE)) AS due
FROM ptrc_fu_ct_t3 AS a
JOIN ptrc_fu_ct_t2 AS b
JOIN ptrc_fu_ct_t4 AS d
WHERE a.dbid = -1 AND b.primary_uid = 1 AND d.task_id = a.taskid
      AND a.taskgenid = 1
ORDER BY b.name;
SELECT a.dbid, b.name,
       CAST('2003-09-28' AS DATE) >=
       IFNULL((SELECT /*+ PRC_SUBQUERY() */ DATE(MAX(c.create_date))
               FROM ptrc_fu_ct_t1 AS c
               WHERE c.dbid = b.db_id AND c.taskid = a.taskgenid),
              CAST('1950-01-01' AS DATE)) AS due
FROM ptrc_fu_ct_t3 AS a
JOIN ptrc_fu_ct_t2 AS b
JOIN ptrc_fu_ct_t4 AS d
WHERE a.dbid = -1 AND b.primary_uid = 1 AND d.task_id = a.taskid
      AND a.taskgenid = 1
ORDER BY b.name;
DROP TABLE ptrc_fu_ct_t1, ptrc_fu_ct_t2, ptrc_fu_ct_t3, ptrc_fu_ct_t4;

--echo # BUGFIX: QEP_shared::m_position may be unavailable during PTRC costing.
CREATE TABLE ptrc_fu_pos_t0 (
  c1 BIT(1) NOT NULL,
  PRIMARY KEY (c1)
) ENGINE=InnoDB;
SET rds_partial_result_cache_cost_threshold=0.01;
--replace_regex $elide_ptrc_analyze
EXPLAIN ANALYZE FORMAT=TREE
SELECT c1 AS c10
FROM ptrc_fu_pos_t0 t1
WHERE c1 NOT IN (((SELECT c1 AS c11
                   FROM ptrc_fu_pos_t0 t2) IN (t1.c1 IS NULL))
                 IN (SELECT c1 AS c12
                     FROM ptrc_fu_pos_t0 t3));
SET rds_partial_result_cache_cost_threshold=0;
--replace_regex $elide_ptrc_analyze
EXPLAIN ANALYZE FORMAT=TREE
SELECT c1 AS c10
FROM ptrc_fu_pos_t0 t1
WHERE c1 NOT IN (((SELECT c1 AS c11
                   FROM ptrc_fu_pos_t0 t2) IN (t1.c1 IS NULL))
                 IN (SELECT c1 AS c12
                     FROM ptrc_fu_pos_t0 t3));
DROP TABLE ptrc_fu_pos_t0;

SET optimizer_switch=@saved_optimizer_switch;
SET rds_partial_result_cache_cost_threshold=@saved_ptrc_cost_threshold;
