#
# Test for upgrading, whether rds_comment will be created after upgrade.
#

call mtr.add_suppression("Table 'mysql.dstore_ddl_log' requires repair.");
call mtr.add_suppression("Table 'mysql.dstore_ddl_log' repair failed.");

-- source include/no_valgrind_without_big.inc
-- source include/mysql_upgrade_preparation.inc

DROP TABLE mysql.rds_comment;
USE mysql;
SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'rds_comment';

--let $restart_parameters = restart: --upgrade=FORCE
--let $wait_counter= 10000
--source include/restart_mysqld.inc

SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'rds_comment';

--source include/mysql_upgrade_cleanup.inc
