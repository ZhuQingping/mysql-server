--echo # PTRC optimizer hint parser smoke tests

SELECT @@optimizer_switch LIKE '%partial_result_cache=on%' AS ptrc_default_on;

EXPLAIN SELECT /*+ PRC_JOIN() */ 1;
EXPLAIN SELECT /*+ NO_PRC_JOIN() */ 1;
EXPLAIN SELECT /*+ PRC_SUBQUERY() */ 1;
EXPLAIN SELECT /*+ NO_PRC_SUBQUERY() */ 1;

--echo # Commercial names are PRC_*; PTRC is not an alias.
EXPLAIN SELECT /*+ PTRC() */ 1;
