(6,  '26', '20260110', '20260110154530', '20260110154530', '154530'),
(7,  2026, '2026.01.11', '2026.01.11 01:01:01', '2026.01.11 01:01:01', '01:01:01'),
(8,  2026, '2026/01/12', '2026/01/12 02:02:02', '2026-01-12 02:02:02', '02:02:02'),
(9,  2026, '2026-1-1', '2026-01-01 03:04:05', '2026-01-01 03:04:05', '03:04:05'),
(10, 2025, 20251231, 20251231235959, 20251231235959, '23:59:59'),
(11, '99', '19991231', '1999-12-31 11:11:11', '1999-12-31 11:11:11', '11:11:11'),
(12, '70', 700101, '1970-01-01 08:00:01', '1970-01-01 08:00:01', '08:00:01'),
(13, 2026, '2026@01@13', '2026-01-08 10:30:00', '2026-01-08 10:30:00', '10:30:00'),
(14, 2024, 20240229, 20240229120000, 20240229120000, '12:00:00'),
