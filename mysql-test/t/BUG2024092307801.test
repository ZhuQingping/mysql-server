# Create initial procedures

CREATE PROCEDURE p1(INOUT i1 INT)
BEGIN
END;

CREATE PROCEDURE p2()
BEGIN
END;

# Prepare statements with correct number of args
# Drop procedures

PREPARE stmt FROM 'CALL p1(?)';
DROP PROCEDURE p1;

PREPARE stmt2 FROM 'CALL p2()';
DROP PROCEDURE p2;

# Create procedures with different number of par

CREATE PROCEDURE p1 (OUT i1 INT, INOUT i2 INT)
BEGIN
END;

CREATE PROCEDURE p2 (OUT i1 INT)
BEGIN
END;

# Execute prepared stmts

SET @a = 1;
--error ER_SP_WRONG_NO_OF_ARGS
EXECUTE stmt USING @a;

--error ER_SP_WRONG_NO_OF_ARGS
EXECUTE stmt2;

# Clean up

DROP PROCEDURE p1;
DROP PROCEDURE p2;
DEALLOCATE PREPARE stmt;
DEALLOCATE PREPARE stmt2;
