--echo # Phase 5P: PFS memory tracking for session plan cache

CREATE TABLE pc5p_t (id INT PRIMARY KEY, c INT) ENGINE=InnoDB;
INSERT INTO pc5p_t VALUES (1, 10), (2, 20);

SET SESSION rds_plan_cache=ON;

SELECT THREAD_ID INTO @pc_thread_id
  FROM performance_schema.threads
  WHERE PROCESSLIST_ID = CONNECTION_ID();
SET @pc_event_name = 'memory/sql/plan_cache_mem_root';

SELECT COUNT(*) = 1 AS plan_cache_memory_instrument_exists
  FROM performance_schema.setup_instruments
  WHERE NAME = @pc_event_name AND DOCUMENTATION IS NOT NULL;

SELECT COALESCE(
    (SELECT CURRENT_NUMBER_OF_BYTES_USED = 0
       FROM performance_schema.memory_summary_by_thread_by_event_name
       WHERE THREAD_ID = @pc_thread_id AND EVENT_NAME = @pc_event_name),
    1) AS initial_plan_cache_memory_zero;

SELECT VARIABLE_VALUE + 0 INTO @pc_hits_before
  FROM performance_schema.session_status
  WHERE VARIABLE_NAME = 'Cached_plan_hits';

PREPARE stmt FROM 'SELECT c FROM pc5p_t WHERE id = ?';
SET @id = 1;
EXECUTE stmt USING @id;

SELECT
    (SELECT VARIABLE_VALUE + 0
       FROM performance_schema.session_status
       WHERE VARIABLE_NAME = 'Cached_plan_count') = 1
  AS cached_plan_count_after_first_execute;

SELECT COALESCE(
    (SELECT COUNT_ALLOC > COUNT_FREE
            AND CURRENT_NUMBER_OF_BYTES_USED > 0
       FROM performance_schema.memory_summary_by_thread_by_event_name
       WHERE THREAD_ID = @pc_thread_id AND EVENT_NAME = @pc_event_name),
    0) AS cached_plan_memory_allocated;

SET @id = 2;
EXECUTE stmt USING @id;

SELECT
    (SELECT VARIABLE_VALUE + 0
       FROM performance_schema.session_status
       WHERE VARIABLE_NAME = 'Cached_plan_hits') = @pc_hits_before + 1
  AS cached_plan_hit_delta;

DEALLOCATE PREPARE stmt;

SELECT
    (SELECT VARIABLE_VALUE + 0
       FROM performance_schema.session_status
       WHERE VARIABLE_NAME = 'Cached_plan_count') = 0
  AS cached_plan_count_after_deallocate;

SELECT COALESCE(
    (SELECT COUNT_ALLOC = COUNT_FREE
            AND SUM_NUMBER_OF_BYTES_ALLOC = SUM_NUMBER_OF_BYTES_FREE
            AND CURRENT_NUMBER_OF_BYTES_USED = 0
       FROM performance_schema.memory_summary_by_thread_by_event_name
       WHERE THREAD_ID = @pc_thread_id AND EVENT_NAME = @pc_event_name),
    0) AS cached_plan_memory_released;

DROP TABLE pc5p_t;
