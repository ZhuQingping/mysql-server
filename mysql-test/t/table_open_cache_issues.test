--echo #
--echo # BUG2025082924708: ASAN: HEAP-USE-AFTER-FREE IN Item_default_value::bind_fields ON FIRST EXECUTION
--echo #
CREATE TABLE t1 (
  id int NOT NULL,
  bigint_field bigint DEFAULT NULL
);

PREPARE stmt0 FROM 'SELECT DEFAULT(bigint_field) FROM t1';
EXECUTE stmt0;
EXECUTE stmt0;
EXECUTE stmt0;
DEALLOCATE PREPARE stmt0;
DROP TABLE t1;

CREATE TABLE t (a INT,
b INT,
c INT DEFAULT 77,
d INT GENERATED ALWAYS AS (DEFAULT(c)));
INSERT INTO t VALUES(1,2,3,DEFAULT);
prepare stmt0 from "INSERT INTO t VALUES(?,?,?,DEFAULT(c))";
set @a = 1;
set @b = 2;
set @c = 3;
execute stmt0 using @a, @b, @c;
execute stmt0 using @a, @b, @c;
SELECT * FROM t;
DEALLOCATE PREPARE stmt0;

prepare stmt0 from "INSERT INTO t VALUES(?,?,?,DEFAULT)";
set @a = 1;
set @b = 2;
set @c = 3;
execute stmt0 using @a, @b, @c;
execute stmt0 using @a, @b, @c;
SELECT * FROM t;
DEALLOCATE PREPARE stmt0;

DROP TABLE t;

--echo #
--echo # BUG2025070819695: Crash in function get_secondary_engine_handlerton
--echo #
CREATE TABLE t1(a INT, b VARCHAR(100));
CREATE TABLE t3(a INT, b VARCHAR(100));
INSERT INTO t1 VALUES(1,'HuaWei');
INSERT INTO t3 VALUES(2,'Dstore');
--error ER_NO_SUCH_TABLE
DELETE t3 FROM t1 JOIN t2, t3 WHERE t3.b<='mh';
DROP TABLE t1,t3;
