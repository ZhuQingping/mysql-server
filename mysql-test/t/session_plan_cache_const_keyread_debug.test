--source include/have_debug.inc

--echo # Phase 5S: cached const-table reads preserve covering key-read

CREATE TABLE pc5s_keyread (
  id INT NOT NULL,
  c INT NOT NULL,
  pad VARCHAR(64),
  PRIMARY KEY (id),
  UNIQUE KEY c_uq (c)
) ENGINE=InnoDB;

INSERT INTO pc5s_keyread VALUES
  (1, 10, 'ten'),
  (2, 20, 'twenty'),
  (3, 30, 'thirty'),
  (4, 40, 'forty');

SET SESSION rds_plan_cache=ON;

--echo # The optimizer reports a const covering-index read.
EXPLAIN SELECT c FROM pc5s_keyread FORCE INDEX (c_uq) WHERE c = 20;

SHOW STATUS LIKE 'Cached_plan_count';
SHOW STATUS LIKE 'Cached_plan_hits';

PREPARE stmt FROM
  'SELECT c FROM pc5s_keyread FORCE INDEX (c_uq) WHERE c = ?';

SET @c=20;
EXECUTE stmt USING @c;

SHOW STATUS LIKE 'Cached_plan_count';
SHOW STATUS LIKE 'Cached_plan_hits';

--echo # Cached const-table apply must enable key-read before read_const().
SET SESSION debug='+d,plan_cache_require_const_keyread';

SET @c=30;
EXECUTE stmt USING @c;

SET @c=40;
EXECUTE stmt USING @c;

SET SESSION debug='-d,plan_cache_require_const_keyread';

SHOW STATUS LIKE 'Cached_plan_count';
SHOW STATUS LIKE 'Cached_plan_hits';

DEALLOCATE PREPARE stmt;

SHOW STATUS LIKE 'Cached_plan_count';
SHOW STATUS LIKE 'Cached_plan_hits';

DROP TABLE pc5s_keyread;
