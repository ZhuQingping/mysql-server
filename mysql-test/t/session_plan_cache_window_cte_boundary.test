--echo # Phase 5H: window and CTE/change-list fallback boundaries

CREATE TABLE pc5h_window (
  id INT PRIMARY KEY,
  sex CHAR(1),
  created_at DATE,
  score INT,
  KEY score_idx(score),
  KEY created_idx(created_at, id),
  KEY sex_created_idx(sex, created_at, id)
) ENGINE=InnoDB;
INSERT INTO pc5h_window VALUES
  (1, 'M', '2020-01-02', 10),
  (2, 'F', '2020-01-01', 20),
  (3, 'M', '2020-01-01', 30),
  (4, 'F', '2020-01-03', 40);

CREATE TABLE pc5h_cte_a (
  text_col VARCHAR(16),
  enum_col ENUM('i','iii2','2020','NULL'),
  blob_col BLOB,
  bool_col BOOL
) ENGINE=InnoDB;
CREATE TABLE pc5h_cte_b (
  text_col VARCHAR(16),
  decimal_col DECIMAL(10,2),
  datetime_col DATETIME
) ENGINE=InnoDB;
CREATE TABLE pc5h_cte_c (
  text_col VARCHAR(16),
  float_col FLOAT
) ENGINE=InnoDB;

INSERT INTO pc5h_cte_a VALUES
  ('a', 'i', 'a', 0),
  ('i', 'iii2', 'iii2', 1),
  ('iii2', '2020', 'iiiiiiiiii1', 0),
  ('z', 'NULL', 'z', 1);
INSERT INTO pc5h_cte_b VALUES
  ('a', 1.10, '2020-01-01 00:00:00'),
  ('i', 2.20, '2020-01-02 00:00:00'),
  ('iii2', 3.30, '2020-01-03 00:00:00'),
  ('z', 4.40, '2020-01-04 00:00:00');
INSERT INTO pc5h_cte_c VALUES
  ('m', 1.5),
  ('zz', NULL);

SET @old_rds_plan_cache=@@SESSION.rds_plan_cache;
SET SESSION rds_plan_cache=ON;

--echo # Window ORDER BY and top-level ORDER BY stay on the fallback path
FLUSH STATUS;
PREPARE win_stmt FROM
  'SELECT sex, created_at, id, id - LAG(id) OVER (ORDER BY created_at, id) AS delta_id
     FROM pc5h_window
    WHERE score >= ?
    ORDER BY sex, created_at, id';

SET @min_score=10;
EXECUTE win_stmt USING @min_score;
EXECUTE win_stmt USING @min_score;
EXECUTE win_stmt USING @min_score;

SHOW STATUS LIKE 'Cached_plan_count';
SHOW STATUS LIKE 'Cached_plan_hits';
let $pc_count= query_get_value(SHOW STATUS LIKE 'Cached_plan_count', Value, 1);
if ($pc_count != 0) {
  --die window fallback leaked a READY cached plan
}
let $pc_hits= query_get_value(SHOW STATUS LIKE 'Cached_plan_hits', Value, 1);
if ($pc_hits != 0) {
  --die window fallback produced cached hits
}
DEALLOCATE PREPARE win_stmt;

--echo # CTE and THD change-list-heavy shapes stay on the fallback path
FLUSH STATUS;
PREPARE cte_stmt FROM
  'WITH cte1 AS (
      SELECT text_col FROM pc5h_cte_a
       WHERE enum_col NOT BETWEEN NULL AND ?
          OR blob_col IN (?, NULL, ''a'', ''iiiiiiiiii1'')
          XOR bool_col <> ?
    ),
    cte2 AS (
      SELECT cte1.text_col, b.decimal_col, COUNT(b.datetime_col)
        FROM cte1 LEFT JOIN pc5h_cte_b b ON cte1.text_col = b.text_col
       WHERE cte1.text_col < ANY (
         WITH cte3 AS (
           SELECT text_col FROM pc5h_cte_c WHERE float_col IS NOT UNKNOWN
         )
         SELECT text_col FROM cte3)
       GROUP BY 1,2 ORDER BY 1,2,3
    )
    SELECT * FROM cte2 ORDER BY 1,3,2';

SET @enum_param='iii2';
SET @blob_param='a';
SET @bool_param='2020';
EXECUTE cte_stmt USING @enum_param, @blob_param, @bool_param;

SET @enum_param='i';
SET @blob_param='iii2';
SET @bool_param='NULL';
EXECUTE cte_stmt USING @enum_param, @blob_param, @bool_param;

SET @enum_param='NULL';
SET @blob_param='a';
SET @bool_param='1901';
EXECUTE cte_stmt USING @enum_param, @blob_param, @bool_param;

SET @enum_param='iii2';
SET @blob_param='a';
SET @bool_param='2020';
EXECUTE cte_stmt USING @enum_param, @blob_param, @bool_param;

SET @enum_param='i';
SET @blob_param='iii2';
SET @bool_param='NULL';
EXECUTE cte_stmt USING @enum_param, @blob_param, @bool_param;

SET @enum_param='NULL';
SET @blob_param='a';
SET @bool_param='1901';
EXECUTE cte_stmt USING @enum_param, @blob_param, @bool_param;

SHOW STATUS LIKE 'Cached_plan_count';
SHOW STATUS LIKE 'Cached_plan_hits';
let $pc_count= query_get_value(SHOW STATUS LIKE 'Cached_plan_count', Value, 1);
if ($pc_count != 0) {
  --die CTE fallback leaked a READY cached plan
}
let $pc_hits= query_get_value(SHOW STATUS LIKE 'Cached_plan_hits', Value, 1);
if ($pc_hits != 0) {
  --die CTE fallback produced cached hits
}
DEALLOCATE PREPARE cte_stmt;

SET SESSION rds_plan_cache=@old_rds_plan_cache;
DROP TABLE pc5h_cte_c;
DROP TABLE pc5h_cte_b;
DROP TABLE pc5h_cte_a;
DROP TABLE pc5h_window;
