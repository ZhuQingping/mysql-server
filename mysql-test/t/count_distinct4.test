EXPLAIN SELECT COUNT(*), COUNT(DISTINCT 1) FROM t1;
SELECT COUNT(*), COUNT(DISTINCT 1) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(*), COUNT(DISTINCT NULL) FROM t1;
SELECT COUNT(*), COUNT(DISTINCT NULL) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT DISTINCT 1, COUNT(DISTINCT c1) FROM t1;
SELECT DISTINCT 1, COUNT(DISTINCT c1) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT DISTINCT(c1),COUNT(DISTINCT c2)  FROM t1 GROUP BY c1;
SELECT DISTINCT(c1),COUNT(DISTINCT c2)  FROM t1 GROUP BY c1;

