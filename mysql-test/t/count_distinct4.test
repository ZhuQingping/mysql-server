--source include/elide_costs.inc

SET @saved_pq_support_features_switch = @@pq_support_features_switch;

show variables like '%pq_support_features_switch%';
SET pq_support_features_switch = 'count_distinct=on';
show variables like '%pq_support_features_switch%';

--echo # case1: COUNT(DISTINCT) includes a field

CREATE TABLE t1 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(50),
    age INT,
    class VARCHAR(50)
);
INSERT INTO t1 (name, age, class) VALUES 
('Alice', 30, '1'),
('Bob', 25, '1'),
('Charlie', 35, '2'),
('David', 40, '1'),
('Alice', 30, '1'),
('Frank', 29, '1'),
('Grace', 33, '2'),
('Hank', 45, '1'),
('Ivy', 27, '2'),
('John', 38, '1'),
('Alice', 30, '1');

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age) FROM t1;
SELECT COUNT(DISTINCT age) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT name) FROM t1;
SELECT COUNT(DISTINCT name) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT class) FROM t1;
SELECT COUNT(DISTINCT class) FROM t1;

--echo # case2: COUNT(DISTINCT) includes multiple fields

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age, name) FROM t1;
SELECT COUNT(DISTINCT age, name) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age, name, class) FROM t1;
SELECT COUNT(DISTINCT age, name, class) FROM t1;

--echo # case3: The parameter of COUNT(DISTINCT) is a constant.

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT 1) FROM t1;
SELECT COUNT(DISTINCT 1) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT 0) FROM t1;
SELECT COUNT(DISTINCT 0) FROM t1;

--echo # case4: The parameter of COUNT(DISTINCT) is a NULL value.

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT NULL) FROM t1;
SELECT COUNT(DISTINCT NULL) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT 1, NULL) FROM t1;
SELECT COUNT(DISTINCT 1, NULL) FROM t1;

DROP TABLE t1;

--echo # case5: The parameter of COUNT(DISTINCT) has multiple data types.

CREATE TABLE t1 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    -- Integer types
    tinyint_col TINYINT,
    smallint_col SMALLINT,
    mediumint_col MEDIUMINT,
    int_col INT,
    bigint_col BIGINT,
    
    -- Floating-point types
    float_col FLOAT(10,2),
    double_col DOUBLE(16,2),
    decimal_col DECIMAL(10,2),
    
    -- String types
    char_col CHAR(10),
    varchar_col VARCHAR(100),
    text_col TEXT,
    tinytext_col TINYTEXT,
    mediumtext_col MEDIUMTEXT,
    longtext_col LONGTEXT,
    
    -- Date and time types
    date_col DATE,
    time_col TIME,
    datetime_col DATETIME,
    timestamp_col TIMESTAMP,
    year_col YEAR,
    
    -- Binary string types
    binary_col BINARY(10),
    varbinary_col VARBINARY(100),
    blob_col BLOB,
    tinyblob_col TINYBLOB,
    mediumblob_col MEDIUMBLOB,
    longblob_col LONGBLOB
);

