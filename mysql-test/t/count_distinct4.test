--echo # case23: temporary table parameters

CREATE TABLE t1 (a INT);
--delimiter |
CREATE PROCEDURE InsertNumbers()
BEGIN
  DECLARE i INT DEFAULT 1;
  WHILE i <= 1000 DO
    INSERT INTO t1 (a) VALUES (i);
    SET i = i + 1;
  END WHILE;
END|
--delimiter ;

CALL InsertNumbers();

SELECT /*+ SET_VAR(tmp_table_size=1024) */ COUNT(DISTINCT a) FROM t1;

DROP PROCEDURE InsertNumbers;
DROP TABLE t1;

