EXPLAIN SELECT COUNT(DISTINCT c1) FROM t1;
SELECT COUNT(DISTINCT c1) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT c2) FROM t1;
