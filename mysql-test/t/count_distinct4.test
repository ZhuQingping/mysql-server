--echo # case6: The parameter of COUNT(DISTINCT) is a function.

CREATE TABLE t1 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    c1 INT,
    c2 INT,
    c3 TINYINT
);
INSERT INTO t1 (c1, c2, c3) VALUES 
(10, 100, 10),
(10, 100, 10),
(30, 300, 3),
(100, 10, 10),
(50, 500, 5);

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT 1+2) FROM t1;
SELECT COUNT(DISTINCT 1+2) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT c1+c2) FROM t1;
SELECT COUNT(DISTINCT c1+c2) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT c1+c2-c3) FROM t1;
SELECT COUNT(DISTINCT c1+c2-c3) FROM t1;

--echo # case7: Cases with multiple COUNT(DISTINCT).

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT c1+c2-c3), COUNT(DISTINCT(c1)) FROM t1;
SELECT COUNT(DISTINCT c1+c2-c3), COUNT(DISTINCT(c1)) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT c1+c2-c3), COUNT(DISTINCT(1)) FROM t1;
SELECT COUNT(DISTINCT c1+c2-c3), COUNT(DISTINCT(1)) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT c1+c2-c3), COUNT(DISTINCT(NULL)) FROM t1;
SELECT COUNT(DISTINCT c1+c2-c3), COUNT(DISTINCT(NULL)) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT c1), COUNT(DISTINCT c2) FROM t1;
SELECT COUNT(DISTINCT c1), COUNT(DISTINCT c2) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT c1), COUNT(DISTINCT c2), COUNT(DISTINCT c3) FROM t1;
SELECT COUNT(DISTINCT c1), COUNT(DISTINCT c2), COUNT(DISTINCT c3) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT c1), COUNT(DISTINCT c2), COUNT(DISTINCT 1) FROM t1;
SELECT COUNT(DISTINCT c1), COUNT(DISTINCT c2), COUNT(DISTINCT 1) FROM t1;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT c1), COUNT(DISTINCT c2), COUNT(DISTINCT NULL) FROM t1;
SELECT COUNT(DISTINCT c1), COUNT(DISTINCT c2), COUNT(DISTINCT NULL) FROM t1;

DROP TABLE t1;

--echo # case8: COUNT(DISTINCT) appears in the HAVING clause.

CREATE TABLE t1 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    n1 INT,
    n2 INT
);

INSERT INTO t1 (n1, n2) VALUES 
(10, 100),
(20, 200),
(30, 300),
(20, 201),
(40, 400),
(50, 500),
(30, 301),
(60, 600);

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT n1) AS DISTINCT_n1_COUNT FROM t1 HAVING COUNT(DISTINCT n1) > 4;
SELECT COUNT(DISTINCT n1) AS DISTINCT_n1_COUNT FROM t1 HAVING COUNT(DISTINCT n1) > 4;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT n1) AS DISTINCT_n1_COUNT FROM t1 HAVING COUNT(DISTINCT n1) < 4;
SELECT COUNT(DISTINCT n1) AS DISTINCT_n1_COUNT FROM t1 HAVING COUNT(DISTINCT n1) < 4;

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT n1) AS DISTINCT_n1_COUNT FROM t1 HAVING COUNT(DISTINCT n1, n2) > 4;
SELECT COUNT(DISTINCT n1) AS DISTINCT_n1_COUNT FROM t1 HAVING COUNT(DISTINCT n1, n2) > 4;

--replace_column 10 # 11 #
EXPLAIN SELECT n1 AS DISTINCT_n1_COUNT FROM t1 GROUP BY n1 HAVING COUNT(DISTINCT n1, n2) < 4;
SELECT n1 AS DISTINCT_n1_COUNT FROM t1 GROUP BY n1 HAVING COUNT(DISTINCT n1, n2) < 4;

DROP TABLE t1;

--echo # case9: COUNT(DISTINCT) appears in the WHERE clause.

CREATE TABLE t1 (
    id INT PRIMARY KEY,
    c1 INT,
    c2 INT
);

CREATE TABLE t2 (
    id INT PRIMARY KEY,
    c1 INT,
    c2 INT
);

CREATE TABLE t3 (
    id INT PRIMARY KEY,
    c1 INT,
    c2 INT
);

INSERT INTO t1 (id, c1, c2) VALUES
(1, 100, 101),
(2, 200, 201),
(3, 300, 301);

INSERT INTO t2 (id, c1, c2) VALUES
(1, 400, 401),
(2, 500, 501),
(3, 600, 601);

INSERT INTO t3 (id, c1, c2) VALUES
(1, 700, 701),
(2, 800, 801),
(3, 900, 901);

--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t1 WHERE t1.c1 >= (SELECT COUNT(DISTINCT c1) FROM t2 WHERE c1 >= 500);
SELECT * FROM t1 WHERE t1.c1 >= (SELECT COUNT(DISTINCT c1) FROM t2 WHERE c1 >= 500);

--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t1 WHERE t1.c1 >= (SELECT COUNT(DISTINCT c1, c2) FROM t2 WHERE c1 >= 500);
SELECT * FROM t1 WHERE t1.c1 >= (SELECT COUNT(DISTINCT c1, c2) FROM t2 WHERE c1 >= 500);

--echo # case10: COUNT(DISTINCT) appears in the join condition.

--replace_column 10 # 11 #
EXPLAIN SELECT t1.*, t2.* FROM t1 JOIN t2 ON t1.id=t2.id AND t1.c1 >= (SELECT COUNT(DISTINCT c1) FROM t3 WHERE c1 > 700);
SELECT t1.*, t2.* FROM t1 JOIN t2 ON t1.id=t2.id AND t1.c1 >= (SELECT COUNT(DISTINCT c1) FROM t3 WHERE c1 > 700);

--replace_column 10 # 11 #
EXPLAIN SELECT t1.*, t2.* FROM t1 JOIN t2 ON t1.id=t2.id AND t1.c1 >= (SELECT COUNT(DISTINCT c1, c2) FROM t3 WHERE c1 > 700);
SELECT t1.*, t2.* FROM t1 JOIN t2 ON t1.id=t2.id AND t1.c1 >= (SELECT COUNT(DISTINCT c1, c2) FROM t3 WHERE c1 > 700);

DROP TABLE t1;
DROP TABLE t2;
DROP TABLE t3;

--echo # case11: COUNT(DISTINCT) with GROUP BY.

CREATE TABLE t1 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    age INT NOT NULL,
    department VARCHAR(50) NOT NULL
);
INSERT INTO t1 (name, age, department) VALUES
('Alice', 30, 'Sales'),
('Bob', 35, 'Dev'),
('Charlie', 40, 'HR'),
('Diana', 30, 'Sales'),
('Eve', 20, 'Dev'),
('Frank', 45, 'HR'),
('Grace', 35, 'Sales'),
('Heidi', 30, 'Dev'),
('Ivan', 40, 'HR'),
('Judy', 20, 'Sales');

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department;
SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department;

ALTER TABLE t1 ADD INDEX idx_dep(department);

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department;
SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department;

--echo # case12: COUNT(DISTINCT) with GROUP BY + ORDER BY.

ALTER TABLE t1 DROP INDEX idx_dep;
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department ORDER BY department DESC;
SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department ORDER BY department DESC;

ALTER TABLE t1 ADD INDEX idx_dep(department);
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department ORDER BY department DESC;
SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department ORDER BY department DESC;

--echo # case13: COUNT(DISTINCT) with GROUP BY + ORDER BY + HAVING.

ALTER TABLE t1 DROP INDEX idx_dep;
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department HAVING COUNT(DISTINCT age) > 2 ORDER BY department DESC;
SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department HAVING COUNT(DISTINCT age) > 2 ORDER BY department DESC;

ALTER TABLE t1 ADD INDEX idx_dep(department);
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department HAVING COUNT(DISTINCT age) > 2 ORDER BY department DESC;
SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department HAVING COUNT(DISTINCT age) > 2 ORDER BY department DESC;

--echo # case14: COUNT(DISTINCT) with GROUP BY + ORDER BY + HAVING + limit

ALTER TABLE t1 DROP INDEX idx_dep;
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department HAVING COUNT(DISTINCT age) > 2 ORDER BY department DESC limit 2;
SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department HAVING COUNT(DISTINCT age) > 2 ORDER BY department DESC limit 2;

ALTER TABLE t1 ADD INDEX idx_dep(department);
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department HAVING COUNT(DISTINCT age) > 2 ORDER BY department DESC limit 2;
SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department HAVING COUNT(DISTINCT age) > 2 ORDER BY department DESC limit 2;

--echo # case15: PQ does not support scenarios where ROLLUP is used.
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department WITH ROLLUP;
SELECT COUNT(DISTINCT age), department FROM t1 GROUP BY department WITH ROLLUP;

DROP TABLE t1;

--echo # case16: COUNT(DISTINCT) + PRIMARY KEY / UNIQUE KEY / KEY

CREATE TABLE `t1` (
  `id` int NOT NULL,
  `c1` int DEFAULT NULL,
  `c2` int DEFAULT NULL,
  `c3` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `c2` (`c2`),
  KEY `idx_c3` (`c3`)
);

INSERT INTO t1 (id, c1, c2, c3) VALUES
(1, 10, 100, 1000),
(2, 20, 200, 2000),
(3, 30, 300, 3000),
(4, 40, 400, 3000),
(5, 10, 500, 5000);
analyze table t1;

