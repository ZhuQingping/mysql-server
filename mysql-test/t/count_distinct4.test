EXPLAIN SELECT 
    d.department_id,
    d.department_name
FROM 
    departments d
WHERE 
    EXISTS (
        SELECT 1
        FROM employees e
        WHERE e.department_id = d.department_id
        GROUP BY e.department_id
        HAVING COUNT(DISTINCT e.sex) >= 2
    );

SELECT 
    d.department_id,
    d.department_name
FROM 
    departments d
WHERE 
    EXISTS (
        SELECT 1
        FROM employees e
        WHERE e.department_id = d.department_id
        GROUP BY e.department_id
        HAVING COUNT(DISTINCT e.sex) >= 2
    );

