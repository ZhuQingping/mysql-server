--echo # case18: Singlerow Subquery

--replace_column 10 # 11 #
EXPLAIN SELECT 
    d.department_name,
    (SELECT COUNT(DISTINCT e.sex) 
     FROM employees e 
     WHERE e.department_id = (
         SELECT department_id 
         FROM employees 
         WHERE name = 'John Doe'
     )) AS distinct_sex_count
FROM departments d
WHERE d.department_id = (
    SELECT department_id 
    FROM employees 
    WHERE name = 'John Doe'
);

SELECT 
    d.department_name,
    (SELECT COUNT(DISTINCT e.sex) 
     FROM employees e 
     WHERE e.department_id = (
         SELECT department_id 
         FROM employees 
         WHERE name = 'John Doe'
     )) AS distinct_sex_count
FROM departments d
WHERE d.department_id = (
    SELECT department_id 
    FROM employees 
    WHERE name = 'John Doe'
);

--echo # case19: IN Subquery

--replace_column 10 # 11 #
EXPLAIN SELECT 
    d.department_id,
    d.department_name
FROM 
    departments d
WHERE 
    d.department_id IN (
        SELECT e.department_id
        FROM employees e
        GROUP BY e.department_id
        HAVING COUNT(DISTINCT e.sex) > 2
    );

SELECT 
    d.department_id,
    d.department_name
FROM 
    departments d
WHERE 
    d.department_id IN (
        SELECT e.department_id
        FROM employees e
        GROUP BY e.department_id
        HAVING COUNT(DISTINCT e.sex) > 2
    );

