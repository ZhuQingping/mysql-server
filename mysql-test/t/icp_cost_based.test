CREATE TABLE t1 (
  a INT NOT NULL,
  b INT NOT NULL,
  c INT NOT NULL,
  payload CHAR(32) NOT NULL,
  KEY idx_abc (a, b, c)
) ENGINE=InnoDB;

CREATE TABLE t2 (
  id INT NOT NULL,
  PRIMARY KEY(id)
) ENGINE=InnoDB;

INSERT INTO t2 VALUES (0), (1), (2), (3), (4);

INSERT INTO t1
WITH RECURSIVE seq AS (
  SELECT 1 AS n
  UNION ALL
  SELECT n + 1 FROM seq WHERE n < 200
)
SELECT
  1 AS a,
  n % 5 AS b,
  IF(n <= 5, 0, 1) AS c,
  LPAD(n, 32, 'x') AS payload
FROM seq;

ANALYZE TABLE t1, t2;

# Normalize volatile parts of EXPLAIN FORMAT=TREE output (costs, rowcount
# estimates, actual timings) so the expected plan shape stays stable across
# platforms and cost-model tweaks. We only check that:
#   - the chosen access type (ref / range / table scan) is the expected one,
#   - ICP pushdown is visible in the plan tree when it is expected.
--let $explain_mask = /\(cost=[0-9.e+-]+ rows=[0-9.e+-]+\)/(cost=X rows=N)/ /\(actual time=[^)]*\)/(actual time=X)/ /never executed/(actual time=X)/
--let $explain_mask_join_flip_off = $explain_mask /tt[.]/tx./ /tu[.]/tx./ / on tt/ on tx/ / on tu/ on tx/

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';

--echo #
--echo # Case 1: feature OFF should fallback to legacy behavior.
--echo #         FORCE INDEX + eq-ref on (a,b) with a non-sargable predicate on c.
--echo #         Expected plan: ref access on idx_abc with ICP ("Using index condition").
--echo #
SET optimizer_trace='enabled=on,one_line=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT SUM(CHAR_LENGTH(payload))
FROM t1 FORCE INDEX(idx_abc)
WHERE t1.a = 1 AND t1.b = 1 AND (t1.c + 0) >= 0;

SELECT SUM(CHAR_LENGTH(payload))
FROM t1 FORCE INDEX(idx_abc)
WHERE t1.a = 1 AND t1.b = 1 AND (t1.c + 0) >= 0;

SELECT
  LOCATE('"icp_cost_based":true', REPLACE(TRACE, ' ', '')) > 0
    AS has_icp_cost_based,
  LOCATE('"icp_enabled":', REPLACE(TRACE, ' ', '')) > 0 AS has_icp_enabled,
  LOCATE('"icp_cost_if_disabled":', REPLACE(TRACE, ' ', '')) > 0
    AS has_icp_cost_if_disabled,
  LOCATE('"icp_cost_if_enabled":', REPLACE(TRACE, ' ', '')) > 0
    AS has_icp_cost_if_enabled
FROM information_schema.optimizer_trace;

--echo #
--echo # Case 2: feature ON should expose cost-based ICP trace fields and
--echo #         still produce a ref access plan with ICP pushdown.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
SET optimizer_trace='enabled=on,one_line=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT SUM(CHAR_LENGTH(payload))
FROM t1 FORCE INDEX(idx_abc)
WHERE t1.a = 1 AND t1.b = 1 AND (t1.c + 0) = 0;

SELECT SUM(CHAR_LENGTH(payload))
FROM t1 FORCE INDEX(idx_abc)
WHERE t1.a = 1 AND t1.b = 1 AND (t1.c + 0) = 0;

SELECT
  LOCATE('"icp_cost_based":true', REPLACE(TRACE, ' ', '')) > 0
    AS has_icp_cost_based,
  LOCATE('"icp_enabled":', REPLACE(TRACE, ' ', '')) > 0 AS has_icp_enabled,
  LOCATE('"icp_cost_if_disabled":', REPLACE(TRACE, ' ', '')) > 0
    AS has_icp_cost_if_disabled,
  LOCATE('"icp_cost_if_enabled":', REPLACE(TRACE, ' ', '')) > 0
    AS has_icp_cost_if_enabled
FROM information_schema.optimizer_trace;

--echo #
--echo # Case 3 (issue-2 regression):
--echo #   FORCE INDEX + range scan on leading key + equality on trailing index
--echo #   column. Before the fix the range-scan baseline made filter_effect
--echo #   collapse to ~1.0 and should_enable_icp_by_cost() always returned
--echo #   false, so push_index_cond() emitted "not_pushed_due_to_icp_cost"
--echo #   and skipped pushdown (10x slower vs community default in practice).
--echo #
--echo #   Expected plan with icp_cost_based=on: range access on idx_ab with
--echo #   ICP ("Using index condition") still present.
--echo #
CREATE TABLE t3 (
  a INT NOT NULL,
  b INT NOT NULL,
  payload CHAR(32) NOT NULL,
  KEY idx_ab (a, b)
) ENGINE=InnoDB;

INSERT INTO t3
WITH RECURSIVE seq AS (
  SELECT 1 AS n
  UNION ALL
  SELECT n + 1 FROM seq WHERE n < 1000
)
SELECT n DIV 10, n MOD 10, LPAD(n, 32, 'x') FROM seq;

ANALYZE TABLE t3;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
SET optimizer_trace='enabled=on,one_line=on';

--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT SUM(CHAR_LENGTH(payload))
FROM t3 FORCE INDEX(idx_ab)
WHERE a BETWEEN 10 AND 80 AND b = 5;

SELECT SUM(CHAR_LENGTH(payload))
FROM t3 FORCE INDEX(idx_ab)
WHERE a BETWEEN 10 AND 80 AND b = 5;

# Must be 0 after fix: community ICP is still pushed down.
SELECT
  LOCATE('"not_pushed_due_to_icp_cost":true', REPLACE(TRACE, ' ', '')) > 0
    AS icp_suppressed_by_cost_model
FROM information_schema.optimizer_trace;

--echo #
--echo # -----------------------------------------------------------------------
--echo # Issue-1 access-path selection coverage:
--echo #
--echo # Cases 4 and 5 verify that ICP benefit participates early enough in
--echo # ref and range candidate selection. With icp_cost_based=off they keep
--echo # the legacy baseline; with icp_cost_based=on the optimizer should pick
--echo # the ICP-capable index and expose "with index condition" in the plan.
--echo # -----------------------------------------------------------------------
--echo #

CREATE TABLE tt (
  a INT,
  b INT,
  c INT,
  d INT,
  payload CHAR(32) NOT NULL DEFAULT '',
  INDEX idx_a(a),
  INDEX idx_ab(a, b),
  INDEX idx_abc(a, b, c)
) ENGINE=InnoDB;

SET @saved_cte_max_recursion_depth = @@cte_max_recursion_depth;
SET cte_max_recursion_depth = 20000;

INSERT INTO tt (a, b, c, d, payload)
WITH RECURSIVE number_series AS (
  SELECT 1 AS n
  UNION ALL
  SELECT n + 1 FROM number_series WHERE n < 10000
)
SELECT
  n %    5 + 1,
  n %   10 + 1,
  n %  100 + 1,
  n % 1000 + 1,
  LPAD(n, 32, 'x')
FROM number_series;

SET cte_max_recursion_depth = @saved_cte_max_recursion_depth;

ANALYZE TABLE tt;

--echo #
--echo # Case 4 (issue-1 ref form):
--echo #   Three equality-eligible indexes share the leading key `a`: idx_a,
--echo #   idx_ab, idx_abc. Only idx_abc can turn c=6 into a pushed index
--echo #   condition (filter ~100x). This case checks whether the ref
--echo #   tournament can see that benefit before choosing the narrowest
--echo #   leading-key index.
--echo #
--echo #   With icp_cost_based=on, find_best_ref() rewards idx_abc because the
--echo #   remaining WHERE column set ({c}) lives on that index. idx_a / idx_ab
--echo #   do not receive the reward, so idx_abc wins the ref tournament.
--echo #
--echo #   Expected:
--echo #     - icp_cost_based=off -> legacy plan ("Index lookup on idx_a" +
--echo #       server-side Filter on c), unchanged across releases;
--echo #     - icp_cost_based=on  -> "Index lookup on tt using idx_abc (a=4),
--echo #       with index condition: (tt.c = 6)".
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a = 4 AND c = 6;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a = 4 AND c = 6;

# Sanity: with FORCE INDEX the execution path is already reachable and ICP
# is pushed down, mirroring Case 3. This documents that the engine-side ICP
# support was always fine -- the gap used to be access-method selection.
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt FORCE INDEX(idx_abc) WHERE a = 4 AND c = 6;

--echo #
--echo # Case 4a (feature-gate guardrail):
--echo #   The new ICP cost reward must be strictly gated by
--echo #   icp_cost_based=on. Re-running the exact same query with the flag
--echo #   back OFF has to restore the legacy plan. This protects against
--echo #   accidental ON-by-default changes or stuck optimizer state.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a = 4 AND c = 6;

--echo #
--echo # Case 4b (full-ref keyparts, reward must NOT fire):
--echo #   When every keypart of idx_abc is bound by ref (a=4 AND b=5 AND
--echo #   c=6), there are no unbound WHERE-columns left for ICP to absorb.
--echo #   The gate in find_best_ref() must detect this and skip the reward;
--echo #   the plan should be a plain ref/eq_ref on idx_abc without any
--echo #   "with index condition" text, regardless of icp_cost_based value.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a = 4 AND b = 5 AND c = 6;

--echo #
--echo # Case 4c (remaining WHERE columns not on the index, reward must NOT
--echo # fire):
--echo #   Here `d` is NOT a keypart of any index. Even with icp_cost_based
--echo #   on, the new gate must refuse to reward idx_a / idx_ab / idx_abc,
--echo #   because {d} is not a subset of any of their keypart sets. The
--echo #   plan therefore has to match the icp_cost_based=off baseline.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a = 4 AND d = 7;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a = 4 AND d = 7;

--echo #
--echo # Case 5 (issue-1 range form):
--echo #   Leading-key range + trailing-key equality without any index hint --
--echo #   this is the single-table shape of the customer_fund_daily_statement
--echo #   reproducer.
--echo #
--echo #   The range optimizer estimates `a BETWEEN 2 AND 4` to return about
--echo #   60% of the table, which makes every candidate range scan's cost
--echo #   (including idx_abc's) higher than the table-scan baseline when ICP
--echo #   benefit is invisible. The range preview gives idx_abc an effective
--echo #   cost that reflects pushing c=50 into the engine.
--echo #
--echo #   The effective cost only drives the "which candidate wins" comparison;
--echo #   path->cost keeps the handler-reported value so downstream cost
--echo #   accounting stays identical.
--echo #
--echo #   Expected:
--echo #     - icp_cost_based=off -> legacy plan (Table scan + server-side
--echo #       Filter on (c, a)), unchanged across releases;
--echo #     - icp_cost_based=on  -> "Index range scan on tt using idx_abc
--echo #       over (...), with index condition: (tt.c = 50 and tt.a between
--echo #       2 and 4)".
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a BETWEEN 2 AND 4 AND c = 50;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a BETWEEN 2 AND 4 AND c = 50;

--echo #
--echo # Case 5a (range + full-prefix keyparts, reward must NOT fire):
--echo #   When the range AND every trailing keypart of idx_abc are pinned
--echo #   (a BETWEEN 2 AND 4 AND b = 3 AND c = 50), there is no "remaining"
--echo #   column set for ICP to absorb -- the range itself already binds
--echo #   all the keyparts the range optimizer can exploit. The preview
--echo #   gate must skip this candidate. Plan should be the same with and
--echo #   without icp_cost_based.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a BETWEEN 2 AND 4 AND b = 3 AND c = 50;

--echo #
--echo # Case 5b (remaining WHERE columns not on any index, reward must NOT
--echo # fire):
--echo #   `d` is not part of any index. The preview gate must refuse to
--echo #   reward idx_a / idx_ab / idx_abc because {d} is not a subset of
--echo #   any of their keypart sets. Plan must therefore match the
--echo #   icp_cost_based=off baseline (Table scan).
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a BETWEEN 2 AND 4 AND d = 7;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT * FROM tt WHERE a BETWEEN 2 AND 4 AND d = 7;

--echo #
--echo # Case 5c (single-table result correctness):
--echo #   Cases 4/5 assert plan shape. This block uses matching predicates to
--echo #   prove that icp_cost_based=on and off return identical aggregate
--echo #   results across ref, range, fully-bound, and off-index gate shapes.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
SELECT 'ref_nonempty_off' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(payload)), 0) AS payload_len
FROM tt
WHERE a = 4 AND c = 49;
SELECT 'range_nonempty_off' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(payload)), 0) AS payload_len
FROM tt
WHERE a BETWEEN 2 AND 4 AND c = 49;
SELECT 'full_prefix_off' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(payload)), 0) AS payload_len
FROM tt
WHERE a BETWEEN 2 AND 4 AND b = 9 AND c = 49;
SELECT 'off_index_off' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(payload)), 0) AS payload_len
FROM tt
WHERE a BETWEEN 2 AND 4 AND d = 49;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
SELECT 'ref_nonempty_on' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(payload)), 0) AS payload_len
FROM tt
WHERE a = 4 AND c = 49;
SELECT 'range_nonempty_on' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(payload)), 0) AS payload_len
FROM tt
WHERE a BETWEEN 2 AND 4 AND c = 49;
SELECT 'full_prefix_on' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(payload)), 0) AS payload_len
FROM tt
WHERE a BETWEEN 2 AND 4 AND b = 9 AND c = 49;
SELECT 'off_index_on' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(payload)), 0) AS payload_len
FROM tt
WHERE a BETWEEN 2 AND 4 AND d = 49;

--echo #
--echo # -----------------------------------------------------------------------
--echo # Multi-table guardrails (completeness check):
--echo #
--echo # The cost-based ICP reward is written into pos->read_cost on the
--echo # winning scan/range path (sql_planner.cc, see best_access_path
--echo # scan branch). It is deliberately NOT written into
--echo # pos->rows_fetched / pos->filter_effect. That separation means:
--echo #
--echo #   * per-table row-count / selectivity estimates stay identical
--echo #     on vs off, so the row-count side of join-order DP is stable;
--echo #   * per-table read_cost DOES carry the reward, and because DP
--echo #     sums pos->read_cost across the prefix, the reward CAN in
--echo #     principle change join order, join method, and semijoin
--echo #     strategy when the OFF-baseline gap between alternatives is
--echo #     small.
--echo #
--echo # These cases map out what actually happens at each scale:
--echo #
--echo #   6a: 2-table join with STRAIGHT_JOIN pinning the order. The
--echo #       reward can only change the inner table's access method.
--echo #
--echo #   6b: 2-table join, free order, row-count gap HUGE (5 vs 10000).
--echo #       The reward cannot overcome that gap -- join order stays
--echo #       put. This is NOT a universal "join order cannot flip"
--echo #       guarantee; see Case 6d for the counter-example.
--echo #
--echo #   6c: EXISTS subquery. Semijoin strategy selection reads
--echo #       pos->read_cost through advance_sj_state(), so the reward
--echo #       CAN flip the chosen strategy (MaterializeLookup <->
--echo #       FirstMatch etc.). Both plans are correct; operators
--echo #       enabling the feature on workloads with EXISTS / IN
--echo #       subqueries should expect some strategy migration.
--echo #
--echo #   6d: 2-table join, free order, row-count equal (10000 vs
--echo #       10000), only index coverage asymmetric (tt has idx_abc,
--echo #       tu only idx_a). Close baseline + big reward on tt's
--echo #       range-ICP side -> the optimizer flips the join method
--echo #       (hash -> NL), the driver (tt -> tu), AND tt's access
--echo #       method (table scan -> idx_abc + ICP) all at once. This
--echo #       is the expected consequence of cost-based reasoning.
--echo #
--echo # Every SELECT on tt / tu below fetches `payload` to force a
--echo # non-covering scan; otherwise the engine would skip ICP entirely
--echo # (gate G2 in range_icp_preview / can_consider_icp_cost) and the
--echo # guardrail would lose its teeth.
--echo # -----------------------------------------------------------------------
--echo #

CREATE TABLE tj_driver (
  id INT NOT NULL PRIMARY KEY,
  a  INT NOT NULL
) ENGINE=InnoDB;

INSERT INTO tj_driver VALUES (1, 2), (2, 3), (3, 4), (4, 4), (5, 2);

ANALYZE TABLE tj_driver;

--echo #
--echo # Case 6a: STRAIGHT_JOIN pins tj_driver as driver. tt must be the
--echo #          inner side with or without the reward. The reward (when
--echo #          on) may change tt's access method to idx_abc + ICP; the
--echo #          join order is already pinned by STRAIGHT_JOIN, so the top
--echo #          line of the plan tree ("Nested loop inner join" with d
--echo #          first, tt second) is what we compare.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT STRAIGHT_JOIN tt.payload
FROM tj_driver d JOIN tt ON tt.a = d.a
WHERE d.id <= 3 AND tt.c = 50;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT STRAIGHT_JOIN tt.payload
FROM tj_driver d JOIN tt ON tt.a = d.a
WHERE d.id <= 3 AND tt.c = 50;

--echo #
--echo # Case 6b: No STRAIGHT_JOIN -- the optimizer picks join order
--echo #          freely. With the baseline gap HUGE (5 rows vs 10 000
--echo #          rows) the reward cannot tip the DP, so both OFF and
--echo #          ON pick the same join order (tj_driver driving, tt
--echo #          inner). The reward DOES still upgrade tt's access
--echo #          method from idx_a to idx_abc + ICP on the inner side.
--echo #
--echo #          Important: this case is NOT a general "join order
--echo #          cannot flip" guarantee -- see Case 6d for the
--echo #          counter-example where the baseline is close and the
--echo #          reward DOES flip the driver. What Case 6b really
--echo #          asserts is that, when rows_fetched/filter_effect are
--echo #          the dominating signal (orders-of-magnitude row-count
--echo #          gap), the reward does not secretly mutate them.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT tt.payload
FROM tj_driver d JOIN tt ON tt.a = d.a
WHERE d.a >= 2 AND tt.c = 50;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT tt.payload
FROM tj_driver d JOIN tt ON tt.a = d.a
WHERE d.a >= 2 AND tt.c = 50;

--echo #
--echo # Case 6c: EXISTS subquery (semijoin). tt is the inner table and is
--echo #          ICP-eligible on c=50. Expected: the chosen semijoin
--echo #          strategy CAN flip between on/off -- on OFF the optimizer
--echo #          prefers MaterializeLookup (because fetching 10000 rows
--echo #          once and probing beats a table scan per outer row); on
--echo #          ON, idx_abc + ICP makes the per-probe inner fetch cheap
--echo #          enough that FirstMatch wins. Both are correct plans; we
--echo #          record the exact strings so a future regression here is
--echo #          noticed immediately and can be reviewed intentionally.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT d.id, d.a FROM tj_driver d
WHERE EXISTS (SELECT 1 FROM tt
              WHERE tt.a = d.a AND tt.c = 50
                AND tt.payload <> '');

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT d.id, d.a FROM tj_driver d
WHERE EXISTS (SELECT 1 FROM tt
              WHERE tt.a = d.a AND tt.c = 50
                AND tt.payload <> '');

--echo #
--echo # Case 6e (multi-table result correctness):
--echo #   Plan shape may change with the reward, but the row set must remain
--echo #   stable. Use non-empty predicates to compare aggregate results under
--echo #   STRAIGHT_JOIN, free join order, and EXISTS/semijoin shapes.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
SELECT 'straight_join_off' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(tt.payload)), 0) AS payload_len
FROM tj_driver d STRAIGHT_JOIN tt ON tt.a = d.a
WHERE d.id <= 3 AND tt.c = 49;
SELECT 'free_join_off' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(tt.payload)), 0) AS payload_len
FROM tj_driver d JOIN tt ON tt.a = d.a
WHERE d.a >= 2 AND tt.c = 49;
SELECT 'exists_off' AS scenario, COUNT(*) AS cnt, COALESCE(SUM(id), 0) AS id_sum
FROM (
  SELECT d.id
  FROM tj_driver d
  WHERE EXISTS (SELECT 1 FROM tt
                WHERE tt.a = d.a AND tt.c = 49
                  AND tt.payload <> '')
) AS matched_driver;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
SELECT 'straight_join_on' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(tt.payload)), 0) AS payload_len
FROM tj_driver d STRAIGHT_JOIN tt ON tt.a = d.a
WHERE d.id <= 3 AND tt.c = 49;
SELECT 'free_join_on' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(tt.payload)), 0) AS payload_len
FROM tj_driver d JOIN tt ON tt.a = d.a
WHERE d.a >= 2 AND tt.c = 49;
SELECT 'exists_on' AS scenario, COUNT(*) AS cnt, COALESCE(SUM(id), 0) AS id_sum
FROM (
  SELECT d.id
  FROM tj_driver d
  WHERE EXISTS (SELECT 1 FROM tt
                WHERE tt.a = d.a AND tt.c = 49
                  AND tt.payload <> '')
) AS matched_driver;

DROP TABLE tj_driver;

--echo #
--echo # Case 6d (multi-table guardrail, EXPECTED behavior change across
--echo # join method, join order AND access method):
--echo #
--echo #   This case DELIBERATELY demonstrates that the cost-based ICP
--echo #   reward CAN reshape an entire multi-table plan when the two
--echo #   sides are close in baseline cost. It documents the limit of
--echo #   the "non-pollution" guarantee given by Case 6b: rows_fetched
--echo #   and filter_effect stay intact, but pos->read_cost DOES carry
--echo #   the reward and that is enough to change join-order DP when
--echo #   the baseline gap is small.
--echo #
--echo #   Setup: tt and tu have identical row count (10000), identical
--echo #   column distributions, and the same join key shape. The only
--echo #   asymmetry is INDEX COVERAGE -- tt has idx_abc(a,b,c) so
--echo #   `a between 2 and 4 AND c = 50` is ICP-eligible; tu only has
--echo #   idx_a(a), so its trailing c=50 cannot be pushed via the
--echo #   range-optimizer preview.
--echo #
--echo #   Observed plans recorded below:
--echo #     - OFF: Hash join, tt and tu both via table scan + SQL-layer
--echo #       filters. No index chosen on either side.
--echo #     - ON:  Nested loop, tu as driver (table scan + filter),
--echo #       tt as inner via idx_abc + ICP (`a=tu.a, with index
--echo #       condition: (tt.c = 50)`). tt's ICP reward made the
--echo #       per-probe inner cost cheap enough that BOTH the join
--echo #       algorithm (hash -> NL) AND the driver (tt -> tu) changed,
--echo #       AND tt's own access method switched from table scan to
--echo #       idx_abc + ICP.
--echo #
--echo #   All three changes are legitimate cost-based outcomes. We
--echo #   pin the exact plan strings so any future unintended movement
--echo #   (either direction) surfaces at --record time and can be
--echo #   triaged intentionally.
--echo #

CREATE TABLE tu (
  a INT,
  b INT,
  c INT,
  d INT,
  payload CHAR(32) NOT NULL DEFAULT '',
  INDEX idx_a(a)
) ENGINE=InnoDB;

SET cte_max_recursion_depth = 20000;

INSERT INTO tu (a, b, c, d, payload)
WITH RECURSIVE number_series AS (
  SELECT 1 AS n
  UNION ALL
  SELECT n + 1 FROM number_series WHERE n < 10000
)
SELECT
  n %    5 + 1,
  n %   10 + 1,
  n %  100 + 1,
  n % 1000 + 1,
  LPAD(n, 32, 'y')
FROM number_series;

SET cte_max_recursion_depth = @saved_cte_max_recursion_depth;

ANALYZE TABLE tu;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
# tt and tu are intentionally symmetric in this OFF baseline; normalize the
# chosen hash-build/probe side so the assertion focuses on plan shape.
--replace_regex $explain_mask_join_flip_off
EXPLAIN FORMAT=TREE
SELECT tt.payload, tu.payload
FROM tt JOIN tu ON tu.a = tt.a
WHERE tt.a BETWEEN 2 AND 4 AND tt.c = 50
  AND tu.a BETWEEN 2 AND 4 AND tu.c = 50;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
--replace_regex $explain_mask
EXPLAIN FORMAT=TREE
SELECT tt.payload, tu.payload
FROM tt JOIN tu ON tu.a = tt.a
WHERE tt.a BETWEEN 2 AND 4 AND tt.c = 50
  AND tu.a BETWEEN 2 AND 4 AND tu.c = 50;

--echo #
--echo # Case 6f (join-order flip result correctness):
--echo #   Case 6d allows the optimizer to flip join method, driver, and tt's
--echo #   access method. The same non-empty join must still return the same
--echo #   aggregate result with the feature off and on.
--echo #
SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=off';
SELECT 'join_flip_off' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(tt.payload) + CHAR_LENGTH(tu.payload)), 0)
         AS payload_len
FROM tt JOIN tu ON tu.a = tt.a
WHERE tt.a BETWEEN 2 AND 4 AND tt.c = 49
  AND tu.a BETWEEN 2 AND 4 AND tu.c = 49;

SET optimizer_switch=
  'index_condition_pushdown=on,condition_fanout_filter=on,mrr=off,mrr_cost_based=off,icp_cost_based=on';
SELECT 'join_flip_on' AS scenario, COUNT(*) AS cnt,
       COALESCE(SUM(CHAR_LENGTH(tt.payload) + CHAR_LENGTH(tu.payload)), 0)
         AS payload_len
FROM tt JOIN tu ON tu.a = tt.a
WHERE tt.a BETWEEN 2 AND 4 AND tt.c = 49
  AND tu.a BETWEEN 2 AND 4 AND tu.c = 49;

DROP TABLE tu;

DROP TABLE tt, t3, t2, t1;
