--echo # Test cases covering all SET type storage lengths (1-8 bytes)

--echo # 1-byte SET (1-8 elements)
CREATE TABLE `tb_1byte` (
  `c1` set('elem1','elem2','elem3','elem4','elem5','elem6','elem7','elem8') DEFAULT 'elem1,elem3'
);

--echo # 2-byte SET (9-16 elements)
CREATE TABLE `tb_2byte` (
  `c2` set('e1','e2','e3','e4','e5','e6','e7','e8','e9','e10','e11','e12','e13','e14','e15','e16') DEFAULT 'e1,e5,e9'
);

--echo # 3-byte SET (17-24 elements)
CREATE TABLE `tb_3byte` (
  `c3` set('a1','a2','a3','a4','a5','a6','a7','a8','a9','a10','a11','a12','a13','a14','a15','a16','a17','a18','a19','a20','a21','a22','a23','a24') DEFAULT 'a1,a8,a17'
);

--echo # 4-byte SET (25-32 elements)
CREATE TABLE `tb_4byte` (
  `c4` set('v1','v2','v3','v4','v5','v6','v7','v8','v9','v10','v11','v12','v13','v14','v15','v16','v17','v18','v19','v20','v21','v22','v23','v24','v25','v26','v27','v28','v29','v30','v31','v32') DEFAULT 'v1,v16,v25'
);

--echo # 8-byte SET (33-40 elements)
CREATE TABLE `tb_8byte_1` (
  `c8` set(
    'item01','item02','item03','item04','item05','item06','item07','item08',
    'item09','item10','item11','item12','item13','item14','item15','item16',
    'item17','item18','item19','item20','item21','item22','item23','item24',
    'item25','item26','item27','item28','item29','item30','item31','item32',
    'item33','item34','item35','item36','item37','item38','item39','item40'
  ) DEFAULT 'item01,item32,item33'
);

--echo # 8-byte SET (41-48 elements)
CREATE TABLE `tb_8byte_2` (
  `c8` set(
    'item01','item02','item03','item04','item05','item06','item07','item08',
    'item09','item10','item11','item12','item13','item14','item15','item16',
    'item17','item18','item19','item20','item21','item22','item23','item24',
    'item25','item26','item27','item28','item29','item30','item31','item32',
    'item33','item34','item35','item36','item37','item38','item39','item40',
    'item41','item42','item43','item44','item45','item46','item47','item48'
  ) DEFAULT 'item01,item32,item33'
);

--echo # 8-byte SET (49-56 elements)
CREATE TABLE `tb_8byte_3` (
  `c8` set(
    'item01','item02','item03','item04','item05','item06','item07','item08',
    'item09','item10','item11','item12','item13','item14','item15','item16',
    'item17','item18','item19','item20','item21','item22','item23','item24',
    'item25','item26','item27','item28','item29','item30','item31','item32',
    'item33','item34','item35','item36','item37','item38','item39','item40',
    'item41','item42','item43','item44','item45','item46','item47','item48',
    'item49','item50','item51','item52','item53','item54','item55','item56'
  ) DEFAULT 'item01,item32,item33'
);

--echo # 8-byte SET (57-64 elements)
CREATE TABLE `tb_8byte_4` (
  `c8` set(
    'item01','item02','item03','item04','item05','item06','item07','item08',
    'item09','item10','item11','item12','item13','item14','item15','item16',
    'item17','item18','item19','item20','item21','item22','item23','item24',
    'item25','item26','item27','item28','item29','item30','item31','item32',
    'item33','item34','item35','item36','item37','item38','item39','item40',
    'item41','item42','item43','item44','item45','item46','item47','item48',
    'item49','item50','item51','item52','item53','item54','item55','item56',
    'item57','item58','item59','item60','item61','item62','item63','item64'
  ) DEFAULT 'item01,item32,item33'
);

--echo # Insert test data for all tables
INSERT INTO tb_1byte (c1) VALUES 
('elem1'),
('elem2,elem4,elem6'),
('elem1,elem3,elem5,elem7'),
('elem8');

INSERT INTO tb_2byte (c2) VALUES 
('e9'),
('e5'),
('e1,e8,e16'),
('e2,e4,e6,e10,e12,e14'),
('e9,e10,e11,e12,e13,e14,e15,e16');

INSERT INTO tb_3byte (c3) VALUES 
('a17'),
('a6'),
('a1,a12,a24'),
('a2,a4,a6,a8,a10,a12,a14,a16,a18,a20,a22,a24'),
('a17,a18,a19,a20,a21,a22,a23,a24');

INSERT INTO tb_4byte (c4) VALUES 
('v17'),
('v7'),
('v1,v16,v32'),
('v2,v4,v6,v8,v10,v12,v14,v16,v18,v20,v22,v24,v26,v28,v30,v32'),
('v25,v26,v27,v28,v29,v30,v31,v32');

INSERT INTO tb_8byte_1 (c8) VALUES 
('item25'),
('item07'),
('item01,item32,item40'),
('item02,item04,item08,item16,item32,item38,item39,item40'),
('item33,item34,item35,item36,item37,item38,item39,item40');

INSERT INTO tb_8byte_2 (c8) VALUES 
('item25'),
('item15'),
('item01,item32,item48'),
('item02,item04,item08,item16,item32,item44,item46,item48'),
('item41,item42,item43,item44,item45,item46,item47,item48');

INSERT INTO tb_8byte_3 (c8) VALUES 
('item50'),
('item23'),
('item01,item32,item56'),
('item02,item04,item08,item16,item32,item52,item54,item56'),
('item49,item50,item51,item52,item53,item54,item55,item56');

INSERT INTO tb_8byte_4 (c8) VALUES 
('item23'),
('item49'),
('item01,item32,item64'),
('item02,item04,item08,item16,item32,item60,item62,item64'),
('item57,item58,item59,item60,item61,item62,item63,item64');

--echo # Query test without indexes
SELECT '1-byte SET:' as test_type, c1 FROM tb_1byte ORDER BY c1;
SELECT '2-byte SET:' as test_type, c2 FROM tb_2byte ORDER BY c2;
SELECT '3-byte SET:' as test_type, c3 FROM tb_3byte ORDER BY c3;
SELECT '4-byte SET:' as test_type, c4 FROM tb_4byte ORDER BY c4;
SELECT '8-byte SET (33-40):' as test_type, c8 FROM tb_8byte_1 ORDER BY c8;
SELECT '8-byte SET (41-48):' as test_type, c8 FROM tb_8byte_2 ORDER BY c8;
SELECT '8-byte SET (49-56):' as test_type, c8 FROM tb_8byte_3 ORDER BY c8;
SELECT '8-byte SET (57-64):' as test_type, c8 FROM tb_8byte_4 ORDER BY c8;

--echo # Add indexes for performance testing
ALTER TABLE tb_1byte ADD INDEX idx_c1 (c1);
ALTER TABLE tb_2byte ADD INDEX idx_c2 (c2);
ALTER TABLE tb_3byte ADD INDEX idx_c3 (c3);
ALTER TABLE tb_4byte ADD INDEX idx_c4 (c4);
ALTER TABLE tb_8byte_1 ADD INDEX idx_c8_1 (c8);
ALTER TABLE tb_8byte_2 ADD INDEX idx_c8_2 (c8);
ALTER TABLE tb_8byte_3 ADD INDEX idx_c8_3 (c8);
ALTER TABLE tb_8byte_4 ADD INDEX idx_c8_4 (c8);

--echo # Query test with indexes
SELECT '1-byte SET with index:' as test_type, c1 FROM tb_1byte ORDER BY c1;
SELECT '2-byte SET with index:' as test_type, c2 FROM tb_2byte ORDER BY c2;
SELECT '3-byte SET with index:' as test_type, c3 FROM tb_3byte ORDER BY c3;
SELECT '4-byte SET with index:' as test_type, c4 FROM tb_4byte ORDER BY c4;
SELECT '8-byte SET (33-40) with index:' as test_type, c8 FROM tb_8byte_1 ORDER BY c8;
SELECT '8-byte SET (41-48) with index:' as test_type, c8 FROM tb_8byte_2 ORDER BY c8;
SELECT '8-byte SET (49-56) with index:' as test_type, c8 FROM tb_8byte_3 ORDER BY c8;
SELECT '8-byte SET (57-64) with index:' as test_type, c8 FROM tb_8byte_4 ORDER BY c8;

--echo # Add additional SET columns with same element count as original columns
ALTER TABLE tb_1byte ADD COLUMN c1_extra set('extra1','extra2','extra3','extra4','extra5','extra6','extra7','extra8') NOT NULL DEFAULT 'extra1';
ALTER TABLE tb_2byte ADD COLUMN c2_extra set('ex1','ex2','ex3','ex4','ex5','ex6','ex7','ex8','ex9','ex10','ex11','ex12','ex13','ex14','ex15','ex16') NOT NULL DEFAULT 'ex1';
ALTER TABLE tb_3byte ADD COLUMN c3_extra set('add1','add2','add3','add4','add5','add6','add7','add8','add9','add10','add11','add12','add13','add14','add15','add16','add17','add18','add19','add20','add21','add22','add23','add24') NOT NULL DEFAULT 'add1';
ALTER TABLE tb_4byte ADD COLUMN c4_extra set('new1','new2','new3','new4','new5','new6','new7','new8','new9','new10','new11','new12','new13','new14','new15','new16','new17','new18','new19','new20','new21','new22','new23','new24','new25','new26','new27','new28','new29','new30','new31','new32') NOT NULL DEFAULT 'new1';
