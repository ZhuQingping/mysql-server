ALTER TABLE tb_8byte_4 ADD COLUMN c8_extra set(
    'extra01','extra02','extra03','extra04','extra05','extra06','extra07','extra08',
    'extra09','extra10','extra11','extra12','extra13','extra14','extra15','extra16',
    'extra17','extra18','extra19','extra20','extra21','extra22','extra23','extra24',
    'extra25','extra26','extra27','extra28','extra29','extra30','extra31','extra32',
    'extra33','extra34','extra35','extra36','extra37','extra38','extra39','extra40',
