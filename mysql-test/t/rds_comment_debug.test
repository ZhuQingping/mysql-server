#
# This test simulates error handling when operating rds_comment
#

--source include/have_debug.inc

call mtr.add_suppression("Failed to open rds_comment table.");
call mtr.add_suppression("Failed to close rds_comment table.");
call mtr.add_suppression("Fill column 'rds_comment.object_type' failed.");
call mtr.add_suppression("Delete from rds_comment table failed.");
call mtr.add_suppression("Init rds_comment table index failed.");

INSERT INTO mysql.rds_comment (object_type, object_name, comment) values ('DB','test_comment_db','test db comment');

SET debug="+d, rds_comment_table_fill_fields_failed";
CREATE DATABASE test_comment_db;
DROP DATABASE test_comment_db;
SET debug="-d, rds_comment_table_fill_fields_failed";

SET debug="+d, rds_comment_table_access_open_failed";
CREATE DATABASE test_comment_db;
DROP DATABASE test_comment_db;
SET debug="-d, rds_comment_table_access_open_failed";

SET debug="+d, rds_comment_index_init_fail";
CREATE DATABASE test_comment_db;
DROP DATABASE test_comment_db;
SET debug="-d, rds_comment_index_init_fail";

SET debug="+d, rds_comment_table_key_not_found";
CREATE DATABASE test_comment_db;
DROP DATABASE test_comment_db;
SET debug="-d, rds_comment_table_key_not_found";

SET debug="+d, rds_comment_table_delete_failed";
CREATE DATABASE test_comment_db;
DROP DATABASE test_comment_db;
SET debug="-d, rds_comment_table_delete_failed";

SET debug="+d, rds_comment_table_access_close_failed";
CREATE DATABASE test_comment_db;
DROP DATABASE test_comment_db;
SET debug="-d, rds_comment_table_access_close_failed";

DELETE FROM mysql.rds_comment;
