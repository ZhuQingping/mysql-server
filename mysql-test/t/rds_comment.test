#
# This test is used for test rds_comment records can update or delete
# by user drop database/user or rename user operations.
#
# rds_comment will not be added automatically, some prepare
# records must be inserted before test.
#

--source include/have_binlog_format_row.inc

--echo # 1. Test sync with drop database
SET @saved_rds_permission_control = @@global.rds_permission_control;
SET @saved_rds_sync_comment = @@global.rds_sync_comment;
TRUNCATE mysql.rds_comment;
RESET MASTER;

SET GLOBAL rds_sync_comment = ON;
INSERT INTO mysql.rds_comment (object_type, object_name, comment) VALUES ('DB','test_comment_db','test db comment');
INSERT INTO mysql.rds_comment (object_type, object_name, comment) VALUES ('DB','not_exist_db','test db comment');

CREATE DATABASE test_comment_db;
SELECT object_type, object_name, comment FROM mysql.rds_comment WHERE object_type='DB';
DROP DATABASE test_comment_db;
SELECT object_type, object_name, comment FROM mysql.rds_comment WHERE object_type='DB';

--echo # 2. Check binlog (rds_comment should not record in binlog)
--source include/show_binlog_events.inc

--echo # 3. Make sure that user can't do any ddl to rds_comment;
CREATE USER 'user1'@'%' IDENTIFIED BY '123456';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, RELOAD, PROCESS, REFERENCES, INDEX, ALTER, SHOW DATABASES, CREATE TEMPORARY TABLES, LOCK TABLES, EXECUTE, REPLICATION SLAVE, REPLICATION CLIENT, CREATE VIEW, SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, CREATE USER, EVENT, TRIGGER ON *.* TO 'user1'@'%' WITH GRANT OPTION;

SET GLOBAL rds_permission_control = ON;

connect(conn1,localhost,user1,123456,mysql);
--error ER_DBACCESS_DENIED_ERROR
DROP TABLE rds_comment;
SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME = 'rds_comment';

--error ER_DBACCESS_DENIED_ERROR
ALTER TABLE rds_comment DROP COLUMN status;
SHOW CREATE TABLE rds_comment;

--connection default
DROP USER 'user1'@'%';

DELETE FROM mysql.rds_comment;
SET GLOBAL rds_permission_control = @saved_rds_permission_control;
SET GLOBAL rds_sync_comment = @saved_rds_sync_comment;
SET GLOBAL rds_reserved_users = "";
