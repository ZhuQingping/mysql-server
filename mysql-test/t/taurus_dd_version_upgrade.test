--source include/have_debug.inc

--echo # Test DD Upgrade

--let BASEDIR= `select @@basedir`
--let DDIR=$MYSQL_TMP_DIR/installdb_test
--let MYSQLD_LOG=$MYSQL_TMP_DIR/server.log
--let extra_args=--no-defaults --innodb_dedicated_server=OFF --console --loose-skip-auto_generate_certs --loose-skip-sha256_password_auto_generate_rsa_keys --skip-ssl --basedir=$BASEDIR --lc-messages-dir=$MYSQL_SHAREDIR
--let BOOTSTRAP_SQL=$MYSQL_TMP_DIR/tiny_bootstrap.sql

write_file $BOOTSTRAP_SQL;
CREATE DATABASE test;
EOF

--echo # Run the server with:
--echo #   --initialize-insecure

--exec $MYSQLD $extra_args --initialize-insecure --datadir=$DDIR --init-file=$BOOTSTRAP_SQL $MYSQL_DSTORE_TENANT_CONFIG_OPTION > $MYSQLD_LOG 2>&1

--echo # 1.3 Restart the server against DDIR - should succeed.
--exec echo "restart: --datadir=$DDIR --no-console --log-error=$MYSQLD_LOG" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc

--let $find_taurus_dd_version_stmt = SELECT SUBSTRING_INDEX(SUBSTRING(properties, LOCATE('TAURUS_EXTENDED_DD_VERSION', properties), 40), ';', 1) as TAURUS_EXTENDED_DD_VERSION FROM mysql.dd_properties;
--let $find_dd_version_stmt = SELECT SUBSTRING_INDEX(SUBSTRING(properties, LOCATE('DD_VERSION', properties), 40), ';', 1) as DD_VERSION FROM mysql.dd_properties;

SET SESSION debug= '+d,skip_dd_table_access_check';
let $version1= query_get_value("$find_dd_version_stmt", DD_VERSION, 1);
let $version2= query_get_value("$find_taurus_dd_version_stmt", TAURUS_EXTENDED_DD_VERSION, 1);
SET SESSION debug= '-d,skip_dd_table_access_check';
--echo $version1
--echo $version2

# test dd upgrade with no-dd-upgrade option and it will failed to upgrade.

--echo # restart failed
--source include/kill_mysqld.inc
--error 1
--exec $MYSQLD_CMD --datadir=$DDIR --no-console --log-error=$MYSQLD_LOG --no-dd-upgrade --debug=+d,force_taurus_dd_version_upgrade

--let SEARCH_FILE=$MYSQLD_LOG
--let SEARCH_PATTERN=Data dictionary upgrade prohibited by the command line option '--no_dd_upgrade'
--source include/search_pattern.inc

# test dd upgrade

--exec echo "restart: --datadir=$DDIR --log-error=$MYSQLD_LOG --debug=+d,force_taurus_dd_version_upgrade" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc

SET SESSION debug= '+d,skip_dd_table_access_check';
let $version5= query_get_value("$find_dd_version_stmt", DD_VERSION, 1);
let $version6= query_get_value("$find_taurus_dd_version_stmt", TAURUS_EXTENDED_DD_VERSION, 1);
SET SESSION debug= '-d,skip_dd_table_access_check';
--echo $version5
--echo $version6

--let $assert_file=$MYSQLD_LOG
--let $assert_select=.* Data dictionary upgrading from version
--let $assert_text= DD upgraded.
--let $assert_count=1
--source include/assert_grep.inc

--echo # restart failed
--source include/kill_mysqld.inc
--error 1
--exec $MYSQLD_CMD --user=root --datadir=$DDIR --no-console --log-error=$MYSQLD_LOG

--let SEARCH_FILE=$MYSQLD_LOG
--let SEARCH_PATTERN=Downgrade of the extended data dictionary version TAURUS_EXTENDED_DD_VERSION is not supported
source include/search_pattern.inc;

--echo # Clean up
# Delete mysqld log and init file
remove_file $MYSQLD_LOG;
# Delete datadir
--force-rmdir $DDIR

remove_file $BOOTSTRAP_SQL;

--echo #
--echo # Cleanup: Restarting the server against default datadir.
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc
