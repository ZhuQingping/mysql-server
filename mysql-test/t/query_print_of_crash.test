###############################################################################
# Remove the historical 1024 byte limit when printing the current query
# during signal handling. Bump the limit up to the maximum value for
# max_allowed_packet(1GB).
###############################################################################
--source include/have_debug.inc

# Write file to make mysql-test-run.pl wait for the server to stop
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect

# Following query trigger mysql crash, and query length > 1024
--error 2013
SET DEBUG='+d,crash_now,';

# Call script that will poll the server waiting for it to disappear
--source include/wait_until_disconnected.inc

--let $_expect_file_name= $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--source include/start_mysqld.inc

# Check query print printed log in error message is complete
--let SEARCH_FILE = $MYSQLTEST_VARDIR/tmp/query_print_of_crash.err
--let SEARCH_PATTERN = crash_now,
--source include/search_pattern.inc

