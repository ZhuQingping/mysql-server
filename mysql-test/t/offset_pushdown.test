  (SELECT 1) UNION (SELECT 1) LIMIT 1 OFFSET 1;


--echo # Table function
--echo # Offset pushdown not compatible
--echo # table functions is an intrinsic table
--echo # Reads rows using row_search_no_mvcc
--echo # No support for offset pushdown in row_search_no_mvcc

explain format=tree SELECT *
     FROM
       JSON_TABLE(
         '[{"x":2,"y":"8"},{"x":"3","y":"7"},{"x":"4","y":6}]',
         "$[*]" COLUMNS(
           xval VARCHAR(100) PATH "$.x",
           yval VARCHAR(100) PATH "$.y"
         )
       ) AS  jt LIMIT 1 OFFSET 1;
 SELECT * FROM JSON_TABLE(
         '[{"x":2,"y":"8"},{"x":"3","y":"7"},{"x":"4","y":6}]',
         "$[*]" COLUMNS(
           xval VARCHAR(100) PATH "$.x",
           yval VARCHAR(100) PATH "$.y"
         )
       ) AS  jt LIMIT 1 OFFSET 1;
SET SESSION BIG_TABLES =default;

