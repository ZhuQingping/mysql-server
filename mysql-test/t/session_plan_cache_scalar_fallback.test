--echo # Phase 5H: scalar max/min and uncacheable fallback boundaries

CREATE TABLE pc5h_scalar_outer (
  id INT PRIMARY KEY,
  score INT NOT NULL,
  label VARCHAR(16)
) ENGINE=InnoDB;
CREATE TABLE pc5h_scalar_inner (
  id INT PRIMARY KEY,
  grp INT NOT NULL,
  score INT NOT NULL,
  KEY grp_idx(grp)
) ENGINE=InnoDB;

INSERT INTO pc5h_scalar_outer VALUES
  (1, 10, 'ten'),
  (2, 20, 'twenty'),
  (3, 30, 'thirty');
INSERT INTO pc5h_scalar_inner VALUES
  (1, 1, 12),
  (2, 1, 22),
  (3, 2, 5);

SET @old_rds_plan_cache=@@SESSION.rds_plan_cache;
SET SESSION rds_plan_cache=ON;

--echo # ANY/ALL max/min-transformed scalar shapes stay on the fallback path
FLUSH STATUS;
let $pc_invalidations_before= query_get_value(SHOW STATUS LIKE 'Cached_plan_invalidations', Value, 1);
PREPARE maxmin_stmt FROM
  'SELECT id FROM pc5h_scalar_outer WHERE score > ALL (SELECT score FROM pc5h_scalar_inner WHERE grp = ?)';

SET @grp=1;
--sorted_result
EXECUTE maxmin_stmt USING @grp;

SET @grp=2;
--sorted_result
EXECUTE maxmin_stmt USING @grp;

SET @grp=1;
--sorted_result
EXECUTE maxmin_stmt USING @grp;

SHOW STATUS LIKE 'Cached_plan_count';
SHOW STATUS LIKE 'Cached_plan_hits';
let $pc_count= query_get_value(SHOW STATUS LIKE 'Cached_plan_count', Value, 1);
if ($pc_count != 0) {
  --die max/min scalar fallback leaked a READY cached plan
}
let $pc_hits= query_get_value(SHOW STATUS LIKE 'Cached_plan_hits', Value, 1);
if ($pc_hits != 0) {
  --die max/min scalar fallback produced cached hits
}
let $pc_invalidations_after= query_get_value(SHOW STATUS LIKE 'Cached_plan_invalidations', Value, 1);
if ($pc_invalidations_after != $pc_invalidations_before) {
  --die max/min scalar fallback changed Cached_plan_invalidations
}
DEALLOCATE PREPARE maxmin_stmt;

--echo # SELECT-list ANY/ALL wrappers stay on the fallback path too
FLUSH STATUS;
let $pc_invalidations_before= query_get_value(SHOW STATUS LIKE 'Cached_plan_invalidations', Value, 1);
PREPARE maxmin_select_stmt FROM
  'SELECT id, score > ALL (SELECT score FROM pc5h_scalar_inner WHERE grp = ?) AS is_gt_all FROM pc5h_scalar_outer WHERE id = ?';

SET @grp=1;
SET @id=1;
EXECUTE maxmin_select_stmt USING @grp, @id;

SET @grp=1;
SET @id=3;
EXECUTE maxmin_select_stmt USING @grp, @id;

SET @grp=2;
SET @id=2;
EXECUTE maxmin_select_stmt USING @grp, @id;

SHOW STATUS LIKE 'Cached_plan_count';
SHOW STATUS LIKE 'Cached_plan_hits';
let $pc_count= query_get_value(SHOW STATUS LIKE 'Cached_plan_count', Value, 1);
if ($pc_count != 0) {
  --die SELECT-list max/min scalar fallback leaked a READY cached plan
}
let $pc_hits= query_get_value(SHOW STATUS LIKE 'Cached_plan_hits', Value, 1);
if ($pc_hits != 0) {
  --die SELECT-list max/min scalar fallback produced cached hits
}
let $pc_invalidations_after= query_get_value(SHOW STATUS LIKE 'Cached_plan_invalidations', Value, 1);
if ($pc_invalidations_after != $pc_invalidations_before) {
  --die SELECT-list max/min scalar fallback changed Cached_plan_invalidations
}
DEALLOCATE PREPARE maxmin_select_stmt;

--echo # Uncacheable scalar subqueries stay on the fallback path
FLUSH STATUS;
let $pc_invalidations_before= query_get_value(SHOW STATUS LIKE 'Cached_plan_invalidations', Value, 1);
PREPARE uncacheable_stmt FROM
  'SELECT id FROM pc5h_scalar_outer WHERE id = ? AND (SELECT RAND() FROM pc5h_scalar_inner WHERE id = ?) IS NOT NULL';

SET @id=1;
SET @inner_id=1;
EXECUTE uncacheable_stmt USING @id, @inner_id;

SET @id=2;
SET @inner_id=2;
EXECUTE uncacheable_stmt USING @id, @inner_id;

SET @id=3;
SET @inner_id=3;
EXECUTE uncacheable_stmt USING @id, @inner_id;

SHOW STATUS LIKE 'Cached_plan_count';
SHOW STATUS LIKE 'Cached_plan_hits';
let $pc_count= query_get_value(SHOW STATUS LIKE 'Cached_plan_count', Value, 1);
if ($pc_count != 0) {
  --die uncacheable scalar fallback leaked a READY cached plan
}
let $pc_hits= query_get_value(SHOW STATUS LIKE 'Cached_plan_hits', Value, 1);
if ($pc_hits != 0) {
  --die uncacheable scalar fallback produced cached hits
}
let $pc_invalidations_after= query_get_value(SHOW STATUS LIKE 'Cached_plan_invalidations', Value, 1);
if ($pc_invalidations_after != $pc_invalidations_before) {
  --die uncacheable scalar fallback changed Cached_plan_invalidations
}
DEALLOCATE PREPARE uncacheable_stmt;

SET SESSION rds_plan_cache=@old_rds_plan_cache;
DROP TABLE pc5h_scalar_inner;
DROP TABLE pc5h_scalar_outer;
