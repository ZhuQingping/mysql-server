--echo End of 4.1 tests


#
# Bug#18775 - Temporary table from alter table visible to other threads
#
# REPAIR TABLE ... USE_FRM on temporary table crashed the table or server.
--disable_warnings
DROP TABLE IF EXISTS tt1;
--enable_warnings
CREATE TEMPORARY TABLE tt1 (c1 INT);
REPAIR TABLE tt1 USE_FRM;
DROP TABLE tt1;


--echo #
--echo # Bug #48248 assert in MDL_ticket::upgrade_shared_lock_to_exclusive
--echo #

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1(a INT);
LOCK TABLES t1 READ;
REPAIR TABLE t1;

UNLOCK TABLES;
DROP TABLE t1;


--echo #
--echo # Test for bug #50784 "MDL: Assertion `m_tickets.is_empty() ||
--echo #                      m_tickets.front() == m_trans_sentinel'"
--echo #
--disable_warnings
drop tables if exists t1, t2;
--enable_warnings
create table t1 (i int);
create table t2 (j int);
set @@autocommit= 0;
repair table t1, t2;
set @@autocommit= default;
drop tables t1, t2;



--echo #
--echo # Test for BUG2025122427775 - when REPAIR TABLE . USE_FRM
--echo #             the open_and_lock_tables() success but the
--echo #             acquire_shared_backup_lock() fails, the next
--echo #             ddl in same session will causes server crash.

--echo # create 2 connection
connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

--echo # con1 get BACKUP_LOCK  MLD_SHARED
connection con1;
USE test;
CREATE TABLE t2(a INT);
LOCK INSTANCE FOR BACKUP;


--echo # con2 REPAIR temp table t1, for TEMPORARY TABLE
--echo # open_and_lock_tables() will success, but
--echo # acquire_shared_backup_lock() will be blocked by con1.
--echo # DDL after repair table will be execute normally.
connection con2;
USE test;
SET lock_wait_timeout=1;
CREATE TEMPORARY TABLE t1 (a int);
REPAIR TABLE t1 USE_FRM;
--error ER_LOCK_WAIT_TIMEOUT
alter table t2 add index(a);

--echo # con1 release BACKUP_LOCK  MLD_SHARED
connection con1;
UNLOCK INSTANCE;

--echo # con2 repair table and ddl will be execute normally
connection con2;
alter table t2 add index(a);
alter table t2 drop index a;
REPAIR TABLE t1 USE_FRM;
alter table t2 add index(a);
alter table t2 drop index a;
DROP TABLE t1;


--echo # clean up
connection default;
DROP TABLE t2;

disconnect con1;
disconnect con2;