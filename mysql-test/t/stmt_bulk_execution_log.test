--source include/no_valgrind_without_big.inc
--source include/have_myisam.inc
--source include/have_plugin_auth.inc

SET @old_general_log= @@global.general_log;
SET @old_slow_query_log= @@global.slow_query_log;
SET @old_log_output = @@global.log_output;
SET @old_general_log_file = @@global.general_log_file;
SET @old_slow_query_log_file = @@global.slow_query_log_file;
SET @old_long_query_time = @@global.long_query_time;

--let $LOG_DIR= $MYSQLTEST_VARDIR/log

SET GLOBAL log_output="FILE";
--replace_result $LOG_DIR LOG_DIR
eval SET GLOBAL general_log_file = '$LOG_DIR/master.log';
SET GLOBAL general_log= 'ON';
--replace_result $LOG_DIR LOG_DIR
eval SET GLOBAL slow_query_log_file = '$LOG_DIR/master-slow.log';
SET GLOBAL slow_query_log= 'ON';
SET GLOBAL long_query_time = 1;

--echo Empty general log and slow query log
--exec echo "" > $LOG_DIR/master.log
--exec echo "" > $LOG_DIR/master-slow.log

--exec echo "$MYSQL_CLIENT_TEST" > $LOG_DIR/mysql_client_test.out.log 2>&1
--exec $MYSQL_CLIENT_TEST --getopt-ll-test=25600M $PLUGIN_AUTH_CLIENT_OPT stmt_bulk_test_general_and_slow_log  >> $LOG_DIR/mysql_client_test.out.log 2>&1

--echo == VERIFY GENERAL LOG ==
--echo INSERT: 1 line
--exec grep "/\* Bulk exection, might have more parameter sets \*/INSERT INTO tbl VALUES" $LOG_DIR/master.log | wc -l

--echo UPDATE: 5 line
--exec grep "UPDATE tbl SET a = 1" $LOG_DIR/master.log | wc -l

--echo REPLACE: 1 line
--exec grep "/\* Bulk exection, might have more parameter sets \*/REPLACE INTO tbl (a, b) VALUES" $LOG_DIR/master.log | wc -l

--echo DELETE: 5 line
--exec grep "DELETE FROM tbl WHERE a = " $LOG_DIR/master.log | grep -v "DELETE FROM tbl WHERE a = ?" | wc -l

--echo == VERIFY SLOW QUERY LOG ==
--echo INSERT: 1 line
--exec grep "/\* Bulk exection, might have more parameter sets \*/INSERT INTO tbl VALUES (1, 'Alice');"  $LOG_DIR/master-slow.log | wc -l

--echo UPDATE: 1 line
--exec grep "UPDATE tbl SET a = 15 WHERE b = 'Eve'" $LOG_DIR/master-slow.log | wc -l

--echo REPLACE: 1 line
--exec grep "/\* Bulk exection, might have more parameter sets \*/REPLACE INTO tbl (a, b) VALUES (22, 'Bob');" $LOG_DIR/master-slow.log | wc -l

--echo DELETE: 1 line
--exec grep "DELETE FROM tbl WHERE a = 15;" $LOG_DIR/master-slow.log | wc -l

SET @@global.general_log= @old_general_log;
SET @@global.slow_query_log= @old_slow_query_log;
SET @@global.log_output= @old_log_output;
SET @@global.general_log_file = @old_general_log_file;
SET @@global.slow_query_log_file = @old_slow_query_log_file;
SET @@global.long_query_time = @old_long_query_time;

