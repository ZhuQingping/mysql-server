--source include/have_dstore.inc

--echo #
--echo # BUG2025092025863: create table ... as select * from ... using wrong engine
--echo #
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--shutdown_server
--source include/wait_until_disconnected.inc

--echo # Restart the server using ONLY_DSTORE engine mode
--exec echo "restart: --storage_engine_mode=ONLY_DSTORE --default_storage_engine=Dstore --default_tmp_storage_engine=Dstore --disabled_storage_engines=InnoDB,CSV,Memory,MyISAM,MRG_MyISAM --transaction_isolation=READ-COMMITTED" >$MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc

--disable_warnings
SET SQL_MODE='';
--enable_warnings

CREATE TABLE MyISAM_2_Dstore(i int) ENGINE=MyISAM;
SHOW CREATE TABLE MyISAM_2_Dstore;
CREATE TABLE InnoDB_2_Dstore ENGINE=InnoDB AS SELECT * FROM MyISAM_2_Dstore;
SHOW CREATE TABLE InnoDB_2_Dstore;

DROP TABLE MyISAM_2_Dstore;
DROP TABLE InnoDB_2_Dstore;

--source include/restart_mysqld.inc
