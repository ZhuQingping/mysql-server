--echo # BUG2025030728654
set @saved_rds_load_data_infile_enable = @@global.rds_load_data_infile_enable;
create table t1 (a date, b date, c date not null, d date);
load data infile '../../std_data/loaddata1.dat' ignore into table t1 fields terminated by ',';
SELECT * from t1;
drop table t1;

create table t1 (a date, b date, c date not null, d date);
set global rds_load_data_infile_enable = off;
--error ER_LOAD_DATA_INFILE_DISABLED
load data infile '../../std_data/loaddata1.dat' ignore into table t1 fields terminated by ',';
SELECT * from t1;

drop table t1;
set global rds_load_data_infile_enable = @saved_rds_load_data_infile_enable;
