--echo #READ COMMITTED:  Skipping pk access- check lock release

--echo # ---------------------------------------------------


--echo # ---------------------------------------------------

--echo # WITHOUT  OP

--echo # ---------------------------------------------------

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

CREATE TABLE t1 (b INT, PRIMARY KEY (b));
