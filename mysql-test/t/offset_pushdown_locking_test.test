--echo # End of range check does not apply with ICP - stopped by ICP out of range before OFFSET 5000 is reached
SET rds_empty_redundant_check_in_range_scan = false;
SET @save_skipped_rows = (SELECT variable_value FROM performance_schema.global_status WHERE LOWER(variable_name) = 'innodb_rds_rows_skipped_by_offset_pushdown');
SELECT * FROM t2 WHERE a = 1 AND b < 11 LIMIT 1 OFFSET 5000;
SELECT variable_value - @save_skipped_rows FROM performance_schema.global_status WHERE LOWER(variable_name) = 'innodb_rds_rows_skipped_by_offset_pushdown';

--echo # ICP_OUT_OF_RANGE evaluated before systematic end of range check for locking scenario- no need to check end of range if idx_cond==true
start transaction;
