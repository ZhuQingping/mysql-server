# The test case to identify new added plugins

# The expected plugin inventory includes DStore information-schema plugins.
# This build intentionally has no DStore engine, so this is a DStore-capability
# test rather than a generic non-default-engine test.
--source include/have_dstore.inc
select * from information_schema.plugins where plugin_name like '%dstore%' or plugin_name in ('audit_log','threadpool') order by plugin_name;
