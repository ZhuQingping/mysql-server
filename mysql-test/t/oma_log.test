--echo
--echo # dump content of OMA log.
--echo
 
let OMA_LOG= `SELECT @@global.rds_oma_log_file`;
 
--perl
   use strict;
 
   my $file= $ENV{'OMA_LOG'} or die("oma log not set");
   my $result=0;
 
   open(FILE, "$file") or die("Unable to open $file: $!");
   while (<FILE>) {
     my $line = $_;
 
     if ($line !~ m/^(# Query_time|# Time|Tcp port|# User)|(Source distribution|mysqld)/) {
       #$line =~ s/Thread_id: \d* Schema:/Thread_id: 0 Schema:/;
       #$line =~ m/(Rows_sent.*) Start.*/;
       print "$line";
     }
   }
   close(FILE);
 
EOF
 
--echo
--echo # dump content of OMA log end.
--echo
 
--echo
--echo #Test log output while switch off..
--echo
-- let $OMA_TEST_DIR= `select @@datadir`
--replace_result $OMA_TEST_DIR ...
eval SET GLOBAL rds_oma_log_file= '$OMA_TEST_DIR/my_oma_empty.log';
SET GLOBAL rds_oma_log = OFF;
 
let OMA_LOG= `SELECT @@global.rds_oma_log_file`;
 
--echo
--echo # dump content of OMA log.
--echo
 
--perl
   use strict;
 
   my $file= $ENV{'OMA_LOG'} or die("oma log not set");
   my $result=0;
 
   open(FILE, "$file") or die("Unable to open $file: $!");
   while (<FILE>) {
     my $line = $_;
 
     if ($line !~ m/^(# Query_time|# Time|Tcp port|# User)|(Source distribution|mysqld)/) {
       print "$line";
     }
   }
   close(FILE);
 
EOF
 
--echo
--echo # dump content of OMA log end.
--echo
 
--remove_file $OMA_TEST_DIR/my_oma_empty.log
--remove_file $MYSQL_TMP_DIR/my_oma.log
