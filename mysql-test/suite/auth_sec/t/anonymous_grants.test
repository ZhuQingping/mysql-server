--echo #
--echo # bug#27375069 CRASHES ON SHOW GRANTS FOR ANONYMOUS USER
--echo #

--disable_query_log
SET @old_rds_allow_empty_users = @@global.rds_allow_empty_users;
SET @@global.rds_allow_empty_users = ON;
--enable_query_log

create user ''@'localhost';
grant all privileges on *.* to ''@'localhost';
show grants for ''@'localhost';

--disable_query_log
SET @@global.rds_allow_empty_users = @old_rds_allow_empty_users;
--enable_query_log

--echo # cleanup
drop user ''@'localhost';
