############################################################
Establish a master-replica replication relationship based on physical replication.
############################################################
include/master-slave.inc
[connection master]
#
# 1. Initialize the required variables, then disconnect the subsequent master-replica replication connections.
#
[connection master]
[connection slave]
STOP REPLICA;
RESET REPLICA ALL;
#
# 2. Since physical replication does not support DDL operations at present, execute all required DDL statements first.
#
create database copy_database;
use copy_database;
CREATE TABLE copy_table (
id INT PRIMARY KEY,
data VARCHAR(100)
) engine = dstore;
#
# 3. Shutdown the primary and standby instances.
#
include/rpl_stop_server.inc [server_number=1]
include/rpl_stop_server.inc [server_number=2]
#
# 4. Copy the data directory of the primary to that of the standby.
#
#
# 5. Start the primary and standby instances with new parameters for establishing a master-replica physical replication relationship.
#
include/rpl_start_server.inc [server_number=1]
include/rpl_start_server.inc [server_number=2]
#
# 6. Confirm that the primary and standby servers start with the new data directory.
#
include/assert.inc [Database copy_database should exist (only one record)]
include/assert.inc [Table copy_table should exist in database copy_database (only one record)]
use copy_database;
show tables;
Tables_in_copy_database
copy_table
include/assert.inc [Database copy_database should exist (only one record)]
include/assert.inc [Table copy_table should exist in database copy_database (only one record)]
use copy_database;
show tables;
Tables_in_copy_database
copy_table
#
# 7. Install the plugin on both the primary and standby servers, and establish a master-replica physical replication relationship.
#
#
# Install the primary server's plugin and set enabled_wal to ON.
#
INSTALL PLUGIN rpl_semi_sync_source SONAME 'semisync_source.so';
INSTALL PLUGIN rpl_semi_sync_replica SONAME 'semisync_replica.so';
SET GLOBAL rpl_semi_sync_source_enabled_wal = 1;
SET GLOBAL rpl_semi_sync_replica_enabled_wal = 1;
SET GLOBAL rds_physical_rpl_sender_packet_size = 1;
#
# dstore_enable_standby_role should show as false, indicating that the current node is the source.
#
SHOW VARIABLES LIKE 'server_id';
Variable_name	Value
server_id	1
SHOW VARIABLES LIKE 'dstore_enable_standby_role';
Variable_name	Value
dstore_enable_standby_role	OFF
#
# Install the standby server's plugin and set enabled_wal to ON.
#
INSTALL PLUGIN rpl_semi_sync_source SONAME 'semisync_source.so';
INSTALL PLUGIN rpl_semi_sync_replica SONAME 'semisync_replica.so';
SET GLOBAL rpl_semi_sync_source_enabled_wal = 1;
SET GLOBAL rpl_semi_sync_replica_enabled_wal = 1;
SET GLOBAL rds_physical_rpl_sender_packet_size = 1;
#
# dstore_enable_standby_role should show as true, indicating that the current node is the replica.
#
SHOW VARIABLES LIKE 'server_id';
Variable_name	Value
server_id	2
SHOW VARIABLES LIKE 'dstore_enable_standby_role';
Variable_name	Value
dstore_enable_standby_role	ON
#
# Configure the replica and check whether it is configured correctly.
#
STOP REPLICA;
Warnings:
Note	3084	Replication thread(s) for channel '' are already stopped.
RESET REPLICA ALL;
CHANGE REPLICATION SOURCE TO SOURCE_HOST='127.0.0.1', SOURCE_PORT=SERVER_MYPORT_1, SOURCE_USER='root', SOURCE_HEARTBEAT_PERIOD = 100 FOR CHANNEL 'dstore_wal_replication_channel';;
include/assert.inc [Channel name should be 'dstore_wal_replication_channel']
Slave_IO_Running should be OFF.
select rcs.SERVICE_STATE as Slave_IO_Running from performance_schema.replication_connection_status rcs;
Slave_IO_Running
OFF
START REPLICA;
#
# Slave_IO_Running should be ON.
#
select rcs.SERVICE_STATE as Slave_IO_Running from performance_schema.replication_connection_status rcs;
Slave_IO_Running
ON
CALL mtr.add_suppression(".* failed on net_flush().*");
#
# 1. SQLCOM_CREATE_USER
#
CREATE USER 'test_create_user'@'%' IDENTIFIED BY 'Pass123!';
---------------------
SELECT User, Host FROM mysql.user 
WHERE User = 'test_create_user' AND Host = '%';
User	Host
test_create_user	%
#
# 2. SQLCOM_ALTER_USER
#
ALTER USER 'test_create_user'@'%' IDENTIFIED BY 'NewPass123!';
FLUSH PRIVILEGES;
---------------------
SELECT User, Host FROM mysql.user 
WHERE User = 'test_create_user' AND Host = '%';
User	Host
test_create_user	%
SELECT CURRENT_USER();
CURRENT_USER()
root@localhost
SELECT CURRENT_USER();
CURRENT_USER()
test_create_user@%
#
# 3. SQLCOM_SET_PASSWORD
#
SET PASSWORD FOR 'test_create_user'@'%' = 'NewNewPass123!';
FLUSH PRIVILEGES;
---------------------
SELECT User, Host FROM mysql.user 
WHERE User = 'test_create_user' AND Host = '%';
User	Host
test_create_user	%
SELECT CURRENT_USER();
CURRENT_USER()
root@localhost
SELECT CURRENT_USER();
CURRENT_USER()
test_create_user@%
#
# 4. SQLCOM_RENAME_USER
#
RENAME USER 'test_create_user'@'%' TO 'new_name_user'@'%';
---------------------
SELECT User, Host FROM mysql.user 
WHERE User = 'new_name_user' AND Host = '%';
User	Host
new_name_user	%
#
# 5. SQLCOM_CREATE_ROLE
#
CREATE ROLE 'test_role_1';
---------------------
SELECT User, Host, authentication_string 
FROM mysql.user 
WHERE User = 'test_role_1' AND Host = '%' 
AND authentication_string = '';
User	Host	authentication_string
test_role_1	%	
#
# 6. SQLCOM_GRANT_ROLE
#
GRANT 'test_role_1' TO 'new_name_user'@'%';
---------------------
SELECT * FROM mysql.role_edges 
WHERE FROM_USER = 'test_role_1' 
AND TO_USER = 'new_name_user' 
AND TO_HOST = '%';
FROM_HOST	FROM_USER	TO_HOST	TO_USER	WITH_ADMIN_OPTION
%	test_role_1	%	new_name_user	N
#
# 7. SQLCOM_ALTER_USER_DEFAULT_ROLE
#
# Before setting the default role (there should be no records)
SELECT USER, HOST, DEFAULT_ROLE_USER, DEFAULT_ROLE_HOST 
FROM mysql.default_roles 
WHERE USER = 'new_name_user' AND HOST = '%';
USER	HOST	DEFAULT_ROLE_USER	DEFAULT_ROLE_HOST
ALTER USER 'new_name_user'@'%' DEFAULT ROLE 'test_role_1';
# After setting the default role (there should be records)
SELECT USER, HOST, DEFAULT_ROLE_USER, DEFAULT_ROLE_HOST 
FROM mysql.default_roles 
WHERE USER = 'new_name_user' AND HOST = '%';
USER	HOST	DEFAULT_ROLE_USER	DEFAULT_ROLE_HOST
new_name_user	%	test_role_1	%
---------------------
# After setting the default role (there should be records)
SELECT USER, HOST, DEFAULT_ROLE_USER, DEFAULT_ROLE_HOST 
FROM mysql.default_roles 
WHERE USER = 'new_name_user' AND HOST = '%';
USER	HOST	DEFAULT_ROLE_USER	DEFAULT_ROLE_HOST
new_name_user	%	test_role_1	%
#
# 8. SQLCOM_REVOKE_ROLE
#
REVOKE 'test_role_1' FROM 'new_name_user'@'%';
---------------------
# No records expected, as the role has been revoked.
SELECT * FROM mysql.role_edges 
WHERE FROM_USER = 'test_role_1' 
AND TO_USER = 'new_name_user' 
AND TO_HOST = '%';
FROM_HOST	FROM_USER	TO_HOST	TO_USER	WITH_ADMIN_OPTION
#
# 9. SQLCOM_GRANT
#
# Grant global SELECT and UPDATE privileges to the user
GRANT SELECT, UPDATE ON *.* TO 'new_name_user'@'%';
# Grant global UPDATE privilege to the role
GRANT UPDATE ON *.* TO 'test_role_1';
FLUSH PRIVILEGES;
GRANT 'test_role_1' TO 'new_name_user'@'%';
---------------------
# Verify user privileges
SHOW GRANTS FOR 'new_name_user'@'%';
Grants for new_name_user@%
GRANT SELECT, UPDATE ON *.* TO `new_name_user`@`%`
GRANT `test_role_1`@`%` TO `new_name_user`@`%`
# Verify role privileges
SHOW GRANTS FOR 'test_role_1';
Grants for test_role_1@%
GRANT UPDATE ON *.* TO `test_role_1`@`%`
# Verify the privilege bits in the mysql.user table
SELECT 
User, Host,
Select_priv, Insert_priv, Update_priv, Delete_priv,
Create_priv, Drop_priv
FROM mysql.user 
WHERE User = 'new_name_user' AND Host = '%';
User	Host	Select_priv	Insert_priv	Update_priv	Delete_priv	Create_priv	Drop_priv
new_name_user	%	Y	N	Y	N	N	N
SELECT * FROM mysql.role_edges 
WHERE FROM_USER = 'test_role_1' 
AND TO_USER = 'new_name_user' 
AND TO_HOST = '%';
FROM_HOST	FROM_USER	TO_HOST	TO_USER	WITH_ADMIN_OPTION
%	test_role_1	%	new_name_user	N
#
# 10. SQLCOM_REVOKE
#
# Revoke partial privileges from the user
REVOKE SELECT ON *.* FROM 'new_name_user'@'%';
REVOKE UPDATE ON *.* FROM 'test_role_1';
FLUSH PRIVILEGES;
---------------------
SELECT 
User, Host,
Select_priv, Update_priv
FROM mysql.user 
WHERE User = 'new_name_user' AND Host = '%';
User	Host	Select_priv	Update_priv
new_name_user	%	N	Y
#
# 11. SQLCOM_REVOKE_ALL
#
# Revoke all privileges of the user (including those obtained via roles)
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'new_name_user'@'%';
# Revoke all privileges from the role
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'test_role_1';
FLUSH PRIVILEGES;
---------------------
SHOW GRANTS FOR 'new_name_user'@'%';
Grants for new_name_user@%
GRANT USAGE ON *.* TO `new_name_user`@`%`
GRANT `test_role_1`@`%` TO `new_name_user`@`%`
SHOW GRANTS FOR 'test_role_1';
Grants for test_role_1@%
GRANT USAGE ON *.* TO `test_role_1`@`%`
# Verify role association (still exists; REVOKE ALL does not revoke role associations)
SELECT * FROM mysql.role_edges 
WHERE FROM_USER = 'test_role_1' 
AND TO_USER = 'new_name_user' 
AND TO_HOST = '%';
FROM_HOST	FROM_USER	TO_HOST	TO_USER	WITH_ADMIN_OPTION
%	test_role_1	%	new_name_user	N
#
# 12. SQLCOM_DROP_USER
#
DROP USER 'new_name_user'@'%';
---------------------
SELECT User, Host FROM mysql.user 
WHERE User = 'new_name_user' AND Host = '%';
User	Host
#
# 13. SQLCOM_DROP_ROLE
#
DROP ROLE 'test_role_1';
---------------------
SELECT User, Host, authentication_string 
FROM mysql.user 
WHERE User = 'test_role_1' AND Host = '%' 
AND authentication_string = '';
User	Host	authentication_string
############################################################
# Uninstall the plugins, reset the variables, and restore the original master-replica replication relationship.
############################################################
#
# 1. Shutdown the mysqld instances of the master and replica servers launched with the new data directory.
#
STOP REPLICA;
RESET REPLICA ALL FOR CHANNEL 'dstore_wal_replication_channel';
include/stop_wal_dump_threads.inc
SET GLOBAL rpl_semi_sync_source_enabled_wal = 0;
SET GLOBAL rpl_semi_sync_replica_enabled_wal = 0;
UNINSTALL PLUGIN rpl_semi_sync_source;
UNINSTALL PLUGIN rpl_semi_sync_replica;
use mtr;
SET GLOBAL rpl_semi_sync_source_enabled_wal = 0;
SET GLOBAL rpl_semi_sync_replica_enabled_wal = 0;
UNINSTALL PLUGIN rpl_semi_sync_source;
UNINSTALL PLUGIN rpl_semi_sync_replica;
use mtr;
#
# 2. Shutdown the mysqld instances of the master and replica servers launched with the new data directory.
#
include/rpl_stop_server.inc [server_number=1]
include/rpl_stop_server.inc [server_number=2]
# Delete the directories of the primary and standby servers.
#
# 3. Restart the mysqld instances of the master and replica servers using the configurations from the opt file.
#
include/rpl_start_server.inc [server_number=1]
show databases;
Database
__recyclebin__
copy_database
information_schema
mtr
mysql
performance_schema
sys
test
drop database copy_database;
use mtr;
include/rpl_start_server.inc [server_number=2]
use mtr;
