#
# 4.0 SQLCOM_CREATE_FUNCTION
#
CREATE FUNCTION fn_get_customer_balance_abs(
p_w_id SMALLINT,
p_d_id TINYINT,
p_c_id INT
) RETURNS DECIMAL(12,2)
DETERMINISTIC
READS SQL DATA
BEGIN
DECLARE balance_abs DECIMAL(12,2);
SELECT ABS(c_balance) INTO balance_abs
FROM customer
WHERE c_w_id = p_w_id AND c_d_id = p_d_id AND c_id = p_c_id;
RETURN balance_abs;
END$$
---------------------
SELECT ROUTINE_NAME, ROUTINE_TYPE 
FROM INFORMATION_SCHEMA.ROUTINES 
WHERE ROUTINE_SCHEMA = 'tpcc' AND ROUTINE_NAME = 'fn_get_customer_balance_abs';
ROUTINE_NAME	ROUTINE_TYPE
fn_get_customer_balance_abs	FUNCTION
#
# 4.1 SQLCOM_ALTER_FUNCTION
#
ALTER FUNCTION fn_get_customer_balance_abs COMMENT 'test SQLCOM_ALTER_FUNCTION';
---------------------
SELECT SPECIFIC_NAME, ROUTINE_COMMENT FROM INFORMATION_SCHEMA.ROUTINES WHERE ROUTINE_SCHEMA='tpcc' 
AND ROUTINE_NAME='fn_get_customer_balance_abs' AND ROUTINE_COMMENT='test SQLCOM_ALTER_FUNCTION';
SPECIFIC_NAME	ROUTINE_COMMENT
fn_get_customer_balance_abs	test SQLCOM_ALTER_FUNCTION
#
# 5. SQLCOM_CREATE_VIEW
#
CREATE VIEW v_high_value_customers AS
SELECT c_w_id, c_d_id, c_id, c_first, c_middle, c_last, c_balance
FROM customer
WHERE c_balance < -100.00;
---------------------
SELECT 
TABLE_NAME AS view_name,
VIEW_DEFINITION AS view_definition,
TABLE_SCHEMA AS database_name
FROM information_schema.VIEWS 
WHERE TABLE_NAME = 'v_high_value_customers';
view_name	view_definition	database_name
v_high_value_customers	select `tpcc`.`customer`.`c_w_id` AS `c_w_id`,`tpcc`.`customer`.`c_d_id` AS `c_d_id`,`tpcc`.`customer`.`c_id` AS `c_id`,`tpcc`.`customer`.`c_first` AS `c_first`,`tpcc`.`customer`.`c_middle` AS `c_middle`,`tpcc`.`customer`.`c_last` AS `c_last`,`tpcc`.`customer`.`c_balance` AS `c_balance` from `tpcc`.`customer` where (`tpcc`.`customer`.`c_balance` < -(100.00))	tpcc
#
# 6. SQLCOM_CREATE_TRIGGER
#
CREATE TRIGGER tr_customer_insert BEFORE INSERT ON customer FOR EACH ROW SET NEW.c_since = NOW();
---------------------
SELECT TRIGGER_NAME FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA='tpcc' AND TRIGGER_NAME='tr_customer_insert';
TRIGGER_NAME
tr_customer_insert
#
# 7.0 SQLCOM_CREATE_EVENT
#
CREATE EVENT IF NOT EXISTS ev_insert_test_customer
ON SCHEDULE EVERY 1 MINUTE  -- 执行频率：每分钟一次
DO
INSERT INTO customer (
c_id, c_d_id, c_w_id, c_first, c_middle, c_last, c_balance
) VALUES (
999, 1, 1, 'test', 'xx', 'user', -50.00  -- 固定测试值
);
---------------------
SELECT EVENT_NAME, EVENT_SCHEMA, STATUS 
FROM INFORMATION_SCHEMA.EVENTS 
WHERE EVENT_SCHEMA = 'tpcc' AND EVENT_NAME = 'ev_insert_test_customer';
EVENT_NAME	EVENT_SCHEMA	STATUS
ev_insert_test_customer	tpcc	ENABLED
#
# 7.1 SQLCOM_ALTER_EVENT
#
ALTER EVENT ev_insert_test_customer
ON SCHEDULE EVERY 1 DAY 
DO
INSERT INTO customer (
c_id, c_d_id, c_w_id, c_first, c_middle, c_last, c_balance
) VALUES (
999, 1, 1, 'test', 'xx', 'user', -50.00
);
---------------------
SELECT EVENT_NAME, EVENT_SCHEMA, STATUS, INTERVAL_VALUE 
FROM INFORMATION_SCHEMA.EVENTS 
WHERE EVENT_SCHEMA = 'tpcc' AND EVENT_NAME = 'ev_insert_test_customer';
EVENT_NAME	EVENT_SCHEMA	STATUS	INTERVAL_VALUE
ev_insert_test_customer	tpcc	ENABLED	1
