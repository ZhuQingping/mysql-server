#
# 二、Execute the corresponding DDL statements for SQLCOM_CREATE_VIEW, SQLCOM_ALTER_VIEW, and SQLCOM_DROP_VIEW.
#
#
# 1 SQLCOM_CREATE_VIEW
#
# 1 Create an associated view: Employee and department information
CREATE VIEW v_emp_dept AS
SELECT 
e.emp_id,
e.emp_name,
e.department,
e.salary,
d.location,
d.budget
FROM employees e
JOIN departments d ON e.department = d.dept_name
WHERE e.status = 'ACTIVE';
# 2. Create an aggregate view: Department statistical information
CREATE VIEW v_dept_stats AS
SELECT 
d.dept_name,
d.location,
COUNT(e.emp_id) AS employee_count,
SUM(e.salary) AS total_salary,
AVG(e.salary) AS avg_salary,
MIN(e.hire_date) AS earliest_hire,
MAX(e.hire_date) AS latest_hire
FROM departments d
LEFT JOIN employees e ON d.dept_name = e.department AND e.status = 'ACTIVE'
GROUP BY d.dept_name, d.location;
# 3 Create a complex view: Employee project participation status
CREATE VIEW v_emp_project_details AS
SELECT 
e.emp_id,
e.emp_name,
e.department,
p.project_name,
p.status AS project_status,
ep.role,
ep.hours_assigned,
p.start_date,
p.end_date,
CASE 
WHEN CURDATE() BETWEEN p.start_date AND p.end_date THEN '进行中'
        WHEN CURDATE() > p.end_date THEN '已结束'
        ELSE '未开始'
    END AS timeline_status
FROM employees e
JOIN employee_projects ep ON e.emp_id = ep.emp_id
JOIN projects p ON ep.project_id = p.project_id
WHERE e.status = 'ACTIVE';
# 4 Create a view with calculated aggregation: Salary analysis
CREATE VIEW v_salary_analysis AS
SELECT 
department,
COUNT(*) AS emp_count,
SUM(salary) AS total_salary,
AVG(salary) AS avg_salary,
MIN(salary) AS min_salary,
MAX(salary) AS max_salary,
(MAX(salary) - MIN(salary)) AS salary_range,
ROUND((MAX(salary) - MIN(salary)) / AVG(salary) * 100, 2) AS range_percentage
FROM employees
WHERE status = 'ACTIVE'
 GROUP BY department;
# 5 Create a nested view: A view based on other views
CREATE VIEW v_nested_view AS
SELECT 
v.dept_name,
v.employee_count,
v.total_salary,
ROUND(v.total_salary / NULLIF(v.employee_count, 0), 2) AS per_capita_cost
FROM v_dept_stats v;
# 6 Create a view for verifying the delete operation
CREATE VIEW v_to_delete AS
SELECT emp_id, emp_name, department, salary, hire_date
FROM employees
WHERE status = 'ACTIVE'
WITH CHECK OPTION;
#
# 2 SQLCOM_ALTER_VIEW
#
ALTER VIEW v_emp_dept AS
SELECT 
e.emp_id,
e.emp_name,
e.department,
e.salary,
d.location,
d.budget,
CASE 
WHEN e.salary > 10000 THEN '高薪'
        WHEN e.salary > 8000 THEN '中薪'
        ELSE '低薪'
    END AS salary_level
FROM employees e
JOIN departments d ON e.department = d.dept_name
WHERE e.status = 'ACTIVE' AND e.salary > 0;
ALTER VIEW v_dept_stats AS
SELECT 
d.dept_name,
d.location,
d.budget,
COUNT(e.emp_id) AS employee_count,
SUM(e.salary) AS total_salary,
AVG(e.salary) AS avg_salary,
MIN(e.hire_date) AS earliest_hire,
MAX(e.hire_date) AS latest_hire,
ROUND(SUM(e.salary) / d.budget * 100, 2) AS salary_budget_ratio
FROM departments d
LEFT JOIN employees e ON d.dept_name = e.department AND e.status = 'ACTIVE'
GROUP BY d.dept_name, d.location, d.budget;
#
# 3 SQLCOM_DROP_VIEW
#
DROP VIEW IF EXISTS v_to_delete;
# Check view metadata on the primary node
SELECT 
TABLE_NAME,
CHECK_OPTION,
IS_UPDATABLE,
DEFINER,
SECURITY_TYPE
FROM INFORMATION_SCHEMA.VIEWS 
WHERE TABLE_SCHEMA = 'test_view_db'
ORDER BY TABLE_NAME;
TABLE_NAME	CHECK_OPTION	IS_UPDATABLE	DEFINER	SECURITY_TYPE
v_dept_stats	NONE	NO	root@localhost	DEFINER
v_emp_dept	NONE	YES	root@localhost	DEFINER
v_emp_project_details	NONE	YES	root@localhost	DEFINER
v_nested_view	NONE	NO	root@localhost	DEFINER
v_salary_analysis	NONE	NO	root@localhost	DEFINER
#
# 三、Check the DD on the standby node to ensure the correctness of metadata replay on the standby node.
#
USE test_view_db;
# Verify the view replay on the standby node
SELECT 
TABLE_NAME,
CHECK_OPTION,
IS_UPDATABLE,
DEFINER,
SECURITY_TYPE
FROM INFORMATION_SCHEMA.VIEWS 
WHERE TABLE_SCHEMA = 'test_view_db'
ORDER BY TABLE_NAME;
TABLE_NAME	CHECK_OPTION	IS_UPDATABLE	DEFINER	SECURITY_TYPE
v_dept_stats	NONE	NO	root@localhost	DEFINER
v_emp_dept	NONE	YES	root@localhost	DEFINER
v_emp_project_details	NONE	YES	root@localhost	DEFINER
v_nested_view	NONE	NO	root@localhost	DEFINER
v_salary_analysis	NONE	NO	root@localhost	DEFINER
