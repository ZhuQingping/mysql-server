#
# 七、Modify and delete the replayed views on the new primary node to ensure the availability and operability of the replayed DDL.
#
# 1 Perform operations on the replayed views on the new primary node
ALTER VIEW v_emp_dept
AS
SELECT 
e.emp_id,
e.emp_name,
e.department,
e.salary,
d.location,
d.budget,
CASE 
WHEN e.salary > 10000 THEN '高薪'
        WHEN e.salary > 8000 THEN '中薪'
        ELSE '低薪'
    END AS salary_level,
CASE 
WHEN d.dept_name = '技术部' THEN '技术岗位'
        WHEN d.dept_name = '销售部' THEN '业务岗位'
        ELSE '职能岗位'
    END AS position_type
FROM employees e
JOIN departments d ON TRIM(e.department) = TRIM(d.dept_name)  -- 修复：加TRIM防空格，主备一致
WHERE e.status = 'ACTIVE' AND e.salary > 0;
DROP VIEW IF EXISTS v_salary_analysis;
# 2 Verify whether the new standby node has synchronized the modifications
USE test_view_db;
SELECT 
TABLE_NAME,
CHECK_OPTION,
IS_UPDATABLE,
DEFINER,
SECURITY_TYPE
FROM INFORMATION_SCHEMA.VIEWS 
WHERE TABLE_SCHEMA = 'test_view_db'
ORDER BY TABLE_NAME;
TABLE_NAME	CHECK_OPTION	IS_UPDATABLE	DEFINER	SECURITY_TYPE
v_dept_stats	NONE	NO	root@localhost	DEFINER
v_emp_dept	NONE	YES	root@localhost	DEFINER
v_emp_project_details	NONE	YES	root@localhost	DEFINER
v_nested_view	NONE	NO	root@localhost	DEFINER
############################################################
# Uninstall the plugins, reset the variables, and restore the original master-replica replication relationship.
############################################################
#
# 1. Shutdown the mysqld instances of the master and replica servers launched with the new data directory.
#
STOP REPLICA;
RESET REPLICA ALL FOR CHANNEL 'dstore_wal_replication_channel';
include/stop_wal_dump_threads.inc
SET GLOBAL rpl_semi_sync_source_enabled_wal = 0;
SET GLOBAL rpl_semi_sync_replica_enabled_wal = 0;
UNINSTALL PLUGIN rpl_semi_sync_source;
UNINSTALL PLUGIN rpl_semi_sync_replica;
use mtr;
SET GLOBAL rpl_semi_sync_source_enabled_wal = 0;
SET GLOBAL rpl_semi_sync_replica_enabled_wal = 0;
UNINSTALL PLUGIN rpl_semi_sync_source;
UNINSTALL PLUGIN rpl_semi_sync_replica;
use mtr;
#
# 2. Shutdown the mysqld instances of the master and replica servers launched with the new data directory.
#
include/rpl_stop_server.inc [server_number=1]
include/rpl_stop_server.inc [server_number=2]
# Delete the directories of the primary and standby servers.
#
# 3. Restart the mysqld instances of the master and replica servers using the configurations from the opt file.
#
include/rpl_start_server.inc [server_number=1]
show databases;
Database
__recyclebin__
copy_database
information_schema
mtr
mysql
performance_schema
sys
test
drop database copy_database;
use mtr;
include/rpl_start_server.inc [server_number=2]
use mtr;
