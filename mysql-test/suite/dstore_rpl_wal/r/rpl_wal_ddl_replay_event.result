############################################################
Establish a master-replica replication relationship based on physical replication.
############################################################
include/master-slave.inc
[connection master]
#
# 1. Initialize the required variables, then disconnect the subsequent master-replica replication connections.
#
[connection master]
[connection slave]
STOP REPLICA;
RESET REPLICA ALL;
#
# 2. Since physical replication does not support DDL operations at present, execute all required DDL statements first.
#
create database copy_database;
use copy_database;
CREATE TABLE copy_table (
id INT PRIMARY KEY,
data VARCHAR(100)
) engine = dstore;
#
# 3. Shutdown the primary and standby instances.
#
include/rpl_stop_server.inc [server_number=1]
include/rpl_stop_server.inc [server_number=2]
#
# 4. Copy the data directory of the primary to that of the standby.
#
#
# 5. Start the primary and standby instances with new parameters for establishing a master-replica physical replication relationship.
#
include/rpl_start_server.inc [server_number=1]
include/rpl_start_server.inc [server_number=2]
#
# 6. Confirm that the primary and standby servers start with the new data directory.
#
include/assert.inc [Database copy_database should exist (only one record)]
include/assert.inc [Table copy_table should exist in database copy_database (only one record)]
use copy_database;
show tables;
Tables_in_copy_database
copy_table
include/assert.inc [Database copy_database should exist (only one record)]
include/assert.inc [Table copy_table should exist in database copy_database (only one record)]
use copy_database;
show tables;
Tables_in_copy_database
copy_table
#
# 7. Install the plugin on both the primary and standby servers, and establish a master-replica physical replication relationship.
#
#
# Install the primary server's plugin and set enabled_wal to ON.
#
INSTALL PLUGIN rpl_semi_sync_source SONAME 'semisync_source.so';
INSTALL PLUGIN rpl_semi_sync_replica SONAME 'semisync_replica.so';
SET GLOBAL rpl_semi_sync_source_enabled_wal = 1;
SET GLOBAL rpl_semi_sync_replica_enabled_wal = 1;
SET GLOBAL rds_physical_rpl_sender_packet_size = 1;
#
# dstore_enable_standby_role should show as false, indicating that the current node is the source.
#
SHOW VARIABLES LIKE 'server_id';
Variable_name	Value
server_id	1
SHOW VARIABLES LIKE 'dstore_enable_standby_role';
Variable_name	Value
dstore_enable_standby_role	OFF
#
# Install the standby server's plugin and set enabled_wal to ON.
#
INSTALL PLUGIN rpl_semi_sync_source SONAME 'semisync_source.so';
INSTALL PLUGIN rpl_semi_sync_replica SONAME 'semisync_replica.so';
SET GLOBAL rpl_semi_sync_source_enabled_wal = 1;
SET GLOBAL rpl_semi_sync_replica_enabled_wal = 1;
SET GLOBAL rds_physical_rpl_sender_packet_size = 1;
#
# dstore_enable_standby_role should show as true, indicating that the current node is the replica.
#
SHOW VARIABLES LIKE 'server_id';
Variable_name	Value
server_id	2
SHOW VARIABLES LIKE 'dstore_enable_standby_role';
Variable_name	Value
dstore_enable_standby_role	ON
#
# Configure the replica and check whether it is configured correctly.
#
STOP REPLICA;
Warnings:
Note	3084	Replication thread(s) for channel '' are already stopped.
RESET REPLICA ALL;
CHANGE REPLICATION SOURCE TO SOURCE_HOST='127.0.0.1', SOURCE_PORT=SERVER_MYPORT_1, SOURCE_USER='root', SOURCE_HEARTBEAT_PERIOD = 100 FOR CHANNEL 'dstore_wal_replication_channel';;
include/assert.inc [Channel name should be 'dstore_wal_replication_channel']
Slave_IO_Running should be OFF.
select rcs.SERVICE_STATE as Slave_IO_Running from performance_schema.replication_connection_status rcs;
Slave_IO_Running
OFF
START REPLICA;
#
# Slave_IO_Running should be ON.
#
select rcs.SERVICE_STATE as Slave_IO_Running from performance_schema.replication_connection_status rcs;
Slave_IO_Running
ON
############################################################
一、Set up the test environment.
二、Execute the corresponding DDL statements for SQLCOM_CREATE_EVENT, SQLCOM_DROP_EVENT, and SQLCOM_ALTER_EVENT.
三、Check the DD information on the standby node to ensure correct metadata replay.
四、Execute some SQL statements related to these DDL operations. After execution, perform a full table scan and select from the tables operated by the events, for later comparison on the new primary node to ensure the replay function works correctly.
五、Perform a switchover.
六、Select from the tables operated by the events on the new primary node, and compare the results with those from Step 4 to verify the correctness of the standby node replay function.
七、Check the scheduling parameters on the new primary node to verify whether the replayed events can be scheduled normally. Perform operations (alter and drop) on the replayed events to ensure the availability and operability of the replayed DDL results.
############################################################
#
# 一、Set up the test environment.
#
CREATE DATABASE IF NOT EXISTS test_event_db 
DEFAULT CHARACTER SET utf8mb4 
DEFAULT COLLATE utf8mb4_general_ci;
USE test_event_db;
CREATE TABLE event_log (
id INT AUTO_INCREMENT PRIMARY KEY,
event_type VARCHAR(50),
event_name VARCHAR(100),
execute_time DATETIME DEFAULT CURRENT_TIMESTAMP,
remark VARCHAR(200)
);
CREATE TABLE test_employees (
emp_id INT AUTO_INCREMENT PRIMARY KEY,
emp_name VARCHAR(100) NOT NULL,
department VARCHAR(50),
salary DECIMAL(10, 2),
hire_date DATE,
status VARCHAR(20) DEFAULT 'ACTIVE',
last_modified TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);
CREATE TABLE event_execution_log (
id INT AUTO_INCREMENT PRIMARY KEY,
event_name VARCHAR(100) NOT NULL,
execution_time DATETIME(6) DEFAULT CURRENT_TIMESTAMP(6),
executed_by VARCHAR(50) DEFAULT 'EVENT',
remarks TEXT
);
INSERT INTO test_employees (emp_name, department, salary, hire_date) VALUES
('张三', '技术部', 15000.00, '2020-01-15'),
('李四', '技术部', 12000.00, '2020-03-20'),
('王五', '销售部', 8000.00, '2021-05-10'),
('赵六', '人事部', 10000.00, '2019-11-30'),
('钱七', '销售部', 9000.00, '2022-02-14'),
('孙八', '财务部', 11000.00, '2021-07-01');
#
# 二、Execute the corresponding DDL statements for SQLCOM_CREATE_EVENT, SQLCOM_DROP_EVENT, and SQLCOM_ALTER_EVENT.
#
#
# SQLCOM_CREATE_EVENT
#
# 1 Create a one-time event
CREATE EVENT ev_one_time
ON SCHEDULE AT CURRENT_TIMESTAMP + INTERVAL 1 SECOND
ON COMPLETION NOT PRESERVE
COMMENT '一次性测试事件'
DO 
INSERT INTO event_log(event_type, event_name, remark) 
VALUES ('one_time', 'ev_one_time', '一次性事件执行');
# 2 Create recurring event
CREATE EVENT ev_daily
ON SCHEDULE EVERY 1 DAY
STARTS CURRENT_TIMESTAMP + INTERVAL 3 SECOND
ON COMPLETION PRESERVE
COMMENT '周期性测试事件'
DO 
INSERT INTO event_log(event_type, event_name, remark) 
VALUES ('daily', 'ev_daily', '周期性事件执行');
# 3 Create a test event in disabled state
CREATE EVENT ev_disabled
ON SCHEDULE EVERY 1 MINUTE
STARTS CURRENT_TIMESTAMP + INTERVAL 1 SECOND
ENDS CURRENT_TIMESTAMP + INTERVAL 1 HOUR
ON COMPLETION NOT PRESERVE
DISABLE
COMMENT '禁用状态测试事件'
DO 
INSERT INTO event_log(event_type, event_name, remark) 
VALUES ('disabled', 'ev_disabled', '禁用事件不应执行');
# 4 Create an event with conditions
CREATE EVENT e_dynamic_frequency
ON SCHEDULE EVERY 30 MINUTE
STARTS CURRENT_TIMESTAMP + INTERVAL 1 SECOND
COMMENT '根据数据量动态调整的执行事件'
DO
BEGIN
DECLARE v_record_count INT;
DECLARE v_frequency VARCHAR(50);
SELECT COUNT(*) INTO v_record_count FROM test_employees;
IF v_record_count < 10 THEN
SET v_frequency = '低频';
INSERT INTO event_execution_log (event_name, remarks)
VALUES ('e_dynamic_frequency', '数据量较少，执行低频操作');
ELSEIF v_record_count BETWEEN 10 AND 100 THEN
SET v_frequency = '中频';
INSERT INTO event_execution_log (event_name, remarks)
VALUES ('e_dynamic_frequency', '数据量适中，执行中频操作');
ELSE
SET v_frequency = '高频';
INSERT INTO event_execution_log (event_name, remarks)
VALUES ('e_dynamic_frequency', '数据量较大，执行高频操作');
END IF;
END$$
# 5 Create an event to verify deletion
CREATE EVENT ev_one_time_delete
ON SCHEDULE EVERY 1 DAY
STARTS CURRENT_TIMESTAMP + INTERVAL 1 DAY
ON COMPLETION PRESERVE
COMMENT '一个验证删除的事件'
DO 
INSERT INTO event_log(event_type, event_name, remark) 
VALUES ('daily', 'ev_one_time_delete', '一个验证删除的事件');
#
# SQLCOM_ALTER_EVENT
#
# 1 Alter the event schedule time
ALTER EVENT ev_daily
ON SCHEDULE EVERY 1 HOUR
STARTS TIMESTAMP(CURRENT_DATE, '00:30:00')
COMMENT '改为每2天执行一次';
# 2 Rename the event
ALTER EVENT ev_daily
RENAME TO ev_hour;
# 3 Alter the event status (enable/disable)
ALTER EVENT ev_hour DISABLE;
#
# SQLCOM_DROP_EVENT
#
DROP EVENT IF EXISTS ev_one_time_delete;
# View event metadata on the primary node
SELECT 
EVENT_NAME,
EVENT_SCHEMA,
DEFINER,
EVENT_TYPE
FROM INFORMATION_SCHEMA.EVENTS 
WHERE EVENT_SCHEMA = 'test_event_db'
ORDER BY EVENT_NAME;
EVENT_NAME	EVENT_SCHEMA	DEFINER	EVENT_TYPE
ev_disabled	test_event_db	root@localhost	RECURRING
ev_hour	test_event_db	root@localhost	RECURRING
e_dynamic_frequency	test_event_db	root@localhost	RECURRING
#
# 三、Check the DD information on the standby node to ensure correct metadata replay.
#
SELECT 
EVENT_NAME,
EVENT_SCHEMA,
DEFINER,
EVENT_TYPE
FROM INFORMATION_SCHEMA.EVENTS 
WHERE EVENT_SCHEMA = 'test_event_db'
ORDER BY EVENT_NAME;
EVENT_NAME	EVENT_SCHEMA	DEFINER	EVENT_TYPE
ev_disabled	test_event_db	root@localhost	RECURRING
ev_hour	test_event_db	root@localhost	RECURRING
e_dynamic_frequency	test_event_db	root@localhost	RECURRING
#
# 四、Execute some SQL statements related to these DDL operations. After execution, perform a full table scan and select from the tables operated by the events, for later comparison on the new primary node to ensure the replay function works correctly.
#
USE test_event_db;
# View the event_log table
SELECT id, event_type, event_name, remark FROM event_log ORDER BY id;
id	event_type	event_name	remark
1	one_time	ev_one_time	一次性事件执行
2	daily	ev_daily	周期性事件执行
# View the event_execution_log table
SELECT id, event_name, executed_by, remarks FROM event_execution_log ORDER BY id DESC LIMIT 10;
id	event_name	executed_by	remarks
1	e_dynamic_frequency	EVENT	数据量较少，执行低频操作
#
# 五、Perform a switchover.
#
############################################################
switchover_1
############################################################
# Demote the source to replica.
SET GLOBAL read_only = ON;
SET GLOBAL event_scheduler = OFF;
call rpl_wal.pdb_demote();
#
# dstore_enable_standby_role should show as true, indicating that the current node is the replica.
#
SHOW VARIABLES LIKE 'server_id';
Variable_name	Value
server_id	1
SHOW VARIABLES LIKE 'dstore_enable_standby_role';
Variable_name	Value
dstore_enable_standby_role	ON
#
# Promote the replica to source.
#
STOP REPLICA;
RESET REPLICA ALL FOR CHANNEL 'dstore_wal_replication_channel';
call rpl_wal.pdb_promote();
#
# dstore_enable_standby_role should show as false, indicating that the current node is the source.
#
SHOW VARIABLES LIKE 'server_id';
Variable_name	Value
server_id	2
SHOW VARIABLES LIKE 'dstore_enable_standby_role';
Variable_name	Value
dstore_enable_standby_role	OFF
#
# Clean the primary and standby servers.
#
include/stop_wal_dump_threads.inc
#
# Re-establish primary-standby relationship.
#
CHANGE REPLICATION SOURCE TO SOURCE_HOST='127.0.0.1', SOURCE_PORT=old_standby_port, SOURCE_USER='root', SOURCE_HEARTBEAT_PERIOD = 100 FOR CHANNEL 'dstore_wal_replication_channel';;
include/assert.inc [Channel name should be 'dstore_wal_replication_channel']
START REPLICA;
#
# Slave_IO_Running should be ON.
#
select rcs.SERVICE_STATE as Slave_IO_Running from performance_schema.replication_connection_status rcs;
Slave_IO_Running
ON
#
# Disable read-only mode on the new source.
#
SET GLOBAL read_only = OFF;
SET GLOBAL event_scheduler = ON;
#
# 六、Select from the tables operated by the events on the new primary node, and compare the results with those from Step 4 to verify the correctness of the standby node replay function.
#
USE test_event_db;
# View the event_log table
SELECT id, event_type, event_name, remark FROM event_log ORDER BY id;
id	event_type	event_name	remark
1	one_time	ev_one_time	一次性事件执行
2	daily	ev_daily	周期性事件执行
# View the event_execution_log table
SELECT id, event_name, executed_by, remarks FROM event_execution_log ORDER BY id DESC LIMIT 10;
id	event_name	executed_by	remarks
1	e_dynamic_frequency	EVENT	数据量较少，执行低频操作
#
# 七、Check the scheduling parameters on the new primary node to verify whether the replayed events can be scheduled normally. Perform operations (alter and drop) on the replayed events to ensure the availability and operability of the replayed DDL results.
#
# 1 Modify the event scheduling time
ALTER EVENT ev_hour
ON SCHEDULE EVERY 3 HOUR
COMMENT '在新主机上修改为每3小时执行';
# 2 Modify the status of the event
ALTER EVENT ev_disabled ENABLE;
SELECT 
EVENT_NAME,
EVENT_SCHEMA,
DEFINER,
EVENT_TYPE,
# EXECUTE_AT,
INTERVAL_VALUE,
INTERVAL_FIELD,
# STARTS,
# ENDS,
STATUS,
ON_COMPLETION,
# CREATED,
# LAST_ALTERED,
EVENT_COMMENT
FROM INFORMATION_SCHEMA.EVENTS 
WHERE EVENT_SCHEMA = 'test_event_db'
ORDER BY EVENT_NAME;
EVENT_NAME	EVENT_SCHEMA	DEFINER	EVENT_TYPE	INTERVAL_VALUE	INTERVAL_FIELD	STATUS	ON_COMPLETION	EVENT_COMMENT
ev_disabled	test_event_db	root@localhost	RECURRING	1	MINUTE	ENABLED	NOT PRESERVE	禁用状态测试事件
ev_hour	test_event_db	root@localhost	RECURRING	3	HOUR	DISABLED	PRESERVE	在新主机上修改为每3小时执行
e_dynamic_frequency	test_event_db	root@localhost	RECURRING	30	MINUTE	ENABLED	NOT PRESERVE	根据数据量动态调整的执行事件
############################################################
# Uninstall the plugins, reset the variables, and restore the original master-replica replication relationship.
############################################################
#
# 1. Shutdown the mysqld instances of the master and replica servers launched with the new data directory.
#
STOP REPLICA;
RESET REPLICA ALL FOR CHANNEL 'dstore_wal_replication_channel';
include/stop_wal_dump_threads.inc
SET GLOBAL rpl_semi_sync_source_enabled_wal = 0;
SET GLOBAL rpl_semi_sync_replica_enabled_wal = 0;
UNINSTALL PLUGIN rpl_semi_sync_source;
UNINSTALL PLUGIN rpl_semi_sync_replica;
use mtr;
SET GLOBAL rpl_semi_sync_source_enabled_wal = 0;
SET GLOBAL rpl_semi_sync_replica_enabled_wal = 0;
UNINSTALL PLUGIN rpl_semi_sync_source;
UNINSTALL PLUGIN rpl_semi_sync_replica;
use mtr;
#
# 2. Shutdown the mysqld instances of the master and replica servers launched with the new data directory.
#
include/rpl_stop_server.inc [server_number=1]
include/rpl_stop_server.inc [server_number=2]
# Delete the directories of the primary and standby servers.
#
# 3. Restart the mysqld instances of the master and replica servers using the configurations from the opt file.
#
include/rpl_start_server.inc [server_number=1]
show databases;
Database
__recyclebin__
copy_database
information_schema
mtr
mysql
performance_schema
sys
test
drop database copy_database;
use mtr;
include/rpl_start_server.inc [server_number=2]
use mtr;
