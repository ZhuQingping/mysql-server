#
# install rpl_semi_sync_source plugin.
#
INSTALL PLUGIN rpl_semi_sync_source SONAME 'SEMISYNC_SOURCE_PLUGIN';
#
# set rpl_semi_sync_source_timeout_wal to 10s, should success.
#
SET GLOBAL rpl_semi_sync_source_timeout_wal = 10000;
#
# set rpl_semi_sync_source_timeout_wal to 40s, should fail.
#
SET GLOBAL rpl_semi_sync_source_timeout_wal = 40000;
ERROR 42000: Variable 'rpl_semi_sync_source_timeout_wal' can't be set to the value of '40000'
#
# set rpl_semi_sync_source_timeout_wal to 100s, should fail.
#
SET GLOBAL rpl_semi_sync_source_timeout_wal = 100000;
ERROR 42000: Variable 'rpl_semi_sync_source_timeout_wal' can't be set to the value of '100000'
#
# Clean up.
#
UNINSTALL PLUGIN rpl_semi_sync_source;
