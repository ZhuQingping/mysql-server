--disable_warnings
--source suite/dstore_rpl_wal/include/rpl_wal_physical_replication_setup.inc
--enable_warnings

# --echo ############################################################
# --echo 一、 准备工作：创建测试环境。
# --echo 二、 针对 SQLCOM_CREATE_VIEW、SQLCOM_ALTER_VIEW、SQLCOM_DROP_VIEW 执行对应的 ddl 语句
# --echo 三、 在备机测查看dd信息，保证备机回放元数据的正确性
# --echo 四、 使用创建的view进行查询，供后面的新主机对比，保证回放功能正确
# --echo 五、 执行 switchover 
# --echo 六、 新主机使用老主创建的view进行查询，与第四步进行对比，保证备机回放功能的正确性
# --echo 七、 新主机对回放出的view进行修改删除，保证回放出来的ddl的可操作性
# --echo ############################################################

--echo ############################################################
--echo # 一、Create the test environment.
--echo # 二、Execute the corresponding DDL statements for SQLCOM_CREATE_VIEW, SQLCOM_ALTER_VIEW, and SQLCOM_DROP_VIEW.
--echo # 三、Check the DD information on the standby node to ensure correct metadata replay.
--echo # 四、Query using the created views for subsequent comparison with the new primary node to ensure the correctness of the replay function.
--echo # 五、Perform a switchover.
--echo # 六、Query using the views created by the original primary node on the new primary node, and compare the results with those from Step 4 to ensure the correctness of the standby node replay function.
--echo # 七、Modify and delete the replayed views on the new primary node to ensure the availability and operability of the replayed DDL.
--echo ############################################################

--echo #
--echo # 一、Create the test environment.
--echo #

--connection $node1
CREATE DATABASE IF NOT EXISTS test_view_db 
DEFAULT CHARACTER SET utf8mb4 
DEFAULT COLLATE utf8mb4_general_ci;

USE test_view_db;

CREATE TABLE employees (
    emp_id INT AUTO_INCREMENT PRIMARY KEY,
    emp_name VARCHAR(100) NOT NULL,
    department VARCHAR(50),
    salary DECIMAL(10, 2),
    hire_date DATE,
    status VARCHAR(20) DEFAULT 'ACTIVE'
);

CREATE TABLE departments (
    dept_id INT AUTO_INCREMENT PRIMARY KEY,
    dept_name VARCHAR(50) NOT NULL UNIQUE,
    location VARCHAR(100),
    budget DECIMAL(15, 2) DEFAULT 0
);

CREATE TABLE projects (
    project_id INT AUTO_INCREMENT PRIMARY KEY,
    project_name VARCHAR(100) NOT NULL,
    manager_id INT,
    department VARCHAR(50),
    budget DECIMAL(15, 2),
    start_date DATE,
    end_date DATE,
    status VARCHAR(20) DEFAULT 'PLANNING',
    FOREIGN KEY (manager_id) REFERENCES employees(emp_id)
);

# 4. 员工项目关联表
CREATE TABLE employee_projects (
    emp_proj_id INT AUTO_INCREMENT PRIMARY KEY,
    emp_id INT NOT NULL,
    project_id INT NOT NULL,
    role VARCHAR(50),
    hours_assigned INT DEFAULT 0,
    assigned_date DATE DEFAULT (CURDATE()),
    FOREIGN KEY (emp_id) REFERENCES employees(emp_id),
    FOREIGN KEY (project_id) REFERENCES projects(project_id),
    UNIQUE KEY uniq_emp_project (emp_id, project_id)  -- 防止重复分配
);

