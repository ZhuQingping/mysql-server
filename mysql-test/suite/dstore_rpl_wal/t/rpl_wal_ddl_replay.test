SELECT SCHEMA_NAME FROM INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME = 'tpcc';
set global debug="-d,standby_ddl_already_replayed";

--echo #
--echo # DDLCOM_ACL
--echo #
--echo #
--echo # 1.SQLCOM_CREATE_PROCEDURE
--echo #
--connection $node1
use test;
DELIMITER $$;
CREATE PROCEDURE test_proc_1()
BEGIN
  SELECT 'Hello from replicated procedure!' AS msg;
END$$
DELIMITER ;$$

