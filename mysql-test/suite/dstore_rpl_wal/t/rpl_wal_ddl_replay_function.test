--disable_warnings
--source suite/dstore_rpl_wal/include/rpl_wal_physical_replication_setup.inc
--enable_warnings

# --echo ############################################################
# --echo 一、 准备工作：创建测试环境。
# --echo 二、 然后针对   SQLCOM_CREATE_FUNCTION 、 SQLCOM_ALTER_FUNCTION 、 SQLCOM_DROP_FUNCTION 、SQLCOM_CREATE_SPFUNCTION 执行对应的 ddl 语句 。 
# --echo 三、 在备机测查看dd信息，保证备机回放元数据的正确性。
# --echo 四、 调用function、调用function创表。执行完后，进行全表扫描，供后面的新主机对比，保证回放功能正确。
# --echo 五、 执行 switchover 。
# --echo 六、 新主机进行全表扫描，与第四步进行对比，保证备机回放功能的正确性。
# --echo 七、 使用回放出的function，并对回放出来的function进行操作(修改删除)，保证回放出来的ddl可用性和可操作性。
# --echo ############################################################

--echo ############################################################
--echo 一、Set up the test environment.
--echo 二、Then execute the corresponding DDL statements for SQLCOM_CREATE_FUNCTION, SQLCOM_ALTER_FUNCTION, SQLCOM_DROP_FUNCTION, and SQLCOM_CREATE_SPFUNCTION.
--echo 三、Check the DD information on the standby node to ensure correct metadata replay.
--echo 四、Call the functions and create tables by calling the functions. After execution, perform a full table scan for later comparison on the new primary node to ensure the replay function works correctly.
--echo 五、Perform a switchover.
--echo 六、Perform a full table scan on the new primary node and compare the results with those from Step 4 to verify the correctness of the standby node replay function.
--echo 七、Use the replayed functions and perform operations (alter and drop) on them to ensure the availability and operability of the replayed DDL results.
--echo ############################################################

--echo #
--echo # 一、Set up the test environment.
--echo #

--connection $node1
CREATE DATABASE IF NOT EXISTS test_function_db 
DEFAULT CHARACTER SET utf8mb4 
DEFAULT COLLATE utf8mb4_general_ci;

USE test_function_db;

CREATE TABLE employees (
    emp_id INT AUTO_INCREMENT PRIMARY KEY,
    emp_name VARCHAR(100) NOT NULL,
    department VARCHAR(50),
    salary DECIMAL(10, 2),
    hire_date DATE
);

CREATE TABLE departments (
    dept_id INT AUTO_INCREMENT PRIMARY KEY,
    dept_name VARCHAR(50) NOT NULL UNIQUE,
    location VARCHAR(100)
);

INSERT INTO departments(dept_name, location) VALUES
('技术部', '北京'),
('销售部', '上海'),
('人事部', '广州');

INSERT INTO employees(emp_name, department, salary, hire_date) VALUES
('张三', '技术部', 15000.00, '2020-01-15'),
('李四', '技术部', 12000.00, '2020-03-20'),
('王五', '销售部', 8000.00, '2021-05-10'),
('赵六', '人事部', 10000.00, '2019-11-30');

--echo #
--echo # 二、Then execute the corresponding DDL statements for SQLCOM_CREATE_FUNCTION, SQLCOM_ALTER_FUNCTION, SQLCOM_DROP_FUNCTION, and SQLCOM_CREATE_SPFUNCTION.
--echo #

--echo #
--echo # SQLCOM_CREATE_FUNCTION
--echo #

--echo # Create a deterministic function for calculating annual salary
DELIMITER $$;
CREATE FUNCTION calculate_annual_salary(monthly_salary DECIMAL(10,2))
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    RETURN monthly_salary * 12;
END$$
DELIMITER ;$$

# SQL关键字： READS SQL DATA → 【只读SQL数据函数】，
# SQL层含义：函数体内部会执行 SELECT 查询数据库表的数据，**不会修改任何数据**（无INSERT/UPDATE/DELETE），是MySQL的函数安全特性关键字
# 函数体内定义局部变量：emp_count ，INT类型，用于接收查询出来的员工数量
--echo # Create a non-deterministic function to get the number of employees
DELIMITER $$;
CREATE FUNCTION get_department_employee_count(dept_name_param VARCHAR(50))
RETURNS INT 
READS SQL DATA 
BEGIN
    DECLARE emp_count INT;
    SELECT COUNT(*) INTO emp_count 
    FROM employees 
    WHERE department = dept_name_param;
    RETURN emp_count;
END$$
DELIMITER ;$$

# SQL关键字：DETERMINISTIC → 【确定性函数】，SQL层含义：相同的入职日期入参，永远返回相同的工龄结果
--echo # Create a custom function that uses built-in MySQL functions
DELIMITER $$;
CREATE FUNCTION calculate_service_years(hire_date_param DATE)
RETURNS INT
DETERMINISTIC
BEGIN
    RETURN YEAR(CURDATE()) - YEAR(hire_date_param);
END$$
DELIMITER ;$$

--echo # Create a function with conditional logic
DELIMITER $$;
CREATE FUNCTION get_salary_level(salary_val DECIMAL(10,2))
RETURNS VARCHAR(20)
DETERMINISTIC
BEGIN
    IF salary_val > 12000 THEN
        RETURN '高薪';
    ELSEIF salary_val > 8000 THEN
        RETURN '中薪';
    ELSE
        RETURN '低薪';
    END IF;
END$$
DELIMITER ;$$

--echo # Create a test function to be dropped
DELIMITER $$;
CREATE FUNCTION calculate_service_years_delete(hire_date_param DATE)
RETURNS INT
DETERMINISTIC
BEGIN
    RETURN YEAR(CURDATE()) - YEAR(hire_date_param);
END$$
DELIMITER ;$$

--echo #
--echo # 2 SQLCOM_ALTER_FUNCTION
--echo #

ALTER FUNCTION calculate_annual_salary
COMMENT '计算年薪函数（已修改）';

# 这个函数 / 存储过程在执行时，使用谁的权限来访问数据库对象（如表、视图等）。
# 使用「调用这个函数的用户」（也就是当前执行 SELECT get_department_employee_count(...) 的用户）的权限。
# 另一个可选选项：SQL SECURITY DEFINER（默认选项）
# 该函数执行时，使用「创建这个函数的用户」（也就是定义者）的权限。

--echo # Modify the function's security setting to INVOKER
ALTER FUNCTION get_department_employee_count
SQL SECURITY INVOKER
COMMENT '获取部门员工数量（已修改安全设置）';

# 修改函数的确定性（注意：只能从NON-DETERMINISTIC改为DETERMINISTIC）
# ALTER FUNCTION calculate_service_years
# SQL SECURITY INVOKER
# COMMENT '计算工龄函数，安全设置修改';

--echo #
--echo # 3 SQLCOM_DROP_FUNCTION
--echo #
DROP FUNCTION IF EXISTS calculate_service_years_delete;

--echo # Query metadata on the primary node
SELECT 
    ROUTINE_NAME,
    ROUTINE_TYPE,
    DATA_TYPE,
    IS_DETERMINISTIC,
    SECURITY_TYPE,
    ROUTINE_COMMENT
FROM INFORMATION_SCHEMA.ROUTINES 
WHERE ROUTINE_SCHEMA = 'test_function_db'
ORDER BY ROUTINE_TYPE, ROUTINE_NAME;

--echo #
--echo # 三、Check the DD information on the standby node to ensure correct metadata replay.
--echo #

--sleep 2
--connection $node2
--echo # Query metadata on the standby node
SELECT 
    ROUTINE_NAME,
    ROUTINE_TYPE,
    DATA_TYPE,
    IS_DETERMINISTIC,
    SECURITY_TYPE,
    ROUTINE_COMMENT
FROM INFORMATION_SCHEMA.ROUTINES 
WHERE ROUTINE_SCHEMA = 'test_function_db'
ORDER BY ROUTINE_TYPE, ROUTINE_NAME;

--echo # Verify the parameter information
SELECT 
    SPECIFIC_NAME,
    PARAMETER_NAME,
    DATA_TYPE,
    ORDINAL_POSITION
FROM INFORMATION_SCHEMA.PARAMETERS 
WHERE SPECIFIC_SCHEMA = 'test_function_db'
ORDER BY SPECIFIC_NAME, ORDINAL_POSITION;

--echo #
--echo # 四、Call the functions and create tables by calling the functions. After execution, perform a full table scan for later comparison on the new primary node to ensure the replay function works correctly.
--echo #

--connection $node1
USE test_function_db;

--echo # 1 Create a new table that uses functions
CREATE TABLE salary_analysis AS
SELECT 
emp_id,
emp_name,
salary,
calculate_annual_salary(salary) as annual_salary,
CASE 
WHEN salary > 12000 THEN '高薪'
        WHEN salary > 8000 THEN '中薪'
        ELSE '低薪'
    END as salary_level
FROM employees;

--echo # 2 Create a view that uses functions
CREATE VIEW v_employee_analysis AS
SELECT 
    e.emp_name,
    e.department,
    e.salary,
    calculate_annual_salary(e.salary) as annual_salary,
    d.location,
    (SELECT get_department_employee_count(e.department)) as dept_emp_count
FROM employees e
LEFT JOIN departments d ON e.department = d.dept_name;

--echo # 3 Record the current data status for comparison with the new primary node

--echo # Data of the salary_analysis table
SELECT * FROM salary_analysis ORDER BY emp_id;

--echo # Data of the view
SELECT * FROM v_employee_analysis ORDER BY emp_name;

--echo # Verify the function invocation
SELECT 
    dept_name,
    get_department_employee_count(dept_name) as employee_count
FROM departments;

--echo #
--echo # 五、Perform a switchover.
--echo #
--sleep 3
--let $old_primary = $node1
--let $old_standby = $node2
--let $old_standby_port = $SERVER_MYPORT_2
--source suite/dstore_rpl_wal/include/rpl_wal_physical_replication_switch.inc

--echo #
--echo # 六、Perform a full table scan on the new primary node and compare the results with those from Step 4 to verify the correctness of the standby node replay function.
--echo #
--connection $node2
USE test_function_db;

--echo # 1. Verify the data in the salary_analysis table
SELECT * FROM salary_analysis ORDER BY emp_id;

--echo # 2. Verify view data
SELECT * FROM v_employee_analysis ORDER BY emp_name;

--echo # 3. Verify function invocation
SELECT 
    dept_name,
    get_department_employee_count(dept_name) as employee_count
FROM departments;


--echo #
--echo # 七、Use the replayed functions and perform operations (alter and drop) on them to ensure the availability and operability of the replayed DDL results.
--echo #

--echo # 1 Perform operations on the replayed functions: modify and delete the replayed functions

ALTER FUNCTION calculate_annual_salary
SQL SECURITY INVOKER
COMMENT '在新主上修改的函数';

DROP FUNCTION IF EXISTS get_department_employee_count;

DELIMITER $$;
CREATE FUNCTION calculate_bonus(salary DECIMAL(10,2), performance_rating INT)
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    DECLARE bonus DECIMAL(10,2);
    
    IF performance_rating >= 90 THEN
        SET bonus = salary * 0.3;
    ELSEIF performance_rating >= 80 THEN
        SET bonus = salary * 0.2;
    ELSEIF performance_rating >= 70 THEN
        SET bonus = salary * 0.1;
    ELSE
        SET bonus = 0;
    END IF;
    
    RETURN bonus;
END$$
DELIMITER ;$$

--echo # 2 Verify metadata on the standby node
--connection $node1
--sleep 2
SELECT 
    ROUTINE_NAME,
    ROUTINE_TYPE,
    IS_DETERMINISTIC,
    SECURITY_TYPE,
    ROUTINE_COMMENT
FROM INFORMATION_SCHEMA.ROUTINES 
WHERE ROUTINE_SCHEMA = 'test_function_db'
ORDER BY ROUTINE_TYPE, ROUTINE_NAME;

--disable_warnings
--let $current_standby = $node1
--let $current_primary = $node2
--source suite/dstore_rpl_wal/include/rpl_wal_physical_replication_cleanup.inc
--enable_warnings
