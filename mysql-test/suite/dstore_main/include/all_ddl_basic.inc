# ==== Purpose ====
#
# This file includes testcases to verify the all DDL supported by MySQL on Dstore
#
# ==== References ====
#
# US2025071500732 Support atomic-DDL for MySQL on Dstore
# 

## Start with a special create statements that prevented by Sever-layer before touching Dstore-handler,
## But it will call post_ddl interface of Dstore-handler.
--error ER_DEFAULT_VAL_GENERATED_NON_PRIOR
create table DATATYPE_DEFAULT_015 (f1 float default (f2),f2 float default(rand()));

## SQLCOM_CREATE_DB
create database ddl_test0; USE ddl_test0;

## SQLCOM_ALTER_DB
ALTER DATABASE ddl_test0 CHARACTER SET = utf8mb4;

## SQLCOM_CREATE_TABLE
CREATE TABLE t1 (
  id INT primary key auto_increment,
  name VARCHAR(20),
  mylob BLOB);
INSERT INTO t1 (name, mylob) VALUES ('User1', NULL),('User2', 0x010203),('User3', 0xFFD8FFE0);

## CREATE WITH SELECT
CREATE TABLE t_select CHARSET = utf8mb4 AS SELECT if(1, 9223372036854775808, 1) AS i, CASE WHEN 1 THEN 9223372036854775808 ELSE 1 END AS c, coalesce(9223372036854775808, 1);

## SQLCOM_DROP_TABLE
DROP TABLE t_select;

## SQLCOM_CREATE_INDEX
CREATE INDEX idx1 ON t1(id);
CREATE INDEX idx2 ON t1(name);

## SQLCOM_ALTER_TABLE
ALTER TABLE t1 ADD COLUMN age INT;

## SQLCOM_ANALYZE
ANALYZE TABLE t1;

## SQLCOM_OPTIMIZE
OPTIMIZE TABLE atomic_ddl_department;

## SQLCOM_TRUNCATE
TRUNCATE TABLE t1;

## SQLCOM_RENAME_TABLE
RENAME TABLE t1 TO t2;
RENAME TABLE t2 TO t1;

## SQLCOM_DROP_INDEX
DROP INDEX idx1 ON t1;
DROP INDEX idx2 ON t1;

## SQLCOM_CREATE_VIEW
CREATE VIEW v1 AS SELECT 1 AS col;
CREATE VIEW v2 AS SELECT * FROM t1;

## SQLCOM_DROP_VIEW
DROP VIEW v1;
DROP VIEW v2;

## SQLCOM_CREATE_FUNCTION
CREATE FUNCTION metaphon RETURNS STRING SONAME 'udf_example.so';

## SQLCOM_CREATE_SPFUNCTION
CREATE FUNCTION hello() RETURNS INT DETERMINISTIC RETURN 1;

## SQLCOM_ALTER_FUNCTION
ALTER FUNCTION hello COMMENT 'modified';

## SQLCOM_DROP_FUNCTION
DROP FUNCTION hello;
DROP FUNCTION metaphon;

## SQLCOM_CREATE_PROCEDURE
DELIMITER |;
CREATE PROCEDURE p1() BEGIN SELECT 1; END|
DELIMITER ;|

## SQLCOM_ALTER_PROCEDURE
ALTER PROCEDURE p1 COMMENT 'modified';

## SQLCOM_DROP_PROCEDURE
DROP PROCEDURE p1;

## SQLCOM_CREATE_TRIGGER
CREATE TRIGGER tr1 BEFORE INSERT ON t1 FOR EACH ROW SET NEW.id = 0;
 
## SQLCOM_DROP_TRIGGER
DROP TRIGGER tr1;

## SQLCOM_CREATE_EVENT
CREATE EVENT e1 ON SCHEDULE EVERY 1 DAY DO DELETE FROM t1;

## SQLCOM_ALTER_EVENT
ALTER EVENT e1 DISABLE;

## SQLCOM_DROP_EVENT
DROP EVENT e1;

## SQLCOM_CREATE_SERVER
CREATE SERVER s1 FOREIGN DATA WRAPPER mysql OPTIONS (HOST '127.0.0.1');

## SQLCOM_ALTER_SERVER
ALTER SERVER s1 OPTIONS (USER 'test');

## SQLCOM_DROP_SERVER
DROP SERVER s1;

## SQLCOM_CREATE_RESOURCE_GROUP
CREATE RESOURCE GROUP rg1 TYPE = USER;

## SQLCOM_ALTER_RESOURCE_GROUP
ALTER RESOURCE GROUP rg1 VCPU = 0-1;

## SQLCOM_DROP_RESOURCE_GROUP
DROP RESOURCE GROUP rg1;

## SQLCOM_CREATE_USER
CREATE USER 'testuser'@'localhost' IDENTIFIED BY 'password';
 
## SQLCOM_ALTER_USER
ALTER USER 'testuser'@'localhost' IDENTIFIED BY 'new_password';
 
## SQLCOM_RENAME_USER
RENAME USER 'testuser'@'localhost' TO 'newuser'@'localhost';
RENAME USER 'newuser'@'localhost' TO 'testuser'@'localhost';

## SQLCOM_SET_PASSWORD
SET PASSWORD FOR 'testuser'@'localhost' = 'pass';

## SQLCOM_CREATE_ROLE
CREATE ROLE 'role1';
CREATE ROLE 'role2';

## SQLCOM_GRANT_ROLE
GRANT 'role1' TO 'testuser'@'localhost';
GRANT 'role2' TO 'testuser'@'localhost';

## SQLCOM_GRANT
GRANT SELECT ON ddl_test1.* TO 'role1';
GRANT INSERT ON ddl_test1.* TO 'role1';
GRANT UPDATE ON ddl_test1.* TO 'role1';
GRANT DELETE ON ddl_test1.* TO 'role1';
GRANT SELECT ON ddl_test1.* TO 'role2';

## SQLCOM_ALTER_USER_DEFAULT_ROLE
ALTER USER 'testuser'@'localhost' DEFAULT ROLE 'role1';

## SQLCOM_REVOKE
REVOKE SELECT ON ddl_test1.* FROM 'role1';

## SQLCOM_REVOKE_ALL
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'role1';

## SQLCOM_REVOKE_ROLE
REVOKE 'role1' FROM 'testuser'@'localhost';
REVOKE 'role2' FROM 'testuser'@'localhost';

## SQLCOM_DROP_ROLE
DROP ROLE 'role1';
DROP ROLE 'role2';

## SQLCOM_DROP_USER
DROP USER 'testuser'@'localhost';

## SQLCOM_CREATE_SRS
CREATE SPATIAL REFERENCE SYSTEM 1004326 NAME 'WGS 84 (long-lat)' DEFINITION 'GEOGCS["WGS 84",DATUM["World Geodetic System 1984",SPHEROID["WGS 84",6378137,298.257223563,AUTHORITY["EPSG","7030"]],AUTHORITY["EPSG","6326"]],PRIMEM["Greenwich",0,AUTHORITY["EPSG","8901"]],UNIT["degree",0.017453292519943278,AUTHORITY["EPSG","9122"]],AXIS["Lon",EAST],AXIS["Lat",NORTH]]' DESCRIPTION 'WGS 84 with coordinate axes swapped to be longitude-latitude instead of latitude-longitude';

## SQLCOM_DROP_SRS
DROP SPATIAL REFERENCE SYSTEM 1004326;

## SQLCOM_ALTER_TABLESPACE
CREATE TABLESPACE ts_1 ENGINE = InnoDB;
DROP TABLESPACE ts_1;

## SQLCOM_DROP_DB
drop database ddl_test0;
