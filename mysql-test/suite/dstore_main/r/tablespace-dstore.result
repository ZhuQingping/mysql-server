create tablespace test2 max_size=41943040;
CREATE TABLE users (
id INT AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(100) NOT NULL,
email VARCHAR(150) NOT NULL,
created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) tablespace=test2;
CREATE PROCEDURE insert_many_users(IN num_rows INT)
BEGIN
DECLARE i INT DEFAULT 0;
DECLARE random_name VARCHAR(100);
DECLARE random_email VARCHAR(150);
WHILE i < num_rows DO
SET random_name = CONCAT('User', FLOOR(RAND() * 1000000));
SET random_email = CONCAT(random_name, '@example.com');
INSERT INTO users (name, email) VALUES (random_name, random_email);
SET i = i + 1;
END WHILE;
END |
call insert_many_users(100000);
ERROR HY000: Tablespace has reached to it's max_size
drop procedure insert_many_users;
drop table users;
drop tablespace test2;
create table test(a int);
insert into test values(10);
alter table test tablespace=innodb_system;
ERROR HY000: DStore: A general tablespace named `innodb_system` cannot be found.
alter table test tablespace=dstore_temporary;
ERROR HY000: DStore: Tablespace `dstore_temporary` can only contain TEMPORARY tables.
alter table test tablespace=dstore_global;
ERROR HY000: The table './test/test' may not be created in the reserved tablespace 'dstore_global'.
drop table test;
CREATE TABLE `test_data` (
`id` INT AUTO_INCREMENT PRIMARY KEY,
`username` VARCHAR(50),
`score` INT,
`created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE PROCEDURE BatchInsertData()
BEGIN
DECLARE i INT DEFAULT 1;
START TRANSACTION;
WHILE i <= 100000 DO
INSERT INTO test_data (username, score) 
VALUES (CONCAT('user_', i), FLOOR(RAND() * 100));
IF i % 10000 = 0 THEN
COMMIT;
START TRANSACTION;
END IF;
SET i = i + 1;
END WHILE;
END;
//
CALL BatchInsertData();
create tablespace ts1 max_size 43554432;
drop tablespace ts1;
drop procedure BatchInsertData;
drop table test_data;
drop tablespace dstore_default;
