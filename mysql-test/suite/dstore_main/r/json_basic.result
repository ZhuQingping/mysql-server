ALTER TABLE json_test ADD COLUMN json_col2 JSON, ALGORITHM=INSTANT;
ERROR HY000: BLOB Column can't be added with ALGORITHM=INSTANT. Try ALGORITHM=INPLACE/COPY.
ALTER TABLE json_test ADD COLUMN json_col2 JSON, ALGORITHM=INPLACE;
ALTER TABLE json_test ADD COLUMN json_col3 JSON, ALGORITHM=COPY;
