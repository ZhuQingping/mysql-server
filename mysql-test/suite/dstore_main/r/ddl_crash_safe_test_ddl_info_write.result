# Step 2. Do A Clean Shutdown.
# Step 3. Write DDLs Concurrently.
#         We write almost all DDL types except for USER/PRIVILEGE related DDL
#         because those DDL will block the tests.
SET DEBUG_SYNC = 'ddl_crash_safe_before_innodb_commit WAIT_FOR release_all_connections';
CREATE DATABASE db_01;
SET DEBUG_SYNC = 'ddl_crash_safe_before_innodb_commit WAIT_FOR release_all_connections';
