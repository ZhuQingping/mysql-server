# Step 3. Kill The Server To Do Crash Recovery.
SET debug='d, ib_trx_crash_after_prepare_done_step';
CREATE TABLE tx(pk INT PRIMARY KEY);
ERROR HY000: Lost connection to MySQL server during query
# Step 4. Check Whether All DDLs Are In Prepared State.
Pattern "Found 26 prepared transaction\(s\) in InnoDB" found
# Step 5. Check Recovery Result: Ensure All DDLs Have Taken Effect.
