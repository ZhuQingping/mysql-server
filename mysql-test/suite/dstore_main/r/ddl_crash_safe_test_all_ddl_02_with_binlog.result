#
#  DDL CRASH SAFE TEST: ALL DDL TEST PART 02
#  This test will check whether the server can recovery from different
#  phases of ALL DDLs without inconsistency between dstore and
#  innodb. Each DDL will be tested at 3 crash points and recovery
#  results will be verified.
#
CREATE DATABASE test_ddl_crash_comprehensive;
USE test_ddl_crash_comprehensive;
CREATE TABLE t_ddl_crash_renamed(pk INT PRIMARY KEY, col1 INT);
INSERT INTO t_ddl_crash_renamed VALUES (1,2),(2,3),(3,4);
#  11. Crash on CREATE VIEW statement.
#  11.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
CREATE VIEW v_ddl_crash AS SELECT * FROM t_ddl_crash_renamed;
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify view should not exist
SELECT COUNT(*) AS view_count FROM INFORMATION_SCHEMA.VIEWS WHERE TABLE_NAME='v_ddl_crash';
view_count
0
#  11.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
CREATE VIEW v_ddl_crash AS SELECT * FROM t_ddl_crash_renamed;
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify view should not exist
SELECT COUNT(*) AS view_count FROM INFORMATION_SCHEMA.VIEWS WHERE TABLE_NAME='v_ddl_crash';
view_count
0
#  11.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
CREATE VIEW v_ddl_crash AS SELECT * FROM t_ddl_crash_renamed;
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify view should exist
SELECT COUNT(*) AS view_count FROM INFORMATION_SCHEMA.VIEWS WHERE TABLE_NAME='v_ddl_crash';
view_count
1
SHOW CREATE VIEW v_ddl_crash;
View	Create View	character_set_client	collation_connection
v_ddl_crash	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v_ddl_crash` AS select `t_ddl_crash_renamed`.`pk` AS `pk`,`t_ddl_crash_renamed`.`col1` AS `col1` from `t_ddl_crash_renamed`	utf8mb4	utf8mb4_0900_ai_ci
#  12. Crash on DROP VIEW statement.
