#  18. Crash on CREATE EVENT statement.
#  18.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
CREATE EVENT e_crash ON SCHEDULE EVERY 1 DAY DO DELETE FROM t_ddl_crash_renamed WHERE pk > 1000;
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify event should not exist
SELECT COUNT(*) AS event_count FROM INFORMATION_SCHEMA.EVENTS WHERE EVENT_NAME='e_crash';
event_count
0
#  18.2 Crash after InnoDB prepare.
