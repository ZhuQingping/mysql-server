#  17. Crash on CREATE TRIGGER statement.
#  17.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
CREATE TRIGGER tr_crash BEFORE INSERT ON t_ddl_crash_renamed FOR EACH ROW SET NEW.pk = NEW.pk + 100;
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify trigger should not exist
SELECT COUNT(*) AS trigger_count FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_NAME='tr_crash';
trigger_count
0
#  17.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
CREATE TRIGGER tr_crash BEFORE INSERT ON t_ddl_crash_renamed FOR EACH ROW SET NEW.pk = NEW.pk + 100;
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify trigger should not exist
SELECT COUNT(*) AS trigger_count FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_NAME='tr_crash';
trigger_count
0
#  17.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
CREATE TRIGGER tr_crash BEFORE INSERT ON t_ddl_crash_renamed FOR EACH ROW SET NEW.pk = NEW.pk + 100;
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify trigger should exist and work
SELECT COUNT(*) AS trigger_count FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_NAME='tr_crash';
trigger_count
1
