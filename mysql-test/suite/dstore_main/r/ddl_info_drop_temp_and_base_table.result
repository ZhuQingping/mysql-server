#
# Test case for filtering temporary tables operations during DROP TABLE.
#
DROP DATABASE IF EXISTS test_temp_db;
DROP TABLE IF EXISTS t1, t2, t3, t4;
CREATE DATABASE test_temp_db;
USE test_temp_db;
SET debug='reset';
#
# Scenario 1: Drop multiple temporary tables
#
CREATE TEMPORARY TABLE temptb1 (id INT, data VARCHAR(50));
CREATE TEMPORARY TABLE temptb2 (id INT, data VARCHAR(50));
CREATE TEMPORARY TABLE temptb3 (id INT, data VARCHAR(50));
INSERT INTO temptb1 VALUES (1, 'temptb1 data');
INSERT INTO temptb2 VALUES (2, 'temptb2 data');
INSERT INTO temptb3 VALUES (3, 'temptb3 data');
SELECT * FROM temptb1;
id	data
1	temptb1 data
SELECT * FROM temptb2;
id	data
2	temptb2 data
SELECT * FROM temptb3;
id	data
3	temptb3 data
DROP TEMPORARY TABLE temptb1, temptb2, temptb3;
#
# Scenario 2: Drop multiple base tables
#
CREATE TABLE base1 (id INT, data VARCHAR(50));
CREATE TABLE base2 (id INT, data VARCHAR(50));
CREATE TABLE base3 (id INT, data VARCHAR(50));
INSERT INTO base1 VALUES (1, 'base1 data');
INSERT INTO base2 VALUES (2, 'base2 data');
INSERT INTO base3 VALUES (3, 'base3 data');
SELECT * FROM base1;
id	data
1	base1 data
SELECT * FROM base2;
id	data
2	base2 data
SELECT * FROM base3;
id	data
3	base3 data
DROP TABLE base1, base2, base3;
#
# Scenario 3: Drop multiple mixed tables (different names)
#
CREATE TABLE base1 (id INT);
CREATE TABLE base2 (id INT);
CREATE TEMPORARY TABLE temptb1 (id INT);
CREATE TEMPORARY TABLE temptb2 (id INT);
INSERT INTO base1 VALUES (1);
INSERT INTO base2 VALUES (2);
INSERT INTO temptb1 VALUES (3);
INSERT INTO temptb2 VALUES (4);
DROP TABLE base1, base2, temptb1, temptb2;
#
# Scenario 4: Drop mixed temporary and base tables (same name)
#
CREATE TABLE t1 (id INT, type VARCHAR(50));
INSERT INTO t1 VALUES (1, 'base table');
CREATE TEMPORARY TABLE t1 (id INT, type VARCHAR(50));
INSERT INTO t1 VALUES (2, 'temporary table');
# Should see temporary table
SELECT * FROM t1;
id	type
2	temporary table
DROP TABLE t1;
# Should see base table now
SELECT * FROM t1;
id	type
1	base table
DROP TABLE t1;
#
# Scenario 5: Drop mixed temporary and base tables (same name)
#
CREATE TABLE t1 (id INT, type VARCHAR(50));
INSERT INTO t1 VALUES (1, 'base table');
CREATE TEMPORARY TABLE t1 (id INT, type VARCHAR(50));
INSERT INTO t1 VALUES (2, 'temporary table');
CREATE TABLE t2 (id INT, type VARCHAR(50));
INSERT INTO t2 VALUES (1, 'base table t2');
# Should see temporary table
SELECT * FROM t1;
id	type
2	temporary table
DROP TABLE t1,t2;
# Should see base table now
SELECT * FROM t1;
id	type
1	base table
DROP TABLE t1;
SET debug='reset';
#
# Cleanup
#
USE test;
DROP DATABASE test_temp_db;
# All temptb* tables should not be written into wal.
Pattern "temptb" not found
