# Here t1.c is replaced with a '?'. Even though the comments
# below are a bit complicated as they try to explain what is going
# internally, the visible result of queries is that elimination is done
# and not done, properly.
# 'c' is string so '?' is also given an inferred string type by
# param_type_uses_non_param(). string_col=string is safe for
# elimination, so elimination is done.
PREPARE s FROM 'EXPLAIN SELECT t1.a FROM t1 LEFT JOIN t2 ON t2.c=?';
SET @var='abc';
EXECUTE s USING @var;
