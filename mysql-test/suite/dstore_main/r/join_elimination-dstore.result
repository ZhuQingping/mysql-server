# the same, with a JSON_TABLE which is similar to a lateral
# table but is not one in MySQL's implementation, so needs
# special handling
EXPLAIN SELECT DISTINCT t1.a FROM t1 LEFT JOIN t2 ON t2.a>t1.b JOIN JSON_TABLE(
COALESCE('[{"a":"3"},{"a":2},{"b":1},{"a":0}]', CONCAT(t2.a)),
'$[*]' COLUMNS (id FOR ORDINALITY,
jpath VARCHAR(100) PATH '$.a',
jexst INT EXISTS PATH '$.b')
) AS derived ON TRUE;
