# Elimination in INSERT SELECT ... ON DUPLICATE KEY UPDATE.
# t5 could be eliminated from the SELECT if it were just a
# SELECT, but here should not as it's used in the UPDATE clause. If we
# accidentally eliminate it, and given that we zero its read_set, then
# when reading t5.a to calculate t5.a+0, we fail the assertion
# ASSERT_COLUMN_MARKED_FOR_READ in Field_long::val_int(), as is
# appropriate.
CREATE TABLE t3 (a INT PRIMARY KEY);
INSERT INTO t3 VALUES (100);
CREATE TABLE t4 (a INT PRIMARY KEY);
INSERT INTO t4 VALUES (100);
# So this cannot eliminate
EXPLAIN INSERT INTO t3 SELECT DISTINCT t4.a FROM t4 LEFT JOIN t4 AS t5 ON t4.a=t5.a ON DUPLICATE KEY UPDATE t3.a=t5.a+0;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	INSERT	t3	NULL	ALL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
1	SIMPLE	t4	NULL	index	PRIMARY	PRIMARY	4	NULL	1	100.00	Using index; Using temporary
1	SIMPLE	t5	NULL	eq_ref	PRIMARY	PRIMARY	4	test.t4.a	1	100.00	Using index
