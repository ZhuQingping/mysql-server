# integer type (checked in check_parameter_types()), there is
# re-preparation. In this new preparation we have t2.c=integer, so
# elimination cannot be done (string_col=int is unsafe, look for
# is_string_type() in sql_join_elimination.cc).
EXECUTE s USING @var;
