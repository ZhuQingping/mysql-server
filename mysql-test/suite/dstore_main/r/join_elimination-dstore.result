# This tests the feature: "LEFT JOIN elimination" implemented by Huawei
# in code file sql/sql_join_elimination.cc .
# Results of SELECTs have all been compared to results with the
# feature off, and are identical.
CREATE TABLE t1(a INT PRIMARY KEY, b INT, c VARCHAR(10), dt DATETIME);
CREATE TABLE t2(a INT PRIMARY KEY, b INT, c VARCHAR(10), dt DATETIME);
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `a` int NOT NULL,
  `b` int DEFAULT NULL,
  `c` varchar(10) DEFAULT NULL,
  `dt` datetime DEFAULT NULL,
  PRIMARY KEY (`a`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t1 VALUES(1,1,"4.0","2000-01-01 12:34:56"),
(2,3,"abc","2002-01-01"),(7,null,"wxc","2004-02-02");
INSERT INTO t2 VALUES(2,2,"4.0","2000-01-01 12:34:56"),
(4,5,"def","2002-01-01"),(5,4,"abc","2004-02-02");
# Should be ON by default
SELECT @@optimizer_switch LIKE "%left_join_elimination=off%",
@@optimizer_switch LIKE "%left_join_elimination=on%";
@@optimizer_switch LIKE "%left_join_elimination=off%"	@@optimizer_switch LIKE "%left_join_elimination=on%"
0	1
# No elimination, as no GROUP BY or DISTINCT, and no equality
# on unique key
EXPLAIN SELECT t1.a FROM t1 LEFT JOIN t2 ON t2.a>t1.b;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	3	100.00	NULL
1	SIMPLE	t2	NULL	ALL	PRIMARY	NULL	NULL	NULL	3	100.00	Range checked for each record (index map: 0x1)
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a` from `test`.`t1` left join `test`.`t2` on((`test`.`t2`.`a` > `test`.`t1`.`b`)) where true
SELECT t1.a FROM t1 LEFT JOIN t2 ON t2.a>t1.b;
a
1
1
1
2
2
7
# (I) Elimination due to LEFT JOIN with GROUP BY or DISTINCT
EXPLAIN SELECT t1.a FROM t1 LEFT JOIN t2 ON t2.a>t1.b GROUP BY t1.a;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	PRIMARY	NULL	NULL	NULL	3	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a` from `test`.`t1` group by `test`.`t1`.`a`
SELECT t1.a FROM t1 LEFT JOIN t2 ON t2.a>t1.b GROUP BY t1.a;
a
1
2
7
EXPLAIN SELECT DISTINCT t1.a FROM t1 LEFT JOIN t2 ON t2.a>t1.b;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	PRIMARY	NULL	NULL	NULL	3	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select distinct `test`.`t1`.`a` AS `a` from `test`.`t1`
SELECT DISTINCT t1.a FROM t1 LEFT JOIN t2 ON t2.a>t1.b;
a
1
2
7
# If switch is off, feature is disabled:
SET optimizer_switch="left_join_elimination=off";
EXPLAIN SELECT t1.a FROM t1 LEFT JOIN t2 ON t2.a>t1.b GROUP BY t1.a;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
