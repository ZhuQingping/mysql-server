# Now an imaginary example which looks realistic: we have two
# tables with PK-FK relationship, a view which presents information
# gathered from both tables, and a query which happens to select only
# certain columns, making one table actually unnecessary.
CREATE TABLE person(name VARCHAR(10) PRIMARY KEY, zip_code CHAR(6));
CREATE TABLE town(zip_code CHAR(6) PRIMARY KEY, name VARCHAR(10));
INSERT INTO person VALUES('M. A', NULL),('Ms. B', '170150');
INSERT INTO town VALUES('170150', 'Quito'), ('090150', 'Guayaquil');
# A view which presents the person's name and the town's name; using a LEFT JOIN in case the person has a NULL (unknown) zip_code.
CREATE VIEW person_town AS SELECT p.name AS p_name, t.name AS t_name
FROM person p LEFT JOIN town t ON p.zip_code=t.zip_code;
# All information is requested, cannot eliminate 'town'
EXPLAIN SELECT * FROM person_town;
