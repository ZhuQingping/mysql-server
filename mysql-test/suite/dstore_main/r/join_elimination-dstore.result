1	SIMPLE	t	NULL	eq_ref	PRIMARY	PRIMARY	4	func	1	100.00	Using index condition
1	SIMPLE	u	NULL	ALL	a	NULL	NULL	NULL	1	100.00	Using where; Using join buffer (hash join)
1	SIMPLE	w	NULL	ALL	NULL	NULL	NULL	NULL	3	100.00	Using where; Using join buffer (hash join)
