# One note: join elimination and COUNT(not-null) optimization have no
# chance to work together: we could hope that the latter would
# eliminate a reference to the right-side table in COUNT, so maybe
# elimination could then happen; but actually no: the right-side table
# is potentially NULL-complemented by definition, so COUNT(not-null)
# cannot apply. Example below, even though in base table 'u' the
# column 'c' is not nullable, we cannot eliminate 'u':
EXPLAIN SELECT 1+(2*COUNT(derived.uc)) FROM
(SELECT t.a, u.c AS uc,
CASE WHEN t.b = '1' THEN 'ab' ELSE 'cd' END AS computed_col
FROM t1 AS t
LEFT JOIN u ON (t.a, t.b) = (u.b, u.a)
INNER JOIN t2 AS v ON v.b+2 = t.a
INNER JOIN t2 AS w ON w.b+3 = t.a
) AS derived;
