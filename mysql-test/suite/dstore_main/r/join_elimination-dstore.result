# The same, with a subquery in ON inside the removed nest. This
# is to demonstrate that, when removing the nest t2-t3, we must also
# clean up any subquery inside it, not just the ON clause of t1 LEFT
# JOIN (t2-t3). Otherwise, it remains "dangling" and causes
# subquery-partial-result-cache to crash.
EXPLAIN SELECT DISTINCT t1.a FROM t1 LEFT JOIN (t2 LEFT JOIN t1 AS t3 ON t3.a=(SELECT t4.a FROM t1 AS t4 WHERE t2.b<4 ORDER BY 1 LIMIT 1)) ON COALESCE(t3.a,1)=1;
