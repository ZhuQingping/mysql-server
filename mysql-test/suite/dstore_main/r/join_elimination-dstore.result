# BUG2025112734711 Execute query and enable
# partial_result_cache and left_join_elimination at the same
# time, mysqld crashes：CreateNestedLoopAccessPath
CREATE TABLE t1 (medal_now INT);
CREATE TABLE t2 (id INT);
CREATE TABLE t3 (medal_now INT);
INSERT INTO t1 (medal_now) VALUES (1);
INSERT INTO t2 (id) VALUES (1), (2), (3);
INSERT INTO t3 (medal_now) VALUES (1), (2), (NULL);
# Used to crash. This CASE is always non-NULL, so IS NULL says it is
# constant FALSE and thus contains no reference so ref_49 is eliminated
# from the left join; still the subquery remains in the tree of
# Query_expression-s, gets optimized, Partial Table Result Cache is set
# up for it, sees that it depends on outer value ref49.medal_now, and
# then crashes when trying to access statistics of ref_49 which do not
# exist as ref_49 has not been dealt with by the Optimizer when
# optimizing the outer query.
EXPLAIN SELECT DISTINCT
(CASE WHEN EXISTS (SELECT ref_49.medal_now FROM t1) THEN 1 ELSE 0 END) IS NULL
FROM t2 LEFT JOIN t3 AS ref_49 ON TRUE;
