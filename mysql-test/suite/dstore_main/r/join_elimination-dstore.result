# Equality on string column is tricky, we test it
ALTER TABLE t2 ADD UNIQUE INDEX (c);
# No elimination, comparing number on left to string on right.
# In detail: imagine te left table has one row with integer
# value 1, and the right table has two rows with string values
# '1' and '1.0' (which are different strings, so UNIQUE is
# respected) : with the original query there will be _two_ matches in
# the join (comparison is done as numbers), and two rows in the result;
# with elimination, only one row).
EXPLAIN SELECT t1.a FROM t1 LEFT JOIN t2 ON t2.c=t1.a;
