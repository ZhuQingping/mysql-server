#
#  DDL CRASH SAFE TEST: ALL DDL TEST PART 01
#  This test will check whether the server can recovery from different
#  phases of ALL DDLs without inconsistency between dstore and
#  innodb. Each DDL will be tested at 3 crash points and recovery
#  results will be verified.
#
CREATE DATABASE test_ddl_crash_comprehensive;
USE test_ddl_crash_comprehensive;
#  1. Crash on CREATE TABLE statement.
#  1.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
CREATE TABLE t_ddl_crash_create_table_01(pk INT PRIMARY KEY, col1 INT);
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify table should not exist after crash before prepare
SHOW CREATE TABLE t_ddl_crash_create_table_01;
ERROR 42S02: Table 'test_ddl_crash_comprehensive.t_ddl_crash_create_table_01' doesn't exist
#  1.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
CREATE TABLE t_ddl_crash_create_table_01(pk INT PRIMARY KEY, col1 INT);
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify table should not exist after crash after prepare but before commit
SHOW CREATE TABLE t_ddl_crash_create_table_01;
ERROR 42S02: Table 'test_ddl_crash_comprehensive.t_ddl_crash_create_table_01' doesn't exist
#  1.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
CREATE TABLE t_ddl_crash_create_table_01(pk INT PRIMARY KEY, col1 INT);
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify table should exist after crash after dstore commit
SHOW CREATE TABLE t_ddl_crash_create_table_01;
Table	Create Table
t_ddl_crash_create_table_01	CREATE TABLE `t_ddl_crash_create_table_01` (
  `pk` int NOT NULL,
  `col1` int DEFAULT NULL,
  PRIMARY KEY (`pk`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t_ddl_crash_create_table_01 VALUES(1,2),(2,3),(3,4);
SELECT * FROM t_ddl_crash_create_table_01;
pk	col1
1	2
2	3
3	4
