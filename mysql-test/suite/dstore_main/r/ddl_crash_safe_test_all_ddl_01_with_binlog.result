SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
CREATE TABLE t_ddl_crash_ctas AS SELECT * FROM t_ddl_crash_create_table_01;
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify CTAS table should not exist
SHOW CREATE TABLE t_ddl_crash_ctas;
ERROR 42S02: Table 'test_ddl_crash_comprehensive.t_ddl_crash_ctas' doesn't exist
#  2.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
CREATE TABLE t_ddl_crash_ctas AS SELECT * FROM t_ddl_crash_create_table_01;
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify CTAS table should exist with data
SHOW CREATE TABLE t_ddl_crash_ctas;
Table	Create Table
t_ddl_crash_ctas	CREATE TABLE `t_ddl_crash_ctas` (
  `pk` int NOT NULL,
  `col1` int DEFAULT NULL
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT * FROM t_ddl_crash_ctas;
pk	col1
1	2
2	3
