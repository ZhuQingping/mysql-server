id INT NOT NULL,
col_year YEAR,
col_date DATE NOT NULL,
col_dt DATETIME(6) NOT NULL,
col_ts TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
col_time TIME(6) NOT NULL DEFAULT '00:00:00',
PRIMARY KEY (id),
INDEX idx_year (col_year),
INDEX idx_date (col_date),
INDEX idx_dt (col_dt),
INDEX idx_ts (col_ts),
INDEX idx_time (col_time)
) DEFAULT CHARSET=utf8mb4;
