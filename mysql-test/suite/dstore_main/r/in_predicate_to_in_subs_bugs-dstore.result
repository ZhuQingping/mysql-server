prepare stmt1 from 'explain select b from t1 where t1.b != any (select b from t2) and t1.b IN (1,2,3) order by b';
prepare stmt2 from 'explain format=tree select b from t1 where t1.b != any (select b from t2) and t1.b IN (1,2,3) order by b';
prepare stmt3 from 'select b from t1 where t1.b != any (select b from t2) and t1.b IN (1,2,3) order by b';
