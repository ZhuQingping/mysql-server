DESCRIBE INFORMATION_SCHEMA.DSTORE_SEGMENT;
Field	Type	Null	Key	Default	Extra
SEGMENT_ID	varchar(20)	NO			
TYPE	varchar(10)	NO			
DB_NAME	varchar(320)	NO			
TABLE_NAME	varchar(320)	NO			
INDEX_NAME	varchar(320)	NO			
PARTITION_NAME	varchar(320)	NO			
TABLESPACE	bigint unsigned	NO			
FILL_FACTOR	int unsigned	NO			
PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_64B_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_128B_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_512B_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_1K_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_2K_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_4K_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_8K_PAGE_COUNT	bigint unsigned	NO			
DROP DATABASE IF EXISTS IS_PUSHDOWN;
CREATE DATABASE IS_PUSHDOWN;
USE IS_PUSHDOWN;
DROP TABLE IF EXISTS test_dstore_segment1;
DROP TABLE IF EXISTS test_dstore_segment2;
DROP TABLE IF EXISTS test_dstore_segment3;
DROP TABLE IF EXISTS test_dstore_segment_no_index;
CREATE TABLE test_dstore_segment1 (
id INT PRIMARY KEY AUTO_INCREMENT,
data INT,
info VARCHAR(50)
) ENGINE=DSTORE;
CREATE TABLE test_dstore_segment2 (
id INT PRIMARY KEY AUTO_INCREMENT,
data INT,
info VARCHAR(50),
INDEX idx_segment2_data (data)
) ENGINE=DSTORE;
CREATE TABLE test_dstore_segment3 (
id INT PRIMARY KEY AUTO_INCREMENT,
data INT,
info BLOB
) ENGINE=DSTORE;
CREATE TABLE test_dstore_segment_no_index (
id INT
) ENGINE=DSTORE;
DROP PROCEDURE IF EXISTS insert_test_data;
CREATE PROCEDURE insert_test_data()
BEGIN
DECLARE i INT DEFAULT 1;
DECLARE EXIT HANDLER FOR SQLEXCEPTION ROLLBACK;
START TRANSACTION;
WHILE i <= 500 DO
INSERT INTO test_dstore_segment1 (data, info) VALUES (i, CONCAT('test_', i));
INSERT INTO test_dstore_segment2 (data, info) VALUES (i, CONCAT('test_', i));
INSERT INTO test_dstore_segment3 (data, info) VALUES (i, REPEAT(i, 3000));
SET i = i + 1;
IF i % 100 = 0 THEN
COMMIT;
START TRANSACTION;
END IF;
END WHILE;
COMMIT;
END |
DROP PROCEDURE IF EXISTS query_test_data;
CREATE PROCEDURE query_test_data()
BEGIN
DECLARE dummy INT;
SELECT COUNT(*) INTO dummy FROM test_dstore_segment1 WHERE data < 100;
SELECT COUNT(*) INTO dummy FROM test_dstore_segment1 WHERE data > 400;
SELECT MAX(data) INTO dummy FROM test_dstore_segment1;
END |
CALL insert_test_data();
CALL query_test_data();
