INSERT INTO t3 SELECT e, myfunc_double(b), max(a) from t1 group by b;
CREATE PROCEDURE curdemo()
BEGIN
DECLARE done INT DEFAULT FALSE;
DECLARE max_a INT;
DECLARE store_e INT;
DECLARE store_r REAL;
DECLARE cur1 CURSOR FOR SELECT e, myfunc_double(b), max(a) from t1 group by b;
DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
OPEN cur1;
read_loop: LOOP
FETCH cur1 INTO store_e, store_r, max_a;
IF done THEN
LEAVE read_loop;
END IF;
INSERT INTO t3 VALUES (store_e, store_r, max_a);
END LOOP;
CLOSE cur1;
END|
call curdemo();
