INSERT INTO t2 VALUES ("r1c1", "r1c2");
SELECT * FROM t2;
c1	c2
r1c1	r1c2
CREATE TABLE t1 (c1 char(10), c2 char(10));
INSERT INTO t1 VALUES ("r1c1", "r1c2");
SELECT * FROM t1;
c1	c2
r1c1	r1c2
BEGIN;
SELECT * FROM t2;
c1	c2
r1c1	r1c2
### Connection B: Change table t1 definition
ALTER TABLE t1 ADD COLUMN c3 char(10) DEFAULT "c3_def",ALGORITHM=INSTANT;
UPDATE t1 SET c1 = "r1c11";
SELECT * FROM t1;
c1	c2	c3
r1c11	r1c2	c3_def
