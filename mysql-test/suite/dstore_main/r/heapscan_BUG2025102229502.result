DROP TABLE IF EXISTS `yy_player_t0`;
CREATE TABLE `yy_player_t0` (
`id` int unsigned NOT NULL AUTO_INCREMENT COMMENT '主键ID',
`android_id` varchar(50) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci DEFAULT NULL,
`nick_name` varchar(10) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL DEFAULT '' COMMENT '用户昵称',
`username` varchar(30) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL DEFAULT '' COMMENT '用户名',
`icon_url` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci DEFAULT NULL COMMENT '头像地址',
`channel` smallint NOT NULL DEFAULT '0' COMMENT '渠道ID',
`sources_cid` smallint unsigned NOT NULL,
`invitation_uid` int NOT NULL,
`password` char(32) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL DEFAULT '' COMMENT '密码',
`salt` char(6) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL DEFAULT '',
`regip` bigint unsigned NOT NULL COMMENT '注册IP',
`system1` tinyint unsigned NOT NULL DEFAULT '1' COMMENT '1 安卓',
`maker` varchar(20) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL DEFAULT '' COMMENT '手机厂商',
`mobile_model` varchar(40) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL DEFAULT '' COMMENT '手机型号',
`machine_code` char(64) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL COMMENT '设备号',
`system_version` varchar(20) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL DEFAULT '' COMMENT '系统版本',
`vip_update` int unsigned NOT NULL DEFAULT '0' COMMENT '会员生效时间',
`vip_end` bigint NOT NULL DEFAULT '0',
`last_login_time` int unsigned NOT NULL DEFAULT '0' COMMENT '最后登录时间',
`create_time` int unsigned NOT NULL DEFAULT '0' COMMENT '创建时间',
`modify_time` int NOT NULL DEFAULT '0' COMMENT '修改时间',
`status` tinyint unsigned NOT NULL DEFAULT '1' COMMENT '1 正常 2 禁号',
`sk_num` int unsigned DEFAULT '10',
`is_login` tinyint(1) NOT NULL DEFAULT '0' COMMENT '登录状态 0-未登录，1-已登录',
`mobile` char(11) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL COMMENT '手机号',
`coin` int DEFAULT '0' COMMENT '金币',
`share_num` int DEFAULT '0' COMMENT '链接分享次数(不包含二维码分享)',
`qrcode_num` int DEFAULT '0' COMMENT '扫码邀请下载次数',
`url_num` int DEFAULT '0' COMMENT '链接邀请下载次数',
`token` varchar(40) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci DEFAULT NULL COMMENT 'token',
`birthday` char(30) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci DEFAULT NULL COMMENT '生日',
`gender` int DEFAULT '0' COMMENT '性别:0保密，1男，2女',
`email` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci DEFAULT NULL COMMENT '邮箱',
`history_total_coin` decimal(20,2) unsigned DEFAULT '0.00' COMMENT '历史获得金币总额',
`uid` varchar(20) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci DEFAULT '' COMMENT '用户识别码',
`mcoin` int unsigned NOT NULL DEFAULT '0' COMMENT 'M币',
`movie_ticket` int unsigned NOT NULL DEFAULT '0' COMMENT '观影券数量',
`invitation_number` int unsigned NOT NULL DEFAULT '0' COMMENT '成功邀请人数',
`total_recharge_friends` decimal(20,2) unsigned NOT NULL DEFAULT '0.00' COMMENT '好友充值总金额',
`vip_level` int unsigned NOT NULL DEFAULT '0' COMMENT '当前vip等级',
`vip_experience` int unsigned NOT NULL DEFAULT '0' COMMENT '当前vip经验',
`pwd` varchar(32) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL DEFAULT '' COMMENT '未加密的密码',
`account` varchar(12) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL DEFAULT '' COMMENT '初始账号或者说成uid',
`fans` int DEFAULT '0' COMMENT '粉丝数量',
`account_status` tinyint(1) NOT NULL DEFAULT '0' COMMENT '账号绑定状态',
`imei` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci DEFAULT '' COMMENT '设备识别号',
`hash_code` varchar(255) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci DEFAULT '' COMMENT '哈希识别码',
`last_update` int NOT NULL DEFAULT '0' COMMENT '上次头像或昵称修改时间',
`vip_start` int NOT NULL DEFAULT '0' COMMENT '首次成为vip的时间',
`medal` int NOT NULL DEFAULT '0' COMMENT '获得勋章的数量',
`medal_now` int NOT NULL DEFAULT '0' COMMENT '当前佩戴的勋章',
`draw_ticket` int NOT NULL DEFAULT '0' COMMENT '抽奖券',
PRIMARY KEY (`id` DESC) USING BTREE,
KEY `invitation_uid` (`invitation_uid` DESC) USING BTREE,
KEY `create_time` (`create_time` DESC) USING BTREE,
KEY `idx_machinecode` (`machine_code` DESC) USING BTREE,
KEY `idx_sourcescid` (`sources_cid` DESC) USING BTREE,
KEY `idx_mobile` (`mobile` DESC) USING BTREE,
KEY `idx_status` (`status` DESC) USING BTREE,
KEY `idx_username` (`username` DESC) USING BTREE,
KEY `idx_account` (`account` DESC) USING BTREE,
KEY `idx_token` (`token` DESC) USING BTREE,
KEY `idx_channel` (`channel` DESC) USING BTREE
) ENGINE=Dstore AUTO_INCREMENT=25755116 DEFAULT CHARSET=utf8mb3 COMMENT='用户表';
