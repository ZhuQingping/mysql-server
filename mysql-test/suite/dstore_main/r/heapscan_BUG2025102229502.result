DROP TABLE IF EXISTS `t11`;
CREATE TABLE `t11` (
`C_ID` int NOT NULL DEFAULT '99' COMMENT 'string',
`C_D_ID` int DEFAULT NULL,
`C_W_ID` bigint DEFAULT NULL,
`C_DOUBLE` double DEFAULT NULL,
`C_DECIMAL` decimal(10,0) DEFAULT NULL,
`C_FIRST` varchar(64) DEFAULT NULL,
`C_MIDDLE` char(2) DEFAULT NULL,
`C_LAST` varchar(64) DEFAULT NULL,
`C_STREET_1` varchar(20) DEFAULT NULL,
`C_STREET_2` varchar(20) DEFAULT NULL,
`C_CITY` varchar(64) DEFAULT NULL,
`C_STATE` char(2) DEFAULT NULL,
`C_ZIP` char(9) DEFAULT NULL,
`C_PHONE` char(16) DEFAULT NULL,
`C_SINCE` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
`C_CREDIT` char(2) DEFAULT NULL,
`C_CREDIT_LIM` decimal(12,2) DEFAULT NULL,
`C_DISCOUNT` decimal(4,4) DEFAULT NULL,
`C_BALANCE` decimal(12,2) DEFAULT NULL,
`C_YTD_PAYMENT` double DEFAULT NULL,
`C_PAYMENT_CNT` float DEFAULT NULL,
`C_DELIVERY_CNT` tinyint(1) DEFAULT NULL,
`C_END` date DEFAULT NULL,
`C_VCHAR` varchar(1000) DEFAULT NULL,
PRIMARY KEY (`C_ID` DESC),
UNIQUE KEY `C_ID` (`C_ID`),
UNIQUE KEY `C_ID_2` (`C_ID`) COMMENT 'string',
KEY `index_CREATE_TABLE_PART_HASH_029_taurus` (`C_ID` DESC) USING BTREE,
KEY `ndx_C_ID` (`C_ID`) USING BTREE,
KEY `ndx_C_D_ID` (`C_D_ID`) USING BTREE,
KEY `ndx_C_W_ID` (`C_W_ID`) USING BTREE,
KEY `ndx_C_DOUBLE` (`C_DOUBLE`) USING BTREE,
KEY `ndx_C_DECIMAL` (`C_DECIMAL`) USING BTREE,
KEY `ndx_C_FIRST` (`C_FIRST`) USING BTREE,
KEY `ndx_C_MIDDLE` (`C_MIDDLE`) USING BTREE,
KEY `ndx_C_LAST` (`C_LAST`) USING BTREE,
KEY `ndx_C_STREET_1` (`C_STREET_1`) USING BTREE,
KEY `ndx_C_STREET_2` (`C_STREET_2`) USING BTREE,
KEY `ndx_C_CITY` (`C_CITY`) USING BTREE,
KEY `ndx_C_STATE` (`C_STATE`) USING BTREE,
KEY `ndx_C_ZIP` (`C_ZIP`) USING BTREE,
KEY `ndx_C_PHONE` (`C_PHONE`) USING BTREE,
KEY `ndx_C_SINCE` (`C_SINCE`) USING BTREE,
KEY `ndx_C_CREDIT` (`C_CREDIT`) USING BTREE,
KEY `ndx_C_CREDIT_LIM` (`C_CREDIT_LIM`) USING BTREE,
KEY `ndx_C_DISCOUNT` (`C_DISCOUNT`) USING BTREE,
KEY `ndx_C_BALANCE` (`C_BALANCE`) USING BTREE,
KEY `ndx_C_YTD_PAYMENT` (`C_YTD_PAYMENT`) USING BTREE,
KEY `ndx_C_PAYMENT_CNT` (`C_PAYMENT_CNT`) USING BTREE,
KEY `ndx_C_DELIVERY_CNT` (`C_DELIVERY_CNT`) USING BTREE,
KEY `ndx_C_END` (`C_END`) USING BTREE
) ENGINE=Dstore DEFAULT CHARSET=utf8mb3 MAX_ROWS=99 AVG_ROW_LENGTH=8 PACK_KEYS=1 DELAY_KEY_WRITE=1 CONNECTION='connect_string';
INSERT INTO `t11` VALUES (9,8,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'2020-11-05 09:25:23',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL),(8,7,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'2020-11-05 09:25:23',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL),(7,6,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'2020-11-05 09:25:23',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL),(6,5,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'2020-11-05 09:25:23',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL),(5,4,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'2020-11-05 09:25:23',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL),(4,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'2020-11-05 09:25:23',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL),(3,2,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'2020-11-05 09:25:23',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL),(2,1,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'2020-11-05 09:25:23',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL),(1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'2020-11-05 09:25:23',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL),(0,9,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'2020-11-05 09:25:24',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL);
CREATE VIEW `sqltester_1`.`t0_partition_sub_view_mixed_001` AS select 1 AS `c_id`,1 AS `c_d_id`,1 AS `c_w_id`,1 AS `c_first`,1 AS `c_middle`,1 AS `c_last`,1 AS `c_street_1`,1 AS `c_street_2`,1 AS `c_city`,1 AS `c_state`,1 AS `c_zip`,1 AS `c_phone`,1 AS `c_since`,1 AS `c_credit`,1 AS `c_credit_lim`,1 AS `c_discount`,1 AS `c_balance`,1 AS `c_ytd_payment`,1 AS `c_payment_cnt`,1 AS `c_delivery_cnt`,1 AS `c_data`;
create  VIEW `sqltester_1`.`tx_cmplx_003` AS select 1 AS `c0`,1 AS `c1`,1 AS `c2`,1 AS `c3`,1 AS `c4`,1 AS `c5`,1 AS `c6`,1 AS `c7`,1 AS `c8`,1 AS `c9`,1 AS `c10`,1 AS `c11`;
create VIEW `sqltester_1`.`t0_t10_sub_1` AS select 1 AS `c_d_id`,1 AS `c_id`,1 AS `c_middle`,1 AS `c_street_1`,1 AS `c_credit`,1 AS `c_w_id`;
create VIEW `sqltester_1`.`t0_hash_partition_p1_view` AS select 1 AS `c_id`,1 AS `c_d_id`,1 AS `c_w_id`,1 AS `c_first`,1 AS `c_middle`,1 AS `c_last`,1 AS `c_street_1`,1 AS `c_street_2`,1 AS `c_city`,1 AS `c_state`,1 AS `c_zip`,1 AS `c_phone`,1 AS `c_since`,1 AS `c_credit`,1 AS `c_credit_lim`,1 AS `c_discount`,1 AS `c_balance`,1 AS `c_ytd_payment`,1 AS `c_payment_cnt`,1 AS `c_delivery_cnt`,1 AS `c_data`;
create VIEW `sqltester_1`.`t0_sub_union` AS select 1 AS `c_d_id`,1 AS `c_id`,1 AS `c_w_id`,1 AS `c_middle`,1 AS `c_street_1`,1 AS `c_credit`;
create VIEW `sqltester_1`.`tx_cmplx_001` AS select 1 AS `c1`,1 AS `c2`;
use sqltester;
prepare stmt from "
select distinct  
  subq_1.c0 as c0, 
  ref_6.c_w_id as c1
from 
  (select distinct  
            ref_1.c_street_1 as c0, 
            ref_0.c_state as c1, 
            database() as c2, 
            binary(
              log10(
                (select distinct sources_cid from sqltester.yy_player_t0 order by 1 limit 1 offset 6)
                  )) as c3
          from 
            sqltester.t0_partition_sub_view_mixed_001 as ref_0
              right join sqltester.t0_sub_1 as ref_1
              on ((schema() is not NULL) 
                  or ((select distinct C_STREET_2 from sqltester.t10 order by 1 limit 1 offset 5)
                       is not NULL))
          where true
          ) as subq_0
      left join (select distinct  
                ref_2.C_W_ID as c0
              from 
                sqltester.t11 as ref_2
              where EXISTS (
                select distinct  
                    cos(
                      pi()) as c0, 
                    (select distinct max(c_id) from sqltester_1.t0_partition_sub_view_mixed_001)
                       as c1, 
                    nullif(
                      ref_2.C_PAYMENT_CNT,
                      ref_2.C_PAYMENT_CNT) as c2
                  from 
                    sqltester.tx_cmplx_004 as ref_3
                  where (ref_2.C_YTD_PAYMENT is not NULL) 
                    or (EXISTS (
                      select distinct  
                          aes_encrypt(
                            ref_2.C_FIRST,
                            ref_2.C_LAST) as c0, 
                          ref_2.C_DOUBLE as c1, 
                          ref_4.c3 as c2, 
                          pi() as c3, 
                          ref_2.C_CITY as c4, 
                          ref_4.c1 as c5, 
                          ref_2.C_SINCE as c6, 
                          ref_4.c1 as c7, 
                          ref_2.C_W_ID as c8, 
                          ref_4.c3 as c9, 
                          ref_4.c3 as c10, 
                          ref_3.c2 as c11, 
                          ref_3.c2 as c12, 
                          year(
                            ref_2.C_END) as c13, 
                          schema() as c14
                        from 
                          sqltester.tx_cmplx_004 as ref_4
                        where ref_2.C_D_ID is NULL
                        ))
                  )
              ) as subq_1
          inner join sqltester.t4 as ref_5
            inner join sqltester_1.t1 as ref_6
            on ((((false) 
                    or (ref_5.c_city is NULL)) 
                  or (ref_6.c_state is not NULL)) 
                and (ref_5.c_street_2 is not NULL))
          on (ref_6.c_discount is NULL)
        left join sqltester.t10 as ref_7
        on (((ref_5.c_last is NULL) 
              and ((EXISTS (
                  select distinct  
                      quarter(
                        ref_7.C_SINCE) as c0
                    from 
                      sqltester_1.tx_cmplx_003 as ref_8
                    where EXISTS (
                      select distinct  
                          ref_8.c5 as c0, 
                          ref_8.c7 as c1, 
                          yearweek(
                            ref_7.C_END) as c2, 
                          ref_7.C_DECIMAL as c3
                        from 
                          sqltester_1.t0_t10_sub_1 as ref_9
                        where false
                        )
                    )) 
                or (EXISTS (
                  select distinct  
                      ref_5.c_data as c0, 
                      ref_7.C_BIT as c1
                    from 
                      sqltester_1.t11 as ref_10
                    where (true) 
                      and (((select distinct bigint_col from sqltester.t2 order by 1 limit 1 offset 1)
                             is not NULL) 
                        or (true))
                    )))) 
            or ((true) 
              or ((false) 
                and (true))))
      on ((subq_1.c0 is not NULL) 
          or (true))
    inner join sqltester.tx_cmplx_004 as ref_11
    on ((true) 
        or ((false) 
          and (EXISTS (
            select distinct  
                subq_0.c1 as c0, 
                pi() as c1
              from 
                sqltester_1.t0_hash_partition_p1_view as ref_12
              where (select distinct min(c_street_1) from sqltester_1.t0_sub_union)
                   is NULL
              ))))
where (EXISTS (
    select distinct  
        ref_6.c_phone as c0, 
        database() as c1, 
        subq_1.c0 as c2, 
        46 as c3, 
        unhex(
          
            max(
              ref_7.C_DOUBLE) over (partition by subq_0.c2 order by ref_14.c_last)) as c4, 
        database() as c5, 
        ref_11.c1 as c6, 
        mod(
          ref_7.C_PAYMENT_CNT,
          ref_15.c_payment_cnt) as c7, 
        ref_15.c_phone as c8, 
        subq_0.c3 as c9, 
        ref_13.c1 as c10, 
        subq_0.c0 as c11, 
        ref_6.c_delivery_cnt as c12, 
        schema() as c13, 
        ref_14.c_middle as c14, 
        ref_5.c_state as c15, 
        ref_6.c_credit_lim as c16, 
        schema() as c17, 
        ref_5.c_phone as c18, 
        ref_11.c3 as c19
      from 
        sqltester_1.tx_cmplx_001 as ref_13
            inner join sqltester_1.t0 as ref_14
            on ((ref_14.c_payment_cnt is NULL) 
                and (ref_14.c_id is not NULL))
          inner join sqltester.t0_partition_sub_view_mixed_001 as ref_15
          on ((ref_14.c_discount is NULL) 
              and (EXISTS (
                select distinct  
                    locate(
                      ref_14.c_zip,
                      ref_14.c_phone) as c0, 
                    ref_16.c_street_1 as c1, 
                    ref_13.c1 as c2, 
                    ref_13.c1 as c3, 
                    ref_15.c_ytd_payment as c4, 
                    ref_14.c_first as c5, 
                    ref_13.c2 as c6
                  from 
                    sqltester.t0_sub_union as ref_16
                  where ref_16.c_middle is NULL
                  )))
      where ref_15.c_phone is not NULL
      )) 
  or (EXISTS (
    select distinct  
        ref_21.C_FIRST as c0, 
        ref_18.C_VARCHARS as c1
      from 
        sqltester.common_t0 as ref_17
              inner join sqltester.key_pt_t0 as ref_18
                inner join sqltester.t11 as ref_19
                on (ref_18.C_DATE = ref_19.C_END )
              on ((ref_17.C_TINYINT_ID is not NULL) 
                  or (EXISTS (
                    select distinct  
                        ref_17.C_DATE as c0, 
                        ref_19.C_STATE as c1, 
                        ref_17.C_UINT_ID as c2, 
                        ref_19.C_STATE as c3, 
                        ref_20.c2 as c4, 
                        ref_17.C_PART_ID as c5, 
                        ref_18.C_VARCHARTWN as c6, 
                        ref_20.c4 as c7, 
                        ref_18.C_TINYTEXT as c8, 
                        ref_17.C_TINYTEXT as c9
                      from 
                        sqltester_1.tx_cmplx_003 as ref_20
                      where true
                      )))
            inner join sqltester.t11 as ref_21
              left join sqltester_1.t0_t10_sub_1 as ref_22
              on (ref_21.C_D_ID = ref_22.c_d_id )
            on (((true) 
                  or (true)) 
                and (ref_17.C_DOUBLE is not NULL))
          left join sqltester.key_pt_t0 as ref_23
          on (false)
      where false
      ))

group by 1,2
order by 1,2 desc";
execute stmt;
