DROP TABLE IF EXISTS t1, t2;
#
# Test 1: Parameter Value Tests
#
# 1.1 default value
SELECT @@session.dstore_parallel_read_threads;
@@session.dstore_parallel_read_threads
4
# 1.2 valid value
SET SESSION dstore_parallel_read_threads = 0;
SELECT @@session.dstore_parallel_read_threads;
@@session.dstore_parallel_read_threads
0
SET SESSION dstore_parallel_read_threads = 1;
SELECT @@session.dstore_parallel_read_threads;
@@session.dstore_parallel_read_threads
1
SET SESSION dstore_parallel_read_threads = 8;
SELECT @@session.dstore_parallel_read_threads;
@@session.dstore_parallel_read_threads
8
SET SESSION dstore_parallel_read_threads = 16;
SELECT @@session.dstore_parallel_read_threads;
@@session.dstore_parallel_read_threads
16
SET SESSION dstore_parallel_read_threads = 128;
SELECT @@session.dstore_parallel_read_threads;
@@session.dstore_parallel_read_threads
128
# 1.3 border value
SET SESSION dstore_parallel_read_threads = -1;
Warnings:
Warning	1292	Truncated incorrect dstore_parallel_read_threads value: '-1'
# should truncate to 0
SELECT @@session.dstore_parallel_read_threads;
@@session.dstore_parallel_read_threads
0
SET SESSION dstore_parallel_read_threads = 129;
Warnings:
Warning	1292	Truncated incorrect dstore_parallel_read_threads value: '129'
# should truncate to 128
SELECT @@session.dstore_parallel_read_threads;
@@session.dstore_parallel_read_threads
128
SET SESSION dstore_parallel_read_threads = 'abc';
ERROR 42000: Incorrect argument type to variable 'dstore_parallel_read_threads'
# 1.4 session & global variable test
SET GLOBAL dstore_parallel_read_threads = 8;
SELECT @@global.dstore_parallel_read_threads;
@@global.dstore_parallel_read_threads
8
SELECT @@session.dstore_parallel_read_threads;
@@session.dstore_parallel_read_threads
8
SET GLOBAL dstore_parallel_read_threads = 4;
#
# Test 2: Basic Functionality Tests
#
# 2.1 test table
CREATE TABLE t1 (
id INT,
name VARCHAR(100),
age INT NOT NULL
) ENGINE=DSTORE;
# 2.2 load data - small dateset
INSERT INTO t1 VALUES (1, 'Alice', 25), (2, 'Bob', 30), (3, 'Charlie', 35);
# 2.3 disable parallel reader
SET SESSION dstore_parallel_read_threads = 0;
SELECT COUNT(*) FROM t1;
COUNT(*)
3
# 2.4 signal thread
SET SESSION dstore_parallel_read_threads = 1;
SELECT COUNT(*) FROM t1;
COUNT(*)
3
# 2.5 multi-thread
SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t1;
COUNT(*)
3
# 2.7 load data - big dataset
SET SESSION dstore_parallel_read_threads = 0;
SELECT COUNT(*) FROM t1;
COUNT(*)
20003
SET SESSION dstore_parallel_read_threads = 8;
SELECT COUNT(*) FROM t1;
COUNT(*)
20003
# 2.8 empty table
CREATE TABLE t2 (id INT PRIMARY KEY, data VARCHAR(100)) ENGINE=DSTORE;
SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t2;
COUNT(*)
0
#
# Test 3: Lock Mode Tests
#
# 3.1 LOCK NONE（should use parallel）
SET SESSION dstore_parallel_read_threads = 4;
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
START TRANSACTION;
SELECT COUNT(*) FROM t1;
COUNT(*)
20003
COMMIT;
# 3.2 LOCK X（should use handler::records）
START TRANSACTION;
SELECT COUNT(*) FROM t1 FOR UPDATE;
COUNT(*)
20003
COMMIT;
START TRANSACTION;
SELECT COUNT(*) FROM t1 LOCK IN SHARE MODE;
COUNT(*)
20003
COMMIT;
#
# Test 4: Transaction Isolation Tests
#
SET SESSION dstore_parallel_read_threads = 4;
# 4.1 READ COMMITTED
START TRANSACTION;
INSERT INTO t1 SELECT * FROM t1 LIMIT 10;
SELECT COUNT(*) FROM t1;
COUNT(*)
20003
COMMIT;
SELECT COUNT(*) FROM t1;
COUNT(*)
20013
#
# Test 5: Concurrency Tests
#
# 5.1 multi session count(*)
SET SESSION dstore_parallel_read_threads = 4;
SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t1;
SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t1;
COUNT(*)
20013
COUNT(*)
20013
#
# Test 6: Edge Case Tests
#
# 6.1 init data
SET SESSION dstore_parallel_read_threads = 16;
SELECT COUNT(*) FROM t1;
COUNT(*)
20013
# 6.2 recreate table case
DROP TABLE t1;
CREATE TABLE t1 (id INT, val INT NOT NULL) ENGINE=DSTORE;
INSERT INTO t1 VALUES (1, 100), (2, 200), (3, 300);
SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t1;
COUNT(*)
3
#
# Test 7: test with other releated features
#
# 7.1 test with condition
SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t1 WHERE val > 30;
COUNT(*)
3
# 7.2 test with NOT NULL COLUMN optimization(age COLUMN is not null)
SELECT COUNT(val) FROM t1;
COUNT(val)
3
# 7.3 test with LEFT JOIN elimination
SELECT COUNT(*) FROM t1 LEFT JOIN t2 ON t1.id = t2.id;
COUNT(*)
3
#
# Test 8: test with TEMPORARY table
#
CREATE TEMPORARY TABLE t_t (id INT, val INT NOT NULL) ENGINE=DSTORE;
SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t_t;
COUNT(*)
10000
DROP TABLE t_t;
#
# Test 9: Cleanup
#
# 9.1 drop all tables
DROP TABLE t1, t2;
# 9.2 retore parameter value.
SET GLOBAL dstore_parallel_read_threads = 4;
SET SESSION dstore_parallel_read_threads = 4;
#
# Test completed successfully
#
