ALTER TABLE t1 ADD COLUMN s1 BLOB, ADD COLUMN s2 TEXT, ALGORITHM=INSTANT;
ERROR HY000: BLOB Column can't be added with ALGORITHM=INSTANT. Try ALGORITHM=INPLACE/COPY.
ALTER TABLE t1 ADD COLUMN s1 BLOB, ADD COLUMN s2 TEXT, ALGORITHM=COPY;
