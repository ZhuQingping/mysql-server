SELECT hex(n1) FROM t1 WHERE n1 = 0x01020304050607080900;
hex(n1)
01020304050607080900
SELECT hex(n2) FROM t1 WHERE n2 = 0x102030405060708090;
hex(n2)
102030405060708090
