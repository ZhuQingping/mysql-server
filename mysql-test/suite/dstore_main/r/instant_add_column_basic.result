test.t1	check	note	The storage engine for the table doesn't support check
INSERT INTO t1(a, d2) VALUES(0, 1234);
SELECT count(*) = max(a) FROM t1 WHERE d2 = 1234567890;
count(*) = max(a)
1
SELECT d2 FROM t1 WHERE d2 = 1234;
d2
1234
