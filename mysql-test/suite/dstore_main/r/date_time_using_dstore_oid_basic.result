# ===============================================
# COMPREHENSIVE PRECISION TESTING
# ===============================================
CREATE TABLE t_precision_test (
id INT AUTO_INCREMENT PRIMARY KEY,
description VARCHAR(100),
dt0 DATETIME(0),
dt1 DATETIME(1),
dt2 DATETIME(2),
dt3 DATETIME(3),
dt4 DATETIME(4),
dt5 DATETIME(5),
dt6 DATETIME(6),
ts0 TIMESTAMP(0) NULL,
ts1 TIMESTAMP(1) NULL,
ts2 TIMESTAMP(2) NULL,
ts3 TIMESTAMP(3) NULL,
ts4 TIMESTAMP(4) NULL,
ts5 TIMESTAMP(5) NULL,
ts6 TIMESTAMP(6) NULL,
t0 TIME(0),
t1 TIME(1),
t2 TIME(2),
t3 TIME(3),
t4 TIME(4),
t5 TIME(5),
t6 TIME(6),
KEY idx_dt6 (dt6),
KEY idx_ts6 (ts6),
KEY idx_t6 (t6)
);

