fixed_utc	fixed_utc_6
2021-01-01 00:00:00	2021-01-01 00:00:00.123456
SET time_zone = '+08:00';
SELECT FROM_UNIXTIME(1609459200) as fixed_beijing, FROM_UNIXTIME(1609459200.123456) as fixed_beijing_6;
fixed_beijing	fixed_beijing_6
2021-01-01 08:00:00	2021-01-01 08:00:00.123456
SET time_zone = @original_time_zone;
DROP TABLE t_date_time_test;
DROP TABLE t_timezone_test;
DROP TABLE t_precision_test;
