SET @original_time_zone = @@time_zone;
SET @original_system_time_zone = @@system_time_zone;
DROP TABLE IF EXISTS t_date_time_test;
Warnings:
Note	1051	Unknown table 'test.t_date_time_test'
DROP TABLE IF EXISTS t_timezone_test;
Warnings:
Note	1051	Unknown table 'test.t_timezone_test'
DROP TABLE IF EXISTS t_precision_test;
Warnings:
Note	1051	Unknown table 'test.t_precision_test'

# Testing DATE type operations
CREATE TABLE t_date_time_test (
id INT AUTO_INCREMENT PRIMARY KEY,
d DATE,
dt DATETIME,
ts TIMESTAMP,
t TIME,
KEY idx_date (d),
KEY idx_datetime (dt),
KEY idx_timestamp (ts),
KEY idx_time (t)
);
INSERT INTO t_date_time_test (d) VALUES 
('1000-01-01'),     # Min date
('2023-12-31'),     # Regular date
('9999-12-31'),     # Max date
('2024-02-29'),     # Leap year
('2023-02-28'),     # Non-leap year
(NULL);
# Basic DATE comparisons
SELECT d FROM t_date_time_test WHERE d = '2023-12-31';
d
2023-12-31
SELECT d FROM t_date_time_test WHERE d != '2023-12-31' ORDER BY d;
d
1000-01-01
2023-02-28
2024-02-29
9999-12-31
SELECT d FROM t_date_time_test WHERE d < '2024-01-01' ORDER BY d;
d
1000-01-01
2023-02-28
2023-12-31
SELECT d FROM t_date_time_test WHERE d > '2023-01-01' ORDER BY d;
d
2023-02-28
2023-12-31
2024-02-29
9999-12-31
SELECT d FROM t_date_time_test WHERE d <= '2023-12-31' ORDER BY d;
d
1000-01-01
2023-02-28
2023-12-31
SELECT d FROM t_date_time_test WHERE d >= '2023-12-31' ORDER BY d;
d
2023-12-31
2024-02-29
9999-12-31
# DATE NULL-safe comparison
SELECT d FROM t_date_time_test WHERE d <=> NULL;
d
NULL
SELECT d FROM t_date_time_test WHERE d <=> '2023-12-31';
d
2023-12-31

# Testing DATETIME type operations
TRUNCATE TABLE t_date_time_test;
INSERT INTO t_date_time_test (dt) VALUES 
('1000-01-01 00:00:00'),           # Min datetime
('2023-12-31 23:59:59'),           # Max time of day
('9999-12-31 23:59:59'),           # Max datetime
('2024-02-29 12:30:45'),           # Leap year with time
('2023-07-15 00:00:00'),           # Midnight
('2023-07-15 12:00:00.123456'),    # With microseconds
(NULL);
# Basic DATETIME comparisons
SELECT dt FROM t_date_time_test WHERE dt = '2023-12-31 23:59:59';
dt
2023-12-31 23:59:59
SELECT dt FROM t_date_time_test WHERE dt < '2024-01-01 00:00:00' ORDER BY dt;
dt
1000-01-01 00:00:00
2023-07-15 00:00:00
2023-07-15 12:00:00
2023-12-31 23:59:59
SELECT dt FROM t_date_time_test WHERE dt > '2023-01-01 00:00:00' ORDER BY dt;
dt
2023-07-15 00:00:00
2023-07-15 12:00:00
2023-12-31 23:59:59
2024-02-29 12:30:45
9999-12-31 23:59:59
SELECT dt FROM t_date_time_test WHERE dt BETWEEN '2023-07-15 00:00:00' AND '2023-07-15 23:59:59' ORDER BY dt;
dt
2023-07-15 00:00:00
2023-07-15 12:00:00
# DATETIME with microsecond precision
SELECT dt FROM t_date_time_test WHERE dt = '2023-07-15 12:00:00.123456';
dt
2023-07-15 12:00:00
SELECT dt FROM t_date_time_test WHERE dt > '2023-07-15 12:00:00.000000' ORDER BY dt;
dt
2023-12-31 23:59:59
2024-02-29 12:30:45
9999-12-31 23:59:59

