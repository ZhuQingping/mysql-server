# ===============================================
# TIMEZONE TESTING WITH PRECISION
# ===============================================
CREATE TABLE t_timezone_test (
id INT AUTO_INCREMENT PRIMARY KEY,
description VARCHAR(100),
dt DATETIME(6),
ts TIMESTAMP(6) NULL,
created_at TIMESTAMP(6) NULL DEFAULT CURRENT_TIMESTAMP(6),
KEY idx_ts (ts)
);

# Testing timezone with precision
SET time_zone = '+00:00';
INSERT INTO t_timezone_test (description, dt, ts) VALUES 
('UTC precision test', '2023-07-15 12:00:00.123456', '2023-07-15 12:00:00.123456'),
('UTC precision test 2', '2023-07-15 12:00:00.654321', '2023-07-15 12:00:00.654321');
SELECT description, dt, ts FROM t_timezone_test;
description	dt	ts
UTC precision test	2023-07-15 12:00:00.123456	2023-07-15 12:00:00.123456
UTC precision test 2	2023-07-15 12:00:00.654321	2023-07-15 12:00:00.654321
SET time_zone = '+08:00';
# Same data in +08:00 timezone (precision preserved)
SELECT description, dt, ts FROM t_timezone_test;
description	dt	ts
UTC precision test	2023-07-15 12:00:00.123456	2023-07-15 20:00:00.123456
UTC precision test 2	2023-07-15 12:00:00.654321	2023-07-15 20:00:00.654321
SELECT description FROM t_timezone_test WHERE ts > '2023-07-15 20:00:00.200000' ORDER BY ts;
description
UTC precision test 2
SELECT description FROM t_timezone_test WHERE ts < '2023-07-15 20:00:00.500000' ORDER BY ts;
description
UTC precision test

# Testing precision with timezone conversion
SET time_zone = '+00:00';
# Basic timezone conversion test
SELECT 
description,
ts,
CONVERT_TZ(ts, '+00:00', '+08:00') as tz_beijing,
CONVERT_TZ(ts, '+00:00', '-05:00') as tz_est
FROM t_timezone_test 
ORDER BY ts;
description	ts	tz_beijing	tz_est
UTC precision test	2023-07-15 12:00:00.123456	2023-07-15 20:00:00.123456	2023-07-15 07:00:00.123456
UTC precision test 2	2023-07-15 12:00:00.654321	2023-07-15 20:00:00.654321	2023-07-15 07:00:00.654321
# Timezone conversion with microsecond precision
SELECT 
description,
MICROSECOND(ts) as orig_microsec,
MICROSECOND(CONVERT_TZ(ts, '+00:00', '+08:00')) as conv_microsec
FROM t_timezone_test 
ORDER BY ts;
description	orig_microsec	conv_microsec
UTC precision test	123456	123456
UTC precision test 2	654321	654321
# Full timezone conversion details
SELECT 
description,
ts as original_utc,
CONVERT_TZ(ts, '+00:00', '+08:00') as beijing_time,
CONVERT_TZ(ts, '+00:00', '-05:00') as eastern_time,
CONVERT_TZ(ts, '+00:00', '+09:00') as tokyo_time
FROM t_timezone_test 
ORDER BY ts;
description	original_utc	beijing_time	eastern_time	tokyo_time
UTC precision test	2023-07-15 12:00:00.123456	2023-07-15 20:00:00.123456	2023-07-15 07:00:00.123456	2023-07-15 21:00:00.123456
UTC precision test 2	2023-07-15 12:00:00.654321	2023-07-15 20:00:00.654321	2023-07-15 07:00:00.654321	2023-07-15 21:00:00.654321

# Testing multiple timezone scenarios
