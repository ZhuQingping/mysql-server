'2023-07-15 12:30:45.123456',
'2023-07-15 12:30:45.123456',
'2023-07-15 12:30:45.123456',
'2023-07-15 12:30:45.123456',
'2023-07-15 12:30:45.123456',
'2023-07-15 12:30:45.123456',    # TIMESTAMP with different precisions
'2023-07-15 12:30:45.123456',
'2023-07-15 12:30:45.123456',
'2023-07-15 12:30:45.123456',
'2023-07-15 12:30:45.123456',
'2023-07-15 12:30:45.123456',
'2023-07-15 12:30:45.123456',
'12:30:45.123456',               # TIME with different precisions
'12:30:45.123456',
'12:30:45.123456',
'12:30:45.123456',
'12:30:45.123456',
'12:30:45.123456',
'12:30:45.123456'
);
