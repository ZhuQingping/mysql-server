SELECT description, dt, ts, UNIX_TIMESTAMP(ts) as unix_ts FROM t_timezone_test ORDER BY ts;
description	dt	ts	unix_ts
UTC_data	2023-07-15 12:00:00.123456	2023-07-15 20:00:00.123456	1689422400.123456
Asia_data	2023-07-15 20:00:00.123456	2023-07-15 20:00:00.123456	1689422400.123456
EST_data	2023-07-15 07:00:00.123456	2023-07-15 20:00:00.123456	1689422400.123456
JST_data	2023-07-15 21:00:00.123456	2023-07-15 20:00:00.123456	1689422400.123456

# Testing timezone conversion functions
SET time_zone = '+00:00';
SELECT 
description,
CONVERT_TZ(ts, '+00:00', '+08:00') as beijing_tz,
CONVERT_TZ(ts, '+00:00', '-05:00') as est_tz,
CONVERT_TZ(ts, '+00:00', '+09:00') as jst_tz
FROM t_timezone_test 
ORDER BY ts;
description	beijing_tz	est_tz	jst_tz
UTC_data	2023-07-15 20:00:00.123456	2023-07-15 07:00:00.123456	2023-07-15 21:00:00.123456
Asia_data	2023-07-15 20:00:00.123456	2023-07-15 07:00:00.123456	2023-07-15 21:00:00.123456
EST_data	2023-07-15 20:00:00.123456	2023-07-15 07:00:00.123456	2023-07-15 21:00:00.123456
JST_data	2023-07-15 20:00:00.123456	2023-07-15 07:00:00.123456	2023-07-15 21:00:00.123456
SELECT description FROM t_timezone_test 
WHERE CONVERT_TZ(ts, '+00:00', '+08:00') > '2023-07-15 20:00:00';
description
UTC_data
Asia_data
EST_data
JST_data
SELECT description FROM t_timezone_test 
WHERE CONVERT_TZ(ts, '+00:00', '-05:00') < '2023-07-15 08:00:00';
description
UTC_data
Asia_data
EST_data
JST_data

# Testing DST scenarios
TRUNCATE TABLE t_timezone_test;
SET time_zone = '-05:00';
# Testing DST-like scenarios with timezone offset
INSERT INTO t_timezone_test (description, dt, ts) VALUES 
('Before spring forward', '2024-03-10 01:59:59.999999', '2024-03-10 01:59:59.999999'),
('After spring forward', '2024-03-10 03:00:01.000000', '2024-03-10 03:00:01.000000');
SELECT description, dt, ts FROM t_timezone_test WHERE description LIKE '%spring%';
description	dt	ts
Before spring forward	2024-03-10 01:59:59.999999	2024-03-10 01:59:59.999999
After spring forward	2024-03-10 03:00:01.000000	2024-03-10 03:00:01.000000
SELECT description FROM t_timezone_test 
WHERE ts BETWEEN '2024-03-10 01:00:00' AND '2024-03-10 04:00:00'
ORDER BY ts;
description
Before spring forward
After spring forward

# Testing precision with arithmetic operations
TRUNCATE TABLE t_precision_test;
INSERT INTO t_precision_test (description, dt6, ts6, t6) VALUES 
('Arithmetic test', '2023-07-15 12:30:45.123456', '2023-07-15 12:30:45.123456', '12:30:45.123456');
SELECT 
description,
dt6,
dt6 + INTERVAL 1 MICROSECOND as plus_one_micro,
dt6 - INTERVAL 1 MICROSECOND as minus_one_micro,
dt6 + INTERVAL 500 MICROSECOND as plus_500_micro
FROM t_precision_test 
WHERE description = 'Arithmetic test';
description	dt6	plus_one_micro	minus_one_micro	plus_500_micro
Arithmetic test	2023-07-15 12:30:45.123456	2023-07-15 12:30:45.123457	2023-07-15 12:30:45.123455	2023-07-15 12:30:45.123956
SELECT 
description,
t6,
ADDTIME(t6, '0:0:0.000001') as plus_one_micro,
SUBTIME(t6, '0:0:0.000001') as minus_one_micro
FROM t_precision_test 
WHERE description = 'Arithmetic test';
description	t6	plus_one_micro	minus_one_micro
Arithmetic test	12:30:45.123456	12:30:45.123457	12:30:45.123455

# Testing precision with date/time functions
SELECT 
description,
dt6,
MICROSECOND(dt6) as microsecond_part,
DATE_FORMAT(dt6, '%Y-%m-%d %H:%i:%s.%f') as formatted,
UNIX_TIMESTAMP(dt6) as unix_timestamp
FROM t_precision_test 
WHERE description = 'Arithmetic test';
description	dt6	microsecond_part	formatted	unix_timestamp
Arithmetic test	2023-07-15 12:30:45.123456	123456	2023-07-15 12:30:45.123456	1689442245.123456
SELECT
description,
t6,
MICROSECOND(t6) as microsecond_part,
TIME_FORMAT(t6, '%H:%i:%s.%f') as formatted
FROM t_precision_test
WHERE description = 'Arithmetic test';
description	t6	microsecond_part	formatted
Arithmetic test	12:30:45.123456	123456	12:30:45.123456

# Testing precision with aggregation functions
INSERT INTO t_precision_test (description, dt6, ts6, t6) VALUES
('Agg test 1', '2023-07-15 12:30:45.123456', '2023-07-15 12:30:45.123456', '12:30:45.123456'),
('Agg test 2', '2023-07-15 12:30:45.654321', '2023-07-15 12:30:45.654321', '12:30:45.654321'),
('Agg test 3', '2023-07-15 12:30:45.999999', '2023-07-15 12:30:45.999999', '12:30:45.999999');
SELECT 
MIN(dt6) as min_datetime,
MAX(dt6) as max_datetime,
AVG(UNIX_TIMESTAMP(dt6)) as avg_unix_timestamp
FROM t_precision_test 
WHERE description LIKE 'Agg test%';
min_datetime	max_datetime	avg_unix_timestamp
2023-07-15 12:30:45.123456	2023-07-15 12:30:45.999999	1689442245.5925920000
SELECT 
MIN(t6) as min_time,
MAX(t6) as max_time,
COUNT(*) as count_records
FROM t_precision_test 
WHERE description LIKE 'Agg test%';
min_time	max_time	count_records
12:30:45.123456	12:30:45.999999	3

# Testing precision with GROUP BY
SELECT 
DATE(dt6) as date_part,
COUNT(*) as count_per_date,
MIN(dt6) as earliest_time,
MAX(dt6) as latest_time
FROM t_precision_test 
WHERE dt6 IS NOT NULL
GROUP BY DATE(dt6)
ORDER BY date_part;
date_part	count_per_date	earliest_time	latest_time
2023-07-15	4	2023-07-15 12:30:45.123456	2023-07-15 12:30:45.999999

# Testing precision index operations
SELECT dt6 FROM t_precision_test WHERE dt6 = '2023-07-15 12:30:45.123456';
dt6
2023-07-15 12:30:45.123456
2023-07-15 12:30:45.123456
SELECT dt6 FROM t_precision_test WHERE dt6 > '2023-07-15 12:30:45.123455';
dt6
2023-07-15 12:30:45.123456
2023-07-15 12:30:45.123456
2023-07-15 12:30:45.654321
2023-07-15 12:30:45.999999
SELECT dt6 FROM t_precision_test WHERE dt6 BETWEEN '2023-07-15 12:30:45.123456' AND '2023-07-15 12:30:45.654321';
dt6
2023-07-15 12:30:45.123456
2023-07-15 12:30:45.123456
2023-07-15 12:30:45.654321
SET time_zone = @original_time_zone;

# Testing cross-type comparisons with precision (back to original timezone)
TRUNCATE TABLE t_date_time_test;
INSERT INTO t_date_time_test (d, dt, ts, t) VALUES 
('2023-07-15', '2023-07-15 12:30:45.123456', '2023-07-15 12:30:45.123456', '12:30:45.123456'),
('2023-07-14', '2023-07-14 08:15:30.654321', '2023-07-14 08:15:30.654321', '08:15:30.654321'),
('2023-07-16', '2023-07-16 18:45:00.999999', '2023-07-16 18:45:00.999999', '18:45:00.999999');
# Cross-type precision comparisons
SELECT * FROM t_date_time_test WHERE dt = '2023-07-15 12:30:45.123456';
id	d	dt	ts	t
1	2023-07-15	2023-07-15 12:30:45	2023-07-15 12:30:45	12:30:45
SELECT * FROM t_date_time_test WHERE dt > '2023-07-15 12:30:45.123455';
id	d	dt	ts	t
3	2023-07-16	2023-07-16 18:45:01	2023-07-16 18:45:01	18:45:01
SELECT * FROM t_date_time_test WHERE TIME(dt) = t;
id	d	dt	ts	t
1	2023-07-15	2023-07-15 12:30:45	2023-07-15 12:30:45	12:30:45
2	2023-07-14	2023-07-14 08:15:31	2023-07-14 08:15:31	08:15:31
3	2023-07-16	2023-07-16 18:45:01	2023-07-16 18:45:01	18:45:01
SELECT * FROM t_date_time_test WHERE TIME(dt) > '12:30:45.123455';
id	d	dt	ts	t
3	2023-07-16	2023-07-16 18:45:01	2023-07-16 18:45:01	18:45:01
# DATE vs DATETIME comparison
SELECT * FROM t_date_time_test WHERE d = DATE(dt);
id	d	dt	ts	t
1	2023-07-15	2023-07-15 12:30:45	2023-07-15 12:30:45	12:30:45
2	2023-07-14	2023-07-14 08:15:31	2023-07-14 08:15:31	08:15:31
3	2023-07-16	2023-07-16 18:45:01	2023-07-16 18:45:01	18:45:01
SELECT * FROM t_date_time_test WHERE d < '2023-07-15';
id	d	dt	ts	t
2	2023-07-14	2023-07-14 08:15:31	2023-07-14 08:15:31	08:15:31
# DATETIME vs TIMESTAMP comparison
SELECT * FROM t_date_time_test WHERE dt = ts;
id	d	dt	ts	t
1	2023-07-15	2023-07-15 12:30:45	2023-07-15 12:30:45	12:30:45
2	2023-07-14	2023-07-14 08:15:31	2023-07-14 08:15:31	08:15:31
3	2023-07-16	2023-07-16 18:45:01	2023-07-16 18:45:01	18:45:01
SELECT * FROM t_date_time_test WHERE dt > ts;
id	d	dt	ts	t

# Testing precision with functions and expressions
SELECT * FROM t_date_time_test WHERE dt < NOW(6);
id	d	dt	ts	t
2	2023-07-14	2023-07-14 08:15:31	2023-07-14 08:15:31	08:15:31
1	2023-07-15	2023-07-15 12:30:45	2023-07-15 12:30:45	12:30:45
3	2023-07-16	2023-07-16 18:45:01	2023-07-16 18:45:01	18:45:01
SELECT * FROM t_date_time_test WHERE MICROSECOND(dt) > 123455;
id	d	dt	ts	t
SELECT * FROM t_date_time_test WHERE MICROSECOND(t) < 123457;
id	d	dt	ts	t
1	2023-07-15	2023-07-15 12:30:45	2023-07-15 12:30:45	12:30:45
2	2023-07-14	2023-07-14 08:15:31	2023-07-14 08:15:31	08:15:31
3	2023-07-16	2023-07-16 18:45:01	2023-07-16 18:45:01	18:45:01

# Testing precision edge cases
TRUNCATE TABLE t_precision_test;
INSERT INTO t_precision_test (description, dt6, ts6, t6) VALUES
('Zero microseconds', '2023-07-15 12:30:45.000000', '2023-07-15 12:30:45.000000', '12:30:45.000000'),
('All nines', '2023-07-15 12:30:45.999999', '2023-07-15 12:30:45.999999', '12:30:45.999999'),
('Pattern 123456', '2023-07-15 12:30:45.123456', '2023-07-15 12:30:45.123456', '12:30:45.123456'),
('Pattern 654321', '2023-07-15 12:30:45.654321', '2023-07-15 12:30:45.654321', '12:30:45.654321'),
('Alternating', '2023-07-15 12:30:45.505050', '2023-07-15 12:30:45.505050', '12:30:45.505050');
# Precision pattern comparisons
SELECT description, dt6, ts6, t6 FROM t_precision_test ORDER BY dt6;
description	dt6	ts6	t6
Zero microseconds	2023-07-15 12:30:45.000000	2023-07-15 12:30:45.000000	12:30:45.000000
Pattern 123456	2023-07-15 12:30:45.123456	2023-07-15 12:30:45.123456	12:30:45.123456
Alternating	2023-07-15 12:30:45.505050	2023-07-15 12:30:45.505050	12:30:45.505050
Pattern 654321	2023-07-15 12:30:45.654321	2023-07-15 12:30:45.654321	12:30:45.654321
All nines	2023-07-15 12:30:45.999999	2023-07-15 12:30:45.999999	12:30:45.999999
SELECT description FROM t_precision_test WHERE MICROSECOND(dt6) % 2 = 0;
description
Zero microseconds
Pattern 123456
Alternating
SELECT description FROM t_precision_test WHERE MICROSECOND(t6) > 500000;
description
All nines
Pattern 654321
Alternating

# Testing precision with NULL values
INSERT INTO t_precision_test (description, dt6, ts6, t6) VALUES ('NULL precision test', NULL, NULL, NULL);
SELECT description FROM t_precision_test WHERE dt6 IS NULL;
description
NULL precision test
SELECT description FROM t_precision_test WHERE dt6 IS NOT NULL AND MICROSECOND(dt6) > 0 ORDER BY dt6;
description
Pattern 123456
Alternating
Pattern 654321
All nines

# Testing precision sorting and ordering
SELECT 
description, 
dt6, 
MICROSECOND(dt6) as microsec_part
FROM t_precision_test 
WHERE dt6 IS NOT NULL
ORDER BY MICROSECOND(dt6) ASC;
description	dt6	microsec_part
Zero microseconds	2023-07-15 12:30:45.000000	0
Pattern 123456	2023-07-15 12:30:45.123456	123456
Alternating	2023-07-15 12:30:45.505050	505050
Pattern 654321	2023-07-15 12:30:45.654321	654321
All nines	2023-07-15 12:30:45.999999	999999
SELECT 
description, 
t6, 
MICROSECOND(t6) as microsec_part
FROM t_precision_test 
WHERE t6 IS NOT NULL
ORDER BY MICROSECOND(t6) DESC;
description	t6	microsec_part
All nines	12:30:45.999999	999999
Pattern 654321	12:30:45.654321	654321
Alternating	12:30:45.505050	505050
Pattern 123456	12:30:45.123456	123456
Zero microseconds	12:30:45.000000	0

# Final comprehensive precision and timezone test
SELECT 
'DATETIME precision test' as test_type,
COUNT(*) as total_records,
COUNT(DISTINCT MICROSECOND(dt6)) as distinct_microseconds,
MIN(dt6) as min_datetime,
MAX(dt6) as max_datetime,
AVG(MICROSECOND(dt6)) as avg_microsecond
FROM t_precision_test 
WHERE dt6 IS NOT NULL;
test_type	total_records	distinct_microseconds	min_datetime	max_datetime	avg_microsecond
DATETIME precision test	5	5	2023-07-15 12:30:45.000000	2023-07-15 12:30:45.999999	456565.2000
SELECT 
'TIME precision test' as test_type,
COUNT(*) as total_records,
COUNT(DISTINCT MICROSECOND(t6)) as distinct_microseconds,
MIN(t6) as min_time,
MAX(t6) as max_time,
AVG(MICROSECOND(t6)) as avg_microsecond
FROM t_precision_test 
WHERE t6 IS NOT NULL;
test_type	total_records	distinct_microseconds	min_time	max_time	avg_microsecond
TIME precision test	5	5	12:30:45.000000	12:30:45.999999	456565.2000
