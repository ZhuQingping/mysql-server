########################################################################
# Bug: Server crash when field key_length != key_part length in function index field
########################################################################
# Save original sql_mode
SET sql_mode = 'NO_ENGINE_SUBSTITUTION';
#
# Case 1: Test functional index with mismatched key length
# Expected: Before patch, server crashes at store_create_ddl_info()
#
# Test 1.1: Direct creation
CREATE TABLE t1(pk INT PRIMARY KEY, c1 VARCHAR(255), KEY ci((REVERSE(c1)))) CHARSET=utf8mb4;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `pk` int NOT NULL,
  `c1` varchar(255) DEFAULT NULL,
  PRIMARY KEY (`pk`),
  KEY `ci` ((reverse(`c1`)))
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Test 1.2: Create with small then convert to big
CREATE TABLE t2(pk INT PRIMARY KEY, c1 VARCHAR(255), KEY ci((REVERSE(c1)))) CHARSET=utf8mb3;
ALTER TABLE t2 CONVERT TO CHARACTER SET utf8mb4;
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `pk` int NOT NULL,
  `c1` varchar(255) DEFAULT NULL,
  PRIMARY KEY (`pk`),
  KEY `ci` ((reverse(`c1`)))
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Test 1.3: Create with InnoDB then convert to dstore.
CREATE TABLE t3(pk INT PRIMARY KEY, c1 VARCHAR(255), KEY ci((REVERSE(c1)))) ENGINE=InnoDB CHARSET=utf8mb4;
ALTER TABLE t3 ENGINE=Dstore;
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `pk` int NOT NULL,
  `c1` varchar(255) DEFAULT NULL,
  PRIMARY KEY (`pk`),
  KEY `ci` ((reverse(`c1`)))
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t3 VALUES (1,"Z"),(2,"ZH"),(3,"ZHA"),(4,"ZHAN"),(5,"ZHANG");
EXPLAIN SELECT * FROM t3 WHERE REVERSE(c1) = "AHZ";
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t3	NULL	ref	ci	ci	1023	const	1	100.00	NULL
# Test 1.4: Create index on virtual column.
CREATE TABLE t4 ( id INT PRIMARY KEY AUTO_INCREMENT, first_name VARCHAR(50) NOT NULL, last_name VARCHAR(50) NOT NULL, full_name VARCHAR(101) AS (CONCAT(last_name, ' ', first_name)), INDEX idx_full_name_prefix(full_name(20)));
SHOW CREATE TABLE t4;
Table	Create Table
t4	CREATE TABLE `t4` (
  `id` int NOT NULL AUTO_INCREMENT,
  `first_name` varchar(50) NOT NULL,
  `last_name` varchar(50) NOT NULL,
  `full_name` varchar(101) GENERATED ALWAYS AS (concat(`last_name`,_utf8mb4' ',`first_name`)) VIRTUAL,
  PRIMARY KEY (`id`),
  KEY `idx_full_name_prefix` (`full_name`(20))
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO t4(id, first_name, last_name) VALUES (1,"S","Z"),(2,"SA","ZH"),(3,"SAN","ZHA"),(4,"SANS","ZHAN"),(5,"SANSA","ZHANG");
EXPLAIN SELECT * FROM t4 WHERE full_name = "SAN ZHA";
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t4	NULL	ref	idx_full_name_prefix	idx_full_name_prefix	83	const	1	100.00	Using where
# Cleanup
DROP TABLE t1,t2,t3,t4;
# Restore original sql_mode
########################################################################
# End of Test
########################################################################
