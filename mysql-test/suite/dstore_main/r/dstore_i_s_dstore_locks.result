SET @old_default_engine= @@default_storage_engine;
SET @@default_storage_engine = 'dstore';
DESCRIBE INFORMATION_SCHEMA.DSTORE_LOCKS;
Field	Type	Null	Key	Default	Extra
OS_THREAD_ID	bigint unsigned	NO			
LOCKTAG_TYPE	int unsigned	NO			
LOCK_MODE	int unsigned	NO			
FIELD1	int unsigned	NO			
FIELD2	int unsigned	NO			
FIELD3	int unsigned	NO			
FIELD4	int unsigned	NO			
FIELD5	int unsigned	NO			
STATE	varchar(10)	NO			
GRANTED_COUNT	int unsigned	NO			
DESC	varchar(128)	NO			
DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (
int_col INT,
char_col char(5) not null,
varchar_col varchar(10) not null,
PRIMARY KEY (int_col)
) ENGINE=DSTORE;
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION;
INSERT INTO t1 VALUES (1, "abc", "defgh"), (2, "bcd", "efgh"), (3, "jfda", "xyz");
SELECT * FROM t1;
int_col	char_col	varchar_col
1	abc	defgh
2	bcd	efgh
3	jfda	xyz
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;
LOCKTAG_TYPE	LOCK_MODE	STATE	GRANTED_COUNT
0	3	GRANTED	1
3	7	GRANTED	1
SELECT * FROM t1 FOR UPDATE;
int_col	char_col	varchar_col
1	abc	defgh
2	bcd	efgh
3	jfda	xyz
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;
LOCKTAG_TYPE	LOCK_MODE	STATE	GRANTED_COUNT
0	3	GRANTED	2
3	7	GRANTED	1
SELECT * FROM INFORMATION_SCHEMA.DSTORE_LOCKS WHERE OS_THREAD_ID=0;
OS_THREAD_ID	LOCKTAG_TYPE	LOCK_MODE	FIELD1	FIELD2	FIELD3	FIELD4	FIELD5	STATE	GRANTED_COUNT	DESC
SELECT * FROM INFORMATION_SCHEMA.DSTORE_LOCKS WHERE OS_THREAD_ID=1;
OS_THREAD_ID	LOCKTAG_TYPE	LOCK_MODE	FIELD1	FIELD2	FIELD3	FIELD4	FIELD5	STATE	GRANTED_COUNT	DESC
SELECT OS_THREAD_ID INTO @tid FROM INFORMATION_SCHEMA.DSTORE_LOCKS LIMIT 1;
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS WHERE OS_THREAD_ID=@tid ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;
LOCKTAG_TYPE	LOCK_MODE	STATE	GRANTED_COUNT
0	3	GRANTED	2
3	7	GRANTED	1
COMMIT;
START TRANSACTION;
INSERT INTO t1 VALUES (4, "ters", "etqjd");
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;
LOCKTAG_TYPE	LOCK_MODE	STATE	GRANTED_COUNT
0	3	GRANTED	1
3	7	GRANTED	1
ROLLBACK;
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;
LOCKTAG_TYPE	LOCK_MODE	STATE	GRANTED_COUNT
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
BEGIN;
INSERT INTO t1 VALUES (4, "dbc", "xefgh");
SELECT * FROM t1 WHERE int_col = 2 FOR UPDATE;
int_col	char_col	varchar_col
2	bcd	efgh
BEGIN;
UPDATE t1 SET char_col = "xyz" where int_col = 2;;
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;
LOCKTAG_TYPE	LOCK_MODE	STATE	GRANTED_COUNT
0	3	GRANTED	2
0	3	GRANTED	1
3	3	WAITING	0
3	7	GRANTED	1
3	7	GRANTED	1
COMMIT;
SELECT * FROM t1;
int_col	char_col	varchar_col
1	abc	defgh
2	xyz	efgh
3	jfda	xyz
COMMIT;
SELECT * FROM t1;
int_col	char_col	varchar_col
1	abc	defgh
2	xyz	efgh
3	jfda	xyz
4	dbc	xefgh
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;
LOCKTAG_TYPE	LOCK_MODE	STATE	GRANTED_COUNT
DROP TABLE t1;
SET @@default_storage_engine=@old_default_engine;
