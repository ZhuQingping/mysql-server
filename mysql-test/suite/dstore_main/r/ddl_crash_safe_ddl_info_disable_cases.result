#
#  The following cases should disable DDL info writing during query execution.
#
#  Case1: ANALYZE/OPTIMIZE more than one table.
CREATE TABLE t1(pk INT PRIMARY KEY, col1 INT DEFAULT NULL);
CREATE TABLE t2(pk INT PRIMARY KEY, col1 INT DEFAULT NULL);
INSERT INTO t1 VALUES (1,2),(2,3),(3,4);
INSERT INTO t2 VALUES (1,2),(2,3),(3,4);
ANALYZE TABLE t1,t2;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK
OPTIMIZE TABLE t1,t2;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
test.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t2	optimize	status	OK
DROP TABLE t1,t2;
