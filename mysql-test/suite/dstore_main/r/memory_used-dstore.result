CREATE TABLE t1(a int, b int);
INSERT INTO t1 VALUES(1,2),(2,3),(2,3),(2,3),(2,4),(3,1);
CREATE TABLE t2(a int, b int);
INSERT INTO t2 VALUES(1,3),(2,4),(3,4);
INSERT INTO t2 SELECT * FROM t2;
INSERT INTO t2 SELECT * FROM t1;
SET optimizer_switch='semijoin=off,partial_result_cache=on',rds_partial_result_cache_cost_threshold = 0;
EXPLAIN ANALYZE format=tree SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b GROUP BY b) ORDER BY a;
EXPLAIN
-> Sort: t1.a  (cost=1.85 rows=6) (actual time=# loops=1)
    -> Filter: <in_optimizer>(t1.a,<exists>(select #2))  (cost=1.85 rows=6) (actual time=# loops=1)
        -> Table scan on t1  (cost=1.85 rows=6) (actual time=# loops=1)
        -> Select #2 (subquery in condition; dependent)
            -> Result cache : cache keys(t1.a, t1.b) (Cache Hits: 2, Cache Misses: 4, Cache Evictions: 0, Cache Overflows: 0, Memory Usage: 40960 )  (actual time=# loops=6)
                -> Limit: 1 row(s)  (cost=1.35 rows=1) (actual time=# loops=6)
                    -> Filter: ((t2.b > t1.b) and (<cache>(t1.a) = t2.b))  (cost=1.35 rows=1) (actual time=# loops=6)
                        -> Table scan on t2  (cost=1.35 rows=12) (actual time=# loops=6)

Warnings:
Note	1276	Field or reference 'test.t1.b' of SELECT #2 was resolved in SELECT #1
DROP TABLE t1, t2;
