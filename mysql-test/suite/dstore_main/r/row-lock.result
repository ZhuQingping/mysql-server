# Switching to connection 'thr1'.
set autocommit=0;
begin;
select * from test where id = 15;
id	varchar_col	char_col
15	xy	uvw
update test set varchar_col = "efg" where id = 15;
select * from test where id = 15;
id	varchar_col	char_col
15	efg	uvw
# Switching to connection 'thr2'.
set autocommit=0;
begin;
select * from test where id = 15;
id	varchar_col	char_col
15	xy	uvw
# thr2 hang here
update test set varchar_col = "efg" where id = 15;
# Switching to connection 'thr1'.
commit;
# Switching to connection 'thr2'.
select * from test where id = 15;
id	varchar_col	char_col
15	xy	uvw
commit;
# test lock conflict between delete and update.
# Switching to connection 'thr1'.
begin;
select * from test where id = 25;
id	varchar_col	char_col
25	xy	uvw
delete from test where id = 25;
select * from test where id = 25;
id	varchar_col	char_col
# Switching to connection 'thr2'.
begin;
select * from test where id = 25;
id	varchar_col	char_col
25	xy	uvw
# thr2 hang here
update test set varchar_col = "efghigk" where id = 25;
# Switching to connection 'thr1'.
commit;
# Switching to connection 'thr2'.
select * from test where id = 25;
id	varchar_col	char_col
25	xy	uvw
commit;
# test deadlock
# Switching to default.
create table testp (
id int not null primary key, 
varchar_col varchar(10) not null,
char_col char(5) not null
) ENGINE=Dstore character set utf8mb4 collate utf8mb4_0900_ai_ci;
insert into testp values(1,'aaa','bbb');
insert into testp values(2,'aaa','bbb');
select * from testp;
id	varchar_col	char_col
1	aaa	bbb
2	aaa	bbb
# Switching to connection 'thr1'.
begin;
update testp set varchar_col = "xxx" where id = 1;
# Switching to connection 'thr2'.
begin;
update testp set varchar_col = "ppp" where id = 2;
# Switching to connection 'thr1'.
update testp set varchar_col = "yyy" where id = 2;;
# Switching to connection 'thr2'
update testp set varchar_col = "qqq" where id = 1;
commit;
select * from testp;
id	varchar_col	char_col
1	qqq	bbb
2	ppp	bbb
# Switching to connection 'thr1'
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
select * from testp;
id	varchar_col	char_col
1	qqq	bbb
2	ppp	bbb
# Switching to default.
drop table test;
drop table testp;
