CREATE TABLE orders (
id INT PRIMARY KEY AUTO_INCREMENT,
user_id INT NOT NULL,
amount DECIMAL(10,2),
status VARCHAR(20),
INDEX idx_user_id (user_id)
) ENGINE=Dstore;
INSERT INTO orders (user_id, amount, status)
WITH RECURSIVE seq AS (
SELECT 1 AS n UNION ALL SELECT n+1 FROM seq WHERE n < 100
)
SELECT 
150 + ((n-1) % 101),
10.00 + ((n % 101) * 0.5),
CASE WHEN 150 + ((n-1) % 101) < 200 THEN 'pending' ELSE 'completed' END
FROM seq;
ANALYZE TABLE orders UPDATE HISTOGRAM ON id,user_id;
Table	Op	Msg_type	Msg_text
test.orders	histogram	status	Histogram statistics created for column 'id'.
test.orders	histogram	status	Histogram statistics created for column 'user_id'.
ANALYZE TABLE orders;
Table	Op	Msg_type	Msg_text
test.orders	analyze	status	OK
BEGIN;
EXPLAIN SELECT * FROM orders WHERE user_id BETWEEN 180 AND 220 AND status = 'pending' FOR UPDATE;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	orders	NULL	range	idx_user_id	idx_user_id	4	NULL	41	10.00	Using where; Using MRR
Warnings:
Note	1003	/* select#1 */ select `test`.`orders`.`id` AS `id`,`test`.`orders`.`user_id` AS `user_id`,`test`.`orders`.`amount` AS `amount`,`test`.`orders`.`status` AS `status` from `test`.`orders` where ((`test`.`orders`.`status` = 'pending') and (`test`.`orders`.`user_id` between 180 and 220))
SELECT * FROM orders WHERE user_id BETWEEN 180 AND 220 AND status = 'pending' limit 5 FOR UPDATE;
id	user_id	amount	status
31	180	25.50	pending
32	181	26.00	pending
33	182	26.50	pending
34	183	27.00	pending
35	184	27.50	pending
UPDATE orders SET amount = amount * 1.1 WHERE user_id BETWEEN 180 AND 220;
SELECT * FROM orders WHERE user_id BETWEEN 180 AND 220 AND status = 'pending' limit 5;
