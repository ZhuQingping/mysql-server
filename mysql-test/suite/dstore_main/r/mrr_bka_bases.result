31	180	28.05	pending
32	181	28.60	pending
33	182	29.15	pending
34	183	29.70	pending
35	184	30.25	pending
COMMIT;
DROP TABLE orders;
CREATE TABLE t_shared_lock (
id INT PRIMARY KEY AUTO_INCREMENT,
user_id INT NOT NULL,
amount DECIMAL(10,2),
status VARCHAR(20),
INDEX idx_user_id (user_id))
ENGINE=Dstore;
INSERT INTO t_shared_lock (user_id, amount, status) VALUES
(150, 10.00, 'pending'),
(160, 15.00, 'completed'),
(170, 20.00, 'pending'),
(180, 25.00, 'completed');
BEGIN;
SELECT * FROM t_shared_lock WHERE user_id BETWEEN 150 AND 180 AND status = 'pending';
id	user_id	amount	status
1	150	10.00	pending
3	170	20.00	pending
COMMIT;
CALL mtr.add_suppression(".*CDELockTuple failed.*");
SET SESSION DEBUG='+d,cde_lock_tuple_injection';
SELECT * FROM t_shared_lock WHERE user_id BETWEEN 150 AND 180 AND status = 'pending';
id	user_id	amount	status
1	150	10.00	pending
3	170	20.00	pending
SET SESSION DEBUG='-d,cde_lock_tuple_injection';
CALL mtr.add_suppression(".*FetchTuple fail.*");
SET SESSION DEBUG='+d,cde_fetch_tuple_injection';
SELECT * FROM t_shared_lock WHERE user_id BETWEEN 150 AND 180 AND status = 'pending';
ERROR HY000: Got error 168 - 'Unknown (generic) error from engine' from storage engine
SET SESSION DEBUG='-d,cde_fetch_tuple_injection';
DROP TABLE t_shared_lock;
set optimizer_switch=default;
