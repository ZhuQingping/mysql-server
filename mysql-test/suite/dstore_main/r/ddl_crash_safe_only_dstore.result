#
#  This test check server can print an message when storage_engine_mode is BOTH_STORAGE_ENGINE
#  while DDL info requires recovery.
#
#  1.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
CREATE TABLE t1(pk INT PRIMARY KEY, col1 INT);
ERROR HY000: Lost connection to MySQL server during query
Pattern "DDL info found in DStore WAL requires recovery" found
# restart
DROP TABLE t1;
