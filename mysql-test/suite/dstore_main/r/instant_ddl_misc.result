##############################################
# Test instant ADD/DROP COLUMN for REDUNDANT format
##############################################
SET SESSION debug= '+d,show_dropped_column';
# Scenario 1
create table t1 (c1 char(10), c2 char(10));
# DD Metadata of columns in table
NAME	ORDINAL_POSITION	TYPE	HAS_NO_DEFAULT	HIDDEN	SE_PRIVATE_DATA
c1	1	MYSQL_TYPE_STRING	0	Visible	NULL
c2	2	MYSQL_TYPE_STRING	0	Visible	NULL
insert into t1 values ("r1c1", "r1c2");
select * from t1;
c1	c2
r1c1	r1c2
alter table t1 add column c3 char(10) default "def_c3" after c1;
# DD Metadata of columns in table
NAME	ORDINAL_POSITION	TYPE	HAS_NO_DEFAULT	HIDDEN	SE_PRIVATE_DATA
c1	1	MYSQL_TYPE_STRING	0	Visible	physical_pos=0;
c3	2	MYSQL_TYPE_STRING	0	Visible	default=0a6465665f633320202020;physical_pos=2;version_added=1;
c2	3	MYSQL_TYPE_STRING	0	Visible	physical_pos=1;
insert into t1 values ("r2c1", "r2c3", "r2c2");
select * from t1;
c1	c3	c2
r1c1	def_c3	r1c2
r2c1	r2c3	r2c2
drop table t1;
# Scenario 2
create table t1 (c1 char(10), c2 char(10), c3 char(10));
insert into t1 values ("r1c1", "r1c2", "r1c3");
alter table t1 drop column c2;
# DD Metadata of columns in table
NAME	ORDINAL_POSITION	TYPE	HAS_NO_DEFAULT	HIDDEN	SE_PRIVATE_DATA
c1	1	MYSQL_TYPE_STRING	0	Visible	physical_pos=0;
c3	2	MYSQL_TYPE_STRING	0	Visible	physical_pos=2;
!hidden!_dropped_v1_p1_c2	3	MYSQL_TYPE_STRING	0	SE	default_null=1;physical_pos=1;version_dropped=1;
select * from t1;
c1	c3
r1c1	r1c3
drop table t1;
# Scenario 3
create table t1 (c1 char(10), c2 char(10));
insert into t1 values ("r1c1", "r1c2");
select * from t1;
c1	c2
r1c1	r1c2
alter table t1 add column c3 char(10) default "def_c3" after c1, algorithm=INSTANT;
insert into t1 values ("r2c1", "r2c3", "r2c2");
select * from t1;
c1	c3	c2
r1c1	def_c3	r1c2
r2c1	r2c3	r2c2
alter table t1 drop column c2, algorithm=INSTANT;
select * from t1;
c1	c3
r1c1	def_c3
r2c1	r2c3
drop table t1;
# Scenario 4
create table t1 (c1 char(10), c2 char(10), c3 char(10));
insert into t1 values ("r1c1", "r1c2", "r1c3");
select * from t1;
c1	c2	c3
r1c1	r1c2	r1c3
alter table t1 drop column c2;
select * from t1;
c1	c3
r1c1	r1c3
drop table t1;
# Scenario 5
create table t1 (c1 char(10), c2 char(10));
insert into t1 values ("r1c1", "r1c2");
alter table t1 add column c3 char(10) default "def_c3" after c1;
select * from t1;
c1	c3	c2
r1c1	def_c3	r1c2
insert into t1 value ("r2c1", "r2c3", "r2c2");
alter table t1 drop column c2;
select * from t1;
c1	c3
r1c1	def_c3
r2c1	r2c3
drop table t1;
# Scenario 6
create table t1 (c1 char(10), c2 char(10));
insert into t1 values ("r1c1", "r1c2");
alter table t1 add column c2 char(10) default "def_c3", drop column c2;
select * from t1;
c1	c2
r1c1	def_c3
insert into t1 value ("r2c1", "r2c2");
select * from t1;
c1	c2
r1c1	def_c3
r2c1	r2c2
drop table t1;
# Scenario 7
create table t1 (c1 char(10), c2 char(10));
insert into t1 values ("r1c1", "r1c2");
alter table t1 add column c3 int after c1;
select * from t1;
c1	c3	c2
r1c1	NULL	r1c2
insert into t1 value ("r2c1", 3, "r2c2");
select * from t1;
c1	c3	c2
r1c1	NULL	r1c2
r2c1	3	r2c2
alter table t1 drop column c2;
select * from t1;
c1	c3
r1c1	NULL
r2c1	3
drop table t1;
# Scenario 8
create table t1 (c1 char(10), c2 char(10), c3 char(10));
insert into t1 values ("r1c1", NULL, "r1c3");
select * from t1;
c1	c2	c3
r1c1	NULL	r1c3
alter table t1 drop column c2;
# DD Metadata of columns in table
NAME	ORDINAL_POSITION	TYPE	HAS_NO_DEFAULT	HIDDEN	SE_PRIVATE_DATA
c1	1	MYSQL_TYPE_STRING	0	Visible	physical_pos=0;
c3	2	MYSQL_TYPE_STRING	0	Visible	physical_pos=2;
!hidden!_dropped_v1_p1_c2	3	MYSQL_TYPE_STRING	0	SE	default_null=1;physical_pos=1;version_dropped=1;
select * from t1;
c1	c3
r1c1	r1c3
drop table t1;
# Scenario 9
CREATE TABLE t1 (C1 char(10), C2 char(10), C3 char(10)) ROW_FORMAT=REDUNDANT;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
INSERT INTO t1 values ("r1c1", "r1c2", "r1c3");
alter table t1 drop column c1;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
select * from t1;
C2	C3
r1c2	r1c3
alter table t1 drop column c3;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
select * from t1;
C2
r1c2
drop table t1;
# Scenario 10
create table t1 (c1 char(10) KEY, c2 char(10), key sec_idx(c2));
insert into t1 values ("r1c1", "r1c2");
select * from t1;
c1	c2
r1c1	r1c2
alter table t1 add column c3 char(10) default "def_c3";
select * from t1;
c1	c2	c3
r1c1	r1c2	def_c3
insert into t1 values ("r2c1", "r2c2", "r3c3");
drop table t1;
# Scenario 13
CREATE TABLE t1(a INT) ROW_FORMAT=REDUNDANT;
Warnings:
