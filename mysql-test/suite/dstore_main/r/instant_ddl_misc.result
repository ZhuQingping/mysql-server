ALTER TABLE t1 add COLUMN (h INT generated always as (a+1) virtual), add INDEX idx (h), algorithm=inplace;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
DROP TABLE t1;
