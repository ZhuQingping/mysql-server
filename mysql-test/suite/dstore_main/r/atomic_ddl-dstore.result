`id` int,
`content` VARCHAR(512)
)ENGINE=DSTORE CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
# connection conn2
SET DEBUG_SYNC= 'sql_parse_before_rewrite WAIT_FOR replay_log_done';
# connection conn1
SET DEBUG_SYNC= 'cde_replay_drop_segment_hang_before_commit SIGNAL replay_log_done WAIT_FOR kill_mysqld';
DROP TABLE `atomic_ddl_employees`;
# connection conn2
INSERT INTO `atomic_ddl_tmp1` VALUES(1, "aaa");
# Kill and restart
