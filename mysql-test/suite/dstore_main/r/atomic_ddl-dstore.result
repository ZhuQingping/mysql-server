########################################################################################################
# Test1.1 Verify can't access ddl log table table on default.                                          #
########################################################################################################
USE mysql;
SHOW TABLES LIKE "%dstore_ddl_log%";
Tables_in_mysql (%dstore_ddl_log%)
SELECT * FROM dstore_ddl_log;
ERROR HY000: Access to table 'mysql.dstore_ddl_log' is rejected.
INSERT INTO dstore_ddl_log VALUES(1,1,1,1,1,1,"a","b");
ERROR HY000: Access to table 'mysql.dstore_ddl_log' is rejected.
UPDATE dstore_ddl_log set id=1 WHERE id=2;
ERROR HY000: Access to table 'mysql.dstore_ddl_log' is rejected.
ALTER TABLE dstore_ddl_log ADD COLUMN new_col VARCHAR(50);
ERROR HY000: Access to table 'mysql.dstore_ddl_log' is rejected.
DROP TABLE dstore_ddl_log;
ERROR HY000: Access to table 'mysql.dstore_ddl_log' is rejected.
CREATE TABLE dstore_ddl_log (id INT AUTO_INCREMENT PRIMARY KEY);
ERROR HY000: Access to table 'mysql.dstore_ddl_log' is rejected.
SELECT count(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA='mysql' and TABLE_NAME='dstore_ddl_log';
count(*)
0
########################################################################################################
# Test1.2 The permission only works with who has ACL_SUPER grant.                                      #
########################################################################################################
CREATE USER 'no_super'@'%' IDENTIFIED BY '123456';
GRANT ALL PRIVILEGES ON *.* TO 'no_super'@'%' WITH GRANT OPTION;
REVOKE SUPER ON *.* FROM 'no_super'@'%';
Warnings:
Warning	1287	The SUPER privilege identifier is deprecated
SET GLOBAL rds_show_hidden_table=true;
ERROR 42000: Access denied; you need (at least one of) the SUPER privilege(s) for this operation
DROP USER 'no_super'@'%';
########################################################################################################
# Test1.3 Testing any operations on ddl log table to simulate the rescure mode after get permission.   #
########################################################################################################
# restart: --rds_dstore_enable_atomic_ddl=false --dstore_use_histogram_auto_update=false
SET GLOBAL rds_show_hidden_table=true;
SELECT * FROM dstore_ddl_log;
id	thread_id	type	file_id	block_id	segment_type	tablespace_id	table_name	table_name_new
INSERT INTO dstore_ddl_log VALUES(1,1,1,1,1,1,1,"a","b");
UPDATE dstore_ddl_log set id=2 WHERE id=1;
ALTER TABLE mysql.dstore_ddl_log ADD COLUMN new_col VARCHAR(50);
DROP TABLE dstore_ddl_log;
CREATE TABLE IF NOT EXISTS dstore_ddl_log(
id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
thread_id BIGINT UNSIGNED NOT NULL,
type INT UNSIGNED NOT NULL,
file_id INT UNSIGNED NOT NULL,
block_id INT UNSIGNED NOT NULL,
segment_type INT UNSIGNED NOT NULL,
tablespace_id INT UNSIGNED NOT NULL,
table_name VARCHAR(512),
table_name_new VARCHAR(512),
PRIMARY KEY idx_pk(id),
KEY idx_1(thread_id)
)engine=DSTORE STATS_PERSISTENT=0 CHARACTER SET latin1 COLLATE latin1_bin;
SET GLOBAL rds_show_hidden_table=false;
SELECT * FROM dstore_ddl_log;
ERROR HY000: Access to table 'mysql.dstore_ddl_log' is rejected.
USE test;
# restart
call mtr.add_suppression("\\[DSTORE\\] Replay DDL log failed");
DROP TABLE IF EXISTS atomic_ddl_department;
DROP TABLE IF EXISTS atomic_ddl_employees;
CREATE TABLE `atomic_ddl_department` (
`dept_id` INT PRIMARY KEY NOT NULL,
`dept_name` VARCHAR(512)
)ENGINE=DSTORE CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
INSERT INTO `atomic_ddl_department` VALUES(1, "DBS Product Department"),(2, "2012 Gauss Department");
########################################################################################################
# Test2.1 Create table rollback triggered by error.                                                    #
########################################################################################################
SET GLOBAL DEBUG='+d,cde_create_table_error_before_commit';
CREATE TABLE `atomic_ddl_employees` (
`emp_id` INT,
`emp_name` VARCHAR(512),
`dept_id` INT,
CONSTRAINT fk_dept 
FOREIGN KEY (dept_id) REFERENCES `atomic_ddl_department`(dept_id)
ON DELETE SET NULL
ON UPDATE CASCADE
)ENGINE=DSTORE CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
ERROR HY000: Got error 168 - 'Unknown (generic) error from engine' from storage engine
SET GLOBAL DEBUG='-d,cde_create_table_error_before_commit';
# Expect found 2 times
Pattern "Replay DDL log success.*Type:DROP_SEGMENT_LOG" found 2 times
# Expect found 1 time
Pattern "Replay DDL log success.*Type:REMOVE_CACHE_LOG" found 1 times
SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='atomic_ddl_employees';
COUNT(*)
0
