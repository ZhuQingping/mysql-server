########################################################################################################
# Test10 DDL rollback by write ddl log table error.                                                     #
########################################################################################################
USE test;
CREATE TABLE `atomic_ddl_tmp2` (
id INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
col1 INT NOT NULL,
INDEX idx_col1 (col1)
);
INSERT INTO atomic_ddl_tmp2 VALUES (1,1);
INSERT INTO atomic_ddl_tmp2 VALUES (2,1);
call mtr.add_suppression("Inject failure of insert DDL log table");
call mtr.add_suppression("Log DDL failed, record");
call mtr.add_suppression("Log drop segment fail");
call mtr.add_suppression("Drop the newly allocated segment");
call mtr.add_suppression("Alloc heap segment failed");
call mtr.add_suppression("cde_create_table_info.create_table fail");
call mtr.add_suppression("Drop index: idx_col1 fail due to LogDropSegment fail.");
