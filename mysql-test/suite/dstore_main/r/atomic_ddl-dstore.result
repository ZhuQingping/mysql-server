########################################################################################################
# Test7 Session in Post ddl is killed.                                                                 #
########################################################################################################
show variables like '%threadpool_enabled%';
Variable_name	Value
threadpool_enabled	OFF
# connection conn1
SET DEBUG_SYNC='hanging_at_log_dummy WAIT_FOR kill_session';
CREATE DATABASE atomic_ddl_tmp_db;
# connection conn2
KILL QUERY 12;
SET DEBUG_SYNC= 'now SIGNAL kill_session';
# connection conn1
SET DEBUG_SYNC="reset";
DROP DATABASE atomic_ddl_tmp_db;
