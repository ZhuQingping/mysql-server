# Test REPEATABLE READ
#
CREATE TABLE t1(
seat_id    INT,
state      INT,
PRIMARY KEY(seat_id)
) ENGINE=Dstore;
INSERT INTO t1 VALUES
(1,0),
(3,0),
(4,0),
(6,0);
