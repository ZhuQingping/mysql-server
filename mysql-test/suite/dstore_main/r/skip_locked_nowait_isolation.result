3	0
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
BEGIN;
INSERT INTO t1 VALUES(2,0);
SELECT seat_id, state FROM t1 WHERE state = 0
FOR UPDATE NOWAIT;
SELECT seat_id, state FROM t1 WHERE state = 0
FOR UPDATE SKIP LOCKED;
seat_id	state
4	0
6	0
