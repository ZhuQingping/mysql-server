BEGIN;
SELECT seat_id, state FROM t1
WHERE state = 0 AND seat_id >= 1 LIMIT 2 FOR SHARE;
seat_id	state
1	0
3	0
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
BEGIN;
INSERT INTO t1 VALUES(2,0);
SELECT seat_id, state FROM t1 WHERE state = 0
FOR UPDATE NOWAIT;
SELECT seat_id, state FROM t1 WHERE state = 0
FOR UPDATE SKIP LOCKED;
seat_id	state
4	0
6	0
2	0
COMMIT;
COMMIT;
DROP TABLE t1;
#
# Test SERIALIZABLE
#
CREATE TABLE t1(
seat_id    INT,
state      INT,
PRIMARY KEY(seat_id)
) ENGINE=Dstore;
INSERT INTO t1 VALUES
(1,0),
(3,0),
(4,0),
(6,0);
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
BEGIN;
SELECT seat_id, state FROM t1
WHERE state = 0 AND seat_id >= 1 LIMIT 2 ;
seat_id	state
1	0
3	0
SET SESSION TRANSACTION ISOLATION LEVEL SERIALIZABLE;
BEGIN;
INSERT INTO t1 VALUES(2,0);
SELECT seat_id, state FROM t1 WHERE state = 0
FOR UPDATE NOWAIT;
seat_id	state
1	0
3	0
4	0
6	0
2	0
SELECT seat_id, state FROM t1 WHERE state = 0
FOR UPDATE SKIP LOCKED;
seat_id	state
1	0
3	0
4	0
6	0
2	0
COMMIT;
COMMIT;
DROP TABLE t1;
SET global dstore_lock_wait_timeout=default;
