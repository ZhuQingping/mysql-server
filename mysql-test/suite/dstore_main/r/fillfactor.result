#case1: test variable dstore_default_fillfactor.
set dstore_default_fillfactor=90;
ERROR HY000: Variable 'dstore_default_fillfactor' is a GLOBAL variable and should be set with SET GLOBAL
set global dstore_default_fillfactor=80;
set global dstore_default_fillfactor=60.1;
ERROR 42000: Incorrect argument type to variable 'dstore_default_fillfactor'
set global dstore_default_fillfactor=80.0;
ERROR 42000: Incorrect argument type to variable 'dstore_default_fillfactor'
set global dstore_default_fillfactor=default;
set global dstore_default_fillfactor=10;
select @@dstore_default_fillfactor;
@@dstore_default_fillfactor
10
set global dstore_default_fillfactor=100;
select @@dstore_default_fillfactor;
@@dstore_default_fillfactor
100
set global dstore_default_fillfactor=9;
Warnings:
Warning	1292	Truncated incorrect dstore_default_fillfactor value: '9'
select @@dstore_default_fillfactor;
@@dstore_default_fillfactor
10
set global dstore_default_fillfactor=101;
Warnings:
Warning	1292	Truncated incorrect dstore_default_fillfactor value: '101'
select @@dstore_default_fillfactor;
@@dstore_default_fillfactor
100
set global dstore_default_fillfactor=default;
select @@dstore_default_fillfactor;
@@dstore_default_fillfactor
80
#case2: fillfactor is not a key word.
create table fillfactor(fillfactor int) engine=Dstore, charset=utf8mb4;
alter table fillfactor add index fillfactor(fillfactor);
show create table fillfactor;
Table	Create Table
fillfactor	CREATE TABLE `fillfactor` (
  `fillfactor` int DEFAULT NULL,
  KEY `fillfactor` (`fillfactor`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
insert into fillfactor values(1),(2);
select fillfactor from fillfactor;
fillfactor
1
2
drop table fillfactor;
create function fillfactor() returns int return 1;
select fillfactor();
fillfactor()
1
drop function fillfactor;
create table t1(a int);
insert into t1 values(1),(2);
create view fillfactor as select a fillfactor from t1;
select fillfactor from fillfactor;
fillfactor
1
2
drop view fillfactor;
drop table t1;
#case3: Fillfactor only support dstore engine.
set @save_default_storage_engine = @@default_storage_engine;
create table t1(a int)engine=Dstore, comment 'fillfactor=200';
