#case5: Check fillfactor format in comment.
create table t1(a int)engine=Dstore, comment 'fillfactor=75';
create table t2(a int)engine=Dstore, comment 'user table, FillFactor=75';
create table t3(a int)engine=Dstore, comment 'FILLFACTOR=75 user table';
create table t4(a int)engine=Dstore, comment 'user table FILLfactor=75 test fillfactor';
create table t5(a int)engine=Dstore, comment 'user table fillFACTOR 	=75 test fillfactor';
create table t6(a int)engine=Dstore, comment 'user table fillfacTOR= 	75 test fillfactor';
create table t7(a int)engine=Dstore, comment 'user table FillFactor	= 	75 test fillfactor';
create table t8(a int)engine=Dstore, comment 'user tableFillFactor=75dstore';
create table t9(a int)engine=Dstore, comment 'user table fillfactor=test fillfactor';
