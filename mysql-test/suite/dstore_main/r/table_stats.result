# ###################################################################
# Test TABLE STATUS information for Dstore table
# ###################################################################
CREATE TABLE t1 (
a int not NULL,
b VARCHAR(1024) not NULL,
c blob,
PRIMARY KEY (a)
) ENGINE=Dstore, STATS_SAMPLE_PAGES=500;
CREATE PROCEDURE insert_table(IN n int)
BEGIN
DECLARE i INT DEFAULT 1;
START TRANSACTION;
WHILE (i <= n ) DO
INSERT INTO t1 (a, b, c) VALUES (i,REPEAT('Dstore',150),REPEAT('A',3000));
SET i=i+1;
END WHILE;
COMMIT;
END ||
# 1 Test Empty table, do not gererate record in mysql.dstore_table_stats
SELECT COUNT(*) FROM t1;
COUNT(*)
0
SHOW TABLE STATUS LIKE 't1';
Name	Engine	Version	Row_format	Rows	Avg_row_length	Data_length	Max_data_length	Index_length	Data_free	Auto_increment	Create_time	Update_time	Check_time	Collation	Checksum	Create_options	Comment
t1	Dstore	10	Redundant	0	0	8192	0	#	0	NULL	#	NULL	NULL	utf8mb4_0900_ai_ci	NULL	stats_sample_pages=500	
SELECT TABLE_NAME,TABLE_TYPE,ENGINE,TABLE_ROWS,AVG_ROW_LENGTH,DATA_LENGTH,MAX_DATA_LENGTH,DATA_FREE FROM information_schema.tables WHERE table_name='t1';
TABLE_NAME	TABLE_TYPE	ENGINE	TABLE_ROWS	AVG_ROW_LENGTH	DATA_LENGTH	MAX_DATA_LENGTH	DATA_FREE
t1	BASE TABLE	Dstore	0	0	8192	0	0
SELECT table_name,table_rows,avg_row_length,data_length,max_data_length,data_free FROM mysql.table_stats WHERE table_name='t1';
table_name	table_rows	avg_row_length	data_length	max_data_length	data_free
t1	0	0	8192	0	0
SELECT table_name,n_rows,heap_table_pages,heap_table_free_pages,heap_table_lob_pages FROM mysql.dstore_table_stats WHERE table_name='t1';
table_name	n_rows	heap_table_pages	heap_table_free_pages	heap_table_lob_pages
t1	0	1	0	0
# 2 Test insert 2 records in heap table
CALL insert_table(2);
ANALYZE TABLE t1;
