# 7 Test heap table size larger than stats_sample_pages
DROP TABLE t1;
CREATE TABLE t1 (
a int not NULL,
b VARCHAR(1024) not NULL,
c blob,
PRIMARY KEY (a)
) ENGINE=Dstore, STATS_SAMPLE_PAGES=100;
CALL insert_table(1000);
DELETE FROM t1 LIMIT 990;
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
SELECT COUNT(*) FROM t1;
COUNT(*)
10
SELECT TABLE_NAME,TABLE_TYPE,ENGINE,DATA_LENGTH,DATA_FREE>(DATA_LENGTH-DATA_FREE) FROM information_schema.tables WHERE table_name='t1';
TABLE_NAME	TABLE_TYPE	ENGINE	DATA_LENGTH	DATA_FREE>(DATA_LENGTH-DATA_FREE)
t1	BASE TABLE	Dstore	2039808	1
SELECT table_name,heap_table_pages,heap_table_free_pages>(heap_table_pages-heap_table_free_pages) FROM mysql.dstore_table_stats WHERE table_name='t1';
table_name	heap_table_pages	heap_table_free_pages>(heap_table_pages-heap_table_free_pages)
t1	237	1
DROP TABLE t1;
DROP PROCEDURE insert_table;
#
# BUG2026031741987: [Partition Table] When an SQLancer service that contains partition table operations is executed,
#                   the instance is abnormal. The error keyword is "CdeDdOpenTableOne&:HaCdepartShare::openOneTablePart".
# increase test coverage
CREATE PROCEDURE insert_table(IN n int)
BEGIN
DECLARE i INT DEFAULT 1;
START TRANSACTION;
WHILE (i <= n ) DO
INSERT INTO t1 (a, b, c) VALUES (i,REPEAT('Dstore',150),REPEAT('A',3000));
SET i=i+1;
END WHILE;
COMMIT;
END ||
CREATE TABLE t1 (
a int not NULL,
b VARCHAR(1024) not NULL,
c blob,
PRIMARY KEY (a)
) ENGINE=Dstore, STATS_SAMPLE_PAGES=100;
CALL insert_table(1000);
SET SESSION DEBUG='+d,info_impl_null_dict_table';
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	Unable to write table statistics to DD tables
SET SESSION DEBUG='-d,info_impl_null_dict_table';
DROP TABLE t1;
DROP PROCEDURE insert_table;
