# 0. Prepare test data
DROP DATABASE IF EXISTS test_data_types;
CREATE DATABASE test_data_types;
USE test_data_types;
CREATE TABLE all_data_types (
id INT AUTO_INCREMENT PRIMARY KEY COMMENT 'Auto increment primary key',
-- Signed Numeric Types
c01 TINYINT COMMENT 'Small integer (-128 to 127)',
c02 SMALLINT COMMENT 'Short integer (-32768 to 32767)',
c03 MEDIUMINT COMMENT 'Medium integer (-8388608 to 8388607)',
c04 INT COMMENT 'Standard integer (-2147483648 to 2147483647)',
c05 BIGINT COMMENT 'Big integer (-9223372036854775808 to 9223372036854775807)',
-- Unsigned Numeric Types
c01u TINYINT UNSIGNED COMMENT 'Unsigned small integer (0 to 255)',
c02u SMALLINT UNSIGNED COMMENT 'Unsigned short integer (0 to 65535)',
c03u MEDIUMINT UNSIGNED COMMENT 'Unsigned medium integer (0 to 16777215)',
c04u INT UNSIGNED COMMENT 'Unsigned standard integer (0 to 4294967295)',
c05u BIGINT UNSIGNED COMMENT 'Unsigned big integer (0 to 18446744073709551615)',
-- Decimal Types
c06 DECIMAL(10,2) COMMENT 'Fixed-point number (signed)',
c06u DECIMAL(10,2) UNSIGNED COMMENT 'Fixed-point number (unsigned)',
-- Other Numeric Types
c07 FLOAT COMMENT 'Single-precision floating point',
c08 DOUBLE COMMENT 'Double-precision floating point',
c09 BIT(8) COMMENT 'Bit field (1-64 bits)',
-- String Types
c10 CHAR(50) COMMENT 'Fixed-length string',
c11 VARCHAR(1000) COMMENT 'Variable-length string',
-- Binary Types
c12 BINARY(50) COMMENT 'Fixed-length binary string',
c13 VARBINARY(1000) COMMENT 'Variable-length binary string',
-- Date and Time Types
c14 DATE COMMENT 'Date (YYYY-MM-DD)',
c15 TIME COMMENT 'Time (HH:MM:SS)',
c16 DATETIME COMMENT 'Date and time (YYYY-MM-DD HH:MM:SS)',
c17 TIMESTAMP COMMENT 'Timestamp',
c18 YEAR COMMENT 'Year',
-- Enumeration and Set Types
c19 ENUM('small','medium','large') COMMENT 'Enumeration type',
c20 SET('red','green','blue') COMMENT 'Set type',
-- Add indexes
INDEX idx_c01 (c01),
INDEX idx_c02 (c02),
INDEX idx_c03 (c03),
INDEX idx_c04 (c04),
INDEX idx_c05 (c05),
INDEX idx_c01u (c01u),
INDEX idx_c02u (c02u),
INDEX idx_c03u (c03u),
INDEX idx_c04u (c04u),
INDEX idx_c05u (c05u),
INDEX idx_c06 (c06),
INDEX idx_c06u (c06u),
INDEX idx_c07 (c07),
INDEX idx_c08 (c08),
INDEX idx_c09 (c09),
INDEX idx_c10 (c10),
# The index field length cannot exceed 950 bytes,
# which corresponds to 237 characters for a single UTF8MB4 variable-length column.
INDEX idx_c11 (c11(127)),
INDEX idx_c12 (c12),
# The index field length cannot exceed 950 bytes,
# which corresponds to 237 characters for a single UTF8MB4 variable-length column.
INDEX idx_c13 (c13(127)),
INDEX idx_c14 (c14),
INDEX idx_c15 (c15),
INDEX idx_c16 (c16),
INDEX idx_c17 (c17),
INDEX idx_c18 (c18),
INDEX idx_c19 (c19),
INDEX idx_c20 (c20)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
Warnings:
Warning	1681	UNSIGNED for decimal and floating point data types is deprecated and support for it will be removed in a future release.
CALL generate_random_data();
ANALYZE TABLE all_data_types UPDATE HISTOGRAM ON
c01, c02, c03, c04, c05,
c01u, c02u, c03u, c04u, c05u,
c06, c06u, c07, c08, c09,
c10, c11, c12, c13,
c14, c15, c16, c17, c18,
c19, c20
WITH 100 BUCKETS;
Table	Op	Msg_type	Msg_text
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c01'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c01u'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c02'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c02u'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c03'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c03u'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c04'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c04u'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c05'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c05u'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c06'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c06u'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c07'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c08'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c09'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c10'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c11'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c12'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c13'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c14'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c15'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c16'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c17'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c18'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c19'.
test_data_types.all_data_types	histogram	status	Histogram statistics created for column 'c20'.
SET session debug='+d,print_histgram_recived_values';
SELECT @@session.time_zone INTO @save_tz;
# use the UTC time to get a stable result.
SET @@session.time_zone = '+00:00';
# 1. Test with different value and check the convert result.
#    We will typically test for MIN+1, MAX-1, 0, and a random value.
SELECT COUNT(1) FROM all_data_types WHERE c01 >= -127;
Pattern "COUNT\(1.*Histogram received values: -127.*" found
