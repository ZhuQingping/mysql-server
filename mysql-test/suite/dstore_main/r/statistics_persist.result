# BUG2026010740696 if a table in dstore_index_stats data is empty. when fetch statistics to dict index->stat_leaf_page_cnt is 0.
# But when an empty table is created. initial value index->stat_leaf_page_cnt is 1. that have a inconsistency.
#
set global dstore_stats_persistent = default;
# restart: --dstore_enable_index_sample=off
create table t1(c1 int, c2 int, index index_c1_c2(c1, c2)) engine=Dstore;
select * from mysql.dstore_table_stats where database_name = 'test' and table_name = 't1';
database_name	table_name	last_update	n_rows	heap_table_pages	sum_of_index_pages	heap_table_free_pages	heap_table_lob_pages
test	t1	#	0	1	0	0	0
select * from mysql.dstore_index_stats where database_name = 'test' and table_name = 't1';
database_name	table_name	index_name	last_update	stat_name	stat_value	sample_size	stat_description
test	t1	index_c1_c2	#	n_diff_pfx01	0	0	c1
test	t1	index_c1_c2	#	n_diff_pfx02	0	0	c1,c2
test	t1	index_c1_c2	#	n_leaf_pages	1	0	Number of leaf pages in the index
test	t1	index_c1_c2	#	size	1	0	Number of pages in the index
delete from mysql.dstore_index_stats where database_name = 'test' and table_name = 't1';
# restart: --dstore_enable_index_sample=off
analyze table t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
select * from mysql.dstore_index_stats where database_name = 'test' and table_name = 't1';
database_name	table_name	index_name	last_update	stat_name	stat_value	sample_size	stat_description
