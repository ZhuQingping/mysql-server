test	t1	index_c1_c2	#	size	0	0	Number of pages in the index
drop table t1;
create table tt3(a int, index idx(a)) partition by range(a) (PARTITION p1 VALUES LESS THAN (20), PARTITION p2 VALUES LESS THAN (40),PARTITION p3 VALUES LESS THAN MAXVALUE);
select table_name from mysql.dstore_index_stats where database_name="test" and table_name like "tt3%" group by 1;
table_name
tt3#p#p1
tt3#p#p2
tt3#p#p3
drop table if exists tt3;
select table_name from mysql.dstore_index_stats where database_name="test" and table_name like "tt3%" group by 1;
table_name
