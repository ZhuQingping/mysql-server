test	t1	index_c1_c2	#	n_leaf_pages	1	0	Number of leaf pages in the index
test	t1	index_c1_c2	#	size	0	0	Number of pages in the index
delete from mysql.dstore_index_stats where database_name = 'test' and table_name = 't1';
# restart: --dstore_enable_index_sample=off
select * from t1;
c1	c2
analyze table t1;
