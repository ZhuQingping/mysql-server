4
# we see the rewriting is done, and only on "count(a)". But as "count(distinct a)" is used, not "using index".
explain select count(a), count(distinct a), count(b), sum(a), count(a+1) from t1 where b>1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	range	b	b	5	NULL	4	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select count(0) AS `count(a)`,count(distinct `test`.`t1`.`a`) AS `count(distinct a)`,count(`test`.`t1`.`b`) AS `count(b)`,sum(`test`.`t1`.`a`) AS `sum(a)`,count((`test`.`t1`.`a` + 1)) AS `count(a+1)` from `test`.`t1` where (`test`.`t1`.`b` > 1)
select count(a), count(distinct a), count(b), sum(a), count(a+1) from t1 where b>1;
count(a)	count(distinct a)	count(b)	sum(a)	count(a+1)
4	4	4	18	4
