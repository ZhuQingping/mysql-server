# FE2025032900033 convert COUNT(col) to COUNT(*) if "col" is not nullable
create table t1(a int not null, b int, index(b));
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int NOT NULL,
  `b` int DEFAULT NULL,
  KEY `b` (`b`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
insert into t1 values (1,1),(2,2),(3,3),(5,3),(8,3),(4,-1);
analyze table t1 update histogram on b;
Table	Op	Msg_type	Msg_text
test.t1	histogram	status	Histogram statistics created for column 'b'.
analyze table t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
create view v1 as select a,a+1 as c,b from t1;
# First the feature is off, then it is on. There are two things to observe in the "on" case, in EXPLAIN output:
# - the rewrite to count(0), in the 'Note' line
# - the "using index", which appears for most queries. Those for which it does not appear, have a good reason:
# even after the simplification to count(0) there remains reasons why the index on 'b' is not enough (see comments
# further down).
set optimizer_switch='simplify_count_not_null=off';
select @@optimizer_switch like '%simplify_count_not_null=on%' as simplify_count_not_null;
simplify_count_not_null
0
# Optimal case, using index only
explain select count(*) from t1 where b>1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	range	b	b	5	NULL	4	100.00	Using aggregate; Using index
Warnings:
Note	1003	/* select#1 */ select count(0) AS `count(*)` from `test`.`t1` where (`test`.`t1`.`b` > 1)
# same
explain select count(0) from t1 where b>1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	range	b	b	5	NULL	4	100.00	Using aggregate; Using index
Warnings:
Note	1003	/* select#1 */ select count(0) AS `count(0)` from `test`.`t1` where (`test`.`t1`.`b` > 1)
# this demonstrates the basic case for the feature: without/with the feature, a covering index is used or not.
explain select count(a) from t1 where b>1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	range	b	b	5	NULL	4	100.00	Using aggregate
Warnings:
Note	1003	/* select#1 */ select count(`test`.`t1`.`a`) AS `count(a)` from `test`.`t1` where (`test`.`t1`.`b` > 1)
select count(a) from t1 where b>1;
count(a)
4
# we see the rewriting is done, and only on "count(a)". But as "count(distinct a)" is used, not "using index".
explain select count(a), count(distinct a), count(b), sum(a), count(a+1) from t1 where b>1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	range	b	b	5	NULL	4	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select count(`test`.`t1`.`a`) AS `count(a)`,count(distinct `test`.`t1`.`a`) AS `count(distinct a)`,count(`test`.`t1`.`b`) AS `count(b)`,sum(`test`.`t1`.`a`) AS `sum(a)`,count((`test`.`t1`.`a` + 1)) AS `count(a+1)` from `test`.`t1` where (`test`.`t1`.`b` > 1)
select count(a), count(distinct a), count(b), sum(a), count(a+1) from t1 where b>1;
count(a)	count(distinct a)	count(b)	sum(a)	count(a+1)
4	4	4	18	4
# these two show the difference between inner join and left join: on the right side of the latter, columns become nullable.
explain select count(t1.a), count(t2.a) from t1, t1 as t2 where t1.b>1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	range	b	b	5	NULL	4	100.00	NULL
1	SIMPLE	t2	NULL	ALL	NULL	NULL	NULL	NULL	6	100.00	Using join buffer (hash join)
Warnings:
Note	1003	/* select#1 */ select count(`test`.`t1`.`a`) AS `count(t1.a)`,count(`test`.`t2`.`a`) AS `count(t2.a)` from `test`.`t1` join `test`.`t1` `t2` where (`test`.`t1`.`b` > 1)
select count(t1.a), count(t2.a) from t1, t1 as t2 where t1.b>1;
count(t1.a)	count(t2.a)
24	24
explain select count(t1.a), count(t2.a) from t1 left join t1 as t2 on t1.b>=3 where t1.b>1;
