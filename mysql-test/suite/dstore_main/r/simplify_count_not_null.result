deallocate prepare s1;
deallocate prepare s2;
# store procedure
create procedure p1(in arg int)
begin
explain select count(a) from t1 where b>arg;
select count(a) from t1 where b>arg;
end|
call p1(1);
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	range	b	b	5	NULL	4	100.00	Using index condition; Using aggregate
count(a)
