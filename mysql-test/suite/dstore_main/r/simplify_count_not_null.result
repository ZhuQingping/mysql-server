3	3
# outer reference. Here the feature brings nothing, because in the subquery ext.a is a constant, so even without any rewriting we have "using index" in the subquery. Alas we do not have "using index" in the top query (see comment in Item_sum_count::fix_fields() for an explanation).
# However, note that the rewriting happens *after* deciding of where aggregation happens, so we get an error here (aggregation in top query), while we do not get an error if the user has written count(0) (aggregation in subquery), and each time this is proper behaviour.
explain select (select count(ext.a) from t1 where t1.b>1) from t1 as ext where b>1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	PRIMARY	ext	NULL	range	b	b	5	NULL	4	100.00	Using aggregate
2	DEPENDENT SUBQUERY	t1	NULL	range	b	b	5	NULL	4	100.00	Using index
Warnings:
Note	1276	Field or reference 'test.ext.a' of SELECT #2 was resolved in SELECT #1
Note	1003	/* select#1 */ select (/* select#2 */ select count(`test`.`ext`.`a`) from `test`.`t1` where (`test`.`t1`.`b` > 1)) AS `(select count(ext.a) from t1 where t1.b>1)` from `test`.`t1` `ext` where (`test`.`ext`.`b` > 1)
select (select count(ext.a) from t1 where t1.b>1) from t1 as ext where b>1;
ERROR 21000: Subquery returns more than 1 row
explain select (select count(0) from t1 where t1.b>1) from t1 as ext where b>1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	PRIMARY	ext	NULL	range	b	b	5	NULL	4	100.00	Using index
2	SUBQUERY	t1	NULL	range	b	b	5	NULL	4	100.00	Using aggregate; Using index
Warnings:
Note	1003	/* select#1 */ select (/* select#2 */ select count(0) from `test`.`t1` where (`test`.`t1`.`b` > 1)) AS `(select count(0) from t1 where t1.b>1)` from `test`.`t1` `ext` where (`test`.`ext`.`b` > 1)
select (select count(0) from t1 where t1.b>1) from t1 as ext where b>1;
(select count(0) from t1 where t1.b>1)
4
4
4
4
# As a consequence, such rewriting must not be done while creating a view (but it can be done when reading from this view), otherwise, the query's meaning would change.
create view v2 as select (select count(ext.a) from t1 where t1.b>1) from t1 as ext where b>1;
# Not done when creating:
show create view v2;
View	Create View	character_set_client	collation_connection
v2	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v2` AS select (select count(`ext`.`a`) from `t1` where (`t1`.`b` > 1)) AS `(select count(ext.a) from t1 where t1.b>1)` from `t1` `ext` where (`ext`.`b` > 1)	utf8mb4	utf8mb4_0900_ai_ci
# Done when reading:
set optimizer_trace='enabled=on';
select * from v2;
ERROR 21000: Subquery returns more than 1 row
# The rewriting happened above ; it cannot be seen in EXPLAIN (which would fail with ER_SUBQUERY_NO_1_ROW because the view is single-row so materialized during EXPLAIN) but it can be seen in the optimizer trace:
select trace like '% count(0) %' from information_schema.optimizer_trace;
trace like '% count(0) %'
0
set optimizer_trace=default;
drop view v2;
