# and also if the view is materialized: the tmp table's have proper (non-)nullability so we can use this information, and rewrite. No "using index" though, which is understandable: MySQL has not created any index on the tmp table.
explain select /*+ no_merge() */ count(a), count(c), count(b) from v1 where b>1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	PRIMARY	<derived2>	NULL	ALL	NULL	NULL	NULL	NULL	4	100.00	NULL
2	DERIVED	t1	NULL	range	b	b	5	NULL	4	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select /*+ NO_MERGE(@`select#1`) */ count(`test`.`v1`.`a`) AS `count(a)`,count(`test`.`v1`.`c`) AS `count(c)`,count(`test`.`v1`.`b`) AS `count(b)` from `test`.`v1`
select /*+ no_merge() */ count(a), count(c), count(b) from v1 where b>1;
count(a)	count(c)	count(b)
4	4	4
