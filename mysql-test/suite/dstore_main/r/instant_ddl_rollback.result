##############################################
# Test instant ADD/DROP COLUMN for REDUNDANT format
##############################################
# ------------------------------------------------------------
# Create a table with 3 columns. [id, c1, c2, c3]
# ------------------------------------------------------------
CREATE TABLE t1(id INT PRIMARY KEY, c1 VARCHAR(4000), c2 VARCHAR(4000), c3 VARCHAR(1000)) ROW_FORMAT=REDUNDANT;;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
INSERT INTO t1 VALUES(1, repeat('a', 4000), repeat('b', 4000), repeat('c', 1));
SELECT id, length(c1), length(c2), length(c3) FROM t1 ORDER BY id;
id	length(c1)	length(c2)	length(c3)
1	4000	4000	1
SELECT id, LEFT(c1 , 10), LEFT(c2, 10), c3 FROM t1 ORDER BY id;
id	LEFT(c1 , 10)	LEFT(c2, 10)	c3
1	aaaaaaaaaa	bbbbbbbbbb	c
# INSTANT ADD a column
ALTER TABLE t1 ADD COLUMN c4 VARCHAR(500) NOT NULL DEFAULT '', ALGORITHM=INSTANT;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
INSERT INTO t1 VALUES(2, repeat('e', 4000), repeat('f', 4000), repeat('g', 1), repeat('h', 100));
SELECT id, length(c1), length(c2), length(c3), length(c4) FROM t1 ORDER BY id;
id	length(c1)	length(c2)	length(c3)	length(c4)
1	4000	4000	1	500
2	4000	4000	1	100
SELECT id, LEFT(c1 , 10), LEFT(c2, 10), c3, LEFT(c4, 10) FROM t1 ORDER BY id;
id	LEFT(c1 , 10)	LEFT(c2, 10)	c3	LEFT(c4, 10)
1	aaaaaaaaaa	bbbbbbbbbb	c	dddddddddd
2	eeeeeeeeee	ffffffffff	g	hhhhhhhhhh
START TRANSACTION;
UPDATE t1 SET c1 = repeat('x', 200) WHERE id = 1;
SELECT id, length(c1), length(c2), length(c3), length(c4) FROM t1 ORDER BY id;
id	length(c1)	length(c2)	length(c3)	length(c4)
1	200	4000	1	500
2	4000	4000	1	100
SELECT id, LEFT(c1 , 10), LEFT(c2, 10), c3, LEFT(c4, 10) FROM t1 ORDER BY id;
id	LEFT(c1 , 10)	LEFT(c2, 10)	c3	LEFT(c4, 10)
1	xxxxxxxxxx	bbbbbbbbbb	c	dddddddddd
2	eeeeeeeeee	ffffffffff	g	hhhhhhhhhh
ROLLBACK;
SELECT id, length(c1), length(c2), length(c3), length(c4) FROM t1 ORDER BY id;
id	length(c1)	length(c2)	length(c3)	length(c4)
1	4000	4000	1	500
2	4000	4000	1	100
SELECT id, LEFT(c1 , 10), LEFT(c2, 10), c3, LEFT(c4, 10) FROM t1 ORDER BY id;
id	LEFT(c1 , 10)	LEFT(c2, 10)	c3	LEFT(c4, 10)
1	aaaaaaaaaa	bbbbbbbbbb	c	dddddddddd
2	eeeeeeeeee	ffffffffff	g	hhhhhhhhhh
# INSTANT DROP a column
ALTER TABLE t1 DROP COLUMN c4, ALGORITHM=INSTANT;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
SELECT id, length(c1), length(c2), length(c3) FROM t1 ORDER BY id;
id	length(c1)	length(c2)	length(c3)
1	4000	4000	1
2	4000	4000	1
SELECT id, LEFT(c1 , 10), LEFT(c2, 10), LEFT(c3, 10) FROM t1 ORDER BY id;
id	LEFT(c1 , 10)	LEFT(c2, 10)	LEFT(c3, 10)
1	aaaaaaaaaa	bbbbbbbbbb	c
2	eeeeeeeeee	ffffffffff	g
START TRANSACTION;
UPDATE t1 SET c1 = repeat('x', 200) WHERE id = 1;
SELECT id, length(c1), length(c2), length(c3) FROM t1 ORDER BY id;
id	length(c1)	length(c2)	length(c3)
1	200	4000	1
2	4000	4000	1
SELECT id, LEFT(c1 , 10), LEFT(c2, 10), LEFT(c3, 10) FROM t1 ORDER BY id;
id	LEFT(c1 , 10)	LEFT(c2, 10)	LEFT(c3, 10)
1	xxxxxxxxxx	bbbbbbbbbb	c
2	eeeeeeeeee	ffffffffff	g
ROLLBACK;
SELECT id, length(c1), length(c2), length(c3) FROM t1 ORDER BY id;
id	length(c1)	length(c2)	length(c3)
1	4000	4000	1
2	4000	4000	1
SELECT id, LEFT(c1 , 10), LEFT(c2, 10), LEFT(c3, 10) FROM t1 ORDER BY id;
id	LEFT(c1 , 10)	LEFT(c2, 10)	LEFT(c3, 10)
1	aaaaaaaaaa	bbbbbbbbbb	c
2	eeeeeeeeee	ffffffffff	g
###########
# CLEANUP #
###########
DROP TABLE t1;
