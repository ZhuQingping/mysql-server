(10, 'A', 100.50),
(20, 'B', 200.75),
(30, 'C', 300.25),
(40, 'D', 400.00),
(50, 'E', 500.50),
(60, 'F', 600.75),
(70, 'G', 700.25),
(80, 'H', 800.00),
