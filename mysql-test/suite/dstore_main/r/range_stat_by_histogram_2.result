# Index (c01,c02,c03,c04,c05,c06) - TINYINT related
# =====================================================
# Full range query on all columns
SELECT COUNT(1)
FROM multi_column_index
WHERE
(
c01 > -128 OR
(c01 = -128 AND c02 > 0) OR
(c01 = -128 AND c02 = 0 AND c03 > 0) OR
(c01 = -128 AND c02 = 0 AND c03 = 0 AND c04 > 0) OR
(c01 = -128 AND c02 = 0 AND c03 = 0 AND c04 = 0 AND c05 > -128) OR
(c01 = -128 AND c02 = 0 AND c03 = 0 AND c04 = 0 AND c05 = -128 AND c06 >= 0)
)
AND
(
c01 < 127 OR
(c01 = 127 AND c02 < 255) OR
(c01 = 127 AND c02 = 255 AND c03 < 1) OR
(c01 = 127 AND c02 = 255 AND c03 = 1 AND c04 < 255) OR
(c01 = 127 AND c02 = 255 AND c03 = 1 AND c04 = 255 AND c05 < 127) OR
(c01 = 127 AND c02 = 255 AND c03 = 1 AND c04 = 255 AND c05 = 127 AND c06 <= 255)
);
