CREATE TABLE `BUG2025042413770` (
`pk` int NOT NULL AUTO_INCREMENT PRIMARY KEY,
`char_col` char(10) DEFAULT NULL,
KEY `idx_char_col` (char_col)
) ENGINE=Dstore CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
CREATE PROCEDURE gen_bug2025042413770_data()
BEGIN
DECLARE i INT DEFAULT 1;
DECLARE char_val CHAR(10);
WHILE i <= 1000 DO
IF i <= 250 THEN
SET char_val = 'Taurus';
ELSEIF i <= 500 THEN
SET char_val = 'Taurus ';
ELSEIF i <= 750 THEN
SET char_val = 'Taurus    ';
ELSE
SET char_val = 'TaurusDB04';
END IF;
INSERT INTO BUG2025042413770 (char_col) VALUES (char_val);
SET i = i + 1;
END WHILE;
END$$
CALL gen_bug2025042413770_data();
set sql_mode="PAD_CHAR_TO_FULL_LENGTH";
