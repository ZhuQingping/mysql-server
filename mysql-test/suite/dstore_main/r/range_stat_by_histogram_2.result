DROP DATABASE IF EXISTS test_cond_table;
CREATE DATABASE test_cond_table;
USE test_cond_table;
CREATE TABLE test_cond_table (
id BIGINT AUTO_INCREMENT PRIMARY KEY,
c1 INT NOT NULL,
c2 INT,
c3 INT,
INDEX idx_c1 (c1),
INDEX idx_c2 (c2),
INDEX idx_c3 (c3),
INDEX idx_c1_c2_c3 (c1, c2, c3)
) ENGINE=Dstore;
CALL insert_combinations();
ANALYZE TABLE test_cond_table
UPDATE HISTOGRAM ON c1, c2, c3
WITH 100 BUCKETS;
Table	Op	Msg_type	Msg_text
test_cond_table.test_cond_table	histogram	status	Histogram statistics created for column 'c1'.
test_cond_table.test_cond_table	histogram	status	Histogram statistics created for column 'c2'.
test_cond_table.test_cond_table	histogram	status	Histogram statistics created for column 'c3'.
# 1. Test NULL condition.
SELECT COUNT(1) FROM test_cond_table WHERE c2 IS NULL;
COUNT(1)
10
# 2. Test NOT NULL condition.
SELECT COUNT(1) FROM test_cond_table WHERE c2 IS NOT NULL;
COUNT(1)
1000
# 3. Test GT condition.
SELECT COUNT(1) FROM test_cond_table WHERE c1 > 5;
COUNT(1)
505
# 4. Test GE condition.
SELECT COUNT(1) FROM test_cond_table WHERE c1 >= 5;
COUNT(1)
606
# 5. Test LT condition.
SELECT COUNT(1) FROM test_cond_table WHERE c1 < 5;
COUNT(1)
404
# 6. Test LE condition.
SELECT COUNT(1) FROM test_cond_table WHERE c1 <= 5;
COUNT(1)
505
# 7. Test COMP condition.
SELECT COUNT(1) FROM test_cond_table WHERE c1 <= 5 AND c1 > 2;
COUNT(1)
303
SELECT COUNT(1) FROM test_cond_table WHERE c1 < 5 AND c1 > 2;
COUNT(1)
202
SELECT COUNT(1) FROM test_cond_table WHERE c1 < 5 AND c1 >= 2;
COUNT(1)
303
SELECT COUNT(1) FROM test_cond_table WHERE c1 <= 5 AND c1 >= 2;
COUNT(1)
404
# 8. Test NE condition.
SELECT COUNT(1) FROM test_cond_table WHERE c1 != 5;
COUNT(1)
909
# 9. Test EQ condition.
SELECT COUNT(1) FROM test_cond_table WHERE c1 = 5;
COUNT(1)
101
# 10. Test BETWEEN condition.
SELECT COUNT(1) FROM test_cond_table WHERE c1 BETWEEN 2 and 6;
COUNT(1)
505
# 11. Test not BETWEEN condition.
SELECT COUNT(1) FROM test_cond_table WHERE c1 NOT BETWEEN 2 and 6;
COUNT(1)
505
# 12. Test IN condition.
SELECT COUNT(1) FROM test_cond_table WHERE c1 IN (1,3,5);
COUNT(1)
303
DROP DATABASE test_cond_table;
DROP DATABASE IF EXISTS multi_column_index;
CREATE DATABASE multi_column_index;
USE multi_column_index;
CREATE TABLE multi_column_index (
id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
-- TINYINT (-128 to 127 or 0 to 255)
c01 TINYINT,                    -- Default signed
c02 TINYINT UNSIGNED,           -- Unsigned
c03 TINYINT(1),                -- Commonly used for boolean
c04 TINYINT UNSIGNED ZEROFILL,  -- Zero-fill
c05 TINYINT NOT NULL DEFAULT 127,      -- Maximum signed value
c06 TINYINT UNSIGNED NOT NULL DEFAULT 255,  -- Maximum unsigned value
-- SMALLINT (-32768 to 32767 or 0 to 65535)
c07 SMALLINT,                   -- Default signed
c08 SMALLINT UNSIGNED,          -- Unsigned
c09 SMALLINT(4),               -- Display width
c10 SMALLINT UNSIGNED ZEROFILL, -- Zero-fill
c11 SMALLINT NOT NULL DEFAULT 32767,    -- Maximum signed value
c12 SMALLINT UNSIGNED NOT NULL DEFAULT 65535,  -- Maximum unsigned value
-- MEDIUMINT (-8388608 to 8388607 or 0 to 16777215)
c13 MEDIUMINT,                  -- Default signed
c14 MEDIUMINT UNSIGNED,         -- Unsigned
c15 MEDIUMINT(7),              -- Display width
c16 MEDIUMINT UNSIGNED ZEROFILL,-- Zero-fill
c17 MEDIUMINT NOT NULL DEFAULT 8388607,  -- Maximum signed value
c18 MEDIUMINT UNSIGNED NOT NULL DEFAULT 16777215,  -- Maximum unsigned value
-- INT (-2147483648 to 2147483647 or 0 to 4294967295)
c19 INT,                        -- Default signed
c20 INT UNSIGNED,               -- Unsigned
c21 INT(9),                    -- Display width
c22 INT UNSIGNED ZEROFILL,      -- Zero-fill
c23 INT NOT NULL DEFAULT 2147483647,  -- Maximum signed value
c24 INT UNSIGNED NOT NULL DEFAULT 4294967295,  -- Maximum unsigned value
-- BIGINT (-9223372036854775808 to 9223372036854775807 or 0 to 18446744073709551615)
c25 BIGINT,                     -- Default signed
c26 BIGINT UNSIGNED,            -- Unsigned
c27 BIGINT(18),               -- Display width
c28 BIGINT UNSIGNED ZEROFILL,   -- Zero-fill
c29 BIGINT NOT NULL DEFAULT 9223372036854775807,  -- Maximum signed value
c30 BIGINT UNSIGNED NOT NULL DEFAULT 18446744073709551615,  -- Maximum unsigned value
-- Combined indexes for each integer type group
INDEX idx_tinyint_combined (c01, c02, c03, c04, c05, c06),
INDEX idx_smallint_combined (c07, c08, c09, c10, c11, c12),
INDEX idx_mediumint_combined (c13, c14, c15, c16, c17, c18),
INDEX idx_int_combined (c19, c20, c21, c22, c23, c24),
INDEX idx_bigint_combined (c25, c26, c27, c28, c29, c30)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
