DROP DATABASE IF EXISTS test_equal_cond;
CREATE DATABASE test_equal_cond;
USE test_equal_cond;
CREATE TABLE test_equal_cond (
pk INT PRIMARY KEY,
i1 INT,
b1 BIT(8),
d1 DATE,
d2 TIME,
d3 DATETIME,
d4 TIMESTAMP,
d5 YEAR,
s1 CHAR(32),
s2 VARCHAR(128),
e ENUM('a','b','c'),
e2 SET('a','b','c'),
INDEX idx_i1 (i1),
INDEX idx_b1 (b1),
INDEX idx_d1 (d1),
INDEX idx_d2 (d2),
INDEX idx_d3 (d3),
INDEX idx_d4 (d4),
INDEX idx_d5 (d5),
INDEX idx_s1 (s1),
INDEX idx_s2 (s2),
INDEX idx_e (e),
INDEX idx_e2 (e2)
) ENGINE=Dstore;
