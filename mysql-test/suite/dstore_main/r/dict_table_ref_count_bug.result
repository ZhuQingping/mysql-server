#
# Test 1. When the background statistic thread hold the MDL read lock, we cannot do DDL
#
CREATE TABLE t1 (c1 int);
SET GLOBAL DEBUG='+d,bg_stat_after_get_table_wait';
insert into t1 values (1);
insert into t1 values (2);
insert into t1 values (3);
SET GLOBAL DEBUG='-d,bg_stat_after_get_table_wait';
ALTER TABLE t1 add column c2 int;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
SET DEBUG_SYNC = 'now SIGNAL resume_bg_stat_sig';
SET DEBUG_SYNC= 'RESET';
#
# Test 2. When we are doing ddl, we cannot do background statistic
#
SET GLOBAL DEBUG='+d,bg_stat_after_get_table_name_wait';
insert into t1 values (4);
insert into t1 values (5);
insert into t1 values (6);
SET GLOBAL DEBUG='-d,bg_stat_after_get_table_name_wait';
SET DEBUG_SYNC = 'before_get_refcnt SIGNAL resume_bg_stat_sig WAIT_FOR c1';
ALTER TABLE t1 add column c2 int;;
include/assert_grep.inc [bg statistic thread should wait mdl lock fail]
SET DEBUG_SYNC = 'now SIGNAL c1';
SELECT * FROM t1;
c1	c2
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL
6	NULL
DROP TABLE t1;
#
# Test 2. BUG2026020229395 We cannot acquire the operation lock before check the result of CdeDdTableLoadForeignKey
#
create table t1 (c1 int primary key);
create table t2 (c1 int primary key);
ALTER TABLE t1 ADD CONSTRAINT c1fk FOREIGN KEY (c1) REFERENCES t2 (c1) ON UPDATE CASCADE;
FLUSH TABLE t1;
set debug = "+d, force_reload_dict_table, dd_table_load_foreign_key_failed";
set debug_sync = "wait_after_load_foreign_key wait_for c1";
select * from t1;;
select * from t1;;
We should ensure the SQL of connection 2 is stuck.
select count(*) from information_schema.processlist where USER = 'root' and COMMAND != 'Sleep';
count(*)
3
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
set debug_sync = "now signal c1";
ERROR 42S02: Table 'test.t1' doesn't exist
set debug = "-d, force_reload_dict_table, dd_table_load_foreign_key_failed";
c1
#
# Clean up
#
DROP TABLE t1, t2;
