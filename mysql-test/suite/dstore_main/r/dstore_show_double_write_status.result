CALL mtr.add_suppression(".*Get double write info failed.*");
show status like "Dstore_double_write_init_normal";
Variable_name	Value
Dstore_double_write_init_normal	ON
# restart:--dstore-enable-double-write=OFF
show status like "Dstore_double_write_init_normal";
Variable_name	Value
Dstore_double_write_init_normal	OFF
# restart:--dstore-enable-double-write=ON
set global debug="+d,get_double_write_info_fail";
show status like "Dstore_double_write_init_normal";
Variable_name	Value
Dstore_double_write_init_normal	OFF
set global debug="-d,get_double_write_info_fail";
