RESET MASTER;
CREATE TABLE t1(c1 INT);
SET @@GLOBAL.DEBUG= '+d, simulate_binlog_is_closed';
INSERT INTO t1 VALUES(1);
#
# Check that the 'INSERT' transaction is committed successfully.
#
SELECT * FROM t1 ORDER BY t1.c1;
c1
1
SET @@GLOBAL.DEBUG= '-d, simulate_binlog_is_closed';
DELETE FROM t1 WHERE c1=1;
#
# Check that the 'DELETE' transaction is committed successfully.
#
SELECT * FROM t1 ORDER BY t1.c1;
c1
#
# Check that the above 'INSERT' transaction is not written into
# binary log and the above 'DELETE' transaction is written into
# binary log.
#
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
binlog.000001	#	Previous_gtids	#	#	
binlog.000001	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
binlog.000001	#	Query	#	#	use `test`; CREATE TABLE t1(c1 INT)
binlog.000001	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
binlog.000001	#	Query	#	#	BEGIN
binlog.000001	#	Table_map	#	#	table_id: # (test.t1)
binlog.000001	#	Delete_rows	#	#	table_id: # flags: STMT_END_F
binlog.000001	#	Xid	#	#	COMMIT /* XID */
DROP TABLE t1;
