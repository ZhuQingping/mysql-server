RESET MASTER;
CREATE DATABASE db1;
DROP DATABASE db1;
CREATE TABLE t1(c1 INT PRIMARY KEY);
#
# Create connections.
#
#
# Execute inserts in parallel on master.
#
INSERT INTO t1 VALUES (1);;
INSERT INTO t1 VALUES (2);;
INSERT INTO t1 VALUES (3);;
INSERT INTO t1 VALUES (4);;
INSERT INTO t1 VALUES (5);;
INSERT INTO t1 VALUES (6);;
INSERT INTO t1 VALUES (7);;
INSERT INTO t1 VALUES (8);;
INSERT INTO t1 VALUES (9);;
INSERT INTO t1 VALUES (10);;
INSERT INTO t1 VALUES (11);;
INSERT INTO t1 VALUES (12);;
INSERT INTO t1 VALUES (13);;
INSERT INTO t1 VALUES (14);;
INSERT INTO t1 VALUES (15);;
INSERT INTO t1 VALUES (16);;
#
# Execute inserts in parallel on master again.
#
INSERT INTO t1 VALUES (101);;
INSERT INTO t1 VALUES (102);;
INSERT INTO t1 VALUES (103);;
INSERT INTO t1 VALUES (104);;
INSERT INTO t1 VALUES (105);;
INSERT INTO t1 VALUES (106);;
INSERT INTO t1 VALUES (107);;
INSERT INTO t1 VALUES (108);;
INSERT INTO t1 VALUES (109);;
INSERT INTO t1 VALUES (110);;
INSERT INTO t1 VALUES (111);;
INSERT INTO t1 VALUES (112);;
INSERT INTO t1 VALUES (113);;
INSERT INTO t1 VALUES (114);;
INSERT INTO t1 VALUES (115);;
INSERT INTO t1 VALUES (116);;
#
# Check that the concurrent transactions are committed successfully.
#
SELECT * FROM t1 ORDER BY t1.c1;
