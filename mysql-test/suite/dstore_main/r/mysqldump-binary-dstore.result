# Bug#22601255 Restoring a dump of binary column, made with mysqldump, warns of invalid string
CREATE TABLE t1(
u CHAR(10),
b BINARY(16),
bi BIT(64));
INSERT INTO t1 VALUES(
'basic',
x'EE0C6D03C34C11E5B1640026B977EB17',
x'EE0C6D03C34C11E5');
SELECT
u='basic',
HEX(b)='EE0C6D03C34C11E5B1640026B977EB17',
HEX(bi)='EE0C6D03C34C11E5'
FROM t1;
