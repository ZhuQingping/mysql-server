DESCRIBE INFORMATION_SCHEMA.DSTORE_SEGMENT;
Field	Type	Null	Key	Default	Extra
SEGMENT_ID	varchar(20)	NO			
TYPE	varchar(10)	NO			
DB_NAME	varchar(320)	NO			
TABLE_NAME	varchar(320)	NO			
INDEX_NAME	varchar(320)	NO			
PARTITION_NAME	varchar(320)	NO			
TABLESPACE	bigint unsigned	NO			
FILL_FACTOR	int unsigned	NO			
PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_64B_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_128B_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_512B_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_1K_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_2K_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_4K_PAGE_COUNT	bigint unsigned	NO			
FREE_LEVEL_8K_PAGE_COUNT	bigint unsigned	NO			
DROP DATABASE IF EXISTS IS_PUSHDOWN;
CREATE DATABASE IS_PUSHDOWN;
USE IS_PUSHDOWN;
DROP TABLE IF EXISTS sales;
DROP TABLE IF EXISTS t_audit_logs;
CREATE TABLE sales (
id INT NOT NULL,
sale_date DATE NOT NULL,
amount DECIMAL(10,2),
content TEXT,
PRIMARY KEY (id, sale_date) COMMENT 'fillfactor=50',
INDEX idx_amount (amount) COMMENT 'fillfactor=60'
)
PARTITION BY RANGE (YEAR(sale_date)) (
PARTITION p2023 VALUES LESS THAN (2024),
PARTITION p2024 VALUES LESS THAN (2025),
PARTITION p2025 VALUES LESS THAN (2026),
PARTITION p_future VALUES LESS THAN MAXVALUE
);
CREATE TABLE t_audit_logs (
id BIGINT NOT NULL AUTO_INCREMENT,
log_time DATETIME NOT NULL,
user_id INT,
action_type VARCHAR(50),
content TEXT,
PRIMARY KEY (id, log_time)
)
PARTITION BY RANGE (YEAR(log_time))
SUBPARTITION BY HASH (id)
SUBPARTITIONS 4
(
PARTITION p2024 VALUES LESS THAN (2025),
PARTITION p2025 VALUES LESS THAN (2026),
PARTITION p_future VALUES LESS THAN MAXVALUE
);
