CREATE TABLE t1(i INT,
j INT,
k INT) ENGINE=dstore;
CREATE TABLE t2(i INT PRIMARY KEY,
j INT,
k INT,
UNIQUE KEY covering(i,j)) ENGINE=dstore;
INSERT INTO t1 VALUES (1,2,3), (2,2,3), (3,2,3), (4,2,3);
INSERT INTO t2 VALUES (1,2,3), (2,2,3), (3,2,3), (4,2,3);
ANALYZE TABLE t1, t2;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK
SELECT t2.i, t2.j
FROM t1, t2 WHERE t1.i = t2.i;
i	j
1	2
2	2
3	2
4	2
EXPLAIN SELECT t2.i, t2.j
FROM t1, t2 WHERE t1.i = t2.i;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	4	100.00	Using where
1	SIMPLE	t2	NULL	eq_ref	PRIMARY,covering	covering	4	test.t1.i	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`j` AS `j` from `test`.`t1` join `test`.`t2` where (`test`.`t2`.`i` = `test`.`t1`.`i`)
EXPLAIN FORMAT=tree SELECT t2.i, t2.j
FROM t1, t2 WHERE t1.i = t2.i;
EXPLAIN
-> Nested loop inner join  (...)
    -> Filter: (t1.i is not null)  (...)
        -> Table scan on t1  (...)
    -> Single-row covering index lookup on t2 using covering (i=t1.i)  (...)

# Check that the promotion is visible in optimizer trace
SET SESSION optimizer_trace="enabled=ON";
SELECT t2.i, t2.j
FROM t1, t2 WHERE t1.i = t2.i;
i	j
1	2
2	2
3	2
4	2
SELECT json_extract(trace,
CONCAT("$.steps[1].join_optimization.steps[5].",
"considered_execution_plans[0].rest_of_plan[0].",
"best_access_path.considered_access_paths[1].",
"promoted_covering_index_over_PK"))
FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE;
json_extract(trace,
CONCAT("$.steps[1].join_optimization.steps[5].",
"considered_execution_plans[0].rest_of_plan[0].",
"best_access_path.considered_access_paths[1].",
"promoted_covering_index_over_PK"))
true
# Check that we do not get promotion if the feature is switched off:
SET SESSION rds_prefer_covering_index_over_pk = 0;
SELECT t2.i, t2.j
FROM t1, t2 WHERE t1.i = t2.i;
i	j
1	2
2	2
3	2
4	2
SELECT json_extract(trace,
CONCAT("$.steps[1].join_optimization.steps[5].",
"considered_execution_plans[0].rest_of_plan[0].",
"best_access_path.considered_access_paths[1].",
"promoted_covering_index_over_PK"))
FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE;
json_extract(trace,
CONCAT("$.steps[1].join_optimization.steps[5].",
"considered_execution_plans[0].rest_of_plan[0].",
"best_access_path.considered_access_paths[1].",
"promoted_covering_index_over_PK"))
NULL
EXPLAIN SELECT t2.i, t2.j
FROM t1, t2 WHERE t1.i = t2.i;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	4	100.00	Using where
1	SIMPLE	t2	NULL	eq_ref	PRIMARY,covering	PRIMARY	4	test.t1.i	1	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`j` AS `j` from `test`.`t1` join `test`.`t2` where (`test`.`t2`.`i` = `test`.`t1`.`i`)
SET SESSION optimizer_trace="enabled=DEFAULT";
SET SESSION rds_prefer_covering_index_over_pk = default;
EXPLAIN
SELECT t2.*
FROM t1, t2 WHERE t1.i = t2.i;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	4	100.00	Using where
1	SIMPLE	t2	NULL	eq_ref	PRIMARY,covering	PRIMARY	4	test.t1.i	1	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`j` AS `j`,`test`.`t2`.`k` AS `k` from `test`.`t1` join `test`.`t2` where (`test`.`t2`.`i` = `test`.`t1`.`i`)
SELECT t2.i, t2.j, t2_a.i, t2_a.j
FROM t2, t2 AS t2_a WHERE t2_a.i = t2.i AND t2.j = t2_a.j;
i	j	i	j
1	2	1	2
2	2	2	2
3	2	3	2
4	2	4	2
EXPLAIN SELECT t2.i, t2.j, t2_a.i, t2_a.j
FROM t2, t2 AS t2_a WHERE t2_a.i = t2.i AND t2.j = t2_a.j;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	index	PRIMARY,covering	covering	9	NULL	4	100.00	Using where; Using index
1	SIMPLE	t2_a	NULL	eq_ref	PRIMARY,covering	covering	9	test.t2.i,test.t2.j	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`j` AS `j`,`test`.`t2_a`.`i` AS `i`,`test`.`t2_a`.`j` AS `j` from `test`.`t2` join `test`.`t2` `t2_a` where ((`test`.`t2_a`.`j` = `test`.`t2`.`j`) and (`test`.`t2_a`.`i` = `test`.`t2`.`i`))
EXPLAIN FORMAT=tree SELECT t2.i, t2.j, t2_a.i, t2_a.j
FROM t2, t2 AS t2_a WHERE t2_a.i = t2.i AND t2.j = t2_a.j;
EXPLAIN
-> Nested loop inner join  (...)
    -> Filter: (t2.j is not null)  (...)
        -> Index scan on t2 using covering  (...)
    -> Single-row covering index lookup on t2_a using covering (i=t2.i, j=t2.j)  (...)

DROP TABLE t2;
# Don't be explicit that the covering key is unique, since
# it contains primary key prefix we know that is redundant.
CREATE TABLE t2(i INT PRIMARY KEY,
j INT,
k INT,
KEY covering(i,j)) ENGINE=dstore;
INSERT INTO t2 VALUES (1,2,3), (2,2,3), (3,2,3), (4,2,3);
ANALYZE TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	OK
SELECT t2.i, t2.j
FROM t1, t2 WHERE t1.i = t2.i;
i	j
1	2
2	2
3	2
4	2
EXPLAIN SELECT t2.i, t2.j
FROM t1, t2 WHERE t1.i = t2.i;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	4	100.00	Using where
1	SIMPLE	t2	NULL	eq_ref	PRIMARY,covering	covering	4	test.t1.i	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`j` AS `j` from `test`.`t1` join `test`.`t2` where (`test`.`t2`.`i` = `test`.`t1`.`i`)
EXPLAIN FORMAT=tree SELECT t2.i, t2.j
FROM t1, t2 WHERE t1.i = t2.i;
EXPLAIN
-> Nested loop inner join  (...)
    -> Filter: (t1.i is not null)  (...)
        -> Table scan on t1  (...)
    -> Single-row covering index lookup on t2 using covering (i=t1.i)  (...)

SELECT t2.i, t2.j, t2_a.i, t2_a.j
FROM t2, t2 AS t2_a WHERE t2_a.i = t2.i AND t2.j = t2_a.j;
i	j	i	j
1	2	1	2
2	2	2	2
3	2	3	2
4	2	4	2
EXPLAIN SELECT t2.i, t2.j, t2_a.i, t2_a.j
FROM t2, t2 AS t2_a WHERE t2_a.i = t2.i AND t2.j = t2_a.j;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t2	NULL	index	PRIMARY,covering	covering	9	NULL	4	100.00	Using where; Using index
1	SIMPLE	t2_a	NULL	eq_ref	PRIMARY,covering	covering	9	test.t2.i,test.t2.j	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`i` AS `i`,`test`.`t2`.`j` AS `j`,`test`.`t2_a`.`i` AS `i`,`test`.`t2_a`.`j` AS `j` from `test`.`t2` join `test`.`t2` `t2_a` where ((`test`.`t2_a`.`j` = `test`.`t2`.`j`) and (`test`.`t2_a`.`i` = `test`.`t2`.`i`))
EXPLAIN FORMAT=tree SELECT t2.i, t2.j, t2_a.i, t2_a.j
FROM t2, t2 AS t2_a WHERE t2_a.i = t2.i AND t2.j = t2_a.j;
EXPLAIN
-> Nested loop inner join  (...)
    -> Filter: (t2.j is not null)  (...)
        -> Index scan on t2 using covering  (...)
    -> Single-row covering index lookup on t2_a using covering (i=t2.i, j=t2.j)  (...)

SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `i` int NOT NULL,
  `j` int DEFAULT NULL,
  `k` int DEFAULT NULL,
  PRIMARY KEY (`i`),
  KEY `covering` (`i`,`j`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1, t2;
