#
# CDE
#
use test;
CALL mtr.add_suppression("insert dstore index tuple fail");
CALL mtr.add_suppression("insert_index fail");
create table t1(n int);
# test-single stmt trx rollback
insert into t1 values(1);
SET SESSION DEBUG='+d,stmt_rollback_injection';
insert into t1 values(2);
ERROR HY000: Got error 168 - 'Unknown (generic) error from engine' from storage engine
SET SESSION DEBUG='-d,stmt_rollback_injection';
select * from t1;
n
1
delete from t1;
# test-multi stmt trx manual rollback
insert into t1 values(1);
begin;
insert into t1 values(2);
insert into t1 values(3);
insert into t1 values(4);
rollback;
select * from t1;
n
1
delete from t1;
# test-multi stmt trx automatic rollback(like dead lock)
begin;
insert into t1 values(1);
insert into t1 values(2);
SET SESSION DEBUG='+d,trx_rollback_injection';
insert into t1 values(3);
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
SET SESSION DEBUG='-d,trx_rollback_injection';
select * from t1;
n
delete from t1;
# test-multi stmt trx automatic current sql rollback
begin;
insert into t1 values(1);
insert into t1 values(2);
SET SESSION DEBUG='+d,stmt_rollback_injection';
insert into t1 values(3);
ERROR HY000: Got error 168 - 'Unknown (generic) error from engine' from storage engine
SET SESSION DEBUG='-d,stmt_rollback_injection';
select * from t1;
n
1
2
commit;
select * from t1;
n
1
2
delete from t1;
# test-multi stmt trx + ddl commit
begin;
insert into t1 values(1);
insert into t1 values(2);
create table t2(n int);
select * from t1;
n
1
2
commit;
select * from t1;
n
1
2
drop table t2;
drop table t1;
# test-dead lock of update and update
# Establish connection thr1 (user=root)
# Establish connection thr2 (user=root)
# Switching to default.
create table testp (
id int not null primary key, 
varchar_col varchar(10) not null,
char_col char(5) not null
) ENGINE=Dstore character set utf8mb4 collate utf8mb4_0900_ai_ci;
insert into testp values(1,'aaa','bbb');
insert into testp values(2,'aaa','bbb');
select * from testp;
id	varchar_col	char_col
1	aaa	bbb
2	aaa	bbb
# Switching to connection 'thr1'.
begin;
update testp set varchar_col = "xxx" where id = 1;
# Switching to connection 'thr2'.
begin;
update testp set varchar_col = "ppp" where id = 2;
# Switching to connection 'thr1'.
update testp set varchar_col = "yyy" where id = 2;;
# Switching to connection 'thr2'
update testp set varchar_col = "qqq" where id = 1;
commit;
select * from testp;
id	varchar_col	char_col
1	qqq	bbb
2	ppp	bbb
# Switching to connection 'thr1'
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
select * from testp;
id	varchar_col	char_col
1	qqq	bbb
2	ppp	bbb
delete from testp;
# test-dead lock of insert and update
insert into testp values(1,'aaa','bbb');
# Switching to connection 'thr1'.
begin;
insert into testp values(2,'aaa','bbb');
# Switching to connection 'thr2'.
begin;
update testp set varchar_col = "ppp" where id = 1;
# Switching to connection 'thr1'.
update testp set varchar_col = "xxx" where id = 1;;
# Switching to connection 'thr2'
insert into testp values(2,'aaa','bbb');
commit;
select * from testp order by id;
id	varchar_col	char_col
1	ppp	bbb
2	aaa	bbb
# Switching to connection 'thr1'
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
select * from testp order by id;
id	varchar_col	char_col
1	ppp	bbb
2	aaa	bbb
# Switching to default.
drop table testp;
