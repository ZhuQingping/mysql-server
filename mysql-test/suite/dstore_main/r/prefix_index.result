# Test Case: VARCHAR Minimum Prefix Index Test
#
# 1. Create a table with a VARCHAR(1000) column
#
CREATE TABLE t1 (
id INT PRIMARY KEY AUTO_INCREMENT,
col VARCHAR(1000)
);
#
# 2. Create an index with prefix length = 1 on the VARCHAR(1000) column
#
CREATE INDEX idx_col ON t1 (col(1));
#
# 3. Insert test data
#
INSERT INTO t1 (col) VALUES
('Apple'),
('Banana'),
('Apricot'),
('Avocado'),
('Blueberry'),
('Aardvark');
#
# 4. Verify index usage (using EXPLAIN)
#
EXPLAIN SELECT * FROM t1 WHERE col LIKE 'A%';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	range	idx_col	idx_col	7	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`col` AS `col` from `test`.`t1` where (`test`.`t1`.`col` like 'A%')
#
# 5. Verify query results
#
SELECT col FROM t1 WHERE col LIKE 'A%' ORDER BY col;
col
Aardvark
Apple
Apricot
Avocado
DROP TABLE t1;
# Test Case: Minimum Prefix Length (1-byte) Edge Case
#
# 1. Create table with minimal prefix
#
CREATE TABLE t3_min_prefix (
id INT PRIMARY KEY,
sku CHAR(5),
INDEX idx_min_prefix (sku(1))
);
#
# 2. Insert boundary data
#
INSERT INTO t3_min_prefix VALUES
(1, 'A1234'),
(2, 'A'),
(3, 'B');
ANALYZE TABLE t3_min_prefix UPDATE HISTOGRAM ON id,sku;
Table	Op	Msg_type	Msg_text
test.t3_min_prefix	histogram	status	Histogram statistics created for column 'id'.
test.t3_min_prefix	histogram	status	Histogram statistics created for column 'sku'.
ANALYZE TABLE t3_min_prefix;
Table	Op	Msg_type	Msg_text
test.t3_min_prefix	analyze	status	OK
#
# 3. Verify index usage
#
EXPLAIN SELECT * FROM t3_min_prefix WHERE sku = 'A';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t3_min_prefix	NULL	ref	idx_min_prefix	idx_min_prefix	5	const	1	100.00	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t3_min_prefix`.`id` AS `id`,`test`.`t3_min_prefix`.`sku` AS `sku` from `test`.`t3_min_prefix` where (`test`.`t3_min_prefix`.`sku` = 'A')
#
# 4. Verify query accuracy
#
SELECT sku FROM t3_min_prefix WHERE sku LIKE 'A%';
sku
A1234
A
#
# 5. Cleanup
#
DROP TABLE t3_min_prefix;
# Test Case: Prefix Index with Full Column Length
#
# 1. Create table with full-length prefix
#
CREATE TABLE t4_full_length (
code CHAR(5),
INDEX idx_full_length (code(5))
);
#
# 2. Insert exact length data
#
INSERT INTO t4_full_length VALUES 
('12345'),
('1234 ');
#
# 3. Verify index behavior
#
EXPLAIN SELECT * FROM t4_full_length WHERE code = '1234';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t4_full_length	NULL	ref	idx_full_length	idx_full_length	21	const	1	100.00	Using where; Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t4_full_length`.`code` AS `code` from `test`.`t4_full_length` where (`test`.`t4_full_length`.`code` = '1234')
#
# 4. Verify CHAR padding handling
#
SELECT HEX(code), code FROM t4_full_length;
HEX(code)	code
31323334	1234
3132333435	12345
#
# 5. Cleanup
#
DROP TABLE t4_full_length;
# Test Case: Composite Index with Prefix Component
#
# 1. Create composite index
#
CREATE TABLE t5_composite (
cust_code VARCHAR(20),
status ENUM('active','inactive'),
INDEX idx_comp (cust_code(5), status)
);
#
# 2. Insert test data
#
INSERT INTO t5_composite VALUES
('CUST001', 'active'),
('CUST002', 'inactive'),
('CUSTX', 'active');
#
# 3. Verify index coverage
#
EXPLAIN SELECT cust_code, status FROM t5_composite 
WHERE cust_code LIKE 'CUST%';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t5_composite	NULL	range	idx_comp	idx_comp	23	NULL	3	100.00	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t5_composite`.`cust_code` AS `cust_code`,`test`.`t5_composite`.`status` AS `status` from `test`.`t5_composite` where (`test`.`t5_composite`.`cust_code` like 'CUST%')
#
# 4. Cleanup
#
DROP TABLE t5_composite;
# Test Case: Zero-Length Prefix Index (Invalid)
#
# 1. Attempt to create index with prefix length 0 (should fail)
#
CREATE TABLE t1_zero_prefix (
id INT PRIMARY KEY,
data VARCHAR(10),
INDEX idx_bad_prefix (data(0))
);
ERROR HY000: Key part 'data' length cannot be 0
#
# 1. Create table with VARCHAR(5)
#
CREATE TABLE t3_long_prefix (
code VARCHAR(5),
INDEX idx_over_prefix (code(10)) -- Prefix longer than column
);
ERROR HY000: Incorrect prefix key; the used key part isn't a string, the used length is longer than the key part, or the storage engine doesn't support unique prefix keys
#
# 1. Create table with nullable column
#
CREATE TABLE t4_nullable (
id INT PRIMARY KEY,
notes VARCHAR(100) NULL,
INDEX idx_notes_prefix (notes(10))
);
#
# 2. Insert mixed NULL and non-NULL data
#
INSERT INTO t4_nullable VALUES 
(1, NULL),
(2, 'Important Note'),
(3, '');
#
# 3. Query NULL entries
#
SELECT id FROM t4_nullable WHERE notes IS NULL;
id
1
#
# 4. Verify index ignores NULLs
#
EXPLAIN SELECT * FROM t4_nullable WHERE notes LIKE 'Impo%';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t4_nullable	NULL	range	idx_notes_prefix	idx_notes_prefix	43	NULL	1	100.00	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t4_nullable`.`id` AS `id`,`test`.`t4_nullable`.`notes` AS `notes` from `test`.`t4_nullable` where (`test`.`t4_nullable`.`notes` like 'Impo%')
#
# 5. Cleanup
#
DROP TABLE t4_nullable;
#
# 1. Create table with VARBINARY(5)
#
CREATE TABLE t2_varbinary_max (
data VARBINARY(5),
INDEX idx_over_prefix (data(10))
);
ERROR HY000: Incorrect prefix key; the used key part isn't a string, the used length is longer than the key part, or the storage engine doesn't support unique prefix keys
#
# 1. Create table with UTF8MB4 charset
#
CREATE TABLE t1_mb_truncate (
id INT PRIMARY KEY,
data VARCHAR(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
INDEX idx_prefix_3chars (data(3)),  # 前3个字符（可能跨字节）
INDEX idx_prefix_5bytes (data(5))   # 前5字节（可能截断字符）
);
#
# 2. Insert multi-byte data
#
INSERT INTO t1_mb_truncate VALUES (1, '中文测试');
#
# 3. Verify 3-character prefix index
#
EXPLAIN SELECT * FROM t1_mb_truncate 
WHERE data LIKE '中%';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1_mb_truncate	NULL	range	idx_prefix_3chars,idx_prefix_5bytes	idx_prefix_3chars	15	NULL	1	100.00	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t1_mb_truncate`.`id` AS `id`,`test`.`t1_mb_truncate`.`data` AS `data` from `test`.`t1_mb_truncate` where (`test`.`t1_mb_truncate`.`data` like '中%')
#
# 4. Verify 5-byte prefix index
#
SELECT HEX(SUBSTRING(data,1,5)), data FROM t1_mb_truncate;
HEX(SUBSTRING(data,1,5))	data
E4B8ADE69687E6B58BE8AF95	中文测试
#
# 5. Cleanup
#
DROP TABLE t1_mb_truncate;
# Test Case: BUG2025042234633 Index Prefixes column in different position
