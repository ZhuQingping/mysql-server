reset master;
CREATE TABLE t1 (c1 INT, c2 VARCHAR(1000));
include/show_binlog_events.inc
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
binlog.000001	#	Previous_gtids	#	#	
binlog.000001	#	Gtid	#	#	SET @@SESSION.GTID_NEXT= 'Gtid_set'
binlog.000001	#	Query	#	#	use `test`; CREATE TABLE t1 (c1 INT, c2 VARCHAR(1000))
create procedure binlog_insert ( loop_time INT ) 
begin 
declare i int default 1; 
while i < loop_time do 
INSERT INTO t1 VALUES(1, REPEAT('a', 1000));
set i = i + 1; 
end while; 
end;|
call binlog_insert(10);
include/show_binlog_events.inc
