(4, 50, 15000, 500000, 1000000, 5000000000, 9999.99, 9.876, 5.432, b'01010101', TRUE),
(5, -50, -15000, -500000, -1000000, -5000000000, -9999.99, -9.876, -5.432, b'10101010', FALSE),
(6, 25, 16384, 4194304, 1073741824, 4611686018427387904, 5000.50, 2.5, 1.5, b'11001100', TRUE),
(7, -25, -16384, -4194304, -1073741824, -4611686018427387904, -5000.50, -2.5, -1.5, b'00110011', FALSE),
