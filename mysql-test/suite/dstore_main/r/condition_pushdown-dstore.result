drop table if exists  numeric_types, datetime_types, string_types, json_type, users;
CREATE TABLE numeric_types (
id INT AUTO_INCREMENT PRIMARY KEY,
tiny_int_col TINYINT,
small_int_col SMALLINT,
medium_int_col MEDIUMINT,
int_col INT,
big_int_col BIGINT,
decimal_col DECIMAL(10,2),
float_col FLOAT,
double_col DOUBLE,
bit_col BIT(8),
boolean_col BOOLEAN
);
