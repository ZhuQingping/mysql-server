CREATE TABLE string_types (
id INT AUTO_INCREMENT PRIMARY KEY,
char_col CHAR(10),
varchar_col VARCHAR(100),
binary_col BINARY(5),
varbinary_col VARBINARY(100),
tinytext_col TINYTEXT,
text_col TEXT,
enum_col ENUM('small', 'medium', 'large'),
set_col SET('red', 'green', 'blue', 'yellow')
);
INSERT INTO string_types VALUES
(1, 'fixed', 'Variable length string', 'abcde', 'binary data', 'Short text', 'This is a longer text field', 'small', 'red,green'),
(2, 'hello', 'MySQL data types', '12345', 'more binary', 'Tiny text', 'Lorem ipsum dolor sit amet', 'medium', 'blue'),
(3, 'world', 'Example varchar', 'ABCDE', 'data', 'Sample', 'Consectetur adipiscing elit', 'large', 'yellow'),
(4, 'test', 'Another example', '!@#$%', 'binary', 'Content', 'Sed do eiusmod tempor', 'small', 'red,blue'),
(5, 'data', 'String values', '67890', 'information', 'Info', 'Incididunt ut labore', 'medium', 'green,yellow'),
(6, 'types', 'Database table', 'XYZ12', 'storage', 'Details', 'Et dolore magna aliqua', 'large', 'red,green,blue'),
(7, 'mysql', 'Relational DB', 'QWERT', 'bytes', 'Summary', 'Ut enim ad minim veniam', 'small', 'blue,yellow'),
(8, 'sample', 'Test data', 'ASDFG', 'raw data', 'Abstract', 'Quis nostrud exercitation', 'medium', 'red'),
(9, 'string', 'Character data', 'HJKLM', 'binary info', 'Brief', 'Ullamco laboris nisi', 'large', 'green'),
(10, 'value', 'Last example', 'NOPQR', 'final data', 'Closing', 'Ut aliquip ex ea commodo', 'small', 'red,green,blue,yellow');
