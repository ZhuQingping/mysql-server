CREATE TABLE json_type (
id INT AUTO_INCREMENT PRIMARY KEY,
json_col JSON,
description VARCHAR(100)
);
INSERT INTO json_type VALUES
(1, '{"name": "John Doe", "age": 30, "email": "john@example.com", "active": true, "roles": ["admin", "user"]}', 'Basic user profile'),
(2, '{"product": "Laptop", "price": 999.99, "specs": {"cpu": "i7", "ram": "16GB", "storage": "512GB SSD"}, "in_stock": true}', 'Product information'),
(3, '{"order_id": "ORD12345", "customer": {"name": "Alice", "id": 42}, "items": [{"id": 1, "qty": 2}, {"id": 5, "qty": 1}], "total": 149.98}', 'Order details'),
(4, '{"config": {"theme": "dark", "notifications": true, "language": "en"}, "last_login": "2023-05-15T14:30:00Z"}', 'User preferences'),
(5, '{"error": {"code": 404, "message": "Not Found", "details": "The requested resource was not found"}, "timestamp": "2023-06-20T09:15:22Z"}', 'Error response'),
(6, '{"employee": {"id": 101, "name": "Bob Smith", "department": "IT", "skills": ["Java", "SQL", "JavaScript"], "projects": [1, 3, 7]}}', 'Employee record'),
(7, '{"geolocation": {"latitude": 40.7128, "longitude": -74.0060, "city": "New York", "country": "USA"}, "timezone": "America/New_York"}', 'Location data'),
(8, '{"blog_post": {"title": "MySQL JSON Features", "author": "Jane Doe", "tags": ["database", "mysql", "json"], "content": "..."}}', 'Blog post metadata'),
(9, '{"survey_results": {"question1": {"yes": 45, "no": 15}, "question2": {"optionA": 20, "optionB": 30, "optionC": 10}}, "participants": 60}', 'Survey data'),
(10, '{"system_metrics": {"cpu_usage": 32.5, "memory_usage": 45.2, "disk_space": {"total": 500, "used": 120}, "uptime": "7d 3h 22m"}}', 'System monitoring data');
