      "table_name": "t2",
      "access_type": "index",
      "estimated_rows": 1.0,
      "lookup_condition": "i=t1.i",
      "index_access_type": "index_lookup",
      "estimated_total_cost": 0.25,
      "estimated_first_row_cost": 0.25
    }
  ],
  "join_type": "semijoin",
  "operation": "Nested loop semijoin",
  "access_type": "join",
  "estimated_rows": 4.0,
