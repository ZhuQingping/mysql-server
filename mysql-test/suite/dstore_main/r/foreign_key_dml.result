DROP PROCEDURE IF EXISTS insert_10k_rows_ref_id_no_random;
CREATE PROCEDURE insert_10k_rows_ref_id_no_random(IN max_count INT)
BEGIN
DECLARE i INT DEFAULT 0;
DECLARE max_ref INT;
SELECT MAX(ref_id) INTO max_ref FROM related_table;
IF max_ref IS NULL THEN SET max_ref = 1; END IF;
SET foreign_key_checks = 0;
ALTER TABLE all_data_types DISABLE KEYS;
START TRANSACTION;
WHILE i < max_count DO
SET @rand_num = FLOOR(RAND() * 10000) + 1;
SET @rand_str = CONCAT('Str_', LEFT(UUID(), 8));
SET @rand_date = DATE_ADD('2000-01-01', INTERVAL FLOOR(RAND() * 8000) DAY);
SET @rand_time = SEC_TO_TIME(FLOOR(RAND() * 86400));
SET @ref_id = i + 1;
INSERT INTO all_data_types (
char_col,
varchar_col,
binary_col,
varbinary_col,
tinyblob_col,
blob_col,
mediumblob_col,
longblob_col,
tinytext_col,
text_col,
mediumtext_col,
longtext_col,
ref_id
) VALUES (  
LEFT(@rand_str, 10), 
@rand_str,        
UNHEX(HEX(@rand_str)), 
UNHEX(HEX(@rand_str)), 
RANDOM_BYTES(100), 
RANDOM_BYTES(1000),
RANDOM_BYTES(1000),
RANDOM_BYTES(1000),
LEFT(@rand_str, 50), 
CONCAT(@rand_str, ' ', REPEAT('Text ', 10)), 
CONCAT(@rand_str, ' ', REPEAT('MediumText ', 20)), 
CONCAT(@rand_str, ' ', REPEAT('LongText ', 50)), 
@ref_id
);
SET i = i + 1;
END WHILE;
COMMIT;
ALTER TABLE all_data_types ENABLE KEYS;
SET foreign_key_checks = 1;
OPTIMIZE TABLE all_data_types;
END$
CALL insert_10k_rows_ref_id_no_random(200);
