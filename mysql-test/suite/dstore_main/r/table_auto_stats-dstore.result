#
# When table was droped, the element will be removed from delay recalculate pool
#
CREATE TABLE t1(a INT, INDEX(a))ENGINE=Dstore;
SET debug='+d,dstore_recalc_pool_del_print';
INSERT INTO t1 VALUES(1),(2),(3),(4);
SELECT TABLE_NAME, COLUMN_NAME, JSON_EXTRACT(HISTOGRAM, '$.buckets') FROM information_schema.COLUMN_STATISTICS WHERE TABLE_NAME IN ('t1');
TABLE_NAME	COLUMN_NAME	JSON_EXTRACT(HISTOGRAM, '$.buckets')
t1	a	[[1, 0.25], [2, 0.5], [3, 0.75], [4, 1.0]]
EXPLAIN SELECT * FROM t1 WHERE a=2;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ref	a	a	5	const	1	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a` from `test`.`t1` where (`test`.`t1`.`a` = 2)
INSERT INTO t1 VALUES(5),(6),(7),(8);
DROP TABLE t1;
Pattern "Remove table from backend auto update delay recalculate pool, table name: ./test/t1" found
SET debug='-d,dstore_recalc_pool_del_print';
#
# Verify adaptive auto stats recalc interval branches with debug forcing.
#
CREATE TABLE t_stats_interval (
id INT PRIMARY KEY
) STATS_PERSISTENT=1 STATS_AUTO_RECALC=1;
INSERT INTO t_stats_interval
WITH RECURSIVE seq AS (
SELECT 1 AS n
UNION ALL
SELECT n + 1 FROM seq WHERE n < 200
)
SELECT n FROM seq;
ANALYZE TABLE t_stats_interval UPDATE HISTOGRAM ON id;
Table	Op	Msg_type	Msg_text
test.t_stats_interval	histogram	status	Histogram statistics created for column 'id'.
ANALYZE TABLE t_stats_interval;
Table	Op	Msg_type	Msg_text
test.t_stats_interval	analyze	status	OK
SET @old_ts= (
SELECT UNIX_TIMESTAMP(last_update)
FROM mysql.dstore_table_stats
WHERE database_name= DATABASE() AND table_name= 't_stats_interval'
);
# Force high CPU branch and shorter test intervals (fast=1s, slow=3s).
SET @save_debug= @@GLOBAL.debug;
SET GLOBAL debug=
'+d,dstore_auto_stats_interval_test_short,dstore_auto_stats_interval_force_high_cpu';
INSERT INTO t_stats_interval
WITH RECURSIVE seq AS (
SELECT 1001 AS n
UNION ALL
SELECT n + 1 FROM seq WHERE n < 1040
)
SELECT n FROM seq;
SELECT SLEEP(1);
SLEEP(1)
0
SET @new_ts = (
SELECT UNIX_TIMESTAMP(last_update)
FROM mysql.dstore_table_stats
WHERE database_name= DATABASE() AND table_name= 't_stats_interval'
);
SELECT @new_ts > @old_ts AS high_branch_not_too_early;
high_branch_not_too_early
0
SELECT SLEEP(10);
SLEEP(10)
0
SET @new_ts= (
SELECT UNIX_TIMESTAMP(last_update)
FROM mysql.dstore_table_stats
WHERE database_name= DATABASE() AND table_name= 't_stats_interval'
);
SELECT @new_ts > @old_ts AS high_branch_eventually_updates;
high_branch_eventually_updates
1
# Force low CPU branch and shorter test intervals (fast=1s).
SET @old_ts= @new_ts;
SET GLOBAL debug=
'+d,dstore_auto_stats_interval_test_short,dstore_auto_stats_interval_force_low_cpu';
INSERT INTO t_stats_interval
WITH RECURSIVE seq AS (
SELECT 2001 AS n
UNION ALL
SELECT n + 1 FROM seq WHERE n < 2040
)
SELECT n FROM seq;
SELECT SLEEP(11);
SLEEP(11)
0
SET @new_ts= (
SELECT UNIX_TIMESTAMP(last_update)
FROM mysql.dstore_table_stats
WHERE database_name= DATABASE() AND table_name= 't_stats_interval'
);
SELECT @new_ts > @old_ts AS low_branch_updates_fast;
low_branch_updates_fast
1
SET GLOBAL debug= @save_debug;
DROP TABLE t_stats_interval;
