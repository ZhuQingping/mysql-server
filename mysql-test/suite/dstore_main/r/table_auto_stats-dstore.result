SET GLOBAL dstore_stats_persistent = ON;
SET GLOBAL dstore_stats_auto_recalc = ON;
SET SESSION cte_max_recursion_depth = 10000;
CREATE TABLE t (id INT) ENGINE=Dstore;
# Initial statistics (should show 0 row)
ANALYZE TABLE t;
Table	Op	Msg_type	Msg_text
test.t	analyze	status	OK
explain select * from t;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	ALL	NULL	NULL	NULL	NULL	1	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t`
BEGIN;
# Inserting 30,000 rows (batch insert)
INSERT INTO t (id)
WITH RECURSIVE nums (n) AS (
SELECT 1
UNION ALL
SELECT n + 1 FROM nums WHERE n < 10000
)
SELECT n FROM nums;
INSERT INTO t (id)
WITH RECURSIVE nums (n) AS (
SELECT 1
UNION ALL
SELECT n + 1 FROM nums WHERE n < 10000
)
SELECT n FROM nums;
INSERT INTO t (id)
WITH RECURSIVE nums (n) AS (
SELECT 1
UNION ALL
SELECT n + 1 FROM nums WHERE n < 10000
)
SELECT n FROM nums;
# Statistics during transaction (should show 30000 row), because have not recalc
SELECT SLEEP(1);
SLEEP(1)
0
explain select * from t;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	ALL	NULL	NULL	NULL	NULL	30000	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t`
# Commit transaction
COMMIT;
explain select * from t;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	ALL	NULL	NULL	NULL	NULL	30000	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t`
# Wait for background stats recalculation (persistent mode)
SELECT SLEEP(11);
SLEEP(11)
0
# Statistics after background update (should show != 30,000 rows)
explain select * from t;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	ALL	NULL	NULL	NULL	NULL	X	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t`
DROP TABLE t;
