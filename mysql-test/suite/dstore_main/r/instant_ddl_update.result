##############################################
# Test instant ADD/DROP COLUMN for REDUNDANT format
##############################################
CREATE TABLE t1 (c1 char(20), c2 char(20)) ROW_FORMAT=REDUNDANT;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
INSERT INTO t1 values ("row1_c1", "row1_c2");
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `c1` char(20) DEFAULT NULL,
  `c2` char(20) DEFAULT NULL
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=REDUNDANT
# ------------------------------------------------------------
# ADD AN INSTANT COLUMN At the end [c1, c2, +c3]
# ------------------------------------------------------------
ALTER TABLE t1 ADD COLUMN c3 char(20) default "c3_def", ALGORITHM=INSTANT;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
SELECT * FROM t1 ORDER BY c1;
c1	c2	c3
row1_c1	row1_c2	c3_def
INSERT INTO t1 values ("row2_c1", "row2_c2", "row2_c3");
SELECT * FROM t1 ORDER BY c1;
c1	c2	c3
row1_c1	row1_c2	c3_def
row2_c1	row2_c2	row2_c3
# INPLACE UPDATE
UPDATE t1 SET c1="r1_c1" where c1="row1_c1";
SELECT * FROM t1 ORDER BY c1;
c1	c2	c3
r1_c1	row1_c2	c3_def
row2_c1	row2_c2	row2_c3
# NOT INPLACE UPDATE
UPDATE t1 SET c3="row1_c3" where c1="r1_c1";
SELECT * FROM t1 ORDER BY c1;
c1	c2	c3
r1_c1	row1_c2	row1_c3
row2_c1	row2_c2	row2_c3
# ------------------------------------------------------------
# DROP A COLUMN at the end [c1, c2, -c3]
# ------------------------------------------------------------
ALTER TABLE t1 DROP COLUMN c3, ALGORITHM=INSTANT;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
SELECT * FROM t1 ORDER BY c1;
c1	c2
r1_c1	row1_c2
row2_c1	row2_c2
INSERT INTO t1 values ("row3_c1", "row3_c2");
SELECT * FROM t1 ORDER BY c1;
c1	c2
r1_c1	row1_c2
row2_c1	row2_c2
row3_c1	row3_c2
# INPLACE UPDATE
UPDATE t1 SET c1="r3_c1" where c1="row3_c1";
SELECT * FROM t1 ORDER BY c1;
c1	c2
r1_c1	row1_c2
r3_c1	row3_c2
row2_c1	row2_c2
# NOT INPLACE UPDATE
UPDATE t1 SET c2="r1_c2" where c1="r1_c1";
SELECT * FROM t1 ORDER BY c1;
c1	c2
r1_c1	r1_c2
r3_c1	row3_c2
row2_c1	row2_c2
# ------------------------------------------------------------
# Rebuild table [c1, c4]
# ------------------------------------------------------------
ALTER TABLE t1 FORCE;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
SELECT * FROM t1 ORDER BY c1;
c1	c2
r1_c1	r1_c2
r3_c1	row3_c2
row2_c1	row2_c2
INSERT INTO t1 values ("row4_c1", "row4_c2");
SELECT * FROM t1 ORDER BY c1;
c1	c2
r1_c1	r1_c2
r3_c1	row3_c2
row2_c1	row2_c2
row4_c1	row4_c2
###########
# CLEANUP #
###########
DROP TABLE t1;
