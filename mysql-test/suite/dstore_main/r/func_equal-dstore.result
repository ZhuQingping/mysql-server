10:59:59.000000	2001-02-01 00:00:00.000000	2001-03-02 00:00:00.000000	1
EXPLAIN SELECT A.time_col as c1, A.datetime_col as c4, B.time_col as c4, B.datetime_col as c4 FROM ta A LEFT JOIN tb B ON B.time_col IS NOT UNKNOWN
WHERE A.datetime_col IN ('2012-11-09 00:00:00.000000','2001-04-06 00:00:00.000000') XOR B.time_col NOT BETWEEN '02:59:59.000000' AND B.datetime_col
GROUP BY 1,2,3,4
HAVING (A.time_col, A.datetime_col) <=> (SELECT time_col, datetime_col FROM tc D WHERE A.time_col > D.time_col OR B.datetime_col > D.datetime_col ORDER BY 1  LIMIT 1 OFFSET 5)
ORDER BY 1,2,3,4 LIMIT 10;
