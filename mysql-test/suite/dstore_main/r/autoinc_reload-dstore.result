#
# Keep the autoinc value after instant/inplace ddl
#
CREATE TABLE t1 (
id INT PRIMARY KEY AUTO_INCREMENT,
year_col YEAR DEFAULT NULL
) ENGINE=DSTORE;
INSERT INTO t1(year_col) VALUES(1998);
ALTER TABLE t1 AUTO_INCREMENT = 1000;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL AUTO_INCREMENT,
  `year_col` year DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=Dstore AUTO_INCREMENT=1000 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
ALTER TABLE t1 RENAME COLUMN id TO mid, ALGORITHM = COPY;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `mid` int NOT NULL AUTO_INCREMENT,
  `year_col` year DEFAULT NULL,
  PRIMARY KEY (`mid`)
) ENGINE=Dstore AUTO_INCREMENT=1000 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
ALTER TABLE t1 RENAME COLUMN mid TO inc_id, ALGORITHM = INPLACE;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `inc_id` int NOT NULL AUTO_INCREMENT,
  `year_col` year DEFAULT NULL,
  PRIMARY KEY (`inc_id`)
) ENGINE=Dstore AUTO_INCREMENT=1000 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
