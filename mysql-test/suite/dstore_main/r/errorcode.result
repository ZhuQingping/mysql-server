#
# error code test for foreign key constraint
#
CREATE TABLE t_errcode_10 (
c1 INT AUTO_INCREMENT PRIMARY KEY
);
CREATE TABLE t_errcode_11 (
id INT AUTO_INCREMENT PRIMARY KEY,
fk_id INT,
FOREIGN KEY (fk_id) 
REFERENCES t_errcode_10(c1) 
ON DELETE CASCADE 
ON UPDATE CASCADE
);
