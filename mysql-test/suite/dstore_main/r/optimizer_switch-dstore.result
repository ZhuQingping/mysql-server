CREATE VIEW `v88` (
`c0`, 
`c1`, 
`c2`, 
`c3`, 
`c4`
)
AS
SELECT -295423420 AS `-295423420`, '' AS `Name_exp_2`
	, CASE NOT 0.03591938718271759 LIKE `t1`.`c4`
		AND 0 <> rtrim(acos(762791604 LIKE `t1`.`c1`))
