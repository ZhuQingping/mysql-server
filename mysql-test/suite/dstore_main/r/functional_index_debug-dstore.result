1	SIMPLE	t1	NULL	ref	idx1	idx1	47	const	1	100.00	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`col1` AS `col1` from `test`.`t1` where (soundex(`col1`) = 'aa')
DROP TABLE t1;
