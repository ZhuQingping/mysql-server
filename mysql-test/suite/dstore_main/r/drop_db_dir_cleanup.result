# ========================================================
# Scenario 1: Empty directory - should succeed
# ========================================================
# Create database
CREATE DATABASE test_scenario1;
# Drop database (directory should be empty after this)
DROP DATABASE test_scenario1;
# Verify database is dropped
include/assert.inc [Database test_scenario1 should not exist after DROP]
# Recreate empty directory manually
# Drop database again with empty directory - should succeed
DROP DATABASE test_scenario1;
# Verify directory is removed
include/assert.inc [Database test_scenario1 should not exist after dropping empty directory]
# ========================================================
# Scenario 2: Non-empty directory - should fail
# ========================================================
# Recreate directory manually
# Create a file in the directory
# Try to drop database with non-empty directory - should fail
DROP DATABASE test_scenario2;
ERROR HY000: Schema 'test_scenario2' does not exist, but schema directory './test_scenario2/' was found. This must be resolved manually (e.g. by moving the schema directory to another location).
# Cleanup: remove the extra file and directory
# ========================================================
# Cleanup
# ========================================================
DROP DATABASE IF EXISTS test_scenario1;
Warnings:
Note	1008	Can't drop database 'test_scenario1'; database doesn't exist
DROP DATABASE IF EXISTS test_scenario2;
Warnings:
Note	1008	Can't drop database 'test_scenario2'; database doesn't exist
