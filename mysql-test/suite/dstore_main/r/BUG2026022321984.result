#
# Test-12:
# CHANGE COLUMN reorders indexed varchar, key length under threshold(910)
# with no explicit ALGORITHM;
# Expect no rebuild.
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
a VARCHAR(5),
c1 VARCHAR(10),
KEY idx_12(c1)
) ENGINE=dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
ALTER TABLE t1 CHANGE COLUMN c1 c1 VARCHAR(12) FIRST;
# Expect DROP_SEGMENT_LOG not found(no rebuild)
Pattern "Replay DDL log success.*Type:DROP_SEGMENT_LOG" found 3 times
SELECT COLUMN_NAME, CHARACTER_MAXIMUM_LENGTH
FROM information_schema.COLUMNS
WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='t1'
  ORDER BY COLUMN_NAME;
COLUMN_NAME	CHARACTER_MAXIMUM_LENGTH
a	5
c1	12
id	NULL
DROP TABLE t1;
