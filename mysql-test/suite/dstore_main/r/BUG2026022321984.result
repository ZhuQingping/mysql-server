# 
# Test-1:
# Indexed varchar size growed but length under the threshold(910)
# with no explicit ALGORITHM;
# Expect no rebuild.
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
c1 VARCHAR(200),
KEY idx_1(c1)
) ENGINE=dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
ALTER TABLE t1 MODIFY COLUMN c1 VARCHAR(201);
# Expect DROP_SEGMENT_LOG not found(no rebuild)
Pattern "Replay DDL log success.*Type:DROP_SEGMENT_LOG" not found
SELECT COLUMN_NAME, CHARACTER_MAXIMUM_LENGTH
FROM information_schema.COLUMNS
WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='t1'
  ORDER BY COLUMN_NAME;
COLUMN_NAME	CHARACTER_MAXIMUM_LENGTH
c1	201
id	NULL
DROP TABLE t1;
#
# Test-2:
# Indexed virtual varchar size growed but length under the threshold(910)
# with no explicit ALGORITHM;
# Expect no rebuild.
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
c1 VARCHAR(200),
vc1 VARCHAR(200) GENERATED ALWAYS AS (c1) VIRTUAL,
KEY vidx_1(vc1)
) ENGINE=dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
ALTER TABLE t1 MODIFY COLUMN vc1 VARCHAR(201) GENERATED ALWAYS AS (c1) VIRTUAL;
# Expect DROP_SEGMENT_LOG not found(no rebuild)
Pattern "Replay DDL log success.*Type:DROP_SEGMENT_LOG" not found
SELECT COLUMN_NAME, CHARACTER_MAXIMUM_LENGTH
FROM information_schema.COLUMNS
WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='t1'
  ORDER BY COLUMN_NAME;
COLUMN_NAME	CHARACTER_MAXIMUM_LENGTH
c1	200
id	NULL
vc1	201
DROP TABLE t1;
