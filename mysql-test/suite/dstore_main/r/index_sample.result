create table t3(a int, b char(10));
create index index_t3 on t3(a);
CREATE PROCEDURE Insert40KRows()
BEGIN
DECLARE i INT DEFAULT 1;
START TRANSACTION;
WHILE i <= 40000 DO
INSERT INTO t3 (a, b) VALUES (1, 'a');
SET i = i + 1;
END WHILE;
COMMIT;
END$$
CALL Insert40KRows();
DROP PROCEDURE Insert40KRows;
analyze table t3;
Table	Op	Msg_type	Msg_text
test.t3	analyze	status	OK
select cardinality from information_schema.statistics where table_schema = 'test' and table_name = 't3';
CARDINALITY
1
select stat_value from mysql.dstore_index_stats where database_name = 'test' and table_name = 't3' and stat_name = 'n_diff_pfx01';
stat_value
1
CREATE PROCEDURE Insert40KRows()
BEGIN
DECLARE i INT DEFAULT 1;
START TRANSACTION;
WHILE i <= 40000 DO
INSERT INTO t3 (a, b) VALUES (2, 'a');
SET i = i + 1;
END WHILE;
COMMIT;
END$$
CALL Insert40KRows();
DROP PROCEDURE Insert40KRows;
