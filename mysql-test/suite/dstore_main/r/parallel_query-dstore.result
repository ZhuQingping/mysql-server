# 
# pq do not support dstore table.
# 
set force_parallel_execute=on;
set parallel_cost_threshold=0;
set parallel_rows_threshold=0;
set parallel_tuple_cost=0;
set parallel_setup_cost=0;
set optimizer_trace="enabled=on";
create table t1(a int, b int)engine=dstore;
insert into t1 values(1,1),(2,2),(3,3);
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int DEFAULT NULL,
  `b` int DEFAULT NULL
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
explain select * from t1 where a > 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	3	33.33	Using where; Using pushed condition (`test`.`t1`.`a` > 1)
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a`,`test`.`t1`.`b` AS `b` from `test`.`t1` where (`test`.`t1`.`a` > 1)
select * from t1 where a > 1;
a	b
2	2
3	3
SELECT query, json_extract(trace,"$.steps[*].not_apply_pq_plan") FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE;
query	json_extract(trace,"$.steps[*].not_apply_pq_plan")
select * from t1 where a > 1	[{"chosen": false, "reason": "Disable PQ if access table is not InnoDB", "select#": 1}]
drop table t1;
set force_parallel_execute=default;
set parallel_cost_threshold=default;
set parallel_rows_threshold=default;
set parallel_tuple_cost=default;
set parallel_setup_cost=default;
set optimizer_trace="enabled=off";
