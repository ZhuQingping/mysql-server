# Final cleanup and summary
# Drop remaining objects for complete cleanup
DROP USER 'newuser_crash'@'localhost';
DROP ROLE 'role_crash';
# Summary: All DDL crash recovery tests completed successfully
# Each DDL was tested at 3 crash points with proper recovery verification
# - Before InnoDB prepare: DDL should be rolled back
# - After InnoDB prepare but before DStore commit: DDL should be rolled back
# - After DStore commit: DDL should be committed and visible
SET debug='reset';
DROP DATABASE test_ddl_crash_comprehensive;
