0
#  31.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
GRANT SELECT ON test_ddl_crash_comprehensive.* TO 'role_crash';
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify grant should exist
SELECT COUNT(*) AS grant_count FROM mysql.db WHERE User='role_crash' AND Db='test_ddl_crash_comprehensive';
grant_count
1
