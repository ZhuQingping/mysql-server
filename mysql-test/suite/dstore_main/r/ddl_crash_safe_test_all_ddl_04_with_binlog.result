#  35. Crash on RENAME USER statement.
#  35.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
RENAME USER 'testuser_crash'@'localhost' TO 'newuser_crash'@'localhost';
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify old user name should still exist
SELECT COUNT(*) AS old_user_count FROM mysql.user WHERE USER='testuser_crash';
old_user_count
1
SELECT COUNT(*) AS new_user_count FROM mysql.user WHERE USER='newuser_crash';
new_user_count
0
