#
#  DDL CRASH SAFE TEST: ALL DDL TEST PART 04
#  This test will check whether the server can recovery from different
#  phases of ALL DDLs without inconsistency between dstore and
#  innodb. Each DDL will be tested at 3 crash points and recovery
#  results will be verified.
#
CREATE DATABASE test_ddl_crash_comprehensive;
USE test_ddl_crash_comprehensive;
CREATE USER 'testuser_crash'@'localhost' IDENTIFIED BY 'password';
#  30. Crash on CREATE ROLE statement.
#  30.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
CREATE ROLE 'role_crash';
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify role should not exist
SELECT COUNT(*) AS role_count FROM mysql.user WHERE USER='role_crash';
role_count
0
#  30.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
CREATE ROLE 'role_crash';
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify role should not exist
SELECT COUNT(*) AS role_count FROM mysql.user WHERE USER='role_crash';
role_count
0
#  30.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
CREATE ROLE 'role_crash';
ERROR HY000: Lost connection to MySQL server during query
# restart
USE test_ddl_crash_comprehensive;
# Verify role should exist
SELECT COUNT(*) AS role_count FROM mysql.user WHERE USER='role_crash';
role_count
1
SELECT USER FROM mysql.user WHERE USER='role_crash';
USER
role_crash
