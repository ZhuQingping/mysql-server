--source include/have_only_dstore.inc
CREATE TABLE t1(a INT,  b INT, INDEX(b));
INSERT INTO t1 VALUES (1,2),(2,3),(3,3),(4,3);

CREATE TABLE t2(a INT,  b INT, INDEX(a,b));
INSERT INTO t2 VALUES (1,2),(2,3),(3,3),(4,3);

ANALYZE TABLE t1 UPDATE HISTOGRAM ON b;
ANALYZE TABLE t2 UPDATE HISTOGRAM ON a,b;
ANALYZE TABLE t1, t2;

--echo #
--echo # Test that redundant condition in not removed when we disable redundant condition removal
--echo #
set rds_empty_redundant_check_in_range_scan=false;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT b FROM t1 WHERE b > 2;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT a, b FROM t2 WHERE a = 2 AND b < 2;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT a, b FROM t2 WHERE 2 = a AND b < 2;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT a, b FROM t2 WHERE a = 2 AND 2 < b;

--echo # between with condition
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN 2 and 3;
--echo # BETWEEN and type conversion
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "b" AND 5;
SELECT * FROM t2 WHERE a BETWEEN "b" AND 5;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND "5";
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND 5;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN 2 AND "5";
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2.0" AND "5";
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND "5.0";

--echo #
--echo # Now enable redundant condition removal
--echo #
set rds_empty_redundant_check_in_range_scan=true;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT b FROM t1 WHERE b > 2;
--echo # works whether b OP cond or cond OP b
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT a, b FROM t2 WHERE a = 2 AND b < 2;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT a, b FROM t2 WHERE 2 = a AND b < 2;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT a, b FROM t2 WHERE a = 2 AND 2 < b;

--echo # Empty IS NULL in WHERE clause
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree  SELECT * FROM  t2 WHERE a IS NULL AND b > 5;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree  SELECT * FROM  t2 WHERE a IS NULL AND b > 5 LIMIT 100 OFFSET 1;

--echo # between condition removal
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN 2 and 3;
--echo # BETWEEN and type conversion
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "b" AND 5;
SELECT * FROM t2 WHERE a BETWEEN "b" AND 5;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND "5";
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND 5;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN 2 AND "5";
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2.0" AND "5";
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND "5.0";

--echo # Empty IS NULL in WHERE clause
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree  SELECT * FROM  t2 WHERE a IS NULL AND b > 5;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree  SELECT * FROM  t2 WHERE a IS NULL AND b > 5 LIMIT 100 OFFSET 1;

DROP TABLE t1, t2;

--echo # Empty redundant condition in index range scan: check different data types
--echo # redundant check removal  extended to real numbers (DOUBLE)
CREATE TABLE t(a DOUBLE, b DOUBLE, c DOUBLE , INDEX(a,b,c));
INSERT INTO t VALUES (1,2,6), (2,3,7), (3,3,8), (4,3,12);
ANALYZE TABLE t UPDATE HISTOGRAM ON a,b,c;
analyze TABLE t;
SET rds_empty_redundant_check_in_range_scan = false;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t WHERE a > 2;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t WHERE a = 2 AND b < 5 AND b > 1;
SET rds_empty_redundant_check_in_range_scan = true;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t WHERE a > 2;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t WHERE a = 2 AND b < 5 AND b > 1;
DROP TABLE t;

--echo # redundant check removal extended to DECIMAL
CREATE TABLE t(a DECIMAL, b DECIMAL, c DECIMAL , INDEX(a,b,c));
INSERT INTO t VALUES (1,2,6), (2,3,7), (3,3,8), (4,3,12);
ANALYZE TABLE t UPDATE HISTOGRAM ON a,b,c;
analyze TABLE t;
SET rds_empty_redundant_check_in_range_scan = false;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t WHERE a > 2;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t WHERE a = 2 AND b < 5 AND b > 1;
SET rds_empty_redundant_check_in_range_scan = true;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t WHERE a > 2;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree SELECT * FROM t WHERE a = 2 AND b < 5 AND b > 1;
DROP TABLE t;

--echo # redundant check removal extended to String
CREATE TABLE people(zipcode CHAR(10),lastname CHAR(10), firstname CHAR(10),address CHAR(10), INDEX (zipcode, lastname, firstname));
ANALYZE TABLE people UPDATE HISTOGRAM ON zipcode,lastname,firstname;
analyze TABLE people;
SET rds_empty_redundant_check_in_range_scan = false;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree  SELECT * FROM people WHERE zipcode > '95054';
SET rds_empty_redundant_check_in_range_scan = true;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree  SELECT * FROM people WHERE zipcode > '95054';
DROP TABLE people;

--echo # Test skip scan 
CREATE TABLE t1 (f1 INT NOT NULL, f2 INT NOT NULL, PRIMARY KEY(f1, f2));
INSERT INTO t1 VALUES
  (1,1), (1,2), (1,3), (1,4), (1,5),
  (2,1), (2,2), (2,3), (2,4), (2,5);
INSERT INTO t1 SELECT f1, f2 + 5 FROM t1;
INSERT INTO t1 SELECT f1, f2 + 10 FROM t1;
INSERT INTO t1 SELECT f1, f2 + 20 FROM t1;
INSERT INTO t1 SELECT f1, f2 + 40 FROM t1;
ANALYZE TABLE t1 UPDATE HISTOGRAM ON f1,f2;
ANALYZE TABLE t1;
SET rds_empty_redundant_check_in_range_scan = false;
EXPLAIN format=tree SELECT f1, f2 FROM t1 WHERE f2 > 40;
SET rds_empty_redundant_check_in_range_scan = true;
EXPLAIN format=tree SELECT f1, f2 FROM t1 WHERE f2 > 40;
DROP TABLE t1;

CREATE TABLE jemp (
     c JSON,
    g INT GENERATED ALWAYS AS (c->"$.id"),
    INDEX i (g)
 );
INSERT INTO jemp (c) VALUES
        ('{"id": "1", "name": "Fred"}'), ('{"id": "2", "name": "Wilma"}'),
        ('{"id": "3", "name": "Barney"}'), ('{"id": "4", "name": "Betty"}');
ANALYZE TABLE jemp UPDATE HISTOGRAM ON g;
analyze TABLE jemp;

--echo # without optimization
SET rds_empty_redundant_check_in_range_scan = false;
 SELECT c->>"$.name" AS name
    FROM jemp WHERE g > 2;
 EXPLAIN SELECT c->>"$.name" AS name
   FROM jemp WHERE g > 2;
--echo # with optimization 
SET rds_empty_redundant_check_in_range_scan = true;
 SELECT c->>"$.name" AS name
    FROM jemp WHERE g > 2;
 EXPLAIN SELECT c->>"$.name" AS name
   FROM jemp WHERE g > 2;
DROP TABLE jemp;


--echo # INCONSISTENT RESULTS FOR SELECTS FROM TABLE WITH CHAR(N) COLUMN
--echo # AND NO_PAD COLLATION from ctype_uca.test,
--echo # verify that an inequality condition is kept at SQL layer:
CREATE TABLE t1 (
    f1 CHAR(20) COLLATE utf8mb4_0900_ai_ci  # A NO PAD collation.
);
INSERT INTO t1 VALUES ('ABC  ');
INSERT INTO t1 VALUES ('XYZ');
INSERT INTO t1 VALUES ('XYZ ');
INSERT INTO t1 VALUES ('ABC ');

CREATE INDEX f1_index ON t1 ( f1 );
ANALYZE TABLE t1 UPDATE HISTOGRAM ON f1;
analyze table t1;

set rds_empty_redundant_check_in_range_scan = on;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree  SELECT CONCAT(f1, '|') FROM t1 WHERE f1 >= 'XYZ ';

--echo # Now, a PAD SPACE collation, condition is not kept

ALTER TABLE t1 modify f1 CHAR(20) COLLATE utf8mb4_unicode_ci;
analyze TABLE t1;
--replace_regex /cost=\d+.\d+/cost=***/  /rows=\d+/rows=***/
explain format=tree  SELECT CONCAT(f1, '|') FROM t1 WHERE f1 >= 'XYZ ';

SET rds_empty_redundant_check_in_range_scan=default;
DROP TABLE t1;

