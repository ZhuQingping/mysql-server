--echo #
--echo # Test tpcc Q34 (simulated) (FE2025041500028)
--echo #

CREATE TABLE bmsql_stock (
s_w_id INT NOT NULL,
s_i_id int NOT NULL,
s_quantity SMALLINT,
PRIMARY KEY(s_w_id, s_i_id)
);
INSERT INTO bmsql_stock VALUES (316, 5, 10),(316, 9, 10),(317, 12, 351), (316, 1, 9999);
ANALYZE TABLE bmsql_stock UPDATE HISTOGRAM ON s_w_id, s_i_id;
ANALYZE TABLE bmsql_stock;

CREATE TABLE bmsql_order_line (
ol_w_id INT NOT NULL,
ol_d_id TINYINT NOT NULL,
ol_o_id INT NOT NULL,
ol_i_id INT,
ol_number TINYINT NOT NULL,
PRIMARY KEY(ol_w_id , ol_d_id , ol_o_id , ol_number)
);
INSERT INTO bmsql_order_line VALUES (316, 7, 90, 5, 34);
ANALYZE TABLE bmsql_order_line UPDATE HISTOGRAM ON ol_w_id,ol_d_id,ol_o_id,ol_number;
ANALYZE TABLE bmsql_order_line;

CREATE TABLE bmsql_district (
d_w_id INT NOT NULL,
d_id TINYINT NOT NULL,
d_next_o_id INT,
PRIMARY KEY (d_w_id , d_id)
);
INSERT INTO bmsql_district VALUES (316, 7, 100);
ANALYZE TABLE bmsql_district UPDATE HISTOGRAM ON d_w_id,d_id;
ANALYZE TABLE bmsql_district;

--echo # first no condition removal
set rds_empty_redundant_check_in_range_scan=false;
EXPLAIN format=tree SELECT count(*) AS low_stock FROM ( 
    SELECT s_w_id, s_i_id, s_quantity FROM
     bmsql_stock WHERE s_w_id = 316 AND s_quantity < 10 AND
      s_i_id IN ( SELECT ol_i_id FROM 
      bmsql_district JOIN bmsql_order_line ON ol_w_id = d_w_id AND
       ol_d_id = d_id AND ol_o_id >= d_next_o_id - 20 AND
        ol_o_id < d_next_o_id WHERE d_w_id = 316 AND d_id = 7 ) ) AS L ;

--echo # with condition removal
set rds_empty_redundant_check_in_range_scan=true;
EXPLAIN format=tree SELECT count(*) AS low_stock FROM ( 
    SELECT s_w_id, s_i_id, s_quantity FROM
     bmsql_stock WHERE s_w_id = 316 AND s_quantity < 10 AND
      s_i_id IN ( SELECT ol_i_id FROM 
      bmsql_district JOIN bmsql_order_line ON ol_w_id = d_w_id AND
       ol_d_id = d_id AND ol_o_id >= d_next_o_id - 20 AND
        ol_o_id < d_next_o_id WHERE d_w_id = 316 AND d_id = 7 ) ) AS L ;

DROP TABLE bmsql_district, bmsql_order_line, bmsql_stock;

--echo #
--echo # BUG2026030947301 Incorrect result issue caused by the rds_empty_redundant_check_in_range_scan feature.
--echo #
CREATE TABLE `t1` (
  `c1` tinyint DEFAULT NULL,
  `c2` char(4) DEFAULT NULL
);

CREATE TABLE `t2` (
  `c1` tinyint DEFAULT NULL,
  `c2` char(4) DEFAULT NULL,
  KEY `c1` (`c1`)
);

INSERT INTO t1 VALUES(   1, 'aaaa');
INSERT INTO t1 VALUES(   1, 'aabb');
INSERT INTO t1 VALUES(   1, 'aacd');
INSERT INTO t1 VALUES(   0, 'aaa2');
INSERT INTO t1 VALUES(   0, 'ab');
INSERT INTO t1 VALUES(   0, NULL);
INSERT INTO t1 VALUES(   1, NULL);
INSERT INTO t1 VALUES(   2, NULL);
INSERT INTO t1 VALUES(NULL, NULL);

INSERT INTO t2 VALUES(   1, 'aaaa');
INSERT INTO t2 VALUES(   1, 'aabb');
INSERT INTO t2 VALUES(   1, 'aacd');
INSERT INTO t2 VALUES(   0, 'aaa2');
INSERT INTO t2 VALUES(   0, 'ab');
INSERT INTO t2 VALUES(   1, NULL);
INSERT INTO t2 VALUES(   0, NULL);
INSERT INTO t2 VALUES(   2, NULL);
INSERT INTO t2 VALUES(NULL, NULL);

ANALYZE TABLE t1,t2;

SET rds_empty_redundant_check_in_range_scan=ON;

SELECT t1.c2, t2.c2
FROM 
    t1, t2
WHERE t1.c1 <= t1.c1
    AND t2.c1 IN (false, 0)
    AND t2.c1 BETWEEN 'true' AND t2.c2
GROUP BY 1, 2
ORDER BY 1, 2;

SET rds_empty_redundant_check_in_range_scan=OFF;

SELECT t1.c2, t2.c2
FROM 
    t1, t2
WHERE t1.c1 <= t1.c1
    AND t2.c1 IN (false, 0)
    AND t2.c1 BETWEEN 'true' AND t2.c2
GROUP BY 1, 2
ORDER BY 1, 2;

DROP TABLE t1,t2;
