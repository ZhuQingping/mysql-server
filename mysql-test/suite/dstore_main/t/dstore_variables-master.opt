--dstore_buffer=2048
--dstore_buffer_lru_partition=128
--dstore_log_min_messages=PANIC
--dstore_perf_level=OFF
--dstore_fold_period=30
--dstore_fold_level=PANIC
--dstore_lock_table_partition_num=512
--dstore_enable_lazy_lock=ON
--dstore_vfs_tenant_isolation_config_path=""
--dstore_num_obj_space_mgr_workers=2
--dstore_prob_of_extension_threshold=1
--dstore_wal_level=MINIMAL
--dstore_recovery_worker_num=2
--dstore_synchronous_commit=OFF
--dstore_wal_flush_timeout=3
--dstore_wal_read_buffer_size=268435456
--dstore_wal_redo_buffer_size=536870912
--dstore_wal_writer_cpu_bind=-1
--dstore_wal_keep_segments=32
--dstore_bg_wal_writer_min_bytes=102400
--dstore_wal_each_write_lenghth_limit=1044480
--dstore_disable_btree_page_recycle=ON
--dstore_deadlock_time_interval=30000
--dstore_enable_out_of_line_lob=OFF
--dstore_bg_disk_writer_slave_num=2
--dstore_bg_page_writer_sleep_millisecond=4000
--dstore_wal_throttling_size=163840
--dstore_max_io_capacity_kb=30720
--dstore_bulk_read_ring_size=1024
--dstore_bulk_write_ring_size=32768
--dstore_wal_archive_interval=120
--dstore_keep_wal_stream_not_change=false
--dstore_local_backup_retry_num=4
--dstore_lock_hash_table_size=128
--dstore_ncores=10000
--dstore_wal_buffers=32768
--dstore_wal_file_size=134217728
--dstore_csn_thread_bind_cpu=0
--default-storage-engine=Dstore
--default_tmp_storage_engine=Dstore
--storage_engine_mode=ONLY_DSTORE
--disabled_storage_engines=CSV,Memory,InnoDB,MyISAM,MRG_MyISAM
--transaction_isolation=READ-COMMITTED
