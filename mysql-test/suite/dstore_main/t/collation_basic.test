# Like function

create table tbl (a int primary key, b varchar(20) collate utf8mb4_eo_0900_as_cs, c varchar(20) collate utf8_czech_ci);
insert into tbl values (1, 'abc', 'ab%');


select b like c from tbl;
select 'abc' like 'ab%' escape 'x' from tbl;
select 'abc' like 'ab%' escape 'x' collate utf8mb4_sl_0900_ai_ci from tbl;

drop table tbl;

# Time compared with string literal: issue #2984
create table tbl1 (a int primary key, b time);
insert into tbl1 values (1, '04:59:59.000000');
create table tbl2 (a int primary key, b varchar(30));
insert into tbl2 values (1, '04:59:59.000000');


select * from tbl1 where b = '04:59:59.000000';
select * from tbl1 where b = '04:59:59.000000' collate utf8mb4_0900_bin;
select * from tbl1 where b between '04:59:59.000000' and '05:59:59.000000';
select * from tbl1 where b in ('04:59:59.000000', '05:59:59.000000');
select * from tbl1 where b not in ('04:59:59.000000', '05:59:59.000000');
select * from tbl1, tbl2 where tbl1.b = tbl2.b;
select * from tbl1, tbl2 where tbl1.b = tbl2.b collate utf8mb4_0900_bin;

select * from tbl1 where b = '04:59:59.0000xxx';

drop table tbl1, tbl2;

create table u(pk int primary key, a time);
insert into u values (1,'09:09:59');

select * from  u;
select * from  u where a='09:09:59.000000';
select * from  u where a in('09:09:59.000000');
select * from  u where a in('09:09:59.000000','23:23:59.000000');
select * from  u where a not in('09:09:59.000000','23:23:59.000000');

drop table u;


