#
# Testing of INFORMATION_SCHEMA.DSTORE_LOCKS
#

SET @old_default_engine= @@default_storage_engine;
SET @@default_storage_engine = 'dstore';

DESCRIBE INFORMATION_SCHEMA.DSTORE_LOCKS;

-- disable_warnings
DROP TABLE IF EXISTS t1;
-- enable_warnings

CREATE TABLE t1 (
  int_col INT,
  char_col char(5) not null,
  varchar_col varchar(10) not null,
  PRIMARY KEY (int_col)
) ENGINE=DSTORE;

SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;

START TRANSACTION;
INSERT INTO t1 VALUES (1, "abc", "defgh"), (2, "bcd", "efgh"), (3, "jfda", "xyz");
SELECT * FROM t1;
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;
SELECT * FROM t1 FOR UPDATE;
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;

# INVALID OS_THREAD_ID
SELECT * FROM INFORMATION_SCHEMA.DSTORE_LOCKS WHERE OS_THREAD_ID=0;
SELECT * FROM INFORMATION_SCHEMA.DSTORE_LOCKS WHERE OS_THREAD_ID=1;
# FILTER BY OS_THREAD_ID
SELECT OS_THREAD_ID INTO @tid FROM INFORMATION_SCHEMA.DSTORE_LOCKS LIMIT 1;
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS WHERE OS_THREAD_ID=@tid ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;

COMMIT;

START TRANSACTION;
INSERT INTO t1 VALUES (4, "ters", "etqjd");
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;
ROLLBACK;
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;

SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;

connect (thr1,localhost,root,,);
BEGIN;
INSERT INTO t1 VALUES (4, "dbc", "xefgh");
SELECT * FROM t1 WHERE int_col = 2 FOR UPDATE;

connect (thr2,localhost,root,,);
BEGIN;
--send UPDATE t1 SET char_col = "xyz" where int_col = 2;
--sleep 1

--connect (show,localhost,root,,)
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;

-- connection thr1
COMMIT;

-- connection thr2
reap;
SELECT * FROM t1;
COMMIT;
SELECT * FROM t1;

--connection default
SELECT LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT FROM INFORMATION_SCHEMA.DSTORE_LOCKS ORDER BY LOCKTAG_TYPE, LOCK_MODE, STATE, GRANTED_COUNT DESC;

--disconnect thr1
--disconnect thr2
--disconnect show

--connection default

DROP TABLE t1;

SET @@default_storage_engine=@old_default_engine;
