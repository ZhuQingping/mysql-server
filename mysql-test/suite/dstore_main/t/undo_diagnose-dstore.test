# get_undo_page_header
--replace_regex /[0-9]+/#/
call dbms_dstore_maintenance.show_dstore_info("get_undo_page_header", "5131 1");
call dbms_dstore_maintenance.show_dstore_info("get_undo_page_header", "5131");
call dbms_dstore_maintenance.show_dstore_info("get_undo_page_header", " 5131");
