##########test descend index backward scan
#test select null value
#the first col is null
select * from t1 force index(a) where a is null order by a;
select * from t1 force index(a) where a is null and b > 2 order by b;
select * from t1 force index(a) where a is null and b < 2 order by b;

#the first two cols is null
select * from t1 force index(a) where a is null and b is null order by b;
select * from t1 force index(a) where a is null and b is null and c > 0 order by c;
select * from t1 force index(a) where a is null and b is null and c < 5 order by c;

#all of three cols is null
select * from t1 force index(a) where a is null and b is null and c is null order by c;

#the second col is null
select * from t1 force index(a) where a = 2 and b is null and c > 0 order by c;

#the third col is null
select * from t1 force index(a) where a = 2 and b = 2 and c is null order by c;

#test( < or is null) case
select * from t1 force index(a) where a < 4 or a is null order by a;
select * from t1 force index(a) where a = 2 and (b < 4 or b is null) order by b;
select * from t1 force index(a) where a = 2 and b = 2 and (c < 4 or c is null) order by c;
select * from t1 force index(a) where a is not null or a is null order by a;

#test only use the first col in index
select * from t1 force index(a) where a = 3 order by a;
select * from t1 force index(a) where a between 3 and 6 order by a;
select * from t1 force index(a) where a > 6 order by a;
select * from t1 force index(a) where a >= 7 order by a;
select * from t1 force index(a) where a < 3 order by a;
select * from t1 force index(a) where a >= -1 order by a;
select * from t1 force index(a) where a <= 3 order by a;


#test only use the first two cols in index
select * from t1 force index(a) where a = 3 and b = 3 order by b;
select * from t1 force index(a) where a = 3 and b < 4 order by b;
select * from t1 force index(a) where a = 3 and b <= 4 order by b;
select * from t1 force index(a) where a = 3 and b > 3 order by b;
select * from t1 force index(a) where a = 3 and b >= 3 order by b;
select * from t1 force index(a) where a = -2 and b < 1 order by b;

#test use all of the cols in index
select * from t1 force index(a) where a = 3 and b = 3 and c = 3 order by c;
select * from t1 force index(a) where a = 3 and b = 3 and c < 5 order by c;
select * from t1 force index(a) where a = 3 and b = 3 and c > 2 order by c;
select * from t1 force index(a) where a = 3 and b = 3 and c > 5 order by c;
select * from t1 force index(a) where a = 3 and b = 3 and c < 2 order by c;
select * from t1 force index(a) where a = -2 and b = -2 and c < 1 order by c;

#test only read a part of key cases
select b from t1 force index(a) where a = 3 and b = 3;
select b from t1 force index(a) where a = 3 and b < 4;
select b from t1 force index(a) where a = 3 and b <= 4;
select b from t1 force index(a) where a = 3 and b > 3;
select b from t1 force index(a) where a = 3 and b >= 3;
select b from t1 force index(a) where a = -2 and b < 1;

select b from t1 force index(a) where a is null and b is null;
select b from t1 force index(a) where a is null and b is null and c > 0;
select b from t1 force index(a) where a is null and b is null and c < 5;

#test index include int and char
create table t2(id int, a int, b char(5), key(id),key(a,b)) engine=Dstore;
insert into t2 values(1, 1, 'a');
insert into t2 values(2, 2, 'b');
insert into t2 values(3, 3, 'c');
insert into t2 values(4, 4, 'd');
insert into t2 values(5, 5, 'e');

--disable_query_log
--disable_result_log
ANALYZE TABLE t2 UPDATE HISTOGRAM ON id,a,b;
ANALYZE TABLE t2;
--enable_query_log
--enable_result_log

select * from t2 where a = 2 and b = 'b';
select * from t2 where a > 2 and b = 'e';

##########test records_in_range
#test select null value
#the first col is null
explain select * from t force index(a) where a is null order by id;
explain select * from t force index(a) where a is null and b > 2 order by id;
