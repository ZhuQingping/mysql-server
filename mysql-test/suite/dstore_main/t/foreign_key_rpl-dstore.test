--let $rpl_server_number = 2
--source include/rpl_restart_server.inc

--connection slave
--source include/start_slave.inc

--connection master

ALTER TABLE bmsql_customer ADD CONSTRAINT c_district_fkey FOREIGN KEY (c_w_id, c_d_id) REFERENCES bmsql_district (d_w_id, d_id);

--sync_slave_with_master

--connection slave

SELECT
c.c_w_id, c.c_d_id, c.c_id
FROM
bmsql_customer c LEFT JOIN bmsql_district d ON c.c_w_id = d.d_w_id AND c.c_d_id = d.d_id
WHERE d.d_w_id IS NULL;

--connection master
