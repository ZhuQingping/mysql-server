--disable_query_log
call mtr.add_suppression("\\[Warning\\] .*MY-\\d+.* Compute virtual");
--enable_query_log

CREATE TABLE t (a INT, b INT GENERATED ALWAYS AS (a), c CHAR(10), d CHAR(20), e CHAR(10) GENERATED ALWAYS AS (c), g INT) ENGINE=Dstore;
INSERT INTO t VALUES(10, DEFAULT, "aa", "bb", DEFAULT, 20);
INSERT INTO t VALUES(11, DEFAULT, "jj", "kk", DEFAULT, 21);

CREATE INDEX idx ON t(e);
INSERT INTO t VALUES(12, DEFAULT, 'mm', "nn", DEFAULT, 22);

SELECT e FROM t;

DROP TABLE t;

CREATE TABLE t (a INT, b INT, c INT GENERATED ALWAYS AS(a+b), h VARCHAR(10)) ENGINE=Dstore;

INSERT INTO t VALUES (11, 3, DEFAULT, 'mm');
INSERT INTO t VALUES (18, 1, DEFAULT, 'mm');
INSERT INTO t VALUES (28, 1, DEFAULT, 'mm');
INSERT INTO t VALUES (null, null, DEFAULT, 'mm');

CREATE INDEX idx ON t(c);
--sorted_result
SELECT c FROM t;

UPDATE t SET a = 10 WHERE a = 11;
--sorted_result
SELECT c FROM t;

--sorted_result
SELECT * FROM t;

DELETE FROM t WHERE a = 18;

--sorted_result
SELECT c FROM t;

START TRANSACTION;

INSERT INTO t VALUES (128, 22, DEFAULT, "xx");
INSERT INTO t VALUES (1290, 212, DEFAULT, "xmx");
ROLLBACK;

--sorted_result
SELECT c FROM t;
--sorted_result
SELECT * FROM t;

DROP TABLE t;

