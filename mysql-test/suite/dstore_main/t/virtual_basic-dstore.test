INSERT INTO ibstd_16_fk VALUES(1, 3, "mmm", "SSS", default, default);

# Cascading delete/update on column non-related to virtual column or virtual
# index will be fine
DELETE FROM ibstd_16 WHERE a = 1;

DROP TABLE ibstd_16_fk;
DROP TABLE ibstd_16;

