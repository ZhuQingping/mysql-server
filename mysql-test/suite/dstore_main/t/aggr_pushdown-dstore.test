#virtual gencol index
CREATE TABLE vt (
    a INT NOT NULL,
    b INT generated always as (a+1) virtual,
    INDEX idx_b (b)
);
INSERT INTO vt(a) VALUES(1),(2),(3);
SELECT COUNT(*) FROM vt;
SELECT COUNT(b) FROM vt;
SELECT SUM(b) FROM vt;
DROP TABLE vt;

