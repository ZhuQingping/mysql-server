SET @orig_switch = @@optimizer_switch;
SET @orig_trace = @@optimizer_trace;
SET @orig_trace_fea = @@optimizer_trace_features;
SET optimizer_switch='aggregate_pushdown=on';
CREATE index idxt2 on t2(b1);
PREPARE st1 from "SELECT * from t1 where (a1, a2) in (SELECT b1, min(b2) from t2 where b1 > '0' group by b1)";
PREPARE st2 from "EXPLAIN SELECT * from t1 where (a1, a2) in (SELECT b1, min(b2) from t2 where b1 > '0' group by b1)";
SET optimizer_trace="enabled=on";
SET optimizer_trace_features="greedy_search=off,range_optimizer=off,dynamic_range=off,repeated_subSELECT=off";
EXECUTE st1;
SELECT TRACE LIKE '%aggregate_pushdown%' FROM information_schema.OPTIMIZER_TRACE;
EXECUTE st2;

# test with plancache
EXECUTE st1;
SELECT TRACE LIKE '%aggregate_pushdown%' FROM information_schema.OPTIMIZER_TRACE;
EXECUTE st2;

SET optimizer_switch='aggregate_pushdown=off';
EXECUTE st1;
SELECT TRACE LIKE '%aggregate_pushdown%' FROM information_schema.OPTIMIZER_TRACE;
EXECUTE st2;

DROP TABLE t1,t2;
SET optimizer_trace = @orig_trace;
SET optimizer_trace_features = @orig_trace_fea;

