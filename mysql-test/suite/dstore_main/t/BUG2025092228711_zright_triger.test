#### Update data with trigger

connect (conn1,localhost,root,,);
connect (conn2,localhost,root,,);
connect (conn3,localhost,root,,);

connection conn1;
set sql_mode="";
set transaction_isolation = "READ-COMMITTED";
start transaction;
--enable_info
update test.zright set v1=v1+1,r1=r1+1,gmt_modify=current_timestamp where grp_id=728;
--disable_info

connection conn2;
set sql_mode="";
--send
update test.zright set c1=-279,c2=-325,c3=473,c4=-60,c5=-985,c6=34,c7=831,c8=806,c9=-42,c10='pSgpBhD8V4xm1ejRL6T2fNgRK9mtWCG9hTwf2e1KMO1hw2nm5ZhL0oPrgiG70ra8rF24fFU4An7Lqr7f9PqLHVProVmWB9bBc3kJ',c11=-453,c12='7POuZ6ADcSE1GGAJIqWcX0zI9w4sTY7gb3MvWoKDsJJw01O1JsTCSmn2vkVCG7MbG18bIMiLRq4mCVlJeSZ1HmeMgsNFi4ilw9eV',c13=486,c14='q91kjWpL7lfFkbjM7vubNPp886KvEF5U48GGfDHmrofYOfAMKGLpvUAVG3PlxjGZ0BJRge1DL2A4IoTlfTsMjhpsCgSXgDhT8Lmu',trx_grp=-976,v3='wG6PrtakjOWp9XBzwvmNb8wmqozpKKD5lhTOV67Llll4Qlfc5xpDhSszoz40Ugd9L2tty3S4gBWCDMLfywtGTkEFmbVVd0smhDwc',v4='J1PIcoxPw1PQn61j2MbOlkiNPEaPOvbYvHg30KyerZyCpT1tMWWtzeQjMS9SlIPyF7llOLIOT06EvdIuTtjtAXQfjGFOvBNzA6ew',t3=DATE_FORMAT('5002', '%Y-%m-%d %H:%i:%s'),gmt_modify=current_timestamp where grp_id=728 and mod(row_id,10)=5;

connection conn3;
set sql_mode="";
--send
update test.zright set r1=-161,dec_1=-161*1024/10000*1024,gmt_modify=current_timestamp where grp_id=728 and mod(row_id,5)=0;

connection conn1;
commit;

connection conn2;
--enable_info
--reap
--disable_info
commit;

connection conn3;
--enable_info
--reap
--disable_info
commit;

#### Clean Data

connection default;
drop table zright;
drop table tmp_zright;
--enable_warnings

#### case2
connection default;
create database nebula;
use nebula;
create table nebula.obright(id int not null auto_increment primary key, c int);
insert into nebula.obright(c) values (1),(2),(3);

create table nebula.tmp_obright(c int);
insert into nebula.tmp_obright values (1),(2),(3);

create table nebula.tmp_obright2(c int);

create table nebula.w(c int);
insert into nebula.w values(0);

DELIMITER $;
create trigger nebula.auth_secure before update on nebula.obright FOR EACH ROW
BEGIN
  insert into nebula.tmp_obright2 select * from nebula.tmp_obright;
  update nebula.w set c = c + 1;
END
$
DELIMITER ;$

connection conn1;
SET transaction_isolation = "READ-COMMITTED";
use nebula;
begin;
select * from nebula.w for update;

connection conn2;
SET transaction_isolation = "READ-COMMITTED";
use nebula;
--send
update nebula.obright set c=c+1;

--sleep 2
connection conn3;
SET transaction_isolation = "READ-COMMITTED";
use nebula;
insert into nebula.tmp_obright values (4);

connection conn1;
commit;

connection conn2;
--reap

connection conn1;
select * from tmp_obright2;

### Clean data
drop database nebula;
