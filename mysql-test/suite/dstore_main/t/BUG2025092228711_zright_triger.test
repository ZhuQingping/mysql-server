--source include/have_only_dstore.inc

#### Prepare Data

--disable_warnings
connection default;
set sql_mode="";
create table test.zright(grp_id int,row_id int,row_hex varchar(100),v1 varchar(100),v_check int,c1 int,c2 int,c3 int,c4 int,c5 int,c6 int,c7 int,c8 int,c9 int,c10 varchar(100),c11 int,c12 varchar(100),c13 int,c14 varchar(100),trx_grp int,r1 blob,r2 int,v3 varchar(100),v4 varchar(100),t3 timestamp,v5 varchar(100),d1 int,dec_1 decimal(16,4),dec_2 decimal(16,4),dec_3 decimal(16,6),dec_4 decimal(16,6),gmt_create timestamp,gmt_modify timestamp,primary key(grp_id,row_id,row_hex));

create table test.tmp_zright(i int);
DELIMITER $;
create trigger test.auth_secure before update on test.zright FOR EACH ROW
BEGIN
  insert into test.tmp_zright values(1);
END
$
DELIMITER ;$

