--source include/have_only_dstore.inc
--source include/not_hypergraph.inc  # Non-traditional formats differ in hypergraph.

# myisam specific test

# Don't run with binlog_format=statement due to unsafe REPLACE... SELECT.
--source include/not_binlog_format_statement.inc

# 
# Run explain_non_select.inc on MyISAM with all of the so-called 6.0 features.

set optimizer_switch='semijoin=on,materialization=on,firstmatch=on,loosescan=on,index_condition_pushdown=on,mrr=on,mrr_cost_based=off';

set @save_storage_engine= @@session.default_storage_engine;
set session default_storage_engine = Dstore;
--let $json = 0
--let $DSTORE_IGNORE_EXPLAIN_ROWS_COST_FILTERED = 1
--source include/explain_non_select-dstore.inc
--let $DSTORE_IGNORE_EXPLAIN_ROWS_COST_FILTERED = 0
set default_storage_engine= @save_storage_engine;

set optimizer_switch=default;
