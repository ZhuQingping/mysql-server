-- echo 
-- echo ## TEST INT KEY ##
-- echo
CREATE TABLE records_in_range_test_int (
	c1 INT,
	c2 VARCHAR(2048),
	PRIMARY KEY (c1)
);

# Insert some records so that they cannot fit in one page for some page sizes
# in order to exercise records_in_range() where 1, 2 or more pages are sampled
INSERT INTO records_in_range_test_int VALUES
('111', REPEAT('v', 2048)),
('2222', REPEAT('v', 2048)),
('3333', REPEAT('v', 2048)),
('4444', REPEAT('v', 2048)),
('5555', REPEAT('v', 2048)),
('6666', REPEAT('v', 2048)),
('7777', REPEAT('v', 2048)),
('8888', REPEAT('v', 2048)),
('9999', REPEAT('v', 2048)),
('444', REPEAT('v', 2048)),
('777', REPEAT('v', 2048)),
('33333', REPEAT('v', 2048)),
('44444', REPEAT('v', 2048)),
('55555', REPEAT('v', 2048)),
('66666', REPEAT('v', 2048)),
('77777', REPEAT('v', 2048)),
('88888', REPEAT('v', 2048)),
('99999', REPEAT('v', 2048)),
('88', REPEAT('v', 2048)),
('77', REPEAT('v', 2048)),
('999', REPEAT('v', 2048));

ANALYZE TABLE records_in_range_test_int;

