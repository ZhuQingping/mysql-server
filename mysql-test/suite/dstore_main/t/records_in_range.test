#
# Test ha_cde::records_in_range()
#

-- source include/have_debug.inc
-- source include/not_hypergraph.inc   # Does not use the same estimators.

-- echo 
-- echo ## TEST VARCHAR KEY ##
-- echo
CREATE TABLE records_in_range_test_varchar (
	c1 VARCHAR(16),
	c2 VARCHAR(512),
	PRIMARY KEY (c1)
);

# Insert some records so that they cannot fit in one page for some page sizes
# in order to exercise records_in_range() where 1, 2 or more pages are sampled
INSERT INTO records_in_range_test_varchar VALUES
('ccc', REPEAT('v', 512)),
('kkk01', REPEAT('v', 512)),
('kkk02', REPEAT('v', 512)),
('kkk03', REPEAT('v', 512)),
('kkk04', REPEAT('v', 512)),
('kkk05', REPEAT('v', 512)),
('kkk06', REPEAT('v', 512)),
('kkk07', REPEAT('v', 512)),
('kkk08', REPEAT('v', 512)),
('mmm', REPEAT('v', 512)),
('nnn', REPEAT('v', 512)),
('uuu01', REPEAT('v', 512)),
('uuu02', REPEAT('v', 512)),
('uuu03', REPEAT('v', 512)),
('uuu04', REPEAT('v', 512)),
('uuu05', REPEAT('v', 512)),
('uuu06', REPEAT('v', 512)),
('uuu07', REPEAT('v', 512)),
('uuu08', REPEAT('v', 512)),
('xxx', REPEAT('v', 512));

ANALYZE TABLE records_in_range_test_varchar;

-- echo
-- echo Test left-unbounded, right-open intervals
-- echo
SELECT COUNT(*) FROM records_in_range_test_varchar WHERE c1 < 'aaa';
SELECT COUNT(*) FROM records_in_range_test_varchar WHERE c1 < 'ccc';
SELECT COUNT(*) FROM records_in_range_test_varchar WHERE c1 < 'eee';
