--echo # Test Case: VARCHAR Minimum Prefix Index Test
--echo #
--echo # 1. Create a table with a VARCHAR(1000) column
--echo #
CREATE TABLE t1 (
  id INT PRIMARY KEY AUTO_INCREMENT,
  col VARCHAR(1000)
);

--echo #
--echo # 2. Create an index with prefix length = 1 on the VARCHAR(1000) column
--echo #
CREATE INDEX idx_col ON t1 (col(1));

--echo #
--echo # 3. Insert test data
--echo #
INSERT INTO t1 (col) VALUES
  ('Apple'),
  ('Banana'),
  ('Apricot'),
  ('Avocado'),
  ('Blueberry'),
  ('Aardvark');

--echo #
--echo # 4. Verify index usage (using EXPLAIN)
--echo #
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t1 WHERE col LIKE 'A%';

--echo #
--echo # 5. Verify query results
--echo #
SELECT col FROM t1 WHERE col LIKE 'A%' ORDER BY col;

DROP TABLE t1;

--echo # Test Case: Minimum Prefix Length (1-byte) Edge Case
--echo #
--echo # 1. Create table with minimal prefix
--echo #
CREATE TABLE t3_min_prefix (
  id INT PRIMARY KEY,
  sku CHAR(5),
  INDEX idx_min_prefix (sku(1))
);

--echo #
--echo # 2. Insert boundary data
--echo #
INSERT INTO t3_min_prefix VALUES
(1, 'A1234'),
(2, 'A'),
(3, 'B');

ANALYZE TABLE t3_min_prefix UPDATE HISTOGRAM ON id,sku;
ANALYZE TABLE t3_min_prefix;
--echo #
--echo # 3. Verify index usage
--echo #
--replace_regex /key_len=[0-9]+/key_len=XXX/ /rows=[0-9]+/rows=XXX/
EXPLAIN SELECT * FROM t3_min_prefix WHERE sku = 'A';

--echo #
--echo # 4. Verify query accuracy
--echo #
SELECT sku FROM t3_min_prefix WHERE sku LIKE 'A%';

--echo #
--echo # 5. Cleanup
--echo #
DROP TABLE t3_min_prefix;

--echo # Test Case: Prefix Index with Full Column Length
--echo #
--echo # 1. Create table with full-length prefix
--echo #
CREATE TABLE t4_full_length (
  code CHAR(5),
  INDEX idx_full_length (code(5))
);

--echo #
--echo # 2. Insert exact length data
--echo #
INSERT INTO t4_full_length VALUES 
('12345'),
('1234 ');

--echo #
--echo # 3. Verify index behavior
--echo #
--replace_regex /key_len=[0-9]+/key_len=XXX/ /rows=[0-9]+/rows=XXX/
EXPLAIN SELECT * FROM t4_full_length WHERE code = '1234';

--echo #
--echo # 4. Verify CHAR padding handling
--echo #
SELECT HEX(code), code FROM t4_full_length;

--echo #
--echo # 5. Cleanup
--echo #
DROP TABLE t4_full_length;

--echo # Test Case: Composite Index with Prefix Component
--echo #
--echo # 1. Create composite index
--echo #
CREATE TABLE t5_composite (
  cust_code VARCHAR(20),
  status ENUM('active','inactive'),
  INDEX idx_comp (cust_code(5), status)
);

--echo #
--echo # 2. Insert test data
--echo #
INSERT INTO t5_composite VALUES
('CUST001', 'active'),
('CUST002', 'inactive'),
('CUSTX', 'active');

--echo #
--echo # 3. Verify index coverage
--echo #
--replace_regex /key_len=[0-9]+/key_len=XXX/ /rows=[0-9]+/rows=XXX/
EXPLAIN SELECT cust_code, status FROM t5_composite 
WHERE cust_code LIKE 'CUST%';

--echo #
--echo # 4. Cleanup
--echo #
DROP TABLE t5_composite;

--echo # Test Case: Zero-Length Prefix Index (Invalid)
--echo #
--echo # 1. Attempt to create index with prefix length 0 (should fail)
--echo #
--error ER_KEY_PART_0
CREATE TABLE t1_zero_prefix (
  id INT PRIMARY KEY,
  data VARCHAR(10),
  INDEX idx_bad_prefix (data(0))
);

# Test Case: Prefix Exceeding Column Length
--echo #
--echo # 1. Create table with VARCHAR(5)
--echo #

--error ER_WRONG_SUB_KEY
CREATE TABLE t3_long_prefix (
  code VARCHAR(5),
  INDEX idx_over_prefix (code(10)) -- Prefix longer than column
);


# Test Case: NULL Values in Prefix Index

--echo #
--echo # 1. Create table with nullable column
--echo #
CREATE TABLE t4_nullable (
  id INT PRIMARY KEY,
  notes VARCHAR(100) NULL,
  INDEX idx_notes_prefix (notes(10))
);

--echo #
--echo # 2. Insert mixed NULL and non-NULL data
--echo #
INSERT INTO t4_nullable VALUES 
(1, NULL),
(2, 'Important Note'),
(3, '');

--echo #
--echo # 3. Query NULL entries
--echo #
SELECT id FROM t4_nullable WHERE notes IS NULL;

--echo #
--echo # 4. Verify index ignores NULLs
--echo #
--replace_regex /key_len=[0-9]+/key_len=XXX/ /rows=[0-9]+/rows=XXX/
EXPLAIN SELECT * FROM t4_nullable WHERE notes LIKE 'Impo%';

--echo #
--echo # 5. Cleanup
--echo #
DROP TABLE t4_nullable;


# Test Case: VARBINARY Prefix Exceeding Column Max Length
--echo #
--echo # 1. Create table with VARBINARY(5)
--echo #

--error ER_WRONG_SUB_KEY
CREATE TABLE t2_varbinary_max (
  data VARBINARY(5),
  INDEX idx_over_prefix (data(10))
);


# Test Case: Multi-byte Character Truncation (UTF8MB4)

--echo #
--echo # 1. Create table with UTF8MB4 charset
--echo #
CREATE TABLE t1_mb_truncate (
  id INT PRIMARY KEY,
  data VARCHAR(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  INDEX idx_prefix_3chars (data(3)),  # 前3个字符（可能跨字节）
  INDEX idx_prefix_5bytes (data(5))   # 前5字节（可能截断字符）
);

--echo #
--echo # 2. Insert multi-byte data
--echo #
INSERT INTO t1_mb_truncate VALUES (1, '中文测试');

--echo #
--echo # 3. Verify 3-character prefix index
--echo #
--replace_regex /key_len=[0-9]+/key_len=XXX/ /rows=[0-9]+/rows=XXX/
EXPLAIN SELECT * FROM t1_mb_truncate 
WHERE data LIKE '中%';  # 第1条记录

--echo #
--echo # 4. Verify 5-byte prefix index
--echo #
SELECT HEX(SUBSTRING(data,1,5)), data FROM t1_mb_truncate;

--echo #
--echo # 5. Cleanup
--echo #
DROP TABLE t1_mb_truncate;

--echo # Test Case: BUG2025042234633 Index Prefixes column in different position
CREATE TABLE tt4 (id int NOT NULL,v1 varchar(4),v2 varbinary(255),PRIMARY KEY (id),KEY idx_v1_v2 (v2(5),v1));
INSERT INTO tt4 VALUES(1,'ab','d'),(2,'ab','d'),(3,'ab','d'),(4,'ab','d'),(5,'ab','d'),(6,'ab','d'),(7,'ab','d'),(8,'ab','d'),(9,'ab','d'),(10,'ab','d');
SELECT v1, v2 FROM tt4 WHERE v1 = 'ab' AND v2 = 'd';
DROP TABLE tt4;
CREATE TABLE tt4 (id int NOT NULL,v1 varchar(4),v2 varbinary(255),PRIMARY KEY (id),KEY idx_v1_v2 (v1,v2(5)));
INSERT INTO tt4 VALUES(1,'ab','d'),(2,'ab','d'),(3,'ab','d'),(4,'ab','d'),(5,'ab','d'),(6,'ab','d'),(7,'ab','d'),(8,'ab','d'),(9,'ab','d'),(10,'ab','d');
SELECT v1, v2 FROM tt4 WHERE v1 = 'ab' AND v2 = 'd';
DROP TABLE tt4;

