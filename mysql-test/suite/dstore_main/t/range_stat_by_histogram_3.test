#
#  Test case for Histogram based records_in_range.
#
#  Part 01: Error handle test
#  We will test the error handling like OMM and other error.
#

--source include/have_only_dstore.inc
--source include/have_debug.inc

--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log

# 0. Prepare data for test
--disable_warnings
DROP DATABASE IF EXISTS test_error_table;
CREATE DATABASE test_error_table;
USE test_error_table;
--enable_warnings

CREATE TABLE test_error_table (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    c1 INT NOT NULL,
    c2 INT,
    c3 INT,
    INDEX idx_c1 (c1),
    INDEX idx_c2 (c2),
    INDEX idx_c3 (c3),
    INDEX idx_c1_c2_c3 (c1, c2, c3)
) ENGINE=Dstore;

--disable_query_log
--DELIMITER //

CREATE PROCEDURE insert_combinations()
BEGIN
    DECLARE v1, v2, v3 INT DEFAULT 1;

    SET v1 = 1;
    WHILE v1 <= 10 DO
        INSERT INTO test_error_table(c1, c2, c3) VALUES(v1, NULL, NULL);
        SET v1 = v1 + 1;
    END WHILE;

    SET v1 = 1;
    WHILE v1 <= 10 DO
        SET v2 = 1;
        WHILE v2 <= 10 DO
            SET v3 = 1;
            WHILE v3 <= 10 DO
                INSERT INTO test_error_table(c1, c2, c3) VALUES(v1, v2, v3);
                SET v3 = v3 + 1;
            END WHILE;
            SET v2 = v2 + 1;
        END WHILE;
        SET v1 = v1 + 1;
    END WHILE;
END //
--DELIMITER ;
--enable_query_log

CALL insert_combinations();

set global dstore_use_histogram_auto_update=off;

--disable_warnings
ANALYZE TABLE test_error_table
UPDATE HISTOGRAM ON c1, c2, c3
WITH 100 BUCKETS;
--enable_warnings

# 1. histogram not exists.
ANALYZE TABLE test_error_table DROP HISTOGRAM ON c1;
SELECT COUNT(1) FROM test_error_table WHERE c1 > 5;
ANALYZE TABLE test_error_table UPDATE HISTOGRAM ON c1 WITH 100 BUCKETS;

# 2. test create field failed.
SET session debug='+d,histogram_stat_clone_field_failed';
SELECT COUNT(1) FROM test_error_table WHERE c1 > 5;
SET session debug='-d,histogram_stat_clone_field_failed';

# 2. test create item field failed.
SET session debug='+d,histogram_stat_new_item_field_failed';
SELECT COUNT(1) FROM test_error_table WHERE c1 > 5;
SELECT COUNT(1) FROM test_error_table WHERE c1 < 5;
SELECT COUNT(1) FROM test_error_table WHERE c1 > 5 and c1 < 7;
SET session debug='-d,histogram_stat_new_item_field_failed';

DROP DATABASE test_error_table;

--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log

#
#  Part 02: Test original Histogram function not be affected.
#

--disable_result_log
--let error_log= $MYSQLTEST_VARDIR/tmp/range_stat_by_histogram_3.err
--let restart_parameters="restart: --log-error=$error_log"
--source include/restart_mysqld.inc
--enable_result_log

--disable_warnings
DROP DATABASE IF EXISTS test_histogram;
CREATE DATABASE test_histogram;
USE test_histogram;
--enable_warnings

create table t (i integer, i2 integer);
insert into t values(1,1),(1,2),(1,3),(1,4),(2,1),(2,2),(2,3),(2,4),(3,1),(3,2),(3,3),(3,4),(4,1),(4,2),(4,3),(4,4);
--disable_warnings
analyze table t update histogram on i;
--enable_warnings

SET session debug='+d,print_histgram_recived_values';

--echo # 1. The following SQL should not use histogram.
--disable_result_log
explain format=tree select * from t where i < i2;

explain format=tree select * from t where i between i2 and i2;

explain format=tree select * from t where i in (i2, i2);
--enable_result_log

--echo # Check whether use histogram by search debug print, it should be not found.
--let SEARCH_FILE= $error_log
--let SEARCH_PATTERN= Enter get_selectivity_dispatcher
--source include/search_pattern.inc

DROP DATABASE test_histogram;
SET GLOBAL dstore_use_histogram_auto_update=default;

--remove_file $error_log

--disable_result_log
--source include/restart_mysqld.inc
--enable_result_log

--echo #
--echo # Test variable dstore_calculate_exact_rows_for_range
--echo #
use test;
CREATE TABLE t(a INT, b INT, KEY(a, b));
INSERT INTO t(a, b) VALUES
( 1, 1), ( 2, 1), ( 3, 1), ( 4, 1), ( 5, 1),
( 6, 1), ( 7, 1), ( 8, 1), ( 9, 1), (10, 1),
(11, 1), (12, 1), (13, 1), (14, 1), (15, 1),
(16, 1), (17, 1), (18, 1), (19, 1), (20, 1);
INSERT INTO t SELECT a, 2 FROM t WHERE b = 1;
INSERT INTO t SELECT a, 3 FROM t WHERE b = 1;
INSERT INTO t SELECT -1, -1 FROM t;
ANALYZE TABLE t UPDATE HISTOGRAM ON a,b;
ANALYZE TABLE t;

SET @save_dstore_calculate_exact_rows_for_range= @@global.dstore_calculate_exact_rows_for_range;
SET @save_optimizer_switch=@@optimizer_switch;

# test global variable dstore_calculate_exact_rows_for_range
SELECT @@global.dstore_calculate_exact_rows_for_range;
--Error ER_GLOBAL_VARIABLE
SET dstore_calculate_exact_rows_for_range=ON;
SET GLOBAL dstore_calculate_exact_rows_for_range=ON;
SELECT @@global.dstore_calculate_exact_rows_for_range;
SET GLOBAL dstore_calculate_exact_rows_for_range=OFF;
SELECT @@global.dstore_calculate_exact_rows_for_range;
SET GLOBAL dstore_calculate_exact_rows_for_range=1;
SELECT @@global.dstore_calculate_exact_rows_for_range;
SET GLOBAL dstore_calculate_exact_rows_for_range=0;
SELECT @@global.dstore_calculate_exact_rows_for_range;
SET GLOBAL dstore_calculate_exact_rows_for_range=DEFAULT;
SELECT @@global.dstore_calculate_exact_rows_for_range;

# Disable use histogram estimate records in range
SET optimizer_switch='dstore_use_histogram_range_estimation=off';

SET GLOBAL dstore_calculate_exact_rows_for_range=OFF;
EXPLAIN SELECT * FROM t WHERE 5 <= a AND a < 6 ORDER BY a,b;
SELECT * FROM t WHERE 5 <= a AND a < 6 ORDER BY a,b;
EXPLAIN SELECT * FROM t WHERE (5 <= a AND a < 6) OR (15 <= a AND a < 16) ORDER BY a,b;
SELECT * FROM t WHERE (5 <= a AND a < 6) OR (15 <= a AND a < 16) ORDER BY a,b;
EXPLAIN SELECT * FROM t WHERE a = 5 AND b <= 3 ORDER BY a,b;
SELECT * FROM t WHERE a = 5 AND b <= 3 ORDER BY a,b;
EXPLAIN SELECT * FROM t WHERE a = 5 AND b > 2 and b < 4 ORDER BY a,b;
SELECT * FROM t WHERE a = 5 AND b > 2 and b < 4 ORDER BY a,b;
EXPLAIN SELECT * FROM t WHERE 5 <= a AND a < 8 AND b = 1 ORDER BY a,b;
SELECT * FROM t WHERE 5 <= a AND a < 8 AND b = 1 ORDER BY a,b;
EXPLAIN SELECT * FROM t WHERE (5 <= a AND a < 6 AND b = 1) OR (15 <= a AND a < 16 AND b = 3) ORDER BY a,b;
SELECT * FROM t WHERE (5 <= a AND a < 6 AND b = 1) OR (15 <= a AND a < 16 AND b = 3) ORDER BY a,b;

SET GLOBAL dstore_calculate_exact_rows_for_range=ON;
EXPLAIN SELECT * FROM t WHERE 5 <= a AND a < 6 ORDER BY a,b;
SELECT * FROM t WHERE 5 <= a AND a < 6 ORDER BY a,b;
EXPLAIN SELECT * FROM t WHERE (5 <= a AND a < 6) OR (15 <= a AND a < 16) ORDER BY a,b;
SELECT * FROM t WHERE (5 <= a AND a < 6) OR (15 <= a AND a < 16) ORDER BY a,b;
EXPLAIN SELECT * FROM t WHERE a = 5 AND b <= 3 ORDER BY a,b;
SELECT * FROM t WHERE a = 5 AND b <= 3 ORDER BY a,b;
EXPLAIN SELECT * FROM t WHERE a = 5 AND b > 2 and b < 4 ORDER BY a,b;
SELECT * FROM t WHERE a = 5 AND b > 2 and b < 4 ORDER BY a,b;
EXPLAIN SELECT * FROM t WHERE 5 <= a AND a < 8 AND b = 1 ORDER BY a,b;
SELECT * FROM t WHERE 5 <= a AND a < 8 AND b = 1 ORDER BY a,b;
EXPLAIN SELECT * FROM t WHERE (5 <= a AND a < 6 AND b = 1) OR (15 <= a AND a < 16 AND b = 3) ORDER BY a,b;
SELECT * FROM t WHERE (5 <= a AND a < 6 AND b = 1) OR (15 <= a AND a < 16 AND b = 3) ORDER BY a,b;

SET debug='+d,dstore_records_in_range_wring_key_no';
EXPLAIN SELECT * FROM t WHERE 5 <= a AND a < 6 ORDER BY a,b;
SET debug='-d,dstore_records_in_range_wring_key_no';
EXPLAIN SELECT * FROM t WHERE 5 <= a AND a < 6 ORDER BY a,b;

SET debug='+d,dstore_records_in_range_no_min_max_key';
EXPLAIN SELECT * FROM t WHERE 5 <= a AND a < 6 ORDER BY a,b;
SET debug='-d,dstore_records_in_range_no_min_max_key';
EXPLAIN SELECT * FROM t WHERE 5 <= a AND a < 6 ORDER BY a,b;

DROP TABLE t;
# restore variables
SET GLOBAL dstore_calculate_exact_rows_for_range= @save_dstore_calculate_exact_rows_for_range;
SET optimizer_switch= @save_optimizer_switch;
