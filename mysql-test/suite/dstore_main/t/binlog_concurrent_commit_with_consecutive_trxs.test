# ==== Purpose ====
# Verify that the consecutive transactions can be committed
# successfully with concurrent commit on dstore when gtid
# mode is off.
#
# ==== References ====
#
# US2025030700428 Implement a "BINLOG GROUP COMMIT" with one phase commit
#
 
--source include/have_binlog_format_row.inc
--source include/have_only_dstore.inc
--source include/have_log_bin.inc
 
RESET MASTER;
 
CREATE TABLE t1(c1 INT);
 
--let $i = 1
while ($i < 50) {
  --eval INSERT INTO t1 VALUES ($i);
  --inc $i
}
 
--echo #
--echo # Check that the consecutive transactions are committed successfully.
--echo #
SELECT * FROM t1 ORDER BY t1.c1;
 
--echo #
--echo # Check that the consecutive transactions are written into binary
--echo # log successfully with Anonymous_Gtid when gtid mode is off.
--echo #
--sleep 3
--let $keep_gtid_events= 1
--source include/show_binlog_events.inc
 
# Cleanup
DROP TABLE t1;
