# ==== Purpose =======
# Validate that ALTER TABLE operations involving auto-increment 
# columns trigger SQL warnings.
#
# ==== References ====
#
#
--source include/have_dstore.inc
CALL mtr.add_suppression("If the table contains data, adding an auto-increment column may lead to inconsistencies between primary and replica node.");
create table t(i int);

--echo #expect 1 warnings
alter table t modify column `i` int not null auto_increment, add primary key (`i`);

--let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let SEARCH_PATTERN=If the table contains data, adding an auto-increment column may lead to inconsistencies between primary and replica node.
--source include/search_pattern.inc

--echo #expect 0 warnings
alter table t add id int;

--echo #expect 0 warnings
alter table t modify column id bigint;

create table t1(i int);

--echo #expect 0 warnings
alter table t1 add id int primary key;

create table t2(i int);

--echo #expect 1 warnings
alter table t2 add id int auto_increment primary key;
--let SEARCH_PATTERN=If the table contains data, adding an auto-increment column may lead to inconsistencies between primary and replica node.
--source include/search_pattern.inc

drop table t;
drop table t1;
drop table t2;
