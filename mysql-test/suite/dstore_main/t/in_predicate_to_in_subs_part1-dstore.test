#INSERT INTO t2 VALUES('praesentium aut dolor expedita dolor.', 'no value'),
#       ('harum aliquid sit!', 'no_value');
#EXPLAIN
#SELECT a
#FROM t2
#WHERE a in ('praesentium aut dolor expedita dolor.',
#                        'harum aliquid sit!');
#SELECT a
#FROM t2
#WHERE a in ('praesentium aut dolor expedita dolor.',
