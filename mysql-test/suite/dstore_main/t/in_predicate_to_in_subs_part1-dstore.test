#DROP TABLE t2;

--echo #
--echo # BUG2023052402386: Conversion fails if previous conversion failed
--echo #
CREATE TABLE tb1 (id_col int NOT NULL AUTO_INCREMENT, PRIMARY key(id_col));
INSERT INTO tb1 VALUES(1);

EXPLAIN
SELECT *
FROM tb1
WHERE id_col in (-9999999999999999999999999999999999999999999999999999999999999999.9, 1);
# Fail to convert IN-list into subquery because of type conversion
EXPLAIN
SELECT *
FROM tb1
WHERE id_col in (-99999999999999999999999999999999999999999999999999999999999999999.9, 1);
EXPLAIN
SELECT *
FROM tb1
WHERE id_col in (-9999999999999999999999999999999999999999999999999999999999999999.9, 1);
SET DEBUG='+d,simulate_in_predicate_to_in_sub_fill_tmp_table_failed';
prepare stmt from "select * from tb1 where id_col in (1,2)";
execute stmt;
SET DEBUG='-d,simulate_in_predicate_to_in_sub_fill_tmp_table_failed';
prepare stmt from "explain select * from tb1 where id_col in (1,2)";
execute stmt;
DROP TABLE tb1;

--echo #
--echo # BUG2023052901120: Hint is invalid for IN-list conversion
--echo #
set rds_in_predicate_conversion_threshold = 0;
CREATE TABLE t1(a INT, b INT, key(a));
INSERT INTO t1 VALUES(1,2),(3,4);
EXPLAIN SELECT * FROM t1 WHERE a IN (1, 2);
EXPLAIN SELECT /*+ SET_VAR(rds_in_predicate_conversion_threshold = 1) */ * FROM t1 WHERE a IN (1, 2);
DROP TABLE t1;

--echo #
--echo # BUG2023060201559: Differnt type causes In-list conversion to have a mismatched result
--echo #
CREATE TABLE t1(varbinary_col varbinary(255) DEFAULT NULL, decimal_col decimal(25,5) DEFAULT NULL,
                 KEY vb(varbinary_col), KEY dec_key(decimal_col)); 
INSERT INTO t1 VALUES(binary 'dddddddddd1', null), (binary 'eeeeeeeeeee1', null);
--let $query = select decimal_col from t1 where decimal_col in (-99999999999999999999.9999,-3.40282e38);
--source include/explain_and_query.inc
--let $query = select count(*) from t1 where varbinary_col in ('1', 0);
--source include/explain_and_query.inc
DROP TABLE t1;

--echo #
--echo # BUG2023060602873: Result mismatch after in-list conversion
--echo #
CREATE TABLE test6 (
                        b3 blob,
                        gen_3 varchar(3) GENERATED ALWAYS AS (left(b3,3)) STORED,
                        KEY key_3 (gen_3)
                     );
INSERT INTO test6 (b3) VALUES (_binary '00158124837-54289467866-63898207856-kjihgfedcba-2785532715900158124837-54289467866-63898207856-kjihgfedcba'),
       (_binary 'h01857915357-17612134148-88720199355-96890455862-95815779431');
SELECT gen_3 FROM test6 WHERE gen_3 IN ('h01',1);
DROP TABLE test6;

