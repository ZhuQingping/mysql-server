--echo #
--echo # BUG2025090201272: the in predicate `t.c0 IN (..., NULL, ...)  is is [not] null/unknown` lead to incorrect results
--echo #
CREATE TABLE `t` (`c0` varchar(32) DEFAULT NULL, KEY `i0` (`c0`));
INSERT INTO `t` VALUES ('12');

CREATE TABLE `t_temp` (`c0` varchar(32) DEFAULT NULL, KEY `i0` (`c0`));
INSERT INTO `t_temp` VALUES ('-1706708328'),(NULL);

set rds_in_predicate_conversion_threshold=0;
SELECT t.c0 FROM t WHERE ((t.c0) IN ('-1706708328',  NULL)) IS UNKNOWN;
SELECT t.c0 FROM t WHERE ((t.c0) IN ('-1706708328',  NULL)) IS NULL;
SELECT t.c0 FROM t WHERE ((t.c0) IN ('-1706708328',  NULL)) IS NOT UNKNOWN;
SELECT t.c0 FROM t WHERE ((t.c0) IN ('-1706708328',  NULL)) IS NOT NULL;

set rds_in_predicate_conversion_threshold=1;
--let $query = SELECT t.c0 FROM t WHERE ((t.c0) IN ('-1706708328',  NULL)) IS UNKNOWN;
--source include/explain_and_query.inc
--let $query = SELECT t.c0 FROM t WHERE ((t.c0) IN ('-1706708328',  NULL)) IS NULL;
--source include/explain_and_query.inc
--let $query = SELECT t.c0 FROM t WHERE ((t.c0) IN ('-1706708328',  NULL)) IS NOT UNKNOWN;
--source include/explain_and_query.inc
--let $query = SELECT t.c0 FROM t WHERE ((t.c0) IN ('-1706708328',  NULL)) IS NOT NULL;
--source include/explain_and_query.inc

DROP TABLE t;
DROP TABLE t_temp;

--echo #
--echo # BUG2025091100137: IN-LIST subquery incorrectly use `ref` access instead of `ref_or_null` access
--echo #
CREATE TABLE `t2` (`c1` varchar(500) DEFAULT NULL,`c6` varchar(237) DEFAULT NULL,index idx_c6(c6));
insert into t2 values("","");
 
CREATE TABLE `t_tmp` (`c6` varchar(237) DEFAULT "", KEY `id_c6` (`c6`));
insert into t_tmp values(NULL),("0.6798096730298574");
 
--let $query = SELECT /*+ SET_VAR(rds_in_predicate_conversion_threshold=1) */ t2.c6,t2.c1 FROM t2 WHERE (t2.c6 NOT IN (t2.c1)) IN (t2.c6 IN (NULL, "0.6798096730298574"));
--source include/explain_and_query.inc
--let $query = SELECT t2.c6,t2.c1 FROM t2 WHERE (t2.c6 NOT IN (t2.c1)) IN (t2.c6 IN (select * from t_tmp));
--source include/explain_and_query.inc
 
DROP TABLE t2;
DROP TABLE t_tmp;

--echo #
--echo # BUG2025120324811: IN-LIST query of enum field in condition has invalid enum value incorrectly in sql_mode = ''.
--echo #
create table t1(`enum_col` enum('aaa','bbb','ccc') not null, index index_c1(`enum_col`));
set sql_mode = '';
--disable_warnings
insert into t1 values('aaa'),('bbb'),('ccc'),('xxx'),('kkk');
set rds_in_predicate_conversion_threshold=0;
--let $query = select * from t1 where enum_col in ('bbb', 'ccc', 'false', 'true')
--source include/explain_and_query.inc
--let $query = select * from t1 where enum_col in ('bbb', 'ccc', null)
--source include/explain_and_query.inc
set rds_in_predicate_conversion_threshold=1;
--let $query = select * from t1 where enum_col in ('bbb', 'ccc', 'false', 'true')
--source include/explain_and_query.inc
--let $query = select * from t1 where enum_col in ('bbb', 'ccc', null)
--source include/explain_and_query.inc
--let $query = select * from t1 where enum_col in ('bbb', 'ccc')
--source include/explain_and_query.inc
drop table t1;

create table t1(`enum_col1` enum('aaa','bbb','ccc') not null, `enum_col2` enum('ddd','eee','fff') not null, index index_c1(`enum_col1`), index index_c2(`enum_col2`));
insert into t1 values('aaa', 'ddd'), ('bbb', 'eee'), ('ccc', 'fff'), ('kkk', 'eee');
set rds_in_predicate_conversion_threshold=0;
--let $query = select * from t1 where (enum_col1, enum_col2) in (('aaa', 'ddd'), ('bbb', 'eee'), ('xxx', 'eee'))
--source include/explain_and_query.inc
set rds_in_predicate_conversion_threshold=1;
--let $query = select * from t1 where (enum_col1, enum_col2) in (('aaa', 'ddd'), ('bbb', 'eee'), ('xxx', 'eee'))
--source include/explain_and_query.inc
--let $query = select * from t1 where (enum_col1, enum_col2) in (('aaa', 'ddd'), ('bbb', 'eee'))
--source include/explain_and_query.inc
drop table t1;

create table t1(`enum_col1` enum('aaa','bbb','ccc') not null, c2 int not null, index index_c1(`enum_col1`), index index_c2(c2));
insert into t1 values('aaa', 1), ('bbb', 2), ('ccc', 3), ('kkk', 4);
set rds_in_predicate_conversion_threshold=0;
--let $query = select * from t1 where (enum_col1, c2) in (('aaa', 1), ('bbb', 2), ('xxx', 4))
--source include/explain_and_query.inc
set rds_in_predicate_conversion_threshold=1;
--let $query = select * from t1 where (enum_col1, c2) in (('aaa', 1), ('bbb', 2), ('xxx', 4))
--source include/explain_and_query.inc
--let $query = select * from t1 where (enum_col1, c2) in (('aaa', 1), ('bbb', 2))
--source include/explain_and_query.inc
drop table t1;
--enable_warnings

set rds_in_predicate_conversion_threshold=default;
set optimizer_trace_max_mem_size=default;
set sql_mode = default;

--let $shutdown_server_timeout= 300
--source include/shutdown_mysqld.inc
--source include/start_mysqld.inc
