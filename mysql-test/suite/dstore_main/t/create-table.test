create table table_column_limit(id int) engine=Dstore;
DELIMITER |;

# Procedure to add enough columns to a table such that it reaches the maximum
# number of columns allowed on a table
CREATE PROCEDURE add_columns(table_name varchar(50), algorithm varchar(10))
    BEGIN
    DECLARE i INT DEFAULT 1;
    SET @sql_text = CONCAT('ALTER TABLE ', table_name, ' ');
    while (i < 1664) do
        SET @sql_text = CONCAT(@sql_text, ' ADD COLUMN ', CONCAT('col_', i), ' INTEGER NULL DEFAULT NULL,');
        set i = i + 1;
    end while;
    SET @sql_text = CONCAT(@sql_text, 'ALGORITHM=', algorithm);
    PREPARE stmt FROM @sql_text;
    EXECUTE stmt;
    DEALLOCATE PREPARE stmt;
END |
DELIMITER ;|

call add_columns('table_column_limit', 'COPY');
--error ER_TOO_MANY_FIELDS
ALTER TABLE table_column_limit ADD I_VJ278 INTEGER NULL DEFAULT NULL, ALGORITHM=COPY;
drop table table_column_limit;
DROP PROCEDURE add_columns;
--error ER_TABLESPACE_MISSING_WITH_NAME
CREATE TABLE t2 (i INTEGER) TABLESPACE tttt;
call mtr.add_suppression("Alloc heap segment failed*");
call mtr.add_suppression("Alloc lob segment failed*");
call mtr.add_suppression("cde_create_table_info.create_table fail! *");
SET DEBUG = '+d,create_table_alloc_failed_cause_full_tablespace';
--error ER_DSTORE_ERR_TABLESPACE_REACH_MAXSIZE
CREATE TABLE t2 (i INTEGER);
SET DEBUG = '-d,create_table_alloc_failed_cause_full_tablespace';
SET DEBUG = '+d,create_table_alloc_blob_failed_cause_full_tablespace';
--error ER_DSTORE_ERR_TABLESPACE_REACH_MAXSIZE
CREATE TABLE t2 (i blob);
SET DEBUG = '-d,create_table_alloc_blob_failed_cause_full_tablespace';
SET DEBUG = '+d,create_cde_dict_index_full_tablespace';
--error ER_DSTORE_ERR_TABLESPACE_REACH_MAXSIZE
CREATE TABLE t2 (i INTEGER, key(i));
SET DEBUG = '-d,create_cde_dict_index_full_tablespace';
CREATE TABLE t2 (i INTEGER, key(i));
SET DEBUG = '+d,create_cde_dict_index_full_tablespace';
--error ER_DSTORE_ERR_TABLESPACE_REACH_MAXSIZE 
alter table t2 add column j INTEGER, add index(j);
SET DEBUG = '-d,create_cde_dict_index_full_tablespace';
drop table t2;
