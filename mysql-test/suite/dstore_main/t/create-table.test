--source include/have_only_dstore.inc
--echo #
--echo # CDE
--echo #
use test;

create table t53(id int, a int, b int, c CHAR(120),key(id),key(a),key(a,b)) engine=Dstore;
insert into t53 values(1,1,1,1);
insert into t53 values(2,2,2,2);
insert into t53 values(3,3,3,3);
insert into t53 values(4,4,4,4);
insert into t53 values(5,5,5,5);
insert into t53 values(6,6,6,6);
insert into t53 values(7,7,7,7);
insert into t53 values(8,8,8,8);
insert into t53 values(9,9,9,9);
--replace_column 7 #
show index from t53;
set optimizer_switch="index_condition_pushdown=off";
--sleep 1
#test index read for CDE table
select count(*) from t53;
select a from t53 where id >= 1;
select * from t53 where a < 3;
select * from t53 where b >= 3;
select a from t53 where a >=1;
select a from t53 where id > 1;
#test index read for CDE table
select * from t53 where a >= 1;
select * from t53 where a < 3;
select * from t53 where b >= 3;
select a from t53 where a >=1;
#shoud go through index_last
select max(id) from t53 where id>1;
select max(id) from t53 where id < 5;
select count(*) from t53 where id > 1 and id < 5;
select * from t53 where a > 1 and id < 9;
select * from t53 where a > 1 or id < 8;
select count(*) from t53 where a > 1 or id < 8;
--replace_column 10 #
explain select * from t53 force index(a_2) where a=2 and b=2;
#should  go through handler::ha_index_last->ha_cde::index_last  and index_prev
select * from t53 where id>4  order by id  desc;
--replace_column 10 #
explain select * from t53 where id>4  order by id  desc;
select * from t53 force index(a_2) where a=2 and b=2;
drop table t53;

