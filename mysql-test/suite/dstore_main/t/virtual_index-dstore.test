CREATE TABLE t1 (
  c1 varchar(10)
) ENGINE=Dstore;
insert into t1 values('ab'),('bb');
CREATE TABLE t2 (
  id int NOT NULL DEFAULT 0,
  c1 int,
  c2 varchar(10),
  KEY idx (((c1 - id)))
) ENGINE=Dstore;
INSERT INTO t2 VALUES(1, 3, 'ab'),(2, 4, 'aabb');
delete from t2 using t2 right join t1 on t2.c2 = t1.c1;
select * from t2;
drop table t1,t2;
SET @@sql_mode=@org_mode;
