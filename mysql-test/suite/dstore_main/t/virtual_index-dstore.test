CREATE TABLE `t0` (
  `c0` decimal(10,0) DEFAULT NULL COMMENT 'asdf',
  `c1` double DEFAULT NULL,
  `vc3` varchar(100) GENERATED ALWAYS AS (cast(`c1` as char(30) charset utf8mb4)) VIRTUAL,
  `vc4` decimal(10,0) GENERATED ALWAYS AS (cast(`vc3` as unsigned)) VIRTUAL,
  `c5` tinyint(160) unsigned zerofill  DEFAULT NULL COMMENT 'asdf',
  `c6` float DEFAULT NULL,
  `vc7` varchar(100) GENERATED ALWAYS AS (cast(`c5` as char(30) charset utf8mb4)) VIRTUAL,
  `c8` tinyint(1) DEFAULT NULL COMMENT 'asdf',
  `vc9` tinyint(1) GENERATED ALWAYS AS (cast(`c5` as unsigned)) VIRTUAL,
  UNIQUE KEY `i0` (`c1` DESC,`c5`),
  UNIQUE KEY `i8` (`c0` DESC,`c8`,`vc4`,`c6`) USING BTREE /*!80000 INVISIBLE */,
  UNIQUE KEY `i3` (`c0`,`vc7`(3),`vc4`,`c5`,`c1`,`vc3`,`c6`,`c8`,`vc9`) /*!80000 INVISIBLE */,
  UNIQUE KEY `i6` (`c5`,`vc9`,`c0`,`vc3`(2),`c6`,`vc7`(3),`vc4`,`c8`,`c1`),
  KEY `i2` (`c5`,`c0`,`vc3`(3),`vc9`,`vc4`,`c6`,`c8`,`vc7`,`c1`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci MIN_ROWS=4294967295 AVG_ROW_LENGTH=2009662977 PACK_KEYS=1 STATS_AUTO_RECALC=0 DELAY_KEY_WRITE=1 KEY_BLOCK_SIZE=26693;

