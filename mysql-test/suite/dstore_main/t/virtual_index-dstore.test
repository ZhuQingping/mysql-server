--echo # BUG 2025101529730
--echo #

DROP TABLE IF EXISTS `t0`;
CREATE TABLE `t0` (
  `c2` varchar(500) /*!50606 COLUMN_FORMAT FIXED */ DEFAULT NULL COMMENT 'asdf',
  `vc3` mediumint GENERATED ALWAYS AS (cast(`c2` as signed)) VIRTUAL,
  KEY `i0` (`vc3`,`c2`(3)) USING BTREE
) ENGINE=dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
