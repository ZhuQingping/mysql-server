SET FOREIGN_KEY_CHECKS = 1;

SELECT t0.c0 AS ref0, t0.c1 AS ref1, t0.c2 AS ref2, t0.vc3 AS ref3, t0.c4 AS ref4, t0.c5 AS ref5, t0.vc6 AS ref6, t0.vc7 AS ref7, t0.c8 AS ref8, t0.c9 AS ref9, t0.c10 AS ref10 FROM t0 WHERE ((t0.vc7) NOT IN (GREATEST(-870041137, "eS~^jW<I!"))) OR ((t0.c8) IS NOT UNKNOWN);

DROP TABLE t0;

