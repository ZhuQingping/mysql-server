--source include/have_only_dstore.inc
#
# MRR/InnoDB tests.
# (Turns off all 6.0 optimizer switches, even MRR)
# 

--source include/no_valgrind_without_big.inc

--disable_query_log
if (`select locate('semijoin', @@optimizer_switch) > 0`) 
{
  set optimizer_switch='semijoin=off';
}
if (`select locate('materialization', @@optimizer_switch) > 0`) 
{
  set optimizer_switch='materialization=off';
}
if (`select locate('index_condition_pushdown', @@optimizer_switch) > 0`) 
{
  set optimizer_switch='index_condition_pushdown=off';
}
if (`select locate('mrr', @@optimizer_switch) > 0`) 
{
  set optimizer_switch='mrr=off';
}
--enable_query_log

set @save_storage_engine= @@default_storage_engine;
set default_storage_engine=Dstore;
set global rds_empty_redundant_check_in_range_scan=false;
set session rds_empty_redundant_check_in_range_scan=false;

--source include/mrr_tests-dstore.inc 
--source include/mrr_innodb_tests.inc

set session rds_empty_redundant_check_in_range_scan=true;
set global rds_empty_redundant_check_in_range_scan=true;
set default_storage_engine= @save_storage_engine;
set optimizer_switch=default;

