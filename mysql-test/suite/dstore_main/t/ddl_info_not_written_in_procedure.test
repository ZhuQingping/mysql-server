--source include/have_only_dstore.inc

--echo #
--echo # Bug fix verification: DDL info writing in multi-DDL procedures
--echo #
--echo # Description:
--echo # Previously, DDL info was not written for subsequent DDL statements in a 
--echo # multi-DDL stored procedure when 'rds_dstore_write_ddl_sql_into_redo' was OFF.
--echo # This happened because 'THD::is_ddl_info_written' was only reset when 
--echo # 'thd->ddl_info_sql().length()' was non-zero. When the variable is OFF, 
--echo # the length is always zero, causing subsequent DDLs to skip writing DDL info.
--echo #

--echo # 1. Create the stored procedure with multiple DDLs
DELIMITER $$;

DROP PROCEDURE IF EXISTS `test_lifecycle_demo`$$

CREATE PROCEDURE `test_lifecycle_demo`()
BEGIN
    -- Execute multiple DDLs in sequence
    CREATE TABLE `tb_user` (id INT);
    CREATE TABLE `tb_product` (id INT);
    CREATE TABLE `tb_order` (id INT);

    DROP TABLE `tb_user`;
    DROP TABLE `tb_product`;
    DROP TABLE `tb_order`;
END$$

DELIMITER ;$$

--echo # 2. Execute the procedure
--echo # If the bug exists, server will crash at Dstore extral wal check function.
CALL test_lifecycle_demo();

--echo # 3. Cleanup
DROP PROCEDURE test_lifecycle_demo;

--echo # Test passed.
