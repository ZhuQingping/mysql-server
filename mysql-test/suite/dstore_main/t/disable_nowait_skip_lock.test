#
# Testing of disabled NOWAIT and others
#
SET GLOBAL rds_allow_skip_locked_now_wait = false;

CREATE table num (v INT);
insert into num (v) VALUES (1),(2);
--error ER_CHECK_NOT_IMPLEMENTED
SELECT * from num FOR UPDATE NOWAIT;
--error ER_CHECK_NOT_IMPLEMENTED
SELECT * from num FOR SHARE NOWAIT;
--error ER_CHECK_NOT_IMPLEMENTED
SELECT * from num FOR UPDATE SKIP LOCKED;
SELECT * FROM num FOR SHARE;
SELECT * FROM num FOR UPDATE;
SELECT * FROM num;
drop table num;
CREATE table num (v INT) ENGINE=Innodb;
insert into num (v) VALUES (1),(2);
SELECT * from num FOR UPDATE NOWAIT;
SELECT * from num FOR SHARE NOWAIT;
SELECT * from num FOR UPDATE SKIP LOCKED;
SELECT * FROM num FOR SHARE;
drop table num;
SET GLOBAL rds_allow_skip_locked_now_wait = default;
