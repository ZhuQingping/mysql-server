# BUG2025072831816 skip virtual generated columns in conditon pushdown
CREATE TABLE `tt_2` (
  `d0` double DEFAULT NULL,
  `i4` int DEFAULT NULL,
  `v5` varchar(24) DEFAULT NULL,
  `g6` varchar(10) GENERATED ALWAYS AS (concat(substr(`v5`,1,10))) VIRTUAL,
  `vN290_rename` varchar(24) DEFAULT NULL,
  `gN173` varchar(2) GENERATED ALWAYS AS (concat(substr(`vN290_rename`,1,2))) VIRTUAL,
  `vN223` varchar(20) DEFAULT NULL,
  `vN234` varchar(28) DEFAULT NULL,
  `gN276_rename` char(3) GENERATED ALWAYS AS (concat(substr(`vN234`,1,2),substr(`vN290_rename`,1,1))) VIRTUAL,
  `gN267` char(11) GENERATED ALWAYS AS (concat(substr(`vN290_rename`,1,1),substr(`vN223`,1,6),substr(`vN290_rename`,1,2),substr(`vN290_rename`,1,2))) STORED,
  `cN165` char(22) DEFAULT NULL,
  `cN54` char(15) DEFAULT NULL,
  `iN128` int DEFAULT NULL
);
