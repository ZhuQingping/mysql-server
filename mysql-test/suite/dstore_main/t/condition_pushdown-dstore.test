SELECT small_u FROM overflow_test WHERE small_u BETWEEN 65535 AND 65535 ORDER BY small_u;
SELECT small_u FROM overflow_test WHERE small_u BETWEEN -1 AND -1 ORDER BY small_u;
SELECT small_u FROM overflow_test WHERE small_u BETWEEN 65536 AND 65536 ORDER BY small_u;

