CREATE TABLE invalid_time (a TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6), b datetime(3));
INSERT INTO invalid_time VALUES ('2001-01-01 11:22:33.123456', '2016-12-31 23:59:59.000');
INSERT INTO invalid_time VALUES ('2001-01-01 00:00:00.100000', '1000-12-31 23:59:59.000');
SET @a=20010101000000.1e0;
SELECT * FROM invalid_time WHERE a=@a;
SELECT * FROM invalid_time WHERE 9e9 <= b;
SELECT * FROM invalid_time WHERE 9e9 between b and b;
explain SELECT * FROM invalid_time WHERE a= cast(20010101000000.1e0 AS CHAR);

create table tm_bt(a timestamp NULL DEFAULT NULL, b timestamp(3) NULL DEFAULT NULL, c timestamp(3) NULL DEFAULT NULL);
insert into tm_bt values('2025-01-01 00:00:00', '2025-01-01 00:00:00.000', '2025-01-01 00:00:00.000');
insert into tm_bt values('2025-01-01 00:00:01', '2025-01-01 00:00:00.001', '2025-01-01 00:00:00.001');
insert into tm_bt values('2025-01-01 00:00:01', '2025-01-01 00:00:00.000', '2025-01-01 00:00:00.000');
insert into tm_bt values('2038-01-19 03:14:07', '2025-01-01 00:00:00.000', '2025-01-01 00:00:00.000');
select a,b from tm_bt where 20250101000000.000000 between b and a order by 1;
select a,b from tm_bt where 20250101000000.000000 between b and c order by 1;

