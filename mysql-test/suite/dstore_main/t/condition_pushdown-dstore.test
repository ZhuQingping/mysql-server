select a from tm_trunc where  a > '1.001.00';
select a from tm_trunc where  '1.001.00' < a;
select a from tm_trunc where  a < '1.001.00';
select a from tm_trunc where  '1.001.00' > a;

select c from tm_trunc where  c > '0.000.000001';
select c from tm_trunc where  '0.000.000001' < c;
select c from tm_trunc where  c < '0.000.00001';
select c from tm_trunc where  '0.000.000001' > c;

select a from tm_trunc where  a > '0:00:00.000001';
select b from tm_trunc where  b > '0:00:00.000001';
select c from tm_trunc where  c > '0:00:00.000001';
select b FROM tm_trunc where 9e9 <= b ORDER BY 1;

explain select a from tm_trunc where '-20250101' > a;
