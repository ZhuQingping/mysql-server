CREATE ALGORITHM=UNDEFINED VIEW `v0` (`c0`) AS select 1975 AS `ref0` from `tmv` order by `tmv`.`vc3` limit 4881250600087046415;
SELECT tmv.c0 AS ref0 FROM v0 LEFT JOIN tmv ON  EXISTS (SELECT 1 wHERE FALSE) WHERE ((NULL) IS FALSE) < ((+ (v0.c0)));

