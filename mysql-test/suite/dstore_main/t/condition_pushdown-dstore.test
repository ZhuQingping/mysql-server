# test mv, BUG2025121727849
CREATE TABLE `tmv` (
  `c0` tinyint(1) NOT NULL /*!50606 STORAGE DISK */ /*!50606 COLUMN_FORMAT DYNAMIC */ COMMENT 'asdf',
  `c1` mediumblob,
  `c2` double(56,10) unsigned zerofill /*!50606 STORAGE DISK */ DEFAULT NULL COMMENT 'asdf',
  `vc3` mediumblob GENERATED ALWAYS AS (cast(`c0` as char(30) charset utf8mb4)) VIRTUAL,
  `vc4` timestamp GENERATED ALWAYS AS (cast(`c1` as unsigned)) VIRTUAL NOT NULL,
  `vc5` datetime(5) GENERATED ALWAYS AS (cast(`c1` as unsigned)) VIRTUAL,
  `vc7` tinyint(1) GENERATED ALWAYS AS (cast(`vc4` as unsigned)) VIRTUAL,
  `vc9` float(53,23) unsigned zerofill GENERATED ALWAYS AS (cast(`vc7` as unsigned)) VIRTUAL,
  PRIMARY KEY (`c0`),
  UNIQUE KEY `i0` (`c2`,`vc5`,`vc4`,`vc7`),
  KEY `i1` ((_utf8mb4'04:04:13')) /*!80000 INVISIBLE */,
  KEY `i42` (`c0`,`vc7` DESC)
);

