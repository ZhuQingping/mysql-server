SELECT SUM(a) FROM agg where b between 20 and 60;


# ORDER BY/GROUP BY/DISTINCT/LIMIT, OFFSET/
explain select id from users where age between 14 and 15 order by age;
explain select distinct age from users where age between 14 and 15 order by age;
explain select age from users where age between 14 and 15 group by age;
explain select id,age from users where age between 14 and 15 order by age limit 2 offset 1;

# window function
explain SELECT
    id,
    name,
    age,
    city,
    RANK() OVER (PARTITION BY city ORDER BY age DESC) AS age_rank_in_city
FROM
    users
WHERE
    age BETWEEN 12 AND 14
ORDER BY
    city, age_rank_in_city;

explain SELECT
    id,
    name,
    age,
    city,
    AVG(age) OVER (ORDER BY age ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS moving_avg_age
FROM
    users
WHERE
    age >= 12
ORDER BY
    age;

explain SELECT
    age,
    COUNT(*) AS user_count,
    SUM(COUNT(*)) OVER (ORDER BY age ROWS UNBOUNDED PRECEDING) AS cumulative_users
FROM
    users
WHERE
    age > 12
GROUP BY
    age
ORDER BY
    age;

explain SELECT
    id,
    name,
    age,
    city,
    PERCENT_RANK() OVER (ORDER BY age) AS age_percentile
FROM
    users
WHERE
    age > 12
ORDER BY
    age_percentile DESC;

# CTE
explain WITH filtered_users AS (
    SELECT
        id,
        name,
        age,
        city
    FROM
        users
    WHERE
        age BETWEEN 11 AND 14
        AND city LIKE 'M%'
)
SELECT
    id,
    name,
    age,
    city,
    RANK() OVER (PARTITION BY city ORDER BY age DESC) AS age_rank,
    age - AVG(age) OVER (PARTITION BY city) AS age_diff_from_avg
FROM
    filtered_users
ORDER BY
    city, age_rank;

EXPLAIN SELECT age from users GROUP BY age;

