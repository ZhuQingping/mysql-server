SELECT tiny_s FROM overflow_test WHERE tiny_s BETWEEN 127 AND 127 ORDER BY tiny_s;
SELECT tiny_s FROM overflow_test WHERE tiny_s BETWEEN -129 AND -129 ORDER BY tiny_s;
SELECT tiny_s FROM overflow_test WHERE tiny_s BETWEEN 128 AND 128 ORDER BY tiny_s;

# TINYINT UNSIGNED test (0 to 255)
SELECT tiny_u FROM overflow_test WHERE tiny_u BETWEEN 0 AND 0 ORDER BY tiny_u;
SELECT tiny_u FROM overflow_test WHERE tiny_u BETWEEN 255 AND 255 ORDER BY tiny_u;
SELECT tiny_u FROM overflow_test WHERE tiny_u BETWEEN -1 AND -1 ORDER BY tiny_u;
SELECT tiny_u FROM overflow_test WHERE tiny_u BETWEEN 256 AND 256 ORDER BY tiny_u;

