CREATE TABLE t0 (
    c0 tinyint(1) NOT NULL,
    c1 smallint DEFAULT NULL,
    c4 float unsigned zerofill,
    c5 decimal(10,0)
);

INSERT INTO t0 values(0, -32768, 0.5, 1);
INSERT INTO t0 values(1, 32767, 0.125, 1);
INSERT INTO t0 values(0, 32767, 3.1415926, 100);
INSERT INTO t0 values(1, -32768, 3.14, -100);
INSERT INTO t0 values(0, -32768, -3.14, 300);
INSERT INTO t0 values(1, 32767, 0.685776, 1522944381);
INSERT INTO t0 values(0, 32767, 254219000, 9999999999);
INSERT INTO t0 values(1, -32768, 001191080000, 1022870916);
INSERT INTO t0 values(1, -32767, 0.733325, 1022870916);

SELECT ALL t0.c4 AS ref4, t0.c5 as ref5 FROM t0 WHERE (t0.c4) < (1.191082021E9) order by 1,2;
SELECT ALL t0.c5 AS ref4,(GREATEST(0.7608962789784409, -1.961734088E9)) < (t0.c5) FROM t0 WHERE (GREATEST(0.7608962789784409, -1.961734088E9)) < (t0.c5);
SELECT c5 FROM t0 where c5 < CAST(1000 AS SIGNED);
SELECT t0.c1 FROM t0 WHERE (((~ ('1')))>(t0.c0));
SELECT t0.c1 FROM t0 WHERE (1 >(t0.c0));
SELECT t0.c1 FROM t0 WHERE (NOT (((CAST(-402288618 AS UNSIGNED))<(t0.c1))));
SELECT t0.c1 FROM t0 WHERE (NOT (((CAST(-1 AS SIGNED))<(t0.c1))));
SELECT t0.c1 FROM t0 WHERE c5 > coalesce(NULL,0.6887587680412904);
SELECT t0.c1 FROM t0 WHERE c5 < coalesce(NULL,0.6887587680412904);
SELECT t0.c1 FROM t0 WHERE c5 = coalesce(NULL,0.6887587680412904);
SELECT t0.c4 FROM t0 WHERE !(GREATEST(0.7333249765105414, -1348401349) >= t0.c4);

