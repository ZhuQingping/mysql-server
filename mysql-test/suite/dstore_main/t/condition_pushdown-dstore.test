#
# Test common conditon pushdown.
#
--source include/have_only_dstore.inc

--disable_warnings
drop table if exists  numeric_types, datetime_types, string_types, json_type, users;
--enable_warnings

CREATE TABLE numeric_types (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tiny_int_col TINYINT,
    small_int_col SMALLINT,
    medium_int_col MEDIUMINT,
    int_col INT,
    big_int_col BIGINT,
    decimal_col DECIMAL(10,2),
    float_col FLOAT,
    double_col DOUBLE,
    bit_col BIT(8),
    boolean_col BOOLEAN
);

INSERT INTO numeric_types VALUES
(1, 127, 32767, 8388607, 2147483647, 9223372036854775807, 12345.67, 3.14159, 2.71828, b'10101010', TRUE),
(2, -128, -32768, -8388608, -2147483648, -9223372036854775808, -9876.54, -1.234, -5.678, b'11110000', FALSE),
(3, 0, 0, 0, 0, 0, 0.00, 0.0, 0.0, b'00000000', FALSE),
(4, 50, 15000, 500000, 1000000, 5000000000, 9999.99, 9.876, 5.432, b'01010101', TRUE),
(5, -50, -15000, -500000, -1000000, -5000000000, -9999.99, -9.876, -5.432, b'10101010', FALSE),
(6, 25, 16384, 4194304, 1073741824, 4611686018427387904, 5000.50, 2.5, 1.5, b'11001100', TRUE),
(7, -25, -16384, -4194304, -1073741824, -4611686018427387904, -5000.50, -2.5, -1.5, b'00110011', FALSE),
(8, 100, 25000, 7500000, 2000000000, 9000000000000000000, 1234.56, 1.234, 6.789, b'11111111', TRUE),
(9, -100, -25000, -7500000, -2000000000, -9000000000000000000, -1234.56, -1.234, -6.789, b'00000000', FALSE),
(10, 10, 1000, 100000, 10000000, 1000000000000000000, 333.33, 3.333, 33.333, b'10100101', TRUE);

# primary key
EXPLAIN SELECT id, tiny_int_col, int_col FROM numeric_types where id=6;
SELECT id, tiny_int_col, int_col FROM numeric_types where id=6;

EXPLAIN SELECT id, tiny_int_col, int_col FROM numeric_types where id=6;
SELECT id, tiny_int_col, int_col FROM numeric_types where id=6;

EXPLAIN SELECT id, tiny_int_col, int_col FROM numeric_types where id>=6;
SELECT id, tiny_int_col, int_col FROM numeric_types where id>=6;

