CREATE TABLE datetime_types (
    id INT AUTO_INCREMENT PRIMARY KEY,
    date_col DATE,
    time_col TIME,
    datetime_col DATETIME,
    timestamp_col TIMESTAMP,
    year_col YEAR
);

INSERT INTO datetime_types VALUES
(1, '2023-01-01', '12:00:00', '2023-01-01 12:00:00', '2023-01-01 12:00:00', 2023),
(2, '2022-12-31', '23:59:59', '2022-12-31 23:59:59', '2022-12-31 23:59:59', 2022),
(3, '2000-02-29', '00:00:00', '2000-02-29 00:00:00', '2000-02-29 00:00:00', 2000),
(4, '1999-12-31', '13:30:15', '1999-12-31 13:30:15', '1999-12-31 13:30:15', 1999),
(5, '2038-01-19', '03:14:07', '2038-01-19 03:14:07', '2038-01-19 03:14:07', 2038),
(6, '1980-05-15', '08:45:30', '1980-05-15 08:45:30', '1980-05-15 08:45:30', 1980),
(7, '2023-06-30', '18:30:00', '2023-06-30 18:30:00', '2023-06-30 18:30:00', 2023),
(8, '2015-11-11', '11:11:11', '2015-11-11 11:11:11', '2015-11-11 11:11:11', 2015),
(9, '1970-01-01', '00:00:01', '1970-01-01 00:00:01', '1970-01-01 23:00:01', 1970),
(10, '2024-02-29', '14:25:36', '2024-02-29 14:25:36', '2024-02-29 14:25:36', 2024);

# Basic Date and Time Queries
EXPLAIN SELECT id, date_col FROM datetime_types WHERE date_col = '2023-01-01';
SELECT id, date_col FROM datetime_types WHERE date_col = '2023-01-01';

EXPLAIN SELECT id, time_col FROM datetime_types WHERE time_col = '12:00:00';
SELECT id, time_col FROM datetime_types WHERE time_col = '12:00:00';

EXPLAIN SELECT id, datetime_col FROM datetime_types WHERE datetime_col = '2023-01-01 12:00:00';
SELECT id, datetime_col FROM datetime_types WHERE datetime_col = '2023-01-01 12:00:00';

# # Range Queries
EXPLAIN SELECT id, date_col FROM datetime_types WHERE date_col BETWEEN '2023-01-01' AND '2023-06-30';
SELECT id, date_col FROM datetime_types WHERE date_col BETWEEN '2023-01-01' AND '2023-06-30';

EXPLAIN SELECT id, time_col FROM datetime_types WHERE time_col BETWEEN '09:00:00' AND '17:00:00';
SELECT id, time_col FROM datetime_types WHERE time_col BETWEEN '09:00:00' AND '17:00:00';

EXPLAIN SELECT id, datetime_col FROM datetime_types WHERE datetime_col BETWEEN '2023-01-01 00:00:00' AND '2023-12-31 23:59:59';
SELECT id, datetime_col FROM datetime_types WHERE datetime_col BETWEEN '2023-01-01 00:00:00' AND '2023-12-31 23:59:59';

SET DEBUG="+d,condition_pushdown_invalid_datetime";
EXPLAIN SELECT id, datetime_col FROM datetime_types WHERE datetime_col BETWEEN '2023-01-01 00:00:01' AND '2023-12-31 23:59:59';
SELECT id, datetime_col FROM datetime_types WHERE datetime_col BETWEEN '2023-01-01 00:00:00' AND '2023-12-31 23:59:59';
SET DEBUG="-d,condition_pushdown_invalid_datetime";

# Comparison Operators
EXPLAIN SELECT id, date_col FROM datetime_types WHERE date_col > '2023-03-01';
SELECT id, date_col FROM datetime_types WHERE date_col > '2023-03-01';

EXPLAIN SELECT id, time_col FROM datetime_types WHERE time_col < '12:00:00';
SELECT id, time_col FROM datetime_types WHERE time_col < '12:00:00';

EXPLAIN SELECT id, datetime_col FROM datetime_types WHERE datetime_col >= '2023-06-01 00:00:00';
SELECT id, datetime_col FROM datetime_types WHERE datetime_col >= '2023-06-01 00:00:00';

# Date and Time Functions
EXPLAIN SELECT id, date_col FROM datetime_types WHERE YEAR(date_col) = 2023;
SELECT id, date_col FROM datetime_types WHERE YEAR(date_col) = 2023;

EXPLAIN SELECT id, datetime_col FROM datetime_types WHERE MONTH(datetime_col) = 6;
SELECT id, datetime_col FROM datetime_types WHERE MONTH(datetime_col) = 6;

EXPLAIN SELECT id, time_col FROM datetime_types WHERE HOUR(time_col) > 12;
SELECT id, time_col FROM datetime_types WHERE HOUR(time_col) > 12;

EXPLAIN SELECT id, date_col FROM datetime_types WHERE DAYOFWEEK(date_col) = 2;
SELECT id, date_col FROM datetime_types WHERE DAYOFWEEK(date_col) = 2;

# Date Arithmetic
EXPLAIN SELECT id, date_col FROM datetime_types WHERE date_col = DATE_ADD('2023-01-01', INTERVAL 30 DAY);
SELECT id, date_col FROM datetime_types WHERE date_col = DATE_ADD('2023-01-01', INTERVAL 30 DAY);

EXPLAIN SELECT id, datetime_col FROM datetime_types WHERE datetime_col BETWEEN DATE_SUB(NOW(), INTERVAL 1 MONTH) AND NOW();
SELECT id, datetime_col FROM datetime_types WHERE datetime_col BETWEEN DATE_SUB(NOW(), INTERVAL 1 MONTH) AND NOW();

EXPLAIN SELECT id, time_col FROM datetime_types WHERE TIMEDIFF(time_col, '12:00:00') > '02:00:00';
SELECT id, time_col FROM datetime_types WHERE TIMEDIFF(time_col, '12:00:00') > '02:00:00';

# TIMESTAMP Specific Queries
EXPLAIN SELECT id, timestamp_col FROM datetime_types WHERE timestamp_col > '2025-07-08 22:49:22' - INTERVAL 1 HOUR;
SELECT id, timestamp_col FROM datetime_types WHERE timestamp_col > '2025-07-08 22:49:22' - INTERVAL 1 HOUR;

EXPLAIN SELECT id, timestamp_col FROM datetime_types WHERE timestamp_col BETWEEN '2023-01-01 00:00:00' AND '2023-12-31 23:59:59';
SELECT id, timestamp_col FROM datetime_types WHERE timestamp_col BETWEEN '2023-01-01 00:00:00' AND '2023-12-31 23:59:59';

EXPLAIN SELECT id, timestamp_col FROM datetime_types WHERE UNIX_TIMESTAMP(timestamp_col) > 1672531200;
SELECT id, timestamp_col FROM datetime_types WHERE UNIX_TIMESTAMP(timestamp_col) > 1672531200;

SELECT id, timestamp_col FROM datetime_types WHERE (not 99991231235959.00000000000000001 < timestamp_col) order by id;

# YEAR Type Queries
EXPLAIN SELECT id, year_col FROM datetime_types WHERE year_col = 2023;
SELECT id, year_col FROM datetime_types WHERE year_col = 2023;

EXPLAIN SELECT id, year_col FROM datetime_types WHERE year_col BETWEEN 2020 AND 2025;
SELECT id, year_col FROM datetime_types WHERE year_col BETWEEN 2020 AND 2025;

EXPLAIN SELECT id, year_col FROM datetime_types WHERE year_col > 2020;
SELECT id, year_col FROM datetime_types WHERE year_col > 2020;

# Complex Date/Time Conditions
EXPLAIN SELECT id, date_col FROM datetime_types WHERE DAYOFWEEK(date_col) IN (1, 7) AND MONTH(date_col) = 6;
SELECT id, date_col FROM datetime_types WHERE DAYOFWEEK(date_col) IN (1, 7) AND MONTH(date_col) = 6;

EXPLAIN SELECT id, datetime_col FROM datetime_types WHERE HOUR(datetime_col) BETWEEN 9 AND 17 AND DAYOFWEEK(datetime_col) BETWEEN 2 AND 6;
SELECT id, datetime_col FROM datetime_types WHERE HOUR(datetime_col) BETWEEN 9 AND 17 AND DAYOFWEEK(datetime_col) BETWEEN 2 AND 6;

EXPLAIN SELECT id, date_col FROM datetime_types WHERE date_col = LAST_DAY(date_col);
SELECT id, date_col FROM datetime_types WHERE date_col = LAST_DAY(date_col);

#time precision test
EXPLAIN SELECT id, time_col FROM datetime_types WHERE time_col < '12:00:00.001.00';
SELECT id, time_col FROM datetime_types WHERE time_col < '12:00:00.001.00';
EXPLAIN SELECT id, datetime_col FROM datetime_types WHERE datetime_col = '2023-01-01 12:00:00.001.00';
SELECT id, datetime_col FROM datetime_types WHERE datetime_col = '2023-01-01 12:00:00.001.00';
EXPLAIN SELECT id, timestamp_col FROM datetime_types WHERE timestamp_col > '2025-07-08 22:49:22:00.001.00';
SELECT id, timestamp_col FROM datetime_types WHERE timestamp_col > '2025-07-08 22:49:22:00.001.00';

CREATE TABLE string_types (
    id INT AUTO_INCREMENT PRIMARY KEY,
    char_col CHAR(10),
    varchar_col VARCHAR(100),
    binary_col BINARY(5),
    varbinary_col VARBINARY(100),
    tinytext_col TINYTEXT,
    text_col TEXT,
    enum_col ENUM('small', 'medium', 'large'),
    set_col SET('red', 'green', 'blue', 'yellow')
);

INSERT INTO string_types VALUES
(1, 'fixed', 'Variable length string', 'abcde', 'binary data', 'Short text', 'This is a longer text field', 'small', 'red,green'),
(2, 'hello', 'MySQL data types', '12345', 'more binary', 'Tiny text', 'Lorem ipsum dolor sit amet', 'medium', 'blue'),
(3, 'world', 'Example varchar', 'ABCDE', 'data', 'Sample', 'Consectetur adipiscing elit', 'large', 'yellow'),
(4, 'test', 'Another example', '!@#$%', 'binary', 'Content', 'Sed do eiusmod tempor', 'small', 'red,blue'),
(5, 'data', 'String values', '67890', 'information', 'Info', 'Incididunt ut labore', 'medium', 'green,yellow'),
(6, 'types', 'Database table', 'XYZ12', 'storage', 'Details', 'Et dolore magna aliqua', 'large', 'red,green,blue'),
(7, 'mysql', 'Relational DB', 'QWERT', 'bytes', 'Summary', 'Ut enim ad minim veniam', 'small', 'blue,yellow'),
(8, 'sample', 'Test data', 'ASDFG', 'raw data', 'Abstract', 'Quis nostrud exercitation', 'medium', 'red'),
(9, 'string', 'Character data', 'HJKLM', 'binary info', 'Brief', 'Ullamco laboris nisi', 'large', 'green'),
(10, 'value', 'Last example', 'NOPQR', 'final data', 'Closing', 'Ut aliquip ex ea commodo', 'small', 'red,green,blue,yellow');

