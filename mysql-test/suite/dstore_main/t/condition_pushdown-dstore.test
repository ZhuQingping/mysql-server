EXPLAIN SELECT a, b, c, d FROM bt WHERE 'Baba' BETWEEN c and d;
EXPLAIN SELECT a, b, c, d FROM bt WHERE 5 BETWEEN c and d;

CREATE TABLE tm_trunc (
    a time DEFAULT NULL,
    b time(3) DEFAULT NULL,
    c time(6) DEFAULT NULL
);

