#prepare statements test

# TINYINT Type Tests
PREPARE stmt_e from 'EXPLAIN SELECT id, tiny_int_col FROM numeric_types WHERE tiny_int_col = ?;';
PREPARE stmt_s from 'SELECT id, tiny_int_col FROM numeric_types WHERE tiny_int_col = ?;';
set @a = -128;
execute stmt_e using @a;
execute stmt_s using @a;

# SMALLINT Type Tests
PREPARE stmt_e from 'EXPLAIN SELECT id, small_int_col FROM numeric_types WHERE small_int_col = ?;';
PREPARE stmt_s from 'SELECT id, small_int_col FROM numeric_types WHERE small_int_col = ?;';
set @a = -32768;
execute stmt_e using @a;
execute stmt_s using @a;

# MEDIUMINT Type Tests
PREPARE stmt_e from 'EXPLAIN SELECT id, medium_int_col FROM numeric_types WHERE medium_int_col = ?;';
PREPARE stmt_s from 'SELECT id, medium_int_col FROM numeric_types WHERE medium_int_col = ?;';
set @a = -8388608;
execute stmt_e using @a;
execute stmt_s using @a;

# INT Type Tests
PREPARE stmt_e from 'EXPLAIN SELECT id, int_col FROM numeric_types WHERE int_col BETWEEN ? AND ?;';
PREPARE stmt_s from 'SELECT id, int_col FROM numeric_types WHERE int_col BETWEEN ? AND ?;';
set @a = -1000000000;
set @b = 2000000000;
execute stmt_e using @a, @b;
execute stmt_s using @a, @b;

# DECIMAL Type Tests
PREPARE stmt_e from 'EXPLAIN SELECT id, decimal_col FROM numeric_types WHERE decimal_col = ?;';
PREPARE stmt_s from 'SELECT id, decimal_col FROM numeric_types WHERE decimal_col = ?;';
set @a = 12345.67;
execute stmt_e using @a;
execute stmt_s using @a;

# FLOAT and DOUBLE Type Tests
PREPARE stmt_e from 'EXPLAIN SELECT id, float_col FROM numeric_types WHERE float_col < ?;';
PREPARE stmt_s from 'SELECT id, float_col FROM numeric_types WHERE float_col < ?;';
set @a = 1234.5678;
execute stmt_e using @a;
execute stmt_s using @a;

# FLOAT and DOUBLE Type Tests
PREPARE stmt_e from 'EXPLAIN SELECT id, boolean_col FROM numeric_types WHERE boolean_col = ?;';
PREPARE stmt_s from 'SELECT id, boolean_col FROM numeric_types WHERE boolean_col = ?;';
set @a = TRUE;
execute stmt_e using @a;
execute stmt_s using @a;
set @a = 'FALSE';
execute stmt_e using @a;
execute stmt_s using @a;

# CHAR and VARCHAR Type Tests
