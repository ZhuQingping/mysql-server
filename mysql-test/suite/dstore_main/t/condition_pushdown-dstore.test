PREPARE stmt_s from 'SELECT id, char_col FROM string_types WHERE char_col = ?;';
set @a = 'ABC';
execute stmt_e using @a;
execute stmt_s using @a;

# Basic Date and Time Queries
PREPARE stmt_e from 'EXPLAIN SELECT id, date_col FROM datetime_types WHERE date_col BETWEEN ? AND ?;';
PREPARE stmt_s from 'SELECT id, date_col FROM datetime_types WHERE date_col BETWEEN ? AND ?;';
set @a = '2023-01-01';
set @b = '2023-06-30';
execute stmt_e using @a, @b;
execute stmt_s using @a, @b;

PREPARE stmt_e from 'EXPLAIN SELECT id, time_col FROM datetime_types WHERE time_col BETWEEN ? AND ?;';
PREPARE stmt_s from 'SELECT id, time_col FROM datetime_types WHERE time_col BETWEEN ? AND ?;';
set @a = '09:00:00';
set @b = '17:00:00';
execute stmt_e using @a, @b;
execute stmt_s using @a, @b;

PREPARE stmt_e from 'EXPLAIN SELECT id, datetime_col FROM datetime_types WHERE datetime_col BETWEEN ? AND ?;';
PREPARE stmt_s from 'SELECT id, datetime_col FROM datetime_types WHERE datetime_col BETWEEN ? AND ?;';
set @a = '2023-01-01 00:00:00';
set @b = '2023-12-31 23:59:59';
execute stmt_e using @a, @b;
execute stmt_s using @a, @b;

# Date Arithmetic
PREPARE stmt_e from 'EXPLAIN SELECT id, date_col FROM datetime_types WHERE date_col = ?;';
PREPARE stmt_s from 'SELECT id, date_col FROM datetime_types WHERE date_col = ?;';
set @a = DATE_ADD('2023-01-01', INTERVAL 30 DAY);
execute stmt_e using @a;
execute stmt_s using @a;

# TIMESTAMP Specific Queries
PREPARE stmt_e from 'EXPLAIN SELECT id, timestamp_col FROM datetime_types WHERE timestamp_col > ?;';
PREPARE stmt_s from 'SELECT id, timestamp_col FROM datetime_types WHERE timestamp_col > ?;';
set @a = '2025-07-08 22:49:22' - INTERVAL 1 HOUR;
execute stmt_e using @a;
execute stmt_s using @a;

# YEAR Type Queries
PREPARE stmt_e from 'EXPLAIN SELECT id, year_col FROM datetime_types WHERE year_col BETWEEN ? AND ?;';
PREPARE stmt_s from 'SELECT id, year_col FROM datetime_types WHERE year_col BETWEEN ? AND ?;';
set @a = 2020;
set @b = 2025;
execute stmt_e using @a, @b;
execute stmt_s using @a, @b;
PREPARE stmt_overflow from 'SELECT id, year_col FROM datetime_types WHERE year_col > ?;';
set @a = 2147483647;
execute stmt_overflow using @a;

