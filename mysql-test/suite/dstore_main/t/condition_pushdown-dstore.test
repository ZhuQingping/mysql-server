# Item_REF
CREATE TABLE t1 (f1 INT, f2 INT);
INSERT INTO t1 VALUES (1, 0), (2, 1), (3, 2);
CREATE TABLE t2 (f1 INT, f2 INT);
SELECT t1.f1
FROM t1
HAVING (3, 2) IN (SELECT f1, f2 FROM t2) AND t1.f1  >= 0
ORDER BY t1.f1;

# generated column and instant DDL
CREATE TABLE gen (
    a INT PRIMARY KEY,
    b INT,
    c INT GENERATED ALWAYS AS (a + b) VIRTUAL,
    d INT,
    e INT GENERATED ALWAYS AS (b * d /100) STORED,
    f INT
);
INSERT INTO gen (a, b, d, f) VALUES
(1, 10, 100, 1000),
(2, 20, 200, 2000),
(3, 30, 300, 3000);

explain select * from gen where b<20;
explain select * from gen where c<20;
explain select * from gen where d<200;
explain select * from gen where e<40;
explain select * from gen where f<2000;

alter table gen  ADD COLUMN g VARCHAR(16);
INSERT INTO gen (a, b, d, f, g) VALUES(4, 40, 400, 4000, 'Tom');
explain select * from gen where g='Tom';
select * from gen where g='Tom';
alter table gen drop COLUMN g;
alter table gen  ADD COLUMN h INT;
INSERT INTO gen (a, b, d, f, h) VALUES(5, 50, 500, 5000, 999);
select * from gen where h=999;

