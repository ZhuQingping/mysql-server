--source include/have_only_dstore.inc

#Want to skip this test from daily Valgrind execution
--source include/no_valgrind_without_big.inc
# 
# Run select.inc with index_condition_pushdown and MRR
#

set optimizer_switch='index_condition_pushdown=on,mrr=on,mrr_cost_based=off';
# tentatively switch off histogram due to known bug
set optimizer_switch='dstore_use_histogram_range_estimation=off';

--disable_query_log
if (`select locate('semijoin', @@optimizer_switch) > 0`) 
{
  set optimizer_switch='semijoin=off';
}
if (`select locate('materialization', @@optimizer_switch) > 0`) 
{
  set optimizer_switch='materialization=off';
}
--enable_query_log

--source include/select-dstore.inc

set optimizer_switch=default;
