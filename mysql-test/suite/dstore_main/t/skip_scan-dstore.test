--source include/have_only_dstore.inc
set @optimizer_switch_saved= @@optimizer_switch;
set optimizer_switch="dstore_use_histogram_range_estimation=off";
set @dstore_use_histogram_auto_update_saved=@@dstore_use_histogram_auto_update;
set global dstore_use_histogram_auto_update=off;

let $engine=Dstore;
--source include/skip_scan_test-dstore.inc

--echo #
--echo # Bug#28089360 WL#11322: SIG11 AT QEP_SHARED_OWNER::JOIN | SQL/SQL_OPT_EXEC_SHARED.H:458
--echo #

CREATE TABLE t1 (f1 INT(11), f2 VARCHAR(1), KEY k1 (f2, f1));
INSERT INTO t1 VALUES (-682212662,'c'), (-1974921822,'C'), (1260604936,'9');

CREATE TABLE t2 (f1 INT(11));
INSERT INTO t2 VALUES (824388284), (1186821161);

CREATE VIEW v1 AS select f1, f2 from t1;

DELETE FROM t2 WHERE (f1, f1) IN (SELECT f1,f2 FROM v1 WHERE f1 >= 2);

DROP VIEW v1;
DROP TABLE t1, t2;

--echo #
--echo # Bug #29602393 ASSERTION `BITMAP_IS_SET(KEY_INFO->TABLE->READ_SET,
--echo #                                        KEY_INFO->KEY_PART.*FAILED
--echo #

# CREATE TABLE t1(f1 INT, f2 VARCHAR(64) NOT NULL, PRIMARY KEY (f1))
# PARTITION BY RANGE(f1)
# (
#   PARTITION p1 VALUES LESS THAN (3),
#   PARTITION p2 VALUES LESS THAN (maxvalue)
# );
# INSERT INTO t1 VALUES (1, 'abcde'), (2, 'abcde'), (3, 'abcde');
# CREATE INDEX idx1 ON t1(f2);
# ANALYZE TABLE t1;

# EXPLAIN SELECT /*+ SKIP_SCAN(t1 idx1) */ count(*) FROM t1 WHERE f1 <= 3;
# SELECT /*+ SKIP_SCAN(t1 idx1) */ count(*) FROM t1 WHERE f1 <= 3;

# DROP TABLE t1;

--echo #
--echo # Bug 33251616 - NO_SKIP_SCAN hint disables skip scan for all indexes
--echo #

CREATE TABLE t1(c1 INT, c2 INT, c3 INT, c4 INT);
CREATE UNIQUE INDEX i1_t1 ON t1(c1,c2,c3);
CREATE UNIQUE INDEX i2_t1 ON t1(c1,c2,c4);
INSERT INTO t1 VALUES (1,1,1,1), (1,1,2,2), (1,3,3,3), (1,4,4,4), (1,5,5,5),
                      (2,1,1,1), (2,2,2,2), (2,3,3,3), (2,4,4,4), (2,5,5,5);
INSERT INTO t1 SELECT c1, c2, c3+5, c4+10  FROM t1;
INSERT INTO t1 SELECT c1, c2, c3+10, c4+20 FROM t1;
INSERT INTO t1 SELECT c1, c2, c3+20, c4+40 FROM t1;
INSERT INTO t1 SELECT c1, c2, c3+40, c4+80 FROM t1;
ANALYZE TABLE t1;

EXPLAIN SELECT c1, c2 FROM t1 WHERE c2 > 40;

# the other index(i2_t1) should be used for skip_scan
EXPLAIN SELECT /*+NO_SKIP_SCAN(t1 i1_t1)*/ c1, c2 FROM t1 WHERE c2 > 40;

# index i1_t1 should be used for skip_scan
EXPLAIN SELECT /*+NO_SKIP_SCAN(t1 i2_t1)*/ c1, c2 FROM t1 WHERE c2 > 40;

# skip_scan should not be used for table t1
EXPLAIN SELECT /*+NO_SKIP_SCAN(t1)*/  c1, c2 FROM t1 WHERE c2 > 40;

# force skip_scan to use index i2_t1
EXPLAIN SELECT /*+SKIP_SCAN(t1 i2_t1)*/  c1, c2 FROM t1 WHERE c2 > 40;

SET OPTIMIZER_SWITCH = 'skip_scan=off';
# skip_scan should not be used
EXPLAIN SELECT c1, c2 FROM t1 WHERE c2 > 40;

DROP TABLE t1;
SET OPTIMIZER_SWITCH = default;

--echo #
--echo # BUG2025050823235 - skip scan result in dead loop, causing query can not end
--echo #
CREATE TABLE t (
  a bigint DEFAULT NULL,
  b bigint DEFAULT NULL,
  c varchar(200) DEFAULT NULL,
  KEY idx (a,b desc,c)
) ENGINE=Dstore;

INSERT INTO t VALUES(NULL, 1, 'h1');
INSERT INTO t VALUES(NULL, NULL, 'world');
ANALYZE TABLE t;
EXPLAIN SELECT * FROM t WHERE c = 'h2';
SELECT * FROM t WHERE c = 'h2';
EXPLAIN SELECT * FROM t WHERE c = 'h1';
SELECT * FROM t WHERE c = 'h1';

EXPLAIN SELECT/*+ SKIP_SCAN(t) */ * FROM t WHERE c = 'h2';
SELECT/*+ SKIP_SCAN(t) */ * FROM t WHERE c = 'h2';
EXPLAIN SELECT/*+ SKIP_SCAN(t) */ * FROM t WHERE c = 'h1';
SELECT/*+ SKIP_SCAN(t) */ * FROM t WHERE c = 'h1';

DROP TABLE t;

--echo #
--echo # BUG2025041529169 - skip scan result in wrong result issue
--echo #
CREATE TABLE t(a INT NOT NULL, b INT NOT NULL, c INT NOT NULL, d INT NOT NULL, e INT NOT NULL, PRIMARY KEY (a DESC,b,c DESC,d));
INSERT INTO t VALUES(5, 2, 5, 1, 1);
INSERT INTO t VALUES(5, 2, 4, 2, 2);
INSERT INTO t VALUES(5, 2, 3, 1, 3);
INSERT INTO t VALUES(1, 2, 5, 2, 4);
INSERT INTO t VALUES(1, 2, 4, 1, 5);
INSERT INTO t VALUES(1, 2, 3, 1, 6);
ANALYZE TABLE t;

# Dstore do not support skip scan for this scenario
EXPLAIN SELECT /*+ SKIP_SCAN(t) */ a, b, c, d FROM t WHERE a IN (1, 5) AND b in (2) AND d <= 2;
SELECT /*+ SKIP_SCAN(t) */ a, b, c, d FROM t WHERE a IN (1, 5) AND b in (2) AND d <= 2;
DROP TABLE t;

CREATE TABLE t(a INT, b INT, c INT, d INT, UNIQUE KEY idx1(a,b DESC,c DESC,d));
INSERT INTO t VALUES(5, 5, 1, 1);
INSERT INTO t VALUES(5, 4, 2, 2);
INSERT INTO t VALUES(5, 3, 1, 3);
INSERT INTO t VALUES(5,null,3, 0);
INSERT INTO t VALUES(1, 5, 2, 4);
INSERT INTO t VALUES(1, 4, 1, 5);
INSERT INTO t VALUES(1, 3, 1, 6);
ANALYZE TABLE t;

# Dstore do not support skip scan for this scenario
EXPLAIN SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND d < 5;
SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND d < 5;

# Dstore support skip scan for this scenario
EXPLAIN SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND c < 3;
SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND c < 3;
EXPLAIN SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND (c < 3 OR c is null);
SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND (c < 3 OR c is null);

ALTER TABLE t DROP INDEX idx1;
ALTER TABLE t ADD INDEX idx1(a DESC, b, c DESC, d);

# Dstore do not support skip scan for this scenario
EXPLAIN SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND d < 5;
SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND d < 5;
EXPLAIN SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a between 4 AND 6 AND (c < 3 OR c IS NULL);
SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a between 4 AND 6 AND (c < 3 OR c IS NULL);

# Dstore support skip scan for this scenario
EXPLAIN SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND c < 3;
SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND c < 3;
EXPLAIN SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a is null AND c < 3;
SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a is null AND c < 3;
EXPLAIN SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND (c < 3 OR c IS NULL);
SELECT/*+ SKIP_SCAN(t) */ a,b,c,d FROM t WHERE a=5 AND (c < 3 OR c IS NULL);
DROP TABLE t;

SET optimizer_switch=@optimizer_switch_saved;
SET global dstore_use_histogram_auto_update=@dstore_use_histogram_auto_update_saved;
