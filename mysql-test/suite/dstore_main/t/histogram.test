-- echo #
-- echo # BUG2026031043747 When using histograms to estimate the filter selectivity of a DECIMAL column in a WHERE clause.
-- echo # if the comparison value is derived from a reproducible condition involving complex calculations.
-- echo # it may result in an invalid value. This can lead to a null pointer when retrieving the condition, causing an error during the comparison process.
-- echo #
--disable_warnings
create table t1(c1 decimal(10,0) DEFAULT NULL) engine=dstore;
insert into t1 values(1.0);
insert into t1 values(2.0);
analyze table t1 update histogram on c1;

create table t2(c1 timestamp(6) NOT NULL) engine=dstore;
CREATE VIEW `v0` (`c0`) AS select `t2`.`c1` from `t2` where ((0 <> '2003-08-23 20:51:08') is null) group by `t2`.`c1`;

select t1.c1 from v0, t1 WHERE (t1.c1) != (LEAST('1', v0.c0));
--enable_warnings
drop table t1,t2;
drop view v0;
