# Test for BUG2025042133874
CREATE TABLE t1 (v0 VARCHAR(28), v1 VARCHAR(14), t2 BOOL, c3 CHAR(26), i4 INT, v5 VARCHAR(24), i6 INT AUTO_INCREMENT, i7 INT, v8 VARCHAR(15), v9 VARCHAR(11), d10 DOUBLE, d11 DOUBLE, f12 FLOAT, i13 INT, v14 VARCHAR(10), f15 FLOAT, v16 VARCHAR(19), c17 CHAR(25), f18 FLOAT, g19 VARCHAR(15) AS (CONCAT(SUBSTRING(f15,1,1),SUBSTRING(f15,1,5),SUBSTRING(f12,1,1),SUBSTRING(d11,1,6),SUBSTRING(v0,1,1),t2)) STORED, v20 VARCHAR(17), g21 VARCHAR(16) AS (CONCAT(SUBSTRING(f15,1,3),SUBSTRING(c17,1,2),SUBSTRING(v9,1,1),SUBSTRING(v20,1,4),SUBSTRING(v9,1,4),SUBSTRING(f12,1,2))), g22 VARCHAR(17) AS (CONCAT(SUBSTRING(c17,1,1),SUBSTRING(v0,1,2),t2,SUBSTRING(f15,1,2),SUBSTRING(i13,1,2),SUBSTRING(f15,1,2),SUBSTRING(v0,1,2),SUBSTRING(i13,1,2),SUBSTRING(d11,1,2),t2)), INDEX tt_8i0(g19, v14) , INDEX tt_8i1(i6 ASC, g19 ASC, v16 DESC, c17, v20 DESC, g22) ) ROW_FORMAT=REDUNDANT;
INSERT INTO t1 ( v0 ,v1 ,t2 ,c3 ,i4 ,v5 ,i6 ,i7 ,v8 ,v9 ,d10 ,d11 ,f12 ,i13 ,v14 ,f15 ,v16 ,c17 ,f18 ,g19 ,v20 ,g21 ,g22 ) VALUES( 'fDsRJmX3yd', 'cc3ia7huS2M', false, 'qZx1BxThYY3qA1SektmaoeOTk2', 4896, 'PquV4yeVWQIziFy', 621297, 770675, 'wWKiJ6ZdeswX', '', 0.00000, 0.00000, 0.00, 429452, 'BIkxFZF7pp', 0.00, 'voBW2kAm', 'W3FWtlr5', 0.00, default, '0gGsUC9Je26', default, default ) ;
ALTER TABLE t1 MODIFY COLUMN  v14 VARCHAR(20), LOCK=DEFAULT, ALGORITHM=instant;
SHOW CREATE TABLE t1;
DROP TABLE t1;


# Tests for tinyint type
--echo # Autoinc with [tinyint signed + ascending index + min value]
CREATE TABLE Tiny_1(id TINYINT AUTO_INCREMENT, c1 TINYINT, PRIMARY KEY(id));
INSERT INTO Tiny_1 VALUES(-128,-1),(-127,-2);

--echo # Autoinc with [tinyint signed + ascending index + max value]
CREATE TABLE Tiny_2(id TINYINT AUTO_INCREMENT, c1 TINYINT, PRIMARY KEY(id));
INSERT INTO Tiny_2 VALUES(126,-1),(127,-2);

--echo # Autoinc with [tinyint signed + descending index + min value]
CREATE TABLE Tiny_3(id TINYINT AUTO_INCREMENT, c1 TINYINT, PRIMARY KEY(id DESC));
INSERT INTO Tiny_3 VALUES(-128,-1),(-127,-2);

--echo # Autoinc with [tinyint signed + descending index + max value]
CREATE TABLE Tiny_4(id TINYINT AUTO_INCREMENT, c1 TINYINT, PRIMARY KEY(id DESC));
INSERT INTO Tiny_4 VALUES(126,-1),(127,-2);

--echo # Autoinc with [tinyint unsigned + ascending index + max value]
CREATE TABLE TinyUsigned_1(id TINYINT UNSIGNED AUTO_INCREMENT, c1 TINYINT, PRIMARY KEY(id));
INSERT INTO TinyUsigned_1 VALUES(254,-1),(255,-2);

--echo # Autoinc with [tinyint unsigned + descending index + max value]
CREATE TABLE TinyUsigned_2(id TINYINT UNSIGNED AUTO_INCREMENT, c1 TINYINT, PRIMARY KEY(id DESC));
INSERT INTO TinyUsigned_2 VALUES(254,-1),(255,-2);

--echo # Autoinc with [tinyint unsigned + multi-column index + max value]
CREATE TABLE TinyUsigned_3(id TINYINT UNSIGNED AUTO_INCREMENT, c1 TINYINT, INDEX idx1(id, c1));
INSERT INTO TinyUsigned_3 VALUES(254,-1),(255,-2);


