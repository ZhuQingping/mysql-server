#
# BUG2025050927659 Concurrent execution of update and delete operations on rows
# with BLOB fields results in error 1020.
#

USE test;
CREATE TABLE t1 (
 `rid` bigint unsigned NOT NULL AUTO_INCREMENT,
 `nid` bigint DEFAULT NULL,
 `level` int DEFAULT NULL,
 `vip` int DEFAULT NULL,
 `vip_exp` int DEFAULT NULL,
 `reg_channel` int DEFAULT NULL,
 `guild_id` bigint unsigned DEFAULT '0',
 `guild_open` tinyint(1) DEFAULT '0',
 `forbid_login_time` bigint DEFAULT NULL,
 `forbid_talk_time` bigint DEFAULT NULL,
 `ctime` bigint DEFAULT NULL,
 `mtime` datetime(3) DEFAULT NULL,
 `last_offline_time` bigint DEFAULT NULL,
 `friend_open` tinyint(1) DEFAULT '0',
 `user_data_str` blob,
 `name` varchar(64) DEFAULT NULL,
 `db_fix_version` int DEFAULT '0',
 PRIMARY KEY (`rid`),
 KEY `idx_users_99_nid` (`nid`),
 KEY `idx_users_99_level` (`level`),
 KEY `idx_users_99_ctime` (`ctime`),
 KEY `idx_users_99_mtime` (`mtime`),
 KEY `idx_users_99_last_offline_time` (`last_offline_time`),
 KEY `idx_users_99_name` (`name`)
);

INSERT INTO `t1` (   `nid`, `level`, `vip`, `vip_exp`, `reg_channel`, `guild_id`, `guild_open`,    `forbid_login_time`, `forbid_talk_time`, `ctime`, `mtime`, `last_offline_time`,    `friend_open`, `user_data_str`, `name`, `db_fix_version` ) VALUES (   1002, 2, 0, 0, 1, 0, 0, NULL, NULL, 1696447496, '2023-10-05 12:34:56.789', NULL, 0,    CONCAT(     REPEAT('Test Data ', 1024),     REPEAT('More Data ', 1024)   ),   'TestUser2', 0 );

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
BEGIN;

connection con2;
BEGIN;

connection con1;
UPDATE t1 SET level=level+1 WHERE rid=4393751671200;

connection con2;
--send DELETE FROM t1 WHERE rid=4393751671201;

connection con1;
COMMIT;

connection con2;
--reap
COMMIT;

connection default;
DROP TABLE t1;

--disconnect con1
--disconnect con2

--echo #
--echo # BUG2026020238486 When the LOB is less than 2K, the memory of tupleWithLob is freed repeatedly.
--echo #

CREATE TABLE t1 (
    employee_id VARCHAR(32) PRIMARY KEY NOT NULL,
    email VARCHAR(150),
	brief_description VARCHAR(60000) CHARSET latin1,
    j JSON DEFAULT NULL
);

INSERT INTO t1 (employee_id, email,  brief_description,j) VALUES
('U001', 'zhangsan@example.com', repeat('I am zhangsan', 30),'"2019-1-1"'),
('U002', 'lisi@example.com',repeat('A', 60000), '"2019-01-02"'),
('U003', 'wangwu@example.com',  repeat('I am wangwu', 60), CAST(DATE'2019-1-3' AS JSON)),
('U004', 'zhaoliu@example.com',  repeat('Make zhaoliu great again!', 60), CAST(DATE'2020-1-5' AS JSON)),
('U005', 'qianqi@example.com',  repeat('waaaaagh!', 5000), CAST(DATE'2020-1-30' AS JSON));

UPDATE t1 SET brief_description = repeat('I am zhangsan', 10) WHERE employee_id = 'U001';
UPDATE t1 SET brief_description = repeat('I am zhangsan', 1000) WHERE employee_id = 'U001';
UPDATE t1 SET brief_description = repeat('I am zhangsan', 10) WHERE employee_id = 'U001';
UPDATE t1 SET brief_description = repeat('I am zhangsan', 2000) WHERE employee_id = 'U001';
UPDATE t1 SET brief_description = repeat('I am zhangsan', 3000) WHERE employee_id = 'U001';
UPDATE t1 SET brief_description = repeat('I am zhangsan', 20) WHERE employee_id = 'U001';
UPDATE t1 SET brief_description = repeat('I am zhangsan', 300) WHERE employee_id = 'U001';
select * from t1 where employee_id = 'U001';
UPDATE t1 SET brief_description = repeat('I am zhangsan', 1000) WHERE employee_id = 'U001';
select * from t1 where employee_id = 'U001';

DROP TABLE t1;