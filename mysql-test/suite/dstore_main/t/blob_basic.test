# ==== Purpose ====
# 
# Testing the basic operations (such as create, insert, update, delete, etc.) and boundary values of the BLOB and TEXT data types.
# 
--source include/have_only_dstore.inc
--source include/have_debug.inc
use test;
--echo # 
--echo # 1. A single BLOB column.
--echo # 
CREATE TABLE blob_text_test1 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    blob_col BLOB
) engine=Dstore;

INSERT INTO blob_text_test1 (blob_col) VALUES (REPEAT('A', 120));
SELECT LENGTH(blob_col) from blob_text_test1;
UPDATE blob_text_test1 SET blob_col = 'Updated TinyText' WHERE id = 1;
SELECT LENGTH(blob_col) from blob_text_test1;
UPDATE blob_text_test1 SET blob_col = REPEAT('A', 3000) WHERE id = 1;
SELECT LENGTH(blob_col) from blob_text_test1 where id = 1;

INSERT INTO blob_text_test1 (blob_col) VALUES (REPEAT('A', 3000));
SELECT LENGTH(blob_col) from blob_text_test1;
UPDATE blob_text_test1 SET blob_col = REPEAT('A', 3100) WHERE id = 2;
SELECT LENGTH(blob_col) from blob_text_test1;
UPDATE blob_text_test1 SET blob_col = 'Updated TinyText' WHERE id = 2;
SELECT LENGTH(blob_col) from blob_text_test1 where id = 1;
DELETE FROM blob_text_test1 WHERE id = 2;
SELECT * from blob_text_test1;

CREATE TABLE blob_text_test2 (
    id INT,
    blob_col BLOB
) engine=Dstore;

INSERT INTO blob_text_test2 (id, blob_col) VALUES (1, REPEAT('A', 120));
SELECT LENGTH(blob_col) from blob_text_test2;
UPDATE blob_text_test2 SET blob_col = 'Updated TinyText' WHERE id = 1;
SELECT LENGTH(blob_col) from blob_text_test2;
UPDATE blob_text_test2 SET blob_col = REPEAT('A', 3000) WHERE id = 1;
SELECT LENGTH(blob_col) from blob_text_test2 where id = 1;

INSERT INTO blob_text_test2 (id, blob_col) VALUES (2, REPEAT('A', 3000));
SELECT LENGTH(blob_col) from blob_text_test2;
UPDATE blob_text_test2 SET blob_col = REPEAT('A', 3100) WHERE id = 2;
SELECT LENGTH(blob_col) from blob_text_test2;
UPDATE blob_text_test2 SET blob_col = 'Updated TinyText' WHERE id = 2;
SELECT LENGTH(blob_col) from blob_text_test2 where id = 1;
DELETE FROM blob_text_test2 WHERE id = 2;
SELECT * from blob_text_test2;

--echo # 
--echo # 2. Multiple BLOB columns.
--echo # 
CREATE TABLE blob_text_test3 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    tiny_blob_col TINYBLOB,
    blob_col BLOB
) engine=Dstore;

INSERT INTO blob_text_test3 (tiny_blob_col, blob_col) VALUES (REPEAT('A', 255), REPEAT('B', 3000));
SELECT LENGTH(tiny_blob_col), LENGTH(blob_col) from blob_text_test3;
UPDATE blob_text_test3 SET blob_col = 'Updated TinyText' WHERE id = 1;
SELECT LENGTH(tiny_blob_col), LENGTH(blob_col) from blob_text_test3;
UPDATE blob_text_test3 SET blob_col = REPEAT('A', 3000) WHERE id = 1;
SELECT LENGTH(tiny_blob_col),LENGTH(blob_col) from blob_text_test3 where id = 1;

INSERT INTO blob_text_test3 (tiny_blob_col, blob_col) VALUES (2, REPEAT('A', 3000));
SELECT LENGTH(tiny_blob_col), LENGTH(blob_col) from blob_text_test3;
UPDATE blob_text_test3 SET blob_col = REPEAT('A', 3100) WHERE id = 2;
SELECT LENGTH(tiny_blob_col), LENGTH(blob_col) from blob_text_test3;
UPDATE blob_text_test3 SET blob_col = 'Updated TinyText' WHERE id = 2;
SELECT LENGTH(tiny_blob_col), LENGTH(blob_col) from blob_text_test3 where id = 1;
DELETE FROM blob_text_test3 WHERE id = 2;
SELECT * from blob_text_test3;

SET SESSION DEBUG='+d,data_type_conversion_injection';
CREATE TABLE blob_text_test4 (
    id INT PRIMARY KEY AUTO_INCREMENT,
    tinyblob_col TINYBLOB,
    tinytext_col TINYTEXT,
    blob_col BLOB,
    text_col TEXT
) engine=Dstore;
SET SESSION DEBUG='-d,data_type_conversion_injection';

INSERT INTO blob_text_test4 (tinyblob_col, tinytext_col, blob_col, text_col) 
VALUES (NULL, NULL, NULL, NULL),
       ('', '', '', ''),
       ('Data', 'Data', UNHEX('5000'), 'Data');

SELECT * FROM blob_text_test4;

INSERT INTO blob_text_test4 (tinyblob_col, tinytext_col, blob_col, text_col) 
VALUES (REPEAT('A', 255), REPEAT('B', 255), REPEAT('C', 65535), REPEAT('D', 65535));

SELECT id, LENGTH(text_col) FROM blob_text_test4 WHERE CHAR_LENGTH(text_col) > 1000;
SELECT id, LENGTH(HEX(text_col)) FROM blob_text_test4 WHERE text_col LIKE '%SQL%';
SELECT LENGTH(HEX(text_col)) FROM blob_text_test4 WHERE id = 4;
SELECT OCTET_LENGTH(text_col), CHAR_LENGTH(text_col) FROM blob_text_test4;
SELECT id, HEX(SUBSTRING(blob_col, 1, 4)) AS hex_data FROM blob_text_test4;
SELECT id, SUBSTRING(text_col, 1, 10) AS text_preview FROM blob_text_test4;
SELECT id, CHAR_LENGTH(tinytext_col) AS text_length FROM blob_text_test4 WHERE CHAR_LENGTH(tinytext_col) > 50;
SELECT id, text_col FROM blob_text_test4 WHERE text_col LIKE '%specific substring%';

ANALYZE TABLE blob_text_test4 UPDATE HISTOGRAM ON id;

UPDATE blob_text_test4 SET text_col = REPEAT('C', 5000), text_col = REPEAT('D', 10000) WHERE id = 3;
UPDATE blob_text_test4 SET text_col = REPEAT('N', 255), text_col = REPEAT('S', 3000) WHERE id = 4;

DELETE FROM blob_text_test4 WHERE id = 14;

TRUNCATE TABLE blob_text_test4;

--echo # 
--echo # 3. Table structure includes secondary indexes.
--echo # 

CREATE TABLE `blob_text_test5` (
  id int DEFAULT NULL,
  id2 int DEFAULT NULL,
  blob_col BLOB,
  KEY `idx_id` (`id`)
);

INSERT INTO blob_text_test5 (id, id2, blob_col) VALUES (1, 1, REPEAT('A', 3000)), (2, 2, REPEAT('B', 100)), (3, 3, REPEAT('C', 100)), (4, 4, REPEAT('D', 100));

UPDATE blob_text_test5 set id=5 where id = 1; # use ha_cde::rnd_pos
UPDATE blob_text_test5 set id=10 where id = 5;

ALTER TABLE blob_text_test5 ADD INDEX idx(id2), ALGORITHM = INPLACE;

--error ER_DATA_TOO_LONG
INSERT INTO blob_text_test4 (tinyblob_col) VALUES(REPEAT('G',256));

--error ER_DATA_TOO_LONG
INSERT INTO blob_text_test4 (text_col) VALUES(REPEAT('G',65536));


UPDATE blob_text_test4 SET tinytext_col = REPEAT('G',256) WHERE id = 1;

INSERT INTO blob_text_test4 (tinyblob_col, tinytext_col, blob_col, text_col) 
VALUES (REPEAT('A', 255), REPEAT('B', 255), REPEAT('C', 65535), REPEAT('D', 65535));

--error ER_DATA_TOO_LONG
UPDATE blob_text_test4 SET tinytext_col = REPEAT('G',256) WHERE id = 1;

--error ER_DATA_TOO_LONG
UPDATE blob_text_test4 SET blob_col = REPEAT('G',65536) WHERE id = 1;

--echo # 
--echo # 5. MVCC
--echo # 
# RR
create table blob_text_test6(id int, blob_col blob) engine=Dstore;
connect (con1,localhost,root,,);
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
begin;
insert into blob_text_test6 values(1, repeat('Q', 3000));

connection default;
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
begin;
insert into blob_text_test6 values(2, repeat('A', 3500));
select id, LENGTH(blob_col) from blob_text_test6;

connection con1;
commit;

connection default;
select id, LENGTH(blob_col) from blob_text_test6;
commit;
select id, LENGTH(blob_col) from blob_text_test6;

connection default;
disconnect con1;

# RC
create table blob_text_test7(id int, blob_col blob) engine=Dstore;
connect (con1,localhost,root,,);
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;
begin;
insert into blob_text_test7 values(1, repeat('Q', 3000));

connection default;
SET TRANSACTION ISOLATION LEVEL READ COMMITTED;
begin;
insert into blob_text_test7 values(2, repeat('A', 3500));
select id, LENGTH(blob_col) from blob_text_test7;

connection con1;
commit;

connection default;
select id, LENGTH(blob_col) from blob_text_test7;
commit;

connection default;
disconnect con1;

