--echo # 
--echo # 9. Testing the scenario where a table contains LOB-type columns but the query does not involve these columns.
--echo # 
CREATE TABLE blob_text_test20 (
  `id_col` int NOT NULL AUTO_INCREMENT,
  `bigint_col` bigint NOT NULL,
  `datetime_col` datetime(6) DEFAULT NULL,
  `varchar_col` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  `blob_col` blob,
  `mediumblob_col` blob NOT NULL,
  `year_col` year DEFAULT NULL,
  `enum_col` enum('aaa','bbb','ccc') CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL,
  `set_col` set('111','222','333') CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL,
  `char_col` char(1) DEFAULT NULL,
  PRIMARY KEY (`id_col`,`bigint_col`),
  KEY `ndx_char_varchar_col` (`datetime_col`,`varchar_col`(4) DESC)
); 

INSERT INTO blob_text_test20 (
  `bigint_col`, 
  `datetime_col`, 
  `varchar_col`, 
  `blob_col`, 
  `mediumblob_col`, 
  `year_col`, 
  `enum_col`, 
  `set_col`, 
  `char_col`
) VALUES 
(1001, '2023-01-15 10:30:25.123456', 'Hello World', REPEAT('A', 300), REPEAT('G', 3000), 2023, 'aaa', '111', 'A'),
(1002, '2023-02-20 14:45:30.654321', 'Test data two', REPEAT('B', 3000), REPEAT('H', 300), 2022, 'bbb', '111,222', 'B'),
(1003, '2023-03-25 09:15:45.987654', 'Sample text three', REPEAT('', 300), REPEAT('R', 300), 2021, 'ccc', '222,333', 'C'),
(1004, '2023-04-10 16:20:15.456789', 'Database record', REPEAT('D', 30000), REPEAT('G', 3000), 2020, 'aaa', '111,333', 'D'),
(1005, '2023-05-05 11:55:40.321987', 'Final entry data', NULL, REPEAT('J', 3000), 2023, 'bbb', '333', 'E');

SELECT `id_col`, `varchar_col`, `char_col`, `enum_col`, `set_col` FROM blob_text_test20  WHERE `enum_col` IN ('aaa');

