--source include/have_only_dstore.inc

--echo #
--echo # Test 1. When the background statistic thread hold the MDL read lock, we cannot do DDL
--echo #
connect (con1, localhost, root,,);
connect (con2, localhost, root,,);

connection con1;
CREATE TABLE t1 (c1 int);

SET GLOBAL DEBUG='+d,bg_stat_after_get_table_wait';
insert into t1 values (1);
insert into t1 values (2);
insert into t1 values (3);
--sleep 5
SET GLOBAL DEBUG='-d,bg_stat_after_get_table_wait';

connection con2;

# As the background stat threads hold the MDL lock, at here it will report lock wait timeout
--ERROR ER_LOCK_WAIT_TIMEOUT
ALTER TABLE t1 add column c2 int;
SET DEBUG_SYNC = 'now SIGNAL resume_bg_stat_sig';
SET DEBUG_SYNC= 'RESET';

--echo #
--echo # Test 2. When we are doing ddl, we cannot do background statistic
--echo #
connection con1;

SET GLOBAL DEBUG='+d,bg_stat_after_get_table_name_wait';
insert into t1 values (4);
insert into t1 values (5);
insert into t1 values (6);
--sleep 5
SET GLOBAL DEBUG='-d,bg_stat_after_get_table_name_wait';

connection con2;

# As the background stat threads hold the MDL lock, at here it will report lock wait timeout
SET DEBUG_SYNC = 'before_get_refcnt SIGNAL resume_bg_stat_sig WAIT_FOR c1';
--send ALTER TABLE t1 add column c2 int;

connection con1;
--sleep 5
let $log_error_= `SELECT @@GLOBAL.log_error`;
--let $assert_text=bg statistic thread should wait mdl lock fail
--let $assert_file=$log_error_
--let $assert_select=bg_stat_service get MDL lock fail for table-.*
--let $assert_count=1
--source include/assert_grep.inc
SET DEBUG_SYNC = 'now SIGNAL c1';

connection con2;
--reap
SELECT * FROM t1;
DROP TABLE t1;

--echo #
--echo # Test 2. BUG2026020229395 We cannot acquire the operation lock before check the result of CdeDdTableLoadForeignKey
--echo #
connect (con3, localhost, root,,);

create table t1 (c1 int primary key);
create table t2 (c1 int primary key);
ALTER TABLE t1 ADD CONSTRAINT c1fk FOREIGN KEY (c1) REFERENCES t2 (c1) ON UPDATE CASCADE;
connection con1;
FLUSH TABLE t1;
set debug = "+d, force_reload_dict_table, dd_table_load_foreign_key_failed";
set debug_sync = "wait_after_load_foreign_key wait_for c1";
--send select * from t1;

connection con2;
--sleep 3
--send select * from t1;

connection con3;
--sleep 3
--echo We should ensure the SQL of connection 2 is stuck.
select count(*) from information_schema.processlist where USER = 'root' and COMMAND != 'Sleep';
set debug_sync = "now signal c1";

connection con1;
--error ER_NO_SUCH_TABLE
--reap
set debug = "-d, force_reload_dict_table, dd_table_load_foreign_key_failed";

connection con2;
--reap
disconnect con3;

--echo #
--echo # Clean up
--echo #
DROP TABLE t1, t2;
disconnect con1;
disconnect con2;
