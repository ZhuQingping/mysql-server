--echo #
--echo # Bug#31396191: ASSERTION `LEX->SQL_COMMAND != SQLCOM_ALTER_TABLE' FAILED
--echo #

--error ER_GENERATED_COLUMN_FUNCTION_IS_NOT_ALLOWED
ALTER TABLE z ADD b INT AS (EXISTS((SELECT 1 UNION DISTINCT SELECT 2) LIMIT 3));

--echo #
--echo # Bug#31330789: "ALTER TABLE ... ADD ... DEFAULT NOW()" GENERATES WRONG
--echo # TIME AT FIRST INSERT
--echo # Fixed by WL#9384

--echo # Set a fixed reference TIMESTAMP
SET TIMESTAMP=1558818549;

--echo # Add column with default now() to table without defaults
CREATE TABLE t1 (i INT PRIMARY KEY, no_default DATETIME);
ALTER TABLE t1 ADD alter_default DATETIME DEFAULT (now());
CREATE TABLE t2(i INT, alter_date DATETIME);
INSERT INTO t2 VALUES (0, now()), (1, now()), (2, now());

--echo # Advance TIMESTAMP 5 seconds to ensure timestamps have changed
SET TIMESTAMP=1558818554;

--echo # Insert rows in t1 which should all be newer than t2.alter_time
INSERT INTO t1 (i, no_default) VALUES (0, now()), (1, now()), (2, now());

--echo # Verify
SELECT (t1.no_default > t2.alter_date) AS no_default_newer_than_alter,
(t1.alter_default > t2.alter_date) AS alter_default_newer_than_alter FROM t1
NATURAL JOIN t2;

DROP TABLE t2;
DROP TABLE t1;

--echo # Set a fixed reference TIMESTAMP
SET TIMESTAMP=1558818549;

--echo # Add column with default now() to table with existing column with
--echo # default now()
CREATE TABLE t1 (i INT, no_default DATETIME, create_default DATETIME DEFAULT (now()) );
ALTER TABLE t1 ADD alter_default DATETIME DEFAULT (now());
CREATE TABLE t2(i INT, alter_date DATETIME);
INSERT INTO t2 VALUES (0, now()), (1, now()), (2, now());

--echo # Advance TIMESTAMP 5 seconds to ensure timestamps have changed
SET TIMESTAMP=1558818554;
INSERT INTO t1 (i, no_default) VALUES (0, now()), (1, now()), (2, now());

--echo # Verify
SELECT (no_default > alter_date) AS no_default_newer_than_alter,
(create_default > alter_date) AS create_default_newer_than_alter,
(alter_default > alter_date) AS alter_default_newer_than_alter FROM t1 NATURAL
JOIN t2;
DROP TABLE t2, t1;
SET TIMESTAMP=default;

--echo #
--echo # Bug#32187507: MEMORY LEAK WHEN SETTING SECONDARY_ENGINE_ATTRIBUTE
--echo #

--echo # Verify that CREATE TABLE with invalid type and SECONDARY_ENGINE
--echo # attribute does not leak.
--error ER_TOO_BIG_DISPLAYWIDTH
CREATE TABLE t1(a VARBINARY(9223372036854775806) SECONDARY_ENGINE_ATTRIBUTE '');

--echo # Verify that ALTER TABLE with invalid type and SECONDARY_ENGINE
--echo # attribute does not leak.
--error ER_TOO_BIG_DISPLAYWIDTH
ALTER TABLE t1 ADD COLUMN b VARBINARY(9223372036854775806)
SECONDARY_ENGINE_ATTRIBUTE '';

--echo #
--echo # Bug#32235058: PREPARE_DEFAULT_VALUE: ASSERTION
--echo # `FIELD.CONSTANT_DEFAULT->TYPE() != ITEM::FUNC_ITEM' FAILED.
--echo #

CREATE TABLE t1(a INT);
ALTER TABLE t1 ALTER COLUMN a SET DEFAULT TRUE;
DROP TABLE t1;

--echo #
--echo # Bug#32235671: ITEM_FUNC_CONV_CHARSET::VAL_STR(: ASSERTION `FIXED == 1' FAILED.
--echo # (duplicate of Bug#32235058 above).
--echo #

CREATE TABLE t1(a SET('a') CHARACTER SET BINARY);
--error ER_INVALID_DEFAULT
ALTER TABLE t1 ALTER COLUMN a SET DEFAULT TRUE;
DROP TABLE t1;
SET SQL_MODE=default;

--echo #
--echo # Bug#32234194: DDL: DIAGNOSTICS_AREA::SET_OK_STATUS: ASSERTION `!IS_SET()'
--echo #

CREATE TABLE t1(a INT);
--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
ALTER TABLE t1 MODIFY COLUMN a DECIMAL DEFAULT '4648-04-10';
DROP TABLE t1;

--echo #
--echo # Bug #22141913  ASSERTION: !"INVALID KEY_PART->FIELDNR
--echo # FILL_DD_INDEX_ELEMENTS_FROM_KEY_PARTS
--echo #

CREATE TABLE t (a TIMESTAMP(1) GENERATED ALWAYS AS (1) VIRTUAL,
                b INT GENERATED ALWAYS AS (1) VIRTUAL
               ) ENGINE=INNODB;

--echo # The below ALTER asserts without the fix.
ALTER TABLE t ADD  INDEX (b);
DROP TABLE t;

--echo #
--echo # BUG#27164393: ALTER COLUMN SET DEFAULT DOES NOT RETURN ERROR
--echo #               ON GENERATED COLUMNS


CREATE TABLE t1(fld1 INT, fld2 INT GENERATED ALWAYS AS (-fld1) VIRTUAL,
                fld3 INT GENERATED ALWAYS AS (-fld1) STORED); 

--echo # Without patch, does not report an error.
--error ER_WRONG_USAGE
ALTER TABLE t1 ALTER COLUMN fld2 SET DEFAULT -1;

--error ER_WRONG_USAGE
ALTER TABLE t1 ALTER COLUMN fld3 SET DEFAULT -1;

--echo # Tests added for coverage
--error ER_WRONG_USAGE
ALTER TABLE t1 CHANGE fld2 fld2 INT GENERATED ALWAYS AS (-fld1) DEFAULT -1;

--error ER_WRONG_USAGE
ALTER TABLE t1 MODIFY fld3 INT GENERATED ALWAYS AS (-fld1) STORED DEFAULT -1;

DROP TABLE t1;

# Modify column varchar resize Instantly
CREATE TABLE t1(id INT, name VARCHAR(10)) CHARSET UTF8MB4;
SHOW CREATE TABLE t1;
INSERT INTO t1 VALUES(1, REPEAT('华', 10));
--enable_info
# Varchar resize length no change
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(10), ALGORITHM=INSTANT;
SELECT id FROM t1 WHERE name=REPEAT('华',10);
# Varchar resize with pack length 1B
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(20), ALGORITHM=INSTANT;
SELECT id FROM t1 WHERE name=REPEAT('a',10);
INSERT INTO t1 VALUES(2, REPEAT('华', 20));
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(30), ALGORITHM=INPLACE;
SELECT id FROM t1 WHERE name=REPEAT('华',20);
INSERT INTO t1 VALUES(3, REPEAT('华', 30));
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(40);
SELECT id FROM t1 WHERE name=REPEAT('华',30);
INSERT INTO t1 VALUES(4, REPEAT('华', 40));
# Copy algorithm will affect exist data
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(50), ALGORITHM=COPY;
--disable_info
SHOW CREATE TABLE t1;
INSERT INTO t1 VALUES(5, REPEAT('华', 50));
SELECT COUNT(*) FROM t1;

# Exceed pack length byte can not support instant/inplace
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(64), ALGORITHM=INSTANT;
SELECT id FROM t1 WHERE name=REPEAT('华',50);
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(64), ALGORITHM=INPLACE;
# Exceed pack length(256B) use COPY Algorithm
--enable_info
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(64);

# Varchar resize which pack length is 2B
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(70), ALGORITHM=INSTANT;
INSERT INTO t1 VALUES(6, REPEAT('华', 70));
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(80), ALGORITHM=INPLACE;
SELECT id FROM t1 WHERE name=REPEAT('华',70);
INSERT INTO t1 VALUES(7, REPEAT('华', 80));
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(90);
SELECT id FROM t1 WHERE name=REPEAT('华',80);
INSERT INTO t1 VALUES(8, REPEAT('华', 90));
--disable_info
SELECT COUNT(*) FROM t1;

DROP TABLE t1;


# Mixed varchar resize of 1B/2B
CREATE TABLE t1(id INT, b VARCHAR(10), c VARCHAR(50), d VARCHAR(300)) CHARSET UTF8MB4;
SHOW CREATE TABLE t1;
INSERT INTO t1 values(1, REPEAT('练', 10), REPEAT('习', 50), REPEAT('本', 300));
--enable_info
# Mixed resize 1B->1B, 2B->2B should be succeed
ALTER TABLE t1 MODIFY COLUMN b VARCHAR(20), MODIFY COLUMN c varchar(60), MODIFY COLUMN d VARCHAR(310);
SELECT id FROM t1 WHERE (b=REPEAT('练', 10) AND c=REPEAT('习', 50) AND d=REPEAT('本', 300));
INSERT INTO t1 values(2, REPEAT('练', 20), REPEAT('习', 60), REPEAT('本', 310));
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
# Mixed resize 1B->1B, 1B->2B, 2B->2B should be failed if use INSTANT/INPLACE algorithm
ALTER TABLE t1 MODIFY COLUMN b VARCHAR(30), MODIFY COLUMN c varchar(70), MODIFY COLUMN d VARCHAR(320), ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t1 MODIFY COLUMN b VARCHAR(30), MODIFY COLUMN c varchar(70), MODIFY COLUMN d VARCHAR(320), ALGORITHM=INPLACE;
SELECT id FROM t1 WHERE (b=REPEAT('练', 10) AND c=REPEAT('习', 50) AND d=REPEAT('本', 300));
# Will use COPY if do not support INSTANT/INPLACE for default algorithm
ALTER TABLE t1 MODIFY COLUMN b VARCHAR(30), MODIFY COLUMN c varchar(70), MODIFY COLUMN d VARCHAR(320);
SELECT id FROM t1 WHERE (b=REPEAT('练', 10) AND c=REPEAT('习', 50) AND d=REPEAT('本', 300));
--disable_info
SHOW CREATE TABLE t1;

DROP TABLE t1;

--echo #
--echo #  Mixed instant ops of varchar resize and rename column
--echo #
CREATE TABLE t1(a int, b VARCHAR(10), c int, d VARCHAR(200), KEY(b), KEY(d)) CHARSET UTF8MB4;
INSERT INTO t1 values(1, REPEAT('中', 10), 1, REPEAT('华', 200));
--enable_info
ALTER TABLE t1 RENAME COLUMN a TO aa, CHANGE COLUMN b bb VARCHAR(20), RENAME COLUMN c to cc, MODIFY d VARCHAR(210), ALGORITHM = INSTANT;
SELECT aa FROM t1 WHERE (bb=REPEAT('中', 10) AND cc=1 AND d=REPEAT('华', 200));
SHOW CREATE TABLE t1;
INSERT INTO t1 values(2, REPEAT('中', 20), 1, REPEAT('华', 210));
ALTER TABLE t1 RENAME COLUMN aa TO a, CHANGE COLUMN bb b VARCHAR(30), RENAME COLUMN cc to c, MODIFY d VARCHAR(220), ALGORITHM = INPLACE;
SELECT a FROM t1 WHERE (b=REPEAT('中', 10) AND c=1 AND d=REPEAT('华', 200));
SELECT a FROM t1 WHERE (b=REPEAT('中', 20) AND c=1 AND d=REPEAT('华', 210));
SHOW CREATE TABLE t1;
INSERT INTO t1 values(3, REPEAT('中', 30), 1, REPEAT('华', 220));
# Default algorithm will use instant if alter ops satisfied
ALTER TABLE t1 RENAME COLUMN a TO aa, MODIFY b VARCHAR(40), MODIFY d VARCHAR(237);
SELECT aa FROM t1 WHERE (b=REPEAT('中', 30) AND c=1 AND d=REPEAT('华', 220));
SHOW CREATE TABLE t1;
INSERT INTO t1 values(4, REPEAT('中', 40), 1, REPEAT('华', 237));
# Use change syntax
ALTER TABLE t1 CHANGE COLUMN b bb VARCHAR(50),CHANGE COLUMN d dd VARCHAR(237);
SHOW CREATE TABLE t1;
SELECT aa FROM t1 WHERE (bb=REPEAT('中', 40) AND c=1 AND dd=REPEAT('华', 237));
INSERT INTO t1 values(5, REPEAT('中', 50), 1, REPEAT('华', 237));
ALTER TABLE t1 RENAME COLUMN bb TO b, RENAME COLUMN dd TO d;
SELECT COUNT(*) FROM t1;
--disable_info

# Negative case
--error ER_BAD_FIELD_ERROR
ALTER TABLE t1 RENAME COLUMN b TO bb, MODIFY b VARCHAR(51);
# Rename column ok but varchar resize length 1B->2B should fail
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t1 RENAME COLUMN aa TO a, MODIFY b VARCHAR(120), ALGORITHM = INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t1 RENAME COLUMN aa TO a, MODIFY b VARCHAR(120), ALGORITHM = INPLACE;
# Will use copy algorithm
--enable_info
ALTER TABLE t1 RENAME COLUMN aa TO a, MODIFY b VARCHAR(120);
--disable_info
DROP TABLE t1;
