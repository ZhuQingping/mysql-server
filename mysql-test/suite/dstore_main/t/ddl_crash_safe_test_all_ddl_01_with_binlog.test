--source include/have_only_dstore.inc
--source include/have_debug.inc
--source include/big_test.inc

--echo #
--echo #  DDL CRASH SAFE TEST: ALL DDL TEST PART 01
--echo #  This test will check whether the server can recovery from different
--echo #  phases of ALL DDLs without inconsistency between dstore and
--echo #  innodb. Each DDL will be tested at 3 crash points and recovery
--echo #  results will be verified.
--echo #

CREATE DATABASE test_ddl_crash_comprehensive;
USE test_ddl_crash_comprehensive;

--echo #  1. Crash on CREATE TABLE statement.
--echo #  1.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
--source include/expect_crash.inc
--error 2013
CREATE TABLE t_ddl_crash_create_table_01(pk INT PRIMARY KEY, col1 INT);

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify table should not exist after crash before prepare
--error ER_NO_SUCH_TABLE
SHOW CREATE TABLE t_ddl_crash_create_table_01;

--echo #  1.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
--source include/expect_crash.inc
--error 2013
CREATE TABLE t_ddl_crash_create_table_01(pk INT PRIMARY KEY, col1 INT);

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify table should not exist after crash after prepare but before commit
--error ER_NO_SUCH_TABLE
SHOW CREATE TABLE t_ddl_crash_create_table_01;

--echo #  1.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
--source include/expect_crash.inc
--error 2013
CREATE TABLE t_ddl_crash_create_table_01(pk INT PRIMARY KEY, col1 INT);

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify table should exist after crash after dstore commit
SHOW CREATE TABLE t_ddl_crash_create_table_01;
INSERT INTO t_ddl_crash_create_table_01 VALUES(1,2),(2,3),(3,4);
SELECT * FROM t_ddl_crash_create_table_01;

--echo #  2. Crash on CREATE TABLE AS SELECT statement.
--echo #  2.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
--source include/expect_crash.inc
--error 2013
CREATE TABLE t_ddl_crash_ctas AS SELECT * FROM t_ddl_crash_create_table_01;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify CTAS table should not exist
--error ER_NO_SUCH_TABLE
SHOW CREATE TABLE t_ddl_crash_ctas;

--echo #  2.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
--source include/expect_crash.inc
--error 2013
CREATE TABLE t_ddl_crash_ctas AS SELECT * FROM t_ddl_crash_create_table_01;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify CTAS table should not exist
--error ER_NO_SUCH_TABLE
SHOW CREATE TABLE t_ddl_crash_ctas;

--echo #  2.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
--source include/expect_crash.inc
--error 2013
CREATE TABLE t_ddl_crash_ctas AS SELECT * FROM t_ddl_crash_create_table_01;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify CTAS table should exist with data
SHOW CREATE TABLE t_ddl_crash_ctas;
SELECT * FROM t_ddl_crash_ctas;

--echo #  3. Crash on ALTER TABLE ADD INDEX statement.
--echo #  3.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
--source include/expect_crash.inc
--error 2013
ALTER TABLE t_ddl_crash_create_table_01 ADD INDEX ci(col1);

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify index should not exist
SHOW CREATE TABLE t_ddl_crash_create_table_01;
SELECT COUNT(*) AS index_count FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND INDEX_NAME='ci';

--echo #  3.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
--source include/expect_crash.inc
--error 2013
ALTER TABLE t_ddl_crash_create_table_01 ADD INDEX ci(col1);

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify index should not exist
SHOW CREATE TABLE t_ddl_crash_create_table_01;
SELECT COUNT(*) AS index_count FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND INDEX_NAME='ci';

--echo #  3.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
--source include/expect_crash.inc
--error 2013
ALTER TABLE t_ddl_crash_create_table_01 ADD INDEX ci(col1);

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify index should exist
SHOW CREATE TABLE t_ddl_crash_create_table_01;
SELECT COUNT(*) AS index_count FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND INDEX_NAME='ci';

--echo #  4. Crash on ALTER TABLE ADD COLUMN statement.
--echo #  4.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
--source include/expect_crash.inc
--error 2013
ALTER TABLE t_ddl_crash_create_table_01 ADD COLUMN col2 INT AFTER pk;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify column should not exist
SHOW CREATE TABLE t_ddl_crash_create_table_01;
SELECT COUNT(*) AS column_count FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND COLUMN_NAME='col2';

--echo #  4.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
--source include/expect_crash.inc
--error 2013
ALTER TABLE t_ddl_crash_create_table_01 ADD COLUMN col2 INT AFTER pk;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify column should not exist
SHOW CREATE TABLE t_ddl_crash_create_table_01;
SELECT COUNT(*) AS column_count FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND COLUMN_NAME='col2';

--echo #  4.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
--source include/expect_crash.inc
--error 2013
ALTER TABLE t_ddl_crash_create_table_01 ADD COLUMN col2 INT AFTER pk;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify column should exist
SHOW CREATE TABLE t_ddl_crash_create_table_01;
SELECT COUNT(*) AS column_count FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND COLUMN_NAME='col2';

--echo #  5. Crash on CREATE INDEX statement.
--echo #  5.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
--source include/expect_crash.inc
--error 2013
CREATE INDEX idx_col2 ON t_ddl_crash_create_table_01(col2);

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify index should not exist
SELECT COUNT(*) AS index_count FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND INDEX_NAME='idx_col2';

--echo #  5.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
--source include/expect_crash.inc
--error 2013
CREATE INDEX idx_col2 ON t_ddl_crash_create_table_01(col2);

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify index should not exist
SELECT COUNT(*) AS index_count FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND INDEX_NAME='idx_col2';

--echo #  5.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
--source include/expect_crash.inc
--error 2013
CREATE INDEX idx_col2 ON t_ddl_crash_create_table_01(col2);

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify index should exist
SELECT COUNT(*) AS index_count FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND INDEX_NAME='idx_col2';

--echo #  6. Crash on DROP INDEX statement.
--echo #  6.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
--source include/expect_crash.inc
--error 2013
DROP INDEX ci ON t_ddl_crash_create_table_01;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify index should still exist
SELECT COUNT(*) AS index_count FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND INDEX_NAME='ci';

--echo #  6.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
--source include/expect_crash.inc
--error 2013
DROP INDEX ci ON t_ddl_crash_create_table_01;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify index should still exist
SELECT COUNT(*) AS index_count FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND INDEX_NAME='ci';

--echo #  6.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
--source include/expect_crash.inc
--error 2013
DROP INDEX ci ON t_ddl_crash_create_table_01;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify index should be dropped
SELECT COUNT(*) AS index_count FROM INFORMATION_SCHEMA.STATISTICS
WHERE TABLE_NAME='t_ddl_crash_create_table_01' AND INDEX_NAME='ci';

--echo #  7. Crash on RENAME TABLE statement.
--echo #  7.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
--source include/expect_crash.inc
--error 2013
RENAME TABLE t_ddl_crash_create_table_01 TO t_ddl_crash_renamed;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify old table name should still exist
SHOW CREATE TABLE t_ddl_crash_create_table_01;
--error ER_NO_SUCH_TABLE
SHOW CREATE TABLE t_ddl_crash_renamed;

--echo #  7.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
--source include/expect_crash.inc
--error 2013
RENAME TABLE t_ddl_crash_create_table_01 TO t_ddl_crash_renamed;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify old table name should still exist
SHOW CREATE TABLE t_ddl_crash_create_table_01;
--error ER_NO_SUCH_TABLE
SHOW CREATE TABLE t_ddl_crash_renamed;

--echo #  7.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
--source include/expect_crash.inc
--error 2013
RENAME TABLE t_ddl_crash_create_table_01 TO t_ddl_crash_renamed;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify table should be renamed
--error ER_NO_SUCH_TABLE
SHOW CREATE TABLE t_ddl_crash_create_table_01;
SHOW CREATE TABLE t_ddl_crash_renamed;

--echo #  8. Crash on TRUNCATE TABLE statement.
--echo #  8.1 Crash before InnoDB prepare.
INSERT INTO t_ddl_crash_renamed VALUES(100, 200, 300);
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
--source include/expect_crash.inc
--error 2013
TRUNCATE TABLE t_ddl_crash_renamed;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify table data should not be truncated
SELECT COUNT(*) AS row_count FROM t_ddl_crash_renamed;

--echo #  8.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
--source include/expect_crash.inc
--error 2013
TRUNCATE TABLE t_ddl_crash_renamed;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify table data should not be truncated
SELECT COUNT(*) AS row_count FROM t_ddl_crash_renamed;

--echo #  8.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
--source include/expect_crash.inc
--error 2013
TRUNCATE TABLE t_ddl_crash_renamed;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify table should be truncated
SELECT COUNT(*) AS row_count FROM t_ddl_crash_renamed;

--echo #  9. Crash on ANALYZE TABLE statement.
INSERT INTO t_ddl_crash_renamed VALUES(101, 201, 301), (102, 202, 302);
--echo #  9.1 Crash before InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_during_xa_prepare_step';
--source include/expect_crash.inc
--error 2013
ANALYZE TABLE t_ddl_crash_renamed;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify analyze completed (should have recovered gracefully)
SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='t_ddl_crash_renamed';

--echo #  9.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
--source include/expect_crash.inc
--error 2013
ANALYZE TABLE t_ddl_crash_renamed;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify analyze completed (should have recovered gracefully)
SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='t_ddl_crash_renamed';

--echo #  9.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
--source include/expect_crash.inc
--error 2013
ANALYZE TABLE t_ddl_crash_renamed;

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify analyze completed (should have recovered gracefully)
SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='t_ddl_crash_renamed';

--echo #  10. Crash on OPTIMIZE TABLE statement: NOT SUPPORTED.

--echo # Final cleanup and summary
--echo # Drop remaining objects for complete cleanup

--echo # Summary: All DDL crash recovery tests completed successfully
--echo # Each DDL was tested at 3 crash points with proper recovery verification
--echo # - Before InnoDB prepare: DDL should be rolled back
--echo # - After InnoDB prepare but before DStore commit: DDL should be rolled back
--echo # - After DStore commit: DDL should be committed and visible

SET debug='reset';
DROP DATABASE test_ddl_crash_comprehensive;