# ==== Purpose ====
#
# This file includes testcases to verify the atomic-DDL feature of MySQL on Dstore
#
# ==== References ====
#
# US2025071500732 Support atomic-DDL for MySQL on Dstore
# 

--disable_query_log
call mtr.add_suppression("Don't call WriteBinlogExtraIntoWal or SetExtraCommitWAL, query is");
--enable_query_log

--echo ########################################################################################################
--echo # Test1.1 Verify can't access ddl log table table on default.                                          #
--echo ########################################################################################################
USE mysql;
SHOW TABLES LIKE "%dstore_ddl_log%";
--error ER_NO_SYSTEM_TABLE_ACCESS
SELECT * FROM dstore_ddl_log;
--error ER_NO_SYSTEM_TABLE_ACCESS
INSERT INTO dstore_ddl_log VALUES(1,1,1,1,1,1,"a","b");
--error ER_NO_SYSTEM_TABLE_ACCESS
UPDATE dstore_ddl_log set id=1 WHERE id=2;
--error ER_NO_SYSTEM_TABLE_ACCESS
ALTER TABLE dstore_ddl_log ADD COLUMN new_col VARCHAR(50);
--error ER_NO_SYSTEM_TABLE_ACCESS
DROP TABLE dstore_ddl_log;
--error ER_NO_SYSTEM_TABLE_ACCESS
CREATE TABLE dstore_ddl_log (id INT AUTO_INCREMENT PRIMARY KEY);
# Not hidden in I_S
SELECT count(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA='mysql' and TABLE_NAME='dstore_ddl_log';


--echo ########################################################################################################
--echo # Test1.2 The permission only works with who has ACL_SUPER grant.                                      #
--echo ########################################################################################################
CREATE USER 'no_super'@'%' IDENTIFIED BY '123456';
GRANT ALL PRIVILEGES ON *.* TO 'no_super'@'%' WITH GRANT OPTION;
REVOKE SUPER ON *.* FROM 'no_super'@'%';
connect(conn1, localhost, no_super, 123456, mysql);
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
SET GLOBAL rds_show_hidden_table=true;
disconnect conn1;
--connection default
DROP USER 'no_super'@'%';


--echo ########################################################################################################
--echo # Test1.3 Testing any operations on ddl log table to simulate the rescure mode after get permission.   #
--echo ########################################################################################################
# Turn off atomic-ddl before we broken the ddl log table
--let $restart_parameters = restart: --rds_dstore_enable_atomic_ddl=false --dstore_use_histogram_auto_update=false
--source include/restart_mysqld.inc
SET GLOBAL rds_show_hidden_table=true;
SELECT * FROM dstore_ddl_log;
INSERT INTO dstore_ddl_log VALUES(1,1,1,1,1,1,1,"a","b");
UPDATE dstore_ddl_log set id=2 WHERE id=1;
ALTER TABLE mysql.dstore_ddl_log ADD COLUMN new_col VARCHAR(50);
DROP TABLE dstore_ddl_log;
# Recreate ddl log table
CREATE TABLE IF NOT EXISTS dstore_ddl_log(
  id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  thread_id BIGINT UNSIGNED NOT NULL,
  type INT UNSIGNED NOT NULL,
  file_id INT UNSIGNED NOT NULL,
  block_id INT UNSIGNED NOT NULL,
  segment_type INT UNSIGNED NOT NULL,
  tablespace_id INT UNSIGNED NOT NULL,
  table_name VARCHAR(512),
  table_name_new VARCHAR(512),
  PRIMARY KEY idx_pk(id),
  KEY idx_1(thread_id)
)engine=DSTORE STATS_PERSISTENT=0 CHARACTER SET latin1 COLLATE latin1_bin;

SET GLOBAL rds_show_hidden_table=false;
--error ER_NO_SYSTEM_TABLE_ACCESS
SELECT * FROM dstore_ddl_log;
USE test;

# Turn on atomic-ddl to check if it going well by following testcases after the ddl log table is recreated
--let $restart_parameters = restart
--source include/restart_mysqld.inc

# Prepare for following testcases about ddl rollback.
call mtr.add_suppression("\\[DSTORE\\] Replay DDL log failed");

--source include/have_debug.inc
--disable_warnings
DROP TABLE IF EXISTS atomic_ddl_department;
DROP TABLE IF EXISTS atomic_ddl_employees;
--enable_warnings
--let SEARCH_FILE = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let PRINT_HIT_TIMES = 1

CREATE TABLE `atomic_ddl_department` (
  `dept_id` INT PRIMARY KEY NOT NULL,
  `dept_name` VARCHAR(512)
)ENGINE=DSTORE CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
INSERT INTO `atomic_ddl_department` VALUES(1, "DBS Product Department"),(2, "2012 Gauss Department");


--echo ########################################################################################################
--echo # Test2.1 Create table rollback triggered by error.                                                    #
--echo ########################################################################################################
# Set start line of log file to be searched yo avoid the impact of logs generated by previous testcases
--source include/get_file_line_number.inc
--let SEARCH_START_LINE = $LINE_NUMBER

SET GLOBAL DEBUG='+d,cde_create_table_error_before_commit';

--error ER_GET_ERRNO
CREATE TABLE `atomic_ddl_employees` (
  `emp_id` INT,
  `emp_name` VARCHAR(512),
  `dept_id` INT,
  CONSTRAINT fk_dept 
    FOREIGN KEY (dept_id) REFERENCES `atomic_ddl_department`(dept_id)
    ON DELETE SET NULL
    ON UPDATE CASCADE
)ENGINE=DSTORE CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SET GLOBAL DEBUG='-d,cde_create_table_error_before_commit';

# Wait a while to ensure error log has been flushed to file.
--sleep 3

# Search log file to verify the testcase is as expected
--let SEARCH_PATTERN = Replay DDL log success.*Type:DROP_SEGMENT_LOG
--echo # Expect found 2 times
--source include/search_pattern.inc
--let SEARCH_PATTERN = Replay DDL log success.*Type:REMOVE_CACHE_LOG
--echo # Expect found 1 time
--source include/search_pattern.inc
SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='atomic_ddl_employees';


--echo ########################################################################################################
--echo # Test2.2 Create table rollback triggered by crash.                                                    #
--echo ########################################################################################################
# Set start line of log file to be searched yo avoid the impact of logs generated by previous testcases
--source include/get_file_line_number.inc
--let SEARCH_START_LINE = $LINE_NUMBER

SET GLOBAL DEBUG='+d,cde_create_table_crash_before_commit';

--source include/expect_crash.inc
--error CR_SERVER_LOST
CREATE TABLE `atomic_ddl_employees` (
  `emp_id` INT,
  `emp_name` VARCHAR(512),
  `dept_id` INT,
  `contet` TEXT,
  CONSTRAINT fk_dept 
    FOREIGN KEY (dept_id) REFERENCES atomic_ddl_department(dept_id)
    ON DELETE SET NULL
    ON UPDATE CASCADE
)ENGINE=DSTORE CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

# Restart mysqld
--source include/start_mysqld.inc
SELECT COUNT(*) FROM `atomic_ddl_department`;

# Search log file to verify the testcase is as expected
--let SEARCH_PATTERN = Replay DDL log success.*Type:DROP_SEGMENT_LOG
--echo # Expect found 3 times
--source include/search_pattern.inc
--let SEARCH_PATTERN = Replay DDL log success.*Type:REMOVE_CACHE_LOG
--echo # Expect not found
--source include/search_pattern.inc


--echo ########################################################################################################
--echo # Test3.1 Drop table rollback triggered by error.                                                      #
--echo ########################################################################################################
CREATE TABLE `atomic_ddl_employees` (
  `emp_id` INT,
  `emp_name` VARCHAR(512),
  `dept_id` INT,
  CONSTRAINT fk_dept 
    FOREIGN KEY (dept_id) REFERENCES atomic_ddl_department(dept_id)
    ON DELETE SET NULL
    ON UPDATE CASCADE
)ENGINE=DSTORE CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

INSERT INTO `atomic_ddl_employees` VALUES(1, "ZhangThree", 1),(2, "LiFour", 2);

# Set start line of log file to be searched yo avoid the impact of logs generated by previous testcases
--source include/get_file_line_number.inc
--let SEARCH_START_LINE = $LINE_NUMBER

SET GLOBAL DEBUG='+d,cde_drop_table_error_before_commit';

--error ER_ENGINE_CANT_DROP_TABLE
DROP TABLE `atomic_ddl_employees`;
SET GLOBAL DEBUG='-d,cde_drop_table_error_before_commit';

# Wait a while to ensure error log has been flushed to file.
--sleep 3

# Search log file to verify the testcase is as expected
--let SEARCH_PATTERN = Log DDL success.*Type:DROP_SEGMENT_LOG
--echo # Expect found 2 times
--source include/search_pattern.inc
--let SEARCH_PATTERN = Replay DDL log success
--echo # Expect not found
--source include/search_pattern.inc

# Check table has rollbacked to normal state
SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='atomic_ddl_employees';
INSERT INTO `atomic_ddl_employees` VALUES(3, "WangTwo", 2);
SELECT * FROM `atomic_ddl_employees`;
DELETE FROM `atomic_ddl_employees` WHERE `emp_id` = 3;


