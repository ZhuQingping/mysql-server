--echo ########################################################################################################
--echo # Test6 Truncate table rollback by error.                                                              #
--echo ########################################################################################################
SELECT * FROM atomic_ddl_employees;
SET GLOBAL DEBUG='+d,cde_truncate_impl_exec_injection';
--error ER_GET_ERRNO
TRUNCATE TABLE atomic_ddl_employees;
--error ER_GET_ERRNO
TRUNCATE TABLE atomic_ddl_employees;
SET GLOBAL DEBUG='-d,cde_truncate_impl_exec_injection';
SELECT * FROM atomic_ddl_employees;


--echo ########################################################################################################
--echo # Test7 Session in Post ddl is killed.                                                                 #
--echo ########################################################################################################
show variables like '%threadpool_enabled%';
  
connect(conn1,localhost,root,,);
connect(conn2,localhost,root,,);

--echo # connection conn1
connection conn1;
let $session_id= `select connection_id()`;
SET DEBUG_SYNC='hanging_at_log_dummy WAIT_FOR kill_session';
--send
CREATE DATABASE atomic_ddl_tmp_db;

--sleep 3

--echo # connection conn2
connection conn2;
eval KILL QUERY $session_id;
SET DEBUG_SYNC= 'now SIGNAL kill_session';

--echo # connection conn1
connection conn1;
--reap
SET DEBUG_SYNC="reset";

connection default;
DROP DATABASE atomic_ddl_tmp_db;

--echo ########################################################################################################
--echo # Test8 Duplicate deletion of segment by DDL log replay.                                               #
--echo ########################################################################################################
CREATE TABLE `atomic_ddl_tmp1` (
  `id` int,
  `content` VARCHAR(512)
)ENGINE=DSTORE CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

--echo # connection conn2
connection conn2;
SET DEBUG_SYNC= 'sql_parse_before_rewrite WAIT_FOR replay_log_done';

--echo # connection conn1
connection conn1;
SET DEBUG_SYNC= 'cde_replay_drop_segment_hang_before_commit SIGNAL replay_log_done WAIT_FOR kill_mysqld';
--send
DROP TABLE `atomic_ddl_employees`;

--echo # connection conn2
# Conn2 execute a DML to make sure wal-records of conn1 have been flushed to wal-file.
connection conn2;
INSERT INTO `atomic_ddl_tmp1` VALUES(1, "aaa");

# Set start line of log file to be searched yo avoid the impact of logs generated by previous testcases
--source include/get_file_line_number.inc
--let SEARCH_START_LINE = $LINE_NUMBER

# Restart mysqld
--source include/kill_and_restart_mysqld.inc

# Search the error log of duplicate deletion of segment by DDL log replay
--let SEARCH_PATTERN = Replay DDL log success.*Type:DROP_SEGMENT_LOG
--echo # Expect found 2 times
--source include/search_pattern.inc

# Check table has been deleted
SELECT COUNT(*) FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='atomic_ddl_employees';
DROP TABLE `atomic_ddl_tmp1`;

--echo ########################################################################################################
--echo # Test9 Drop Database as an atomic operation.                                                         #
--echo ########################################################################################################
CREATE DATABASE `automic_ddl_db`;
CREATE TABLE `automic_ddl_db`.`atomic_ddl_tmp0` (`id` int)ENGINE=DSTORE;
CREATE TABLE `automic_ddl_db`.`atomic_ddl_tmp1` (`id` int)ENGINE=DSTORE;
CREATE TABLE `automic_ddl_db`.`atomic_ddl_tmp2` (`id` int)ENGINE=DSTORE;
CREATE TABLE `automic_ddl_db`.`atomic_ddl_tmp3` (`id` int)ENGINE=DSTORE;
CREATE TABLE `automic_ddl_db`.`atomic_ddl_tmp4` (`id` int)ENGINE=DSTORE;
CREATE TABLE `automic_ddl_db`.`atomic_ddl_tmp5` (`id` int)ENGINE=DSTORE;
CREATE TABLE `automic_ddl_db`.`atomic_ddl_tmp6` (`id` int)ENGINE=DSTORE;
CREATE TABLE `automic_ddl_db`.`atomic_ddl_tmp7` (`id` int)ENGINE=DSTORE;
CREATE TABLE `automic_ddl_db`.`atomic_ddl_tmp8` (`id` int)ENGINE=DSTORE;
CREATE TABLE `automic_ddl_db`.`atomic_ddl_tmp9` (`id` int)ENGINE=DSTORE;

# Wait for error log flush to log file.
SELECT SLEEP(5);

# Set start line of log file to be searched yo avoid the impact of logs generated by previous testcases
--source include/get_file_line_number.inc
--let SEARCH_START_LINE = $LINE_NUMBER

SET GLOBAL DEBUG='+d,cde_drop_db_crash_after_some_tables_dropped';
--source include/expect_crash.inc
--error CR_SERVER_LOST
DROP DATABASE `automic_ddl_db`;

# Restart mysqld
--source include/start_mysqld.inc

# Search log file to verify the testcase is as expected
--let SEARCH_PATTERN = Log DDL success.*Type:DROP_SEGMENT_LOG
--echo # Expect found 6 times
--source include/search_pattern.inc
--let SEARCH_PATTERN = Replay DDL log success.*Type:DROP_SEGMENT_LOG
--echo # Expect not found
--source include/search_pattern.inc

USE `automic_ddl_db`;
SHOW TABLES;
INSERT INTO `atomic_ddl_tmp0` VALUES(1);
INSERT INTO `atomic_ddl_tmp1` VALUES(1);
INSERT INTO `atomic_ddl_tmp2` VALUES(1);
INSERT INTO `atomic_ddl_tmp3` VALUES(1);
INSERT INTO `atomic_ddl_tmp4` VALUES(1);
INSERT INTO `atomic_ddl_tmp5` VALUES(1);
INSERT INTO `atomic_ddl_tmp6` VALUES(1);
INSERT INTO `atomic_ddl_tmp7` VALUES(1);
INSERT INTO `atomic_ddl_tmp8` VALUES(1);
INSERT INTO `atomic_ddl_tmp9` VALUES(1);
DROP DATABASE `automic_ddl_db`;

--echo ########################################################################################################
--echo # Test10 DDL rollback by write ddl log table error.                                                     #
--echo ########################################################################################################
USE test;
CREATE TABLE `atomic_ddl_tmp2` (
    id INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
    col1 INT NOT NULL,
    INDEX idx_col1 (col1)
);

INSERT INTO atomic_ddl_tmp2 VALUES (1,1);
INSERT INTO atomic_ddl_tmp2 VALUES (2,1);

call mtr.add_suppression("Inject failure of insert DDL log table");
call mtr.add_suppression("Log DDL failed, record");
call mtr.add_suppression("Log drop segment fail");
call mtr.add_suppression("Drop the newly allocated segment");
call mtr.add_suppression("Alloc heap segment failed");
call mtr.add_suppression("cde_create_table_info.create_table fail");
call mtr.add_suppression("Drop index: idx_col1 fail due to LogDropSegment fail.");

SET GLOBAL DEBUG="+d,insert_index_tuple_of_ddl_log_table_fail";
--error ER_GET_ERRNO
ALTER TABLE `atomic_ddl_tmp2` DROP INDEX idx_col1, ALGORITHM=COPY;
SET GLOBAL DEBUG='-d,insert_index_tuple_of_ddl_log_table_fail';
SHOW CREATE TABLE atomic_ddl_tmp2;
SELECT * FROM atomic_ddl_tmp2;
DROP TABLE atomic_ddl_tmp2;

--echo ########################################################################################################
--echo # Test11 Search ddl log table lock timeouted and retry.                                                #
--echo ########################################################################################################
CREATE TABLE `atomic_ddl_tmp1` (
    id INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
    col1 INT NOT NULL,
    INDEX idx_col1 (col1)
);

CREATE TABLE `atomic_ddl_tmp2` (
    id INT UNSIGNED
);

--let $saved_lock_wait_timeout=`select @@dstore_lock_wait_timeout`
SET GLOBAL dstore_lock_wait_timeout=1;

connect(conn1_new,localhost,root,,);
connect(conn2_new,localhost,root,,);
connect(conn3_new,localhost,root,,);

--echo # connection conn1_new
connection conn1_new;
SET DEBUG_SYNC= 'cde_post_ddl_hang_before_search WAIT_FOR others_pending_commmit';
--send
ALTER TABLE atomic_ddl_tmp1 DROP INDEX idx_col1, ALGORITHM=COPY;
# Wait a while to ensure session1 run into post-ddl.
--sleep 3

--echo # connection conn2_new
connection conn2_new;
SET GLOBAL DEBUG='+d,stay_in_pending_commit';
# Wait a while to ensure dbug take effect.
--sleep 3
--send
DROP TABLE `atomic_ddl_tmp2`;

# Wait a while to ensure session2 run into pending_commit.
--sleep 3

--source include/get_file_line_number.inc
--let SEARCH_START_LINE = $LINE_NUMBER
--let PRINT_HIT_TIMES = 0

--echo # connection conn3_new
connection conn3_new;
SET GLOBAL DEBUG='-d,stay_in_pending_commit';
SET DEBUG_SYNC= 'now SIGNAL others_pending_commmit';
# Wait a while to ensure lock timeouted.
--sleep 3

call mtr.add_suppression("DDL log table index scan next timeouted and retry");
--let SEARCH_PATTERN = DDL log table index scan next timeouted and retry
--echo # Expect found
--source include/search_pattern.inc

SET GLOBAL DEBUG='+d,resume_pending_commit';

--echo # connection conn1_new
connection conn1_new;
--reap

--echo # connection conn2_new
connection conn2_new;
--reap

--let PRINT_HIT_TIMES = 1
--let SEARCH_PATTERN = Replay DDL log success.*Type:DROP_SEGMENT_LOG
--echo # Expect found 4 times
--source include/search_pattern.inc

SET GLOBAL DEBUG='-d,resume_pending_commit';
--eval SET GLOBAL dstore_lock_wait_timeout=$saved_lock_wait_timeout
DROP TABLE `atomic_ddl_tmp1`;

--echo ########################################################################################################
--echo # Test variables.                                                                                      #
--echo ########################################################################################################
SET GLOBAL dstore_ddl_log_fillfactor_heap=9;
SHOW GLOBAL VARIABLES LIKE 'dstore_ddl_log_fillfactor_heap';
SET GLOBAL dstore_ddl_log_fillfactor_heap=101;
SHOW GLOBAL VARIABLES LIKE 'dstore_ddl_log_fillfactor_heap';
SET GLOBAL dstore_ddl_log_fillfactor_heap=70;
SHOW GLOBAL VARIABLES LIKE 'dstore_ddl_log_fillfactor_heap';
SET GLOBAL dstore_ddl_log_fillfactor_heap=default;

SET GLOBAL dstore_ddl_log_fillfactor_index=9;
SHOW GLOBAL VARIABLES LIKE 'dstore_ddl_log_fillfactor_index';
SET GLOBAL dstore_ddl_log_fillfactor_index=101;
SHOW GLOBAL VARIABLES LIKE 'dstore_ddl_log_fillfactor_index';
SET GLOBAL dstore_ddl_log_fillfactor_index=60;
SHOW GLOBAL VARIABLES LIKE 'dstore_ddl_log_fillfactor_index';
SET GLOBAL dstore_ddl_log_fillfactor_index=default;

--echo ########################################################################################################
--echo # Clean up.                                                                                            #
--echo ########################################################################################################
DROP TABLE `test`.`atomic_ddl_department`;
