EXPLAIN SELECT * FROM t WHERE NOT a ORDER BY b;
EXPLAIN FORMAT=TREE SELECT * FROM t WHERE NOT a ORDER BY b;
SELECT * FROM t WHERE NOT a ORDER BY b;
DROP TABLE t;

--echo #
--echo # BUG2025060417623: Wrong result for backward index scan
--echo #
CREATE TABLE t(a INT, b INT, UNIQUE KEY idx_ab(a,b DESC))ENGINE=Dstore;
INSERT INTO t VALUES(NULL,NULL),(-2,NULL),(-1,NULL),(3,NULL);

ANALYZE TABLE t;
EXPLAIN SELECT * FROM t FORCE INDEX(idx_ab) WHERE (NOT a) ORDER BY b;
SELECT * FROM t FORCE INDEX(idx_ab) WHERE (NOT a) ORDER BY b;
EXPLAIN SELECT * FROM t IGNORE INDEX(idx_ab) WHERE (NOT a) ORDER BY b;
SELECT * FROM t IGNORE INDEX(idx_ab) WHERE (NOT a) ORDER BY b;

INSERT INTO t VALUES(0,NULL),(0,0);
ANALYZE TABLE t;
EXPLAIN SELECT * FROM t FORCE INDEX(idx_ab) WHERE (NOT a) ORDER BY b;
SELECT * FROM t FORCE INDEX(idx_ab) WHERE (NOT a) ORDER BY b;
EXPLAIN SELECT * FROM t IGNORE INDEX(idx_ab) WHERE (NOT a) ORDER BY b;
SELECT * FROM t IGNORE INDEX(idx_ab) WHERE (NOT a) ORDER BY b;
DROP TABLE t;

CREATE TABLE t(a VARCHAR(10), b INT, UNIQUE KEY idx_ab(a,b DESC))ENGINE=Dstore;
INSERT INTO t VALUES(NULL,NULL),('huawei',NULL),('amazon',NULL),('tecent',NULL);
ANALYZE TABLE t;
EXPLAIN SELECT * FROM t FORCE INDEX(idx_ab) WHERE a='' ORDER BY b;
SELECT * FROM t FORCE INDEX(idx_ab) WHERE a='' ORDER BY b;
EXPLAIN SELECT * FROM t IGNORE INDEX(idx_ab) WHERE a='' ORDER BY b;
SELECT * FROM t IGNORE INDEX(idx_ab) WHERE a='' ORDER BY b;

EXPLAIN SELECT * FROM t FORCE INDEX(idx_ab) WHERE a like 'h%' ORDER BY b;
SELECT * FROM t FORCE INDEX(idx_ab) WHERE a like 'h%' ORDER BY b;
EXPLAIN SELECT * FROM t IGNORE INDEX(idx_ab) WHERE a like 'h%' ORDER BY b;
SELECT * FROM t IGNORE INDEX(idx_ab) WHERE a like 'h%' ORDER BY b;
DROP TABLE t;

