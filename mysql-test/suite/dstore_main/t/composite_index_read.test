select * from t1 force index(a) where a is not null or a is null order by id;

#test only use the first col in index
select * from t1 force index(a) where a = 3 order by id;
select * from t1 force index(a) where a between 3 and 6 order by id;
select * from t1 force index(a) where a > 6 order by id;
select * from t1 force index(a) where a >= 7 order by id;
select * from t1 force index(a) where a < 3 order by id;
select * from t1 force index(a) where a >= -1 order by id;
