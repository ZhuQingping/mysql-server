# Test index on varchar, char columns
CREATE TABLE t(a int, v varchar(50), c char(50), d int, index(v,d), index(c,d));
INSERT INTO t VALUES(1,'v1','c1',1),(2,'v2','c2',2),(3,repeat('v',50),repeat('c', 50),3),(4,'huawei','taurusdb',4),(5,'alibaba','polardb',5);
INSERT INTO t SELECT * FROM t;
INSERT INTO t SELECT * FROM t;
INSERT INTO t SELECT * FROM t;
INSERT INTO t SELECT * FROM t;
INSERT INTO t SELECT * FROM t;
ANALYZE TABLE t;
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(*) FROM t WHERE v >= 'v1' AND v <= 'v2';
SELECT COUNT(*) FROM t WHERE v >= 'v1' AND v <= 'v2';
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(*) FROM t WHERE c >= 'c1' AND c <= 'c2';
SELECT COUNT(*) FROM t WHERE c >= 'c1' AND c <= 'c2';

--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(*) FROM t WHERE v = 'v1' AND d <= 2;
SELECT COUNT(*) FROM t WHERE v = 'v1' AND d <= 2;
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(*) FROM t WHERE c = 'c1' AND d <= 2;
SELECT COUNT(*) FROM t WHERE c = 'c1' AND d <= 2;

# Do not choose range if operator of prefix index column is not "="
--replace_column 10 # 11 #
EXPLAIN SELECT count(*) FROM t WHERE v BETWEEN 'v1' AND 'v2' AND d IN (2,3);
SELECT count(*) FROM t WHERE v BETWEEN 'v1' AND 'v2' AND d IN (2,3);
--replace_column 10 # 11 #
EXPLAIN SELECT count(*) FROM t WHERE c BETWEEN 'c1' AND 'c2' AND d IN (2,3);
SELECT count(*) FROM t WHERE c BETWEEN 'c1' AND 'c2' AND d IN (2,3);
DROP TABLE t;

