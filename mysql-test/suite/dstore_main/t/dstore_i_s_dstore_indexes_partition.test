DESCRIBE INFORMATION_SCHEMA.DSTORE_INDEXES;
-- disable_warnings
DROP DATABASE IF EXISTS IS_PUSHDOWN;
-- enable_warnings
CREATE DATABASE IS_PUSHDOWN;

USE IS_PUSHDOWN;

-- disable_warnings
DROP TABLE IF EXISTS sales;
DROP TABLE IF EXISTS t_audit_logs;
-- enable_warnings

CREATE TABLE sales (
    id INT NOT NULL,
    sale_date DATE NOT NULL,
    amount DECIMAL(10,2),
    content TEXT,
    PRIMARY KEY (id, sale_date) COMMENT 'fillfactor=50',
    INDEX idx_amount (amount) COMMENT 'fillfactor=60'
)
PARTITION BY RANGE (YEAR(sale_date)) (
    PARTITION p2023 VALUES LESS THAN (2024),
    PARTITION p2024 VALUES LESS THAN (2025),
    PARTITION p2025 VALUES LESS THAN (2026),
    PARTITION p_future VALUES LESS THAN MAXVALUE
);

CREATE TABLE t_audit_logs (
    id BIGINT NOT NULL AUTO_INCREMENT,
    log_time DATETIME NOT NULL,
    user_id INT,
    action_type VARCHAR(50),
    content TEXT,
    PRIMARY KEY (id, log_time)
)
PARTITION BY RANGE (YEAR(log_time))
SUBPARTITION BY HASH (id)
SUBPARTITIONS 4
(
    PARTITION p2024 VALUES LESS THAN (2025),
    
    PARTITION p2025 VALUES LESS THAN (2026),
    
    PARTITION p_future VALUES LESS THAN MAXVALUE
);

SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES;

--disable_query_log
SELECT SEGMENT_ID INTO @segment_id
FROM INFORMATION_SCHEMA.DSTORE_INDEXES 
WHERE TABLE_NAME = "sales" AND DB_NAME = "IS_PUSHDOWN" AND INDEX_NAME = "PRIMARY"
LIMIT 1;

SELECT SEGMENT_ID INTO @segment_id2
FROM INFORMATION_SCHEMA.DSTORE_INDEXES 
WHERE TABLE_NAME = "sales" AND DB_NAME = "IS_PUSHDOWN" AND INDEX_NAME = "NULL"
LIMIT 1;

SELECT SEGMENT_ID INTO @segment_id3
FROM INFORMATION_SCHEMA.DSTORE_INDEXES 
WHERE TABLE_NAME = "t_audit_logs" AND DB_NAME = "IS_PUSHDOWN" AND INDEX_NAME = "PRIMARY"
LIMIT 1;

SELECT SEGMENT_ID INTO @segment_id4
FROM INFORMATION_SCHEMA.DSTORE_INDEXES 
WHERE TABLE_NAME = "t_audit_logs" AND DB_NAME = "IS_PUSHDOWN" AND INDEX_NAME = "NULL"
LIMIT 1;
--enable_query_log

PREPARE stmt1 FROM 'SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES WHERE SEGMENT_ID = ?';
EXECUTE stmt1 USING @segment_id;
EXECUTE stmt1 USING @segment_id2;
EXECUTE stmt1 USING @segment_id3;
EXECUTE stmt1 USING @segment_id4;

SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES 
WHERE TABLE_NAME = "sales" AND DB_NAME = "IS_PUSHDOWN";

SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES 
WHERE TABLE_NAME = "t_audit_logs" AND DB_NAME = "IS_PUSHDOWN";

SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES 
WHERE DB_NAME = "IS_PUSHDOWN";

SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES 
WHERE TABLE_NAME = "t_audit_logs";

SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES 
WHERE TABLE_NAME = "sales";

SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES WHERE TABLE_NAME = "no_exist_table" AND DB_NAME = "no_exist_db";
SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES WHERE TABLE_NAME = "no_exist_table";
SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES WHERE DB_NAME = "no_exist_db";

SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES WHERE INDEX_NAME = "idx_amount";
SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES WHERE INDEX_NAME = "PRIMARY";
SELECT COUNT(*) FROM INFORMATION_SCHEMA.DSTORE_INDEXES WHERE DB_NAME = "IS_PUSHDOWN";

DROP TABLE sales;
DROP TABLE t_audit_logs;
DROP DATABASE IS_PUSHDOWN;