--source include/have_only_dstore.inc
--echo #
--echo #  The following cases should disable DDL info writing during query execution.
--echo #

--echo #  Case1: ANALYZE/OPTIMIZE more than one table.
CREATE TABLE t1(pk INT PRIMARY KEY, col1 INT DEFAULT NULL);
CREATE TABLE t2(pk INT PRIMARY KEY, col1 INT DEFAULT NULL);
INSERT INTO t1 VALUES (1,2),(2,3),(3,4);
INSERT INTO t2 VALUES (1,2),(2,3),(3,4);
ANALYZE TABLE t1,t2;
OPTIMIZE TABLE t1,t2;
DROP TABLE t1,t2;
