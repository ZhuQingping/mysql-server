USE test_ddl_crash_comprehensive;

--echo # Verify procedure comment should not be changed
SELECT ROUTINE_COMMENT FROM INFORMATION_SCHEMA.ROUTINES WHERE ROUTINE_NAME='p_crash';

--echo #  16.2 Crash after InnoDB prepare.
SET debug='reset';
SET debug='d, ib_trx_crash_after_prepare_done_step';
--source include/expect_crash.inc
--error 2013
ALTER PROCEDURE p_crash COMMENT 'crash test modified';

--source include/wait_until_disconnected.inc
--source include/start_mysqld.inc
USE test_ddl_crash_comprehensive;

--echo # Verify procedure comment should not be changed
