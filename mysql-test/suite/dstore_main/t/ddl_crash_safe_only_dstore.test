--source include/have_only_dstore.inc
--source include/have_debug.inc

--echo #
--echo #  This test check server can print an message when storage_engine_mode is BOTH_STORAGE_ENGINE
--echo #  while DDL info requires recovery.
--echo #

--echo #  1.3 Crash after DStore commited.
SET debug='reset';
SET debug='d, ddl_crash_safe_crash_after_commit_in_dstore';
--source include/expect_crash.inc
--error 2013
CREATE TABLE t1(pk INT PRIMARY KEY, col1 INT);
--source include/wait_until_disconnected.inc

--let SEARCH_FILE= $MYSQLTEST_VARDIR/tmp/only_dstore_error.log
--let SEARCH_PATTERN= DDL info found in DStore WAL requires recovery
--exec sh -c '$MYSQLD_CMD --user=root --storage_engine_mode=BOTH_STORAGE_ENGINE --disabled_storage_engines=InnoDB,CSV,Memory,MyISAM,MRG_MyISAM --default-storage-engine=Dstore --default-tmp-storage-engine=Dstore --datadir=$MYSQLTEST_VARDIR/mysqld.1/data --log-error=$SEARCH_FILE 2>&1; exit 0' || true
--source include/search_pattern.inc
--remove_file $SEARCH_FILE

--enable_reconnect
--source include/start_mysqld.inc
--disable_reconnect

DROP TABLE t1;
