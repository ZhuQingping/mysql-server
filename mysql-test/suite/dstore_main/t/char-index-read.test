--source include/have_only_dstore.inc
--echo #
--echo # CDE
--echo #
use test;
create table t53(id int, a int, b int, c CHAR(120), vc CHAR(120),key(id),key(a),key(a,b),key(c),key(vc)) engine=Dstore;
insert into t53 values(1,1,1,'111','aaa');
insert into t53 values(2,2,2,'222','bbb');
insert into t53 values(3,3,3,'333','ccc');
insert into t53 values(4,4,4,'444','ddd');
insert into t53 values(5,5,5,'555','eee');
insert into t53 values(6,6,6,'666','fff');
insert into t53 values(7,7,7,'777','ggg');
insert into t53 values(8,8,8,'888','hhh');
insert into t53 values(9,9,9,'999','iii');
--replace_column 7 #
show index from t53;
--sleep 1
#test char index read for CDE table
select * from t53 where c >= '111';
select * from t53 where c > '222';
select * from t53 where c < '333';
select * from t53 where c >= '444';
select * from t53 where c = '999';
select * from t53 where a < 5 and c > '111';
select * from t53 where vc >= 'hhh';
select * from t53 where vc > 'f';
select * from t53 where vc = 'ddd';
select * from t53 where vc < 'ddd';
select * from t53 where vc <= 'ddd';
--disable_result_log
--disable_query_log
drop table t53;