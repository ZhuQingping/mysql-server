--source include/have_only_dstore.inc

--exec echo "Stop the default MTR mysqld server."
--source include/shutdown_mysqld.inc
let $MYSQLD_DATADIR = $MYSQL_TMP_DIR/tmp_data;
let $MYSQLD_ERROR_LOG = $MYSQL_TMP_DIR/tmp_error.err;
let $MYSQLD_EXTRA_ARGS = --dstore_max_file_size=35184372088832;
let $MYSQLD_START_ARGS = --datadir=$MYSQLD_DATADIR --dstore_tenant_config=$MYSQL_DSTORE_TENANT_CONFIG_FILE --log_error_verbosity=1;

--mkdir $MYSQLD_DATADIR
--source include/initialize_datadir.inc

let $restart_parameters = restart: $MYSQLD_START_ARGS $MYSQLD_EXTRA_ARGS --log-error=$MYSQLD_ERROR_LOG;
--replace_result $MYSQLD_DATADIR MYSQLD_DATADIR $MYSQLD_ERROR_LOG MYSQLD_ERROR_LOG
--source include/start_mysqld_no_echo.inc
--exec echo "Started mysqld with dstore_max_file_size=35184372088832"

create table t1 (a int not null primary key, b char(255));
--disable_query_log
--let $1 = 1000
while ($1)
{
  eval insert into t1 values ('$1', REPEAT('-', 255)); 
  dec $1;
}
select count(*) from t1;
--enable_query_log
drop table t1;
--source include/shutdown_mysqld.inc

--force-rmdir $MYSQLD_DATADIR
--mkdir $MYSQLD_DATADIR
let $MYSQLD_EXTRA_ARGS = --dstore_max_file_size=17592186044416;
--source include/initialize_datadir.inc
let $restart_parameters = restart: $MYSQLD_START_ARGS $MYSQLD_EXTRA_ARGS;
--replace_result $MYSQLD_DATADIR MYSQLD_DATADIR $MYSQLD_ERROR_LOG MYSQLD_ERROR_LOG
--source include/start_mysqld_no_echo.inc
--exec echo "Started mysqld with dstore_max_file_size=17592186044416"

