  CONVERT(UNHEX(REPEAT('F0A08080', 1000)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT('F0A08080', 1000)) USING utf8mb4)
);

--connection con1
start transaction;
# insert data
INSERT INTO t2 (
  var1, var2, var3, var4, var5, var6, var7, var8, 
  var9, var10, var11, var12, var13, var14, var15, var16
) VALUES ('a','a','a','a','a','a','a','a','a','a','a','a','a','a','a','a');

--connection con2
start transaction;
# insert data
INSERT INTO t2 (
  var1, var2, var3, var4, var5, var6, var7, var8, 
  var9, var10, var11, var12, var13, var14, var15, var16
) VALUES ('b','b','b','b','b','b','b','b','b','b','b','b','b','b','b','b');

--connection con3
start transaction;
# insert data
INSERT INTO t2 (
  var1, var2, var3, var4, var5, var6, var7, var8, 
  var9, var10, var11, var12, var13, var14, var15, var16
) VALUES ('c','c','c','c','c','c','c','c','c','c','c','c','c','c','c','c');

--connection con4
start transaction;
INSERT INTO t2 (
  var1, var2, var3, var4, var5, var6, var7, var8, 
  var9, var10, var11, var12, var13, var14, var15, var16
) VALUES ('d','d','d','d','d','d','d','d','d','d','d','d','d','d','d','d');

# check that index page max TD count is 4
--connection con5
start transaction;
CALL mtr.add_suppression("insert dstore index tuple fail");
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t2 (
  var1, var2, var3, var4, var5, var6, var7, var8, 
  var9, var10, var11, var12, var13, var14, var15, var16
) VALUES ('e','e','e','e','e','e','e','e','e','e','e','e','e','e','e','e');

--connection con1
commit;
--connection con2
commit;
--connection con3
commit;
--connection con4
commit;
--connection con5
commit;
select count(*) from t2;

select @@dstore_ddl_threads;
alter table t2 add key(var1(10), var2(10), var3(10), var4(10), var5(10), var6(10), var7(10), var8(10), var9(10), var10(10), var11(10), var12(10), var13(10), var14(10), var15(200), var16(300)), algorithm=inplace;

--error ER_TOO_LONG_KEY
create table t3(
var1 varbinary(2561) DEFAULT NULL,
KEY d (var1)
) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

--error ER_TOO_LONG_KEY
create table t3(
var1 varbinary(100) DEFAULT NULL,
var2 varbinary(100) DEFAULT NULL,
var3 varbinary(100) DEFAULT NULL,
var4 varbinary(100) DEFAULT NULL,
var5 varbinary(100) DEFAULT NULL,
var6 varbinary(100) DEFAULT NULL,
var7 varbinary(100) DEFAULT NULL,
var8 varbinary(100) DEFAULT NULL,
var9 varbinary(100) DEFAULT NULL,
var10 varbinary(100) DEFAULT NULL,
var11 varbinary(100) DEFAULT NULL,
var12 varbinary(100) DEFAULT NULL,
var13 varbinary(100) DEFAULT NULL,
var14 varbinary(100) DEFAULT NULL,
var15 varbinary(100) DEFAULT NULL,
var16 varbinary(1061) DEFAULT NULL,
KEY d (var1, var2, var3, var4, var5, var6, var7, var8, var9, var10, var11, var12, var13, var14, var15, var16)
) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

set global dstore_expand_key_len_by_td=0;
select @@dstore_expand_key_len_by_td;

--error ER_TOO_LONG_KEY
create table t3(
var1 varbinary(911) DEFAULT NULL,
KEY d (var1)
) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

create table t3(
var1 varbinary(910) DEFAULT NULL,
KEY d (var1)
) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

set global dstore_expand_key_len_by_td=1;

drop table t0;
drop table t1;
drop table t2;
drop table t3;
