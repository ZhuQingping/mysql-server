--source include/have_only_dstore.inc
--source include/have_debug.inc


SELECT @@global.dstore_expand_key_len_by_td;
use test;

# create index with 2560 length
create table t0(
var1 varchar(640) DEFAULT NULL,
KEY d (var1)
) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

# create index with 2560 length
create table t1(
var1 varchar(10) DEFAULT NULL,
var2 varchar(10) DEFAULT NULL,
var3 varchar(10) DEFAULT NULL,
var4 varchar(10) DEFAULT NULL,
var5 varchar(10) DEFAULT NULL,
var6 varchar(10) DEFAULT NULL,
var7 varchar(10) DEFAULT NULL,
var8 varchar(10) DEFAULT NULL,
var9 varchar(10) DEFAULT NULL,
var10 varchar(10) DEFAULT NULL,
var11 varchar(10) DEFAULT NULL,
var12 varchar(10) DEFAULT NULL,
var13 varchar(10) DEFAULT NULL,
var14 varchar(10) DEFAULT NULL,
var15 varchar(10) DEFAULT NULL,
var16 varchar(490) DEFAULT NULL,
KEY d (var1, var2, var3, var4, var5, var6, var7, var8, var9, var10, var11, var12, var13, var14, var15, var16)
) DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

SET @four_byte_char = 'F0A08080';

# insert data
INSERT INTO t1 (
  var1, var2, var3, var4, var5, var6, var7, var8, 
  var9, var10, var11, var12, var13, var14, var15, var16
) VALUES (
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4)
);

SET @four_byte_char = 'F0A0AEB7';

# insert data
INSERT INTO t1 (
  var1, var2, var3, var4, var5, var6, var7, var8, 
  var9, var10, var11, var12, var13, var14, var15, var16
) VALUES (
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
  CONVERT(UNHEX(REPEAT(@four_byte_char, 10)) USING utf8mb4),
