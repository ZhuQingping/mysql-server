#
# wl#8919  Implement NOWAIT and SKIP LOCKED
#

--source include/count_sessions.inc
--source include/not_hypergraph.inc   # Depends on indexes being used, which the hypergraph optimizer does not support.

SET global dstore_lock_wait_timeout=1;
connect (con1,localhost,root,,);

connection default;

--echo # Case 1: Test primary index
CREATE TABLE t1(
        seat_id    INT,
        state      INT,
        PRIMARY KEY(seat_id)
) ENGINE=Dstore;

INSERT INTO t1 VALUES(1,0), (2,0), (3,0), (4,0);

BEGIN;
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR SHARE;

connection con1;
BEGIN;

--error ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t1 WHERE state = 0 LIMIT 2 LOCK IN SHARE MODE;
--error ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR SHARE;

--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR SHARE NOWAIT;
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR SHARE SKIP LOCKED;

--error ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR UPDATE;

--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR UPDATE NOWAIT;
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR UPDATE SKIP LOCKED;

--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE seat_id > 0 LIMIT 2 FOR UPDATE NOWAIT;
SELECT * FROM t1 WHERE seat_id > 0 LIMIT 2 FOR UPDATE SKIP LOCKED;

COMMIT;

connection default;
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR UPDATE;

connection con1;
--error ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t1 WHERE state = 0 LIMIT 2 LOCK IN SHARE MODE;

--error ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR SHARE;

--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR SHARE NOWAIT;
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR SHARE SKIP LOCKED;

--error ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR UPDATE;

--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR UPDATE NOWAIT;
SELECT * FROM t1 WHERE state = 0 LIMIT 2 FOR UPDATE SKIP LOCKED;

--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE seat_id > 0 LIMIT 2 FOR UPDATE NOWAIT;
SELECT * FROM t1 WHERE seat_id > 0 LIMIT 2 FOR UPDATE SKIP LOCKED;

COMMIT;

connection default;
COMMIT;

DROP TABLE t1;

--echo # Case 2: Test primary index & secondary index
CREATE TABLE t1(
        seat_id    INT,
        row_id     INT,
        state      INT,
        PRIMARY KEY(seat_id),
        KEY(row_id)
) ENGINE=Dstore;

INSERT INTO t1 VALUES(1,1,0), (2,1,0), (3,2,0), (4,2,0);

--echo # Test secondary key
# Case 2a: secondary blocks secondary/primary
BEGIN;
SELECT * FROM t1 WHERE state = 0 AND row_id = 1 LIMIT 1 FOR UPDATE NOWAIT;

connection con1;
BEGIN;
--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE state = 0 AND row_id = 1 LIMIT 1 FOR UPDATE NOWAIT;
SELECT * FROM t1 WHERE state = 0 AND row_id = 1 LIMIT 1 FOR UPDATE SKIP LOCKED;

--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE state = 0 AND row_id > 0 LIMIT 1 FOR UPDATE NOWAIT;
SELECT * FROM t1 WHERE state = 0 AND row_id > 0 LIMIT 1 FOR UPDATE SKIP LOCKED;

--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE state = 0 FOR UPDATE NOWAIT;
SELECT * FROM t1 WHERE state = 0 FOR UPDATE SKIP LOCKED;

COMMIT;

connection default;
COMMIT;

# Case 2b: primary blocks secondary/primary
BEGIN;
SELECT * FROM t1 WHERE seat_id = 1 FOR UPDATE NOWAIT;

connection con1;
BEGIN;
--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE state = 0 AND row_id = 1 LIMIT 1 FOR UPDATE NOWAIT;
SELECT * FROM t1 WHERE state = 0 AND row_id = 1 LIMIT 1 FOR UPDATE SKIP LOCKED;

--error ER_LOCK_NOWAIT
SELECT * FROM t1 WHERE state = 0 FOR UPDATE NOWAIT;
SELECT * FROM t1 WHERE state = 0 FOR UPDATE SKIP LOCKED;

COMMIT;

connection default;
COMMIT;

DROP TABLE t1;

--echo # Case 3: Test for CdeLockTuple fail in ReadIndexOnly
CREATE TABLE t1(
        seat_id    INT,
        row_id     INT,
        state      INT,
        PRIMARY KEY(seat_id),
        KEY(row_id)
) ENGINE=Dstore;

INSERT INTO t1 VALUES(1,1,0), (2,1,0), (3,2,0), (4,2,0);

BEGIN;
SELECT row_id FROM t1 WHERE row_id = 1 FOR UPDATE NOWAIT;

connection con1;
BEGIN;
--error ER_LOCK_NOWAIT
SELECT row_id FROM t1 WHERE row_id = 1 FOR UPDATE NOWAIT;
SELECT row_id FROM t1 WHERE row_id = 1 FOR UPDATE SKIP LOCKED;
COMMIT;

connection default;
COMMIT;

DROP TABLE t1;

SET global dstore_lock_wait_timeout=default;
--echo # Case 4: Test for CdeLockNewestTuple Case
call mtr.add_suppression("lock newest tuple failed.*");
call mtr.add_suppression("Got error 10006 when reading table.*");

connect (con2,localhost,root,,);

CREATE TABLE t1(
        seat_id    INT,
        state      INT,
        PRIMARY KEY(seat_id)
) ENGINE=Dstore;

INSERT INTO t1 VALUES(1,0), (2,0), (3,0), (4,0);

connection default;
begin;
update t1 set seat_id = 1000000000 where seat_id  = 4;

--sleep 5
connection con1;
set debug_sync = "before_lock_tuple WAIT_FOR continue1 EXECUTE 2";
--send select * from t1 where seat_id = 4 for update NOWAIT;

connection con2;
set debug_sync = "before_lock_tuple WAIT_FOR continue2 EXECUTE 2";
--send select * from t1 where seat_id = 4 for update SKIP LOCKED;

connection default;
commit;
set debug_sync = "now signal continue1";
set debug_sync = "now signal continue2";

--sleep 5
begin;
select * from t1 where seat_id = 1000000000 for update;
set debug_sync = "now signal continue1";
set debug_sync = "now signal continue2";

connection con1;
--error ER_LOCK_NOWAIT
--reap

connection con2;
--reap

connection default;
commit;

DROP TABLE t1;

disconnect con1;
disconnect con2;

--source include/wait_until_count_sessions.inc
