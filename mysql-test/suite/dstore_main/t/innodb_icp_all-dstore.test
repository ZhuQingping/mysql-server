--source include/have_only_dstore.inc
set optimizer_switch='semijoin=on,materialization=on,firstmatch=on,loosescan=on,index_condition_pushdown=on,mrr=on';


set @save_storage_engine= @@default_storage_engine;
set default_storage_engine=Dstore;
set global rds_empty_redundant_check_in_range_scan=false;
set session rds_empty_redundant_check_in_range_scan=false;

--source include/icp_tests-dstore.inc

set session rds_empty_redundant_check_in_range_scan=true;
set global rds_empty_redundant_check_in_range_scan=true;
set default_storage_engine= @save_storage_engine;
set optimizer_switch=default;
