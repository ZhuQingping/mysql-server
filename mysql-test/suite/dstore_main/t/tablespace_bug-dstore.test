--source include/have_only_dstore.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc

--echo #
--echo # BUG2026040128480 Forbid drop dstore_default tablespace when there are tables in it
--echo #
CREATE TABLE test (c1 int);

--echo # Test 1: We cannot drop dstore_default tablespace when we have table in it.
--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

--echo # Test 2: We cannot drop dstore_default tablespace when we rebuild the table in it.
OPTIMIZE TABLE test;
--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

--echo # Test 3: We cannot drop dstore_default tablespace when we use copy algorithm to alter table
alter table test add column c2 int, algorithm = COPY;
--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

--echo # Test 4: We cannot drop dstore_default tablespace when we use inplace algorithm to alter table
alter table test add index (c1), algorithm = INPLACE;
--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

--echo # Test 5: We cannot drop dstore_default tablespace when a CREATE TABLE xxx LIKE table exist
CREATE TABLE test2 like test;
drop table test;
--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

drop table test2;
--echo # Success drop default tablespace 
DROP TABLESPACE dstore_default;

--echo # Test 6: Test for parition table
CREATE TABLE orders (
    id INT NOT NULL,
    order_date DATE NOT NULL,
    customer_id INT,
    amount DECIMAL(10,2),
    PRIMARY KEY (id, order_date)
)
PARTITION BY RANGE (YEAR(order_date)) (
    PARTITION p2023 VALUES LESS THAN (2024),
    PARTITION p2024 VALUES LESS THAN (2025),
    PARTITION p_future VALUES LESS THAN MAXVALUE
);

--echo # Test 6.1:  We cannot drop dstore_default tablespace when we have table in it.
TRUNCATE TABLE orders;
--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

--echo # Test 6.2: We cannot drop dstore_default tablespace when we rebuild the table in it.
OPTIMIZE TABLE orders;
--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

--echo # Test 6.3: We cannot drop dstore_default tablespace when we use copy algorithm to alter table
alter table orders add column c2 int, algorithm = COPY;
--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

--echo # Test 6.4: We cannot drop dstore_default tablespace when a CREATE TABLE xxx LIKE table exist
CREATE TABLE orders2 like orders;
drop table orders;
--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

drop table orders2;
--echo # Success drop default tablespace 
DROP TABLESPACE dstore_default;

--echo # Test 7: We can create temporary table without specify tempory table space
CREATE TEMPORARY TABLE t1 (c1 int);

DROP TABLE t1;

--echo # Test 8: Show create table does not show the tablespace for dstore_default tablespace
CREATE TABLE t1 (c1 int);
SHOW CREATE TABLE t1;

--echo # Test 9: We can alter it to innodb engine
ALTER TABLE t1 ENGINE=innodb;

--echo # Test 10: We can use create temporary table xxx like
CREATE TEMPORARY TABLE t2 LIKE t1;

--echo # Test 11: We can use alter table to INNODB
alter table t1 engine=innodb;

--echo # Test 12: We can use alter table to Dstore
alter table t1 engine=dstore;

DROP TABLE t1;

--echo # Test 13: We can create partition table with only specify engine innodb in partition clause
CREATE TABLE t1 (
a int not null,
b int not null,
c int not null,
primary key(a,b))
partition by key (a)
partitions 3
(partition x1 engine innodb,
partition x2 engine innodb,
partition x3 engine innodb);
DROP TABLE t1;

--echo # Test 14: Test for create xxx select SQL
CREATE TABLE t1 AS SELECT REPEAT(' ', 10) AS s1 LIMIT 0;
ALTER TABLE t1 ADD KEY s1 (s1);

--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

DROP TABLE t1;

--echo # Test 15: Test for tablespace length = 0
SET DEBUG = "+d, mock_tablespace_len0";
CREATE TABLE t1 AS SELECT REPEAT(' ', 10) AS s1 LIMIT 0;
ALTER TABLE t1 ADD KEY s1 (s1);

--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

DROP TABLE t1;

CREATE TABLE test (c1 int);
OPTIMIZE TABLE test;

--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

CREATE TABLE test2 like test;
drop table test;
--error ER_TABLESPACE_IS_NOT_EMPTY
DROP TABLESPACE dstore_default;

drop table test2;
