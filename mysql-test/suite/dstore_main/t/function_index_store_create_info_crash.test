--echo ########################################################################
--echo # Bug: Server crash when field key_length != key_part length in function index field
--echo ########################################################################
 
--echo # Save original sql_mode
let $saved_sql_mode = `SELECT @@sql_mode`;
SET sql_mode = 'NO_ENGINE_SUBSTITUTION';
 
--echo #
--echo # Case 1: Test functional index with mismatched key length
--echo # Expected: Before patch, server crashes at store_create_ddl_info()
--echo #
--disable_warnings
--echo # Test 1.1: Direct creation
CREATE TABLE t1(pk INT PRIMARY KEY, c1 VARCHAR(255), KEY ci((REVERSE(c1)))) CHARSET=utf8mb4;
SHOW CREATE TABLE t1;

--echo # Test 1.2: Create with small then convert to big
CREATE TABLE t2(pk INT PRIMARY KEY, c1 VARCHAR(255), KEY ci((REVERSE(c1)))) CHARSET=utf8mb3;
ALTER TABLE t2 CONVERT TO CHARACTER SET utf8mb4;
SHOW CREATE TABLE t2;

--echo # Test 1.3: Create with InnoDB then convert to dstore.
CREATE TABLE t3(pk INT PRIMARY KEY, c1 VARCHAR(255), KEY ci((REVERSE(c1)))) ENGINE=InnoDB CHARSET=utf8mb4;
ALTER TABLE t3 ENGINE=Dstore;
SHOW CREATE TABLE t3;
INSERT INTO t3 VALUES (1,"Z"),(2,"ZH"),(3,"ZHA"),(4,"ZHAN"),(5,"ZHANG");
EXPLAIN SELECT * FROM t3 WHERE REVERSE(c1) = "AHZ";

--echo # Test 1.4: Create index on virtual column.
CREATE TABLE t4 ( id INT PRIMARY KEY AUTO_INCREMENT, first_name VARCHAR(50) NOT NULL, last_name VARCHAR(50) NOT NULL, full_name VARCHAR(101) AS (CONCAT(last_name, ' ', first_name)), INDEX idx_full_name_prefix(full_name(20)));
SHOW CREATE TABLE t4;
INSERT INTO t4(id, first_name, last_name) VALUES (1,"S","Z"),(2,"SA","ZH"),(3,"SAN","ZHA"),(4,"SANS","ZHAN"),(5,"SANSA","ZHANG");
EXPLAIN SELECT * FROM t4 WHERE full_name = "SAN ZHA";
--enable_warnings

--echo # Cleanup
DROP TABLE t1,t2,t3,t4;
 
--echo # Restore original sql_mode
--disable_query_log
eval SET sql_mode = '$saved_sql_mode';
--enable_query_log

--echo ########################################################################
--echo # End of Test
--echo ########################################################################
