#
# Check for problems with  partial rollback for dstore
#

--source include/have_only_dstore.inc
--disable_warnings

set explicit_defaults_for_timestamp=ON;
set sql_mode = '';
drop database if exists zxf;
create database zxf;
create table zxf.obright(grp_id int,row_id int,row_hex varchar(100),v1 varchar(100),v_check int,c1 int,c2 int,c3 int,c4 int,c5 int,c6 int,c7 int,c8 int,c9 int,c10 varchar(100),c11 int,c12 varchar(100),c13 int,c14 varchar(100),trx_grp int,r1 int,r2 int,v3 varchar(100),v4 varchar(100),t3 timestamp,v5 varchar(100),d1 int,dec_1 decimal(16,4),dec_2 decimal(16,4),dec_3 decimal(16,6),dec_4 decimal(16,6),gmt_create timestamp,gmt_modify timestamp,primary key(grp_id,row_id,row_hex));
alter table zxf.obright add unique key(row_hex);

create table zxf.tmp_obright(i int);
create table zxf.load_obright as select * from zxf.obright limit 0;

delimiter |;
create trigger zxf.auth_secure before update on zxf.obright FOR EACH ROW
BEGIN
insert into zxf.tmp_obright values(1);
end|
DELIMITER ;|

--enable_warnings

#
# Test of  parital rollback for dstore #
#

insert into zxf.load_obright( grp_id,row_id,row_hex,c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11,c12,c13,c14,trx_grp,v3,v4,t3,v5,d1,dec_3,dec_4,v1,v_check,r1,dec_1,r2,dec_2,gmt_create,gmt_modify) select floor(6004/300),6004,CAST(6004 as char),mod(6004,2),mod(6004,3),floor(6004/2),floor(6004/3),floor(6004/2)+mod(6004,3),mod(6004,2),floor(6004/2)*2,floor(6004/3)*3,mod(6004,10000-mod(10000,6004/6)),CAST(mod(6004,10000-mod(10000,6004/6)) as char),mod(6004,100000-mod(100000,6004/6)),CAST(mod(6004,100000-mod(100000,6004/6)) as char),mod(6004,1024-mod(1024,6004/6)),CAST(mod(6004,1024-mod(1024,6004/6)) as char),6004/300,CAST(6004 as char),CAST(6004 as char),DATE_FORMAT(now() + interval CAST(mod(6004*1000,9000)+1000 as char) second, '%Y-%m-%d %H:%i:%s'),null,0,6004/1000000,100.001,-656,656,714,714*1024/10000*1024,-508,-508*1024/10000*1024,current_timestamp,null from dual;

insert into zxf.load_obright( grp_id,row_id,row_hex,c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11,c12,c13,c14,trx_grp,v3,v4,t3,v5,d1,dec_3,dec_4,v1,v_check,r1,dec_1,r2,dec_2,gmt_create,gmt_modify) select floor(6005/300),6005,CAST(6005 as char),mod(6005,2),mod(6005,3),floor(6005/2),floor(6005/3),floor(6005/2)+mod(6005,3),mod(6005,2),floor(6005/2)*2,floor(6005/3)*3,mod(6005,10000-mod(10000,6005/6)),CAST(mod(6005,10000-mod(10000,6005/6)) as char),mod(6005,100000-mod(100000,6005/6)),CAST(mod(6005,100000-mod(100000,6005/6)) as char),mod(6005,1024-mod(1024,6005/6)),CAST(mod(6005,1024-mod(1024,6005/6)) as char),6005/300,CAST(6005 as char),CAST(6005 as char),DATE_FORMAT(now() + interval CAST(mod(6005*1000,9000)+1000 as char) second, '%Y-%m-%d %H:%i:%s'),null,0,6005/1000000,100.001,-59,59,-533,-533*1024/10000*1024,-877,-877*1024/10000*1024,current_timestamp,null from dual;

insert into zxf.load_obright( grp_id,row_id,row_hex,c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11,c12,c13,c14,trx_grp,v3,v4,t3,v5,d1,dec_3,dec_4,v1,v_check,r1,dec_1,r2,dec_2,gmt_create,gmt_modify) select floor(6006/300),6006,CAST(6006 as char),mod(6006,2),mod(6006,3),floor(6006/2),floor(6006/3),floor(6006/2)+mod(6006,3),mod(6006,2),floor(6006/2)*2,floor(6006/3)*3,mod(6006,10000-mod(10000,6006/6)),CAST(mod(6006,10000-mod(10000,6006/6)) as char),mod(6006,100000-mod(100000,6006/6)),CAST(mod(6006,100000-mod(100000,6006/6)) as char),mod(6006,1024-mod(1024,6006/6)),CAST(mod(6006,1024-mod(1024,6006/6)) as char),6006/300,CAST(6006 as char),CAST(6006 as char),DATE_FORMAT(now() + interval CAST(mod(6006*1000,9000)+1000 as char) second, '%Y-%m-%d %H:%i:%s'),null,0,6006/1000000,100.001,1006,-1006,-405,-405*1024/10000*1024,149,149*1024/10000*1024,current_timestamp,null from dual;
 
insert into zxf.obright select * from zxf.load_obright;
insert into zxf.tmp_obright values(20);
select row_hex,r1,r2,dec_1,dec_2 from zxf.obright order by 1,2,3;
 
begin;
--error 1062
update zxf.obright set row_hex = 'ZXFFAKE', r1=98568, dec_1=1198568 where grp_id=floor(6209/300);
commit;
 
select count(*) from zxf.obright;
select * from zxf.obright where row_hex='ZXFFAKE';
select row_hex,r1,r2,dec_1,dec_2 from zxf.obright order by 1,2,3;

drop database zxf;




