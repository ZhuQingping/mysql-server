# ==== Purpose ====
#
# Verify that committing a big trx does not cause crash.
#
# ==== References ====
#
# US2025030700425   Write binlog records into wal and read them out
#

--source include/have_binlog_format_row.inc
--source include/have_only_dstore.inc

SET SQL_LOG_BIN = 0;
call mtr.add_suppression("binlog event size over size 63k, gno is*");
SET SQL_LOG_BIN = 1;

reset master;
CREATE TABLE t1 (c1 INT, c2 text);
begin;
INSERT INTO t1 VALUES(1, REPEAT('a', 16383));
INSERT INTO t1 VALUES(1, REPEAT('a', 16383));
INSERT INTO t1 VALUES(1, REPEAT('a', 16383));
INSERT INTO t1 VALUES(1, REPEAT('a', 16383));
INSERT INTO t1 VALUES(1, REPEAT('a', 16383));
commit;

drop table t1;
