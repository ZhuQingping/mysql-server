--echo # test bug BUG2025060533643
DROP TABLE IF EXISTS all_data_types;
DROP TABLE IF EXISTS related_table;

CREATE TABLE related_table (
  ref_id INT AUTO_INCREMENT PRIMARY KEY,
  ref_name VARCHAR(50) NOT NULL
) ENGINE=Dstore;

INSERT INTO related_table (ref_name) 
VALUES ('Ref1'),('Ref2'),('Ref3'),('Ref4'),('Ref5');

CREATE TABLE all_data_types (
  id INT AUTO_INCREMENT PRIMARY KEY,
  
  char_col CHAR(10),
  varchar_col VARCHAR(100),
  
  binary_col BINARY(20),
  varbinary_col VARBINARY(100),
  
  tinyblob_col TINYBLOB,
  blob_col BLOB,
  mediumblob_col BLOB,
  longblob_col BLOB,
  
  tinytext_col TINYTEXT,
  text_col TEXT,
  mediumtext_col TEXT,
  longtext_col TEXT,

  ref_id INT,
  
  INDEX idx_varchar_prefix (varchar_col(10)),

  CONSTRAINT fk_related_ref 
    FOREIGN KEY (ref_id) 
    REFERENCES related_table(ref_id)
    ON DELETE SET NULL
    ON UPDATE CASCADE
) ENGINE=Dstore ROW_FORMAT=DYNAMIC;

DELIMITER $;
DROP PROCEDURE IF EXISTS insert_10k_rows;
CREATE PROCEDURE insert_10k_rows(IN max_count INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  DECLARE max_ref INT;

  SELECT MAX(ref_id) INTO max_ref FROM related_table;
  IF max_ref IS NULL THEN SET max_ref = 1; END IF;

  SET foreign_key_checks = 0;
  ALTER TABLE all_data_types DISABLE KEYS;
  
  START TRANSACTION;
  
  WHILE i < max_count DO
    SET @rand_num = FLOOR(RAND() * 10000) + 1;
    SET @rand_str = CONCAT('Str_', LEFT(UUID(), 8));
    SET @rand_date = DATE_ADD('2000-01-01', INTERVAL FLOOR(RAND() * 8000) DAY);
    SET @rand_time = SEC_TO_TIME(FLOOR(RAND() * 86400));
    SET @ref_id = FLOOR(1 + RAND() * max_ref);

    INSERT INTO all_data_types (
      char_col,
      varchar_col,
      binary_col,
      varbinary_col,
      tinyblob_col,
      blob_col,
      mediumblob_col,
      longblob_col,
      tinytext_col,
      text_col,
      mediumtext_col,
      longtext_col,
      ref_id
    ) VALUES (  
      LEFT(@rand_str, 10), 
      @rand_str,        
      UNHEX(HEX(@rand_str)), 
      UNHEX(HEX(@rand_str)), 
      RANDOM_BYTES(100), 
      RANDOM_BYTES(1000),
      RANDOM_BYTES(1000),
      RANDOM_BYTES(1000),
      LEFT(@rand_str, 50), 
      CONCAT(@rand_str, ' ', REPEAT('Text ', 10)), 
      CONCAT(@rand_str, ' ', REPEAT('MediumText ', 20)), 
      CONCAT(@rand_str, ' ', REPEAT('LongText ', 50)), 
      @ref_id
    );
    
    SET i = i + 1;

  END WHILE;
  
  COMMIT;
  
  ALTER TABLE all_data_types ENABLE KEYS;
  SET foreign_key_checks = 1;
  
  OPTIMIZE TABLE all_data_types;
END$

DELIMITER ;$

CALL insert_10k_rows(200);

DELETE FROM related_table WHERE ref_id = 1;

DROP PROCEDURE IF EXISTS insert_10k_rows;
DROP TABLE IF EXISTS all_data_types;
DROP TABLE IF EXISTS related_table;

CREATE TABLE related_table (
  ref_id INT AUTO_INCREMENT PRIMARY KEY,
  ref_name VARCHAR(50) NOT NULL
) ENGINE=Dstore;

INSERT INTO related_table (ref_name) 
VALUES ('Ref1'),('Ref2'),('Ref3'),('Ref4'),('Ref5');

CREATE TABLE all_data_types (
  id INT AUTO_INCREMENT PRIMARY KEY,
  
  char_col CHAR(10),
  varchar_col VARCHAR(100),
  
  binary_col BINARY(20),
  varbinary_col VARBINARY(100),
  
  tinyblob_col TINYBLOB,
  blob_col BLOB,
  mediumblob_col BLOB,
  longblob_col BLOB,
  
  tinytext_col TINYTEXT,
  text_col TEXT,
  mediumtext_col TEXT,
  longtext_col TEXT,

  ref_id INT,
  
  INDEX idx_varchar_prefix (varchar_col(10)),

  CONSTRAINT fk_related_ref 
    FOREIGN KEY (ref_id) 
    REFERENCES related_table(ref_id)
    ON DELETE CASCADE
    ON UPDATE CASCADE
) ENGINE=Dstore ROW_FORMAT=DYNAMIC;

DELIMITER $;
DROP PROCEDURE IF EXISTS insert_10k_rows_ref_id_no_random;
CREATE PROCEDURE insert_10k_rows_ref_id_no_random(IN max_count INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  DECLARE max_ref INT;

  SELECT MAX(ref_id) INTO max_ref FROM related_table;
  IF max_ref IS NULL THEN SET max_ref = 1; END IF;

  SET foreign_key_checks = 0;
  ALTER TABLE all_data_types DISABLE KEYS;
  
  START TRANSACTION;
  
  WHILE i < max_count DO
    SET @rand_num = FLOOR(RAND() * 10000) + 1;
    SET @rand_str = CONCAT('Str_', LEFT(UUID(), 8));
    SET @rand_date = DATE_ADD('2000-01-01', INTERVAL FLOOR(RAND() * 8000) DAY);
    SET @rand_time = SEC_TO_TIME(FLOOR(RAND() * 86400));
    SET @ref_id = i + 1;

    INSERT INTO all_data_types (
      char_col,
      varchar_col,
      binary_col,
      varbinary_col,
      tinyblob_col,
      blob_col,
      mediumblob_col,
      longblob_col,
      tinytext_col,
      text_col,
      mediumtext_col,
      longtext_col,
      ref_id
    ) VALUES (  
      LEFT(@rand_str, 10), 
      @rand_str,        
      UNHEX(HEX(@rand_str)), 
      UNHEX(HEX(@rand_str)), 
      RANDOM_BYTES(100), 
      RANDOM_BYTES(1000),
      RANDOM_BYTES(1000),
      RANDOM_BYTES(1000),
      LEFT(@rand_str, 50), 
      CONCAT(@rand_str, ' ', REPEAT('Text ', 10)), 
      CONCAT(@rand_str, ' ', REPEAT('MediumText ', 20)), 
      CONCAT(@rand_str, ' ', REPEAT('LongText ', 50)), 
      @ref_id
    );
    
    SET i = i + 1;

  END WHILE;
  
  COMMIT;
  
  ALTER TABLE all_data_types ENABLE KEYS;
  SET foreign_key_checks = 1;
  
  OPTIMIZE TABLE all_data_types;
END$

DELIMITER ;$

CALL insert_10k_rows_ref_id_no_random(200);

SELECT COUNT(*) FROM related_table WHERE ref_id = 1;
SELECT COUNT(*) FROM all_data_types WHERE ref_id = 1;
DELETE FROM related_table WHERE ref_id = 1;
SELECT COUNT(*) FROM related_table WHERE ref_id = 1;
SELECT COUNT(*) FROM all_data_types WHERE ref_id = 1;

DROP TABLE all_data_types;
TRUNCATE TABLE related_table;

INSERT INTO related_table (ref_name) 
VALUES ('Ref1'),('Ref2'),('Ref3'),('Ref4'),('Ref5');

CREATE TABLE all_data_types (
  id INT AUTO_INCREMENT PRIMARY KEY,
  
  char_col CHAR(10),
  varchar_col VARCHAR(100),
  
  binary_col BINARY(20),
  varbinary_col VARBINARY(100),
  
  tinyblob_col TINYBLOB,
  blob_col BLOB,
  mediumblob_col BLOB,
  longblob_col BLOB,
  
  tinytext_col TINYTEXT,
  text_col TEXT,
  mediumtext_col TEXT,
  longtext_col TEXT,

  ref_id INT,
  
  INDEX idx_varchar_prefix (varchar_col(10)),

  CONSTRAINT fk_related_ref 
    FOREIGN KEY (ref_id) 
    REFERENCES related_table(ref_id)
    ON DELETE SET NULL
    ON UPDATE CASCADE
) ENGINE=Dstore ROW_FORMAT=DYNAMIC;

CALL insert_10k_rows_ref_id_no_random(200);

SET foreign_key_checks = 1;

SELECT COUNT(*) FROM related_table WHERE ref_id = 1;
SELECT COUNT(*) FROM related_table WHERE ref_id = 1008;
SELECT COUNT(*) FROM all_data_types WHERE ref_id = 1;
SELECT COUNT(*) FROM all_data_types WHERE ref_id = 1008;
UPDATE related_table SET ref_id = 1008 WHERE ref_id = 1;
SELECT COUNT(*) FROM related_table WHERE ref_id = 1;
SELECT COUNT(*) FROM related_table WHERE ref_id = 1008;
SELECT COUNT(*) FROM all_data_types WHERE ref_id = 1;
SELECT COUNT(*) FROM all_data_types WHERE ref_id = 1008;

DROP PROCEDURE insert_10k_rows_ref_id_no_random;
DROP TABLE all_data_types;
DROP TABLE related_table;
