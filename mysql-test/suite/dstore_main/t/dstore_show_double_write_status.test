CALL mtr.add_suppression(".*Get double write info failed.*");

show status like "Dstore_double_write_init_normal";

--let $restart_parameters=restart:--dstore-enable-double-write=OFF
--source include/restart_mysqld.inc
show status like "Dstore_double_write_init_normal";

--let $restart_parameters=restart:--dstore-enable-double-write=ON
--source include/restart_mysqld.inc
set global debug="+d,get_double_write_info_fail";
show status like "Dstore_double_write_init_normal";
set global debug="-d,get_double_write_info_fail";
