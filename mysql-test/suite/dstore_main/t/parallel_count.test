--source include/have_only_dstore.inc
--source include/big_test.inc

--disable_warnings
DROP TABLE IF EXISTS t1, t2;
--enable_warnings

--echo #
--echo # Test 1: Parameter Value Tests
--echo #

--echo # 1.1 default value
SELECT @@session.dstore_parallel_read_threads;

--echo # 1.2 valid value
SET SESSION dstore_parallel_read_threads = 0;
SELECT @@session.dstore_parallel_read_threads;

SET SESSION dstore_parallel_read_threads = 1;
SELECT @@session.dstore_parallel_read_threads;

SET SESSION dstore_parallel_read_threads = 8;
SELECT @@session.dstore_parallel_read_threads;

SET SESSION dstore_parallel_read_threads = 16;
SELECT @@session.dstore_parallel_read_threads;

SET SESSION dstore_parallel_read_threads = 128;
SELECT @@session.dstore_parallel_read_threads;

--echo # 1.3 border value
SET SESSION dstore_parallel_read_threads = -1;
--echo # should truncate to 0
SELECT @@session.dstore_parallel_read_threads;

SET SESSION dstore_parallel_read_threads = 129;
--echo # should truncate to 128
SELECT @@session.dstore_parallel_read_threads;

--error ER_WRONG_TYPE_FOR_VAR
SET SESSION dstore_parallel_read_threads = 'abc';

--echo # 1.4 session & global variable test
SET GLOBAL dstore_parallel_read_threads = 8;
SELECT @@global.dstore_parallel_read_threads;

--connect (conn1, localhost, root,,)
SELECT @@session.dstore_parallel_read_threads;
--disconnect conn1
--connection default

SET GLOBAL dstore_parallel_read_threads = 4;

--echo #
--echo # Test 2: Basic Functionality Tests
--echo #

--echo # 2.1 test table
CREATE TABLE t1 (
  id INT,
  name VARCHAR(100),
  age INT NOT NULL
) ENGINE=DSTORE;

--echo # 2.2 load data - small dateset
INSERT INTO t1 VALUES (1, 'Alice', 25), (2, 'Bob', 30), (3, 'Charlie', 35);

--echo # 2.3 disable parallel reader
SET SESSION dstore_parallel_read_threads = 0;
SELECT COUNT(*) FROM t1;

--echo # 2.4 signal thread
SET SESSION dstore_parallel_read_threads = 1;
SELECT COUNT(*) FROM t1;

--echo # 2.5 multi-thread
SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t1;

--echo # 2.7 load data - big dataset
--disable_query_log
let $i = 20000;
while ($i)
{
  eval INSERT INTO t1 VALUES ($i + 1000, CONCAT('User', $i), 20 + ($i % 50));
  dec $i;
}
--enable_query_log

SET SESSION dstore_parallel_read_threads = 0;
SELECT COUNT(*) FROM t1;

SET SESSION dstore_parallel_read_threads = 8;
SELECT COUNT(*) FROM t1;

--echo # 2.8 empty table
CREATE TABLE t2 (id INT PRIMARY KEY, data VARCHAR(100)) ENGINE=DSTORE;

SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t2;

--echo #
--echo # Test 3: Lock Mode Tests
--echo #

--echo # 3.1 LOCK NONE（should use parallel）
SET SESSION dstore_parallel_read_threads = 4;
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
START TRANSACTION;
SELECT COUNT(*) FROM t1;
COMMIT;

--echo # 3.2 LOCK X（should use handler::records）
START TRANSACTION;
SELECT COUNT(*) FROM t1 FOR UPDATE;
COMMIT;

START TRANSACTION;
SELECT COUNT(*) FROM t1 LOCK IN SHARE MODE;
COMMIT;

--echo #
--echo # Test 4: Transaction Isolation Tests
--echo #

SET SESSION dstore_parallel_read_threads = 4;

--echo # 4.1 READ COMMITTED
--connect (conn2, localhost, root,,)
START TRANSACTION;
INSERT INTO t1 SELECT * FROM t1 LIMIT 10;

--connection default
SELECT COUNT(*) FROM t1;

--connection conn2
COMMIT;

--connection default
SELECT COUNT(*) FROM t1;

--echo #
--echo # Test 5: Concurrency Tests
--echo #

--echo # 5.1 multi session count(*)
SET SESSION dstore_parallel_read_threads = 4;

--connection conn2
SET SESSION dstore_parallel_read_threads = 4;
--send SELECT COUNT(*) FROM t1

--connect (conn3, localhost, root,,)
SET SESSION dstore_parallel_read_threads = 4;
--send SELECT COUNT(*) FROM t1

--connection conn2
--reap

--connection conn3
--reap

--connection default

--disconnect conn2
--disconnect conn3

--echo #
--echo # Test 6: Edge Case Tests
--echo #

--echo # 6.1 init data
SET SESSION dstore_parallel_read_threads = 16;
SELECT COUNT(*) FROM t1;

--echo # 6.2 recreate table case
DROP TABLE t1;
CREATE TABLE t1 (id INT, val INT NOT NULL) ENGINE=DSTORE;
INSERT INTO t1 VALUES (1, 100), (2, 200), (3, 300);

SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t1;

--echo #
--echo # Test 7: test with other releated features
--echo #

--echo # 7.1 test with condition
SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t1 WHERE val > 30;

--echo # 7.2 test with NOT NULL COLUMN optimization(age COLUMN is not null)
SELECT COUNT(val) FROM t1;

--echo # 7.3 test with LEFT JOIN elimination
SELECT COUNT(*) FROM t1 LEFT JOIN t2 ON t1.id = t2.id;

--echo #
--echo # Test 8: test with TEMPORARY table
--echo #
CREATE TEMPORARY TABLE t_t (id INT, val INT NOT NULL) ENGINE=DSTORE;
--disable_query_log
let $i = 10000;
while ($i)
{
  eval INSERT INTO t_t VALUES ($i + 10000, 25 + ($i % 60));
  dec $i;
}
--enable_query_log
SET SESSION dstore_parallel_read_threads = 4;
SELECT COUNT(*) FROM t_t;
DROP TABLE t_t;

--echo #
--echo # Test 9: Cleanup
--echo #

--echo # 9.1 drop all tables
DROP TABLE t1, t2;

--echo # 9.2 retore parameter value.
SET GLOBAL dstore_parallel_read_threads = 4;
SET SESSION dstore_parallel_read_threads = 4;

--echo #
--echo # Test completed successfully
--echo #
