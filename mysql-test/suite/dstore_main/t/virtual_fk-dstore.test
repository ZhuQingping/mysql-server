create table t1(c1 time(6) default null, c_varchar varchar(255) default null, c_char char(4) default null, key c_char(c_char), key c_varchar(c_varchar(237)), key c1(c1));
create table t2(c1 time(6) default null, c_varchar varchar(255) default null, c_char char(4) default null, key c_char(c_char), key c_varchar(c_varchar(237)), key c1(c1));
insert into t1 values('00:00:00.000000','ab','aabb'),('07:59:59.000000','ab','aacd'),('08:59:59.000000','bbbbbbbbbaa','aacd');
insert into t2 values('00:00:00.000000','ab','aabb'),('07:59:59.000000','ab','aacd'),('08:59:59.000000','bbbbbbbbbaa','aacd');
alter table t2 add foreign key (c_char) references t1(c_char) on delete cascade on update cascade;
create index i7 on t2((100));
update t1 set c_char='ffff';
select c_char from t2;
drop table t2,t1;
