--echo #
--echo # Bug#BUG2025102129104: [virtual column index]mysqld coredump while executing a delete query in a table that
--echo #                       contains a virtual column and several virtual column indexes

CREATE TABLE `t1` (
  `c_char` char(4) CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci DEFAULT NULL,
  `c2` bigint DEFAULT NULL,
  `c_varchar` varchar(200) CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci NOT NULL,
  `c_generate` varchar(200) CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci GENERATED ALWAYS AS (`c_varchar`) VIRTUAL,
  PRIMARY KEY (`c_varchar`),
  UNIQUE KEY `c2` (`c2`),
  UNIQUE KEY `vindex5` (`c_generate`),
  KEY `c2_2` (`c2`),
  KEY `c2_3` (`c2`,`c_varchar`,`c_char`),
  KEY `c_char` (`c_char`(2)),
  KEY `c_varchar` (`c_varchar`(5)),
  KEY `vindex1` (`c_generate`),
  KEY `vindex7` (`c_generate`,`c_char`)
) ENGINE=Dstore;

INSERT INTO `t1` (`c_char`, `c2`, `c_varchar`) VALUES ('',79,'bbbbbbbbbb'),('aabb',NULL,'bbba2'),(NULL,92,'ab');

CREATE TABLE `t2` (
  `c_char` char(4) CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci DEFAULT NULL,
  `c2` bigint NOT NULL,
  `c_varchar` varchar(200) CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci DEFAULT NULL,
  `c_generate` char(4) CHARACTER SET utf8mb3 COLLATE utf8mb3_unicode_ci GENERATED ALWAYS AS (`c_char`) VIRTUAL,
  PRIMARY KEY (`c2`),
  UNIQUE KEY `c2` (`c2`),
  UNIQUE KEY `vindex6` (`c_generate` DESC),
  KEY `c_varchar` (`c_varchar`),
  KEY `c_varchar_2` (`c_varchar`,`c2`,`c_char`),
  KEY `c_char` (`c_char`(2)),
  KEY `c_varchar_3` (`c_varchar`(5)),
  KEY `vindex2` (`c_generate` DESC),
  KEY `vindex8` (`c_varchar`,`c_generate` DESC),
  CONSTRAINT `t2_fk_1` FOREIGN KEY (`c_varchar`) REFERENCES `t1` (`c_varchar`) ON DELETE SET NULL
) ENGINE=Dstore;

INSERT INTO `t2` (`c_char`, `c2`, `c_varchar`) VALUES ('',79,'bbbbbbbbbb'),('aabb',0,'bbba2'),(NULL,92,'ab');

DELETE FROM t1 LIMIT 1;

DROP TABLE t1,t2;
