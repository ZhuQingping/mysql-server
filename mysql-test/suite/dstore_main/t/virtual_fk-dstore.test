CREATE TABLE IF NOT EXISTS t0(c0 INT  UNIQUE KEY COLUMN_FORMAT DEFAULT, c1 FLOAT  UNIQUE VISIBLE, c2 DOUBLE  UNIQUE KEY COMMENT 'asdf'  INVISIBLE, c3 BOOL  UNIQUE KEY VISIBLE, c4 DATE  STORAGE DISK PRIMARY KEY COLUMN_FORMAT FIXED  COMMENT 'asdf' , vc5 DATETIME  generated always as (COALESCE(CAST(c3 AS UNSIGNED), 0)) virtual VISIBLE, c6 TIME  UNIQUE STORAGE DISK VISIBLE, c7 YEAR   COMMENT 'asdf'  STORAGE DISK  COLUMN_FORMAT DEFAULT VISIBLE, vc8 TIMESTAMP  generated always as (COALESCE(CAST(c2 AS UNSIGNED), 0)) stored INVISIBLE, vc9 VARCHAR(500)  generated always as (COALESCE(CAST(c3 AS CHAR(30)), 'default')) stored VISIBLE);
CREATE TABLE IF NOT EXISTS t1(c0 INT  NULL COLUMN_FORMAT DEFAULT VISIBLE, c1 FLOAT  UNIQUE KEY STORAGE DISK COLUMN_FORMAT FIXED NULL  VISIBLE, c2 DOUBLE  UNIQUE KEY COLUMN_FORMAT DYNAMIC VISIBLE, c3 BOOL  COMMENT 'asdf'  VISIBLE, c4 DATE  COMMENT 'asdf' , c5 DATETIME  UNIQUE KEY VISIBLE, vc6 TIME  generated always as (COALESCE(c0, 0) * 2) stored VISIBLE, c7 YEAR  COMMENT 'asdf'  NULL  VISIBLE, c8 TIMESTAMP  COLUMN_FORMAT FIXED VISIBLE, vc9 VARCHAR(500)  generated always as (COALESCE(CAST(c0 AS CHAR(30)), 'default')) stored INVISIBLE, vc10 DECIMAL(10,2)  generated always as (COALESCE(c2, 0) - 1) virtual VISIBLE , foreign key(c4) references t0(c4) on delete cascade);
CREATE INDEX i0 ON t1(vc10) ALGORITHM COPY;
SET SESSION sql_auto_is_null = ON;
set sql_mode='ONLY_FULL_GROUP_BY';
CREATE INDEX i1 ON t0(c1);
