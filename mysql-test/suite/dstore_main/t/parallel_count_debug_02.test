--source include/have_only_dstore.inc
--source include/big_test.inc
--source include/have_debug.inc

CALL mtr.add_suppression("Out of resources when creating threads");
CALL mtr.add_suppression("heap scan failed during parallel heap scan");
CALL mtr.add_suppression("Parallel record counting failed");

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings
CREATE TABLE t1 (
  id INT,
  name VARCHAR(100),
  age INT NOT NULL
) ENGINE=DSTORE;
INSERT INTO t1 VALUES (1, 'Alice', 25), (2, 'Bob', 30), (3, 'Charlie', 35);
--disable_query_log
let $i = 10000;
while ($i)
{
  eval INSERT INTO t1 VALUES ($i + 10000, 'Zhang', 25 + ($i % 60));
  dec $i;
}
--enable_query_log

--let SEARCH_FILE= $MYSQLTEST_VARDIR/log/mysqld.1.err

--echo # Test 1: thread create failed.
--echo # Test 1.1: all threads create failed.
SET SESSION dstore_parallel_read_threads = 4;
SET SESSION debug = '+d,parallel_reader_create_thread_error_01';
SELECT COUNT(*) FROM t1;
SET SESSION debug = '-d,parallel_reader_create_thread_error_01';

--echo # Test 1.2: some threads create failed.
SET SESSION dstore_parallel_read_threads = 4;
SET SESSION debug = '+d,parallel_reader_create_thread_error_02';
SELECT COUNT(*) FROM t1;
SET SESSION debug = '-d,parallel_reader_create_thread_error_02';

--echo #
--echo # Test 2: Cleanup
--echo #

--echo # 2.1 drop all tables
DROP TABLE t1;

--echo # 2.2 retore parameter value.
SET GLOBAL dstore_parallel_read_threads = 4;
SET SESSION dstore_parallel_read_threads = 4;

--echo #
--echo # Test completed successfully
--echo #
