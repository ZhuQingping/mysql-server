SET @old_binlog_format=@@binlog_format;
SET GLOBAL binlog_format='MIXED';
SET SESSION binlog_format='MIXED';
SHOW  VARIABLES LIKE "binlog_format";
Variable_name	Value
binlog_format	MIXED
SET @a=UNIX_TIMESTAMP("2020-01-21 15:32:22");
SET timestamp=@a;
RESET MASTER;
DROP DATABASE IF EXISTS mtest;
CREATE DATABASE mtest;
USE mtest;
CREATE TABLE test1(p0 INT,p1 CHAR(10));
BEGIN;
INSERT INTO test1 VALUES(7,'aaa');
INSERT INTO test1 VALUES(8,'ddd');
COMMIT;
BEGIN;
INSERT INTO test1 VALUES(1,'aaa');
INSERT INTO test1 VALUES(2,'bbb');
SET timestamp=@a+2;
INSERT INTO test1 VALUES(3,'ccc');
INSERT INTO test1 VALUES(4,'ddd');
COMMIT;
SELECT * FROM test1;
p0	p1
1	aaa
2	bbb
3	ccc
4	ddd
7	aaa
8	ddd
FLUSH LOGS;
DROP DATABASE mtest;
USE mtest;
SELECT * FROM test1;
p0	p1
7	aaa
8	ddd
DROP DATABASE mtest;
