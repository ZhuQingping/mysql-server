SET @old_binlog_format=@@binlog_format;
SET GLOBAL binlog_format='MIXED';
SET SESSION binlog_format='MIXED';
SHOW  VARIABLES LIKE "binlog_format";
Variable_name	Value
binlog_format	MIXED
SET @a=UNIX_TIMESTAMP("2020-01-21 15:32:22");
SET timestamp=@a;
RESET MASTER;
DROP DATABASE IF EXISTS mtest;
CREATE DATABASE mtest;
set  timestamp=@a+4;
FLUSH LOGS;
set timestamp=@a+2;
USE mtest;
CREATE TABLE test1(p0 INT,p1 CHAR(10));
INSERT INTO test1 VALUES(1,'aaa');
INSERT INTO test1 VALUES(2,'bbb');
SET timestamp=@a+4;
CREATE TABLE test2(p0 INT,p1 CHAR(10));
INSERT INTO test2 VALUES(1,'aaa');
INSERT INTO test2 VALUES(2,'bbb');
SELECT * FROM test1;
p0	p1
1	aaa
2	bbb
SELECT * FROM test2;
p0	p1
1	aaa
2	bbb
FLUSH LOGS;
DROP TABLE test1;
DROP TABLE test2;
USE mtest;
SELECT * FROM test1;
p0	p1
1	aaa
2	bbb
SELECT * FROM test2;
ERROR 42S02: Table 'mtest.test2' doesn't exist
DROP DATABASE mtest;
