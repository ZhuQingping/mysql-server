#-------------------------------------------------------------
#
#    Conditions:
#          1. log-bin=mysql-bin(binlog function is turned on)
#          2. binlog format in row
#          3. gtid_mode=OFF
#          4. kill mysql
#    Actions:
#          execute  the command 'mysqlbinlog --merge mysqlbin.000001 mysqlbin.000002
#          to merge binlog files that have the same FD event.
#
#-------------------------------------------------------------
--disable_warnings

SET @old_binlog_format=@@binlog_format;
SET GLOBAL binlog_format='row';
SET SESSION binlog_format='row';

RESET MASTER;
let $tmp=query_get_value(SHOW VARIABLES LIKE 'datadir',Value,1);
let $binlog_name=query_get_value(SHOW MASTER STATUS,File,1);
--echo $binlog_name

DROP DATABASE IF EXISTS mergedb;
CREATE DATABASE mergedb;

#------------------------ Test execution --------------------------------------------

USE mergedb;
create table t1(id int);
DELIMITER $$;
CREATE PROCEDURE `mergetest`()
BEGIN
DECLARE i INT;
DECLARE tmp INT;
SET i = 0;
WHILE i<20 DO
SET @csql =CONCAT('insert into t1 values(',i,');');
SET i = i+1;
PREPARE create_stmt FROM @csql;
EXECUTE create_stmt;
END WHILE;
END$$
DELIMITER ;$$
call mergetest;

--echo "original size of the file"
--exec size0=`wc -c $tmp$binlog_name | cut -f 1 -d ' '`

--echo $binlog_name
--echo $binlog_name.merged
--exec $MYSQL_BINLOG --merge --force-if-open $tmp/$binlog_name -r /dev/null
--exec size1=`wc -c $tmp$binlog_name.merged | cut -f 1 -d ' '`
--exec rm -rf $tmp/$binlog_name.merged

flush logs;
call mergetest;
let $binlog_name1=query_get_value(SHOW MASTER STATUS,File,1);
--source include/kill_mysqld.inc

#--------binlog not closed properly and no stop_event or rotate_event --------

#---- only parameter merge ------#
--exec $MYSQL_BINLOG --merge --force-if-open $tmp/$binlog_name $tmp/$binlog_name1 -r /dev/null
--exec size2=`wc -c $tmp$binlog_name.merged | cut -f 1 -d ' '`
--exec rm -rf $tmp/$binlog_name.merged

#---- parameter merge and merged-file------#
--exec $MYSQL_BINLOG --merged-file=$tmp/out_merged.000001 --merge --force-if-open $tmp/$binlog_name $tmp/$binlog_name1 -r /dev/null
--exec size3=`wc -c $tmp/out_merged.000001 | cut -f 1 -d ' '`
--exec rm -rf $tmp/out_merged.000001

#---- parameter merge, merged-file and merge-dir ------#
--exec $MYSQL_BINLOG --merged-file=$tmp/out_merged.000002 --merge-dir=$tmp --merge --force-if-open $binlog_name $binlog_name1 -r /dev/null
--exec size4=`wc -c $tmp/out_merged.000002 | cut -f 1 -d ' '`

#---- check -----#
--exec $MYSQL_BINLOG $tmp/out_merged.000002 > $tmp/tmp1.sql
--exec rm -rf $tmp/out_merged.000002

--source include/start_mysqld.inc

use mergedb;
select count(*) from t1;
reset master;

DROP DATABASE IF EXISTS mergedb;
--exec $MYSQL -e "source $tmp/tmp1.sql;"

use mergedb;
select count(*) from t1;
--exec rm -rf $tmp/tmp1.sql

#------------------------ Clean up the environment-----------------------------
DROP DATABASE mergedb;
--enable_warnings
