#-------------------------------------------------------------
#
#    Conditions:
#          1.log-bin=mysql-bin(binlog function is turned on)
#          2.binlog format in mixed,then in statement,then in row
#    Actions:
#          execute  the command 'mysqlbinlog --stop-datetime="xxx" 
#          --truncate xxx/binlog_name' to create truncated binlog
#          file.then recover data using the truncated binlog file.then
#          recover data using the following binlog file.for example,
#          use mysql-bin.000001.tmp to recover firstly and then use 
#          mysql-bin.000002.tmp to recover.
#    Expection:
#           the data can be recovered  successfully.
#
#-------------------------------------------------------------

#--disable_query_log
--disable_warnings

let $i=3;
SET @old_binlog_format=@@binlog_format;

while ($i)
{
  if ($i == 3)
  { 
    SET GLOBAL binlog_format='MIXED';
    SET SESSION binlog_format='MIXED';
  }

  if ($i == 2)
  { 
    SET GLOBAL binlog_format='STATEMENT';
    SET SESSION binlog_format='STATEMENT';
  }

  if ($i == 1)
  { 
    SET GLOBAL binlog_format='ROW';
    SET SESSION binlog_format='ROW';
  }

  SHOW  VARIABLES LIKE "binlog_format";
  dec $i;

--source suite/mysqlbinlog/include/binlog_recover_after_tmp.inc

}

SET GLOBAL binlog_format = @old_binlog_format;
--enable_warnings
