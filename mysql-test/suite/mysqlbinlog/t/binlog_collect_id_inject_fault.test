#########################Test preparation#####################################
-- source include/have_log_bin.inc
#--disable_query_log
--disable_warnings
SET @old_server_id=@@server_id;
let $server_id_file=tmp_serverid_file;
--exec rm -rf $server_id_file

SET GLOBAL server_id=2;
RESET MASTER;
let $data_dir=query_get_value(SHOW VARIABLES LIKE 'datadir',Value,1);
DROP DATABASE IF EXISTS mtest;
CREATE DATABASE mtest;
#########################Test execution#######################################
SET GLOBAL server_id=100;
let $binlog_name=query_get_value(SHOW MASTER STATUS,File,1);
USE mtest;
CREATE TABLE test1(p0 INT,p1 CHAR(10));
INSERT INTO test1 VALUES(1,'aaa');
FLUSH LOGS;
## no server_id_file option
--error 1
--exec $MYSQL_BINLOG -vv --collect-server-id $data_dir$binlog_name -r /dev/null
# logname is '-'
--error 1
--exec $MYSQL_BINLOG -vv --collect-server-id --server-id-file=$server_id_file -r /dev/null -
--error 1
--exec $MYSQL_BINLOG -vv -#d,'collect_serverid_my_open_fail' --collect-server-id --server-id-file=$server_id_file $data_dir$binlog_name -r /dev/null
--error 1
--exec $MYSQL_BINLOG -vv -#d,'collect_serverid_open_file_fail' --collect-server-id --server-id-file=$server_id_file  $data_dir$binlog_name -r /dev/null

#########################Clean up the environment#############################
DROP DATABASE mtest;
--exec rm -rf $server_id_file
SET GLOBAL server_id=@old_server_id;
--enable_warnings

