#-------------------------------------------------------------
#
#    Conditions:
#          1.log-bin=mysql-bin(binlog function is turned on)
#          2.binlog format in mixed,then in statement,then in row
#    Actions:
#          execute the command 'mysqlbinlog -vv --stop-datetime="xxx"
#          --truncate xxx/binlog_name' point in the middle of a
#          transaction
#    Expection:
#           the command can be executed normally, this transaction is
#           fully retained and data can be restored successfully.
#
#-------------------------------------------------------------
-- source include/have_log_bin.inc
#--disable_query_log
--disable_warnings

let $i=3;
SET @old_binlog_format=@@binlog_format;

while ($i)
{
  if ($i == 3)
  {
    SET GLOBAL binlog_format='MIXED';
    SET SESSION binlog_format='MIXED';
  }

  if ($i == 2)
  {
    SET GLOBAL binlog_format='STATEMENT';
    SET SESSION binlog_format='STATEMENT';
  }

  if ($i == 1)
  {
    SET GLOBAL binlog_format='ROW';
    SET SESSION binlog_format='ROW';
  }

  SHOW  VARIABLES LIKE "binlog_format";
  dec $i;

--source suite/mysqlbinlog/include/binlog_truncate_xid_event_inject_fault.inc

}

SET GLOBAL binlog_format = @old_binlog_format;
--enable_warnings
