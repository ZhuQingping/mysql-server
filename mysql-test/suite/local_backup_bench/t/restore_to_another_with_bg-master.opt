--innodb_change_buffering=none
--rds_full_local_backup_path=$MYSQLTEST_VARDIR/full_local_backup
--rds_log_archive_path=$MYSQLTEST_VARDIR/wal_archive
--dstore_local_backup_meta_path=$MYSQLTEST_VARDIR/local_backup_meta
--dstore_restore_meta_path=$MYSQLTEST_VARDIR/local_backup_restore_meta
--default_authentication_plugin=mysql_native_password
--default-time-zone=SYSTEM
--dstore_check_point_timeout=1
--dstore_wal_archive_interval=1
