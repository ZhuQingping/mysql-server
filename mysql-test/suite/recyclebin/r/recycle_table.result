# Connect to master
SET @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
SET global rds_extended_partitions_enabled = true;
set global rds_recycle_bin_mode=ON;
create database db_recycle;
create database db_recycle_dropped;
create user normal_1@'%' identified by 'pass';
create user normal_2@'%' identified by 'pass';
create user normal_3@'%' identified by 'pass';
grant all on db_recycle.* to normal_1@'%' ;
grant all on db_recycle_dropped.* to normal_1@'%';
grant all on __recyclebin__.* to normal_1@'%' ;
grant create tablespace on *.* to normal_1@'%' ;
grant SYSTEM_VARIABLES_ADMIN on *.* to normal_1@'%';
grant all on __recyclebin__.* to normal_3@'%' ;
revoke drop on __recyclebin__.* from normal_3@'%';
------------------------------------------------------
1. Privileges
-- Still require related privileges if want to
show recycle bin db;
-- No one can alter db except super_acl user;
------------------------------------------------------
1.1 dbms_recyclebin.purge_table still require db.table privileges;
use db_recycle;
create table t1(id int);
drop table t1;
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
__recyclebin__	#	db_recycle	t1	#	#
call dbms_recyclebin.purge_table('t1');
ERROR 42000: DROP command denied to user 'normal_2'@'localhost' for table 't1'
call dbms_recyclebin.purge_table('t1');
ERROR 42000: DROP command denied to user 'normal_3'@'localhost' for table 't1'
show grants;
Grants for normal_1@%
GRANT CREATE TABLESPACE ON *.* TO `normal_1`@`%`
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO `normal_1`@`%`
GRANT ALL PRIVILEGES ON `__recyclebin__`.* TO `normal_1`@`%`
GRANT ALL PRIVILEGES ON `db_recycle`.* TO `normal_1`@`%`
GRANT ALL PRIVILEGES ON `db_recycle_dropped`.* TO `normal_1`@`%`
call dbms_recyclebin.purge_table('t1');
------------------------------------------------------
1. Drop table
-- Related object:
Foreign key:
Trigger:
View:
Constraint:
-- Partition table
-- multi tables
------------------------------------------------------
use db_recycle;
CREATE TABLE p1 (
id INT NOT NULL,
PRIMARY KEY (id)
) ENGINE=INNODB;
CREATE TABLE c1 (
id INT,
parent_id INT,
INDEX par_ind (parent_id),
FOREIGN KEY (parent_id)
REFERENCES p1(id)
ON DELETE CASCADE
) ENGINE=INNODB;
create table l1(id int);
CREATE TRIGGER tri_1
before INSERT ON c1 FOR EACH ROW
BEGIN
INSERT INTO l1 value(1);
END//
create view v1 as select * from c1;
1.1 confirm the trigger, view, foreign key.
drop table c1;
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
__recyclebin__	#	db_recycle	c1	#	#
show create table __recyclebin__.`c1`;
Table	Create Table
c1	CREATE TABLE `c1` (
  `id` int DEFAULT NULL,
  `parent_id` int DEFAULT NULL,
  KEY `par_ind` (`parent_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
show create trigger tri_1;
ERROR HY000: Trigger does not exist
show create view v1;
View	Create View	character_set_client	collation_connection
v1	CREATE ALGORITHM=UNDEFINED DEFINER=`normal_1`@`%` SQL SECURITY DEFINER VIEW `v1` AS select `c1`.`id` AS `id`,`c1`.`parent_id` AS `parent_id` from `c1`	utf8mb4	utf8mb4_0900_ai_ci
Warnings:
Warning	1356	View 'db_recycle.v1' references invalid table(s) or column(s) or function(s) or definer/invoker of view lack rights to use them
select * from v1;
ERROR HY000: View 'db_recycle.v1' references invalid table(s) or column(s) or function(s) or definer/invoker of view lack rights to use them
call dbms_recyclebin.purge_table('c1');
# Connect to master
use db_recycle;
CREATE TABLE t1 (
id INT NOT NULL,
PRIMARY KEY (id)
) ENGINE=INNODB;
CREATE TABLE t2 (
id INT NOT NULL,
PRIMARY KEY (id)
) ENGINE=INNODB;
drop table t1,t2;
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
__recyclebin__	#	db_recycle	t1	#	#
__recyclebin__	#	db_recycle	t2	#	#
call dbms_recyclebin.purge_table('t1');
call dbms_recyclebin.purge_table('t2');
CREATE TABLE t1 (
id INT NOT NULL,
PRIMARY KEY (id)
) ENGINE=INNODB;
CREATE TEMPORARY TABLE t2 (
id INT NOT NULL);
drop table t1,t2;
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
__recyclebin__	#	db_recycle	t1	#	#
call dbms_recyclebin.purge_table('t1');
CREATE TABLE part_t1
(
dept_no     int,
part_no     int,
country     varchar(20),
date        date,
amount      int
)
PARTITION BY HASH(to_days(date))
SUBPARTITION BY LIST(amount)
(
PARTITION dp0 (
SUBPARTITION p0 values in (1, 2),
SUBPARTITION p1 values in (3, 4),
SUBPARTITION p2 values in (5, 6)
),
PARTITION dp1
(
SUBPARTITION p3 values in (1, 2),
SUBPARTITION p4 values in (3, 4),
SUBPARTITION p5 values in (5, 6)
)
);
CREATE TABLE part_t2 (
sale_date DATE,
product_id INT,
quantity INT,
price DECIMAL(10, 2)
)
PARTITION BY RANGE (TO_DAYS(sale_date))
SUBPARTITION BY HASH (product_id)
SUBPARTITIONS 4
(
PARTITION p0 VALUES LESS THAN (TO_DAYS('2023-01-01')),
PARTITION p1 VALUES LESS THAN (TO_DAYS('2023-07-01')),
PARTITION p2 VALUES LESS THAN (TO_DAYS('2024-01-01')),
PARTITION p3 VALUES LESS THAN MAXVALUE
);
CREATE TABLE part_t3 (
sale_date DATE NOT NULL,
product_id INT,
quantity INT,
price DECIMAL(10, 2)
)
PARTITION BY RANGE (TO_DAYS(sale_date))
(
PARTITION p0 VALUES LESS THAN (TO_DAYS('2023-01-01')),
PARTITION p1 VALUES LESS THAN (TO_DAYS('2023-07-01')),
PARTITION p2 VALUES LESS THAN (TO_DAYS('2024-01-01')),
PARTITION p3 VALUES LESS THAN MAXVALUE
);
CREATE TABLE t4(id INT);
drop table part_t1,part_t2,part_t3,t4;
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
__recyclebin__	#	db_recycle	part_t1	#	#
__recyclebin__	#	db_recycle	part_t2	#	#
__recyclebin__	#	db_recycle	part_t3	#	#
__recyclebin__	#	db_recycle	t4	#	#
call dbms_recyclebin.purge_table('part_t2');
call dbms_recyclebin.purge_table('part_t2');
call dbms_recyclebin.purge_table('part_t3');
call dbms_recyclebin.purge_table('t4');
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
# Connect to master
set rds_recycle_bin_mode=OFF;
use db_recycle;
drop table l1;
drop view v1;
drop table p1;
------------------------------------------------------
1. Drop parent table
------------------------------------------------------
use db_recycle;
CREATE TABLE p1 (
id INT NOT NULL,
PRIMARY KEY (id)
) ENGINE=INNODB;
CREATE TABLE c1 (
id INT,
parent_id INT,
INDEX par_ind (parent_id),
FOREIGN KEY (parent_id)
REFERENCES p1(id)
ON DELETE CASCADE
) ENGINE=INNODB;
1.1  foreign key.
drop table p1;
ERROR HY000: Cannot drop table 'p1' referenced by a foreign key constraint 'c1_ibfk_1' on table 'c1'.
set foreign_key_checks=off;
drop table p1;
insert into c1 values(1, 2);
commit;
show create table c1;
Table	Create Table
c1	CREATE TABLE `c1` (
  `id` int DEFAULT NULL,
  `parent_id` int DEFAULT NULL,
  KEY `par_ind` (`parent_id`),
  CONSTRAINT `c1_ibfk_1` FOREIGN KEY (`parent_id`) REFERENCES `p1` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
set foreign_key_checks=on;
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
# Connect to master
set rds_recycle_bin_mode=OFF;
drop table db_recycle.c1;
------------------------------------------------------
1. Drop in procedure
------------------------------------------------------
use db_recycle;
CREATE TABLE p1 (
id INT NOT NULL,
PRIMARY KEY (id)
) ENGINE=INNODB;
create procedure proc_1()
begin
drop table p1;
end//
call proc_1();
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
drop procedure proc_1;
------------------------------------------------------
2. Drop database
------------------------------------------------------
use db_recycle_dropped;
CREATE TABLE p2 (
id INT NOT NULL,
PRIMARY KEY (id)
) ENGINE=INNODB;
CREATE TABLE c2 (
id INT,
parent_id INT,
self_id INT,
INDEX id_ind (id),
INDEX par_ind (parent_id),
INDEX sel_ind (self_id),
FOREIGN KEY (self_id)
REFERENCES c2(id),
FOREIGN KEY (parent_id)
REFERENCES p2(id)
ON DELETE CASCADE
) ENGINE=INNODB;
create table l2(id int);
CREATE TRIGGER tri_1
before INSERT ON c2 FOR EACH ROW
BEGIN
INSERT INTO l2 value(1);
END//
create view v2 as select * from c2;
drop database db_recycle_dropped;
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
__recyclebin__	#	db_recycle_dropped	c2	#	#
__recyclebin__	#	db_recycle_dropped	l2	#	#
__recyclebin__	#	db_recycle_dropped	p2	#	#
create database db_recycle_dropped;
SET SESSION debug="+d,recyclebin_restore_table_old_db_null";
call dbms_recyclebin.restore_db('db_recycle_dropped');
ERROR HY000: Incorrect parameters (pos is 1) to native procedure 'dbms_recyclebin.restore_db.
SET SESSION debug="-d,recyclebin_restore_table_old_db_null";
call dbms_recyclebin.restore_db('db_recycle_dropped', '__recyclebin__');
ERROR HY000: Recycle table failed : unable to restore table to __recyclebin__.
SET SESSION debug="+d,recyclebin_copy_with_cs_fail_05";
call dbms_recyclebin.restore_db('db_recycle_dropped', 'db_recycle_dropped');
ERROR HY000: Incorrect parameters (pos is 2) to native procedure 'dbms_recyclebin.restore_db.
SET SESSION debug="-d,recyclebin_copy_with_cs_fail_05";
call dbms_recyclebin.restore_db('db_recycle_dropped');
call dbms_recyclebin.restore_db('db_recycle_dropped_note_exist');
ERROR HY000: No table whose origin db is db_recycle_dropped_note_exist exists in recycle bin.
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
set rds_recycle_bin_mode=OFF;
drop database db_recycle_dropped;
set rds_recycle_bin_mode=ON;
------------------------------------------------------
3. read only
------------------------------------------------------
use db_recycle;
create table t2 (id int);
drop table t2;
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
__recyclebin__	#	db_recycle	t2	#	#
set global read_only = on;
call dbms_recyclebin.purge_table('t2');
ERROR HY000: The MySQL server is running with the --read-only option so it cannot execute this statement
set global read_only = off;
call dbms_recyclebin.purge_table('t2');
------------------------------------------------------
4. partition table or general tablespace
------------------------------------------------------
use db_recycle;
CREATE TABLE t3 (
firstname VARCHAR(25) NOT NULL,
lastname VARCHAR(25) NOT NULL,
username VARCHAR(16) NOT NULL,
email VARCHAR(35),
joined DATE NOT NULL
)
PARTITION BY RANGE( YEAR(joined) ) (
PARTITION p0 VALUES LESS THAN (1960),
PARTITION p1 VALUES LESS THAN (1970),
PARTITION p2 VALUES LESS THAN (1980),
PARTITION p3 VALUES LESS THAN (1990),
PARTITION p4 VALUES LESS THAN MAXVALUE
);
drop table t3;
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
__recyclebin__	#	db_recycle	t3	#	#
show create table __recyclebin__.`t3`;
Table	Create Table
t3	CREATE TABLE `t3` (
  `firstname` varchar(25) NOT NULL,
  `lastname` varchar(25) NOT NULL,
  `username` varchar(16) NOT NULL,
  `email` varchar(35) DEFAULT NULL,
  `joined` date NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY RANGE (year(`joined`))
(PARTITION p0 VALUES LESS THAN (1960) ENGINE = InnoDB,
 PARTITION p1 VALUES LESS THAN (1970) ENGINE = InnoDB,
 PARTITION p2 VALUES LESS THAN (1980) ENGINE = InnoDB,
 PARTITION p3 VALUES LESS THAN (1990) ENGINE = InnoDB,
 PARTITION p4 VALUES LESS THAN MAXVALUE ENGINE = InnoDB) */
call dbms_recyclebin.purge_table('t3');
CREATE TABLESPACE `ts1` ADD DATAFILE 'ts1.ibd' Engine=InnoDB;
create table t4(id int) tablespace ts1;
drop table t4;
call dbms_recyclebin.show_tables();
SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
drop tablespace ts1;
