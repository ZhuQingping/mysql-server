--source include/have_only_dstore.inc
#
# Test for recycle func of recyclebin
#

--echo # Connect to master
connection default;
create database db_recycle;

set global rds_recycle_bin_mode=ON;
set rds_recycle_bin_mode=ON;

use db_recycle;
CREATE TABLE t1 (c1 INT PRIMARY KEY, c2 INT, INDEX(c2)) ENGINE = Dstore;

CREATE TABLE t2 (
 c2 INT PRIMARY KEY,
 CONSTRAINT t2c2 FOREIGN KEY (c2) REFERENCES t1 (c2))
ENGINE = Dstore;

DROP TABLE t2;

--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
let $t2_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);

--replace_result $t2_name_in_recyclebin t2
eval SHOW CREATE TABLE __recyclebin__.`$t2_name_in_recyclebin`;

--replace_result $t2_name_in_recyclebin t2
eval call dbms_recyclebin.restore_table('$t2_name_in_recyclebin');

ALTER TABLE t2 ADD CONSTRAINT t2c2 FOREIGN KEY (c2) REFERENCES t1 (c2);

SHOW CREATE TABLE t2;

DROP TABLE t2;

--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
let $t2_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);

--replace_result $t2_name_in_recyclebin t2
eval SHOW CREATE TABLE __recyclebin__.`$t2_name_in_recyclebin`;

--replace_result $t2_name_in_recyclebin t2
eval call dbms_recyclebin.purge_table('$t2_name_in_recyclebin');

create table t3(id int);
CREATE TRIGGER before_t3_insert BEFORE INSERT ON t3 FOR EACH ROW INSERT INTO t1 (c1, c2) VALUES (1, 1); 

drop table t3;
--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
let $t3_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);

SELECT count(*) FROM information_schema.TRIGGERS WHERE TRIGGER_NAME = 'before_t3_insert';

--replace_result $t3_name_in_recyclebin t3
eval call dbms_recyclebin.restore_table('$t3_name_in_recyclebin');

CREATE TRIGGER before_t3_insert BEFORE INSERT ON t3 FOR EACH ROW INSERT INTO t1 (c1, c2) VALUES (1, 1);

DROP DATABASE db_recycle;

SELECT count(*) FROM information_schema.TRIGGERS WHERE TRIGGER_NAME = 'before_t3_insert';

SET rds_recycle_bin_mode=OFF;
SET GLOBAL rds_recycle_bin_mode=OFF;
DROP DATABASE __recyclebin__;
CREATE DATABASE IF NOT EXISTS __recyclebin__ DEFAULT CHARACTER SET utf8mb4;
