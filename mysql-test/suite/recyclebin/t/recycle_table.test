--source include/not_have_only_dstore.inc
source include/have_debug.inc;
#
# Test for recycle func of recyclebin
#

--echo # Connect to master
connection default;
SET @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
SET global rds_extended_partitions_enabled = true;
set global rds_recycle_bin_mode=ON;
create database db_recycle;
create database db_recycle_dropped;

create user normal_1@'%' identified by 'pass';
create user normal_2@'%' identified by 'pass';
create user normal_3@'%' identified by 'pass';

grant all on db_recycle.* to normal_1@'%' ;
grant all on db_recycle_dropped.* to normal_1@'%';
grant all on __recyclebin__.* to normal_1@'%' ;
grant create tablespace on *.* to normal_1@'%' ;
grant SYSTEM_VARIABLES_ADMIN on *.* to normal_1@'%';

grant all on __recyclebin__.* to normal_3@'%' ;
revoke drop on __recyclebin__.* from normal_3@'%';

connect(m_normal_1, 127.0.0.1, normal_1, pass, db_recycle, $SERVER_MYPORT_1);
connect(m_normal_2, 127.0.0.1, normal_2, pass, test, $SERVER_MYPORT_1);
connect(m_normal_3, 127.0.0.1, normal_3, pass, , $SERVER_MYPORT_1);

--echo ------------------------------------------------------
--echo 1. Privileges
--echo    -- Still require related privileges if want to
--echo       show recycle bin db;
--echo    -- No one can alter db except super_acl user;
--echo ------------------------------------------------------

--echo 1.1 dbms_recyclebin.purge_table still require db.table privileges;

connection m_normal_1;
use db_recycle;
create table t1(id int);
drop table t1;

--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
let $t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);

connection m_normal_2;
--replace_result $t1_name_in_recyclebin t1
--error ER_TABLEACCESS_DENIED_ERROR
eval call dbms_recyclebin.purge_table('$t1_name_in_recyclebin');

connection m_normal_3;
--replace_result $t1_name_in_recyclebin t1
--error ER_TABLEACCESS_DENIED_ERROR
eval call dbms_recyclebin.purge_table('$t1_name_in_recyclebin');

connection m_normal_1;
show grants;
--replace_result $t1_name_in_recyclebin t1
eval call dbms_recyclebin.purge_table('$t1_name_in_recyclebin');

--echo ------------------------------------------------------
--echo 1. Drop table
--echo    -- Related object:
--echo       Foreign key:
--echo       Trigger:
--echo       View:
--echo       Constraint:
--echo    -- Partition table
--echo    -- multi tables
--echo ------------------------------------------------------

connection m_normal_1;
use db_recycle;

CREATE TABLE p1 (
    id INT NOT NULL,
    PRIMARY KEY (id)
) ENGINE=INNODB;

CREATE TABLE c1 (
    id INT,
    parent_id INT,
    INDEX par_ind (parent_id),
    FOREIGN KEY (parent_id)
        REFERENCES p1(id)
        ON DELETE CASCADE
) ENGINE=INNODB;

create table l1(id int);

delimiter //;
CREATE TRIGGER tri_1
  before INSERT ON c1 FOR EACH ROW
BEGIN
  INSERT INTO l1 value(1);
END//
delimiter  ;//

create view v1 as select * from c1;

--echo 1.1 confirm the trigger, view, foreign key.
drop table c1;

--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
let $c1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);

connection default;
--replace_result $c1_name_in_recyclebin c1
eval show create table __recyclebin__.`$c1_name_in_recyclebin`;

connection m_normal_1;
--error ER_TRG_DOES_NOT_EXIST
show create trigger tri_1;

show create view v1;

--error ER_VIEW_INVALID
select * from v1;

--replace_result $c1_name_in_recyclebin c1
eval call dbms_recyclebin.purge_table('$c1_name_in_recyclebin');

# 2.1 Tables which all support
--echo # Connect to master
connection m_normal_1;
use db_recycle;
CREATE TABLE t1 (
    id INT NOT NULL,
    PRIMARY KEY (id)
) ENGINE=INNODB;

CREATE TABLE t2 (
    id INT NOT NULL,
    PRIMARY KEY (id)
) ENGINE=INNODB;

drop table t1,t2;
--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
let $t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);
let $t2_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 2);
--replace_result $t1_name_in_recyclebin t1
eval call dbms_recyclebin.purge_table('$t1_name_in_recyclebin');
--replace_result $t2_name_in_recyclebin t2
eval call dbms_recyclebin.purge_table('$t2_name_in_recyclebin');

# 2.2 Tables which not all support
CREATE TABLE t1 (
    id INT NOT NULL,
    PRIMARY KEY (id)
) ENGINE=INNODB;

CREATE TEMPORARY TABLE t2 (
    id INT NOT NULL);

drop table t1,t2;
--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
let $t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);
--replace_result $t1_name_in_recyclebin t1
eval call dbms_recyclebin.purge_table('$t1_name_in_recyclebin');

# 3 Partition Table
CREATE TABLE part_t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
PARTITION BY HASH(to_days(date))
SUBPARTITION BY LIST(amount)
(
  PARTITION dp0 (
    SUBPARTITION p0 values in (1, 2),
    SUBPARTITION p1 values in (3, 4),
    SUBPARTITION p2 values in (5, 6)
),
PARTITION dp1
(
  SUBPARTITION p3 values in (1, 2),
  SUBPARTITION p4 values in (3, 4),
  SUBPARTITION p5 values in (5, 6)
)
);

CREATE TABLE part_t2 (
    sale_date DATE,
    product_id INT,
    quantity INT,
    price DECIMAL(10, 2)
)
PARTITION BY RANGE (TO_DAYS(sale_date))
SUBPARTITION BY HASH (product_id)
SUBPARTITIONS 4
(
    PARTITION p0 VALUES LESS THAN (TO_DAYS('2023-01-01')),
    PARTITION p1 VALUES LESS THAN (TO_DAYS('2023-07-01')),
    PARTITION p2 VALUES LESS THAN (TO_DAYS('2024-01-01')),
    PARTITION p3 VALUES LESS THAN MAXVALUE
);

CREATE TABLE part_t3 (
    sale_date DATE NOT NULL,
    product_id INT,
    quantity INT,
    price DECIMAL(10, 2)
)
PARTITION BY RANGE (TO_DAYS(sale_date))
(
    PARTITION p0 VALUES LESS THAN (TO_DAYS('2023-01-01')),
    PARTITION p1 VALUES LESS THAN (TO_DAYS('2023-07-01')),
    PARTITION p2 VALUES LESS THAN (TO_DAYS('2024-01-01')),
    PARTITION p3 VALUES LESS THAN MAXVALUE
);

CREATE TABLE t4(id INT);

drop table part_t1,part_t2,part_t3,t4;
--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
let $t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);
let $t2_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 2);
let $t3_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 3);
let $t4_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 4);

--replace_result $t1_name_in_recyclebin part_t2
eval call dbms_recyclebin.purge_table('$t1_name_in_recyclebin');
--replace_result $t2_name_in_recyclebin part_t2
eval call dbms_recyclebin.purge_table('$t2_name_in_recyclebin');
--replace_result $t3_name_in_recyclebin part_t3
eval call dbms_recyclebin.purge_table('$t3_name_in_recyclebin');
--replace_result $t4_name_in_recyclebin t4
eval call dbms_recyclebin.purge_table('$t4_name_in_recyclebin');

call dbms_recyclebin.show_tables();

--echo # Connect to master
connection default;
set rds_recycle_bin_mode=OFF;
use db_recycle;
drop table l1;
drop view v1;
drop table p1;

--echo ------------------------------------------------------
--echo 1. Drop parent table
--echo ------------------------------------------------------

connection m_normal_1;
use db_recycle;

CREATE TABLE p1 (
    id INT NOT NULL,
    PRIMARY KEY (id)
) ENGINE=INNODB;

CREATE TABLE c1 (
    id INT,
    parent_id INT,
    INDEX par_ind (parent_id),
    FOREIGN KEY (parent_id)
        REFERENCES p1(id)
        ON DELETE CASCADE
) ENGINE=INNODB;

--echo 1.1  foreign key.
--error ER_FK_CANNOT_DROP_PARENT
drop table p1;

set foreign_key_checks=off;
drop table p1;
insert into c1 values(1, 2);
commit;
show create table c1;
set foreign_key_checks=on;

call dbms_recyclebin.show_tables();

--echo # Connect to master
connection default;
set rds_recycle_bin_mode=OFF;
drop table db_recycle.c1;

--echo ------------------------------------------------------
--echo 1. Drop in procedure
--echo ------------------------------------------------------

connection m_normal_1;
use db_recycle;

CREATE TABLE p1 (
    id INT NOT NULL,
    PRIMARY KEY (id)
) ENGINE=INNODB;

delimiter //;
create procedure proc_1()
begin
  drop table p1;
end//
delimiter ;//

call proc_1();

--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();

drop procedure proc_1;

--echo ------------------------------------------------------
--echo 2. Drop database
--echo ------------------------------------------------------

connection m_normal_1;
use db_recycle_dropped;

CREATE TABLE p2 (
    id INT NOT NULL,
    PRIMARY KEY (id)
) ENGINE=INNODB;

CREATE TABLE c2 (
    id INT,
    parent_id INT,
    self_id INT,
    INDEX id_ind (id),
    INDEX par_ind (parent_id),
    INDEX sel_ind (self_id),
    FOREIGN KEY (self_id)
        REFERENCES c2(id),
    FOREIGN KEY (parent_id)
        REFERENCES p2(id)
        ON DELETE CASCADE
) ENGINE=INNODB;

create table l2(id int);

delimiter //;
CREATE TRIGGER tri_1
  before INSERT ON c2 FOR EACH ROW
BEGIN
  INSERT INTO l2 value(1);
END//
delimiter  ;//

create view v2 as select * from c2;

drop database db_recycle_dropped;

--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();

create database db_recycle_dropped;
SET SESSION debug="+d,recyclebin_restore_table_old_db_null";
--error ER_NATIVE_PROC_PARAMETER_MISMATCH
eval call dbms_recyclebin.restore_db('db_recycle_dropped');
SET SESSION debug="-d,recyclebin_restore_table_old_db_null";
--error ER_PREPARE_RECYCLE_TABLE_ERROR
eval call dbms_recyclebin.restore_db('db_recycle_dropped', '__recyclebin__');
SET SESSION debug="+d,recyclebin_copy_with_cs_fail_05";
--error ER_NATIVE_PROC_PARAMETER_MISMATCH
eval call dbms_recyclebin.restore_db('db_recycle_dropped', 'db_recycle_dropped');
SET SESSION debug="-d,recyclebin_copy_with_cs_fail_05";

call dbms_recyclebin.restore_db('db_recycle_dropped');
--error ER_RECYBIN_NO_MATCH
call dbms_recyclebin.restore_db('db_recycle_dropped_note_exist');

--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();

set rds_recycle_bin_mode=OFF;
drop database db_recycle_dropped;

set rds_recycle_bin_mode=ON;

