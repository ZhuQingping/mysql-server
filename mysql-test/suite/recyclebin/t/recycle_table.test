call dbms_recyclebin.restore_table("abc@123");
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.restore_table("@1@123");
--error ER_PREPARE_RECYCLE_TABLE_ERROR
