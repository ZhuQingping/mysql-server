--echo ------------------------------------------------------
--echo 6. purge normal table or noexist table
--echo ------------------------------------------------------

connection default;
set rds_recycle_bin_mode=ON;
create table __recyclebin__.no_recycle_table(id int);
create table __recyclebin__.__innodb_olddb_oldtable_1234(id int);
create table __recyclebin__.__innodb_olddb_oldtable_1234_(id int);
create table __recyclebin__.abc(id int);
create table __recyclebin__.`@@`(id int);
create table __recyclebin__.`@`(id int);
create table __recyclebin__.`@123`(id int);
create table __recyclebin__.`abc@123`(id int);
create table __recyclebin__.`@1@123`(id int);
create table __recyclebin__.`1@@123`(id int);
create table __recyclebin__.`1@2@`(id int);
create table __recyclebin__.`1@2@ok`(id int);
create table __recyclebin__.`1@2@123`(id int);
create table __recyclebin__.`db_recycle@2@123`(id int);
create table __recyclebin__.`db@recycle@2@123`(id int);
create table __recyclebin__.`db_recycle@4@FFFFFFFF`(id int);
create table db_recycle.`db_recycle@3@123`(id int);
create table db_recycle.`4`(id int);
rename table db_recycle.`db_recycle@3@123` to __recyclebin__.`@3@123`;
rename table db_recycle.`4` to __recyclebin__.`db_recycle@4@123`;

use __recyclebin__;
show tables;
