--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.restore_table("@@");
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.restore_table("@");
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.restore_table("@123");
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.restore_table("__innodb_olddb_oldtable_1234_");
