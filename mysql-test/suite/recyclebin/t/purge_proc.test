--source include/not_have_only_dstore.inc
--source ../include/basic_prepare.inc

--disable_query_log
call mtr.add_suppression("\\[Warning\\] .* Fail to recycle table");

--echo # use conn1 represent my_root, conn2 represent test1, conn3 represent test2 throughout recycbin suite
--echo # drop and purge table in the test file, prepare.inc and cleanup.inc only deal with db and user;

--echo #
--echo # prepare the conn
--echo #
connect(conn1, 127.0.0.1, my_root, 123456);
connect(conn2, 127.0.0.1, test1, 123456);
connect(conn3, 127.0.0.1, test2, 123456);

--echo #
--echo # Case 1: check the invalid input parameter for dbms_recyclebin.purge_table()
--echo #

connection conn1;
--error ER_SP_WRONG_NO_OF_ARGS
call dbms_recyclebin.purge_table();
--error ER_NATIVE_PROC_PARAMETER_MISMATCH
call dbms_recyclebin.purge_table("");
--error ER_BAD_FIELD_ERROR
call dbms_recyclebin.purge_table(fdbfbr);
--error ER_NATIVE_PROC_PARAMETER_MISMATCH
call dbms_recyclebin.purge_table(134);

--echo #
--echo # Case 2: users can't purge tables which they don't have access to
--echo #

drop table sbtest2.t2;
--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
let $t2_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);

--echo # let user test1 purge sbtest2.t2, expected fail
connection conn2;
--replace_result $t2_name_in_recyclebin t2
eval call dbms_recyclebin.purge_table('$t2_name_in_recyclebin');

create table `t1@@t1`(id int);
drop table `t1@@t1`;
--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();

connection conn1;
create database abcd012345678901234567890123456789012345678901234567890123456789;
use abcd012345678901234567890123456789012345678901234567890123456789;
create table 012345678901234567890123456789012345678901234567890123456789abcd(id int);
drop table 012345678901234567890123456789012345678901234567890123456789abcd;
--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
drop database abcd012345678901234567890123456789012345678901234567890123456789;

--echo #
--echo # Case 3: rds_recycle_bin_mode is off
--echo #

set rds_recycle_bin_mode = OFF;
--error ER_RECYCLEBIN_SWITCH_OFF
call dbms_recyclebin.show_tables();
--error ER_RECYCLEBIN_SWITCH_OFF
call dbms_recyclebin.restore_table('t1');
--error ER_RECYCLEBIN_SWITCH_OFF
call dbms_recyclebin.purge_table('t1');
--error ER_RECYCLEBIN_SWITCH_OFF
call dbms_recyclebin.restore_db('db1');
set rds_recycle_bin_mode = ON;

--echo #
--echo # Case 4: lock mode
--echo #

use sbtest1;
create table tt(id int);
lock tables tt write;
drop table tt;
--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();

lock tables sbtest1.t1 write;
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.restore_table('t1');
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.purge_table('t1');
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.restore_db('db1');
unlock tables;

#
# Case 4: __recyclebin__ not exist
#
connection default;
set rds_recycle_bin_mode = ON;
drop database __recyclebin__;
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.restore_table('t1','db1','t2');
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.purge_table('t1');
--error ER_PREPARE_RECYCLE_TABLE_ERROR
call dbms_recyclebin.restore_db('db1','db2');

create database __recyclebin__;

disconnect conn1;
disconnect conn2;

--source ../include/basic_cleanup.inc
