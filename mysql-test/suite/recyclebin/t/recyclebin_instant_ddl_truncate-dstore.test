--source include/have_only_dstore.inc
--source include/have_debug.inc
#
# Test for recycle func of truncate after instant ddl
#

--echo #
--echo # instant add columns and truncate
--echo #

connect (root, 127.0.0.1, root,,);

# connect root
connection root;
set global rds_recycle_bin_mode=on;
set rds_recycle_bin_mode=on;

create database db1;
use db1;
CREATE TABLE tt_1 (ipkey INT AUTO_INCREMENT, d1 DOUBLE, v2 VARCHAR(23), v3 VARCHAR(25), i4 INT(52), v5 VARCHAR(29), t6 BOOL,  PRIMARY KEY(ipkey), INDEX tt_136i0(i4, ipkey DESC) , INDEX tt_136i1(v2 ASC)  ) ENCRYPTION='N' ROW_FORMAT=DYNAMIC ENGINE=Dstore;
ALTER TABLE tt_1 ADD COLUMN  tN49 BOOL, LOCK=DEFAULT, ALGORITHM=INSTANT;
ALTER TABLE tt_1 COMPRESSION= 'zlib';
ALTER TABLE tt_1 ADD COLUMN  tN175 BOOL, LOCK=DEFAULT, ALGORITHM=INSTANT;
ALTER TABLE tt_1 ADD COLUMN  tN273 BOOL, LOCK=DEFAULT, ALGORITHM=INSTANT;
insert into tt_1 values(456961,0,"fVJKfZSsL","OqXVoixf1v0Q","211070","w7iqpB8NtxxiKqxaV35z4x",0,0,1,1);
check table tt_1;
TRUNCATE TABLE tt_1;
insert into tt_1 values(456961,0,"fVJKfZSsL","OqXVoixf1v0Q","211070","w7iqpB8NtxxiKqxaV35z4x",0,0,1,1);
use db1;
select * from tt_1;
--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();
let $t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);

--replace_result $t1_name_in_recyclebin tt_1
eval SELECT instant_cols FROM information_schema.innodb_tables WHERE name='$t1_name_in_recyclebin';
--replace_result $t1_name_in_recyclebin tt_1
eval check table `$t1_name_in_recyclebin`;
SELECT instant_cols FROM information_schema.innodb_tables WHERE name='tt_1';
check table tt_1;

--echo #
--echo # restart
--echo #
--let $restart_parameters= restart:
--source include/restart_mysqld.inc

connection root;
set global rds_recycle_bin_mode=on;
set rds_recycle_bin_mode=on;

--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();

--replace_result $t1_name_in_recyclebin tt_1
eval select * from __recyclebin__.`$t1_name_in_recyclebin`;
check table tt_1;
--replace_result $t1_name_in_recyclebin tt_1
eval check table __recyclebin__.`$t1_name_in_recyclebin`;
--replace_result $t1_name_in_recyclebin tt_1
eval call dbms_recyclebin.purge_table('$t1_name_in_recyclebin');

use db1;
select * from tt_1;
SELECT instant_cols FROM information_schema.innodb_tables WHERE name like '%tt_1%';
check table tt_1;
insert into tt_1 values(456962,0,"fVJKfZSsL","OqXVoixf1v0Q","211070","w7iqpB8NtxxiKqxaV35z4x",0,0,1,1);
select * from tt_1;
check table tt_1;

--echo #
--echo # restart
--echo #
--let $restart_parameters= restart:
--source include/restart_mysqld.inc

use db1;
select * from tt_1;
SELECT instant_cols FROM information_schema.innodb_tables WHERE name like '%tt_1%';
check table tt_1;

set rds_recycle_bin_mode=off;
truncate table tt_1;
drop table tt_1;

set global rds_recycle_bin_mode=on;
set rds_recycle_bin_mode=on;
CREATE TABLE tt_25 (f0 FLOAT, i1_rename INT AUTO_INCREMENT, i2 INTEGER, i3 INT, g4_rename  CHAR(8) GENERATED ALWAYS AS (CONCAT(SUBSTRING(i3,1,1),SUBSTRING(i3,1,3),SUBSTRING(i2,1,4))) STORED, iN149 INT, cN12_rename CHAR(14), iN180_rename INTEGER, cN184 CHAR(18), gN114  VARCHAR(11) GENERATED ALWAYS AS (CONCAT(SUBSTRING(f0,1,4),SUBSTRING(cN184,1,6),SUBSTRING(f0,1,1))), vN259_rename VARCHAR(25), iN91_rename INT, vN92_rename VARCHAR(21), gN186  CHAR(10) GENERATED ALWAYS AS (CONCAT(i2)), vN299_rename VARCHAR(18), tN132 BOOL, tN33_rename BOOL, vN95 VARCHAR(26), tN23 BOOL, vN289_rename VARCHAR(13), tN234_rename BOOL, tN10 BOOL, tN203 BOOL, vN136 VARCHAR(19), vN92 VARCHAR(18), iN105 INT, cN22 CHAR(10), gN79_rename  CHAR(5) GENERATED ALWAYS AS (CONCAT(tN234_rename,tN234_rename,SUBSTRING(cN22,1,1),SUBSTRING(iN91_rename,1,1),tN132)), vN68_rename VARCHAR(17), iN181 INT, cN174 CHAR(29), iN163 INT, iN24 INT, vN111 VARCHAR(24), tN273_rename BOOL, tN95 BOOL, iN88_rename INT, iN226 INT, iN23 INT, vN76 VARCHAR(29), iN172 INTEGER, vN230 VARCHAR(14), iN57 INT, vN103 VARCHAR(29), vN106 VARCHAR(26), iN283 INT(64), cN185 CHAR(19), INDEX tt_25i0(f0, i2 DESC, g4_rename) , INDEX tt_25i1(i1_rename DESC, i2, i3, f0 DESC, g4_rename ASC)  ) ROW_FORMAT=COMPRESSED ENGINE=Dstore;
ALTER TABLE tt_25 DROP COLUMN iN163, LOCK=DEFAULT, ALGORITHM=INSTANT;
TRUNCATE TABLE tt_25;
ALTER TABLE tt_25 ADD COLUMN tN135 BOOL, LOCK=DEFAULT, ALGORITHM=INSTANT;
SHOW CREATE TABLE tt_25;

CREATE TABLE tt_26 (
    f0 FLOAT,
    iN163 INT,
    iN164 INT
) ENGINE = Dstore;
INSERT INTO tt_26
VALUES (1, 1, 1), (2, 2, 2), (3, 3, 3);
ALTER TABLE tt_26
    DROP COLUMN iN163,
    LOCK = DEFAULT,
    ALGORITHM = INSTANT;
INSERT INTO tt_26
VALUES (4, 4), (5, 5), (6, 6);
SHOW CREATE TABLE tt_26;

TRUNCATE TABLE tt_26;
SHOW CREATE TABLE tt_26;
SELECT * FROM tt_26;
INSERT INTO tt_26
VALUES (7, 7), (8, 8), (9, 9);
SELECT * FROM tt_26;

ALTER TABLE tt_26
    ADD COLUMN tN136 BOOL AFTER f0,
    LOCK = DEFAULT,
    ALGORITHM = INSTANT;
SHOW CREATE TABLE tt_26;
SELECT * FROM tt_26;
INSERT INTO tt_26
VALUES (10, 10, 10), (11, 11, 11), (12, 12, 12);
SELECT * FROM tt_26;

TRUNCATE TABLE tt_26;
SHOW CREATE TABLE tt_26;
SELECT * FROM tt_26;
INSERT INTO tt_26
VALUES (13, 13, 13), (14, 14, 14), (15, 15, 15);
SHOW CREATE TABLE tt_26;
SELECT * FROM tt_26;

CREATE TABLE tt_28 (
    f0 FLOAT,
    iN163 INT AUTO_INCREMENT PRIMARY KEY,
    iN164 INT
) ENGINE = InnoDB;
INSERT INTO tt_28(f0, iN164)
VALUES (1, 1), (2, 2), (3, 3);
SELECT * FROM tt_28;
TRUNCATE TABLE tt_28;
INSERT INTO tt_28(f0, iN164)
VALUES (1, 1), (2, 2), (3, 3);
SELECT * FROM tt_28;

--replace_column 2 # 5 # 6 #
call dbms_recyclebin.show_tables();

DROP TABLE tt_25, tt_26, tt_28;

drop database db1;
drop database __recyclebin__;
create database __recyclebin__ default character set utf8mb4;

set global rds_recycle_bin_mode=off;
set rds_recycle_bin_mode=off;
