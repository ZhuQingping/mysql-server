call mtr.add_suppression('Failed to create binlog purge thread');
RESET MASTER;
#
# Expect that the status of binlog purge thread is 'NOT_CREATED'
#
SELECT @@GLOBAL.rds_binlog_purge_thread_status;
@@GLOBAL.rds_binlog_purge_thread_status
NOT_CREATED
SET GLOBAL debug="+d,simulate_create_purge_thread_failure";
# 
# Simulate that the binlog purge thread went away unusually.
# Expect that the status of binlog purge thread is 'INITIALIZING'
# and rds_purge_binary_logs_asynchronously is turned on after
# setting rds_purge_binary_logs_asynchronously to true.
#
SET GLOBAL rds_purge_binary_logs_asynchronously= true;
SELECT @@GLOBAL.rds_binlog_purge_thread_status;
@@GLOBAL.rds_binlog_purge_thread_status
INITIALIZING
SELECT @@GLOBAL.rds_purge_binary_logs_asynchronously;
@@GLOBAL.rds_purge_binary_logs_asynchronously
1
SET GLOBAL debug="-d,simulate_create_purge_thread_failure";
CREATE TABLE t1(c1 TEXT);
#
# Expect that the status of binlog purge thread is 'RESET'
# after rotating binlog.
#
INSERT INTO t1 VALUES (REPEAT('a',4096));
SELECT @@GLOBAL.rds_binlog_purge_thread_status;
@@GLOBAL.rds_binlog_purge_thread_status
RESET
#
# Expect that the stable status of binlog purge thread is 'RESET'
# and rds_purge_binary_logs_asynchronously is turned off after
# setting rds_purge_binary_logs_asynchronously to false.
# Which means we can turn off rds_purge_binary_logs_asynchronously
# successfully after the binlog purge thread went away unusually.
#
SET GLOBAL rds_purge_binary_logs_asynchronously= false;
SELECT @@GLOBAL.rds_binlog_purge_thread_status;
@@GLOBAL.rds_binlog_purge_thread_status
RESET
SELECT @@GLOBAL.rds_purge_binary_logs_asynchronously;
@@GLOBAL.rds_purge_binary_logs_asynchronously
0
