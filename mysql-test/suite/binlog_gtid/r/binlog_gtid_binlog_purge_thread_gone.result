call mtr.add_suppression('The binlog purge thread went away unusually');
call mtr.add_suppression('Failed to create binlog purge thread');
RESET MASTER;
#
# Expect that the status of binlog purge thread is 'NOT_CREATED'
#
SELECT @@GLOBAL.rds_binlog_purge_thread_status;
@@GLOBAL.rds_binlog_purge_thread_status
NOT_CREATED
SET GLOBAL debug="+d,simulate_create_purge_thread_failure";
#
# Expect that the status of binlog purge thread is 'INITIALIZING'
# after setting rds_purge_binary_logs_asynchronously to true.
#
SET GLOBAL rds_purge_binary_logs_asynchronously= true;
SELECT @@GLOBAL.rds_binlog_purge_thread_status;
@@GLOBAL.rds_binlog_purge_thread_status
INITIALIZING
SET GLOBAL debug="-d,simulate_create_purge_thread_failure";
CREATE TABLE t1(c1 TEXT);
#
# Expect that the status of binlog purge thread is 'RESET'
# and then it becomes 'GONE' after rotating binlog more
# than 60 times.
#
