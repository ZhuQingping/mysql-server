#
# Expect that the status of binlog purge thread is 'EXIT' after
# setting rds_purge_binary_logs_asynchronously to false.
#
SET GLOBAL rds_purge_binary_logs_asynchronously= false;
SELECT @@GLOBAL.rds_binlog_purge_thread_status;
@@GLOBAL.rds_binlog_purge_thread_status
EXIT
#
# Expect that the status of binlog purge thread is 'SLEEPING'
# after setting rds_purge_binary_logs_asynchronously to true.
#
SET GLOBAL rds_purge_binary_logs_asynchronously= true;
SELECT @@GLOBAL.rds_binlog_purge_thread_status;
@@GLOBAL.rds_binlog_purge_thread_status
SLEEPING
