#
# Test for tablespace page crc fail
#
call mtr.add_suppression("failed to do full backup for dstore");
call mtr.add_suppression("start full local backup fail");
call mtr.add_suppression("full backup found binlog is not enabled");

--source suite/local_backup/include/prepare_for_backup.inc

# 1. prepare some data
create database backup_page_crc_fail;
use backup_page_crc_fail;
create table t1(s varchar(100)) engine=dstore;

# insert 1000 records
--disable_query_log
--disable_result_log
SET SESSION autocommit=0;
--let $table = t1
--let $i = 1000
--source include/Load_data.inc
--enable_result_log
--enable_query_log
select count(*) from t1;

# Backup should success
--let $full_backup_flag = 0
--source suite/local_backup/include/start_full_backup.inc
--let $skip_check_meta_json=1
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';

# 2. Inject data corrupt
--let $MYSQLD_DATADIR = `SELECT @@datadir`
--disable_query_log
--exec echo -n "HELLO" > $MYSQLTEST_VARDIR/1.txt
--exec dd if=$MYSQLTEST_VARDIR/1.txt of=$MYSQLD_DATADIR/#mysql_dstore/gs_pdb/PDB_17/5125 bs=1 seek=99 count=5 conv=notrunc
--exec rm $MYSQLTEST_VARDIR/1.txt
--enable_query_log

show variables like 'dstore_local_backup_retry_num';

# 3. Create a full backup
--let $full_backup_flag = 0
--source suite/local_backup/include/start_full_backup.inc
--source suite/local_backup/include/wait_full_backup.inc

# 4. Should fail due to crc fail
show status like 'Rds_local_backup_last_full_backup_status';

# make dstore err msg to flush
--let $shutdown_server_timeout= 300
--source include/shutdown_mysqld.inc

--let SEARCH_FILE = $MYSQLD_DATADIR/mysqld-current.log
--let SEARCH_PATTERN=Read buffer and check failed
--source include/search_pattern.inc
--let SEARCH_FILE = $MYSQLD_DATADIR/mysqld-current.log
--let SEARCH_PATTERN=copy file\(fileName \= 5125\) failed
--source include/search_pattern.inc

# Restore use success backup
--source suite/local_backup/include/restore_with_script.inc
--let $restart_parameters= restart: --dstore_open_restore_mode=on
--source include/start_mysqld.inc

drop database backup_page_crc_fail;

--source suite/local_backup/include/clean_backup.inc
