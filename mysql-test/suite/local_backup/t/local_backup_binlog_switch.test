#
# Basic test for full local backup and archive restore
#
--source include/have_log_bin.inc
--source include/have_debug.inc
call mtr.add_suppression("LocalBackup fetch gtid is not enabled");

--source suite/local_backup/include/prepare_for_backup.inc

# prepare some data
create database local_backup_binlog;
use local_backup_binlog;
create table t1(s varchar(100)) engine=Dstore;

# insert 1000 records
--disable_query_log
--disable_result_log
SET SESSION autocommit=0;
--let $table = t1
--let $i = 1000
--source include/Load_data.inc
--enable_result_log
--enable_query_log
select count(*) from t1;

--let $skip_check_meta_json=1

--echo # Restart with rds_local_backup_fetch_gtid=off 
--let $shutdown_server_timeout= 300
--source include/shutdown_mysqld.inc

--let $restart_parameters= restart: --rds_local_backup_fetch_gtid=off
--source include/start_mysqld.inc

select @@rds_local_backup_fetch_gtid;

call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*

--echo # Restart with rds_local_backup_fetch_gtid=on
--source include/kill_mysqld.inc
--let $restart_parameters=
--source include/start_mysqld.inc
select @@rds_local_backup_fetch_gtid;

drop database local_backup_binlog;

--source suite/local_backup/include/clean_backup.inc
