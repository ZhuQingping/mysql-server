#
# Basic test for full local backup and archive restore
#
--source include/have_debug.inc
call mtr.add_suppression("failed to create full backup thread");
call mtr.add_suppression("failed to mkdir for full backup");
call mtr.add_suppression("failed to get backup MDL");
call mtr.add_suppression("failed to fetch schemas from DD");
call mtr.add_suppression("failed to copy schema directory");
call mtr.add_suppression("full backup path not configured");
call mtr.add_suppression("Cannot start local backup: change buffer is not disabled");
call mtr.add_suppression("failed to do full backup for innodb");
call mtr.add_suppression("failed to do full backup for dstore");
call mtr.add_suppression("start full local backup fail");
call mtr.add_suppression("new LocalBackupFile object fail when add local backup file");
call mtr.add_suppression("add local backup file fail when write full local backup meta");
call mtr.add_suppression("write full local backup meta fail");
call mtr.add_suppression("Local backup: failed to write full backup meta info");
call mtr.add_suppression("Local backup: failed to");
call mtr.add_suppression("Local backup: stop dstore full backup failed");
call mtr.add_suppression("Local backup: stop innodb full backup failed");
call mtr.add_suppression("full backup found binlog is not enabled");
call mtr.add_suppression("open file");
call mtr.add_suppression("create new file");
call mtr.add_suppression("prepare for backup fail after backup control file");

--source suite/local_backup/include/prepare_for_backup.inc

# Full backup path not set
--let $shutdown_server_timeout= 300
--let $restart_parameters= restart: --rds_full_local_backup_path=""
--source include/restart_mysqld.inc

--error ER_DA_LOCAL_BACKUP_ERROR
call rds_backup.start_full_local_backup(0);

--let $shutdown_server_timeout= 300
--let $restart_parameters= restart
--source include/restart_mysqld.inc


# prepare some data
create database local_backup_error;
use local_backup_error;
create table t1(s varchar(100)) engine=Dstore;

# insert 1000 records
--disable_query_log
--disable_result_log
SET SESSION autocommit=0;
--let $table = t1
--let $i = 1000
--source include/Load_data.inc
--enable_result_log
--enable_query_log
select count(*) from t1;

# Wrong number of parameter
--error ER_SP_WRONG_NO_OF_ARGS
call rds_backup.start_full_local_backup();
--error ER_SP_WRONG_NO_OF_ARGS
call rds_backup.start_full_local_backup(1, 2);

# Create thread failed for full backup
set global debug='+d,full_lb_create_thread_fail';
--error ER_DA_LOCAL_BACKUP_ERROR
call rds_backup.start_full_local_backup(0);
set global debug='-d,full_lb_create_thread_fail';

# Create dir failed for full backup
set global debug='+d,full_lb_create_dir_fail';
call rds_backup.start_full_local_backup(0);
--let $skip_check_meta_json = 1
--source suite/local_backup/include/wait_full_backup.inc
--let $skip_check_meta_json = 0
show status like 'Rds_local_backup_last_full_backup_status';
set global debug='-d,full_lb_create_dir_fail';

# Acquire MDL failed for full backup
set global debug='+d,full_lb_acquire_mdl_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';
set global debug='-d,full_lb_acquire_mdl_fail';

# Fetch schema from DD failed for full backup
set global debug='+d,full_lb_fetch_schema_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';
set global debug='-d,full_lb_fetch_schema_fail';
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*

# Copy schema dir failed for full backup
set global debug='+d,full_lb_cp_schema_dir_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';
set global debug='-d,full_lb_cp_schema_dir_fail';
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*

set global debug='+d,full_lb_cp_one_dir_open_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';
set global debug='-d,full_lb_cp_one_dir_open_fail';
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*

set global debug='+d,full_lb_cp_one_dir_stat_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';
set global debug='-d,full_lb_cp_one_dir_stat_fail';
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*

set global debug='+d,full_lb_cp_one_dir_mkdir_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';
set global debug='-d,full_lb_cp_one_dir_mkdir_fail';
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*

set global debug='+d,full_lb_cp_one_dir_cp_sub_dir_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';
set global debug='-d,full_lb_cp_one_dir_cp_sub_dir_fail';
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*

set global debug='+d,full_lb_cp_one_dir_copy_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';
set global debug='-d,full_lb_cp_one_dir_copy_fail';
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*

# Write backup meta fail
set global debug='+d,full_lb_file_mgr_add_full_parent_meta_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';
set global debug='-d,full_lb_file_mgr_add_full_parent_meta_fail';
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*

# Stop while backup running
set global debug='+d,full_lb_thd_wait_before_exit';
--let $full_backup_flag = 0
--source suite/local_backup/include/start_full_backup.inc

set global debug='+d,full_lb_stop_dstore_fail';
--error ER_DA_LOCAL_BACKUP_ERROR
call rds_backup.stop_full_local_backup();
set global debug='-d,full_lb_stop_dstore_fail';

set global debug='+d,full_lb_stop_innodb_fail';
--error ER_DA_LOCAL_BACKUP_ERROR
call rds_backup.stop_full_local_backup();
set global debug='-d,full_lb_stop_innodb_fail';

connect(conn1,localhost,root,,local_backup_error);
connection conn1;
send call rds_backup.stop_full_local_backup();

connection default;
set global debug='-d,full_lb_thd_wait_before_exit';

connection conn1;
reap;
connection default;
show status like 'Rds_local_backup_full_backup_is_running';

--disable_query_log
--disable_result_log
SET SESSION autocommit=0;
--let $table = t1
--let $i = 100
--source include/Load_data.inc
--enable_result_log
--enable_query_log
select count(*) from t1;

# Do backup normal
--source suite/local_backup/include/start_full_backup.inc
--source suite/local_backup/include/wait_full_backup.inc

# Restore
--let $shutdown_server_timeout= 300
--source include/shutdown_mysqld.inc

--let $list_type = full_backup
--source suite/local_backup/include/restore_with_script.inc

--let $restart_parameters= restart: --dstore_open_restore_mode=on
--source include/start_mysqld.inc

# Verify data
select count(*) from t1;
# insert after resotre
--disable_query_log
--disable_result_log
SET SESSION autocommit=0;
--let $i = 50
--source include/Load_data.inc
--enable_result_log
--enable_query_log
select count(*) from t1;

drop database local_backup_error;

--source suite/local_backup/include/clean_backup.inc
