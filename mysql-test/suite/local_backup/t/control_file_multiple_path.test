--source suite/local_backup/include/prepare_for_backup.inc

call mtr.add_suppression("full backup found binlog is not enabled");

--let $MYSQLD_DATADIR = `SELECT @@datadir`

CREATE DATABASE db1;
USE db1;
CREATE TABLE t1(a int) ENGINE=Dstore;
INSERT INTO t1 VALUES(1);
SELECT * FROM t1;

# Full backup.
--let $full_backup_flag = 1
--source suite/local_backup/include/start_full_backup.inc
--source suite/local_backup/include/wait_full_backup.inc

INSERT INTO t1 VALUES(2);
SELECT * FROM t1 order by a;

# wal archive.
--source suite/local_backup/include/start_log_archive.inc

INSERT INTO t1 VALUES(3);
SELECT * FROM t1 order by a;

--sleep 3

--source suite/local_backup/include/stop_log_archive.inc

INSERT INTO t1 VALUES(4);
SELECT * FROM t1 order by a;

--echo # Shut server down.
--let $shutdown_server_timeout = 300
--source include/shutdown_mysqld.inc

# Restore with script.
--let $list_type = wal_archive
--source suite/local_backup/include/restore_with_script.inc

# Move control file 2 and wal to the wal_directory.
--exec rm -rf $MYSQLTEST_VARDIR/wal_directory/gs_pdb/PDB_17/database_control_2
--exec rm -rf $MYSQLTEST_VARDIR/wal_directory/gs_pdb/PDB_17/wal/*
--exec mv $MYSQLD_DATADIR/#mysql_dstore/gs_pdb/PDB_17/database_control_2 $MYSQLTEST_VARDIR/wal_directory/gs_pdb/PDB_17/
--exec mv $MYSQLD_DATADIR/#mysql_dstore/gs_pdb/PDB_17/wal/* $MYSQLTEST_VARDIR/wal_directory/gs_pdb/PDB_17/wal/

--echo # Restart the server.
--let $restart_parameters= restart: --dstore_open_restore_mode=on
--source include/start_mysqld.inc

USE db1;
SELECT * FROM t1 order by a;

# Drop database db1.
DROP DATABASE db1;

--source suite/local_backup/include/clean_backup.inc
--exec rm -rf $MYSQLTEST_VARDIR/wal_directory
