--source include/have_debug.inc

--let $mock_obs = 1
--source suite/local_backup/include/prepare_for_backup.inc

call mtr.add_suppression("full backup found binlog is not enabled");
call mtr.add_suppression("OBS error occur when get object meta");
call mtr.add_suppression("OBS get object metadata fail");
call mtr.add_suppression("LocalBackup failed to write binlog meta file");
call mtr.add_suppression("finish full local binlog logic failed");
call mtr.add_suppression("failed to finish backup binlog logic");
call mtr.add_suppression("Local backup: failed to generate binlog files meta data for OBS object");
call mtr.add_suppression("Local backup: full backup failed to copy binlog file");
call mtr.add_suppression("LocalBackup get binlog point fail");
call mtr.add_suppression("start full local backup fail, pdb id ");
call mtr.add_suppression("Local backup: failed to do full backup for dstore");
call mtr.add_suppression("Local backup: failed to append binlog file ");
call mtr.add_suppression("Local backup: failed to append binlog index to OBS object");
call mtr.add_suppression("the start recovery lsn invalid when search point from parent meta");
call mtr.add_suppression("search point from full parent meta fail when create restore meta");
call mtr.add_suppression("create full backup restore meta fail with time point");
call mtr.add_suppression("Local backup: failed to write full backup restore meta to OBS");


--let $skip_check_meta_json = 1
SET GLOBAL debug='+d,mock_put_object';
SET GLOBAL debug='+d,mock_append_object';
SET GLOBAL debug='+d,mock_get_object';
SET GLOBAL debug='+d,mock_list_object';
SET GLOBAL debug='+d,mock_delete_object';
SET GLOBAL debug='+d,mock_get_object_meta';

CREATE DATABASE db1;
USE db1;
CREATE TABLE t1(a int) ENGINE=Dstore;
INSERT INTO t1 VALUES(1);
SELECT * FROM t1;

# full backup.
--let $full_backup_flag = 1
--source suite/local_backup/include/start_full_backup.inc
--source suite/local_backup/include/wait_full_backup.inc

SHOW STATUS LIKE 'Rds_local_backup_last_full_backup_status';

INSERT INTO t1 VALUES(2);
SELECT * FROM t1 order by a;

# Inject some error
SET GLOBAL debug='+d,upload_last_binlog_and_index_to_obs_gen_merged_file_obj_meta_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
SHOW STATUS LIKE 'Rds_local_backup_last_full_backup_status';
SET GLOBAL debug='-d,upload_last_binlog_and_index_to_obs_gen_merged_file_obj_meta_fail';

SET GLOBAL debug='+d,upload_last_binlog_and_index_to_obs_append_one_file_to_obj_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
SHOW STATUS LIKE 'Rds_local_backup_last_full_backup_status';
SET GLOBAL debug='-d,upload_last_binlog_and_index_to_obs_append_one_file_to_obj_fail';

SET GLOBAL debug='+d,upload_last_binlog_and_index_to_obs_append_data_to_obj_fail';
call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
SHOW STATUS LIKE 'Rds_local_backup_last_full_backup_status';
SET GLOBAL debug='-d,upload_last_binlog_and_index_to_obs_append_data_to_obj_fail';

# Drop database db1.
DROP DATABASE db1;

--let $skip_check_meta_json = 0
SET GLOBAL debug='-d,mock_put_object';
SET GLOBAL debug='-d,mock_append_object';
SET GLOBAL debug='-d,mock_get_object';
SET GLOBAL debug='-d,mock_list_object';
SET GLOBAL debug='-d,mock_delete_object';
SET GLOBAL debug='-d,mock_get_object_meta';

--source suite/local_backup/include/clean_backup.inc
--let $mock_obs = 0
