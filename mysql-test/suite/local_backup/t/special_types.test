--source suite/local_backup/include/prepare_for_backup.inc

call mtr.add_suppression("full backup found binlog is not enabled");

CREATE DATABASE db1;
USE db1;
# Auto increment key.
CREATE TABLE t1(a INT NOT NULL AUTO_INCREMENT, PRIMARY KEY(a)) ENGINE=Dstore;
CREATE TABLE t2(a INT NOT NULL AUTO_INCREMENT, b VARCHAR(100), PRIMARY KEY(a)) ENGINE=Dstore;
# Foreign key.
CREATE TABLE t3(a INT, t1_a INT, FOREIGN KEY(t1_a) REFERENCES t1(a)) ENGINE=Dstore;
# Generated column.
CREATE TABLE t4(a INT, b INT GENERATED ALWAYS AS (a), c CHAR(10), d CHAR(10) GENERATED ALWAYS AS (c), a1 INT GENERATED ALWAYS AS (a) VIRTUAL, INDEX(a1)) ENGINE=Dstore;
# Invisible column.
CREATE TABLE t5(a INT, b INT INVISIBLE) ENGINE=Dstore;
# Prefix key.
CREATE TABLE t6(a INT, b CHAR(100), c VARCHAR(100), KEY(b(5)), KEY(c(5))) ENGINE=Dstore;

INSERT INTO t1 VALUES();
INSERT INTO t2 VALUES();
INSERT INTO t3 VALUES(1, 1);
INSERT INTO t4 VALUES(1, DEFAULT, 'aa', DEFAULT, DEFAULT);
INSERT INTO t5 VALUES(1);
INSERT INTO t6 VALUES(1, '1234567890', 'abcde@abc.com');
SELECT * FROM t1;
SELECT * FROM t2;
SELECT * FROM t3;
SELECT * FROM t4;
SELECT a, b FROM t5;
SELECT * FROM t6;

# Full backup.
--let $full_backup_flag = 1
--source suite/local_backup/include/start_full_backup.inc
--source suite/local_backup/include/wait_full_backup.inc

INSERT INTO t1 VALUES();
INSERT INTO t2(b) VALUES('bb');
INSERT INTO t3 VALUES(2, 2);
INSERT INTO t4 VALUES(2, DEFAULT, 'bb', DEFAULT, DEFAULT);
INSERT INTO t5(a, b) VALUES(2, 22);
INSERT INTO t6 VALUES(2, '9876543210', 'zyxwv@zyx.com');
SELECT * FROM t1 order by a;
SELECT * FROM t2 order by a;
SELECT * FROM t3 order by a;
SELECT * FROM t4 order by a;
SELECT a, b FROM t5 order by a;
SELECT * FROM t6 order by a;

# wal archive.
--source suite/local_backup/include/start_log_archive.inc

INSERT INTO t1 VALUES();
INSERT INTO t2(b) VALUES('cc');
INSERT INTO t3 VALUES(3, 3);
INSERT INTO t4 VALUES(3, DEFAULT, 'cc', DEFAULT, DEFAULT);
INSERT INTO t5(a, b) VALUES(3, 33);
INSERT INTO t6 VALUES(3, 'abc123def456ghi789', 'abc123@abc123.com');
SELECT * FROM t1 order by a;
SELECT * FROM t2 order by a;
SELECT * FROM t3 order by a;
SELECT * FROM t4 order by a;
SELECT a, b FROM t5 order by a;
SELECT * FROM t6 order by a;

--sleep 3

--source suite/local_backup/include/stop_log_archive.inc

INSERT INTO t1 VALUES();
INSERT INTO t2(b) VALUES('dd');
INSERT INTO t3 VALUES(4, 4);
INSERT INTO t4 VALUES(4, DEFAULT, 'dd', DEFAULT, DEFAULT);
INSERT INTO t5(a, b) VALUES(4, 44);
INSERT INTO t6 VALUES(4, '987abc654def321ghi', '987abc@987abc.com');
SELECT * FROM t1 order by a;
SELECT * FROM t2 order by a;
SELECT * FROM t3 order by a;
SELECT * FROM t4 order by a;
SELECT a, b FROM t5 order by a;
SELECT * FROM t6 order by a;

--echo # Shut server down.
--let $shutdown_server_timeout = 300
--source include/shutdown_mysqld.inc

# Restore with script.
--let $list_type = wal_archive
--source suite/local_backup/include/restore_with_script.inc

--echo # Restart the server.
--let $restart_parameters= restart: --dstore_open_restore_mode=on
--source include/start_mysqld.inc

USE db1;
SELECT * FROM t1 order by a;
SELECT * FROM t2 order by a;
SELECT * FROM t3 order by a;
SELECT * FROM t4 order by a;
SELECT a, b FROM t5 order by a;
SELECT * FROM t6 order by a;

# Drop database db1.
DROP DATABASE db1;

--source suite/local_backup/include/clean_backup.inc
