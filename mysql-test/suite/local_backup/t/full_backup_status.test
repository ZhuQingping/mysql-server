call mtr.add_suppression("start full local backup fail");
call mtr.add_suppression("failed to do full backup for dstore");
call mtr.add_suppression("Cannot start local backup: change buffer is not disabled");
call mtr.add_suppression("failed to do full backup for innodb");
call mtr.add_suppression("full backup found binlog is not enabled");

--source suite/local_backup/include/prepare_for_backup.inc
--let $check_json_crc = 1

CREATE DATABASE db1;
USE db1;
CREATE TABLE t1(a int) ENGINE=Dstore;
INSERT INTO t1 VALUES(1);
SELECT * FROM t1;

# 1. Full backup success.
--let $full_backup_flag = 1
--source suite/local_backup/include/start_full_backup.inc

# Check backup_meta.json during the full backup is running.
--let $check_status = In_progress
--source suite/local_backup/include/check_backup_meta_json.inc

--source suite/local_backup/include/wait_full_backup.inc

# Test for local backup status.
--disable_result_log
SHOW STATUS LIKE 'Dstore_local_backup_full_backup_status';
--enable_result_log

# 2. Full backup and stop before it's finished.
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*
SET GLOBAL dstore_local_backup_progress_size_interval = 2097152;

--let $full_backup_flag = 1
--source suite/local_backup/include/start_full_backup.inc
--sleep 1
--source suite/local_backup/include/stop_full_backup.inc
--sleep 2

# Check backup_meta.json after the full backup is stopped.
--let $check_status = Aborted
--source suite/local_backup/include/check_backup_meta_json.inc

# Test for local backup status.
--disable_result_log
SHOW STATUS LIKE 'Dstore_local_backup_full_backup_status';
--enable_result_log

SET GLOBAL dstore_local_backup_progress_size_interval = 20971520;

# 3. Full backup fail.
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*
SET GLOBAL innodb_change_buffering=all;
--let $full_backup_flag = 1
--source suite/local_backup/include/start_full_backup.inc
--source suite/local_backup/include/wait_full_backup.inc
show status like 'Rds_local_backup_last_full_backup_status';
SET GLOBAL innodb_change_buffering=none;

# Test for local backup status.
--disable_result_log
SHOW STATUS LIKE 'Dstore_local_backup_full_backup_status';
--enable_result_log

# 4. Full backup and wal archive both running.
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*
--source suite/local_backup/include/start_log_archive.inc
INSERT INTO t1 VALUES(2);
SELECT * FROM t1 order by a;
--sleep 3

--let $full_backup_flag = 1
--source suite/local_backup/include/start_full_backup.inc

# Check backup_meta.json during the full backup is running.
--let $check_status = In_progress
--source suite/local_backup/include/check_backup_meta_json.inc

--source suite/local_backup/include/wait_full_backup.inc

# Test for local backup status.
--disable_result_log
SHOW STATUS LIKE 'Dstore_local_backup_full_backup_status';
--enable_result_log

--source suite/local_backup/include/stop_log_archive.inc

# 5. Update parameter dstore_local_backup_progress_size_interval, then run full backup.
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*
SET GLOBAL dstore_local_backup_progress_size_interval = 2097152;

--let $full_backup_flag = 1
--source suite/local_backup/include/start_full_backup.inc

# Check backup_meta.json during the full backup is running.
--let $check_status = In_progress
--source suite/local_backup/include/check_backup_meta_json.inc

SET GLOBAL dstore_local_backup_progress_size_interval = 20971520000;

--source suite/local_backup/include/wait_full_backup.inc

# Test for local backup status.
--disable_result_log
SHOW STATUS LIKE 'Dstore_local_backup_full_backup_status';
--enable_result_log

SET GLOBAL dstore_local_backup_progress_size_interval = 20971520;

# Drop database db1.
DROP DATABASE db1;
--let $check_json_crc = 0

--source suite/local_backup/include/clean_backup.inc
