--innodb_change_buffering=none
--rds_full_local_backup_path=$MYSQLTEST_VARDIR/full_local_backup
--rds_log_archive_path=$MYSQLTEST_VARDIR/wal_archive
--dstore_local_backup_meta_path=$MYSQLTEST_VARDIR/local_backup_meta
--dstore_restore_meta_path=$MYSQLTEST_VARDIR/local_backup_restore_meta
--timezone=SYSTEM
--dstore_check_point_timeout=1
--dstore_wal_archive_interval=1
--rds_dstore_write_ddl_sql_into_redo=ON
--rds_use_ddl_info_replay=ON
--log_bin=mysql
--disabled_storage_engines=InnoDB,CSV,Memory,MyISAM,MRG_MyISAM
--default_storage_engine=Dstore
--storage_engine_mode=ONLY_DSTORE
--transaction_isolation=READ-COMMITTED
--dstore_checkpoint_interval_time=100
--dstore_bg_page_writer_sleep_millisecond=100
--rds_dstore_support_binlog_check=on