#
# Basic test for full local backup with binlog backup lock
#
--source include/have_log_bin.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc

--source suite/local_backup/include/prepare_for_backup.inc

# prepare some data
create database local_backup_binlog_lock;
use local_backup_binlog_lock;
create table t1(s varchar(100)) engine=Dstore;


# insert 1000 records
--disable_query_log
--disable_result_log
SET SESSION autocommit=0;
--let $table = t1
--let $i = 1000
--source include/Load_data.inc
--enable_result_log
--enable_query_log
select count(*) from t1;

--let $skip_check_meta_json=1

--echo #
--echo # Case 1. check full local backup lock block DML
--echo #

SET GLOBAL DEBUG="+d,full_lb_wait_binlog_lock";
call rds_backup.start_full_local_backup(0);

--sleep 5

--connect(conn1,localhost,root,,local_backup_binlog_lock)
--connection conn1
--echo #
--echo # conn1 would lock wait timeout 
--echo #

SET SESSION DEBUG_SYNC = "now WAIT_FOR signal.full_lb_binlog_lock_acquired";

--echo #
--echo # conn1 continue after wait for debug_sync acqurired
--echo #

SET SESSION lock_wait_timeout = 1;
 
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO local_backup_binlog_lock.t1 VALUES('new_connect');

SET SESSION DEBUG_SYNC = "now SIGNAL signal.full_lb_test_end";
SET GLOBAL DEBUG="-d,full_lb_wait_binlog_lock";
SET SESSION DEBUG_SYNC="RESET";

--echo #
--echo # conn1 continue after full_lb_test_end
--echo #

--connection default
--source suite/local_backup/include/wait_full_backup.inc
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*


--echo #
--echo # Case 2. check full local backup with read only
--echo #

set global read_only = 1;

call rds_backup.start_full_local_backup(0);
--source suite/local_backup/include/wait_full_backup.inc
--exec rm -rf $MYSQLTEST_VARDIR/full_local_backup/*


set global read_only = 0;
drop database local_backup_binlog_lock;

--disconnect conn1
--source suite/local_backup/include/clean_backup.inc
