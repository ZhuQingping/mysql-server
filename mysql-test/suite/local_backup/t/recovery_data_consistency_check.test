#
# Basic test for check data consistency after crash recovery
#

# 1. prepare some data
create database consistency_check;
use consistency_check;
--disable_query_log
--disable_result_log
--source suite/local_backup/include/data_consistency_create_table.inc

# insert data
SET SESSION autocommit=0;
--source suite/local_backup/include/data_consistency_load_data.inc
CALL LoadAllTPCCData(10, 90, 100, 100);

# 2. execute DDL 
--source suite/local_backup/include/data_consistency_ddl.inc
CALL ExecuteAllDDL();
--enable_result_log
--enable_query_log 

# 3. Kill mysqld and restart
--source include/kill_mysqld.inc
--source include/start_mysqld.inc

# 4. Verify data
--disable_query_log
SET SESSION autocommit=0;
--echo # Check data consistency with DDL operation
--source suite/local_backup/include/data_consistency_ddl_check.inc
--enable_query_log

# 5. execute DML 
--disable_query_log
--disable_result_log
--connect (ddl_dml_conn, localhost, root,, consistency_check)
--connection ddl_dml_conn
SET SESSION autocommit=0;
--source suite/local_backup/include/data_consistency_dml.inc
--send CALL ExecuteTPCCWorkload(10, 90, 100, 100, 5000, 0.6, 0.25, 0.05, 0.05, 0.05)
--enable_result_log
--enable_query_log 

# 6. Kill mysqld and restart
--echo # Use original connection to make a crash
--connection default
--sleep 50
--source include/kill_mysqld.inc
--source include/start_mysqld.inc

# 7. Verify data
--disable_query_log
SET SESSION autocommit=0;
--echo # Check data consistency with DML operation
--source suite/local_backup/include/data_consistency_dml_check.inc
--enable_query_log

drop database consistency_check;

--source suite/local_backup/include/clean_backup.inc
