BEGIN
SELECT * FROM users WHERE id = uid;
END
USE ddl_test4; ALTER PROCEDURE get_user COMMENT 'Fetch user by ID'
USE ddl_test4; CREATE DEFINER=`root`@`localhost` FUNCTION `user_count`() RETURNS int
BEGIN
RETURN (SELECT COUNT(*) FROM users);
END
USE ddl_test4; CREATE DEFINER=`root`@`localhost` TRIGGER before_user_insert
BEFORE INSERT ON users
FOR EACH ROW SET NEW.created_at = NOW()
USE ddl_test4; CREATE DEFINER=`root`@`localhost` EVENT cleanup_temp
ON SCHEDULE EVERY 1 DAY
DO TRUNCATE TABLE tmp
