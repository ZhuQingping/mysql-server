create database ddl_test4;
use ddl_test4;
CREATE TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(50));
ALTER TABLE t1 ADD COLUMN created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP;
CREATE INDEX idx_name ON t1(name);
ALTER TABLE t1 ADD INDEX idx_created_at(created_at);
ALTER TABLE t1 DROP INDEX idx_name;
CREATE UNIQUE INDEX uni_id ON t1(id);
ALTER TABLE t1 ADD COLUMN email VARCHAR(100) AFTER name;
ALTER TABLE t1 MODIFY COLUMN name VARCHAR(100);
ALTER TABLE t1 CHANGE COLUMN email user_email VARCHAR(120);
ALTER TABLE t1 DROP COLUMN user_email;
ALTER TABLE t1 RENAME COLUMN name TO full_name;
RENAME TABLE t1 TO users;
OPTIMIZE TABLE users;
Table	Op	Msg_type	Msg_text
ddl_test4.users	optimize	note	Table does not support optimize, doing recreate + analyze instead
ddl_test4.users	optimize	status	OK
CREATE TABLE tmp (id INT);
INSERT INTO tmp VALUES (1);
TRUNCATE TABLE tmp;
CREATE TABLE users_copy LIKE users;
CREATE TABLE user_backup AS SELECT * FROM users;
ALTER TABLE users FORCE;
CREATE TABLE t2 (id INT, name VARCHAR(50));
ALTER TABLE t2 ADD PRIMARY KEY (id);
CREATE TABLE departments (dept_id INT PRIMARY KEY);
CREATE TABLE employees (
emp_id INT PRIMARY KEY,
dept_id INT
);
ALTER TABLE employees ADD CONSTRAINT fk_dept
FOREIGN KEY (dept_id) REFERENCES departments(dept_id);
ALTER TABLE employees ADD CONSTRAINT chk_id CHECK (emp_id > 0);
ALTER TABLE employees ALTER COLUMN dept_id SET DEFAULT 0;
CREATE VIEW v_users AS SELECT * FROM users WITH CHECK OPTION;
ALTER TABLE users CONVERT TO CHARACTER SET utf8mb4;
ALTER TABLE users CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_bin;
CREATE INDEX idx_fullname ON users(full_name) USING BTREE;
CREATE VIEW user_view AS SELECT id, full_name FROM users;
ALTER VIEW user_view AS SELECT id FROM users;
CREATE PROCEDURE get_user(IN uid INT)
BEGIN
SELECT * FROM users WHERE id = uid;
END|
ALTER PROCEDURE get_user COMMENT 'Fetch user by ID';
CREATE FUNCTION user_count() RETURNS INT
BEGIN
RETURN (SELECT COUNT(*) FROM users);
END|
CREATE TRIGGER before_user_insert
BEFORE INSERT ON users
FOR EACH ROW SET NEW.created_at = NOW();
CREATE EVENT cleanup_temp
ON SCHEDULE EVERY 1 DAY
DO TRUNCATE TABLE tmp;
ALTER EVENT cleanup_temp DISABLE;
