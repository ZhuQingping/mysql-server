call mtr.add_suppression("full backup found binlog is not enabled");
CREATE DATABASE db1;
USE db1;
CREATE TABLE t1(a INT NOT NULL AUTO_INCREMENT, PRIMARY KEY(a)) ENGINE=Dstore;
CREATE TABLE t2(a INT NOT NULL AUTO_INCREMENT, b VARCHAR(100), PRIMARY KEY(a)) ENGINE=Dstore;
CREATE TABLE t3(a INT, t1_a INT, FOREIGN KEY(t1_a) REFERENCES t1(a)) ENGINE=Dstore;
CREATE TABLE t4(a INT, b INT GENERATED ALWAYS AS (a), c CHAR(10), d CHAR(10) GENERATED ALWAYS AS (c), a1 INT GENERATED ALWAYS AS (a) VIRTUAL, INDEX(a1)) ENGINE=Dstore;
CREATE TABLE t5(a INT, b INT INVISIBLE) ENGINE=Dstore;
CREATE TABLE t6(a INT, b CHAR(100), c VARCHAR(100), KEY(b(5)), KEY(c(5))) ENGINE=Dstore;
INSERT INTO t1 VALUES();
INSERT INTO t2 VALUES();
INSERT INTO t3 VALUES(1, 1);
INSERT INTO t4 VALUES(1, DEFAULT, 'aa', DEFAULT, DEFAULT);
INSERT INTO t5 VALUES(1);
INSERT INTO t6 VALUES(1, '1234567890', 'abcde@abc.com');
SELECT * FROM t1;
a
