call mtr.add_suppression("previous full backup is running");
call mtr.add_suppression("full backup found binlog is not enabled");
create database full_backup_restore;
use full_backup_restore;
create table t1(s varchar(100)) engine=Dstore;
===============
Load the data
===============
select count(*) from t1;
count(*)
100
show status like 'Rds_local_backup_last_full_backup_status';
Variable_name	Value
Rds_local_backup_last_full_backup_status	None
set global debug='+d,full_lb_thd_wait_before_exit';
call rds_backup.start_full_local_backup(0);
show status like 'Rds_local_backup_full_backup_is_running';
Variable_name	Value
Rds_local_backup_full_backup_is_running	ON
call rds_backup.start_full_local_backup(0);
ERROR HY000: Local backup: previous full backup is running
set global debug='-d,full_lb_thd_wait_before_exit';
show status like '%local_backup_full_backup_is_running%';
Variable_name	Value
Rds_local_backup_full_backup_is_running	OFF
Pattern ""nonDstoreRunningStatus": "Completed"" found
Pattern ""tablespaceRunningStatus": "Completed"" found
Pattern ""walRunningStatus": "Completed"" found
Pattern ""controlFileRunningStatus": "Completed"" found
call rds_backup.stop_full_local_backup();
show status like '%local_backup_full_backup_is_running%';
Variable_name	Value
Rds_local_backup_full_backup_is_running	OFF
call rds_backup.stop_full_local_backup();
show status like '%local_backup_full_backup_is_running%';
Variable_name	Value
Rds_local_backup_full_backup_is_running	OFF
show status like 'Rds_local_backup_last_full_backup_status';
Variable_name	Value
Rds_local_backup_last_full_backup_status	Success
