--disable_query_log
CALL mtr.add_suppression("Plugin 'Dstore' init function returned error.");
CALL mtr.add_suppression("Plugin 'Dstore' registration as a STORAGE ENGINE failed.");
CALL mtr.add_suppression("boot dstore failed, ret=-1");
CALL mtr.add_suppression("Check dstore datadir no exists, startup fail");
--enable_query_log
# Test clone with concurrent DML
--source include/linux.inc
--source include/not_windows.inc
--source include/no_valgrind_without_big.inc
--source include/not_pq_test.inc

--let clone_auto_tune = 1
--source local_dml.test
