# Test remote clone with concurrent DML on compressed row format table

--disable_query_log
CALL mtr.add_suppression("Plugin 'Dstore' init function returned error.");
CALL mtr.add_suppression("Plugin 'Dstore' registration as a STORAGE ENGINE failed.");
--enable_query_log

--source include/have_innodb_max_16k.inc

--let $HOST = 127.0.0.1
--let $PORT =`select @@port`
--let $USER = root
--let remote_clone = 1
--let row_format_compressed = 1

--source local_dml.test
