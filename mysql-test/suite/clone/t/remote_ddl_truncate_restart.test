# Test remote clone error with concurrent DDL and network error restart

--disable_query_log
CALL mtr.add_suppression("Plugin 'Dstore' init function returned error.");
CALL mtr.add_suppression("Plugin 'Dstore' registration as a STORAGE ENGINE failed.");
--enable_query_log

--source include/have_debug.inc
SET global debug="+d,clone_restart_apply";

--source remote_ddl_truncate.test
