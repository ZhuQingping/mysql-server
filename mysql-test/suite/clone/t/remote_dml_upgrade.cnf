# Test remote clone command to replace data directory

[mysqld.1]
server_id=1
rds-load-data-infile-enable=true

[mysqld.2]
server_id=2
rds-load-data-infile-enable=true

[ENV]
SERVER_PORT_1 = @mysqld.1.port
SERVER_SOCK_1 = @mysqld.1.socket

SERVER_PORT_2 = @mysqld.2.port
SERVER_SOCK_2 = @mysqld.2.socket
