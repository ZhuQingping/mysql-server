# Test remote clone with debug sync point to ensure concurrent operation and data in each stages

--disable_query_log
CALL mtr.add_suppression("Plugin 'Dstore' init function returned error.");
CALL mtr.add_suppression("Plugin 'Dstore' registration as a STORAGE ENGINE failed.");
--enable_query_log

--source include/have_debug.inc
SET global debug="+d,clone_restart_apply";

--let $HOST = 127.0.0.1
--let $PORT =`select @@port`
--let $USER = root
--let remote_clone = 1

--source local_stage.test
