# Test remote clone when tablespace file size is increasing in different stages
# This would follow a rollback during recovery

--disable_query_log
CALL mtr.add_suppression("Plugin 'Dstore' init function returned error.");
CALL mtr.add_suppression("Plugin 'Dstore' registration as a STORAGE ENGINE failed.");
--enable_query_log

--let $HOST = 127.0.0.1
--let $PORT =`select @@port`
--let $USER = root
--let remote_clone = 1

--source local_file_extend.test
