#Parallel Index Scan + Ref Access Subquery
create table t1 (a int , b int , c int , index(a,b,c));
insert into t1 values (1,100,1),(2,200,1),(3,300,1),(4,10,2),(5,20,2),(6,30,2),(7,110,3),(8,120,3),(9,130,3),(9,131,1);
create table t2 (a int , b int , c int , index(a,b,c));
insert into t2 values (1,110,1),(2,210,1),(4,20,2),(5,30,2),(7,130,3),(8,140,3);
analyze table t1,t2;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK
explain format=tree select * from t1 where a = (select max(a) from t1 where a > 2) limit 1 offset 1;
EXPLAIN
-> Limit/Offset: 1/1 row(s)  (...)
    -> Gather: 1 workers, parallel scan on t1  (...)
        -> Limit: 2 row(s)  (...)
            -> Parallel covering index lookup on t1 using a (a=(select #2))  (...)
                -> Select #2 (subquery in reference key of index access; run only once)
                    -> Rows fetched before execution  (...)

explain analyze select * from t1 where a = (select max(a) from t1 where a > 2) limit 1 offset 1;
EXPLAIN
-> Limit/Offset: 1/1 row(s)  (...) (actual rows loops)
    -> Gather: 1 workers, parallel scan on t1  (...) (actual rows loops)
        -> Limit: 2 row(s)  (...) (actual rows loops)
            -> Parallel covering index lookup on t1 using a (a=(select #2))  (...) (actual rows loops)
                -> Select #2 (subquery in reference key of index access; run only once)
                    -> Rows fetched before execution  (...) (actual rows loops)

explain format=tree select * from t2 where a = (select max(a) from t1 where t1.a > t2.a) limit 1 offset 1;
EXPLAIN
-> Limit/Offset: 1/1 row(s)  (...)
    -> Gather: 1 workers, parallel scan on t2  (...)
        -> Limit: 2 row(s)  (...)
            -> Filter: (t2.a = (select #2))  (...)
                -> Parallel index scan on t2 using a  (...)
                -> Select #2 (subquery in condition; dependent)
                    -> Aggregate: max(t1.a)  (...)
                        -> Filter: (t1.a > t2.a)  (...)
                            -> Index range scan on t1 (re-planned for each iteration)  (...)

