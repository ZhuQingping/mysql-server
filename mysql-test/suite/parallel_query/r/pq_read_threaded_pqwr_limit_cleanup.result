DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (
id INT PRIMARY KEY,
nullable_i INT NULL,
wide_v VARCHAR(32) NULL,
d DATE NULL
) ENGINE=InnoDB;
INSERT INTO t1 VALUES
(1, 10, 'a', '2024-01-01'),
(2, 20, 'b', '2024-01-02'),
(3, 30, 'c', '2024-01-03'),
(4, 40, 'd', '2024-01-04'),
(5, 50, 'e', '2024-01-05'),
(6, 60, 'f', '2024-01-06'),
(7, 70, 'g', '2024-01-07'),
(8, 80, 'h', '2024-01-08');
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;
SET @pq_executed_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_rows_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_workers_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched');
SET @pqwr_selected_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_selected');
SET @pqwr_rows_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_rows');
SELECT id, nullable_i FROM t1 LIMIT 2 OFFSET 1;
SELECT
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
AS limit_executed_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
AS limit_fallback_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_rows_scanned') - @pq_rows_before
AS limit_rows_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
AS limit_workers_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_selected') -
@pqwr_selected_before AS limit_pqwr_selected_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_rows') -
@pqwr_rows_before AS limit_pqwr_rows_delta;
limit_executed_delta	limit_fallback_delta	limit_rows_delta	limit_workers_delta	limit_pqwr_selected_delta	limit_pqwr_rows_delta
0	0	0	0	0	0
SET @pq_executed_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_rows_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_workers_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched');
SET @pqwr_selected_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_selected');
SET @pqwr_rows_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_rows');
SELECT id, wide_v FROM t1;
id	wide_v
1	a
2	b
3	c
4	d
5	e
6	f
7	g
8	h
SELECT
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
AS followup_executed_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
AS followup_fallback_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_rows_scanned') - @pq_rows_before
AS followup_rows_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
AS followup_workers_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_selected') -
@pqwr_selected_before AS followup_pqwr_selected_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_rows') -
@pqwr_rows_before AS followup_pqwr_rows_delta;
followup_executed_delta	followup_fallback_delta	followup_rows_delta	followup_workers_delta	followup_pqwr_selected_delta	followup_pqwr_rows_delta
1	0	8	2	1	8
SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;
DROP TABLE t1;
