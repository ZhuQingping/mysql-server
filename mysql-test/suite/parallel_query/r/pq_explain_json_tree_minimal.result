DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT PRIMARY KEY, val INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10),(2,20),(3,30);
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;
SET @pq_executed_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback');
EXPLAIN FORMAT=TREE SELECT * FROM t1;
EXPLAIN
-> Table scan on t1, parallel query eligible, execution disabled, serial fallback (dop=2)  (cost=<cost> rows=<rows>)

EXPLAIN FORMAT=JSON SELECT * FROM t1;
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "cost_info": {
      "query_cost": "<cost>"
    },
    "table": {
      "table_name": "t1",
      "access_type": "ALL",
      "rows_examined_per_scan": <rows>,
      "rows_produced_per_join": <rows>,
      "filtered": "100.00",
      "parallel_query": "eligible, execution disabled, serial fallback, dop=2",
      "parallel_query_state": "eligible",
      "cost_info": {
        "read_cost": "<cost>",
        "eval_cost": "<cost>",
        "prefix_cost": "<cost>",
        "data_read_per_join": "<bytes>"
      },
      "used_columns": [
        "id",
        "val"
      ]
    }
  }
}
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`val` AS `val` from `test`.`t1`
EXPLAIN FORMAT=TREE SELECT * FROM t1 ORDER BY val;
EXPLAIN
-> Sort: t1.val  (cost=<cost> rows=<rows>)
    -> Table scan on t1, not parallel (HAS_ORDER_BY)  (cost=<cost> rows=<rows>)

SELECT
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed') -
@pq_executed_before AS explain_executed_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback') -
@pq_fallback_before AS explain_fallback_delta;
explain_executed_delta	explain_fallback_delta
0	0
SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;
DROP TABLE t1;
