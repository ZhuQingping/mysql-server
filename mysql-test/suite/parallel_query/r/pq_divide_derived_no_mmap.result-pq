create database pq_test;
use pq_test;
SET @@optimizer_switch="derived_merge=off,derived_condition_pushdown=off";
create table t1(
id int primary key auto_increment,
col1 varchar(100),
col2 int
)engine= innodb;
show variables like 'force_parallel_execute';
Variable_name	Value
force_parallel_execute	ON
flush status;
select @@internal_tmp_mem_storage_engine;
@@internal_tmp_mem_storage_engine
TempTable
select @@global.temptable_max_ram, @@global.temptable_use_mmap;
@@global.temptable_max_ram	@@global.temptable_use_mmap
2097152	0
SELECT count_alloc > 0
FROM performance_schema.memory_summary_global_by_event_name
WHERE event_name = 'memory/temptable/physical_disk';
count_alloc > 0
0
explain select sum(prod) from (select t1.id*t2.id as prod from t1, t1 as t2, t1 as t3) as derived;
