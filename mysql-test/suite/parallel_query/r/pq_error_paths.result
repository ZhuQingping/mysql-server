SET SESSION transaction_isolation='SERIALIZABLE';
EXPLAIN SELECT * FROM t1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	5	100.00	Not parallel SERIALIZABLE
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`val` AS `val` from `test`.`t1`
SET SESSION transaction_isolation='REPEATABLE-READ';
SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
