SELECT
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed') - @executed_before
AS executed_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched') - @workers_before
AS workers_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_ranges_built') - @ranges_built_before
AS ranges_built_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_ranges_dispatched') -
@ranges_dispatched_before
AS ranges_dispatched_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_secondary_rows_produced') -
@secondary_rows_produced_runtime_before
AS secondary_rows_produced_runtime_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_secondary_rows_materialized_smoke') -
@secondary_rows_materialized_runtime_before
AS secondary_rows_materialized_runtime_delta;
executed_delta	workers_delta	ranges_built_delta	ranges_dispatched_delta	secondary_rows_produced_runtime_delta	secondary_rows_materialized_runtime_delta
