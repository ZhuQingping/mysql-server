(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed') -
@f4_min_executed_before
AS f4_min_executed_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched') -
@f4_min_workers_before
AS f4_min_workers_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_ranges_built') -
@f4_min_ranges_built_before
AS f4_min_ranges_built_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_ranges_dispatched') -
@f4_min_ranges_dispatched_before
AS f4_min_ranges_dispatched_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_secondary_rows_produced') -
@f4_min_secondary_rows_before
AS f4_min_secondary_rows_delta,
((SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_opt_sum_minmax_shortcut_probe_attempts') -
@f4_min_shortcut_attempts_before) >= 3
AS f4_min_shortcut_attempts_seen,
((SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_opt_sum_minmax_shortcut_probe_success') -
@f4_min_shortcut_success_before) >= 2
AS f4_min_shortcut_success_seen,
((SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_opt_sum_minmax_shortcut_probe_empty') -
@f4_min_shortcut_empty_before) >= 1
AS f4_min_shortcut_empty_seen;
f4_min_executed_delta	f4_min_workers_delta	f4_min_ranges_built_delta	f4_min_ranges_dispatched_delta	f4_min_secondary_rows_delta	f4_min_shortcut_attempts_seen	f4_min_shortcut_success_seen	f4_min_shortcut_empty_seen
0	0	0	0	0	1	1	1
