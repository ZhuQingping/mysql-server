DROP TABLE IF EXISTS pq_ref_icp_t1, pq_ref_icp_t2, pq_ref_icp_t3,
pq_ref_icp_t4, pq_ref_icp_mvi, pq_ref_icp_part,
pq_ref_icp_mvi_outer, pq_ref_icp_rev, pq_ref_icp_min,
pq_ref_icp_blob;
CREATE TABLE pq_ref_icp_t1 (
id INT PRIMARY KEY,
k INT NOT NULL,
v INT NOT NULL,
pad CHAR(8),
KEY k_idx(k),
KEY k_v_idx(k, v),
KEY k_pad_idx(k, pad)
) ENGINE=InnoDB;
CREATE TABLE pq_ref_icp_t2 (
id INT PRIMARY KEY,
k INT NOT NULL,
KEY k_idx(k)
) ENGINE=InnoDB;
CREATE TABLE pq_ref_icp_t3 (
id INT PRIMARY KEY,
k INT NOT NULL,
KEY k_idx(k)
) ENGINE=InnoDB;
CREATE TABLE pq_ref_icp_t4 (
id INT PRIMARY KEY,
k INT NOT NULL,
icp_col INT NOT NULL,
payload INT NOT NULL,
KEY k_icp_idx(k, icp_col)
) ENGINE=InnoDB;
CREATE TABLE pq_ref_icp_mvi (
id INT PRIMARY KEY,
doc_id INT NOT NULL,
b INT NOT NULL,
doc JSON,
KEY mv_doc_id_b (
doc_id,
b,
(CAST(JSON_EXTRACT(doc, '$.val') AS UNSIGNED ARRAY)))
) ENGINE=InnoDB;
CREATE TABLE pq_ref_icp_part (
id INT NOT NULL,
k INT NOT NULL,
KEY k_idx(k)
) ENGINE=InnoDB
PARTITION BY HASH(id) PARTITIONS 2;
CREATE TABLE pq_ref_icp_mvi_outer (
id INT PRIMARY KEY,
doc_id INT NOT NULL,
b INT NOT NULL
) ENGINE=InnoDB;
CREATE TABLE pq_ref_icp_rev (
id INT PRIMARY KEY,
k INT NOT NULL,
KEY k_idx(k)
) ENGINE=InnoDB;
CREATE TABLE pq_ref_icp_min (
id INT PRIMARY KEY,
i INT NOT NULL,
j INT NOT NULL,
KEY j_idx(j)
) ENGINE=InnoDB;
CREATE TABLE pq_ref_icp_blob (
id INT PRIMARY KEY,
k INT NOT NULL,
payload BLOB,
KEY k_idx(k)
) ENGINE=InnoDB;
