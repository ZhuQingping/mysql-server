DROP TABLE IF EXISTS pq_ref_icp_t1, pq_ref_icp_t2, pq_ref_icp_t3;
CREATE TABLE pq_ref_icp_t1 (
id INT PRIMARY KEY,
k INT NOT NULL,
v INT NOT NULL,
pad CHAR(8),
KEY k_idx(k),
KEY k_v_idx(k, v),
KEY k_pad_idx(k, pad)
) ENGINE=InnoDB;
CREATE TABLE pq_ref_icp_t2 (
id INT PRIMARY KEY,
k INT NOT NULL,
KEY k_idx(k)
) ENGINE=InnoDB;
CREATE TABLE pq_ref_icp_t3 (
id INT PRIMARY KEY,
k INT NOT NULL,
KEY k_idx(k)
) ENGINE=InnoDB;
