AS secondary_rows_produced_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_secondary_rows_materialized_smoke') -
@secondary_rows_materialized_smoke_before
AS secondary_rows_materialized_smoke_delta,
(SELECT CAST(variable_value AS UNSIGNED)
