SELECT
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed') - @d1_executed_before
AS d1_dependent_ref_executed_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched') - @d1_workers_before
AS d1_dependent_ref_workers_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_ranges_built') - @d1_ranges_built_before
AS d1_dependent_ref_ranges_built_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_ranges_dispatched') -
@d1_ranges_dispatched_before
AS d1_dependent_ref_ranges_dispatched_delta,
(SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_secondary_rows_produced') -
@d1_secondary_rows_produced_before
AS d1_dependent_ref_secondary_rows_delta;
d1_dependent_ref_executed_delta	d1_dependent_ref_workers_delta	d1_dependent_ref_ranges_built_delta	d1_dependent_ref_ranges_dispatched_delta	d1_dependent_ref_secondary_rows_delta
