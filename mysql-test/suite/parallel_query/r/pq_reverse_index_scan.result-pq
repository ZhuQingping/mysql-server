#
#BUG2022102503204 Wrong group merge when using a reverse_sorted index
#
create table t1 (a int, b int, c int, key(a desc, b asc, c desc));
create table t2 (d int, key(d asc));
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `a` int DEFAULT NULL,
  `b` int DEFAULT NULL,
  `c` int DEFAULT NULL,
  KEY `a` (`a` DESC,`b`,`c` DESC)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK
# Test reverse_sorted using index prefix
explain format=tree select sum(a), a from t1 group by a;
EXPLAIN
-> Group aggregate: sum(`<temporary>`.`sum(a)`)  (...)
    -> Gather: 4 workers, parallel scan on t1  (...)
        -> Group aggregate: sum(`<temporary>`.`sum(a)`)  (...)
            -> Parallel index scan on t1 using a  (...)

explain format=tree select/*+NO_PQ*/ sum(a), a from t1 group by a;
EXPLAIN
-> Group aggregate: sum(t1.a)  (...)
    -> Index scan on t1 using a  (...)

select sum(a), a from t1 group by a;
sum(a)	a
625	5
500	4
375	3
250	2
125	1
select/*+NO_PQ*/ sum(a), a from t1 group by a;
sum(a)	a
625	5
500	4
375	3
250	2
125	1
# Test reverse_sorted index not using index prefix (use temptable)
explain format=tree select sum(c), c from t1 group by c;
EXPLAIN
-> Table scan on <temporary>
    -> Aggregate using temporary table
        -> Gather: 4 workers, parallel scan on t1  (...)
            -> Table scan on <temporary>
                -> Aggregate using temporary table
                    -> Parallel index scan on t1 using a  (...)

explain format=tree select/*+NO_PQ*/ sum(c), c from t1 group by c;
EXPLAIN
-> Table scan on <temporary>
    -> Aggregate using temporary table
        -> Index scan on t1 using a  (...)

# Test reverse_sorted index with two key_part(prefix of key)
explain format=tree select sum(a+b), a, b from t1 group by a,b;
EXPLAIN
-> Group aggregate: sum(`<temporary>`.`sum(a+b)`)  (...)
    -> Gather: 4 workers, parallel scan on t1  (...)
        -> Group aggregate: sum(`<temporary>`.`sum(a+b)`)  (...)
            -> Parallel index scan on t1 using a  (...)

explain format=tree select/*+NO_PQ*/ sum(a+b), a, b from t1 group by a,b;
EXPLAIN
-> Group aggregate: sum((t1.a + t1.b))  (...)
    -> Index scan on t1 using a  (...)

