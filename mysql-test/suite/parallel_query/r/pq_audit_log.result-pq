INSTALL PLUGIN audit_log SONAME 'audit_log.so';
create table t1(id int);
create table t2(id int);
# connect 1
SET parallel_default_dop=64;
select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;
id	id
explain select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	<gather1>	NULL	ALL	NULL	NULL	NULL	NULL	1	100.00	Parallel execute (64 workers, test.t2)
1	SIMPLE	t2	NULL	ALL	NULL	NULL	NULL	NULL	1	100.00	Using temporary; Using filesort
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	1	100.00	Using where; Using join buffer (hash join)
