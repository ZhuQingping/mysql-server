DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT PRIMARY KEY, val INT, name VARCHAR(32)) ENGINE=InnoDB;
INSERT INTO t1 VALUES
(1,10,'a'),(2,10,'b'),(3,20,'c'),(4,20,'d'),(5,30,'e');
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
EXPLAIN SELECT val, COUNT(*) FROM t1 GROUP BY val;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	5	100.00	Using temporary; Not parallel GROUP_BY_PARTIAL_AGG_UNSUPPORTED
EXPLAIN SELECT val, COUNT(*) FROM t1 GROUP BY val HAVING COUNT(*) > 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	5	100.00	Using temporary; Not parallel GROUP_BY_HAVING
EXPLAIN SELECT val, COUNT(*) FROM t1 GROUP BY val WITH ROLLUP;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	5	100.00	Using filesort; Not parallel GROUP_BY_ROLLUP
EXPLAIN SELECT val + 1, COUNT(*) FROM t1 GROUP BY val + 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	5	100.00	Using temporary; Not parallel GROUP_BY_UNSUPPORTED_EXPR
EXPLAIN SELECT val, GROUP_CONCAT(name) FROM t1 GROUP BY val;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	5	100.00	Using filesort; Not parallel GROUP_BY_UNSUPPORTED_AGGREGATE
SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
DROP TABLE t1;
