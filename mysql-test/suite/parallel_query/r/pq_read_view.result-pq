# fix pq crash when pq worker copy read_view
CREATE TABLE `t1` (`blob_col` blob);
explain format=tree SELECT /*+ PQ(vtb) no_bnl() */ vtb.id_col FROM (VALUES ROW(1,3,5), ROW(2,4,6) order by 1,2,3 limit 1 offset 1) AS vtb(id_col,int_col,big_int_col) JOIN t1 B on true;
