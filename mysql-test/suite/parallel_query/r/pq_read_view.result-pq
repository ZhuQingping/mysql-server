# The first worker will not fetch any record from "const_table" while the second worker
# read all records. However, the second worker can see the new inserted value (2) in t1.
# This is unreasonable and will cause inconsistent read.
SET @saved_parallel_dop= @@parallel_default_dop;
SET @save_optimizer_switch= @@optimizer_switch;
set optimizer_switch='block_nested_loop=off';
set GLOBAL debug="+d, pq_skip_fetch_ctx";
SET parallel_default_dop=2;
create table t1 (id int);
insert into t1 values (0), (1);
EXPLAIN FORMAT=tree SELECT /*+PQ(const_table) */ t1.id FROM t1 JOIN (VALUES ROW(4), ROW(5), ROW(6), ROW(7)) AS const_table(a) ON TRUE;
EXPLAIN
-> Gather: 2 workers, parallel scan on const_table  (cost=3.4 rows=8)
    -> Nested loop inner join  (cost=3.4 rows=4)
        -> Table scan on t1  (cost=0.45 rows=2)
        -> Parallel table scan on const_table  (cost=1.66..2.92 rows=2)
            -> Materialize  (cost=0.4..0.4 rows=4)
                -> Rows fetched before execution  (cost=0..0 rows=4)

SET DEBUG_SYNC='pq_launch_worker_1 SIGNAL ready WAIT_FOR insert_data';
SELECT /*+PQ(const_table) */ t1.id FROM t1 JOIN (VALUES ROW(4), ROW(5), ROW(6), ROW(7)) AS const_table(a) ON TRUE;
SET DEBUG_SYNC='now WAIT_FOR ready';
INSERT INTO t1 VALUES (2);
SET DEBUG_SYNC='now SIGNAL insert_data';
id
0
0
0
0
1
