# BUG2023021603940 PQ assertion crash during transaction
SET SESSION FORCE_PARALLEL_EXECUTE = 1;
SET SESSION PARALLEL_COST_THRESHOLD = 0;
SET SESSION PARALLEL_ROWS_THRESHOLD = 0;
SET SESSION OPTIMIZER_SWITCH = 'subquery_to_derived=on';
CREATE TABLE t0 (c0 BOOLEAN);
START TRANSACTION;
DELETE FROM t0;
SELECT 1 FROM (SELECT 2) t0(c0);
