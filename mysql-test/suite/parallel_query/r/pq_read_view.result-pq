1
SET GLOBAL debug="-d, pq_skip_fetch_ctx";
SET parallel_default_dop=@saved_parallel_dop;
DROP table t1;
# when the outer query of derived table only contains one tmp table,
# the cloned snapshot may be not freed and thus leading to memory leak.
