DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT PRIMARY KEY, val INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10),(2,20),(3,30),(4,40),(5,50);
SELECT COUNT(*) FROM (
SELECT variable_name FROM performance_schema.global_status
WHERE variable_name LIKE 'Parallel%'
) AS pq_vars;
COUNT(*)
13
SELECT variable_name FROM performance_schema.global_status
WHERE variable_name LIKE 'Parallel%'
  ORDER BY variable_name;
variable_name
Parallel_callback_smoke_attempts
Parallel_callback_smoke_rows
Parallel_exchange_smoke_finishes
Parallel_exchange_smoke_rows
Parallel_queries_executed
Parallel_queries_fallback
Parallel_ranges_built
Parallel_rows_scanned
Parallel_worker_handler_smoke_runs
Parallel_worker_open_smoke_runs
Parallel_worker_producer_smoke_runs
Parallel_worker_smoke_runs
Parallel_workers_launched
SELECT COUNT(*) AS numeric_parallel_status_vars
FROM performance_schema.global_status
WHERE variable_name LIKE 'Parallel%'
    AND variable_value REGEXP '^[0-9]+$';
numeric_parallel_status_vars
13
SET @pq_executed_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_rows_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_workers_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched');
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
EXPLAIN SELECT * FROM t1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	5	100.00	Parallel query eligible, execution disabled, serial fallback, dop=4
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`val` AS `val` from `test`.`t1`
SET @pq_fallback_after_explain = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback');
SELECT @pq_fallback_after_explain - @pq_fallback_before AS fallback_delta;
