SELECT
((SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_worker_void_pull_success') -
@void_pull_success_before) =
((SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_worker_void_pull_cleanup') -
@void_pull_cleanup_before) AS cleanup_matches_success;
