explain format=tree select
ref_0.c_w_id as c0
from
t0_sub_1 as ref_0
inner join t4 as ref_1
where (EXISTS (
select
ref_1.c_street_1 as c0
from
tx_cmplx_006 as ref_11,
lateral (select
ref_0.c_d_id as c0
from
(SELECT 1 AS c1, ref_0.c_middle AS c2
FROM t4 ref_1
LEFT JOIN t4 ON ref_0.c_middle = ref_1.c_credit
WHERE 1 IS NOT NULL) as ref_12
where (ref_12.c2 is NULL)
) as subq_3)
)
or (ref_1.c_credit_lim is not NULL) limit 10;
EXPLAIN
-> Limit: 10 row(s)  (...)
    -> Gather: 4 workers, parallel scan on ref_1, t0  (...)
        -> Limit: 10 row(s)  (...)
            -> Filter: (exists(select #2) or (ref_1.c_credit_lim is not null))  (...)
                -> Inner hash join, hash table shared by worker threads (no condition)  (...)
                    -> Filter: ((t0.c_id = 1) or (t0.c_d_id = 2) or (t0.c_w_id = 3))  (...)
                        -> Parallel table scan on t0  (...)
                    -> Hash
                        -> Parallel index scan on ref_1 using ndx_4_7_9_13_15_19  (...)
                -> Select #2 (subquery in condition; dependent)
                    -> Result cache : cache keys(ref_1.c_street_1, t0.c_middle)
                        -> Limit: 1 row(s)  (...)
                            -> Inner hash join, one hash table per worker (no condition)  (...)
                                -> Table scan on ref_11  (...)
                                    -> Materialize  (...)
                                        -> Table scan on <temporary>  (...)
                                            -> Temporary table with deduplication  (...)
                                                -> Gather: 4 workers, parallel scan on ref_0  (...)
                                                    -> Table scan on <temporary>  (...)
                                                        -> Temporary table with deduplication  (...)
                                                            -> Nested loop left join  (...)
                                                                -> Parallel index range scan on ref_0 using ndx_C_YTD_PAYMENT over (NULL < C_YTD_PAYMENT), with index condition: (ref_0.C_YTD_PAYMENT is not null)  (...)
                                                                -> Nested loop left join  (...)
                                                                    -> Nested loop inner join  (...)
                                                                        -> Zero rows (Impossible filter)  (...)
                                                                        -> Index scan on ref_3 using ndx_C_BIT  (...)
                                                                    -> Result cache : cache keys(ref_0.C_BIT, ref_0.C_YTD_PAYMENT, ref_3.C_ID)  (...)
                                                                        -> Single-row covering index lookup on ref_2 using PRIMARY (id_col=ref_3.C_ID)  (...)
                                -> Hash
                                    -> Left hash join, one hash table per worker (no condition), extra conditions: (t0.c_middle = ref_1.c_credit)  (...)
                                        -> Filter: (t0.c_middle is null)  (...)
                                            -> Index scan on ref_1 using ndx_c_credit  (...)
                                        -> Hash
                                            -> Index scan on t4 using ndx_c_id  (...)

