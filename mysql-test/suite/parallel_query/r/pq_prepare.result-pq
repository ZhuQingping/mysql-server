-> Group (no aggregates)
    -> Gather: 4 workers, parallel scan on subq_0
        -> Group (no aggregates)  (...)
            -> Parallel table scan on subq_0  (...)
                -> Materialize  (...)
                    -> Gather: 4 workers, parallel scan on ref_1, ref_0
                        -> Left hash join, hash table shared by worker threads (no condition)  (...)
                            -> Inner hash join, one hash table per worker (no condition)  (...)
                                -> Table scan on ref_2  (...)
                                    -> Materialize  (...)
                                        -> Sort: subq_0.c2, c3
                                            -> Table scan on <temporary>  (...)
                                                -> Temporary table with deduplication  (...)
                                                    -> Gather: 4 workers, parallel scan on subq_0  (...)
                                                        -> Table scan on <temporary>  (...)
                                                            -> Temporary table with deduplication  (...)
                                                                -> Parallel table scan on subq_0  (...)
                                                                    -> Materialize  (...)
                                                                        -> Gather: 4 workers, parallel scan on ref_0  (...)
                                                                            -> Parallel table scan on ref_0  (...)
                                -> Hash
                                    -> Parallel table scan on ref_0  (...)
                                        -> Materialize  (...)
                                            -> Sort: subq_0.c2, c3
                                                -> Table scan on <temporary>  (...)
                                                    -> Temporary table with deduplication  (...)
                                                        -> Gather: 4 workers, parallel scan on subq_0  (...)
                                                            -> Table scan on <temporary>  (...)
                                                                -> Temporary table with deduplication  (...)
                                                                    -> Parallel table scan on subq_0  (...)
                                                                        -> Materialize  (...)
                                                                            -> Gather: 4 workers, parallel scan on ref_0  (...)
                                                                                -> Filter: (ref_0.C_BIT is null)  (...)
                                                                                    -> Parallel table scan on ref_0  (...)
                            -> Hash
                                -> Parallel index scan on ref_1 using ndx_c_first  (...)

select
40 as c0
from
(select
ref_0.c1 as c0,
ref_2.c3 as c1,
pi() as c2
from
tx_cmplx_004 as ref_0
inner join t1 as ref_1
right join tx_cmplx_004 as ref_2
on (true)
on ((((ref_1.c_first is NULL)
and (ref_2.c3 is NULL))
and ((ref_2.c2 is not NULL)
or (false)))
or (true))
where (pi() is not NULL)
and (ref_0.c1 is NULL)
) as subq_0
where true
group by 1
order by 1;
