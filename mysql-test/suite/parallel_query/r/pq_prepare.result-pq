#Item's used_table_cache in leader is optimized to zero after prepare, making
#leader skips to build the field in tmp table. While worker has cloned the
#value in prepare phase and thus needs to create field in tmp table. Finally,
#leader and worker generate different tmp table.
explain format=tree select
subq_2.c12 as c0,
subq_2.c5 as c1
from
(select
ref_2.bool_col as c5,
abs(ref_2.id_col) as c12
from
(select
1 as c0
from
t11 as ref_1
where ref_1.C_CREDIT is NULL
) as subq_1
inner join t2 as ref_2
on (subq_1.c0 = ref_2.id_col )
) as subq_2
group by 1,2;
EXPLAIN
-> Group (no aggregates)  (...)
    -> Gather: 4 workers, parallel scan on ref_1  (...)
        -> Group (no aggregates)  (...)
            -> Filter: (ref_1.C_CREDIT is null)  (...)
                -> Parallel covering index lookup on ref_1 using ndx_C_CREDIT (C_CREDIT=NULL)  (...)

