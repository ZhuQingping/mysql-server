create view t0_range_key_subpartition_sub_view as select * from t0_range_key_subpartition where c_d_id < 15 and c_w_id=2 union all select * from t0_range_key_subpartition where c_d_id > 15 and c_d_id<30 and c_w_id=1 union all select * from t0_range_key_subpartition where c_d_id > 30 and  c_d_id<50 and c_w_id=1;
create view t0_hash_partition_p1_view  as select * from t0_hash_partition_p1;
create view t0_partition_sub_view_mixed_001 as select * from t0_range_partition where c_d_id <15 Union all select * from t0_list_partition where c_w_id in (0,2) union all select * from t0_key_partition where c_w_id = 4 union all select * from t0_linear_hash_partition where c_w_id = 5 union select * from t0_hash_partition where c_w_id =8;
#BUG2021081001512: the view query is located into one outer query that is optimized to
#produce zero-result, then we have not set the shared structure of view, leading to
#the coredump when creating access path.
explain format=tree select
ref_12.c_delivery_cnt AS c0
FROM   (SELECT sub_1.id as c13
FROM   t0_sub_1 AS ref_0
LEFT JOIN  (select 1 from t0_sub_1 inner join t0_sub_union as ref_1 on (false)) AS sub_1(id)
ON ( false )
WHERE  ref_0.c_id IS NOT NULL) AS subq_0
LEFT JOIN (SELECT ref_2.c_credit AS c0
FROM   t0_hash_partition_p1 AS ref_2
LEFT JOIN t0_hash_partition_p1 AS ref_3
ON ( Pi() IS NOT NULL )) AS subq_2
LEFT JOIN t0_sub_union AS ref_11
RIGHT JOIN t0_hash_partition_p1 AS ref_12
ON ( ( ( true )
AND ( ref_12.c_discount IS NULL ) )
AND ( false ) )
ON ( true )
ON ( ( ref_11.c_street_1 IS NOT NULL )
AND ( ref_11.c_w_id IS NULL ) )
WHERE  ( subq_0.c13 IS NULL )
GROUP  BY 1
ORDER  BY 1;
EXPLAIN
-> Sort: ref_12.c_delivery_cnt
    -> Table scan on <temporary>  (...)
        -> Temporary table with deduplication  (...)
            -> Nested loop left join  (...)
                -> Filter: (1 is null)  (...)
                    -> Nested loop left join  (...)
                        -> Filter: ((t0.c_id = 1) or (t0.c_d_id = 2) or (t0.c_w_id = 3))  (...)
                            -> Index scan on t0 using PRIMARY  (...)
                        -> Nested loop inner join  (...)
                            -> Zero rows (Impossible filter)  (...)
                            -> Table scan on ref_1  (...)
                                -> Union materialize with deduplication  (...)
                                    -> Gather: 4 workers, parallel scan on t0  (...)
                                        -> Parallel table scan on t0  (...)
                                    -> Gather: 4 workers, parallel scan on t0  (...)
                                        -> Filter: ((t0.c_id = 1) or (t0.c_d_id = 2) or (t0.c_w_id = 3))  (...)
                                            -> Parallel table scan on t0  (...)
                -> Nested loop inner join  (...)
                    -> Nested loop left join  (...)
                        -> Nested loop inner join  (...)
                            -> Zero rows (Impossible filter)  (...)
                            -> Index scan on ref_2 using ndx_c_discount  (...)
                        -> Index scan on ref_3 using ndx_c_discount  (...)
                    -> Table scan on ref_11  (...)
                        -> Union materialize with deduplication  (...)
                            -> Gather: 4 workers, parallel scan on t0  (...)
                                -> Parallel table scan on t0  (...)
                            -> Gather: 4 workers, parallel scan on t0  (...)
                                -> Filter: ((t0.c_id = 1) or (t0.c_d_id = 2) or (t0.c_w_id = 3))  (...)
                                    -> Parallel table scan on t0  (...)

select
ref_12.c_delivery_cnt AS c0
FROM   (SELECT sub_1.id as c13
FROM   t0_sub_1 AS ref_0
LEFT JOIN  (select 1 from t0_sub_1 inner join t0_sub_union as ref_1 on (false)) AS sub_1(id)
ON ( false )
WHERE  ref_0.c_id IS NOT NULL) AS subq_0
LEFT JOIN (SELECT ref_2.c_credit AS c0
FROM   t0_hash_partition_p1 AS ref_2
LEFT JOIN t0_hash_partition_p1 AS ref_3
ON ( Pi() IS NOT NULL )) AS subq_2
LEFT JOIN t0_sub_union AS ref_11
RIGHT JOIN t0_hash_partition_p1 AS ref_12
ON ( ( ( true )
AND ( ref_12.c_discount IS NULL ) )
AND ( false ) )
ON ( true )
ON ( ( ref_11.c_street_1 IS NOT NULL )
AND ( ref_11.c_w_id IS NULL ) )
WHERE  ( subq_0.c13 IS NULL )
GROUP  BY 1
ORDER  BY 1;
c0
NULL
#BUG2021080901230: reset NULL row flag will lead hash join read
#uncorrect data which should be a NULL-complemented row after
#re-fill hash table.
SET @save_join_buffer_size = @@join_buffer_size;
SET @@join_buffer_size = 16384;
EXPLAIN FORMAT=tree SELECT /*+ JOIN_ORDER(ref_4, t0) */ ref_6.c0 AS c1, ref_5.c_since AS c3 FROM t5 AS ref_4 RIGHT JOIN t0 AS ref_5 RIGHT JOIN tx_cmplx_005 AS ref_6 ON (ref_5.c_city = ref_6.c0) ON (true) INNER JOIN t0_sub_1 AS ref_15 ON (true) LIMIT 47486, 3;
EXPLAIN
-> Limit/Offset: 3/47486 row(s)  (...)
    -> Gather: 4 workers, parallel scan on ref_0, t0  (...)
        -> Limit: 47489 row(s)  (...)
            -> Inner hash join, hash table shared by worker threads (no condition)  (...)
                -> Filter: ((t0.c_id = 1) or (t0.c_d_id = 2) or (t0.c_w_id = 3))  (...)
                    -> Parallel index scan on t0 using PRIMARY  (...)
                -> Hash
                    -> Left hash join, one hash table per worker (no condition)  (...)
