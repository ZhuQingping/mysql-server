from
t12 as ref_1
inner join t2 as ref_2
right join t10 as ref_3
on (ref_2.id_col = ref_3.C_ID )
on true
where false
) as subq_1
on (false)
group by 1,2;
#BUG2021080502707: when view is included into lateral dependent subquery,
#the first_inner_table in Item_view_ref may be referred to the table in
#the lateral query, thus we should disable this view in parallel query.
