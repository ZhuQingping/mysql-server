explain format=tree select
subq_0.c0 AS c0, subq_0.c6 AS c1, subq_0.c3 AS c2, subq_0.c2 AS c3
FROM (
SELECT ref_0.c_discount AS c0, ref_0.c_credit_lim AS c1, 26 AS c2, ref_0.c_credit AS c3, ref_0.c_balance AS c4
, pi() AS c5, ref_0.c_city AS c6, ref_0.c_since AS c7, ref_0.c_id AS c8
FROM t4 ref_0
WHERE ref_0.c_w_id IS NOT NULL
OR (false
AND false)
) subq_0
WHERE subq_0.c0 IS NOT NULL
GROUP BY 1, 2, 3, 4
ORDER BY 1, 2, 3, 4;
EXPLAIN
-> Sort: subq_0.c0, subq_0.c1, subq_0.c2
    -> Table scan on <temporary>  (...)
        -> Temporary table with deduplication  (...)
            -> Gather: 4 workers, parallel scan on ref_0  (...)
                -> Table scan on <temporary>  (...)
                    -> Temporary table with deduplication  (...)
                        -> Parallel index range scan on ref_0 using ndx_c_discount over (NULL < c_discount), with index condition: (ref_0.c_discount is not null)  (...)

