BUG2022022401743: table subq_0 contains two columns c1 and c2, while
we alias subq_0.c2 as c1. When the query contains group by c2, PQ worker
resolves to error column.
EXPLAIN FORMAT=tree SELECT
subq_0.c2 AS c1,
subq_0.c2 AS c2,
(CASE
WHEN false THEN subq_0.c1
ELSE subq_0.c1
end ) AS c3
FROM (SELECT ref_0.c_street_2 AS c1,
ref_0.c_bit AS c2
FROM   t10 ref_0) subq_0
GROUP BY
subq_0.c2,
subq_0.c2,
(CASE
WHEN false THEN subq_0.c1
ELSE subq_0.c1
end)
ORDER BY
subq_0.c2,
subq_0.c2,
(CASE
WHEN false THEN subq_0.c1
ELSE subq_0.c1
end);
EXPLAIN
-> Sort: subq_0.c2, c3
    -> Table scan on <temporary>  (...)
        -> Temporary table with deduplication  (...)
            -> Gather: 4 workers, parallel scan on subq_0  (...)
                -> Table scan on <temporary>  (...)
                    -> Temporary table with deduplication  (...)
                        -> Parallel table scan on subq_0  (...)
                            -> Materialize  (...)
                                -> Gather: 4 workers, parallel scan on ref_0  (...)
                                    -> Parallel table scan on ref_0  (...)

SELECT
subq_0.c2 AS c1,
subq_0.c2 AS c2,
(CASE
WHEN false THEN subq_0.c1
ELSE subq_0.c1
end ) AS c3
FROM (SELECT ref_0.c_street_2 AS c1,
ref_0.c_bit AS c2
FROM   t10 ref_0) subq_0
GROUP BY
subq_0.c2,
subq_0.c2,
(CASE
WHEN false THEN subq_0.c1
ELSE subq_0.c1
end)
ORDER BY
subq_0.c2,
subq_0.c2,
(CASE
WHEN false THEN subq_0.c1
ELSE subq_0.c1
end);
c1	c2	c3
NULL	NULL	NULL
EXPLAIN FORMAT=tree select
40 as c0
from
(select
ref_0.c1 as c0,
ref_2.c3 as c1,
pi() as c2
from
tx_cmplx_004 as ref_0
inner join t1 as ref_1
right join tx_cmplx_004 as ref_2
on (true)
on ((((ref_1.c_first is NULL)
and (ref_2.c3 is NULL))
and ((ref_2.c2 is not NULL)
or (false)))
or (true))
where (pi() is not NULL)
and (ref_0.c1 is NULL)
) as subq_0
where true
group by 1
order by 1;
