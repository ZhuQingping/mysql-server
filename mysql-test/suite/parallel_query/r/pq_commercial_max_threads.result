DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT PRIMARY KEY, val INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10),(2,20),(3,30),(4,40);
SET @saved_parallel_max_threads = @@global.parallel_max_threads;
SELECT @@global.parallel_max_threads;
@@global.parallel_max_threads
64
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET GLOBAL parallel_max_threads=2;
SET SESSION parallel_default_dop=3;
EXPLAIN SELECT COUNT(*), SUM(val) FROM t1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	4	100.00	Not parallel DOP_EXCEEDS_THREAD_BUDGET
Warnings:
Note	1003	/* select#1 */ select count(0) AS `COUNT(*)`,sum(`test`.`t1`.`val`) AS `SUM(val)` from `test`.`t1`
EXPLAIN FORMAT=TREE SELECT COUNT(*), SUM(val) FROM t1;
EXPLAIN
-> Aggregate: count(0), sum(t1.val)  (cost=<cost> rows=<rows>)
