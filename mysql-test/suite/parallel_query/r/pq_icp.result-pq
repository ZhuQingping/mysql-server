CREATE TABLE `proschedule` (
`OID` varchar(40) NOT NULL,
`DISTRIBUTECODE` varchar(40) NOT NULL,
`DISTRIBUTEROWNO` varchar(40) NOT NULL,
`COMPANYID` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci DEFAULT NULL,
`FACTORYID` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci DEFAULT NULL,
`VENDORID` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci DEFAULT NULL,
`ITEMID` varchar(40) DEFAULT NULL,
`DISTRIBUTEQTY` decimal(65,30) NOT NULL,
`ASNQTY` decimal(65,30) NOT NULL DEFAULT '0.000000000000000000000000000000',
`DISTRIBUTEUNIT` varchar(40) NOT NULL,
`DISTRIBUTEDATE` datetime(6) DEFAULT NULL,
`CONFIRMSTATUS` decimal(38,0) NOT NULL DEFAULT '0',
`INVENTORY` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`LOCATION` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`RESERVENO` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`RESERVEITEM` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`OUTSOURCINGNO` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`OUTSOURCINGBATCHNO` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`PROCUREMENTCERTCODE` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`PROCUREMENTCERTID` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`DISTRIBUTECOMMANDSTATUS` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`DISTRIBUTECOMMANDTYPE` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`DISTRIBUTETYPE` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`DISTRIBUTEAREATYPE` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`DISTRIBUTEAREA` varchar(80) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`RESERVEPRODUCECODE` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`RESERVEWBSCODE` varchar(40) CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL DEFAULT ' ',
`SAPCDATE` datetime(6) DEFAULT NULL,
`SAPMDATE` datetime(6) DEFAULT NULL,
`CUSER` varchar(40) NOT NULL,
`CDATE` datetime(6) DEFAULT NULL,
`MUSER` varchar(40) NOT NULL,
`MDATE` datetime(6) DEFAULT NULL,
`SAPQTY` decimal(65,30) NOT NULL DEFAULT '0.000000000000000000000000000000',
`PRODUCTIONBATCH` varchar(40) DEFAULT NULL,
`PRODUCTIONDATE` datetime(6) DEFAULT NULL,
`MANUFACTURER` varchar(100) DEFAULT NULL,
`INVENTORYNAME` varchar(100) DEFAULT NULL,
`PRODQTY` decimal(28,2) DEFAULT NULL COMMENT '加工单数量(父件数量)',
`MAINCODE` varchar(47) DEFAULT NULL COMMENT '父件号',
`VENDORNAMEERP` varchar(100) DEFAULT NULL,
`ITEMNAMEERP` varchar(100) DEFAULT NULL,
`EFFECTUNIT` varchar(40) DEFAULT NULL COMMENT '有效单元',
`WORKCENTER` varchar(40) DEFAULT NULL COMMENT '工作中心',
`WORKPROCESS` varchar(40) DEFAULT NULL COMMENT '工位',
`WORKLINE` varchar(40) DEFAULT NULL COMMENT '生产线',
`ADDREASON` varchar(200) DEFAULT NULL,
`MEMO` varchar(200) DEFAULT NULL,
`CONFIRMQTY` decimal(65,30) NOT NULL DEFAULT '0.000000000000000000000000000000' COMMENT '确认数量',
`ADDITEMID` varchar(50) DEFAULT NULL,
`MESRECEIVEQTY` decimal(65,30) DEFAULT NULL COMMENT 'MES收货量',
`PLANTYPE` varchar(200) DEFAULT NULL,
`PLANTYPECODE` decimal(65,30) DEFAULT NULL,
`XQ_STATUS` varchar(30) DEFAULT NULL,
`IS_SPS` varchar(30) DEFAULT NULL,
`DOCK_NO` varchar(30) DEFAULT NULL,
`COMPANYCODE` varchar(255) DEFAULT NULL,
`COMPANYNAME` varchar(255) DEFAULT NULL,
`FACTORYCODE` varchar(255) DEFAULT NULL,
`FACTORYNAME` varchar(255) DEFAULT NULL,
`VENDORCODE` varchar(255) DEFAULT NULL,
`VENDORNAME` varchar(255) DEFAULT NULL,
`ITEMCODE` varchar(255) DEFAULT NULL,
`ITEMNAME` varchar(255) DEFAULT NULL,
`SOURCE` varchar(255) DEFAULT NULL COMMENT '来源',
PRIMARY KEY (`OID`),
KEY `index_proschedule_orgdeptd` (`COMPANYCODE`,`DISTRIBUTEDATE`,`CONFIRMSTATUS`,`VENDORNAME`,`VENDORCODE`) USING BTREE
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
