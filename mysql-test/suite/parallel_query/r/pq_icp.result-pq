explain select FACTORYID, VENDORCODE from proschedule where companycode='203' and vendorcode='9116' and CONFIRMSTATUS=1  and distributedate>='20220703' and distributedate<='20220711';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	<gather1>	NULL	ALL	NULL	NULL	NULL	NULL	8	10.00	Parallel execute (4 workers, test.proschedule)
1	SIMPLE	proschedule	NULL	range	index_proschedule_orgdeptd	index_proschedule_orgdeptd	794	NULL	8	10.00	Using index condition
Warnings:
Note	1003	/* select#1 */ select `test`.`proschedule`.`FACTORYID` AS `FACTORYID`,`test`.`proschedule`.`VENDORCODE` AS `VENDORCODE` from `test`.`proschedule` where ((`test`.`proschedule`.`COMPANYCODE` = '203') and (`test`.`proschedule`.`VENDORCODE` = '9116') and (`test`.`proschedule`.`CONFIRMSTATUS` = 1) and (`test`.`proschedule`.`DISTRIBUTEDATE` >= TIMESTAMP'2022-07-03 00:00:00') and (`test`.`proschedule`.`DISTRIBUTEDATE` <= TIMESTAMP'2022-07-11 00:00:00'))
select FACTORYID, VENDORCODE from proschedule where companycode='203' and vendorcode='9116' and CONFIRMSTATUS=1  and distributedate>='20220703' and distributedate<='20220711';
