DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (
id INT PRIMARY KEY,
nullable_i INT NULL,
wide_v VARCHAR(64) NULL,
fixed_c CHAR(16) NULL,
amount DECIMAL(12,3) NULL,
d DATE NULL
) ENGINE=InnoDB;
INSERT INTO t1 VALUES
(1, NULL, NULL, NULL, NULL, NULL),
(2, 20, 'alpha', 'char-alpha', 12345.125, '2024-01-02'),
(3, NULL, 'nullable-int', NULL, -42.500, '1999-12-31'),
(4, 40, NULL, 'char-only', NULL, '2038-01-19'),
(5, -50, 'omega', 'char-five', 0.001, NULL);
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;
SET SESSION debug='d,pq_read_threaded_pqwr_record_gather_path';
SET @pq_executed_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_rows_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_workers_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched');
SET @pqwr_selected_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_selected');
SET @pqwr_rows_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_rows');
SELECT id, nullable_i FROM t1;
id	nullable_i
1	NULL
2	20
3	NULL
4	40
5	-50
SELECT
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
AS subset_executed_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
AS subset_fallback_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_rows_scanned') - @pq_rows_before
AS subset_rows_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
AS subset_workers_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_selected') -
@pqwr_selected_before AS subset_pqwr_selected_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_visible_pqwr_record_gather_rows') -
@pqwr_rows_before AS subset_pqwr_rows_delta;
subset_executed_delta	subset_fallback_delta	subset_rows_delta	subset_workers_delta	subset_pqwr_selected_delta	subset_pqwr_rows_delta
