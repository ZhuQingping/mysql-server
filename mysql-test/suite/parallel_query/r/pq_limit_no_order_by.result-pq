DROP DATABASE IF EXISTS limit_test_db;
CREATE DATABASE limit_test_db;
USE limit_test_db;
CREATE TABLE t1 (
id INT PRIMARY KEY AUTO_INCREMENT,
a INT,
b VARCHAR(20),
c DATE
) ENGINE=InnoDB;
CREATE TABLE t2 (
id INT PRIMARY KEY AUTO_INCREMENT,
t1_id INT,
d DECIMAL(10,2),
e DATETIME,
INDEX (t1_id)
) ENGINE=InnoDB;
INSERT INTO t1 (a, b, c) VALUES
(1, 'apple', '2023-01-01'),
(2, 'banana', '2023-01-02'),
(3, 'cherry', '2023-01-03'),
(4, 'date', '2023-01-04'),
(5, 'elderberry', '2023-01-05'),
(6, 'fig', '2023-01-06'),
(7, 'grape', '2023-01-07'),
(8, 'honeydew', '2023-01-08'),
(9, 'kiwi', '2023-01-09'),
(10, 'lemon', '2023-01-10');
