# BUG2023112700818 Crash in EXPLAIN, PQ plan cloning misses to create ZERO_ROWS path
CREATE TABLE t1(timestamp_col TIMESTAMP, decimal_col DECIMAL);
INSERT INTO t1 VALUES('2023-11-20 14:44:15',NULL);
CREATE TABLE t2 SELECT * FROM t1;
INSERT INTO t2 SELECT * FROM t1;
ALTER TABLE t2 ADD INDEX(decimal_col);
EXPLAIN FORMAT=TREE SELECT timestamp_col, decimal_col FROM t1 A
HAVING ( SELECT timestamp_col FROM t1 B
WHERE A.decimal_col >= B.decimal_col AND
EXISTS (SELECT /*+ NO_SEMIJOIN(FIRSTMATCH) */ timestamp_col FROM t2 C
WHERE decimal_col > NULL ORDER BY 1 LIMIT 1 ));
EXPLAIN
-> Gather: 4 workers, parallel scan on A  (cost=0.275 rows=1)
    -> Filter: (0 <> (select #2))  (cost=0.275 rows=0.25)
        -> Parallel table scan on A  (cost=0.275 rows=0.25)
        -> Select #2 (subquery in condition; dependent)
            -> Zero rows (Impossible WHERE noticed after reading const tables)  (cost=0..0 rows=0)

