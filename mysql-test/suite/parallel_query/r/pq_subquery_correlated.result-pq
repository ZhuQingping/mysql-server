# (9) Equality propagation used a mix of THD::change_item_tree() and non-recorded change, confusing PQ cloning code, and we got in the subquery: WHERE t1.char_col=t1.char_col AND t2.char_col <=> 'aaaa'. So the subquery returned 'aaaa' instead of NULL.
# UPDATE: the fix for this case introduced BUG2025041529773; so it has been reverted and, instead, PQ is turned off (in this case where equality and constant propagation swaps the two arguments of the first condition in WHERE).
CREATE TABLE t1(char_col CHAR(4));
CREATE TABLE t2(char_col CHAR(4));
INSERT INTO t1 VALUES('ab');
INSERT INTO t2 VALUES('aaaa');
EXPLAIN FORMAT=TREE SELECT (SELECT t2.char_col FROM t2  WHERE t2.char_col = t1.char_col AND t2.char_col <=> 'aaaa' ) AS c2 FROM t1 ;
EXPLAIN
-> Table scan on t1  (cost=0.35 rows=1)
-> Select #2 (subquery in projection; dependent)
    -> Filter: ((t1.char_col = 'aaaa') and (t2.char_col <=> 'aaaa'))  (cost=0.35 rows=1)
        -> Table scan on t2  (cost=0.35 rows=1)

Warnings:
