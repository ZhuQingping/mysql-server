FROM (a
JOIN
(a AS sub1_t2)
ON sub1_t2.col_varchar_key IN (SELECT col_varchar_key FROM a))
WHERE EXISTS (SELECT sub2_t1.col_varchar_key
FROM a AS sub2_t1))  AS table1
JOIN
(a AS table2
JOIN
a
ON 1 >= (SELECT MIN( col_varchar_key) FROM a))
ON true;
