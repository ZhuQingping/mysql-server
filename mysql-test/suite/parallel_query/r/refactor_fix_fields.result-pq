# Item_func_find_in_set
create table t1 (
access_id int not null default '0',
name varchar(20) default null,
`rank` int not null default '0',
key idx (access_id)
);
create table t2 (
faq_group_id int not null default '0',
faq_id int not null default '0',
access_id int default null,
unique key idx1 (faq_id),
key idx2 (faq_group_id,faq_id)
);
insert into t1 values (1,'Everyone',2),(2,'Help',3),(3,'Technical Support',1),(4,'Chat User',4);
insert into t2 values (261,265,1),(490,494,1);
analyze table t1,t2;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK
explain select t2.faq_id
from t1 inner join t2 ignore index (idx1)
on (t1.access_id = t2.access_id)
left join t2 t
on (t.faq_group_id = t2.faq_group_id and
find_in_set(t.access_id, '1,4') < find_in_set(t2.access_id, '1,4'))
where
t2.access_id in (1,4) and t.access_id is null and t2.faq_id in (265);
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	<gather1>	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Parallel execute (1 workers, test.t2)
1	SIMPLE	t2	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where
1	SIMPLE	t1	NULL	ref	idx	idx	4	test.t2.access_id	#	#	Using index
1	SIMPLE	t	NULL	ref	idx2	idx2	4	test.t2.faq_group_id	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t2`.`faq_id` AS `faq_id` from `test`.`t1` join `test`.`t2` IGNORE INDEX (`idx1`) left join `test`.`t2` `t` on(((`test`.`t`.`faq_group_id` = `test`.`t2`.`faq_group_id`) and (find_in_set(`test`.`t`.`access_id`,'1,4') < find_in_set(`test`.`t2`.`access_id`,'1,4')))) where ((`test`.`t1`.`access_id` = `test`.`t2`.`access_id`) and (`test`.`t2`.`faq_id` = 265) and (`test`.`t2`.`access_id` in (1,4)) and (`test`.`t`.`access_id` is null))
select t2.faq_id
from t1 inner join t2 ignore index (idx1)
on (t1.access_id = t2.access_id)
left join t2 t
on (t.faq_group_id = t2.faq_group_id and
find_in_set(t.access_id, '1,4') < find_in_set(t2.access_id, '1,4'))
where
t2.access_id in (1,4) and t.access_id is null and t2.faq_id in (265);
faq_id
265
drop table t1,t2;
