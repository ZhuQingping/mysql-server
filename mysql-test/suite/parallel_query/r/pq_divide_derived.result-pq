drop table t1;
create table t1(a int not null, b int not null, c int);
insert into t1 values(1,2,3),(2,3,4);
check table t1;
Table	Op	Msg_type	Msg_text
pq_test.t1	check	status	OK
with qn as (select a, sum(b) as s from t1 group by a) select s from qn group by a;
s
2
3
drop table t1;
# BUG2023032203662 PQ SEGV with big tables
CREATE TABLE t0 (c0 INT);
CREATE TABLE t1 (c1 INT);
SET SESSION BIG_TABLES = 1;
# Hash join with 't1' as build input and the materialized tmp
# table 'x' as probe input. The build input is empty. So the probe input
# will not be read by the worker; this used to crash then because the
# worker calls ha_innobase::pq_worker_scan_end which was not robust
# against a non-opened table (now it is).
EXPLAIN FORMAT=TREE SELECT 1 FROM (SELECT 1 FROM t0 GROUP BY t0.c0) x(x) JOIN t1 ON t1.c1 = 1 GROUP BY t1.c1;
EXPLAIN
-> Group (no aggregates)  (cost=*** rows=***)
    -> Gather: 4 workers, parallel scan on t1, x  (cost=*** rows=***)
        -> Group (no aggregates)  (cost=*** rows=***)
            -> Inner hash join, hash table shared by worker threads (no condition)  (cost=*** rows=***)
                -> Parallel table scan on x  (cost=*** rows=***)
                    -> Materialize  (cost=*** rows=***)
                        -> Table scan on <temporary>  (cost=*** rows=***)
                            -> Temporary table with deduplication  (cost=*** rows=***)
                                -> Gather: 4 workers, parallel scan on t0  (cost=*** rows=***)
                                    -> Table scan on <temporary>  (cost=*** rows=***)
                                        -> Temporary table with deduplication  (cost=*** rows=***)
                                            -> Parallel table scan on t0  (cost=*** rows=***)
                -> Hash
                    -> Filter: (t1.c1 = 1)  (cost=*** rows=***)
                        -> Parallel table scan on t1  (cost=*** rows=***)

SELECT 1 FROM (SELECT 1 FROM t0 GROUP BY t0.c0) x(x) JOIN t1 ON t1.c1 = 1 GROUP BY t1.c1;
1
SET SESSION BIG_TABLES = DEFAULT;
# BUG2023080801757 assertion failure on reversed_access for derived table
# With Temptable engine, no PQ on top level, as such table cannot be divided if not doing a full table scan
EXPLAIN FORMAT=TREE SELECT 1 FROM ((SELECT pi() FROM t0) LIMIT 0 OFFSET 2) y(z) JOIN (SELECT 1) x(z) USING (z)
ORDER BY y.z DESC;
EXPLAIN
-> Filter: (y.z = '1')  (cost=*** rows=***)
    -> Covering index lookup on y using <auto_key0> (z='1') (reverse)  (cost=*** rows=***)
        -> Materialize  (cost=*** rows=***)
            -> Limit/Offset: 0/2 row(s)  (cost=*** rows=***)
                -> Gather: 4 workers, parallel scan on t0  (cost=*** rows=***)
                    -> Limit: 2 row(s)  (cost=*** rows=***)
                        -> Parallel table scan on t0  (cost=*** rows=***)

SELECT 1 FROM ((SELECT pi() FROM t0) LIMIT 0 OFFSET 2) y(z) JOIN (SELECT 1) x(z) USING (z)
ORDER BY y.z DESC;
1
# With InnoDB engine, PQ
SET SESSION BIG_TABLES = 1;
EXPLAIN FORMAT=TREE SELECT 1 FROM ((SELECT pi() FROM t0) LIMIT 0 OFFSET 2) y(z) JOIN (SELECT 1) x(z) USING (z)
ORDER BY y.z DESC;
EXPLAIN
-> Gather: 4 workers, parallel scan on y  (cost=*** rows=***)
    -> Filter: (y.z = x.z)  (cost=*** rows=***)
        -> Parallel covering index lookup on y using <auto_key0> (z=x.z) (reverse)  (cost=*** rows=***)
            -> Materialize  (cost=*** rows=***)
                -> Limit/Offset: 0/2 row(s)  (cost=*** rows=***)
                    -> Gather: 4 workers, parallel scan on t0  (cost=*** rows=***)
                        -> Limit: 2 row(s)  (cost=*** rows=***)
                            -> Parallel table scan on t0  (cost=*** rows=***)

SELECT 1 FROM ((SELECT pi() FROM t0) LIMIT 0 OFFSET 2) y(z) JOIN (SELECT 1) x(z) USING (z)
ORDER BY y.z DESC;
1
SET SESSION BIG_TABLES = DEFAULT;
drop database pq_test;
