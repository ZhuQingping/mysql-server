#BUG2021072202240: there is no idle thread for parallel query and thus we disable PQ.
#However, we have modified field's result_field in check_pq_select_fields and this
#will lead to core when sending data using field.
set session debug="+d, no_available_idle_threads";
explain select * from (select id, a from t1) as sub;
