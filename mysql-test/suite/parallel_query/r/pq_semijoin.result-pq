#
# BUG2022080902008 Assertion failures with PQ + correlated derived table
#
CREATE TABLE t0 (c_payment_cnt INT);
CREATE TABLE t5 (c_delivery_cnt INT);
EXPLAIN FORMAT=TREE SELECT ref_0.c_payment_cnt FROM t0 ref_0 JOIN t5 ref_1
WHERE EXISTS(SELECT 3 FROM(SELECT 0 WHERE ref_1.c_delivery_cnt AND 0) subq_2) ORDER BY 1;
EXPLAIN
-> Sort: ref_0.c_payment_cnt
    -> Stream results  (...)
        -> Hash semijoin (no condition)  (...)
            -> Inner hash join (no condition)  (...)
                -> Table scan on ref_1  (...)
                -> Hash
                    -> Table scan on ref_0  (...)
            -> Hash
                -> Limit: 1 row(s)  (...)
                    -> Table scan on subq_2  (...)
                        -> Materialize  (...)
                            -> Zero rows (Impossible WHERE)  (...)

Warnings:
Note	1276	Field or reference 'test.ref_1.c_delivery_cnt' of SELECT #3 was resolved in SELECT #1
SELECT ref_0.c_payment_cnt FROM t0 ref_0 JOIN t5 ref_1
WHERE EXISTS(SELECT 3 FROM(SELECT 0 WHERE ref_1.c_delivery_cnt AND 0) subq_2) ORDER BY 1;
c_payment_cnt
DROP TABLE t0,t5;
#
# BUG2022081903526 Segmentation fault in MaterializeIterator::Init with PQ + semijoin + IS NULL
#
CREATE TABLE t12 (c_id int);
INSERT INTO t12 VALUES (0),(1);
CREATE TABLE t4 (c_zip char(23) DEFAULT NULL, c_since timestamp NOT NULL);
CREATE TABLE t5 (c_id int);
ANALYZE TABLE t12,t5,t4;
Table	Op	Msg_type	Msg_text
test.t12	analyze	status	OK
test.t5	analyze	status	OK
test.t4	analyze	status	OK
EXPLAIN FORMAT=TREE SELECT
/*+ JOIN_ORDER(t12,t4,ref_8) */
1 FROM t12 LEFT JOIN t5 ref_8
ON EXISTS(SELECT /*+ SEMIJOIN(MATERIALIZATION) */ c_zip FROM t4 WHERE c_since IS NULL);
EXPLAIN
-> Gather: 4 workers, parallel scan on t12  (...)
    -> Nested loop left join  (...)
        -> Parallel table scan on t12  (...)
        -> Nested loop inner join  (...)
            -> Zero rows (Impossible filter)  (...)
            -> Table scan on ref_8  (...)

SELECT
/*+ JOIN_ORDER(t12,t4,ref_8) */
1 FROM t12 LEFT JOIN t5 ref_8
ON EXISTS(SELECT /*+ SEMIJOIN(MATERIALIZATION) */ c_zip FROM t4 WHERE c_since IS NULL);
1
1
1
DROP TABLE t12,t4,t5;
#
# BUG2022112102841 Assertion failure in MaterializeIterator::Init()
