CREATE TABLE `country` (
`code` int DEFAULT NULL,
`name` varchar(255) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
CREATE TABLE `city` (
`country` int DEFAULT NULL,
`name` varchar(255) DEFAULT NULL,
`pop` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
insert into country values(1,'china');
insert into country values(2,'usa');
insert into city values(1,'beijing',1000);
insert into city values(1,'shanghai',1000);
insert into city values(2,'new york',1000);
explain SELECT /*+ SEMIJOIN(@subq1 FIRSTMATCH) */ *
FROM country
WHERE country.code IN (
SELECT /*+ QB_NAME(subq1) */ city.country
FROM city
WHERE city.pop > 100
);
