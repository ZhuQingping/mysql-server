#
# BUG2022101401408 When PQ is enabled, execute a 4-table join query with
#                  aggregate function, and the query with MIN function is
#                  stuck randomly
# Create a case where execution of the query is started (Init() is called
# on the top-level iterator), but an error happens so that Init() is not
# called on the HashJoinIterator. We want to verify that we do not call
# ArriveAndDrop() in both HashJoinIterators End() and in the destructor.
CREATE TABLE t1 (i INTEGER);
INSERT INTO t1 VALUES (1);
EXPLAIN FORMAT=tree SELECT /*+ NO_BNL(t3) PQ(t2) */ * FROM t1 JOIN t1 t2 JOIN t1 t3;
EXPLAIN
-> Gather: 4 workers, parallel scan on t1, t2  (cost=0.45 rows=1)
    -> Nested loop inner join  (cost=0.45 rows=0.25)
        -> Inner hash join, hash table shared by worker threads (no condition)  (cost=0.363 rows=0.25)
            -> Parallel table scan on t2  (cost=0.275 rows=0.25)
            -> Hash
                -> Parallel table scan on t1  (cost=0.275 rows=0.25)
        -> Table scan on t3  (cost=0.35 rows=1)

SET SESSION debug="+d, nested_loop_init_error";
SELECT /*+ NO_BNL(t3) PQ(t2) */ * FROM t1 JOIN t1 t2 JOIN t1 t3;
ERROR 21000: Subquery returns more than 1 row
SET SESSION debug="-d, nested_loop_init_error";
DROP TABLE t1;
