CREATE TABLE t (i INTEGER);
INSERT INTO t VALUES (1), (2), (3);
ANALYZE TABLE t;
Table	Op	Msg_type	Msg_text
test.t	analyze	status	OK
EXPLAIN FORMAT=tree SELECT /*+ PQ(t2) */ * FROM t JOIN t t2 ON t.i = t2.i;
EXPLAIN
-> Gather: 4 workers, parallel scan on t, t2  (cost=0.613 rows=3)
    -> Inner hash join, hash table shared by worker threads (t2.i = t.i)  (cost=0.613 rows=0.75)
        -> Parallel table scan on t2  (cost=0.0917 rows=0.75)
        -> Hash
            -> Parallel table scan on t  (cost=0.325 rows=0.75)

set session debug="+d, pq_worker_abort1";
