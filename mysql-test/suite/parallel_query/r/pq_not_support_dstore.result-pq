# (7) correlated subqueries, PQ not work due to query block include Dstore table.
explain SELECT * FROM t1 WHERE NOT EXISTS(SELECT * FROM t2 WHERE t2.num > t1.num + 100) AND
(SELECT COUNT(*) FROM t2 WHERE t2.num=t1.num)!=5 ORDER BY 1;
