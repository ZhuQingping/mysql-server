DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT PRIMARY KEY, val INT, name VARCHAR(100)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10,'a'),(2,20,'b'),(3,30,'c'),(4,40,'d'),(5,50,'e');
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
EXPLAIN SELECT val, COUNT(*) FROM t1 GROUP BY val;
