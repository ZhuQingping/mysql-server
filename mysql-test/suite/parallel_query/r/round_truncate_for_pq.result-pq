EXPLAIN
-> Aggregate: sum(`<temporary>`.`SUM(a)`)  (cost=0.9 rows=1)
    -> Gather: 4 workers, parallel scan on t0  (cost=0.5 rows=4)
        -> Aggregate: sum(`<temporary>`.`SUM(a)`)  (cost=0.5 rows=1)
            -> Parallel table scan on t0  (cost=0.375 rows=1.25)

SELECT ROUND(SUM(a)) FROM t0;
ROUND(SUM(a))
16
EXPLAIN FORMAT=TREE SELECT /*+ NO_PQ */ ROUND(SUM(a)) FROM t0;
EXPLAIN
-> Aggregate: sum(t0.a)  (cost=1.25 rows=1)
    -> Table scan on t0  (cost=0.75 rows=5)

SELECT /*+ NO_PQ */ ROUND(SUM(a)) FROM t0;
ROUND(SUM(a))
16
#3/ With aggregates and GROUP BY 
