# 4/ SUM_DISTINCT_FUNC is not supported by PQ (yet)
# Same layout as previous tests - if evt. enabled only the execution plans should change 
EXPLAIN FORMAT=TREE SELECT FLOOR(SUM(DISTINCT a))  FROM t0 GROUP BY b;
EXPLAIN
-> Group aggregate: sum(distinct t0.a)  (cost=1.25 rows=2.24)
    -> Sort: t0.b  (cost=0.75 rows=5)
        -> Table scan on t0  (cost=0.75 rows=5)

