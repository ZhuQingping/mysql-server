# Test with Item about math
CREATE TABLE math_time_test (
id INT PRIMARY KEY AUTO_INCREMENT,
value DOUBLE,
angle_radians DOUBLE,
angle_degrees DOUBLE,
event_date DATE,
log_value DOUBLE,
description VARCHAR(100)
);
INSERT INTO math_time_test (value, angle_radians, angle_degrees, event_date, log_value, description) VALUES
(1.0, 0.785398, 45.0, '2024-01-15', 2.71828, 'First quarter, 45 degrees'),
(2.0, 1.570796, 90.0, '2024-04-15', 7.38906, 'Second quarter, 90 degrees'),
(3.0, 3.141593, 180.0, '2024-07-15', 20.0855, 'Third quarter, 180 degrees'),
(4.0, 4.712389, 270.0, '2024-10-15', 54.5982, 'Fourth quarter, 270 degrees'),
(0.5, 0.523599, 30.0, '2024-02-29', 1.64872, 'Leap day, 30 degrees'),
(10.0, 0.0, 0.0, '2024-12-31', 22026.5, 'Year end, 0 degrees'),
(0.0, 1.047198, 60.0, '2024-06-15', 1.0, 'Mid year, 60 degrees'),
(0.707107, 0.785398, 45.0, '2024-03-20', 2.02811, 'Spring equinox'),
(-1.0, -0.785398, -45.0, '2024-11-11', 0.367879, 'Negative angle');
explain SELECT
id,
description,
event_date,
QUARTER(event_date) AS quarter,
angle_degrees,
TAN(RADIANS(angle_degrees)) AS tangent,
COT(RADIANS(angle_degrees)) AS cotangent,
value,
LN(ABS(value) + 1) AS safe_log,
LOG10(ABS(value) + 1) AS safe_log10,
CASE
WHEN value BETWEEN -1 AND 1 THEN DEGREES(ASIN(value))
ELSE NULL
END AS arcsin_degrees,
EXP(value) AS exponential,
EXP(LN(ABS(value) + 1)) AS exp_ln_combo
FROM math_time_test;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	<gather1>	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Parallel execute (4 workers, test.math_time_test)
1	SIMPLE	math_time_test	NULL	ALL	NULL	NULL	NULL	NULL	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`math_time_test`.`id` AS `id`,`test`.`math_time_test`.`description` AS `description`,`test`.`math_time_test`.`event_date` AS `event_date`,quarter(`test`.`math_time_test`.`event_date`) AS `quarter`,`test`.`math_time_test`.`angle_degrees` AS `angle_degrees`,tan(radians(`test`.`math_time_test`.`angle_degrees`)) AS `tangent`,cot(radians(`test`.`math_time_test`.`angle_degrees`)) AS `cotangent`,`test`.`math_time_test`.`value` AS `value`,ln((abs(`test`.`math_time_test`.`value`) + 1)) AS `safe_log`,log10((abs(`test`.`math_time_test`.`value`) + 1)) AS `safe_log10`,(case when (`test`.`math_time_test`.`value` between -(1) and 1) then degrees(asin(`test`.`math_time_test`.`value`)) else NULL end) AS `arcsin_degrees`,exp(`test`.`math_time_test`.`value`) AS `exponential`,exp(ln((abs(`test`.`math_time_test`.`value`) + 1))) AS `exp_ln_combo` from `test`.`math_time_test`
explain SELECT * FROM math_time_test
WHERE QUARTER(event_date) = 2
AND TAN(RADIANS(angle_degrees)) > 0
AND LOG10(ABS(value) + 1) < 0.5
AND EXP(value) < 100;
