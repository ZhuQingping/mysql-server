Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id`,`test`.`t1`.`date_string` AS `date_string`,(case when (cast_as_year(`test`.`t1`.`date_string`) is not null) then cast_as_year(`test`.`t1`.`date_string`) else NULL end) AS `extracted_year`,`test`.`t1`.`event_date` AS `event_date`,last_day(`test`.`t1`.`event_date`) AS `month_end`,`test`.`t1`.`value` AS `value`,(case when (`test`.`t1`.`event_date` = last_day(`test`.`t1`.`event_date`)) then 'YES' else 'NO' end) AS `is_month_end` from `test`.`t1` order by `test`.`t1`.`id`
