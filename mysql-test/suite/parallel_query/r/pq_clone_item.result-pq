# Item_func_is_ipv6
CREATE TABLE network_devices (
device_id INT PRIMARY KEY AUTO_INCREMENT,
device_name VARCHAR(100),
ip_address VARCHAR(45),
device_type VARCHAR(50),
last_seen DATETIME
);
INSERT INTO network_devices (device_name, ip_address, device_type) VALUES
('Router-1', '2001:db8::1', 'router'),
('Server-1', 'fe80::250:56ff:fe96:5d3f', 'server'),
('Switch-1', '192.168.1.1', 'switch'),           -- IPv4
('Firewall-1', '2001:db8:85a3::8a2e:370:7334', 'firewall'),
('Invalid-Device', 'not.an.ip.address', 'unknown');
EXPLAIN SELECT
device_id,
device_name,
ip_address,
device_type,
CASE
WHEN IS_IPV6(ip_address) = 1 THEN 'IPv6'
        ELSE 'IPv4 or Invalid'
    END AS ip_version
FROM network_devices
WHERE IS_IPV6(ip_address) = 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	<gather1>	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Parallel execute (4 workers, test.network_devices)
1	SIMPLE	network_devices	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`network_devices`.`device_id` AS `device_id`,`test`.`network_devices`.`device_name` AS `device_name`,`test`.`network_devices`.`ip_address` AS `ip_address`,`test`.`network_devices`.`device_type` AS `device_type`,(case when (is_ipv6(`test`.`network_devices`.`ip_address`) = 1) then 'IPv6' else 'IPv4 or Invalid' end) AS `ip_version` from `test`.`network_devices` where (is_ipv6(`test`.`network_devices`.`ip_address`) = 1)
DROP TABLE network_devices;
# Item_func_is_ipv4
CREATE TABLE network_configurations (
config_id INT PRIMARY KEY AUTO_INCREMENT,
device_name VARCHAR(100),
ip_address VARCHAR(15),
subnet_mask VARCHAR(15),
gateway VARCHAR(15),
dns_server VARCHAR(15),
config_status ENUM('VALID', 'INVALID', 'PENDING')
);
INSERT INTO network_configurations (device_name, ip_address, subnet_mask, gateway, dns_server) VALUES
('Router-01', '192.168.1.1', '255.255.255.0', '192.168.1.254', '8.8.8.8'),
('Server-01', '10.0.0.100', '255.255.0.0', '10.0.0.1', '10.0.0.53'),
('Switch-01', '172.16.0.1', '255.255.255.240', '172.16.0.14', '1.1.1.1'),
('Invalid-01', '300.400.500.600', '255.255.255.0', '192.168.1.1', '8.8.8.8'),
('Partial-01', '192.168.1', '255.255.255.0', '192.168.1.1', '8.168.1.1');
EXPLAIN SELECT
config_id,
device_name,
ip_address,
subnet_mask,
gateway,
dns_server,
CASE
WHEN IS_IPV4(ip_address) = 1
AND IS_IPV4(subnet_mask) = 1
AND IS_IPV4(gateway) = 1
AND IS_IPV4(dns_server) = 1
THEN 'VALID'
        ELSE 'INVALID'
    END AS validation_result,
CONCAT_WS(', ',
CASE WHEN IS_IPV4(ip_address) = 0 THEN 'IP地址无效' END,
CASE WHEN IS_IPV4(subnet_mask) = 0 THEN '子网掩码无效' END,
CASE WHEN IS_IPV4(gateway) = 0 THEN '网关无效' END,
CASE WHEN IS_IPV4(dns_server) = 0 THEN 'DNS服务器无效' END
) AS error_details
FROM network_configurations;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	<gather1>	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Parallel execute (4 workers, test.network_configurations)
1	SIMPLE	network_configurations	NULL	ALL	NULL	NULL	NULL	NULL	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`network_configurations`.`config_id` AS `config_id`,`test`.`network_configurations`.`device_name` AS `device_name`,`test`.`network_configurations`.`ip_address` AS `ip_address`,`test`.`network_configurations`.`subnet_mask` AS `subnet_mask`,`test`.`network_configurations`.`gateway` AS `gateway`,`test`.`network_configurations`.`dns_server` AS `dns_server`,(case when ((is_ipv4(`test`.`network_configurations`.`ip_address`) = 1) and (is_ipv4(`test`.`network_configurations`.`subnet_mask`) = 1) and (is_ipv4(`test`.`network_configurations`.`gateway`) = 1) and (is_ipv4(`test`.`network_configurations`.`dns_server`) = 1)) then 'VALID' else 'INVALID' end) AS `validation_result`,concat_ws(', ',(case when (is_ipv4(`test`.`network_configurations`.`ip_address`) = 0) then 'IP地址无效' end),(case when (is_ipv4(`test`.`network_configurations`.`subnet_mask`) = 0) then '子网掩码无效' end),(case when (is_ipv4(`test`.`network_configurations`.`gateway`) = 0) then '网关无效' end),(case when (is_ipv4(`test`.`network_configurations`.`dns_server`) = 0) then 'DNS服务器无效' end)) AS `error_details` from `test`.`network_configurations`
DROP TABLE network_configurations;
