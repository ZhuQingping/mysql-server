SET @old_innodb_lock_wait_timeout = @@global.innodb_lock_wait_timeout;
SET @@global.innodb_lock_wait_timeout = 1;
# -----------------------
# basic testing 
# ----------------------
SET @saved_pq_support_features_switch = @@global.pq_support_features_switch;
set pq_support_features_switch='insert_select=on';
create table t0 (a int);
create table t1 (a int, UNIQUE(a));
insert into t0 values (1),(2),(3);
insert into t1 values (1),(2),(3);
# FOR UPDATE and LOCK IN SHARE MODE disable parallel insert select
# because the locks are not released.
explain format=tree replace into t1 select * from t0;
EXPLAIN
-> Replace into t1
    -> Gather: 4 workers, parallel scan on t0  (...)
        -> Parallel table scan on t0  (...)

explain format=tree replace into t1 select * from t0 FOR UPDATE;
EXPLAIN
-> Replace into t1
    -> Table scan on t0  (...)

explain format=tree replace into t1 select * from t0 LOCK IN SHARE MODE;
EXPLAIN
-> Replace into t1
    -> Table scan on t0  (...)

drop table t0;
# SELECT ON PK 
alter table t1 add primary key(a);
create table t2 ( a int, UNIQUE(a));
insert into t2 values (1),(2),(3);
explain format=tree replace into t2 select * from t1;
EXPLAIN
-> Replace into t2
    -> Gather: 4 workers, parallel scan on t1  (...)
        -> Parallel index scan on t1 using PRIMARY  (...)

replace into t2 select * from t1;
select * from t2;
a
1
2
3
# SELECT ON 2nd index
alter table t1 drop primary key;
alter table t1 add index(a);
explain format=tree replace into t2 select * from t1;
EXPLAIN
-> Replace into t2
    -> Gather: 4 workers, parallel scan on t1  (...)
        -> Parallel index scan on t1 using a  (...)

replace into t2 select * from t1;
select * from t2;
a
1
2
3
drop table t2;
# replace into itself
alter table t1 drop index a;
alter table t1 add primary key(a);
start transaction;
explain format=tree replace into t1 select * from t1;
EXPLAIN
-> Replace into t1
    -> Table scan on <temporary>  (...)
        -> Temporary table  (...)
            -> Index scan on t1 using PRIMARY  (...)

replace into t1 select * from t1;
select * from t1;
a
1
2
3
rollback;
start transaction;
explain format=tree replace into t1 select a+1 from t1;
EXPLAIN
-> Replace into t1
    -> Table scan on <temporary>  (...)
        -> Temporary table  (...)
            -> Index scan on t1 using PRIMARY  (...)

replace into t1 select a+1 from t1;
select * from t1;
a
1
2
3
4
drop table t1;
set pq_support_features_switch = default;
# -------------
# Parallel insert select with concurrent DML
# A: INSERT B: UPDATE C: DELETE
# --------------------
# A 
# Parallel Insert into select with concurrent INSERT 
# 1: with parallel insert 2: without 
# They behave the same.
# ---------------------
# 1
SET GLOBAL pq_support_features_switch='insert_select=on';
create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);
# Using connection con1
start transaction;
replace into t2 select a from t1;
# Using connection con2
INSERT INTO t1 values(85);;
# Using connection con1
commit;
# Using connection con2
# Using connection default
select * from t1;
a
1
3
5
85
select * from t2;
b
1
3
5
drop table t1,t2;
# 2
SET GLOBAL pq_support_features_switch='insert_select=off';
create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);
# Using connection con1
start transaction;
replace into t2 select a from t1;
# Using connection con2
INSERT INTO t1 values(85);;
# Using connection con1
commit;
# Using connection con2
# Using connection default
select * from t1;
a
1
3
5
85
select * from t2;
b
1
3
5
drop table t1,t2;
# --------------------
# B
# Parallel Insert into select with concurrent UPDATE
# 1: with parallel insert 2: without 
# They behave the same.
# ---------------------
# 1
SET GLOBAL pq_support_features_switch='insert_select=on';
create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);
# Using connection con1
start transaction;
replace into t2 select a from t1;
# Using connection con2
UPDATE t1 SET a = 85 where a=5;;
# Using connection con1
commit;
# Using connection con2
# Using connection default
select * from t1;
a
1
3
85
select * from t2;
b
1
3
5
drop table t1,t2;
# 2
SET GLOBAL pq_support_features_switch='insert_select=off';
create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);
# Using connection con1
start transaction;
replace into t2 select a from t1;
# Using connection con2
UPDATE t1 SET a = 85 where a=5;;
# Using connection con1
commit;
# Using connection con2
# Using connection default
select * from t1;
a
1
3
85
select * from t2;
b
1
3
5
drop table t1,t2;
# --------------------
# C
# Parallel Insert into select with concurrent DELETE
# 1: with parallel insert 2: without 
# They behave the same.
# ---------------------
# 1
SET GLOBAL pq_support_features_switch='insert_select=on';
create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);
# Using connection con1
start transaction;
replace into t2 select a from t1;
# Using connection con2
DELETE FROM  t1 where a=5;;
# Using connection con1
commit;
# Using connection con2
select * from t1;
a
1
3
select * from t2;
b
1
3
5
drop table t1,t2;
# 2
SET GLOBAL pq_support_features_switch='insert_select=off';
create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);
# Using connection con1
start transaction;
replace into t2 select a from t1;
# Using connection con2
DELETE FROM  t1 where a=5;;
# Using connection con1
commit;
# Using connection con2
# Using connection default
select * from t1;
a
1
3
select * from t2;
b
1
3
5
drop table t1,t2;
# A/ INSERTING INTO table t1 with UNIQUE INDEX from t2 
# Locks from inserted-into table prevent the insert 
# 1/a
SET GLOBAL pq_support_features_switch='insert_select=on';
CREATE TABLE t1(a INT,  UNIQUE KEY(a));
CREATE TABLE t2(a int);
INSERT INTO t1 VALUES(1), (5), (15), (35);
INSERT INTO t2 values (2),(7),(30),(40),(50);
# Using connection con1
start transaction;
INSERT INTO t1 values (50);
# Using connection con2
replace into t1 select * from t2;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
# Using connection con1
rollback;
# Using connection default
# 1/b/ 
# Using connection con1
start transaction;
INSERT INTO t1 values (50);
# Using connection con2
replace into t1 select * from t2;;
# Using connection con1
commit;
# Using connection con2
# Using connection default
drop table t1,t2;
# 2/a (same as 1/a but without parallel insert select)
SET GLOBAL pq_support_features_switch='insert_select=off';
CREATE TABLE t1(a INT,  UNIQUE KEY(a));
CREATE TABLE t2(a int);
INSERT INTO t1 VALUES(1), (5), (15), (35);
INSERT INTO t2 values (2),(7),(30),(40),(50);
# Using connection con1
start transaction;
INSERT INTO t1 values (50);
# Using connection con2
replace into t1 select * from t2;
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
# Using connection con1
rollback;
# Using connection default
# 2/b (same as 1/b but without parallel insert select)
# Using connection con1
start transaction;
INSERT INTO t1 values (50);
# Using connection con2
replace into t1 select * from t2;;
# Using connection con1
commit;
# Using connection con2
# HERE as well
# Using connection default
drop table t1,t2;
# B/ INSERTING INTO table t1 into itself with UNIQUE INDEX 
# Locks from inserted-into table prevent the insert 
SET GLOBAL pq_support_features_switch='insert_select=on';
CREATE TABLE t1(a INT,  UNIQUE KEY(a));
INSERT INTO t1 VALUES(1), (5), (15), (35);
# Using connection con1
start transaction;
INSERT INTO t1 values (85);
# Using connection con2
replace into t1 select a + 50 from t1;;
# Using connection con1
commit;
# Using connection con2
# Using connection default
drop table t1;
SET GLOBAL pq_support_features_switch='insert_select=off';
CREATE TABLE t1(a INT,  UNIQUE KEY(a));
INSERT INTO t1 VALUES(1), (5), (15), (35);
# Using connection con1
start transaction;
INSERT INTO t1 values (85);
# Using connection con2
replace into t1 select a + 50 from t1;;
# Using connection con1
commit;
# Using connection con2
# Using connection default
# -------------------------
# session one calls 'INSERT ... SELECT a + 50 ...' to the same table, 
# Session two tries to inserts 85
# Session two insert fails because of the duplicate key error.
# --------------------------
drop table  t1;
CREATE TABLE t1(a INT,  UNIQUE KEY(a));
INSERT INTO t1 VALUES(1), (5), (15), (35);
# Using connection con1
start transaction;
replace into t1 select a + 50 from t1;
# Using connection con2
INSERT INTO t1 values(85);;
# Using connection con1
commit;
# Using connection con2
ERROR 23000: Duplicate entry '85' for key 't1.a'
# Using connection default
SET GLOBAL pq_support_features_switch='insert_select=on';
drop table t1;
CREATE TABLE t1(a INT,  UNIQUE KEY(a));
INSERT INTO t1 VALUES(1), (5), (15), (35);
# Using connection con1
start transaction;
replace into t1 select a + 50 from t1;
# Using connection con2
INSERT INTO t1 values(85);;
# Using connection con1
commit;
# Using connection con2
ERROR 23000: Duplicate entry '85' for key 't1.a'
# Using connection default
drop table t1;
SET @@global.innodb_lock_wait_timeout = @old_innodb_lock_wait_timeout;
SET global pq_support_features_switch = @saved_pq_support_features_switch;
