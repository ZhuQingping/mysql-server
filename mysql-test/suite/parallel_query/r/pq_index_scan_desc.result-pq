CREATE TABLE `grid_hour_weather` (
`id` bigint NOT NULL AUTO_INCREMENT,
`grid_id` int DEFAULT NULL,
`data` longtext CHARACTER SET utf8 COLLATE utf8_general_ci NOT NULL,
`published_at` datetime NOT NULL,
PRIMARY KEY (`id`),
KEY `grid_hour_weather_published_at` (`published_at`, data(100))
) ENGINE=InnoDB AUTO_INCREMENT=1 DEFAULT CHARSET=utf8;
explain select published_at,count(*) from grid_hour_weather where published_at >= '####-##-## ##:##:##' group by published_at order by published_at desc;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
#	SIMPLE	<gather#>	NULL	ALL	NULL	NULL	NULL	NULL	#####	###.##	Parallel execute (# workers, test.grid_hour_weather)
#	SIMPLE	grid_hour_weather	NULL	range	grid_hour_weather_published_at	grid_hour_weather_published_at	#	NULL	#####	###.##	Backward index scan; Using index
select published_at,count(*) from grid_hour_weather where published_at >= '2022-08-07 00:00:00' group by published_at order by published_at desc;
