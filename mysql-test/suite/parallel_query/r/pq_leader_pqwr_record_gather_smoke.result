(SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_attempts') -
@stream_attempts_before) AS stream_attempt_delta;
stream_attempt_delta
