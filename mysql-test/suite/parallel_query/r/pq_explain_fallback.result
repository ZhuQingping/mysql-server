EXPLAIN SELECT * FROM t1 WHERE val > 20;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ALL	NULL	NULL	NULL	NULL	5	33.33	Using where; Parallel query eligible, execution disabled, serial fallback, dop=4
