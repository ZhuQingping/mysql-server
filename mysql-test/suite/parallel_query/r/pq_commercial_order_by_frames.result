CREATE TABLE pq_orderby_frame_t (
id INT PRIMARY KEY,
k INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO pq_orderby_frame_t VALUES (1, 30), (2, 10), (3, 20);
SET @frame_rows_before = (
SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_exchange_sort_frame_smoke_rows');
SET @frame_finishes_before = (
SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_exchange_sort_frame_smoke_finishes');
SET @frame_errors_before = (
SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_exchange_sort_frame_smoke_errors');
SET @frame_merge_rows_before = (
SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_exchange_sort_frame_merge_smoke_rows');
SET @frame_merge_finishes_before = (
SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_exchange_sort_frame_merge_smoke_finishes');
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;
SELECT * FROM pq_orderby_frame_t;
id	k
1	30
2	10
3	20
SELECT (
(SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_exchange_sort_frame_smoke_rows') -
@frame_rows_before) >= 2 AS orderby_frame_rows_delta;
orderby_frame_rows_delta
1
SELECT (
(SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_exchange_sort_frame_smoke_finishes') -
@frame_finishes_before) >= 1 AS orderby_frame_finishes_delta;
orderby_frame_finishes_delta
1
SELECT (
(SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_exchange_sort_frame_smoke_errors') -
@frame_errors_before) >= 1 AS orderby_frame_errors_delta;
orderby_frame_errors_delta
1
SELECT (
(SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_exchange_sort_frame_merge_smoke_rows') -
@frame_merge_rows_before) >= 6 AS orderby_frame_merge_rows_delta;
orderby_frame_merge_rows_delta
1
SELECT (
(SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_exchange_sort_frame_merge_smoke_finishes') -
@frame_merge_finishes_before) >= 3 AS orderby_frame_merge_finishes_delta;
orderby_frame_merge_finishes_delta
1
SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
SET SESSION parallel_default_dop=4;
DROP TABLE pq_orderby_frame_t;
