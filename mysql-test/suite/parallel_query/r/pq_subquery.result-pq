# BUG2023041802455 assert fail in PQ - derived condition pushdown of a const subquery
CREATE TABLE t0 (c0 INT);
INSERT INTO t0(c0) VALUES (7580965),(-7120991);
explain format=tree SELECT 1 FROM (SELECT t0.c0 FROM t0 GROUP BY t0.c0) as t11 WHERE CAST(sqrt(sysdate()) AS CHAR(30)) >= ANY(SELECT CAST(X'6F' AS CHAR));
EXPLAIN
-> Filter: <nop>((cast(sqrt(sysdate()) as char(30) charset utf8mb4) >= <min>(select #3)))  (cost=4.25..2.73 rows=2)
    -> Table scan on t11  (cost=7.04..8.3 rows=2)
        -> Materialize  (cost=5.78..5.78 rows=2)
            -> Table scan on <temporary>  (cost=4.31..5.58 rows=2)
                -> Temporary table with deduplication  (cost=3.05..3.05 rows=2)
                    -> Gather: 4 workers, parallel scan on t0  (cost=1.6..2.85 rows=2)
                        -> Table scan on <temporary>  (cost=2.85..2.85 rows=0.5)
                            -> Temporary table with deduplication  (cost=0.35..0.35 rows=0.5)
                                -> Parallel table scan on t0  (cost=0.3 rows=0.5)
    -> Select #3 (subquery in condition; run only once)
        -> Rows fetched before execution  (cost=0..0 rows=1)

SELECT 1 FROM (SELECT t0.c0 FROM t0 GROUP BY t0.c0) as t11 WHERE CAST(sqrt(sysdate()) AS CHAR(30)) >= ANY(SELECT CAST(X'6F' AS CHAR));
1
