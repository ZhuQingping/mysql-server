            -> Aggregate: count(0)  (cost=1.75 rows=1)
                -> Nested loop left join  (cost=1.35 rows=4)
                    -> Table scan on t2  (cost=0.45 rows=2)
                    -> Filter: (t3.a > (t2.a - t1.a))  (cost=0.35 rows=2)
                        -> Table scan on t3  (cost=0.35 rows=2)

