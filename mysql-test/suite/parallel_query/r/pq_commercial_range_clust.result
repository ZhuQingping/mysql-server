DROP TABLE IF EXISTS pq_range_clust_t1;
CREATE TABLE pq_range_clust_t1 (
id INT PRIMARY KEY AUTO_INCREMENT,
col1 VARCHAR(32),
col2 INT
) ENGINE=InnoDB;
INSERT INTO pq_range_clust_t1(col1, col2) VALUES
('test',100),('test',90),('test',80),('test',70),
('test',60),('test',50),('test',40),('test',30),
('test',20),('test',10),('test',0),('test',-10);
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;
SET SESSION parallel_query_experimental_threaded_dop=ON;
SELECT COUNT(*) FROM pq_range_clust_t1;
COUNT(*)
12
SELECT MIN(id), MAX(id) FROM pq_range_clust_t1;
MIN(id)	MAX(id)
1	12
SET @pq_executed_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_workers_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched');
SET @pq_rows_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_primary_range_probe_attempts_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_range_probe_attempts');
SET @pq_primary_range_probe_unsupported_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_range_probe_unsupported');
SET @pq_primary_range_partition_attempts_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_range_partition_attempts');
SET @pq_primary_range_partition_success_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_range_partition_success');
SET @pq_primary_range_partition_failed_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_range_partition_failed');
SET @pq_primary_ranges_built_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_ranges_built');
SET @old_debug=@@debug;
SET SESSION debug="+d,pq_primary_range_partition_smoke";
SELECT id, col2 FROM pq_range_clust_t1 FORCE INDEX(PRIMARY) WHERE id < 5;
id	col2
1	100
2	90
3	80
4	70
SET SESSION debug=@old_debug;
SELECT
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
AS executed_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
AS fallback_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
AS workers_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_rows_scanned') - @pq_rows_before
AS rows_scanned_delta,
((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_range_probe_attempts') -
@pq_primary_range_probe_attempts_before) >= 1
AS primary_range_probe_attempts_seen,
((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_range_probe_unsupported') -
@pq_primary_range_probe_unsupported_before) >= 1
AS primary_range_probe_unsupported_seen,
((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_range_partition_attempts') -
@pq_primary_range_partition_attempts_before) >= 1
AS primary_range_partition_attempts_seen,
((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_range_partition_success') -
@pq_primary_range_partition_success_before) >= 1
AS primary_range_partition_success_seen,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_range_partition_failed') -
@pq_primary_range_partition_failed_before
AS primary_range_partition_failed_delta,
((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_primary_ranges_built') -
@pq_primary_ranges_built_before) >= 1
AS primary_ranges_built_seen;
executed_delta	fallback_delta	workers_delta	rows_scanned_delta	primary_range_probe_attempts_seen	primary_range_probe_unsupported_seen	primary_range_partition_attempts_seen	primary_range_partition_success_seen	primary_range_partition_failed_delta	primary_ranges_built_seen
1	0	0	4	1	1	1	1	0	1
