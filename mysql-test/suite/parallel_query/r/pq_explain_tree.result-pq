CREATE TABLE t1(f1 INT, f2 INT);
INSERT INTO t1 VALUES
(1,1),(2,2),(3,3);
CREATE TABLE t2(f1 INT NOT NULL, f2 INT NOT NULL, f3 CHAR(200), KEY(f1, f2));
INSERT INTO t2 VALUES
(1,1, 'qwerty'),(1,2, 'qwerty'),(1,3, 'qwerty'),
(2,1, 'qwerty'),(2,2, 'qwerty'),(2,3, 'qwerty'), (2,4, 'qwerty'),(2,5, 'qwerty'),
(3,1, 'qwerty'),(3,4, 'qwerty'),
(4,1, 'qwerty'),(4,2, 'qwerty'),(4,3, 'qwerty'), (4,4, 'qwerty'),
(1,1, 'qwerty'),(1,2, 'qwerty'),(1,3, 'qwerty'),
(2,1, 'qwerty'),(2,2, 'qwerty'),(2,3, 'qwerty'), (2,4, 'qwerty'),(2,5, 'qwerty'),
(3,1, 'qwerty'),(3,4, 'qwerty'),
(4,1, 'qwerty'),(4,2, 'qwerty'),(4,3, 'qwerty'), (4,4, 'qwerty');
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
ANALYZE TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	OK
explain format=tree SELECT t2.f1, t2.f2, t2.f3 FROM t1,t2 WHERE t1.f1=t2.f1 AND t2.f2 BETWEEN t1.f1 and t1.f2 and t2.f2 + 1 >= t1.f1 + 1;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=5.8 rows=21)
    -> Nested loop inner join  (cost=5.8 rows=5.25)
        -> Filter: (t1.f1 is not null)  (cost=0.55 rows=3)
            -> Table scan on t1  (cost=0.55 rows=3)
        -> Parallel index lookup on t2 using f1 (f1=t1.f1), with index condition: ((t2.f2 between t1.f1 and t1.f2) and ((t2.f2 + 1) >= (t1.f1 + 1)))  (cost=0.706 rows=1.75)

explain format=tree select * from t1;
EXPLAIN
-> Gather: 4 workers, parallel scan on t1  (cost=0.325 rows=3)
    -> Parallel table scan on t1  (cost=0.325 rows=0.75)

explain format=tree select sum(f2) from t2 group by f1 order by f1 limit 2;
EXPLAIN
-> Limit: 2 row(s)  (cost=0.232 rows=1.41)
    -> Group aggregate: sum(t2.f2)  (cost=0.232 rows=1.41)
        -> Index scan on t2 using f1  (cost=0.0321 rows=2)

explain format=tree select sum(f2) from t2 where f1 > 2 group by f1 order by f1 limit 2;
EXPLAIN
-> Limit: 2 row(s)  (cost=3.86 rows=2)
    -> Group aggregate: sum(t2.f2)  (cost=3.86 rows=4)
        -> Covering index range scan on t2 using f1 over (2 < f1)  (cost=2.66 rows=12)

explain format=tree select * from t2 where f1 = 3;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=0.8 rows=4)
    -> Parallel index lookup on t2 using f1 (f1=3)  (cost=0.8 rows=1)

drop table t1,t2;
SET @optimizer_switch_saved= @@optimizer_switch;
set @@optimizer_switch='batched_key_access=off,block_nested_loop=off,mrr_cost_based=off';
CREATE TABLE t1 ( f1 INT PRIMARY KEY );
INSERT INTO t1 VALUES (1), (2), (3);
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
EXPLAIN FORMAT=tree SELECT * FROM t1, ( SELECT f1 FROM t1 UNION SELECT f1 + 10 FROM t1 ) d1;
EXPLAIN
-> Gather: 4 workers, parallel scan on d1  (cost=2.93 rows=18)
    -> Nested loop inner join  (cost=2.93 rows=4.5)
        -> Index scan on t1 using PRIMARY  (cost=0.55 rows=3)
        -> Parallel table scan on d1  (cost=2.92..3.76 rows=1.5)
            -> Union materialize with deduplication  (cost=1.25..1.25 rows=6)
                -> Gather: 4 workers, parallel scan on t1  (cost=0.325 rows=3)
                    -> Parallel index scan on t1 using PRIMARY  (cost=0.325 rows=0.75)
                -> Gather: 4 workers, parallel scan on t1  (cost=0.325 rows=3)
                    -> Parallel index scan on t1 using PRIMARY  (cost=0.325 rows=0.75)

EXPLAIN FORMAT=tree SELECT * FROM t1, ( SELECT f1 FROM t1 UNION ALL SELECT f1 + 10 FROM t1 ) d1;
EXPLAIN
-> Gather: 4 workers, parallel scan on d1  (cost=2.93 rows=18)
    -> Nested loop inner join  (cost=2.93 rows=4.5)
        -> Index scan on t1 using PRIMARY  (cost=0.55 rows=3)
        -> Parallel table scan on d1  (cost=2.92..3.76 rows=1.5)
            -> Union all materialize  (cost=1.25..1.25 rows=6)
                -> Gather: 4 workers, parallel scan on t1  (cost=0.325 rows=3)
                    -> Parallel index scan on t1 using PRIMARY  (cost=0.325 rows=0.75)
                -> Gather: 4 workers, parallel scan on t1  (cost=0.325 rows=3)
                    -> Parallel index scan on t1 using PRIMARY  (cost=0.325 rows=0.75)

SET @@optimizer_switch=@optimizer_switch_saved;
DROP TABLE t1;
