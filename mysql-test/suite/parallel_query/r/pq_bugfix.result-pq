set parallel_rows_threshold = @saved_parallel_rows_threshold;
# BUG2022081003200 
# 3 tests cases
# test 1
# Bug itself - should not allow to cut the inner/build table because there is a LIMIT_OFFSET access_path.
# firstmatch alone is not enough to create an issue, the query plan has to convert it to a LIMIT clause
# test 2
# Inner table can be cut (firstmatch but no limit clause)
# It shows that inner table cutting restriction is not too coarse.
# test 3 
# FirstMatch is deactivated
# Should not cut because there is a limit clause in the query plan.
# test 1
CREATE TABLE ta(a int);
INSERT INTO ta VALUES (2),(2),(2),(2);
CREATE TABLE tb (b varchar(255),c varchar(255));
INSERT INTO tb VALUES (1,2),(2,3),(3,3);
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
SET parallel_default_dop=2;
# There should not be a parallel table scan of the inner table
ANALYZE TABLE ta, tb;
Table	Op	Msg_type	Msg_text
test.ta	analyze	status	OK
test.tb	analyze	status	OK
SELECT * FROM ta WHERE EXISTS (SELECT * FROM tb);
a
2
2
2
2
EXPLAIN FORMAT=tree SELECT * FROM ta WHERE EXISTS (SELECT * FROM tb);
EXPLAIN
-> Gather: 2 workers, parallel scan on ta  (...)
    -> Inner hash join, one hash table per worker (no condition)  (...)
        -> Parallel table scan on ta  (...)
        -> Hash
            -> Limit: 1 row(s)  (...)
                -> Table scan on tb  (...)

# test 1 - modified
CREATE TABLE tc (d varchar(255), e varchar(255));
INSERT INTO tc VALUES (1,2),(2,3),(3,3);
ANALYZE TABLE tc;
Table	Op	Msg_type	Msg_text
test.tc	analyze	status	OK
# Cutting tb returns the wrong answer - cutting tc does not, likely because there
# are not enough rows in tc: Haven't managed to  get large tc with // scan,
# but should it happen, it will be a problem. It is therefore not allowed.
EXPLAIN format=tree SELECT * FROM ta WHERE EXISTS (SELECT * FROM tc,tb);
EXPLAIN
-> Gather: 2 workers, parallel scan on ta  (...)
    -> Inner hash join, one hash table per worker (no condition)  (...)
        -> Parallel table scan on ta  (...)
        -> Hash
            -> Limit: 1 row(s)  (...)
                -> Nested loop inner join  (...)
                    -> Table scan on tc  (...)
                    -> Table scan on tb  (...)

SELECT * FROM ta WHERE EXISTS (SELECT * FROM tc,tb);
a
2
2
2
2
drop table ta,tb,tc;
