(PARTITION smalldata VALUES LESS THAN (100) ENGINE = InnoDB,
PARTITION mediumdata VALUES LESS THAN (200) ENGINE = InnoDB,
PARTITION bigdata VALUES LESS THAN (256) ENGINE = InnoDB) */;
