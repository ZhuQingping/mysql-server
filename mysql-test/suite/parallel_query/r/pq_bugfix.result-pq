CREATE VIEW `tx_cmplx_0061` AS
SELECT `subq_0`.`c4` AS `c1`,
`subq_0`.`c4` AS `c2`
FROM (
(SELECT `ref_0`.`C_ID` AS `c4`
         FROM `t12` `ref_0`
         WHERE (`ref_0`.`C_DELIVERY_CNT` IS NOT NULL)) `subq_0`
      LEFT JOIN
(SELECT `ref_3`.`C_W_ID` AS `c0`
         FROM (`t12` `ref_1`
               JOIN (`t12` `ref_3`
                     LEFT JOIN `t2` `ref_2` on((`ref_2`.`id_col` = `ref_3`.`C_ID`))) on(TRUE))
WHERE FALSE) `subq_1` on(FALSE))
GROUP BY `subq_0`.`c4`,
`subq_0`.`c4`;
