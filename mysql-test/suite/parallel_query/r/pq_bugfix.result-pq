        -> Temporary table  (cost=0.45..0.45 rows=1)
            -> Table scan on t0  (cost=0.35 rows=1)

SELECT DISTINCT CAST(x.x AS UNSIGNED) w
FROM t0 JOIN (SELECT count(*)) x(x) ORDER BY w;
w
DROP TABLE t0;
# BUG2023080801777
# For PQ, it copy the saved condition which is before optimize phase.
# Optimizer will inject cast nodes into condition. So PQ will have
# different condition with the origin plan, which causes PQ have
# wrong result.
# Fix: inject cast nodes after copy the condition.
CREATE TABLE t0 (c0 INT, c1 DATETIME(4), c2 INT);
CREATE TABLE t1 (c0 INT);
