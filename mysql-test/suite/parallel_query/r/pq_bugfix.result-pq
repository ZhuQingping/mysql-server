        -> Inner hash join, one hash table per worker (no condition)  (cost=0.363 rows=0.25)
            -> Table scan on t0  (cost=0.35 rows=1)
            -> Hash
                -> Parallel table scan on t1  (cost=0.275 rows=0.25)
