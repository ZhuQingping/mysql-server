Warning	1292	Truncated incorrect sort_buffer_size value: '8192'
set debug='+d, pq_worker_error1, pq_worker_failed';
SELECT COUNT(*) FROM (SELECT a, b, (SELECT x FROM t2 WHERE y=b ORDER BY z DESC LIMIT 1) c FROM t1) t;
