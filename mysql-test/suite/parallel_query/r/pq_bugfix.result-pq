# A few simple tests that reproduce the issue in BUG2022112303416
# Before the patch, we return 02:59:59.000000 instead of NULL
# or foo ( for the IFNULL test)
# The memcpy we added make sure that the correct information 
# about the nullity of a column is stored in the pq joins. 
create table t1 ( a  decimal(25,5) DEFAULT NULL, b time(6) DEFAULT NULL, index(b));
create table t2 ( a  decimal(25,5) DEFAULT NULL, b time(6) DEFAULT NULL, INDEX(b));
insert into  t1 values (1,'02:59:59.000000'),(3,'02:59:59.000001'),(5,'02:59:59.000001');
insert into  t2 values (1,'02:59:59.000000'),(3,'02:59:59.000001'),(5,'02:59:59.000001');
select  A.a, A.b from t1 A RIGHT JOIN t2 B ON A.b < NULL 
WHERE A.b IS UNKNOWN OR A.b IN ('02:00:00.000001','02:59:59.000000');
a	b
NULL	NULL
NULL	NULL
NULL	NULL
select /*+NO_PQ*/ A.a, A.b from t1 A RIGHT JOIN t2 B ON A.b < NULL 
WHERE A.b IS UNKNOWN OR A.b IN ('02:00:00.000001','02:59:59.000000');
a	b
NULL	NULL
NULL	NULL
NULL	NULL
select  IFNULL(A.b,"foo") from t1 A RIGHT JOIN t2 B ON A.b < NULL  
WHERE A.b IS UNKNOWN OR A.b IN ('02:00:00.000001','02:59:59.000000');
IFNULL(A.b,"foo")
foo
foo
foo
select /*+NO_PQ*/ IFNULL(A.b,"foo") from t1 A RIGHT JOIN t2 B ON A.b < NULL 
WHERE A.b IS UNKNOWN OR A.b IN ('02:00:00.000001','02:59:59.000000');
IFNULL(A.b,"foo")
foo
foo
foo
