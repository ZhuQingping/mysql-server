`user_id` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '用户ID',
`amount` decimal(20,4) DEFAULT NULL COMMENT '金额',
`order_no` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '订单号',
`is_delete` int NOT NULL DEFAULT '0' COMMENT '是否删除 0:否 1:是',
`recharge_status` int DEFAULT NULL COMMENT '充值状态 1.待处理 2.成功 3.失败',
`is_pa` int DEFAULT NULL COMMENT '是否处理过 1 是',
`channel` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '渠道 system:系统生成 C:客户生成',
PRIMARY KEY (`id`),
KEY `idx_channel_userId` (`channel`,`user_id`) USING BTREE,
KEY `idx_is_pa_is_delete_recharge_status_channel` (`is_pa`,`is_delete`,`recharge_status`,`channel`)
) ENGINE=InnoDB AUTO_INCREMENT=11 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='账户变动日志';
