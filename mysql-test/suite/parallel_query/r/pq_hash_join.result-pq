# BUG2021120300060
#
# The following test case is probably way more complex than it needs to
# be, but I haven't found any way to simplify it further. What we want to
# achieve is a parallel-aware hash join below a weedout, where the build
# input contains a parallel-oblivious hash join with a materialize iterator
# as its probe input. In ASCII art, we want something that looks like this:
#
#              weedout
#                 |
#      hash join, parallel-aware
#      |                       |
#  hash join                  t3
#  |       |
#  t1  materialize
#          |
#         t2
#
CREATE TABLE t1 (s VARCHAR(255), INDEX idx (s));
INSERT INTO t1 SELECT UUID();
INSERT INTO t1 SELECT UUID() FROM t1;
INSERT INTO t1 SELECT UUID() FROM t1;
INSERT INTO t1 SELECT UUID() FROM t1;
INSERT INTO t1 SELECT UUID() FROM t1;
INSERT INTO t1 SELECT UUID() FROM t1;
INSERT INTO t1 SELECT UUID() FROM t1;
INSERT INTO t1 SELECT UUID() FROM t1;
INSERT INTO t1 SELECT UUID() FROM t1;
CREATE TABLE t2 (i INTEGER);
INSERT INTO t2 SELECT RAND(1) * 1000 FROM t1 LIMIT 27;
CREATE TABLE t3 (i INTEGER, INDEX idx (i));
INSERT INTO t3 SELECT IF(RAND(1) > 0.5, NULL, RAND(1) * 1000) FROM t1 LIMIT 50;
CREATE TABLE t4 (i INTEGER);
INSERT INTO t4 SELECT 1 FROM t1 LIMIT 27;
CREATE VIEW view1 AS
SELECT 1 FROM t1
UNION ALL
SELECT 1 FROM t1;
CREATE VIEW view2 AS
SELECT
subq_1.c0 AS c1
FROM
(SELECT pi() AS c0, subq_0.c0 AS c1 FROM
(t2 LEFT JOIN
(SELECT 1 AS c0 FROM t3 ref_1 WHERE (ref_1.i IS NULL)) subq_0
ON (subq_0.c0 IS NOT NULL))) subq_1
GROUP BY subq_1.c1, subq_1.c0;
CREATE VIEW view3 AS
SELECT
subq_0.c2 AS c2
FROM
(SELECT
i AS c2 FROM t4) subq_0
GROUP BY subq_0.c2
ORDER BY subq_0.c2;
ANALYZE TABLE t1, t2, t3, t4;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK
test.t3	analyze	status	OK
test.t4	analyze	status	OK
EXPLAIN FORMAT=tree SELECT /*+ PQ(ref_12 4) */
1
FROM
view1 AS ref_9
INNER JOIN t1 AS ref_11 ON (false)
RIGHT JOIN t1 AS ref_12
LEFT JOIN view2 AS ref_13
INNER JOIN t1 AS ref_14 ON (true)
ON (EXISTS (
SELECT
ref_15.c2 AS c0
FROM
view3 AS ref_15
WHERE ref_14.s IS NOT NULL))
ON (ref_13.c1 IS NOT NULL);
EXPLAIN
-> Gather: 4 workers, parallel scan on ref_12  (cost=32881 rows=256)
    -> Left hash join, one hash table per worker (no condition)  (cost=32881 rows=64)
        -> Remove duplicate (ref_12, ref_14, ref_13) rows using temporary table (weedout)  (cost=2838 rows=64)
            -> Left hash join, one hash table per worker (no condition)  (cost=2838 rows=64)
                -> Parallel index scan on ref_12 using idx  (cost=7.15 rows=64)
                -> Hash
                    -> Filter: (ref_14.s is not null)  (cost=2831 rows=0)
                        -> Inner hash join, one hash table per worker (no condition)  (cost=2831 rows=0)
                            -> Table scan on ref_13  (cost=187..198 rows=675)
                                -> Materialize  (cost=187..187 rows=675)
                                    -> Table scan on <temporary>  (cost=109..119 rows=675)
                                        -> Temporary table with deduplication  (cost=109..109 rows=675)
                                            -> Gather: 4 workers, parallel scan on t2  (cost=36.4..41 rows=675)
                                                -> Table scan on <temporary>  (cost=36.4..41 rows=169)
                                                    -> Temporary table with deduplication  (cost=36.4..36.4 rows=169)
                                                        -> Nested loop left join  (cost=19.5 rows=169)
                                                            -> Parallel table scan on t2  (cost=0.925 rows=6.75)
                                                            -> Filter: ((1 is not null) and (ref_1.i is null))  (cost=0.351 rows=25)
                                                                -> Covering index lookup on ref_1 using idx (i=NULL)  (cost=0.351 rows=25)
                            -> Hash
                                -> Inner hash join, one hash table per worker (no condition)  (cost=3.37 rows=0)
                                    -> Index scan on ref_14 using idx  (cost=0.103 rows=256)
                                    -> Hash
                                        -> Table scan on ref_15  (cost=2.5..2.5 rows=0)
                                            -> Materialize  (cost=0..0 rows=0)
                                                -> Sort: subq_0.c2
                                                    -> Table scan on <temporary>  (cost=6.98..9.71 rows=27)
                                                        -> Temporary table with deduplication  (cost=6.88..6.88 rows=27)
                                                            -> Gather: 4 workers, parallel scan on t4  (cost=1.7..4.17 rows=27)
                                                                -> Table scan on <temporary>  (cost=1.98..4.17 rows=6.75)
                                                                    -> Temporary table with deduplication  (cost=1.6..1.6 rows=6.75)
                                                                        -> Parallel table scan on t4  (cost=0.925 rows=6.75)
        -> Hash
            -> Zero rows (Impossible filter)  (cost=0..0 rows=0)

