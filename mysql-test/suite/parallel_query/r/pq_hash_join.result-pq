#
# BUG2022112202646 For parallel-aware hash join, if cut table is under the
#                  WEEDOUT, it will result duplicate results. Because for
#                  workers, it just remove duplicate in worker, not between
#                  workers. So WEEDOUT can not contain cut table.
#                  Due to this scenario is related to big distribution and
#                  big data, only related execution plan is displayed here.
SET @@optimizer_switch = @save_optimizer_switch;
CREATE TABLE t1 (
id_col int NOT NULL AUTO_INCREMENT,
mediumint_col mediumint DEFAULT NULL,
decimal_col decimal(25,5) DEFAULT NULL,
PRIMARY KEY (id_col DESC),
KEY ndx_mediumint_decimal_col (mediumint_col DESC, decimal_col DESC)
) ENGINE=InnoDB AUTO_INCREMENT=114 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
CREATE TABLE t2 (
id_col int NOT NULL AUTO_INCREMENT,
mediumint_col mediumint DEFAULT NULL,
decimal_col decimal(25,5) DEFAULT NULL,
PRIMARY KEY (id_col DESC)
) ENGINE=InnoDB AUTO_INCREMENT=114 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
CREATE TABLE t3 (
id_col int NOT NULL,
mediumint_col mediumint DEFAULT NULL,
decimal_col decimal(25,5) DEFAULT NULL,
float_col float DEFAULT NULL,
datetimelist_col datetime(6) NOT NULL,
PRIMARY KEY (datetimelist_col DESC, id_col DESC),
KEY ndx_decimal_float_col (datetimelist_col DESC, decimal_col DESC, float_col DESC)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SET optimizer_switch="loosescan=off,firstmatch=off";
# The origin execution plan choose C as cut table. After fixed, the cut table can
# not under WEEDOUT
EXPLAIN FORMAT=tree WITH A AS (SELECT /*+PQ(C, B)*/ A.decimal_col, A.mediumint_col FROM t1 A JOIN t2 B ON A.decimal_col = B.decimal_col AND A.mediumint_col = B.mediumint_col WHERE (A.decimal_col, A.mediumint_col) = ANY (SELECT decimal_col, mediumint_col FROM t3 C WHERE (C.datetimelist_col = '1984-02-01 00:00:00' OR C.datetimelist_col = '1984-02-29 23:59:59') AND C.decimal_col > 0.00000)) SELECT /*+join_order(A,C,B)*/ A.decimal_col, RADIANS(A.mediumint_col) FROM A WHERE A.mediumint_col > 1 ORDER BY 1, 2;
EXPLAIN
-> Sort: a.decimal_col, `RADIANS(A.mediumint_col)`
    -> Stream results  (cost=*** rows=***)
        -> Gather: 4 workers, parallel scan on B  (cost=*** rows=***)
            -> Table scan on <temporary>  (cost=*** rows=***)
                -> Temporary table  (cost=*** rows=***)
                    -> Inner hash join, one hash table per worker (b.mediumint_col = a.mediumint_col), (b.decimal_col = a.decimal_col)  (cost=*** rows=***)
                        -> Parallel table scan on B  (cost=*** rows=***)
                        -> Hash
                            -> Remove duplicate A rows using temporary table (weedout)  (cost=*** rows=***)
                                -> Inner hash join, one hash table per worker (c.mediumint_col = a.mediumint_col), (c.decimal_col = a.decimal_col)  (cost=*** rows=***)
                                    -> Filter: ((c.datetimelist_col = TIMESTAMP'1984-02-01 00:00:00') or (c.datetimelist_col = TIMESTAMP'1984-02-29 23:59:59'))  (cost=*** rows=***)
                                        -> Index range scan on C using PRIMARY over (datetimelist_col = '1984-02-29 23:59:59.000000') OR (datetimelist_col = '1984-02-01 00:00:00.000000')  (cost=*** rows=***)
                                    -> Hash
