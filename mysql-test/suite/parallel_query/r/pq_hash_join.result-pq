# Start out simple: see that a simple parallel-oblivious hash join
# without any re-fill of the hash table works as expected.
CREATE TABLE t (i INTEGER);
INSERT INTO t VALUES (1), (2), (3);
ANALYZE TABLE t;
Table	Op	Msg_type	Msg_text
test.t	analyze	status	OK
EXPLAIN FORMAT=tree SELECT /*+ PQ(t 2) */ * FROM t JOIN t t2 ON t.i = t2.i;
EXPLAIN
-> Gather: 2 workers, parallel scan on t  (cost=*** rows=***)
    -> Inner hash join, one hash table per worker (t2.i = t.i)  (cost=*** rows=***)
        -> Table scan on t2  (cost=*** rows=***)
        -> Hash
            -> Parallel table scan on t  (cost=*** rows=***)

SELECT /*+ PQ(t 2) */ * FROM t JOIN t t2 ON t.i = t2.i;
i	i
1	1
2	2
3	3
EXPLAIN FORMAT=tree SELECT /*+ PQ(t 64) */ * FROM t JOIN t t2 ON t.i = t2.i;
EXPLAIN
-> Gather: 64 workers, parallel scan on t  (cost=*** rows=***)
    -> Inner hash join, one hash table per worker (t2.i = t.i)  (cost=*** rows=***)
        -> Table scan on t2  (cost=*** rows=***)
        -> Hash
            -> Parallel table scan on t  (cost=*** rows=***)

SELECT /*+ PQ(t 64) */ * FROM t JOIN t t2 ON t.i = t2.i;
i	i
1	1
2	2
3	3
DROP TABLE t;
