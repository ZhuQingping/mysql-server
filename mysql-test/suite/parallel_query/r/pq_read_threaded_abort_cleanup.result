DROP TABLE IF EXISTS t1;
CREATE TABLE t1 (id INT PRIMARY KEY, pad CHAR(100)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,'a');
INSERT INTO t1 SELECT id + 1, pad FROM t1;
INSERT INTO t1 SELECT id + 2, pad FROM t1;
INSERT INTO t1 SELECT id + 4, pad FROM t1;
INSERT INTO t1 SELECT id + 8, pad FROM t1;
INSERT INTO t1 SELECT id + 16, pad FROM t1;
INSERT INTO t1 SELECT id + 32, pad FROM t1;
INSERT INTO t1 SELECT id + 64, pad FROM t1;
INSERT INTO t1 SELECT id + 128, pad FROM t1;
INSERT INTO t1 SELECT id + 256, pad FROM t1;
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=1;
SET @old_debug=@@session.debug;
SET SESSION debug="d,pq_read_threaded_shadow_path,pq_read_threaded_shadow_abort_after_start";
SET @pq_executed_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_workers_before = (
SELECT CAST(variable_value AS UNSIGNED)
FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched');
SELECT * FROM t1;
ERROR HY000: Got error 122 - 'Internal (unspecified) error in handler' from storage engine
SELECT
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
AS executed_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
AS fallback_delta,
(SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
AS workers_delta;
executed_delta	fallback_delta	workers_delta
0	0	1
SET SESSION debug=@old_debug;
SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;
SELECT COUNT(*) AS serial_count FROM t1;
serial_count
512
DROP TABLE t1;
