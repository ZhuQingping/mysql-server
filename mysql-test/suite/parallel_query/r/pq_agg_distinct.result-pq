create table t1 (id integer primary key not null auto_increment, gender char(1));
insert into t1 values (NULL, 'M'), (NULL, 'F'),(NULL, 'F'),(NULL, 'F'),(NULL, 'M');
create table t2 (user_id integer not null, date date);
insert into t2 values (1, '2002-06-09'),(2, '2002-06-09'),(1, '2002-06-09'),(3, '2002-06-09'),(4, '2002-06-09'),(4, '2002-06-09');
explain format=tree select u.gender as gender, count(distinct  u.id) as dist_count, (count(distinct u.id)/5*100) as percentage from t1 u, t2 l where l.user_id = u.id group by u.gender;
EXPLAIN
-> Group aggregate: count(distinct t1.id), count(distinct t1.id)
    -> Sort: u.gender
        -> Stream results  (cost=2.95 rows=6)
            -> Nested loop inner join  (cost=2.95 rows=6)
                -> Table scan on l  (cost=0.85 rows=6)
                -> Single-row index lookup on u using PRIMARY (id=l.user_id)  (cost=0.267 rows=1)

select u.gender as gender, count(distinct  u.id) as dist_count, (count(distinct u.id)/5*100) as percentage from t1 u, t2 l where l.user_id = u.id group by u.gender;
gender	dist_count	percentage
F	3	60.0000
M	1	20.0000
