CREATE TABLE pq_read_threaded_thread_budget_refuse_t (
id INT PRIMARY KEY,
v INT
) ENGINE=InnoDB;
INSERT INTO pq_read_threaded_thread_budget_refuse_t VALUES (1,10),(2,20);
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=1;
SET @threads_refused_before = (
SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'PQ_threads_refused');
SET @threads_running_before = (
SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'PQ_threads_running');
SET @workers_launched_before = (
SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_workers_launched');
SET @old_debug=@@session.debug;
SET SESSION debug="d,pq_read_threaded_shadow_path,pq_read_threaded_force_thread_budget_refuse";
SELECT id, v FROM pq_read_threaded_thread_budget_refuse_t WHERE v >= 0;
ERROR HY000: Got error 122 - 'Internal (unspecified) error in handler' from storage engine
SET SESSION debug=@old_debug;
SELECT (
(SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'PQ_threads_refused') -
@threads_refused_before) AS threads_refused_delta;
threads_refused_delta
1
SELECT (
(SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'PQ_threads_running') -
@threads_running_before) AS threads_running_delta;
threads_running_delta
0
SELECT (
(SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'Parallel_workers_launched') -
@workers_launched_before) AS workers_launched_delta;
workers_launched_delta
0
SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
SET SESSION parallel_default_dop=4;
DROP TABLE pq_read_threaded_thread_budget_refuse_t;
