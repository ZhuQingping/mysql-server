(333, "Yasmina", NULL),
(198, "John", 333),
(692, "Tarek", 333),
(29, "Pedro", 198),
(4610, "Sarah", 29),
(72, "Pierre", 29),
(123, "Adil", 692);
ANALYZE TABLE employees;
Table	Op	Msg_type	Msg_text
test.employees	analyze	status	OK
SET @save_big_tables = @@big_tables;
SET big_tables = 1;
EXPLAIN FORMAT=tree WITH RECURSIVE employees_extended(ID, NAME, PATH)
AS
(
SELECT ID, NAME, CAST(ID AS CHAR(200))
FROM employees
WHERE MANAGER_ID IS NULL
UNION ALL
SELECT S.ID, S.NAME, CONCAT(M.PATH, ",", S.ID)
FROM employees_extended M STRAIGHT_JOIN employees S ON M.ID=S.MANAGER_ID
),
JOHN_ID AS (SELECT ID FROM employees WHERE NAME='John')
SELECT e.* FROM employees_extended e, JOHN_ID
WHERE FIND_IN_SET(JOHN_ID.ID,
PATH)
AND e.ID<>JOHN_ID.ID;
EXPLAIN
-> Filter: ((0 <> find_in_set(employees.ID,e.`PATH`)) and (e.ID <> employees.ID))  (...)
    -> Inner hash join, one hash table per worker (no condition)  (...)
        -> Table scan on e  (...)
            -> Materialize recursive CTE employees_extended  (...)
                -> Index lookup on employees using MANAGER_ID (MANAGER_ID=NULL), with index condition: (employees.MANAGER_ID is null)  (...)
                -> Repeat until convergence
                    -> Nested loop inner join  (...)
                        -> Filter: (M.ID is not null)  (...)
                            -> Scan new records on M  (...)
                        -> Index lookup on S using MANAGER_ID (MANAGER_ID=M.ID)  (...)
        -> Hash
            -> Filter: (employees.`NAME` = 'John')  (...)
                -> Table scan on employees  (...)

WITH RECURSIVE employees_extended(ID, NAME, PATH)
AS
(
SELECT ID, NAME, CAST(ID AS CHAR(200))
FROM employees
WHERE MANAGER_ID IS NULL
UNION ALL
SELECT S.ID, S.NAME, CONCAT(M.PATH, ",", S.ID)
FROM employees_extended M STRAIGHT_JOIN employees S ON M.ID=S.MANAGER_ID
),
JOHN_ID AS (SELECT ID FROM employees WHERE NAME='John')
SELECT e.* FROM employees_extended e, JOHN_ID
WHERE FIND_IN_SET(JOHN_ID.ID,
PATH)
AND e.ID<>JOHN_ID.ID;
