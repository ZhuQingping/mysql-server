--source include/pq_test.inc
INSTALL PLUGIN audit_log SONAME 'audit_log.so';

create table t1(id int);
create table t2(id int);

--echo # connect 1
connect(conn1,localhost,root,,);
SET parallel_default_dop=64;
select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;
explain select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;

--echo # connect 2
connect(conn2,localhost,root,,);
SET parallel_default_dop=64;
select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;
explain select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;

--echo # connect 3
connect(conn3,localhost,root,,);
SET parallel_default_dop=64;
select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;
explain select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;

--echo # connect 4
connect(conn4,localhost,root,,);
SET parallel_default_dop=64;
select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;
explain select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;

--echo # connect 5
connect(conn5,localhost,root,,);
SET parallel_default_dop=64;
select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;
explain select t2.id,t1.id from t2 inner join t1 on t2.id = t1.id GROUP BY 1,2 ORDER BY 1,2 limit 10 offset 1;

connection default;
disconnect conn1;
disconnect conn2;
disconnect conn3;
disconnect conn4;
disconnect conn5;
drop table t1;
drop table t2;

UNINSTALL PLUGIN AUDIT_LOG;
--source include/disconnect_connections.inc
