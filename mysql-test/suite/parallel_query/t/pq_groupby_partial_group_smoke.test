# Test: pq_groupby_partial_group_smoke
# V2-12B: PARTIAL_GROUP payload v1 wire-protocol and worker partial producer
# smoke. Worker group counters observe non-empty worker ranges; empty workers
# still send FINISH but do not contribute a partial group. This does not enable
# SQL GROUP BY DOP>1 execution.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (id INT PRIMARY KEY, val INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10),(2,20),(3,30),(4,40);

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;

SET @pq_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_partial_groups_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_exchange_partial_group_smoke_rows');
SET @pq_partial_finishes_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_exchange_partial_group_smoke_finishes');
SET @pq_partial_payload_errors_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_partial_payload_errors');
SET @pq_dop_partial_worker_groups_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop_partial_worker_groups');
SET @pq_dop_partial_merged_groups_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop_partial_merged_groups');

--disable_result_log
SELECT * FROM t1;
--enable_result_log

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
    AS fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_exchange_partial_group_smoke_rows') -
      @pq_partial_groups_before
    AS partial_group_rows_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_exchange_partial_group_smoke_finishes') -
      @pq_partial_finishes_before
    AS partial_group_finishes_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_groupby_partial_payload_errors') -
      @pq_partial_payload_errors_before >= 3
    AS partial_group_payload_errors_observed,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_groupby_dop_partial_worker_groups') -
      @pq_dop_partial_worker_groups_before
    AS dop_partial_worker_groups_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_groupby_dop_partial_merged_groups') -
      @pq_dop_partial_merged_groups_before
    AS dop_partial_merged_groups_delta;

SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;
