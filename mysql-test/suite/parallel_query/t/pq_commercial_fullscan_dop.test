# Test: pq_commercial_fullscan_dop
# Commercial DOP resolver coverage for default clustered fullscan.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (id INT PRIMARY KEY, val INT, pad CHAR(16)) ENGINE=InnoDB;
INSERT INTO t1 VALUES
  (1,10,'a'),(2,20,'a'),(3,30,'a'),(4,40,'a'),
  (5,50,'a'),(6,60,'a'),(7,70,'a'),(8,80,'a'),
  (9,90,'a'),(10,100,'a'),(11,110,'a'),(12,120,'a'),
  (13,130,'a'),(14,140,'a'),(15,150,'a'),(16,160,'a');

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_query_experimental_threaded_dop=OFF;
SET SESSION parallel_query_experimental_threaded_dop4=OFF;

# DOP0 is accepted by the commercial sysvar contract but does not start PQ.
SET SESSION parallel_default_dop=0;
SET @pq_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');

SELECT COUNT(*) AS row_count, SUM(val) AS sum_val FROM t1;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
    AS executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
    AS fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_rows_scanned') - @pq_rows_before
    AS rows_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
    AS workers_delta;

# DOP3 uses the default threaded visible void-pull fullscan path.
SET SESSION parallel_default_dop=3;
SET @pq_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');
SET @threaded_void_selected_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_void_pull_threaded_selected');
SET @threaded_void_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_void_pull_threaded_rows');
SET @threaded_void_finishes_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_void_pull_threaded_finishes');
SET @threaded_void_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_void_pull_threaded_workers');
SET @threaded_void_failures_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_void_pull_threaded_failures');

SELECT COUNT(*) AS row_count, SUM(val) AS sum_val FROM t1;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
    AS executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
    AS fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_rows_scanned') - @pq_rows_before
    AS rows_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
    AS workers_delta;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_void_pull_threaded_selected') -
    @threaded_void_selected_before AS threaded_void_selected_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_void_pull_threaded_rows') -
    @threaded_void_rows_before AS threaded_void_rows_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_void_pull_threaded_finishes') -
    @threaded_void_finishes_before AS threaded_void_finishes_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_void_pull_threaded_workers') -
    @threaded_void_workers_before AS threaded_void_workers_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_void_pull_threaded_failures') -
    @threaded_void_failures_before AS threaded_void_failures_delta;

# DOP5 follows the same resolver path.
SET SESSION parallel_default_dop=5;
SET @pq_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');
SET @threaded_void_selected_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_void_pull_threaded_selected');
SET @threaded_void_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_void_pull_threaded_rows');
SET @threaded_void_finishes_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_void_pull_threaded_finishes');
SET @threaded_void_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_void_pull_threaded_workers');
SET @threaded_void_failures_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_void_pull_threaded_failures');

SELECT COUNT(*) AS row_count, SUM(val) AS sum_val FROM t1;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
    AS executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
    AS fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_rows_scanned') - @pq_rows_before
    AS rows_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
    AS workers_delta;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_void_pull_threaded_selected') -
    @threaded_void_selected_before AS threaded_void_selected_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_void_pull_threaded_rows') -
    @threaded_void_rows_before AS threaded_void_rows_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_void_pull_threaded_finishes') -
    @threaded_void_finishes_before AS threaded_void_finishes_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_void_pull_threaded_workers') -
    @threaded_void_workers_before AS threaded_void_workers_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_void_pull_threaded_failures') -
    @threaded_void_failures_before AS threaded_void_failures_delta;

# The sysvar accepts the commercial upper range, but the current execution
# engine still fails closed above the InnoDB PQ thread cap.
SET SESSION parallel_default_dop=1024;
SET @pq_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');

SELECT COUNT(*) AS row_count, SUM(val) AS sum_val FROM t1;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
    AS executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
    AS fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_rows_scanned') - @pq_rows_before
    AS rows_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
    AS workers_delta;

SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
SET SESSION parallel_default_dop=4;

DROP TABLE t1;
