ANALYZE TABLE t0,t1,t2,t10,t12;

let $query=
select  /*+ pq(ref_0) pq(2) */ straight_join ref_8.C_SINCE AS c3 from t10 ref_21 left join (t2 ref_16 left join t1 ref_17 on(false) left join (t12 ref_8 left join (t2 ref_11 join t1 ref_10 left join t12 ref_9 on((ref_9.C_D_ID = ref_10.c_d_id))) on((false)) join t10 ref_7 join t0 ref_14 left join t10 ref_15 on(false)) on((false))) on(false) join t1 ref_0 where true limit 1;

--replace_regex $elide_costs_and_rows
eval explain format=tree $query;
eval $query;

drop table t0,t1,t2,t10,t12;
SET sql_mode=@old_sql_mode;
SET optimizer_switch=@old_optimizer_switch;

--echo #
--echo # BUG2023080802023: Debug assertion failure DBUG_ASSERT(!is_null_row) in function FakeSingleRowIterator::SetNullRowFlag
--echo #
CREATE TABLE t0 (c0 int DEFAULT NULL);
let $query=SELECT 1 FROM (SELECT 'a')w(w) LEFT JOIN (SELECT 'b' FROM t0) x(x) ON x.x = w.w JOIN t0 ON t0.c0 = x.x;

--disable_warnings
--replace_column 10 # 11 #
eval EXPLAIN $query;
--replace_regex $elide_costs_and_rows
eval EXPLAIN FORMAT=TREE $query;
eval $query;
--enable_warnings

DROP TABLE t0;
