# Verify debug leader row stream returns visible row values through Read().

--source include/have_innodb_16k.inc
--source include/have_debug.inc

CREATE TABLE pq_row_value_t (
  id INT NOT NULL,
  v INT NOT NULL
) ENGINE=InnoDB;
INSERT INTO pq_row_value_t VALUES (1,10),(2,20);

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=1;

SET @stream_attempts_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_attempts');
SET @stream_selected_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_selected');
SET @stream_rows_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_rows');
SET @queries_executed_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed');
SET @queries_fallback_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_queries_fallback');
SET @workers_launched_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_workers_launched');
SET @rows_scanned_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_rows_scanned');
SET @probe_attempts_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_probe_attempts');
SET @worker_attach_attempts_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_attempts');
SET @worker_attach_success_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_success');
SET @worker_attach_cleanup_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_cleanup_calls');
SET @error_attempts_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_error_smoke_attempts');
SET @error_selected_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_error_smoke_selected');
SET @error_errors_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_error_smoke_errors');
SET @error_cleanup_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_error_smoke_cleanup');

SET @old_debug=@@session.debug;
SET SESSION debug="d,pq_leader_row_stream_smoke";
SELECT id, v FROM pq_row_value_t;
SET SESSION debug=@old_debug;

SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_attempts') -
  @stream_attempts_before) AS stream_attempt_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_selected') -
  @stream_selected_before) AS stream_selected_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_rows') -
  @stream_rows_before) AS stream_rows_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_queries_executed') -
  @queries_executed_before) AS queries_executed_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_queries_fallback') -
  @queries_fallback_before) AS queries_fallback_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_rows_scanned') -
  @rows_scanned_before) AS rows_scanned_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_workers_launched') -
  @workers_launched_before) AS workers_launched_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_probe_attempts') -
  @probe_attempts_before) AS probe_attempts_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_attempts') -
  @worker_attach_attempts_before) AS worker_attach_attempts_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_success') -
  @worker_attach_success_before) AS worker_attach_success_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_cleanup_calls') -
  @worker_attach_cleanup_before) AS worker_attach_cleanup_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_error_smoke_attempts') -
  @error_attempts_before) AS error_attempts_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_error_smoke_selected') -
  @error_selected_before) AS error_selected_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_error_smoke_errors') -
  @error_errors_before) AS error_errors_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_error_smoke_cleanup') -
  @error_cleanup_before) AS error_cleanup_delta;

SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
SET SESSION parallel_default_dop=4;

DROP TABLE pq_row_value_t;
