# Test: pq_commercial_group_by_deferred_boundary
# M10-C3: commercial-suite GROUP BY deferred boundary guard.
#
# These shapes are intentionally not claimed as supported by the current
# legacy typed-state subset or by the future commercial worker-plan path.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  grp INT NOT NULL,
  val INT NULL,
  txt VARCHAR(16) NOT NULL
) ENGINE=InnoDB;

INSERT INTO t1 VALUES
  (1,10,5,'a'),(2,10,NULL,'a'),
  (3,20,2,'b'),(4,20,9,'b');

SET @pq_partial_selected_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop_partial_selected');
SET @pq_partial_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop_partial_fallback');
SET @pq_legacy_selected_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_legacy_typed_selected');
SET @pq_legacy_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_legacy_typed_executed');
SET @pq_commercial_selected_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_commercial_selected');
SET @pq_commercial_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_commercial_executed');
SET @pq_groupby_shape_unsupported_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_temp_shape_unsupported');

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;
SET SESSION parallel_query_experimental_threaded_dop=ON;
SET SESSION parallel_query_experimental_groupby_dop1=ON;

--sorted_result
SELECT grp, COUNT(*) AS cnt FROM t1 GROUP BY grp HAVING cnt > 0;

--sorted_result
SELECT grp, COUNT(DISTINCT val) AS cnt FROM t1 GROUP BY grp;

--sorted_result
SELECT grp + 1 AS g, COUNT(*) AS cnt FROM t1 GROUP BY grp + 1;

--sorted_result
SELECT grp, SUM(val + 1) AS sum_expr FROM t1 GROUP BY grp;

--sorted_result
SELECT txt, COUNT(val) AS cnt FROM t1 GROUP BY txt;

SELECT grp, COUNT(*) AS cnt FROM t1 GROUP BY grp ORDER BY grp;

SELECT
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_groupby_dop_partial_selected') -
      @pq_partial_selected_before) = 0 AS partial_selected_delta_zero,
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_groupby_dop_partial_fallback') -
      @pq_partial_fallback_before) >= 1 AS partial_fallback_observed,
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_groupby_legacy_typed_selected') -
      @pq_legacy_selected_before) = 0 AS legacy_selected_delta_zero,
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_groupby_legacy_typed_executed') -
      @pq_legacy_executed_before) = 0 AS legacy_executed_delta_zero,
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_groupby_commercial_selected') -
      @pq_commercial_selected_before) = 0 AS commercial_selected_delta_zero,
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_groupby_commercial_executed') -
      @pq_commercial_executed_before) = 0 AS commercial_executed_delta_zero,
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_groupby_temp_shape_unsupported') -
      @pq_groupby_shape_unsupported_before) >= 1 AS unsupported_shape_observed;

SET SESSION parallel_query_experimental_groupby_dop1=OFF;
SET SESSION parallel_query_experimental_threaded_dop=OFF;
SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;
