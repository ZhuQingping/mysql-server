# Test: pq_explain_eligible
# Verify that EXPLAIN shows "Parallel query" annotation when PQ is eligible.
# A simple full scan on InnoDB table with low cost threshold should be eligible.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (id INT PRIMARY KEY, val INT, name VARCHAR(100)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10,'a'),(2,20,'b'),(3,30,'c'),(4,40,'d'),(5,50,'e');

# Turn PQ ON and lower cost threshold so small table qualifies
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;

# Simple full scan should be PQ eligible (no ORDER BY, GROUP BY, etc.)
EXPLAIN SELECT * FROM t1;

# FORMAT=TREE should also show PQ annotation
EXPLAIN FORMAT=TREE SELECT * FROM t1;

# FORMAT=JSON should also show PQ annotation
--replace_column 10 #
EXPLAIN FORMAT=JSON SELECT * FROM t1;

# With WHERE clause (still full table scan if no index on val)
EXPLAIN SELECT * FROM t1 WHERE val > 20;

# Reset
SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;