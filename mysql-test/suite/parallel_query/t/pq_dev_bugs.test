# issue 194, pq clone related issue
create table t(a int, b varchar(50))engine=innodb;
insert into t values(1, 'huawei'),(2, 'mysql');
analyze table t;
explain SELECT * FROM t WHERE b NOT LIKE 'check-mysqld_%';
SELECT * FROM t WHERE b NOT LIKE 'check-mysqld_%';
SELECT * FROM t WHERE b NOT LIKE 'check-mysqld_%';
DROP TABLE t;

# issue 197, correlated subquery related issue
CREATE TABLE t1 (
a int NOT NULL,
b char(10) NOT NULL
)engine=innodb;

CREATE TABLE t2 (
a int NOT NULL,
b char(10) NOT NULL
)engine=innodb;

INSERT INTO t1 values (1, 'a'), (2, 'b'), (3, 'c'), (3, 'c'), (4, 'd'), (5, 'f'), (6, 'e'),(8,'h'),(0,'j');
INSERT INTO t2 values (3, 'c'), (4, 'd'), (5, 'f'), (6, 'e'), (1, 'a'), (2, 'b'), (7, 'g'),(0,'i');

ANALYZE TABLE t1;
ANALYZE TABLE t2;

explain select t1.b from t1 group by t1.b having (select sum(t2.a) from t2 where t2.b=t1.b)>1;
select t1.b from t1 group by t1.b having (select sum(t2.a) from t2 where t2.b=t1.b)>1;
select t1.b from t1 group by t1.b having (select sum(t2.a) from t2 where t2.b=t1.b)>1;

DROP TABLE t1, t2;

# issue 198, uncorrelated subquery related issue
CREATE TABLE t (
  id INT PRIMARY KEY AUTO_INCREMENT,
  t1_id INT,
  d DECIMAL(10,2),
  e DATETIME,
  INDEX (t1_id)
) ENGINE=InnoDB;

INSERT INTO t (t1_id, d, e) VALUES
(1, 10.5, '2023-01-01 10:00:00'),
(2, 20.3, '2023-01-02 11:00:00'),
(3, 15.7, '2023-01-03 12:00:00'),
(1, 5.2, '2023-01-01 14:00:00'),
(4, 30.1, '2023-01-04 13:00:00'),
(5, 25.9, '2023-01-05 14:00:00'),
(2, 18.6, '2023-01-02 15:00:00'),
(6, 12.4, '2023-01-06 16:00:00'),
(7, 8.7, '2023-01-07 17:00:00'),
(8, 22.0, '2023-01-08 18:00:00');
ANALYZE TABLE t;

EXPLAIN SELECT * FROM (SELECT * FROM t LIMIT 4) AS derived;
SELECT * FROM (SELECT * FROM t LIMIT 4) AS derived;
SELECT * FROM (SELECT * FROM t LIMIT 4) AS derived;

DROP TABLE t;

# issue 201, explain analyze trigger crash
SET @saved_pq_support_features_switch = @@session.pq_support_features_switch;
SET pq_support_features_switch = 'count_distinct=on';
create table t0 (c0 int)engine=innodb;
insert into t0 values (1);
analyze table t0;
explain select * from (select max(c0),c0 from t0 where t0.c0 = 1) t2(c0,c1) where t2.c1 = 2;
--replace_regex $elide_costs_and_time_and_row_estimate
explain analyze select * from (select max(c0),c0 from t0 where t0.c0 = 1) t2(c0,c1) where t2.c1 = 2;
SET pq_support_features_switch = @saved_pq_support_features_switch;
drop table t0;
