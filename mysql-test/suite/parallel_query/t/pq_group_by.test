(SELECT t1.id + 1
FROM t t1 INNER JOIN t t2 ON t1.id= 1
GROUP BY t1.id + 1) a, t b
WHERE b.id BETWEEN 1 AND 10;

drop table t;

## issues 541, 549

create table t1 (v varchar(10), c char(10), t text, key(v), key(c), key(t(10)));

--disable_query_log

let $1=10;
while ($1)
{
  let $2=27;
  eval set @space=repeat(' ',10-$1);
  while ($2)
  {
    eval set @char=char(ascii('a')+$2-1);
    insert into t1 values(concat(@char,@space),concat(@char,@space),concat(@char,@space));
    dec $2;
  }
  dec $1;
}
--enable_query_log

insert into t1 values(concat('a',char(1)),concat('a',char(1)),concat('a',char(1)));
--error ER_DUP_ENTRY
alter table t1 add unique(v);
alter table t1 add key(v);

select /*+NO_PQ*/  sql_big_result TRIM(v),count(c) from t1 group by TRIM(v) order by TRIM(v) limit 10;
explain select /*+PQ(1)*/ sql_big_result TRIM(v),count(c) from t1 group by TRIM(v) order by TRIM(v) limit 10;
select /*+PQ(1)*/ sql_big_result TRIM(v),count(c) from t1 group by TRIM(v) order by TRIM(v) limit 10;
select /*+PQ(4)*/ sql_big_result TRIM(v),count(c) from t1 group by TRIM(v) order by TRIM(v) limit 10;

DROP TABLE t1;

SET @saved_sql_mode=@@sql_mode;

set sql_mode = '';
CREATE TABLE t1 (a INT NOT NULL, b INT NOT NULL) ENGINE $engine;

INSERT INTO t1 VALUES (70000, 1092), (70001, 1085), (70002, 1065);

SELECT CONVERT(a, CHAR), CONVERT(b, CHAR) FROM t1 GROUP BY b;

ALTER TABLE t1 ADD INDEX (b);

SELECT CONVERT(a, CHAR), CONVERT(b, CHAR) from t1 GROUP BY b;

DROP TABLE t1;

## ISSUE 557: Send empty record would cause wrong result

set sql_mode = '';
create table t2 (a int);
insert into t2 values (1), (2);

explain select count(t2.a), MAX(t2.a) from t2 join t2 tt;
select count(t2.a), MAX(t2.a) from t2 join t2 tt;

drop table t2;

--echo # when group-by is implemented with index scan, and the field list
--echo # contains scalar subqueries, the created Item_copy can't set proper result_field.
--echo # This will lead to parallel execution error when worker sends partial results.
create table t1 (a int, KEY(a));
insert into t1 values (1), (1), (2), (3);
analyze table t1;
explain select (select a from t1 limit 1) as v from t1 group by a limit 1;
select (select a from t1 limit 1) as v from t1 group by a limit 1;
drop table t1;

--echo # Item_row has not implemented its own eq() method, which leads to
--echo # eq() return false for two cloned equal items.
create table t1 (id int not null, qty int not null);
insert into t1 values (1,2),(1,3),(2,4),(2,5);
explain select count(*), interval(qty,2,3,4,5,6,7,8) as category from t1 group by category;
select count(*), interval(qty,2,3,4,5,6,7,8) as category from t1 group by category;
drop table t1;

## restore sql_mode
SET sql_mode = @saved_sql_mode;

--echo #
--echo # BUG2022101401350, Wrong result for AVG(DIV) in PQ
--echo #

SET @saved_div_precision_increment=@@div_precision_increment;
SET div_precision_increment = 4;

drop table if exists t1;
CREATE TABLE `t1` (
  `id_col` int NOT NULL AUTO_INCREMENT,
  `mediumint_col` mediumint DEFAULT NULL,
  PRIMARY KEY (`id_col`)
);

insert into t1 values(1, -8388608.0000);

let $query= SELECT id_col, AVG(id_col/mediumint_col) FROM t1 group by id_col;
--replace_regex $elide_costs_and_rows
eval EXPLAIN FORMAT=TREE $query;
eval $query;

let $query= SELECT /*+ NO_PQ */ id_col, AVG(id_col/mediumint_col) FROM t1 group by id_col;
--replace_regex $elide_costs_and_rows
eval EXPLAIN FORMAT=TREE $query;
eval $query;

drop table t1;

--echo # Test overflow for AVG in pq
CREATE TABLE `t1` (
  `id` int,
  `overflow` decimal(5,2) DEFAULT NULL
);

insert into t1 values (1, 666.66);
insert into t1 values (1, 888.88);

let $query= SELECT AVG(overflow) from t1 group by id;
--replace_regex $elide_costs_and_rows
eval EXPLAIN FORMAT=TREE $query;
eval $query;

let $query= SELECT /*+ NO_PQ */ AVG(overflow) from t1 group by id;
--replace_regex $elide_costs_and_rows
eval EXPLAIN FORMAT=TREE $query;
eval $query;

drop table t1;

SET div_precision_increment = @saved_div_precision_increment;

