 (17,25), (10,54), (5,62),(3,68);

ANALYZE TABLE t1,t2;

explain
SELECT straight_join concat(t1.b, "") from t2, t1 where t2.b=t1.a GROUP BY t2.b;

SELECT straight_join concat(t1.b, "") from t2, t1 where t2.b=t1.a GROUP BY t2.b;

drop table t1,t2;

