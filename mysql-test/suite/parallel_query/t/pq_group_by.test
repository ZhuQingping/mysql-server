SELECT 1 FROM (SELECT c0, 1 c1 FROM t0) t0 JOIN t0 USING (c0) GROUP BY t0.c0, c1 HAVING (6E-7 = CASE 2 WHEN 8 THEN 5 END) IS NULL;
SET OPTIMIZER_SWITCH=DEFAULT;
DROP TABLE t0;

