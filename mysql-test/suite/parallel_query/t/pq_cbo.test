CREATE TABLE `active_baby` (
  `id` int NOT NULL AUTO_INCREMENT,
  `baby_id` int NOT NULL DEFAULT '0',
  `common_baby_id` int NOT NULL DEFAULT '0',
  `come_time` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `create_at` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `update_at` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uni_baby_id` (`baby_id`),
  KEY `idx_come_time` (`come_time`)
) ENGINE=InnoDB AUTO_INCREMENT=1751716381 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

# Case 1: 'op_over_pq_offset_threshold' switch
SET force_parallel_execute=0;
--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 1000,200;

--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 999,200;

SET force_parallel_execute=1;
--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 1000,200;

--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 999,200;

# Case 2: LIMIT/OFFSET cost based optimize
DELIMITER //;
CREATE PROCEDURE InsertActiveBabyRecords()
BEGIN
    DECLARE i INT DEFAULT 1;
    
    WHILE i <= 2000 DO
        INSERT INTO `active_baby` (`baby_id`, `common_baby_id`, `come_time`, `create_at`, `update_at`)
        VALUES (i, i, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP);
        SET i = i + 1;
    END WHILE;
END //
DELIMITER ;//

CALL InsertActiveBabyRecords();
--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 999,1000;
--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 1,1999;
--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 10,99;
--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 1,1;

SET parallel_setup_cost=1.0;
SET parallel_tuple_cost=1.5;
SET optimizer_trace="enabled=on";
--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 999,1000;
SELECT json_extract(trace,"$.steps[*].not_apply_pq_plan") FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE;
--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 1,1999;
SELECT json_extract(trace,"$.steps[*].not_apply_pq_plan") FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE;
--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 10,99;
SELECT json_extract(trace,"$.steps[*].not_apply_pq_plan") FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE;
--replace_regex $elide_costs_and_rows
explain format=tree SELECT id, baby_id, common_baby_id, come_time, create_at, update_at FROM active_baby WHERE id>1741726385 AND id<=1791716381 ORDER BY id ASC LIMIT 1,1;
SET optimizer_trace="enabled=off";

# Case 3: NESTED_LOOP_JOIN cost based optimize
--disable_warnings
CREATE TABLE `tbl_1_all_type2index` (
  `id_col` int NOT NULL AUTO_INCREMENT,
  `bool_col` tinyint(1) DEFAULT NULL,
  `mediumint_col` mediumint DEFAULT NULL,
  `int_col` int DEFAULT NULL,
  `binary_col` binary(11) DEFAULT NULL,
  `enum_col` enum('aaa','bbb','ccc') CHARACTER SET utf8 COLLATE utf8_unicode_ci DEFAULT NULL,
  PRIMARY KEY (`id_col`),
  KEY `ndx_id_int_col` (`id_col`,`int_col`)
) ENGINE=InnoDB AUTO_INCREMENT=114 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

CREATE TABLE `tbl_3_all_type2index` (
  `id_col` int NOT NULL DEFAULT '0',
  `bool_col` tinyint(1) DEFAULT NULL,
  `mediumint_col` mediumint DEFAULT NULL,
  `int_col` int DEFAULT NULL,
  `binary_col` binary(11) DEFAULT NULL,
  `enum_col` enum('aaa','bbb','ccc') CHARACTER SET utf8 COLLATE utf8_unicode_ci DEFAULT NULL,
  KEY `ndx_id_mediumint_col` (`id_col`,`mediumint_col`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

CREATE TABLE `multi_tbl_3_all_type2index` (
  `id_col` int NOT NULL DEFAULT '0',
  `bool_col` tinyint(1) DEFAULT NULL,
  `mediumint_col` mediumint DEFAULT NULL,
  `int_col` int DEFAULT NULL,
  `binary_col` binary(11) DEFAULT NULL,
  `enum_col` enum('aaa','bbb','ccc') CHARACTER SET utf8 COLLATE utf8_unicode_ci DEFAULT NULL,
  KEY `ndx_id_mediumint_col` (`id_col`,`mediumint_col`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
--enable_warnings

DELIMITER //;
CREATE PROCEDURE InsertRecordsIntoTable(IN tableName VARCHAR(255), IN recordCount INT)
BEGIN
    DECLARE i INT DEFAULT 1;
    DECLARE stmt VARCHAR(1024);
    DECLARE table_name VARCHAR(255);
    SET table_name = tableName;
    
    WHILE i <= recordCount DO
        SET @stmt = CONCAT('INSERT INTO ', table_name, 
                           ' (id_col, bool_col, mediumint_col, int_col, binary_col, enum_col) VALUES (',
                           i, ', ', i % 2, ', ', i * 100, ', ', i * 1000, ', ',
                           'CAST(CONCAT("bin", LPAD(', i, ', 8, "0")) AS BINARY(11)), ',
                           'CASE WHEN ', i, ' % 3 = 1 THEN "aaa" WHEN ', i, ' % 3 = 2 THEN "bbb" ELSE "ccc" END)');
        PREPARE stmt FROM @stmt;
        EXECUTE stmt;
        DEALLOCATE PREPARE stmt;
        SET i = i + 1;
    END WHILE;
END //
DELIMITER ;//

CALL InsertRecordsIntoTable('tbl_1_all_type2index', 13);
CALL InsertRecordsIntoTable('multi_tbl_3_all_type2index', 20);
CALL InsertRecordsIntoTable('tbl_3_all_type2index', 1000);
SET optimizer_trace="enabled=on";
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT = tree WITH cte1 AS (
		SELECT /*+no_bnl()*/ *
		FROM tbl_1_all_type2index
		WHERE tbl_1_all_type2index.int_col <= 99
	), 
	cte2 AS (
		SELECT /*+no_bnl()*/ c1.binary_col, c1.bool_col, B.enum_col
		FROM tbl_3_all_type2index B
			JOIN multi_tbl_3_all_type2index
			JOIN cte1 c1 ON c1.binary_col = B.binary_col
	)
SELECT /*+no_bnl()*/ *
FROM cte2
ORDER BY 1, 2, 3;
SELECT json_extract(trace,"$.steps[*].not_apply_pq_plan") FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE;
SET optimizer_trace="enabled=off";

SET parallel_setup_cost=0.0;
SET parallel_tuple_cost=0.0;
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT = tree WITH cte1 AS (
		SELECT /*+no_bnl()*/ *
		FROM tbl_1_all_type2index
		WHERE tbl_1_all_type2index.int_col <= 99
	), 
	cte2 AS (
		SELECT /*+no_bnl()*/ c1.binary_col, c1.bool_col, B.enum_col
		FROM tbl_3_all_type2index B
			JOIN multi_tbl_3_all_type2index
			JOIN cte1 c1 ON c1.binary_col = B.binary_col
	)
SELECT /*+no_bnl()*/ *
FROM cte2
ORDER BY 1, 2, 3;

# Case 4: HASH_JOIN cost based optimize
set pq_support_features_switch='hash_join_spill_to_disk=on';
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT = tree WITH cte1 AS (
		SELECT *
		FROM tbl_1_all_type2index
		WHERE tbl_1_all_type2index.int_col <= 99
	), 
	cte2 AS (
		SELECT c1.binary_col, c1.bool_col, B.enum_col
		FROM tbl_3_all_type2index B
			JOIN multi_tbl_3_all_type2index
			JOIN cte1 c1 ON c1.binary_col = B.binary_col
	)
SELECT *
FROM cte2
ORDER BY 1, 2, 3;

SET parallel_setup_cost=1.0;
SET parallel_tuple_cost=1.5;
SET optimizer_trace="enabled=on";
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT = tree WITH cte1 AS (
		SELECT *
		FROM tbl_1_all_type2index
		WHERE tbl_1_all_type2index.int_col <= 99
	), 
	cte2 AS (
		SELECT c1.binary_col, c1.bool_col, B.enum_col
		FROM tbl_3_all_type2index B
			JOIN multi_tbl_3_all_type2index
			JOIN cte1 c1 ON c1.binary_col = B.binary_col
	)
SELECT *
FROM cte2
ORDER BY 1, 2, 3;
SELECT json_extract(trace,"$.steps[*].not_apply_pq_plan") FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE;
SET optimizer_trace="enabled=off";

DROP PROCEDURE InsertActiveBabyRecords;
DROP PROCEDURE InsertRecordsIntoTable;
DROP TABLE active_baby;
DROP TABLE tbl_1_all_type2index;
DROP TABLE tbl_3_all_type2index;
DROP TABLE multi_tbl_3_all_type2index;

#BUG2024112219609 mysqld crash, keyword MaterializeIterator::MaterializeQueryBlock
CREATE TABLE t1 (v1 int, v2 int);
INSERT INTO t1 (v1, v2) VALUES (12, 0);
SET parallel_setup_cost=1000;
SELECT v2 AS col1, v2 AS col2, SUM(v1) AS col3 FROM t1 GROUP BY 1, 2;
DROP TABLE t1;

#BUG2024122023329 untrust rows
SET parallel_setup_cost=1000.0,parallel_tuple_cost=1.5;
#Temporary table with deduplication
CREATE TABLE t1 (
  pk int NOT NULL AUTO_INCREMENT,
  col_varchar varchar(1),
  col_varchar_key varchar(1),
  PRIMARY KEY (pk),
  KEY idx_CC_col_varchar_key (col_varchar_key)
);

INSERT INTO t1 VALUES (1,'n','X'),(2,'Y','8'),(3,'R','l');

let $query = SELECT
  t1.col_varchar_key AS field1
FROM
  (t1, t1 as alias1)
WHERE
  NOT
    EXISTS(
      SELECT
        alias2.col_varchar_key
      FROM
        t1 AS alias2
      WHERE
        alias2.col_varchar_key >= t1.col_varchar
    )
GROUP BY
  field1;

ANALYZE TABLE t1;
eval EXPLAIN FORMAT=tree $query;
eval $query;
DROP TABLE t1;

#NESTED_LOOP_SEMIJOIN_WITH_DUPLICATE_REMOVAL
CREATE TABLE t1 (
  a INTEGER NOT NULL
);
INSERT INTO t1 VALUES (2),(2);

CREATE TABLE t2 (
  b INTEGER
);
INSERT INTO t2 VALUES (2),(11),(11);

CREATE TABLE t3 (
  b INTEGER,
  pk INTEGER,
  KEY b_key (b)
);
INSERT INTO t3 VALUES (2,5);

CREATE TABLE t4 (
  pk INTEGER NOT NULL
);
INSERT INTO t4 VALUES (5),(7);

ANALYZE TABLE t1,t2,t3,t4;

let $query =
  SELECT *
FROM t1
  JOIN t2 ON t1.a = t2.b
WHERE t2.b IN (
  SELECT t3.b
  FROM t3 JOIN t4 ON t3.pk = t4.pk
);

eval EXPLAIN FORMAT=TREE $query;
eval $query;

DROP TABLE t1, t2, t3, t4;

#WEEDOUT
SET optimizer_switch="materialization=off,firstmatch=off";
CREATE TABLE t1 (i BIGINT);
CREATE TABLE t2 (i BIGINT);
INSERT INTO t1 VALUES (1), (2), (3);
INSERT INTO t2 VALUES (2), (3);
ANALYZE TABLE t1, t2;
EXPLAIN FORMAT=tree SELECT * FROM t2 WHERE (t2.i) IN (SELECT t1.i FROM t1);
SELECT * FROM t2 WHERE (t2.i) IN (SELECT t1.i FROM t1);
DROP TABLE t1, t2;
SET optimizer_switch = DEFAULT;

#REMOVE_DUPLICATES
set optimizer_switch='firstmatch=off,materialization=off,duplicateweedout=off,loosescan=on';
CREATE TABLE t1 ( i INTEGER, PRIMARY KEY (i) );
CREATE TABLE t2 ( i INTEGER, INDEX i1 (i) );
INSERT INTO t1 VALUES (2), (3), (4), (5);
INSERT INTO t2 VALUES (1), (2), (3), (4);
ANALYZE TABLE t1, t2;
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.i IN (SELECT t2.i FROM t2);
SELECT * FROM t1 WHERE t1.i IN (SELECT t2.i FROM t2);
DROP TABLE t1, t2;
SET optimizer_switch = DEFAULT;

SET optimizer_switch=@save_optimizer_switch;
SET force_parallel_execute=@save_force_parallel_execute;
SET op_over_pq_offset_threshold=@save_op_over_pq_offset_threshold;
SET parallel_setup_cost=@save_parallel_setup_cost;
SET parallel_tuple_cost=@save_parallel_tuple_cost;
SET pq_support_features_switch = @saved_pq_support_features_switch;
