--echo # Item_func_trim
create table t1 (v varchar(10), c char(10), t text, key(v), key(c), key(t(10)));
set @space=repeat(' ',10-9);
set @char=char(ascii('a')+27-1);
insert into t1 values(concat(@char,@space),concat(@char,@space),concat(@char,@space));

set @space=repeat(' ',10-10);
set @char=char(ascii('a')+27-1);
insert into t1 values(concat(@char,@space),concat(@char,@space),concat(@char,@space));

select /*+NO_PQ*/  sql_big_result TRIM(v),count(c) from t1 group by TRIM(v);
--replace_column 10 # 11 #
explain select /*+PQ(1)*/ sql_big_result TRIM(v),count(c) from t1 group by TRIM(v);
select /*+PQ(1)*/ sql_big_result TRIM(v),count(c) from t1 group by TRIM(v);
drop table t1;

--echo # Item_func_numhybrid.
# used_tables_cache after prepare is different from in optimized and so we need copy used_tables_cache and does not reset used_tables_cache in refix_fields.
CREATE TABLE t(id INT PRIMARY KEY,
               c1 INT, c2 INT, key(c2)) engine=InnoDB;
INSERT INTO t(id, c1, c2) VALUES(1, 2, 3), (2, 3, 4), (3, 3, 4), (4, 3, 4);
set force_parallel_execute = 1;
--replace_column 10 # 11 #
explain SELECT (t1.id + 1) as c FROM t t1 INNER JOIN t t2 ON t1.id= 1 GROUP BY c;
drop table t;

