--echo #
--echo # BUG2023102501138
--echo #

CREATE TABLE tbl_3_all_typeindex (
  id_col int NOT NULL DEFAULT '0',
  timestamp_col timestamp(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6),
  binary_col binary(11) DEFAULT NULL,
  KEY `ndx_id_col` (`id_col`),
  KEY `ndx_timestamp_col` (`timestamp_col`),
  KEY `ndx_binary_col` (`binary_col`)
);
insert into tbl_3_all_typeindex values(1,'2020-08-01 10:00:00.000000', 'cccccccccc1');

set force_parallel_execute = 0;
SELECT binary_col AS c1 FROM tbl_3_all_typeindex B WHERE B.timestamp_col = '2020-08-01 10:00:00.000000' AND B.timestamp_col BETWEEN '2020-01-01 00:00:01.000000' AND B.binary_col;

set force_parallel_execute = 1;
--replace_column 10 # 11 #
explain SELECT binary_col AS c1 FROM tbl_3_all_typeindex B WHERE B.timestamp_col = '2020-08-01 10:00:00.000000' AND B.timestamp_col BETWEEN '2020-01-01 00:00:01.000000' AND B.binary_col;
SELECT binary_col AS c1 FROM tbl_3_all_typeindex B WHERE B.timestamp_col = '2020-08-01 10:00:00.000000' AND B.timestamp_col BETWEEN '2020-01-01 00:00:01.000000' AND B.binary_col;

drop table tbl_3_all_typeindex;

