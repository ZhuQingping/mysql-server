SELECT 1 FROM (SELECT CAST('7791-3-21 21:27:26' AS DATETIME) FROM t0) x(x) JOIN (SELECT DISTINCT t0.c1 FROM t0 WHERE CASE WHEN t0.c0 THEN CAST('3857-8-21 12:56:47' AS DATETIME) END > t0.c1) y(y) ON x.x = y.y;

