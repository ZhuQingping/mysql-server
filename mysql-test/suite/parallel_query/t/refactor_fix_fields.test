--echo #
--echo # BUG2023103003201 : The parameter's type of condition in the prepare phase is different from parameter's type after optimize phase.
--echo # As a result, the comparison function is changed. As a result, the result is incorrect.
--echo #

set sql_mode='';

CREATE TABLE ta (
  timestamp_col timestamp NULL DEFAULT NULL
);
CREATE TABLE tb (
  set_col set('111','222','333') DEFAULT NULL
);
insert into ta values('0000-00-00 00:00:00');
insert into tb values('111');

set parallel_cost_threshold=0;
set parallel_default_dop=1;
set parallel_rows_threshold=0;

set force_parallel_execute = 0;
EXPLAIN SELECT B.set_col, A.timestamp_col,A.timestamp_col <> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';
SELECT B.set_col, A.timestamp_col,A.timestamp_col <> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';
set force_parallel_execute = 1;
# Arg_comparator::clone::cmp_as_dates = true
--replace_column 10 # 11 #
explain SELECT B.set_col, A.timestamp_col,A.timestamp_col <> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';
SELECT B.set_col, A.timestamp_col,A.timestamp_col <> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';

set force_parallel_execute = 0;
EXPLAIN SELECT B.set_col, A.timestamp_col,A.timestamp_col <=> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <=> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';
SELECT B.set_col, A.timestamp_col,A.timestamp_col <=> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <=> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';
set force_parallel_execute = 1;
--replace_column 10 # 11 #
explain SELECT B.set_col, A.timestamp_col,A.timestamp_col <=> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <=> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';
SELECT B.set_col, A.timestamp_col,A.timestamp_col <=> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <=> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';

set debug='+d,item_cond_refix_fields_error';
--replace_column 10 # 11 #
explain SELECT /*+ set_var(parallel_graceful_fallback=off) */ B.set_col, A.timestamp_col,A.timestamp_col <> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';
SELECT /*+ set_var(parallel_graceful_fallback=off) */ B.set_col, A.timestamp_col,A.timestamp_col <> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';
--replace_column 10 # 11 #
explain SELECT /*+ set_var(parallel_graceful_fallback=on) */ B.set_col, A.timestamp_col,A.timestamp_col <> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';
SELECT /*+ set_var(parallel_graceful_fallback=on) */ B.set_col, A.timestamp_col,A.timestamp_col <> B.set_col,A.timestamp_col = '0000-00-00 00:00:00.000000' FROM ta A, tb B where A.timestamp_col <> B.set_col and A.timestamp_col = '0000-00-00 00:00:00.000000';
set debug='';

drop table ta, tb;

