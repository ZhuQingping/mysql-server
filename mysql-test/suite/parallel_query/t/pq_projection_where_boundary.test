# Test: pq_projection_where_boundary
# Verify V2-7 predicate/projection boundary: SQL WHERE/projection still runs
# through serial fallback while PQ smoke paths remain non-executing.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (id INT PRIMARY KEY, val INT, pad CHAR(20)) ENGINE=InnoDB;
INSERT INTO t1 VALUES
  (1,10,'a'),(2,20,'b'),(3,30,'c'),(4,40,'d'),(5,50,'e');

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=4;

SET @pq_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');
SET @pq_worker_smoke_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_worker_smoke_runs');
SET @pq_exchange_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_exchange_smoke_rows');
SET @pq_exchange_finishes_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_exchange_smoke_finishes');

SELECT id FROM t1 WHERE val >= 20;
SELECT val, pad FROM t1 WHERE id IN (2,4);
SELECT id FROM t1 WHERE val > 999;

SET @pq_fallback_after_selects = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_worker_smoke_after_selects = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_worker_smoke_runs');
SET @pq_exchange_rows_after_selects = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_exchange_smoke_rows');
SET @pq_exchange_finishes_after_selects = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_exchange_smoke_finishes');

EXPLAIN SELECT id FROM t1 WHERE val >= 20;
EXPLAIN FORMAT=TREE SELECT id FROM t1 WHERE val >= 20;
--replace_regex /\"query_cost\": \"[0-9.]*\"/\"query_cost\": \"<cost>\"/
EXPLAIN FORMAT=JSON SELECT id FROM t1 WHERE val >= 20;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
    AS executed_delta,
  @pq_fallback_after_selects - @pq_fallback_before AS fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_rows_scanned') - @pq_rows_before
    AS rows_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
    AS workers_delta,
  @pq_worker_smoke_after_selects - @pq_worker_smoke_before
    AS worker_smoke_delta,
  @pq_exchange_rows_after_selects - @pq_exchange_rows_before
    >= 4 AS exchange_rows_at_least_4,
  @pq_exchange_finishes_after_selects - @pq_exchange_finishes_before
    >= 4 AS exchange_finishes_at_least_4,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_after_selects
    AS explain_fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_worker_smoke_runs') - @pq_worker_smoke_after_selects
    AS explain_worker_smoke_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_exchange_smoke_rows') - @pq_exchange_rows_after_selects
    AS explain_exchange_rows_delta;

SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;
