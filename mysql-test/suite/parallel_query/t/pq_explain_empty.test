# Test: pq_explain_empty
# Verify EXPLAIN PQ annotation on an empty InnoDB table (edge case).

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t_empty;
--enable_warnings

CREATE TABLE t_empty (id INT PRIMARY KEY, val INT) ENGINE=InnoDB;

# Empty table with PQ ON and low cost threshold
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;

# Even an empty table should show PQ annotation if eligible
EXPLAIN SELECT * FROM t_empty;

EXPLAIN FORMAT=TREE SELECT * FROM t_empty;

# Reset
SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t_empty;