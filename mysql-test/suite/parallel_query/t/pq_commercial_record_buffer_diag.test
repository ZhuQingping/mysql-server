# Verify commercial record-buffer diagnostics remain isolated from visible PQ.

--source include/have_innodb_16k.inc
--source include/have_debug.inc

--disable_warnings
DROP TABLE IF EXISTS pq_record_buffer_diag_t;
--enable_warnings

CREATE TABLE pq_record_buffer_diag_t (
  id INT PRIMARY KEY,
  v INT NOT NULL,
  pad CHAR(8)
) ENGINE=InnoDB;

INSERT INTO pq_record_buffer_diag_t VALUES
  (1, 10, 'a'), (2, 20, 'b'), (3, 30, 'c');

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=1;

SET @rb_null_before = COALESCE((
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_record_buffer_null_probes'), 0);
SET @rb_nonnull_before = COALESCE((
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_record_buffer_nonnull_probes'), 0);
SET @attach_attempts_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_attempts');
SET @attach_success_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_success');
SET @attach_cleanup_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_cleanup_calls');
SET @queries_executed_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed');
SET @workers_launched_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_workers_launched');
SET @ranges_dispatched_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_ranges_dispatched');
SET @secondary_rows_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_secondary_rows_produced');

SET @old_debug=@@session.debug;
SET SESSION debug="d,pq_worker_attach_contract_smoke,pq_worker_record_buffer_probe_smoke";
--sorted_result
SELECT id, v FROM pq_record_buffer_diag_t WHERE v >= 0;
SET SESSION debug=@old_debug;

SELECT COALESCE((
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_record_buffer_null_probes'), 0) -
  @rb_null_before >= 1 AS rb_probe_null_seen;
SELECT COALESCE((
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_record_buffer_nonnull_probes'), 0) -
  @rb_nonnull_before AS rb_probe_nonnull_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_attempts') -
  @attach_attempts_before) >= 1 AS rb_attach_attempt_seen;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_success') -
  @attach_success_before) >= 1 AS rb_attach_success_seen;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_attach_smoke_cleanup_calls') -
  @attach_cleanup_before) >= 1 AS rb_attach_cleanup_seen;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_queries_executed') -
  @queries_executed_before) AS rb_queries_executed_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_workers_launched') -
  @workers_launched_before) AS rb_workers_launched_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_ranges_dispatched') -
  @ranges_dispatched_before) AS rb_ranges_dispatched_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_secondary_rows_produced') -
  @secondary_rows_before) AS rb_secondary_rows_delta;

SET @icp_rb_reject_before = COALESCE((
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_icp_record_buffer_reject_probes'), 0);
SET @rb_null_before = COALESCE((
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_record_buffer_null_probes'), 0);
SET @rb_nonnull_before = COALESCE((
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_record_buffer_nonnull_probes'), 0);
SET @queries_executed_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed');
SET @workers_launched_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_workers_launched');
SET @ranges_dispatched_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_ranges_dispatched');
SET @secondary_rows_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_secondary_rows_produced');

SET SESSION debug="d,pq_worker_attach_contract_smoke,pq_worker_icp_record_buffer_negative_smoke";
--sorted_result
SELECT id, v FROM pq_record_buffer_diag_t WHERE v >= 0;
SET SESSION debug=@old_debug;

SELECT COALESCE((
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_icp_record_buffer_reject_probes'), 0) -
  @icp_rb_reject_before >= 1 AS icp_rb_reject_seen;
SELECT COALESCE((
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_record_buffer_null_probes'), 0) -
  @rb_null_before >= 1 AS icp_rb_null_probe_seen;
SELECT COALESCE((
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_record_buffer_nonnull_probes'), 0) -
  @rb_nonnull_before AS icp_rb_nonnull_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_queries_executed') -
  @queries_executed_before) AS icp_rb_queries_executed_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_workers_launched') -
  @workers_launched_before) AS icp_rb_workers_launched_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_ranges_dispatched') -
  @ranges_dispatched_before) AS icp_rb_ranges_dispatched_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_secondary_rows_produced') -
  @secondary_rows_before) AS icp_rb_secondary_rows_delta;

SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
SET SESSION parallel_default_dop=4;

DROP TABLE pq_record_buffer_diag_t;
