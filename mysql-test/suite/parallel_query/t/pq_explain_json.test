--source include/pq_test.inc
--source include/have_debug.inc

CREATE TABLE t1(f1 INT, f2 INT);
INSERT INTO t1 VALUES
(1,1),(2,2),(3,3);

CREATE TABLE t2(f1 INT NOT NULL, f2 INT NOT NULL, f3 CHAR(200), KEY(f1, f2));
INSERT INTO t2 VALUES
(1,1, 'qwerty'),(1,2, 'qwerty'),(1,3, 'qwerty'),
(2,1, 'qwerty'),(2,2, 'qwerty'),(2,3, 'qwerty'), (2,4, 'qwerty'),(2,5, 'qwerty'),
(3,1, 'qwerty'),(3,4, 'qwerty'),
(4,1, 'qwerty'),(4,2, 'qwerty'),(4,3, 'qwerty'), (4,4, 'qwerty'),
(1,1, 'qwerty'),(1,2, 'qwerty'),(1,3, 'qwerty'),
(2,1, 'qwerty'),(2,2, 'qwerty'),(2,3, 'qwerty'), (2,4, 'qwerty'),(2,5, 'qwerty'),
(3,1, 'qwerty'),(3,4, 'qwerty'),
(4,1, 'qwerty'),(4,2, 'qwerty'),(4,3, 'qwerty'), (4,4, 'qwerty');

ANALYZE TABLE t1;
ANALYZE TABLE t2;

# PQ depend ref which using PQ_REF_SCAN
explain format=json SELECT t2.f1, t2.f2, t2.f3 FROM t1,t2 WHERE t1.f1=t2.f1 AND t2.f2 BETWEEN t1.f1 and t1.f2 and t2.f2 + 1 >= t1.f1 + 1;

# PQ table scan which using PQ_BLOCK_SCAN
explain format=json select * from t1;

# PQ index scan which using PQ_BLOCK_SCAN
explain format=json select sum(f2) from t2 group by f1 order by f1 limit 2;

# PQ range scan which using PQ_BLOCK_SCAN
explain format=json select sum(f2) from t2 where f1 > 2 group by f1 order by f1 limit 2;

# PQ ref scan which using PQ_BLOCK_SCAN
explain format=json select * from t2 where f1 = 3;

drop table t1,t2;

# Test share temp table of two phase PQ
SET @optimizer_switch_saved= @@optimizer_switch;
set @@optimizer_switch='batched_key_access=off,block_nested_loop=off,mrr_cost_based=off';

CREATE TABLE t1 ( f1 INT PRIMARY KEY );
INSERT INTO t1 VALUES (1), (2), (3);
ANALYZE TABLE t1;
EXPLAIN FORMAT=json SELECT * FROM t1, ( SELECT f1 FROM t1 UNION SELECT f1 + 10 FROM t1 ) d1;
EXPLAIN FORMAT=json SELECT * FROM t1, ( SELECT f1 FROM t1 UNION ALL SELECT f1 + 10 FROM t1 ) d1;

SET @@optimizer_switch=@optimizer_switch_saved;
DROP TABLE t1;
