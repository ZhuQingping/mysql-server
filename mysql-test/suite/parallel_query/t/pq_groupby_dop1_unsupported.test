# Test: pq_groupby_dop1_unsupported
# V2-12A-3.8: unsupported GROUP BY shapes must not enter the PQ-owned
# temp-table execution path.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  grp INT NOT NULL,
  val INT NULL,
  txt VARCHAR(16) NOT NULL
) ENGINE=InnoDB;

INSERT INTO t1 VALUES
  (1,10,5,'a'),(2,10,7,'a'),(3,20,2,'b'),(4,20,9,'b');

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=1;
SET SESSION parallel_query_experimental_groupby_dop1=ON;

SET @pq_groupby_selected_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_factory_selected');
SET @pq_groupby_temp_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_temp_table_executed');
SET @pq_groupby_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_factory_fallback');
SET @pq_groupby_shape_unsupported_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_temp_shape_unsupported');

# DOP>1 is outside the DOP1 GROUP BY gate.
SET SESSION parallel_default_dop=2;
SELECT grp, COUNT(*) AS cnt FROM t1 GROUP BY grp;
SET SESSION parallel_default_dop=1;

# Rejected before selected path by optimizer-level GROUP BY guards.
SELECT grp, COUNT(*) AS cnt FROM t1 GROUP BY grp HAVING cnt > 0;
SELECT grp, COUNT(*) AS cnt FROM t1 GROUP BY grp ORDER BY grp;
SELECT grp, COUNT(DISTINCT val) AS cnt FROM t1 GROUP BY grp;
SELECT grp + 1 AS g, COUNT(*) AS cnt FROM t1 GROUP BY grp + 1;

# Reach the factory but fail the supported temp-table shape.
SELECT grp, SUM(val + 1) AS sum_expr FROM t1 GROUP BY grp;
SELECT txt, COUNT(*) AS cnt FROM t1 GROUP BY txt;

SELECT
  ((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_factory_selected') -
      @pq_groupby_selected_before) AS selected_delta,
  ((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_temp_table_executed') -
      @pq_groupby_temp_executed_before) AS temp_executed_delta,
  ((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_factory_fallback') -
      @pq_groupby_fallback_before) >= 1 AS fallback_observed,
  ((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_temp_shape_unsupported') -
      @pq_groupby_shape_unsupported_before) >= 1 AS unsupported_shape_observed;

SET SESSION parallel_query_experimental_groupby_dop1=OFF;
SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;
