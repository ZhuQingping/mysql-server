# Verify the debug-gated worker-thread ExecuteIteratorQuery call smoke.

--source include/have_innodb_16k.inc
--source include/have_debug.inc

CREATE TABLE pq_worker_execute_threaded_call_t (
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO pq_worker_execute_threaded_call_t VALUES (1,10),(2,20),(3,30);

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;

SET @threaded_attempts_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_attempts');
SET @threaded_success_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_success');
SET @threaded_blocked_setup_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_blocked_setup');
SET @threaded_blocked_preflight_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_blocked_preflight');
SET @threaded_drain_errors_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_drain_errors');
SET @threaded_drained_rows_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_drained_rows');
SET @threaded_drained_finishes_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_drained_finishes');
SET @threaded_value_rows_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_value_rows');
SET @threaded_value_errors_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_value_errors');
SET @threaded_value_id_sum_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_value_id_sum');
SET @threaded_value_v_sum_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_value_v_sum');
SET @threaded_value_id_v_sum_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_value_id_v_sum');
SET @threaded_mat_rows_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_mat_rows');
SET @threaded_mat_errors_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_mat_errors');
SET @threaded_mat_id_sum_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_mat_id_sum');
SET @threaded_mat_v_sum_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_mat_v_sum');
SET @threaded_mat_id_v_sum_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_thread_smoke_mat_id_v_sum');
SET @execute_query_called_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_execute_iterator_smoke_xiq_called');
SET @execute_query_success_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_execute_iterator_smoke_xiq_success');
SET @execute_query_rows_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_execute_iterator_smoke_xiq_rows');
SET @execute_query_finishes_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_execute_iterator_smoke_xiq_finishes');
SET @blocked_drain_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_execute_iterator_smoke_blocked_drain');

SET @old_debug=@@session.debug;
SET SESSION debug="+d,pq_worker_execute_iterator_threaded_precheck_smoke";
SET SESSION debug="+d,pq_worker_execute_iterator_threaded_call_smoke";
SELECT id, v FROM pq_worker_execute_threaded_call_t WHERE v >= 0;
SET SESSION debug=@old_debug;

SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_attempts') -
  @threaded_attempts_before) >= 1 AS threaded_attempts_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_success') -
  @threaded_success_before) >= 1 AS threaded_success_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_blocked_setup') -
  @threaded_blocked_setup_before) = 0 AS threaded_blocked_setup_delta_is_0;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_blocked_preflight') -
  @threaded_blocked_preflight_before) = 0
    AS threaded_blocked_preflight_delta_is_0;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_drain_errors') -
  @threaded_drain_errors_before) = 0 AS threaded_drain_errors_delta_is_0;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_drained_rows') -
  @threaded_drained_rows_before) = 3 AS threaded_drained_rows_delta_is_3;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_drained_finishes') -
  @threaded_drained_finishes_before) = 1
    AS threaded_drained_finishes_delta_is_1;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_value_rows') -
  @threaded_value_rows_before) = 3 AS threaded_value_rows_delta_is_3;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_value_errors') -
  @threaded_value_errors_before) = 0 AS threaded_value_errors_delta_is_0;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_value_id_sum') -
  @threaded_value_id_sum_before) = 6 AS threaded_value_id_sum_delta_is_6;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_value_v_sum') -
  @threaded_value_v_sum_before) = 60 AS threaded_value_v_sum_delta_is_60;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_value_id_v_sum') -
  @threaded_value_id_v_sum_before) = 140
    AS threaded_value_id_v_sum_delta_is_140;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_mat_rows') -
  @threaded_mat_rows_before) = 3 AS threaded_mat_rows_delta_is_3;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_mat_errors') -
  @threaded_mat_errors_before) = 0 AS threaded_mat_errors_delta_is_0;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_mat_id_sum') -
  @threaded_mat_id_sum_before) = 6 AS threaded_mat_id_sum_delta_is_6;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_mat_v_sum') -
  @threaded_mat_v_sum_before) = 60 AS threaded_mat_v_sum_delta_is_60;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_thread_smoke_mat_id_v_sum') -
  @threaded_mat_id_v_sum_before) = 140
    AS threaded_mat_id_v_sum_delta_is_140;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_execute_iterator_smoke_xiq_called') -
  @execute_query_called_before) >= 1 AS execute_query_called_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_execute_iterator_smoke_xiq_success') -
  @execute_query_success_before) >= 1 AS execute_query_success_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_execute_iterator_smoke_xiq_rows') -
  @execute_query_rows_before) = 3 AS execute_query_rows_delta_is_3;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_smoke_xiq_finishes') -
  @execute_query_finishes_before) = 1 AS execute_query_finishes_delta_is_1;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_execute_iterator_smoke_blocked_drain') -
  @blocked_drain_before) = 0 AS execute_query_blocked_drain_delta_is_0;

SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
SET SESSION parallel_default_dop=4;

DROP TABLE pq_worker_execute_threaded_call_t;
