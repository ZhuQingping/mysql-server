--source include/pq_test.inc

--echo #
--echo # BUG2025071827333: PQ using multi-valued index reports wrong result
--echo # 1. multi-valued index using PQblockScanIterator test
--echo #
CREATE TABLE `cp1` (
  `id` bigint NOT NULL,
  `biz_order_id` varchar(30) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `biz_type` tinyint NOT NULL,
  `station_id` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `operator_id` varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `comment_tags` json DEFAULT NULL,
  `flag` tinyint NOT NULL DEFAULT '0',
  `create_time` datetime DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_biz_order_id_biz_type` (`biz_order_id`,`biz_type`),
  KEY `idx_create_time` (`create_time`),
  KEY `idx_tag_name` ((cast(json_extract(`comment_tags`,_utf8mb4'$[*].tagName') as char(50) array))),
  KEY `idx_station_id_operator_id_tag_name` (`station_id`,`operator_id`,(cast(json_extract(`comment_tags`,_utf8mb4'$[*].tagName') as char(50) array)))
);
