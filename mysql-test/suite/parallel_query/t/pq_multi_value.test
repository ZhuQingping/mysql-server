--echo #
--echo # 2. multi-valued index using PQRefIterator test
--echo #
CREATE TABLE t (
  id int unsigned NOT NULL,
  doc_id int unsigned DEFAULT NULL,
  b int,
  doc json DEFAULT NULL,
  PRIMARY KEY (id),
  KEY mv_id (id,(cast(json_extract(doc,'$.val') as unsigned array))),
  KEY mv_doc_id_b (doc_id,b,(cast(json_extract(doc,'$.val') as unsigned array)))
);
INSERT INTO t values (1, 2, 2, '{"val":[1,2,3,4,5]}'), (2, 1, 1, '{"val":[2,3,4,5]}'), (3, 2, 2, '{"val":[2,3,4,5]}'), (4, NULL, NULL, '{"val":[3,4,5]}'), (5, 2, 2, '{"val":[4,5]}');

--replace_column 10 # 11 #
EXPLAIN with t0_view(a) as (select 1) select 2 from (select a from t0_view ) as subq_0 inner join t on (subq_0.a = t.doc_id and t.b=1);
with t0_view(a) as (select 1) select 2 from (select a from t0_view ) as subq_0 inner join t on (subq_0.a = t.doc_id and t.b=1);

--replace_column 10 # 11 #
EXPLAIN with t0_view(a) as (select 2) select 2 from (select a from t0_view ) as subq_0 inner join t on (subq_0.a = t.doc_id and t.b=2);
with t0_view(a) as (select 2) select 2 from (select a from t0_view ) as subq_0 inner join t on (subq_0.a = t.doc_id and t.b=2);
 
