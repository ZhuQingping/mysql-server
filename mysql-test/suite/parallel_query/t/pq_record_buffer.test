## reverse index scan
--replace_column 10 # 11 #
explain select C_INT_ID from record_buffer_table order by C_INT_ID desc limit 10;
select C_INT_ID from record_buffer_table order by C_INT_ID desc limit 10;
select C_INT_ID from record_buffer_hash_table where C_INT_ID>-552156416 order by C_INT_ID desc limit 10;
select C_INT_ID from record_buffer_list_table where C_INT_ID>-552156416 order by C_INT_ID desc limit 10;
select C_INT_ID from record_buffer_range_table where C_INT_ID>-552156416 order by C_INT_ID desc limit 10;
select C_INT_ID from record_buffer_key_table where C_INT_ID>-552156416 order by C_INT_ID desc limit 10;

## cleanup record_buffer tables

drop table record_buffer_table;
drop table record_buffer_hash_table;
drop table record_buffer_range_table;
drop table record_buffer_list_table;
drop table record_buffer_key_table;

## index skip scan
--echo PQ has not supported index skip scan now
CREATE TABLE t1 (f1 INT NOT NULL, f2 INT NOT NULL, PRIMARY KEY(f1, f2));
INSERT INTO t1 VALUES
  (1,1), (1,2), (1,3), (1,4), (1,5),
  (2,1), (2,2), (2,3), (2,4), (2,5);
INSERT INTO t1 SELECT f1, f2 + 5 FROM t1;
INSERT INTO t1 SELECT f1, f2 + 10 FROM t1;
INSERT INTO t1 SELECT f1, f2 + 20 FROM t1;
INSERT INTO t1 SELECT f1, f2 + 40 FROM t1;
ANALYZE TABLE t1;

EXPLAIN SELECT f1, f2 FROM t1 WHERE f2 > 40;
SELECT f1, f2 FROM t1 WHERE f2 > 40;

EXPLAIN SELECT f1, f2 FROM t1 WHERE f2 = 40;
SELECT f1, f2 FROM t1 WHERE f2 = 40;

DROP table t1;

## scene that is not suitable for record buffer

CREATE TABLE t1 (a int, b int);

let $1=64;
--disable_query_log

while($1)
{
  let $2=32;
	while($2)
	{
		eval INSERT INTO t1 VALUES (MOD($1, 23), MOD(133, $2));
		dec $2;
	}
	dec $1;
}

--enable_query_log

create temporary table tmp like t1;
insert into tmp select * from t1;

--echo temporary table is not suitable for record buffer
--replace_column 10 # 11 #
explain select sum(a + b) - sum(a) - sum(b) from tmp;
select sum(a + b) - sum(a) - sum(b) from tmp;

--echo scan table with lock is not suitable for record buffer
--replace_column 10 # 11 #
explain select sum(a) from t1 for update;
select sum(a) from t1 for update;

--echo table without defined PK/UK is not suitable for record buffer
--replace_column 10 # 11 #
explain select avg(b) from t1;
select avg(b) from t1;

drop table t1;


CREATE TABLE t1 (id int auto_increment primary key, comments text, a int, b int);

let $1=64;
--disable_query_log

while($1)
{
  let $2=32;
	while($2)
	{
		eval INSERT INTO t1(comments, a, b) VALUES ("Yu2021to12n02g1331", MOD($1, 23), MOD(133, $2));
		dec $2;
	}
	dec $1;
}

--enable_query_log

--echo BLOB field is not suitable for record buffer
explain select * from t1 limit 10;
select * from t1 limit 10;

--echo check table is not suitable for record buffer
check table t1;

drop table t1;

--echo ## Test ICP check with record buffer
create table t1(id int auto_increment primary key, c1 int, c2 int, c3 int, c4 int);
insert into t1 (c1, c2, c3, c4) values (10, 0, 1, 1), (0, 1, 2, 4), (1, 0, 3, 2), (0, 1, 1, 3), (2, 1, 4, 1), (1, 2, 3, 1), (1, 2, 1, 4), (2, 1, 1, 0);
alter table t1 add key idx_c1_c2_c3(c1, c2, c3);

insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;
insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;
insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;
insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;
insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;
insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;
insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;

## Query result number is larger than record buffer max fill number, which
## would lead fill record number many times.
explain select * from t1 force index(idx_c1_c2_c3) where c1=0 and c3 in (2,3);
select count(id) from t1 force index(idx_c1_c2_c3) where c1=0 and c3 in (2,3);
select * from t1 force index(idx_c1_c2_c3) where c1=0 and c3 in (2,3);

drop table t1;

create table t1(id int auto_increment primary key, c1 int, c2 int, c3 int, c4 int);
insert into t1 (c1, c2, c3, c4) values (10, 0, 1, 1), (0, 1, 2, 4), (1, 0, 3, 2), (0, 1, 1, 3), (2, 1, 4, 1), (1, 2, 3, 1), (1, 2, 1, 4), (2, 1, 1, 0);
alter table t1 add key idx_c1_c2_c3(c1, c2, c3);

insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;
insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;
insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;
insert into t1 (c1, c2, c3, c4) select c1, c2, c3, c4 from t1;

--echo loose index scan is not suitable for record buffer
--replace_column 10 # 11 #
explain select c1, c2 from t1 group by c1, c2;
select c1, c2 from t1 group by c1, c2;

## test scenes for using record buffer

--echo table scan
explain select * from t1 where c2 = 1 limit 10;
select * from t1 where c2 = 1 limit 10;

--echo index scan
explain select c1 from t1 limit 10;
select c1 from t1 limit 10;

--echo range scan
explain select c1, c2 from t1 where c1 IN (0, 1) limit 10;
select c1, c2 from t1 where c1 IN (0, 1) limit 10;

--echo ref scan
explain select c2 from t1 where c1 = 1 limit 10;
select c2 from t1 where c1 = 1 limit 10;

--echo retrieve cluster record with secondary index
explain select c4 from t1 where c1 IN (0, 2) order by c2 limit 20;
select c4 from t1 where c1 IN (0, 2) order by c2 limit 20;

--echo limit and offset
explain select c1, c3 from t1 where c2 < 1 limit 10;
select c1, c3 from t1 where c2 < 1 limit 10;
explain select c1, c3 from t1 where c2 < 1 limit 100, 10;
select c1, c3 from t1 where c2 < 1 limit 100, 10;

--echo group_by and order_by

SELECT c1 FROM t1 GROUP BY c1 ORDER by c1 Limit 10;
SELECT c1 FROM t1 GROUP BY c1 HAVING c1 > 1 ORDER by c1 Limit 10;
SELECT c1 FROM t1 GROUP BY c1 HAVING 1 != 1 AND c1 > 1 ORDER by c1 Limit 10;
SELECT 0 AS x, c1 FROM t1 GROUP BY x, c1 HAVING x=1 AND c1 > 1 ORDER by c1 Limit 10;

--echo where and having
EXPLAIN SELECT c1 FROM t1 GROUP BY c1 HAVING (c1 % 11) > 1 ORDER by c1 Limit 10;
SELECT c1 FROM t1 GROUP BY c1 HAVING (c1 % 11) > 1 ORDER by c1 Limit 10;
SELECT c1, c3 FROM t1 GROUP BY c1, c3 HAVING c1 + c3 > 10 ORDER by c1, c3 Limit 10;
SELECT c1, c2 FROM t1 GROUP BY c1, c2 HAVING sin(c1 % 11) > 0.5 and cos(c2 % 7) < 0.5 ORDER by c1, c2 Limit 10, 10;

--echo aggregation
EXPLAIN SELECT c1, sum(c2) from t1 GROUP BY c1, c2 HAVING sum(c2) > 5 ORDER BY c1, c2 LIMIT 10;
SELECT c1, sum(c2) from t1 GROUP BY c1, c2 HAVING sum(c2) > 5 ORDER BY c1, c2 LIMIT 10;

SELECT c1, c2 from t1 GROUP BY c1, c2 HAVING avg(c2) > 5 ORDER BY c1, c2 LIMIT 10;
SELECT sum(c1), avg(c2) from t1 GROUP BY c1, c2 HAVING sum(c1) * avg(c2) > 25 ORDER BY c1, c2 LIMIT 10;

--echo multi table
explain select * from t1 join t1 as t2 on t1.c1 = t2.c1 limit 10;
select * from t1 join t1 as t2 on t1.c1 = t2.c1 limit 10;
explain select sum(t1.c1) from t1 left join t1 as t2 on t1.c1 = t2.c1 where t1.c2 > 10;
select sum(t1.c1) from t1 left join t1 as t2 on t1.c1 = t2.c1 where t1.c2 > 10;
explain select count(t1.c1) + sum(t2.c2) from t1 join t1 as t2 join t1 as t3 on t1.c1 = t2.c1 and t1.c2 = t3.c2 where true;
select count(t1.c1) + sum(t2.c2) from t1 join t1 as t2 join t1 as t3 on t1.c1 = t2.c1 and t1.c2 = t3.c2 where true;

--echo record buffer is initialized multi times in nested-loop join
set @@optimizer_switch='block_nested_loop=off';
explain select * from t1 join t1 as t2 on t1.c1 = t2.c1 limit 100, 10;
select * from t1 join t1 as t2 on t1.c1 = t2.c1 limit 100, 10;

--echo depend-ref join
explain select /*+PQ(t2) */ * from t1 join t1 as t2 on t1.c1 = t2.c1 order by t1.c1 limit 100, 10;
select /*+PQ(t2) */ * from t1 join t1 as t2 on t1.c1 = t2.c1 order by t1.c1 limit 100, 10;

set @@optimizer_switch='block_nested_loop=on';
--echo support record buffer in subquery

create view v1 (c1, c2) as (select t1.c1, t1.c2 from t1 join t1 as t2 on t1.c1 = t2.c1 limit 10);
explain select c1, c2 from v1;
select c1, c2 from v1;

explain select SUM(c1) from v1 group by c2;
select SUM(c1) from v1 group by c2;

--echo join other normal tables
explain select v1.c1, t1.c4 from v1 join t1 on v1.c1 = t1.c2;
select v1.c1, t1.c4 from v1 join t1 on v1.c1 = t1.c2;

SET BIG_TABLES=0;
explain select * from t1 join (select avg(c1) from v1 group by c1) as dt(a) on t1.c1 = dt.a;
select * from t1 join (select avg(c1) from v1 group by c1) as dt(a) on t1.c1 = dt.a;

SET BIG_TABLES=1;
explain select * from t1 join (select avg(c1) from v1 group by c1) as dt(a) on t1.c1 = dt.a;
select * from t1 join (select avg(c1) from v1 group by c1) as dt(a) on t1.c1 = dt.a;

--echo limit/offset in derived table
explain select * from t1 join (select c1 from v1 limit 5) as dt(a) on t1.c1 < dt.a;
select * from t1 join (select c1 from v1 limit 5) as dt(a) on t1.c1 < dt.a;

SET BIG_TABLES = 0;

--echo materialized subquery
set @saved_optimize_trace=@@optimizer_switch;
set session optimizer_switch='semijoin=on,materialization=on,loosescan=off,firstmatch=off,duplicateweedout=off';
explain select * from t1 where c1 IN (select c1 from v1) limit 10;
select * from t1 where c1 IN (select c1 from v1) limit 10;

explain select * from t1 where c1 IN (select c1 from v1 group by c1) limit 10;
select * from t1 where c1 IN (select c1 from v1 group by c1) limit 10;

set session optimizer_switch=@saved_optimize_trace;

--echo scalar subquery
explain select c2, (select avg(c1) from v1) as avg from t1 limit 10;
select c2, (select avg(c1) from v1) as avg from t1 limit 10;

explain select sum(t1.c1) from t1 group by (select avg(c1) from v1) + t1.c2;
select sum(t1.c1) from t1 group by (select avg(c1) from v1) + t1.c2;

explain select * from t1 where c1 > (select avg(c1) from v1) limit 10;
select * from t1 where c1 > (select avg(c1) from v1) limit 10;

explain select sum(c1), (select avg(c1) from v1) as avg from t1 group by c1 having sum(c1) > c1;
select sum(c1), (select avg(c1) from v1) as avg from t1 group by c1 having sum(c1) > c1;

drop view v1;
drop table t1;

## Test record_buffer switch off and prebuilt->n_fetch_rows is dirty for previous query

create table t1(a int);
insert into t1 select 1;
insert into t1 select 1;
insert into t1 select 1;

set debug="+d, pq_n_fetch_rows_dirty";
explain select a from t1;
select a from t1;

set debug="";
drop table t1;


