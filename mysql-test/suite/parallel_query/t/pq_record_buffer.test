--source include/have_debug.inc
--source include/pq_test.inc

## create tables for test, including normal table, hash partition table,
## list partition table, key partition table and range partition table

--echo normal table
drop table if exists record_buffer_table;
create table record_buffer_table (
	C_KEY INT NOT NULL auto_increment primary key,
	C_TIME TIME,
	C_DATETIME DATETIME,
	C_TIMESTAMP TIMESTAMP,
	C_INT_ID INTEGER,
	C_UINT_ID INTEGER unsigned,
	C_BIGINT_ID BIGINT,
	C_UBIGINT_ID BIGINT unsigned,
	C_TINYINT_ID TINYINT,
	C_UTINYINT_ID TINYINT unsigned,
	C_SMAILLINT_ID SMALLINT,
	C_USMALLINT_ID SMALLINT unsigned,
	C_MEDIUMINT_ID MEDIUMINT,
	C_UMEDIUMINT_ID MEDIUMINT unsigned,
	C_DOUBLE DOUBLE(16,4),
	C_DECIMAL DECIMAL(65,30),
	C_UDECIMAL DECIMAL(65,30) unsigned,
	C_CHARTWO CHAR(2),
	C_VARCHARTWN VARCHAR(20) NOT NULL,
	C_VARCHARS VARCHAR(64) NOT NULL,
	C_NUMERIC NUMERIC(28,10),
	C_REAL REAL NOT NULL,
	C_FLOAT FLOAT NOT NULL,
	C_BOOLEAN BOOLEAN NOT NULL,
	C_DATE DATE NOT NULL,
	C_VCHAR VARCHAR(1000),
	C_TEXT TEXT,
	C_BLOB BLOB,
	C_TINYTEXT TINYTEXT,
	C_MEDIUMBLOB MEDIUMBLOB,
	C_LONGBLOB LONGBLOB,
	C_PART_ID INTEGER
) CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

alter table record_buffer_table add key idx_1(C_UINT_ID);

--echo hash partition table
drop table if exists record_buffer_hash_table;
create table record_buffer_hash_table (
	C_KEY INT NOT NULL auto_increment,
	C_TIME TIME,
	C_DATETIME DATETIME,
	C_TIMESTAMP TIMESTAMP,
	C_INT_ID INTEGER,
	C_UINT_ID INTEGER unsigned,
	C_BIGINT_ID BIGINT,
	C_UBIGINT_ID BIGINT unsigned,
	C_TINYINT_ID TINYINT,
	C_UTINYINT_ID TINYINT unsigned,
	C_SMAILLINT_ID SMALLINT,
	C_USMALLINT_ID SMALLINT unsigned,
	C_MEDIUMINT_ID MEDIUMINT,
	C_UMEDIUMINT_ID MEDIUMINT unsigned,
	C_DOUBLE DOUBLE(16,4),
	C_DECIMAL DECIMAL(65,30),
	C_UDECIMAL DECIMAL(65,30) unsigned,
	C_CHARTWO CHAR(2),
	C_VARCHARTWN VARCHAR(20) NOT NULL,
	C_VARCHARS VARCHAR(64) NOT NULL,
	C_NUMERIC NUMERIC(28,10),
	C_REAL REAL NOT NULL,
	C_FLOAT FLOAT NOT NULL,
	C_BOOLEAN BOOLEAN NOT NULL,
	C_DATE DATE NOT NULL,
	C_VCHAR VARCHAR(1000),
	C_TEXT TEXT,
	C_BLOB BLOB,
	C_TINYTEXT TINYTEXT,
	C_MEDIUMBLOB MEDIUMBLOB,
	C_LONGBLOB LONGBLOB,
	C_PART_ID INTEGER,
	primary key(C_KEY,C_PART_ID)
) CHARSET=utf8mb4 COLLATE=utf8mb4_bin
partition by hash(C_PART_ID) partitions 3;

alter table record_buffer_hash_table add key idx_1(C_UINT_ID);

--echo list partition table
drop table if exists record_buffer_list_table;
create table record_buffer_list_table (
	C_KEY INT NOT NULL auto_increment,
	C_TIME TIME,
	C_DATETIME DATETIME,
	C_TIMESTAMP TIMESTAMP,
	C_INT_ID INTEGER,
	C_UINT_ID INTEGER unsigned,
	C_BIGINT_ID BIGINT,
	C_UBIGINT_ID BIGINT unsigned,
	C_TINYINT_ID TINYINT,
	C_UTINYINT_ID TINYINT unsigned,
	C_SMAILLINT_ID SMALLINT,
	C_USMALLINT_ID SMALLINT unsigned,
	C_MEDIUMINT_ID MEDIUMINT,
	C_UMEDIUMINT_ID MEDIUMINT unsigned,
	C_DOUBLE DOUBLE(16,4),
	C_DECIMAL DECIMAL(65,30),
	C_UDECIMAL DECIMAL(65,30) unsigned,
	C_CHARTWO CHAR(2),
	C_VARCHARTWN VARCHAR(20) NOT NULL,
	C_VARCHARS VARCHAR(64) NOT NULL,
	C_NUMERIC NUMERIC(28,10),
	C_REAL REAL NOT NULL,
	C_FLOAT FLOAT NOT NULL,
	C_BOOLEAN BOOLEAN NOT NULL,
	C_DATE DATE NOT NULL,
	C_VCHAR VARCHAR(1000),
	C_TEXT TEXT,
	C_BLOB BLOB,
	C_TINYTEXT TINYTEXT,
	C_MEDIUMBLOB MEDIUMBLOB,
	C_LONGBLOB LONGBLOB,
	C_PART_ID INTEGER,
	primary key(C_KEY,C_PART_ID)
) CHARSET=utf8mb4 COLLATE=utf8mb4_bin
partition by list(C_PART_ID)(
partition smalldata values in (1,2,3,4,5),
partition mediumdata values in (6,7,8,9,10),
partition bigdata values in (11,12,13,14,15)
);

alter table record_buffer_list_table add key idx_1(C_UINT_ID);

--echo key partition table
drop table if exists record_buffer_key_table;
create table record_buffer_key_table (
	C_KEY INT NOT NULL auto_increment,
	C_TIME TIME,
	C_DATETIME DATETIME,
	C_TIMESTAMP TIMESTAMP,
	C_INT_ID INTEGER,
	C_UINT_ID INTEGER unsigned,
	C_BIGINT_ID BIGINT,
	C_UBIGINT_ID BIGINT unsigned,
	C_TINYINT_ID TINYINT,
	C_UTINYINT_ID TINYINT unsigned,
	C_SMAILLINT_ID SMALLINT,
	C_USMALLINT_ID SMALLINT unsigned,
	C_MEDIUMINT_ID MEDIUMINT,
	C_UMEDIUMINT_ID MEDIUMINT unsigned,
	C_DOUBLE DOUBLE(16,4),
	C_DECIMAL DECIMAL(65,30),
	C_UDECIMAL DECIMAL(65,30) unsigned,
	C_CHARTWO CHAR(2),
	C_VARCHARTWN VARCHAR(20) NOT NULL,
	C_VARCHARS VARCHAR(64) NOT NULL,
	C_NUMERIC NUMERIC(28,10),
	C_REAL REAL NOT NULL,
	C_FLOAT FLOAT NOT NULL,
	C_BOOLEAN BOOLEAN NOT NULL,
	C_DATE DATE NOT NULL,
	C_VCHAR VARCHAR(1000),
	C_TEXT TEXT,
	C_BLOB BLOB,
	C_TINYTEXT TINYTEXT,
	C_MEDIUMBLOB MEDIUMBLOB,
	C_LONGBLOB LONGBLOB,
	C_PART_ID INTEGER,
	primary key(C_KEY,C_PART_ID)
) CHARSET=utf8mb4 COLLATE=utf8mb4_bin
partition by LINEAR KEY(C_PART_ID) partitions 8;

alter table record_buffer_key_table add key idx_1(C_UINT_ID);

--echo range partition table
drop table if exists record_buffer_range_table;
create table record_buffer_range_table (
	C_KEY INT NOT NULL auto_increment,
	C_TIME TIME,
	C_DATETIME DATETIME,
	C_TIMESTAMP TIMESTAMP,
	C_INT_ID INTEGER,
	C_UINT_ID INTEGER unsigned,
	C_BIGINT_ID BIGINT,
	C_UBIGINT_ID BIGINT unsigned,
	C_TINYINT_ID TINYINT,
	C_UTINYINT_ID TINYINT unsigned,
	C_SMAILLINT_ID SMALLINT,
	C_USMALLINT_ID SMALLINT unsigned,
	C_MEDIUMINT_ID MEDIUMINT,
	C_UMEDIUMINT_ID MEDIUMINT unsigned,
	C_DOUBLE DOUBLE(16,4),
	C_DECIMAL DECIMAL(65,30),
	C_UDECIMAL DECIMAL(65,30) unsigned,
	C_CHARTWO CHAR(2),
	C_VARCHARTWN VARCHAR(20) NOT NULL,
	C_VARCHARS VARCHAR(64) NOT NULL,
	C_NUMERIC NUMERIC(28,10),
	C_REAL REAL NOT NULL,
	C_FLOAT FLOAT NOT NULL,
	C_BOOLEAN BOOLEAN NOT NULL,
	C_DATE DATE NOT NULL,
	C_VCHAR VARCHAR(1000),
	C_TEXT TEXT,
	C_BLOB BLOB,
	C_TINYTEXT TINYTEXT,
	C_MEDIUMBLOB MEDIUMBLOB,
	C_LONGBLOB LONGBLOB,
	C_PART_ID INTEGER,
	primary key(C_KEY,C_PART_ID)
) CHARSET=utf8 COLLATE=utf8_bin
partition by RANGE (C_PART_ID)(
partition smalldata values less than (6),
partition mediumdata values less than (10),
partition bigdata values less than (16)
);

alter table record_buffer_range_table add key idx_1(C_UINT_ID);

## generate records

let $1=1000;
--disable_query_log

while($1)
{
  INSERT INTO record_buffer_table(C_TIME,C_DATETIME,C_TIMESTAMP,C_INT_ID,C_UINT_ID,C_BIGINT_ID,C_UBIGINT_ID,C_TINYINT_ID,C_UTINYINT_ID,C_SMAILLINT_ID,C_USMALLINT_ID,C_MEDIUMINT_ID,C_UMEDIUMINT_ID,C_DOUBLE,C_DECIMAL,C_UDECIMAL,C_CHARTWO,C_VARCHARTWN,C_VARCHARS,C_NUMERIC,C_REAL,C_FLOAT,C_BOOLEAN,C_DATE,C_VCHAR,C_TEXT,C_BLOB,C_TINYTEXT,C_MEDIUMBLOB,C_LONGBLOB,C_PART_ID)
	VALUES (
		'17:14:15',
		'2021-07-21 17:14:15',
		'2021-07-21 17:14:15',
		1147483647-RAND(202112021332)*2147483647,
		RAND(202112021332)*4294967295,
		4223372036854775807-RAND(202112021332)*9223372036854775807,
		RAND(202112021332)*18446744073709551615,
		64-RAND(202112021332)*128,
		RAND(202112021332)*255,
		22767-RAND(202112021332)*32767,
		RAND(202112021332)*65535,
		4388607-RAND(202112021332)*8388607,
		RAND(202112021332)*16777215,
		RAND(202112021332)*100000000000+RAND(202112021332),
		RAND(202112021332)*1000000000000000000+RAND(202112021332),
		RAND(202112021332)*1000000000000000000+RAND(202112021332),
		'q2',
		'dfecddfecddfecddfecd',
		'wevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbds',
		RAND(202112021332)*1000000000000000000+RAND(202112021332),
		234232400000000000.3454,
		520023400000000000.235,
		true,
		'2021-07-22',
		'',
		'',
		'',
		'wevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbds',
		'wevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbds',
		'wevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbdswevfwbds',
		1
	);
	dec $1;
}
--enable_query_log

## fill record into other tables

insert into record_buffer_hash_table select * from record_buffer_table;
insert into record_buffer_range_table select * from record_buffer_table;
insert into record_buffer_list_table select * from record_buffer_table;
insert into record_buffer_key_table select * from record_buffer_table;

analyze table record_buffer_table;
analyze table record_buffer_hash_table;
analyze table record_buffer_range_table;
analyze table record_buffer_list_table;
analyze table record_buffer_key_table;

