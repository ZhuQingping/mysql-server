# Test: pq_explain_off
# Verify that when parallel_query=OFF, no PQ annotation appears in EXPLAIN.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (id INT PRIMARY KEY, val INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10),(2,20),(3,30),(4,40),(5,50);

# PQ OFF by default - EXPLAIN should show no PQ annotation
EXPLAIN SELECT * FROM t1;

EXPLAIN FORMAT=TREE SELECT * FROM t1;

# Explicitly OFF
SET SESSION parallel_query=OFF;
EXPLAIN SELECT * FROM t1;

DROP TABLE t1;