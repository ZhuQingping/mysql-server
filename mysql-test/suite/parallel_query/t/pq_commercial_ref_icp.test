# Test: pq_commercial_ref_icp
# M9-A guard: secondary index range/ref/ICP still fall back before commercial
# secondary-index execution is enabled.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS pq_ref_icp_t1, pq_ref_icp_t2, pq_ref_icp_t3,
                     pq_ref_icp_t4, pq_ref_icp_mvi, pq_ref_icp_part,
                     pq_ref_icp_mvi_mixed, pq_ref_icp_mvi_outer,
                     pq_ref_icp_rev, pq_ref_icp_min, pq_ref_icp_blob;
--enable_warnings

CREATE TABLE pq_ref_icp_t1 (
  id INT PRIMARY KEY,
  k INT NOT NULL,
  v INT NOT NULL,
  pad CHAR(8),
  KEY k_idx(k),
  KEY k_v_idx(k, v),
  KEY k_pad_idx(k, pad)
) ENGINE=InnoDB;

CREATE TABLE pq_ref_icp_t2 (
  id INT PRIMARY KEY,
  k INT NOT NULL,
  KEY k_idx(k)
) ENGINE=InnoDB;

CREATE TABLE pq_ref_icp_t3 (
  id INT PRIMARY KEY,
  k INT NOT NULL,
  KEY k_idx(k)
) ENGINE=InnoDB;

CREATE TABLE pq_ref_icp_t4 (
  id INT PRIMARY KEY,
  k INT NOT NULL,
  icp_col INT NOT NULL,
  payload INT NOT NULL,
  KEY k_icp_idx(k, icp_col)
) ENGINE=InnoDB;

CREATE TABLE pq_ref_icp_mvi (
  id INT PRIMARY KEY,
  doc_id INT NOT NULL,
  b INT NOT NULL,
  doc JSON,
  KEY mv_doc_id_b (
    doc_id,
    b,
    (CAST(JSON_EXTRACT(doc, '$.val') AS UNSIGNED ARRAY)))
) ENGINE=InnoDB;

CREATE TABLE pq_ref_icp_mvi_mixed (
  id INT PRIMARY KEY,
  doc_id INT NOT NULL,
  b INT NOT NULL,
  doc JSON,
  KEY normal_doc_id (doc_id),
  KEY mv_doc_id_b (
    doc_id,
    b,
    (CAST(JSON_EXTRACT(doc, '$.val') AS UNSIGNED ARRAY)))
) ENGINE=InnoDB;

CREATE TABLE pq_ref_icp_part (
  id INT NOT NULL,
  k INT NOT NULL,
  KEY k_idx(k)
) ENGINE=InnoDB
PARTITION BY HASH(id) PARTITIONS 2;

CREATE TABLE pq_ref_icp_mvi_outer (
  id INT PRIMARY KEY,
  doc_id INT NOT NULL,
  b INT NOT NULL
) ENGINE=InnoDB;

CREATE TABLE pq_ref_icp_rev (
  id INT PRIMARY KEY,
  k INT NOT NULL,
  KEY k_idx(k)
) ENGINE=InnoDB;

CREATE TABLE pq_ref_icp_min (
  id INT PRIMARY KEY,
  i INT NOT NULL,
  j INT NOT NULL,
  KEY j_idx(j)
) ENGINE=InnoDB;

CREATE TABLE pq_ref_icp_blob (
  id INT PRIMARY KEY,
  k INT NOT NULL,
  payload BLOB,
  KEY k_idx(k)
) ENGINE=InnoDB;

INSERT INTO pq_ref_icp_t1 VALUES
  (1,10,100,'a'),(2,20,200,'b'),(3,20,210,'c'),
  (4,30,300,'d'),(5,40,400,'e'),(6,50,500,'f');
INSERT INTO pq_ref_icp_t2 VALUES (1,20),(2,30);
INSERT INTO pq_ref_icp_t3 VALUES (1,20),(2,20),(3,999),(4,30),(5,20);
INSERT INTO pq_ref_icp_t4 VALUES
  (1,20,100,1000),(2,20,110,1100),(3,30,300,3000),
  (4,40,400,4000);
INSERT INTO pq_ref_icp_mvi VALUES
  (1,2,2,'{"val":[1,2]}'),(2,2,2,'{"val":[2,3]}'),
  (3,1,1,'{"val":[3,4]}');
INSERT INTO pq_ref_icp_mvi_mixed VALUES
  (1,2,2,'{"val":[1,2]}'),(2,2,2,'{"val":[2,3]}'),
  (3,1,1,'{"val":[3,4]}');
INSERT INTO pq_ref_icp_part VALUES
  (1,10),(2,20),(3,20),(4,30),(5,40);
INSERT INTO pq_ref_icp_mvi_outer VALUES (1,2,2),(2,1,1),(3,999,9);
INSERT INTO pq_ref_icp_rev VALUES
  (1,10),(2,20),(3,20),(4,30),(5,40);
INSERT INTO pq_ref_icp_min VALUES
  (1,1,10),(2,2,20),(3,3,30);
INSERT INTO pq_ref_icp_blob VALUES
  (1,10,'a'),(2,20,'b'),(3,30,'c');

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;
SET SESSION parallel_query_experimental_threaded_dop=ON;

SET @secondary_range_probe_attempts_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_range_probe_attempts');
SET @secondary_range_probe_unsupported_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_range_probe_unsupported');
SET @secondary_range_clone_attempts_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_range_clone_attempts');
SET @secondary_range_clone_failed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_range_clone_failed');
SET @secondary_ranges_built_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_ranges_built');
SET @secondary_rows_produced_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_rows_produced');
SET @secondary_rows_materialized_smoke_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_rows_materialized_smoke');
SET @secondary_visibility_attempts_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_visibility_attempts');
SET @secondary_visibility_supported_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_visibility_supported');
SET @secondary_visibility_unsupported_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_visibility_unsupported');

# Secondary ref remains an explicit NON_FULL_TABLE_SCAN fallback.
--disable_warnings
--replace_column 10 #
EXPLAIN SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx) WHERE k = 20;
--enable_warnings

# Secondary range with ICP enabled remains fallback.
--disable_warnings
--replace_column 10 #
EXPLAIN SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx)
  WHERE k BETWEEN 20 AND 40 AND v > 150;
--enable_warnings

# Primary range remains fallback but must not count as secondary range probe.
--disable_warnings
--replace_column 10 #
EXPLAIN SELECT * FROM pq_ref_icp_t1 FORCE INDEX(PRIMARY)
  WHERE id BETWEEN 2 AND 4;
--enable_warnings

# The guard must not depend on the optimizer printing "Using index condition".
SET @old_optimizer_switch = @@optimizer_switch;
SET SESSION optimizer_switch='index_condition_pushdown=off';
--disable_warnings
--replace_column 10 #
EXPLAIN SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx)
  WHERE k BETWEEN 20 AND 40 AND v > 150;
--enable_warnings
SET SESSION optimizer_switch=@old_optimizer_switch;

# M9-E0: ICP negative guard. The secondary range shape must prove real ICP
# with EXPLAIN. The ref/dependent-ref shapes guard the adjacent fallback
# boundary and must remain serial with no PQ execution or secondary rows.
SET @e0_icp_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @e0_icp_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');
SET @e0_icp_ranges_built_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_built');
SET @e0_icp_ranges_dispatched_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_dispatched');
SET @e0_icp_secondary_rows_produced_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_rows_produced');

# Secondary range ICP.
--disable_warnings
--replace_column 10 #
EXPLAIN SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx)
  WHERE k BETWEEN 20 AND 40 AND v > 150;
--enable_warnings
--sorted_result
SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx)
  WHERE k BETWEEN 20 AND 40 AND v > 150;
SET SESSION optimizer_switch='index_condition_pushdown=off';
--sorted_result
SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx)
  WHERE k BETWEEN 20 AND 40 AND v > 150;
SET SESSION optimizer_switch=@old_optimizer_switch;

# Constant ref boundary: with k fully consumed as ref access, this schema has
# no stable remaining index condition to push. Keep the runtime boundary serial.
--disable_warnings
--replace_column 10 #
EXPLAIN SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx)
  WHERE k = 20 AND v > 150;
--enable_warnings
--sorted_result
SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx)
  WHERE k = 20 AND v > 150;
SET SESSION optimizer_switch='index_condition_pushdown=off';
--sorted_result
SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx)
  WHERE k = 20 AND v > 150;
SET SESSION optimizer_switch=@old_optimizer_switch;

# Dependent ref boundary: with the join key fully consumed as dependent ref,
# this schema has no stable remaining index condition to push. Keep it serial.
--disable_warnings
--replace_column 10 #
EXPLAIN SELECT pq_ref_icp_t3.id AS outer_id, pq_ref_icp_t1.id AS inner_id,
       pq_ref_icp_t1.k, pq_ref_icp_t1.v, pq_ref_icp_t1.pad
  FROM pq_ref_icp_t3 STRAIGHT_JOIN pq_ref_icp_t1 FORCE INDEX(k_idx)
    ON pq_ref_icp_t1.k = pq_ref_icp_t3.k
  WHERE pq_ref_icp_t1.v > 150;
--enable_warnings
--sorted_result
SELECT pq_ref_icp_t3.id AS outer_id, pq_ref_icp_t1.id AS inner_id,
       pq_ref_icp_t1.k, pq_ref_icp_t1.v, pq_ref_icp_t1.pad
  FROM pq_ref_icp_t3 STRAIGHT_JOIN pq_ref_icp_t1 FORCE INDEX(k_idx)
    ON pq_ref_icp_t1.k = pq_ref_icp_t3.k
  WHERE pq_ref_icp_t1.v > 150;
SET SESSION optimizer_switch='index_condition_pushdown=off';
--sorted_result
SELECT pq_ref_icp_t3.id AS outer_id, pq_ref_icp_t1.id AS inner_id,
       pq_ref_icp_t1.k, pq_ref_icp_t1.v, pq_ref_icp_t1.pad
  FROM pq_ref_icp_t3 STRAIGHT_JOIN pq_ref_icp_t1 FORCE INDEX(k_idx)
    ON pq_ref_icp_t1.k = pq_ref_icp_t3.k
  WHERE pq_ref_icp_t1.v > 150;
SET SESSION optimizer_switch=@old_optimizer_switch;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_queries_executed') -
     @e0_icp_executed_before
    AS e0_icp_executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_workers_launched') - @e0_icp_workers_before
    AS e0_icp_workers_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_ranges_built') -
     @e0_icp_ranges_built_before
    AS e0_icp_ranges_built_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_ranges_dispatched') -
     @e0_icp_ranges_dispatched_before
    AS e0_icp_ranges_dispatched_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_secondary_rows_produced') -
     @e0_icp_secondary_rows_produced_before
    AS e0_icp_secondary_rows_produced_delta;

# Debug-only M9-E1c-1 smoke: evaluate ICP on a non-covering secondary range,
# fetch one clustered record, and materialize it without opening user-visible
# PQ execution.
SET @e1c1_materialized_smoke_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_rows_materialized_smoke');
SET @e1c1_secondary_rows_produced_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_rows_produced');
SET @e1c1_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @e1c1_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');
SET @e1c1_ranges_built_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_built');
SET @e1c1_ranges_dispatched_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_dispatched');
SET @old_debug=@@session.debug;
SET SESSION debug="d,pq_secondary_noncovering_icp_one_record_smoke";
--disable_warnings
--replace_column 10 #
EXPLAIN SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx)
  WHERE k >= 20 AND k < 40 AND v > 150;
--enable_warnings
SET SESSION debug=@old_debug;
SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_secondary_rows_materialized_smoke') -
      @e1c1_materialized_smoke_before
    AS e1c1_materialized_smoke_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_secondary_rows_produced') -
      @e1c1_secondary_rows_produced_before
    AS e1c1_secondary_rows_produced_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_queries_executed') -
      @e1c1_executed_before
    AS e1c1_executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_workers_launched') -
      @e1c1_workers_before
    AS e1c1_workers_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_ranges_built') -
      @e1c1_ranges_built_before
    AS e1c1_ranges_built_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_ranges_dispatched') -
      @e1c1_ranges_dispatched_before
    AS e1c1_ranges_dispatched_delta;

# M9-E1c-2a: user-visible non-covering secondary range ICP gate. The selected
# columns are intentionally limited to non-null integer fields. payload is not
# covered by k_icp_idx, while icp_col is an indexed ICP predicate column, so only
# one ICP_MATCH row should be materialized from the clustered record.
SET @e1c2_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @e1c2_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');
SET @e1c2_ranges_built_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_built');
SET @e1c2_ranges_dispatched_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_dispatched');
SET @e1c2_secondary_rows_produced_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_rows_produced');
--disable_warnings
--replace_column 10 #
EXPLAIN SELECT id, k, payload FROM pq_ref_icp_t4 FORCE INDEX(k_icp_idx)
  WHERE k >= 20 AND k < 40 AND icp_col >= 250;
--enable_warnings
--sorted_result
SELECT id, k, payload FROM pq_ref_icp_t4 FORCE INDEX(k_icp_idx)
  WHERE k >= 20 AND k < 40 AND icp_col >= 250;
SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_queries_executed') -
      @e1c2_executed_before
    AS e1c2_executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_workers_launched') -
      @e1c2_workers_before
    AS e1c2_workers_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_ranges_built') -
      @e1c2_ranges_built_before
    AS e1c2_ranges_built_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_ranges_dispatched') -
      @e1c2_ranges_dispatched_before
    AS e1c2_ranges_dispatched_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_secondary_rows_produced') -
      @e1c2_secondary_rows_produced_before
    AS e1c2_secondary_rows_produced_delta;

# No-ICP clustered-read boundaries outside the bounded upper-row gate do not
# execute PQ here. Unsafe read sets remain fail-closed below.
SET @e1c2_no_icp_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @e1c2_no_icp_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @e1c2_no_icp_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');
SET @e1c2_no_icp_ranges_built_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_built');
SET @e1c2_no_icp_ranges_dispatched_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_dispatched');
SET @e1c2_no_icp_secondary_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_rows_produced');
SET SESSION optimizer_switch='index_condition_pushdown=off';
--sorted_result
SELECT id, k, payload FROM pq_ref_icp_t4 FORCE INDEX(k_icp_idx)
  WHERE k >= 20 AND k < 40 AND icp_col >= 250;
SET SESSION optimizer_switch=@old_optimizer_switch;
SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_queries_executed') -
      @e1c2_no_icp_executed_before
    AS e1c2_no_icp_executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_queries_fallback') -
      @e1c2_no_icp_fallback_before
    AS e1c2_no_icp_fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_workers_launched') -
      @e1c2_no_icp_workers_before
    AS e1c2_no_icp_workers_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_ranges_built') -
      @e1c2_no_icp_ranges_built_before
    AS e1c2_no_icp_ranges_built_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_ranges_dispatched') -
      @e1c2_no_icp_ranges_dispatched_before
    AS e1c2_no_icp_ranges_dispatched_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_secondary_rows_produced') -
      @e1c2_no_icp_secondary_rows_before
    AS e1c2_no_icp_secondary_rows_delta;

SET @e1c2_unsafe_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @e1c2_unsafe_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @e1c2_unsafe_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');
SET @e1c2_unsafe_ranges_built_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_built');
SET @e1c2_unsafe_ranges_dispatched_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_dispatched');
SET @e1c2_unsafe_secondary_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_secondary_rows_produced');
--sorted_result
SELECT * FROM pq_ref_icp_t1 FORCE INDEX(k_idx)
  WHERE k >= 20 AND k < 40 AND v > 250;
SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_queries_executed') -
      @e1c2_unsafe_executed_before
    AS e1c2_unsafe_executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_queries_fallback') -
      @e1c2_unsafe_fallback_before
    AS e1c2_unsafe_fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_workers_launched') -
      @e1c2_unsafe_workers_before
    AS e1c2_unsafe_workers_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_ranges_built') -
      @e1c2_unsafe_ranges_built_before
    AS e1c2_unsafe_ranges_built_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_ranges_dispatched') -
      @e1c2_unsafe_ranges_dispatched_before
    AS e1c2_unsafe_ranges_dispatched_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_secondary_rows_produced') -
      @e1c2_unsafe_secondary_rows_before
    AS e1c2_unsafe_secondary_rows_delta;

# Debug-only M9-B2/B3a-0 smoke: build secondary range partitions and prove
