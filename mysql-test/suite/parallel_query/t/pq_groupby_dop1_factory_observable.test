# Test: pq_groupby_dop1_factory_observable
# V2-12A-3.4c: GROUP BY DOP1 experimental hook is observable while
# native aggregate iterators still own SQL result construction.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (id INT PRIMARY KEY, val INT NOT NULL) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10),(2,10),(3,20),(4,20),(5,30);

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=1;
SET SESSION parallel_query_experimental_groupby_dop1=OFF;

SET @pq_groupby_attempts_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_factory_attempts');
SET @pq_groupby_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_factory_fallback');
SET @pq_groupby_shape_supported_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_temp_shape_supported');

SELECT val, COUNT(*) AS cnt FROM t1 GROUP BY val;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_groupby_dop1_factory_attempts') -
      @pq_groupby_attempts_before AS attempts_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_groupby_dop1_factory_fallback') -
      @pq_groupby_fallback_before AS fallback_delta;

SET SESSION parallel_query_experimental_groupby_dop1=ON;

EXPLAIN SELECT val, COUNT(*) AS cnt FROM t1 GROUP BY val;

SET @pq_groupby_attempts_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_factory_attempts');
SET @pq_groupby_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_factory_fallback');

SELECT val, COUNT(*) AS cnt FROM t1 GROUP BY val;

SELECT
  ((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_factory_attempts') -
      @pq_groupby_attempts_before) >= 1 AS factory_attempted,
  ((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_dop1_factory_fallback') -
      @pq_groupby_fallback_before) >= 1 AS factory_fallback,
  ((SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_groupby_temp_shape_supported') -
      @pq_groupby_shape_supported_before) >= 1 AS temp_shape_supported;

SET SESSION parallel_query_experimental_groupby_dop1=OFF;
SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;
