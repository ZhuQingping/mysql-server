# Test: pq_commercial_batch_sysvars
# Commercial PQ batch-buffer sysvar visibility and session contract.

--source include/have_innodb_16k.inc

SELECT @@session.parallel_batch_max_slot;
SELECT @@session.parallel_batch_max_mem_size;
SELECT @@global.parallel_batch_max_slot;
SELECT @@global.parallel_batch_max_mem_size;

SET SESSION parallel_batch_max_slot=0;
SELECT @@session.parallel_batch_max_slot;
SET SESSION parallel_batch_max_slot=1024;
SELECT @@session.parallel_batch_max_slot;
SET SESSION parallel_batch_max_slot=1025;
SHOW WARNINGS;
SELECT @@session.parallel_batch_max_slot;

SET SESSION parallel_batch_max_mem_size=0;
SELECT @@session.parallel_batch_max_mem_size;
SET SESSION parallel_batch_max_mem_size=1048576;
SELECT @@session.parallel_batch_max_mem_size;

SET SESSION parallel_batch_max_slot=-1;
SHOW WARNINGS;
SELECT @@session.parallel_batch_max_slot;
SET SESSION parallel_batch_max_slot=8;

SET SESSION parallel_batch_max_mem_size=-1;
SHOW WARNINGS;
SELECT @@session.parallel_batch_max_mem_size;

SET SESSION parallel_batch_max_slot=DEFAULT;
SET SESSION parallel_batch_max_mem_size=DEFAULT;
SELECT @@session.parallel_batch_max_slot;
SELECT @@session.parallel_batch_max_mem_size;
