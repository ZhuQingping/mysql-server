    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_pqwr_record_gather_selected');
SET @visible_pqwr_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_visible_pqwr_record_gather_rows');

SET SESSION debug = 'd,pq_worker_void_pull_fullscan_smoke';

--sorted_result
SELECT id FROM t1 WHERE val >= 10;

SET SESSION debug = '';

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_worker_void_pull_attempts') -
    @void_pull_attempts_before AS attempts_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_worker_void_pull_success') -
    @void_pull_success_before AS success_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_worker_void_pull_rows') -
    @void_pull_rows_before AS rows_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_worker_void_pull_eofs') -
    @void_pull_eofs_before AS eofs_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_worker_void_pull_unsupported') -
    @void_pull_unsupported_before AS unsupported_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_worker_void_pull_failures') -
    @void_pull_failures_before AS failures_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_worker_void_pull_cleanup') -
    @void_pull_cleanup_before AS cleanup_delta;

SELECT
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_worker_void_pull_success') -
      @void_pull_success_before) =
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_worker_void_pull_cleanup') -
      @void_pull_cleanup_before) AS cleanup_matches_success;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_pqwr_record_gather_selected') -
    @visible_pqwr_selected_before AS visible_pqwr_selected_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_visible_pqwr_record_gather_rows') -
    @visible_pqwr_rows_before AS visible_pqwr_rows_delta;

# D1.8 explicit visible fullscan void-pull hook remains valid after D1.9 made
# the same path the default eligible DOP2 fullscan route.
SELECT COUNT(*) AS visible_void_pull_status_vars
  FROM performance_schema.global_status
  WHERE variable_name IN (
    'Parallel_visible_void_pull_selected',
    'Parallel_visible_void_pull_rows',
