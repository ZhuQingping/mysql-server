# BUG2022082603144
# USER()/CURRENT_USER()/SESSION_USER()/SYSTEM_USER()
# not need to use paralle_query
--source include/pq_test.inc

create table t0(id int);
insert into t0 values(1),(2),(3),(4),(5);

explain select USER() from t0;
explain select CURRENT_USER() from t0;
explain select SESSION_USER() from t0;
explain select SYSTEM_USER() from t0;

select USER() from t0;
select CURRENT_USER() from t0;
select SESSION_USER() from t0;
select SYSTEM_USER() from t0;

DROP TABLE t0;
