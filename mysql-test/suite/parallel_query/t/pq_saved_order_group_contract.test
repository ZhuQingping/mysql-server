# Test: pq_saved_order_group_contract
# M11-E5d-S1/S2: saved ORDER/GROUP helper contract remains fail-closed.

--source include/have_innodb_16k.inc
--source include/have_debug.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  k INT NOT NULL,
  pad CHAR(8) NOT NULL
) ENGINE=InnoDB;

INSERT INTO t1 VALUES
  (1,30,'c'),(2,10,'a'),(3,20,'b'),(4,20,'d');

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;

SET @pq_saved_contract_attempts_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_saved_order_group_contract_attempts');
SET @pq_saved_contract_unsupported_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_saved_order_group_contract_unsupported');
SET @pq_saved_restore_attempts_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_saved_order_group_restore_smoke_attempts');
SET @pq_saved_restore_success_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_saved_order_group_restore_smoke_success');
SET @pq_saved_restore_unsupported_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_saved_order_group_restore_smoke_unsupported');
SET @pq_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @pq_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');
SET @pq_ranges_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_dispatched');

SET @old_debug=@@SESSION.debug;

# Without DBUG, the restore smoke is not entered.
EXPLAIN SELECT id, k FROM t1 ORDER BY k ASC, id ASC LIMIT 2;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_group_restore_smoke_attempts') -
      @pq_saved_restore_attempts_before AS restore_attempts_without_debug,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_group_restore_smoke_success') -
      @pq_saved_restore_success_before AS restore_success_without_debug,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_group_restore_smoke_unsupported') -
      @pq_saved_restore_unsupported_before AS restore_unsupported_without_debug;

SET SESSION debug="d,pq_saved_order_group_contract_smoke,pq_saved_order_group_restore_smoke";

EXPLAIN SELECT id, k FROM t1 ORDER BY k ASC, id ASC LIMIT 2;

SET SESSION debug=@old_debug;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_group_contract_attempts') -
      @pq_saved_contract_attempts_before AS saved_contract_attempts_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_group_contract_unsupported') -
      @pq_saved_contract_unsupported_before AS saved_contract_unsupported_delta;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_group_restore_smoke_attempts') -
      @pq_saved_restore_attempts_before AS saved_restore_attempts_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_group_restore_smoke_success') -
      @pq_saved_restore_success_before AS saved_restore_success_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_group_restore_smoke_unsupported') -
      @pq_saved_restore_unsupported_before AS saved_restore_unsupported_delta;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_queries_executed') -
      @pq_executed_before AS executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_workers_launched') -
      @pq_workers_before AS workers_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_ranges_dispatched') -
      @pq_ranges_before AS ranges_delta;

SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;
