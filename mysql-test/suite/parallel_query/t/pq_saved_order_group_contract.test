     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_chain_flags_smoke_success') -
      @pq_order_chain_flags_success_before AS order_chain_flags_success_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_chain_flags_smoke_unsupported') -
      @pq_order_chain_flags_unsupported_before AS order_chain_flags_unsupported_delta;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_chain_restore_smoke_attempts') -
      @pq_order_chain_restore_attempts_before AS order_chain_restore_attempts_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_chain_restore_smoke_success') -
      @pq_order_chain_restore_success_before AS order_chain_restore_success_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_chain_restore_smoke_unsupported') -
      @pq_order_chain_restore_unsupported_before AS order_chain_restore_unsupported_delta;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_chain_clone_copy_smoke_attempts') -
      @pq_order_chain_clone_copy_attempts_before AS order_chain_clone_copy_attempts_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_chain_clone_copy_smoke_success') -
      @pq_order_chain_clone_copy_success_before AS order_chain_clone_copy_success_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_saved_order_chain_clone_copy_smoke_unsupported') -
      @pq_order_chain_clone_copy_unsupported_before AS order_chain_clone_copy_unsupported_delta;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_queries_executed') -
      @pq_executed_before AS executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_workers_launched') -
      @pq_workers_before AS workers_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_ranges_dispatched') -
      @pq_ranges_before AS ranges_delta;

SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;
