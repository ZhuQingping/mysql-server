# Test: pq_commercial_order_by
# M8: commercial ORDER BY gather-merge skeleton remains synthetic-only.

--source include/have_innodb_16k.inc
--source include/have_debug.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (
  id INT PRIMARY KEY,
  k INT NOT NULL,
  pad CHAR(8) NOT NULL
) ENGINE=InnoDB;

INSERT INTO t1 VALUES
  (1,30,'c'),(2,10,'a'),(3,20,'b'),(4,20,'d'),
  (5,40,'e'),(6,10,'f');

SELECT variable_name FROM performance_schema.global_status
  WHERE variable_name IN (
    'Parallel_exchange_sort_smoke_runs',
    'Parallel_exchange_sort_smoke_rows')
  ORDER BY variable_name;

SET @pq_sort_smoke_runs_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_exchange_sort_smoke_runs');
SET @pq_sort_smoke_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_exchange_sort_smoke_rows');

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;
SET SESSION parallel_query_experimental_threaded_dop=ON;

--sorted_result
SELECT * FROM t1;

SELECT
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_exchange_sort_smoke_runs') -
      @pq_sort_smoke_runs_before) >= 1 AS orderby_smoke_runs_nonzero,
  ((SELECT CAST(variable_value AS UNSIGNED)
      FROM performance_schema.global_status
      WHERE variable_name = 'Parallel_exchange_sort_smoke_rows') -
      @pq_sort_smoke_rows_before) >= 12 AS orderby_smoke_rows_nonzero;

SET @pq_executed_before_order = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before_order = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_workers_before_order = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');
SET @pq_ranges_before_order = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_ranges_dispatched');
SET @pq_orderby_elig_attempts_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_eligibility_contract_attempts');
SET @pq_orderby_elig_candidate_disabled_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_eligibility_contract_candidate_disabled');
SET @pq_orderby_elig_unsupported_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_eligibility_contract_unsupported');
SET @pq_orderby_preflight_attempts_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_execution_preflight_attempts');
SET @pq_orderby_preflight_blocked_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_execution_preflight_blocked');
SET @pq_orderby_preflight_ready_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_execution_preflight_ready');
SET @pq_orderby_preflight_missing_filesort_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_preflight_missing_filesort');
SET @pq_orderby_preflight_missing_sort_param_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_preflight_missing_sort_param');
SET @pq_orderby_preflight_missing_worker_frame_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_preflight_missing_worker_frame');
SET @pq_orderby_preflight_missing_exchange_heap_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_preflight_missing_exchange_heap');
SET @pq_orderby_preflight_missing_leader_mat_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_preflight_missing_leader_materialize');
SET @pq_orderby_preflight_missing_rowid_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_preflight_missing_rowid');
SET @pq_orderby_preflight_missing_ordered_read_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_preflight_missing_ordered_read');
SET @pq_orderby_preflight_missing_error_diag_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_orderby_preflight_missing_error_diag');

# 5e-1/5e-2: first visible ORDER BY candidate is recognized, but execution
# remains disabled by the central preflight blocker. The query must still be
# optimizer-rejected as HAS_ORDER_BY.
SET @old_debug=@@debug;
SET SESSION debug="+d,pq_orderby_eligibility_contract_smoke";
SET SESSION debug="+d,pq_orderby_execution_preflight_smoke";
EXPLAIN SELECT id, k FROM t1 ORDER BY k ASC, id ASC;
SET SESSION debug=@old_debug;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_eligibility_contract_attempts') -
      @pq_orderby_elig_attempts_before AS orderby_elig_attempts_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_eligibility_contract_candidate_disabled') -
      @pq_orderby_elig_candidate_disabled_before AS orderby_elig_candidate_disabled_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_eligibility_contract_unsupported') -
      @pq_orderby_elig_unsupported_before AS orderby_elig_unsupported_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_execution_preflight_attempts') -
      @pq_orderby_preflight_attempts_before AS orderby_preflight_attempts_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_execution_preflight_blocked') -
      @pq_orderby_preflight_blocked_before AS orderby_preflight_blocked_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_execution_preflight_ready') -
      @pq_orderby_preflight_ready_before AS orderby_preflight_ready_delta;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_preflight_missing_filesort') -
      @pq_orderby_preflight_missing_filesort_before AS missing_filesort_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_preflight_missing_sort_param') -
      @pq_orderby_preflight_missing_sort_param_before AS missing_sort_param_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_preflight_missing_worker_frame') -
      @pq_orderby_preflight_missing_worker_frame_before AS missing_worker_frame_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_preflight_missing_exchange_heap') -
      @pq_orderby_preflight_missing_exchange_heap_before AS missing_exchange_heap_delta;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_preflight_missing_leader_materialize') -
      @pq_orderby_preflight_missing_leader_mat_before AS missing_leader_mat_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_preflight_missing_rowid') -
      @pq_orderby_preflight_missing_rowid_before AS missing_rowid_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_preflight_missing_ordered_read') -
      @pq_orderby_preflight_missing_ordered_read_before AS missing_ordered_read_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_orderby_preflight_missing_error_diag') -
      @pq_orderby_preflight_missing_error_diag_before AS missing_error_diag_delta;

# ORDER BY is still optimizer-rejected in M8. It must stay serial and must not
# create a PQ iterator until the real Exchange_sort worker path is wired.
EXPLAIN SELECT id, k FROM t1 ORDER BY k ASC, id ASC LIMIT 4;

SELECT id, k FROM t1 ORDER BY k ASC, id ASC LIMIT 4;
SELECT id, k FROM t1 ORDER BY k DESC, id ASC LIMIT 4;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_queries_executed') -
      @pq_executed_before_order AS orderby_executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_queries_fallback') -
      @pq_fallback_before_order AS orderby_fallback_delta;
SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_workers_launched') -
      @pq_workers_before_order AS orderby_workers_launched_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_ranges_dispatched') -
      @pq_ranges_before_order AS orderby_ranges_dispatched_delta;

SET SESSION parallel_query_experimental_threaded_dop=OFF;
SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;
