set force_parallel_execute=off;
--replace_regex $elide_pq_costs_and_time_and_row_estimate
eval explain analyze $query;
eval $query;

set force_parallel_execute=on;
--replace_regex $elide_pq_costs_and_time_and_row_estimate
eval explain analyze $query;
eval $query;

drop table t0;

create table t0 (c0 int);
create table t1 (c0 int, c1 int);
insert into t0 values (1);
analyze table t0;
analyze table t1;

let $query = select 1 from (select min(t1.c0), any_value(t1.c0) from t1 join t0 where t1.c1 = 1) t2(c0,c1) where t2.c1 is not null;
set force_parallel_execute=off;
--replace_regex $elide_pq_costs_and_time_and_row_estimate
eval explain analyze $query;
eval $query;

set force_parallel_execute=on;
--replace_regex $elide_pq_costs_and_time_and_row_estimate
eval explain analyze $query;
eval $query;

drop table t0, t1;

#having_cond is not pushed down to worker.
create table t1(c0 int);
let $query = select max(c0) as c1, c0 from t1 where (c0 = 1) having c1 is null;
set force_parallel_execute=off;
--replace_regex $elide_pq_costs_and_time_and_row_estimate
eval explain analyze $query;
eval $query;

set force_parallel_execute=on;
--replace_regex $elide_pq_costs_and_time_and_row_estimate
eval explain analyze $query;
eval $query;

#having_cond has been pushed down to worker.
let $query = select max(c0), c0 from t1 where c0 = 1 having c0 is NULL;
set force_parallel_execute=off;
--replace_regex $elide_pq_costs_and_time_and_row_estimate
eval explain analyze $query;
eval $query;

set force_parallel_execute=on;
--replace_regex $elide_pq_costs_and_time_and_row_estimate
eval explain analyze $query;
eval $query;

drop table t1;

#group_optimized_away is true
create table t0 (c0 int);
create table t1 (c1 int);
let $query = select 1 from (select 1 from t0 group by t0.c0) x(x) join t1 on t1.c1 = 1 group by t1.c1 having t1.c1 > 1;

set force_parallel_execute=on;
--replace_regex $elide_costs_and_rows
eval explain format=tree $query;
eval $query;

set force_parallel_execute=off;
--replace_regex $elide_costs_and_rows
eval explain format=tree $query;
eval $query;

drop table t0;
drop table t1;

set optimizer_switch = @saved_optimizer_switch;
set force_parallel_execute = @saved_force_parallel_execute;

