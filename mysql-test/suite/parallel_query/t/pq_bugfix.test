--echo # BUG2023040403493
--echo # PQ wrong result; Missing logic for functions when the table is empty
--echo # the leader is not aware of the constant it should return and defaults to NULL
--source include/pq_test.inc

CREATE TABLE t0 (c0 INT);
INSERT INTO t0 (c0) VALUES (1);
CREATE TABLE t1 (c0 INT);
explain format=tree SELECT 95 DIV count(*), power(2, (SELECT 1 FROM t0)) FROM t1;
SELECT 95 DIV count(*), power(2, (SELECT 1 FROM t0)) FROM t1;
drop table  t0,t1;

--echo #
--echo # BUG2023050801711 PQ derived table: Enable PQ, SELECT query, nested derived table, subquery in the innermost derived table, union in the outermost derived table, and then join another derived table, which causes the database to crash
--echo #

CREATE TABLE t1 (int_col INT);

# Simplified query (because tables are empty, hints are necessary to force a plan which exhibits the problem)
SET parallel_graceful_fallback = off;
EXPLAIN SELECT /*+ NO_MERGE() */ A.int_col
FROM (
       SELECT int_col
       FROM (SELECT 1) D JOIN t1
            ON int_col IN (
                            SELECT /*+ SEMIJOIN(MATERIALIZATION) */ int_col
                            FROM t1 AS t2
                          )
     ) A;

# Original query
EXPLAIN SELECT A.int_col
FROM (
       SELECT int_col
       FROM (
              SELECT int_col
              FROM t1
              WHERE int_col IN (
                                 SELECT /*+ SEMIJOIN(MATERIALIZATION) */ int_col
                                 FROM t1 AS t2
                               )
            ) C
       UNION
       SELECT int_col FROM t1 AS t3
     ) A
     INNER JOIN (SELECT int_col FROM t1 AS t4) B
     ON A.int_col = B.int_col;

SET parallel_graceful_fallback = on;
EXPLAIN SELECT /*+ NO_MERGE() */ A.int_col
FROM (
       SELECT int_col
       FROM (SELECT 1) D JOIN t1
            ON int_col IN (
                            SELECT /*+ SEMIJOIN(MATERIALIZATION) */ int_col
                            FROM t1 AS t2
                          )
     ) A;
 
EXPLAIN SELECT A.int_col
FROM (
       SELECT int_col
       FROM (
              SELECT int_col
              FROM t1
              WHERE int_col IN (
                                 SELECT /*+ SEMIJOIN(MATERIALIZATION) */ int_col
                                 FROM t1 AS t2
                               )
            ) C
       UNION
       SELECT int_col FROM t1 AS t3
     ) A
     INNER JOIN (SELECT int_col FROM t1 AS t4) B
     ON A.int_col = B.int_col;
 
SET parallel_graceful_fallback = default;
DROP TABLE t1;

