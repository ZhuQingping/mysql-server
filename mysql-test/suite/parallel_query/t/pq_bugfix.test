--echo # BUG2022081003200 
--echo # 3 tests cases

--echo # test 1
--echo # Bug itself - should not allow to cut the inner/build table because there is a LIMIT_OFFSET access_path.
--echo # firstmatch alone is not enough to create an issue, the query plan has to convert it to a LIMIT clause


--echo # test 2
--echo # Inner table can be cut (firstmatch but no limit clause)
--echo # It shows that inner table cutting restriction is not too coarse.

--echo # test 3 
--echo # FirstMatch is deactivated
--echo # Should not cut because there is a limit clause in the query plan.


--echo # test 1
CREATE TABLE ta(a int);
INSERT INTO ta VALUES (2),(2),(2),(2);
CREATE TABLE tb (b varchar(255),c varchar(255));
INSERT INTO tb VALUES (1,2),(2,3),(3,3);
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;
INSERT INTO tb SELECT * FROM tb;

SET parallel_default_dop=2; 
--echo # There should not be a parallel table scan of the inner table
ANALYZE TABLE ta, tb;

SELECT * FROM ta WHERE EXISTS (SELECT * FROM tb);
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=tree SELECT * FROM ta WHERE EXISTS (SELECT * FROM tb);

--echo # test 1 - modified

CREATE TABLE tc (d varchar(255), e varchar(255));
INSERT INTO tc VALUES (1,2),(2,3),(3,3);
ANALYZE TABLE tc;
--echo # Cutting tb returns the wrong answer - cutting tc does not, likely because there
--echo # are not enough rows in tc: Haven't managed to  get large tc with // scan,
--echo # but should it happen, it will be a problem. It is therefore not allowed.

--replace_regex $elide_costs_and_rows
EXPLAIN format=tree SELECT * FROM ta WHERE EXISTS (SELECT * FROM tc,tb);
SELECT * FROM ta WHERE EXISTS (SELECT * FROM tc,tb);

drop table ta,tb,tc;

--echo # test 2
--echo # First match is used but no LIMIT_OFFSET access path
--echo # Therefore not a problem.

CREATE TABLE t1 (
pk INT NOT NULL,
col_int_nokey INT,
col_int_key INT NOT NULL,
PRIMARY KEY (pk),
KEY col_int_key (col_int_key)
) ENGINE=InnoDB;

