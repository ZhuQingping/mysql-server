--source include/pq_test.inc

CREATE TABLE t0 (c0 INT PRIMARY KEY);
INSERT INTO t0(c0) VALUES (7);
explain format=tree SELECT h0, h1 FROM (SELECT rank() OVER (), t0.c0 FROM t0 GROUP BY t0.c0 WITH ROLLUP) h0 (h0, h1);
SELECT h0, h1 FROM (SELECT rank() OVER (), t0.c0 FROM t0 GROUP BY t0.c0 WITH ROLLUP) h0 (h0, h1);
