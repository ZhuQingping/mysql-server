  KEY `ndx_bigint_char_col` (`bigint_col`,`char_col`),
  KEY `ndx_bigint_varchar_col` (`bigint_col`,`varchar_col`(4)),
  KEY `ndx_decimal_float_col` (`decimal_col`,`float_col`),
  KEY `ndx_decimal_datetime_col` (`decimal_col`,`datetime_col`),
  KEY `ndx_decimal_timestamp_col` (`decimal_col`,`timestamp_col`),
  KEY `ndx_decimal_time_col` (`decimal_col`,`time_col`),
