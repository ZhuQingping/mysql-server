--echo # A few simple tests that reproduce the issue in BUG2022112303416
--echo # Before the patch, we return 02:59:59.000000 instead of NULL
--echo # or foo ( for the IFNULL test)

--echo # The memcpy we added make sure that the correct information 
--echo # about the nullity of a column is stored in the pq joins. 
create table t1 ( a  decimal(25,5) DEFAULT NULL, b time(6) DEFAULT NULL, index(b));
create table t2 ( a  decimal(25,5) DEFAULT NULL, b time(6) DEFAULT NULL, INDEX(b));

insert into  t1 values (1,'02:59:59.000000'),(3,'02:59:59.000001'),(5,'02:59:59.000001');
insert into  t2 values (1,'02:59:59.000000'),(3,'02:59:59.000001'),(5,'02:59:59.000001');

