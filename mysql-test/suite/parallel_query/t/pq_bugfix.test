--source include/pq_test.inc
--source include/elide_costs.inc
--source include/have_debug.inc

CALL mtr.add_suppression(".*deep copy method is not implemented, will not use parallel query.*");

# to preserve plans:
--source include/turn_off_join_elimination.inc

## BUG2023051504057

 CREATE TABLE `A` (
  `id_col` int NOT NULL DEFAULT '0'
);
CREATE TABLE `B` (
  `id_col` int NOT NULL DEFAULT '0'
);

Explain select CAST(B.id_col AS CHAR), IF(STRCMP(CAST(A.id_col AS UNSIGNED), CAST(B.id_col AS BINARY)), CAST(A.id_col AS UNSIGNED), CAST(B.id_col AS BINARY)) from A join B;
select CAST(B.id_col AS CHAR), IF(STRCMP(CAST(A.id_col AS UNSIGNED), CAST(B.id_col AS BINARY)), CAST(A.id_col AS UNSIGNED), CAST(B.id_col AS BINARY)) from A join B;

drop table A;
drop table B;

## BUG2023051802498

CREATE TABLE `t1` (
  `date_col` date DEFAULT NULL,
  `id_col` int NOT NULL DEFAULT '0'
);
create view v1 as select * from t1;
select date_col col1,id_col col2 from v1 group by 1,2 having 0=0 or v1.date_col > (select date_col from t1 order by 1 limit 1) order by 1,2;

drop view v1;
drop table t1;

## BUG2023042502987

CREATE TABLE t1 (c0 INT);
explain SELECT 1 WHERE (SELECT 1, 2 FROM t1) NOT IN (SELECT 1, 2 FROM (SELECT DISTINCT 1 FROM t1) x(x));
SELECT 1 WHERE (SELECT 1, 2 FROM t1) NOT IN (SELECT 1, 2 FROM (SELECT DISTINCT 1 FROM t1) x(x));

drop table t1;

## BUG2023060102952
set sql_mode="";

--disable_warnings

DROP TABLE IF EXISTS `t2`;
