CREATE TABLE t4 (
  a int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
INSERT INTO t4 VALUES (1);
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=tree SELECT /*+no_bnl() index_merge(b)*/ 1 FROM t5 b STRAIGHT_JOIN t4 c ON b.bool_col = 0 and b.int_col = 65;
SELECT /*+no_bnl() index_merge(b)*/ 1 FROM t5 b STRAIGHT_JOIN t4 c ON b.bool_col = 0 and b.int_col = 65;
DROP TABLE t5, t4;

--echo #
--echo # BUG2023110204101: Disable parallel query when we have a column pointing to a constant table.
--echo #
CREATE TABLE t (c0 INT);
INSERT INTO t VALUES(2),(1),(3);
# Parallel query disabled for this query
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=tree SELECT c0, c1 FROM (SELECT -t0.c0 c0, t2.c0 c1 FROM (SELECT 1 c0)t0 JOIN t t1 JOIN t t2) t0 ORDER BY c0, c1;
SELECT c0, c1 FROM (SELECT -t0.c0 c0, t2.c0 c1 FROM (SELECT 1 c0)t0 JOIN t t1 JOIN t t2) t0 ORDER BY c0, c1;
# Parallel query disabled for this query
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=tree SELECT -t0.c0 c0, t2.c0 c1 FROM (SELECT 1 c0)t0 JOIN t t1 JOIN t t2 ORDER BY c0, c1;
SELECT -t0.c0 c0, t2.c0 c1 FROM (SELECT 1 c0)t0 JOIN t t1 JOIN t t2 ORDER BY c0, c1;
# Parallel query enabled for this query
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=tree SELECT c0, c1 FROM (SELECT t0.c0 c0, t2.c0 c1 FROM (SELECT 1 c0)t0 JOIN t t1 JOIN t t2) t0 ORDER BY c0, c1;
SELECT c0, c1 FROM (SELECT t0.c0 c0, t2.c0 c1 FROM (SELECT 1 c0)t0 JOIN t t1 JOIN t t2) t0 ORDER BY c0, c1;
DROP TABLE t;

--echo #
--echo # BUG2023102503870: Partition assertion error
--echo #
CREATE TABLE t0 (c0 INT, c1 INT, c2 MEDIUMBLOB, PRIMARY KEY (c0, c2(100))) PARTITION BY HASH(t0.c0) PARTITIONS 1;
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=tree SELECT c0, c1 FROM t0 ORDER BY c0, c1;
SELECT c0, c1 FROM t0 ORDER BY c0, c1;
DROP TABLE t0;

--echo #
--echo # BUG2023120403228: CTE query SEGV
--echo #
WITH t1 (c0) AS (SELECT 1 FROM (SELECT 1) x(x) JOIN (SELECT 1) y(y) ON y.y = x.x WHERE 1 < x.x), t2 (c0) AS ((SELECT 1) UNION (SELECT 1)) SELECT (SELECT 1 FROM t1 JOIN t2 ON tx.c0) FROM t2 tx;

--echo #
--echo # BUG2023112403840: Parallel execution error 2
--echo #
SET @session_start_value = @@COLLATION_CONNECTION;
CREATE TABLE t0 (c0 INT);
SET SESSION COLLATION_CONNECTION = utf16_lithuanian_ci;
SELECT CASE 1 WHEN 1 THEN sec_to_time(t0.c0) END FROM t0;
DROP TABLE t0;
SET SESSION COLLATION_CONNECTION = @session_start_value;

--echo #
--echo # BUG2023080801794: Item field error
--echo #
CREATE TABLE t0 (c0 INT);
INSERT INTO t0 (c0) VALUES (1),(2),(3),(4),(5),(6),(7),(8);
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=tree SELECT SQL_BUFFER_RESULT count(*) FROM (SELECT rank() OVER () FROM t0) x(x);
SELECT SQL_BUFFER_RESULT count(*) FROM (SELECT rank() OVER () FROM t0) x(x);
DROP TABLE t0;

--echo #
--echo # BUG2024020504292: Bit value collation assertion
--echo #
CREATE TABLE t0 (c0 INT);
SELECT _ucs2 b'1' COLLATE ucs2_roman_ci FROM t0;
DROP TABLE t0;

--echo #
--echo # BUG2023091504326: Wrong cast result
--echo #
CREATE TABLE t0 (c0 TINYINT);
INSERT INTO t0(c0) VALUES (-30);
SELECT c0, c1 FROM (SELECT t0.c0, CAST(CONVERT(t0.c0 USING koi8u) AS UNSIGNED) FROM t0) t0 (c0, c1) ORDER BY c0, c1;
DROP TABLE t0;

--echo #
--echo # BUG2024022603083: PQ on-disk hash join causes a incorrect result
--echo #
CREATE TABLE t0 (
