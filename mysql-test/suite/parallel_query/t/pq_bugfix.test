--echo # BUG2023051203134 PQ HAVING AVG(col) is NULL ("HAVING AVG(col) is NULL" returns wrong result in some specific cases after PQ turns on)

CREATE TABLE t (
  smallint_col  SMALLINT,
  enum_col ENUM('aaa','bbb','ccc')
  );

INSERT INTO t VALUES (32767,'ccc'),(32767,'ccc'),(32767,'ccc'),(NULL,NULL),(NULL,NULL),(NULL,NULL),(NULL,NULL),(NULL,NULL),(32767,'ccc'),(32767,'ccc'),(32767,'ccc'),(32767,'ccc'),(32767,'ccc'),(1,NULL),(1,NULL),(1,NULL),(1,NULL),(1,NULL),(1,NULL),(1,NULL),(1,NULL),(1,NULL),(1,NULL),(NULL,NULL),(NULL,NULL),(NULL,NULL),(NULL,NULL),(NULL,NULL);

ANALYZE TABLE t;

let $query=
SELECT smallint_col,enum_col FROM t GROUP BY 1,2 HAVING AVG(enum_col) IS NULL ORDER BY 1,2;

--echo # Compare results of PQ and non-PQ
--echo # In PQ, HAVING was wrongly pushed to the worker
eval EXPLAIN FORMAT=TREE $query;
eval $query;

set force_parallel_execute=off;
eval EXPLAIN FORMAT=TREE $query;
eval $query;
set force_parallel_execute=default;

DROP TABLE t;

--echo #
--echo # BUG2023062703392
--echo #
--echo # Disable parallel query when we have a column (x.x in this case) 
--echo # pointing to a constant table. Since we always  set TABLE::const_table
--echo # to false for workers, the leader and the workers may end up with
--echo # different number of columns in their temporary tables.
CREATE TABLE t0 (c0 INT); 

let $query = SELECT DISTINCT CAST(x.x AS UNSIGNED) w
             FROM t0 JOIN (SELECT count(*)) x(x) ORDER BY w;

eval EXPLAIN FORMAT=tree $query;
eval $query;
DROP TABLE t0;

--echo # BUG2023080801777
--echo # For PQ, it copy the saved condition which is before optimize phase.
--echo # Optimizer will inject cast nodes into condition. So PQ will have
--echo # different condition with the origin plan, which causes PQ have
--echo # wrong result.
--echo # Fix: inject cast nodes after copy the condition.
CREATE TABLE t0 (c0 INT, c1 DATETIME(4), c2 INT);
CREATE TABLE t1 (c0 INT);
INSERT INTO t0 VALUES (1,'9300-07-02 12:27:20',1);
INSERT INTO t1 VALUES (2);

EXPLAIN FORMAT=TREE SELECT 1 FROM t1 JOIN t0 ON CASE WHEN (SELECT t0.c0 FROM t0 JOIN (SELECT 1) x(c1) USING (c1) GROUP BY t0.c0) THEN t0.c1 WHEN t1.c0 THEN t0.c2 END <> t0.c1;
SELECT 1 FROM t1 JOIN t0 ON CASE WHEN (SELECT t0.c0 FROM t0 JOIN (SELECT 1) x(c1) USING (c1) GROUP BY t0.c0) THEN t0.c1 WHEN t1.c0 THEN t0.c2 END <> t0.c1;

DROP TABLE t0, t1;

--echo # BUG2023080801803
SET SESSION PARALLEL_ROWS_THRESHOLD = 0;

CREATE TABLE t0 (c0 INT, INDEX i0 (c0));
INSERT INTO t0 VALUES(1),(2),(3);

SELECT DISTINCT c0 FROM t0 ORDER BY log(c0);
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT DISTINCT c0 FROM t0 ORDER BY log(c0);
SELECT c0 FROM t0 ORDER BY log(c0);
SELECT DISTINCT c0 FROM t0 ORDER BY c0;

DROP TABLE t0;

--echo # BUG2023110202800
set @saved_optimizer_switch = @@optimizer_switch;
set @saved_force_parallel_execute = @@force_parallel_execute;

set optimizer_switch='derived_condition_pushdown=on';

create table t0 (c0 int);
insert into t0 values (1);
analyze table t0;
let $query = select * from (select max(c0),c0 from t0 where t0.c0 = 1) t2(c0,c1) where t2.c1 = 2;
set force_parallel_execute=off;
--replace_regex $elide_pq_costs_and_time_and_row_estimate
eval explain analyze $query;
eval $query;

set force_parallel_execute=on;
--replace_regex $elide_pq_costs_and_time_and_row_estimate
eval explain analyze $query;
eval $query;

#having_cond has been pushed down to worker.
