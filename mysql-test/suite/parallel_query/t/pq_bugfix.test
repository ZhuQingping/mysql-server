--enable_warnings

ANALYZE TABLE t2, t3;
explain SELECT /*+ BKA() PQ() */ count(B.datetime_col) AS datetime_col, count(B.bigint_col) FROM t3 A  RIGHT JOIN t2 B ON (A.datetime_col = B.datetime_col) AND (A.bigint_col = B.bigint_col);
SELECT /*+ BKA() PQ() */ count(B.datetime_col) AS datetime_col, count(B.bigint_col) FROM t3 A  RIGHT JOIN t2 B ON (A.datetime_col = B.datetime_col) AND (A.bigint_col = B.bigint_col);

drop table t2;
drop table t3;

## BUG2023060800235 

CREATE TABLE `t3` (
  `id_col` int NOT NULL DEFAULT '0',
  `year_col` year DEFAULT NULL,
  KEY `ndx_year_col` (`year_col` DESC)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

INSERT INTO `t3` VALUES (88,NULL),(1,1901),(89,1902),(11,1903),(89,1904),(21,1905),(89,1906),(31,1907),(89,1908),(41,1909),(89,1910),(51,1911),(89,1912),(61,1913),(89,2020),(66,2155);

analyze table t3;
explain SELECT year_col,avg(id_col) FROM t3 GROUP BY 1 order by 1,2;
SELECT year_col,avg(id_col) FROM t3 GROUP BY 1 order by 1,2;

drop table t3;

## BUG2023060504524
CREATE TABLE t0 (c0 INT);
INSERT INTO t0(c0) VALUES (1);

explain SELECT c0 FROM (SELECT t0.c0 FROM t0 tx JOIN t0 GROUP BY t0.c0 WITH ROLLUP) t0(c0) ORDER BY c0;
SELECT c0 FROM (SELECT t0.c0 FROM t0 tx JOIN t0 GROUP BY t0.c0 WITH ROLLUP) t0(c0) ORDER BY c0;

drop table t0;
SET sql_mode = DEFAULT;

--echo #
--echo # BUG2023080801753: Plan clone assertion error
--echo #
CREATE TABLE t0 (c0 INT);
EXPLAIN SELECT 1 FROM t0 LEFT JOIN (SELECT 1) x(x) ON compress(t0.c0) = current_timestamp() WHERE NOT t0.c0;
SELECT 1 FROM t0 LEFT JOIN (SELECT 1) x(x) ON compress(t0.c0) = current_timestamp() WHERE NOT t0.c0;
DROP TABLE t0;

--echo #
--echo # BUG2023080801772: Keyparts error
--echo #
CREATE TABLE t0 (c0 INT);
CREATE TABLE t1 (c0 TEXT, PRIMARY KEY (c0(100)));
EXPLAIN SELECT 1 FROM t0 JOIN (SELECT 1) x(x) LEFT JOIN t1 ON t1.c0 = concat_ws(1, x.x);
SELECT 1 FROM t0 JOIN (SELECT 1) x(x) LEFT JOIN t1 ON t1.c0 = concat_ws(1, x.x);
DROP TABLE t0, t1;

--echo #
--echo # BUG2023082804292: Index merge intesect causes an inconsistent result error
--echo #
CREATE TABLE t5 (
  bool_col tinyint(1) DEFAULT NULL,
  int_col int DEFAULT NULL,
  id int NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (id),
  KEY ndx_int_col (int_col),
  KEY ndx_bool_col (bool_col)
);
