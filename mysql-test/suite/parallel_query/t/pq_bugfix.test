--echo #
--echo # BUG2024040701906: PQ lead to memory leak in function row_search_mvcc and row_search_no_mvcc
--echo #
CREATE TABLE bmsql_order_line (
  ol_w_id int NOT NULL,
  ol_d_id int NOT NULL,
  ol_o_id int NOT NULL,
  ol_number int NOT NULL,
  ol_i_id int NOT NULL,
  ol_delivery_d timestamp NULL DEFAULT NULL,
  ol_amount decimal(6,2) DEFAULT NULL,
  ol_supply_w_id int DEFAULT NULL,
  ol_quantity int DEFAULT NULL,
  ol_dist_info char(32) DEFAULT NULL,
  PRIMARY KEY (ol_w_id,ol_d_id,ol_o_id,ol_number)
);

DELIMITER ||;
CREATE PROCEDURE insert_data(in n int, in ol_w_id int, in ol_d_id int)
BEGIN
DECLARE i int DEFAULT 1;
WHILE (i <= n) do
INSERT INTO bmsql_order_line VALUES(ol_w_id,ol_d_id,i,i,round(rand()*100),now(),0,round(rand()*100),1,md5(rand()));
SET i=i+1;
END WHILE;
END ||
DELIMITER ;||

CALL insert_data(100,1,1);
CALL insert_data(100,1,2);
CALL insert_data(100,1,3);

--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=TREE SELECT sum(ol_amount) AS sum_ol_amount FROM bmsql_order_line WHERE ol_w_id = 1 AND ol_d_id=2;
SELECT sum(ol_amount) AS sum_ol_amount FROM bmsql_order_line WHERE ol_w_id = 1 AND ol_d_id=2;

# InnoDB intrinsic
SET @optimizer_switch_saved = @@optimizer_switch;
SET @@optimizer_switch="derived_merge=off,derived_condition_pushdown=off";
SET big_tables = 1;
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=TREE SELECT sum(prod) FROM (SELECT t1.ol_d_id + t2.ol_d_id AS prod FROM bmsql_order_line t1, bmsql_order_line t2 WHERE t1.ol_d_id=t2.ol_d_id) t WHERE prod=3;
SELECT sum(prod) FROM (SELECT t1.ol_d_id + t2.ol_d_id AS prod FROM bmsql_order_line t1, bmsql_order_line t2 WHERE t1.ol_d_id=t2.ol_d_id) t WHERE prod=3;

SET @@optimizer_switch = @optimizer_switch_saved;
SET big_tables = DEFAULT;
DROP PROCEDURE insert_data;
DROP TABLE bmsql_order_line;

--echo #
--echo # BUG2024050703299: PQ should not work when table fetched rows <= parallel_rows_threshold
--echo #
CREATE TABLE t1 (a int DEFAULT NULL, b int DEFAULT NULL);
CREATE TABLE t2 (a int DEFAULT NULL, b int DEFAULT NULL);
insert into t1 values(1,2);
insert into t1 values(2,3);
insert into t1 values(3,4);
insert into t2 select * from t1;
insert into t2 select * from t1;
insert into t2 select * from t1;
insert into t2 select * from t1;
insert into t2 select * from t1;
analyze table t1,t2;
set @saved_threshold = @@parallel_rows_threshold;

## hash join scenario
## choose t2 as divide table, no cut table.
set session parallel_rows_threshold = 6;
--replace_regex $elide_costs_and_rows
explain format=tree select count(*) from t1 join t2 on t1.a=t2.a;
select count(*) from t1 join t2 on t1.a=t2.a;

## do not choose parallel query.
set session parallel_rows_threshold = 15;
--replace_regex $elide_costs_and_rows
explain format=tree select count(*) from t1 join t2 on t1.a=t2.a;
select count(*) from t1 join t2 on t1.a=t2.a;

## nested loop join scenario
alter table t1 add index idx_a(a);
alter table t2 add index idx_a(a);
## choose t2 as divide table.
set session parallel_rows_threshold = 3;
explain select count(*) from t1 join t2 on t1.a=t2.a;
select count(*) from t1 join t2 on t1.a=t2.a;

## do not choose parallel query.
set session parallel_rows_threshold = 10;
explain select count(*) from t1 join t2 on t1.a=t2.a;
select count(*) from t1 join t2 on t1.a=t2.a;

## cleanup
drop table t1,t2;
set session parallel_rows_threshold = @saved_threshold;

