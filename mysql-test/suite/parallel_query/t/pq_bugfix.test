--echo #
set @saved_parallel_rows_threshold = @@parallel_rows_threshold;
# table scan
CREATE TABLE `account_change_log` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT COMMENT 'ID',
  `shop_id` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '店铺ID',
  `user_id` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '用户ID',
  `amount` decimal(20,4) DEFAULT NULL COMMENT '金额',
  `order_no` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '订单号',
  `is_delete` int NOT NULL DEFAULT '0' COMMENT '是否删除 0:否 1:是',
  `recharge_status` int DEFAULT NULL COMMENT '充值状态 1.待处理 2.成功 3.失败',
  `is_pa` int DEFAULT NULL COMMENT '是否处理过 1 是',
  `channel` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci DEFAULT NULL COMMENT '渠道 system:系统生成 C:客户生成',
  PRIMARY KEY (`id`),
  KEY `idx_channel_userId` (`channel`,`user_id`) USING BTREE,
  KEY `idx_is_pa_is_delete_recharge_status_channel` (`is_pa`,`is_delete`,`recharge_status`,`channel`)
) ENGINE=InnoDB AUTO_INCREMENT=11 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='账户变动日志';

INSERT INTO `account_change_log` (
  `shop_id`, `user_id`, `amount`, `order_no`, `is_delete`, `recharge_status`, `is_pa`, `channel`
) VALUES
  ('shop_1', 'user_1', 100.00, 'order_1', 0, 2, 1, 'mshop'),
  ('shop_1', 'user_2', 200.00, 'order_2', 0, 3, 1, 'mshop'),
  ('shop_2', 'user_3', 300.00, 'order_3', 0, 2, 1, 'mshop'),
  ('shop_2', 'user_4', 400.00, 'order_4', 0, 3, 1, 'mshop'),
  ('shop_3', 'user_5', 500.00, 'order_5', 0, 2, 1, 'mshop'),
  ('shop_4', 'user_6', 600.00, 'order_6', 1, 1, 0, 'other_channel'),
  ('shop_5', 'user_7', 700.00, 'order_7', 1, 2, 0, 'other_channel'),
  ('shop_6', 'user_8', 800.00, 'order_8', 1, 3, 0, 'other_channel'),
  ('shop_7', 'user_9', 900.00, 'order_9', 1, 1, 0, 'other_channel'),
  ('shop_8', 'user_10', 1000.00, 'order_10', 1, 2, 0, 'other_channel');

ANALYZE TABLE account_change_log;

SET parallel_rows_threshold=10;
EXPLAIN FORMAT = tree SELECT shop_id, user_id AS user_id, SUM(amount) AS settled_revenue
	, COUNT(order_no) AS order_count
FROM account_change_log FORCE INDEX (PRIMARY)
WHERE is_delete = 0
	AND recharge_status IN (2, 3)
	AND is_pa = 1
	AND channel = 'mshop'
GROUP BY shop_id, user_id;
SELECT shop_id, user_id AS user_id, SUM(amount) AS settled_revenue
	, COUNT(order_no) AS order_count
FROM account_change_log FORCE INDEX (PRIMARY)
WHERE is_delete = 0
	AND recharge_status IN (2, 3)
	AND is_pa = 1
	AND channel = 'mshop'
GROUP BY shop_id, user_id;

SET parallel_rows_threshold=9;
EXPLAIN FORMAT = tree SELECT shop_id, user_id AS user_id, SUM(amount) AS settled_revenue
	, COUNT(order_no) AS order_count
FROM account_change_log FORCE INDEX (PRIMARY)
WHERE is_delete = 0
	AND recharge_status IN (2, 3)
	AND is_pa = 1
	AND channel = 'mshop'
GROUP BY shop_id, user_id;
SELECT shop_id, user_id AS user_id, SUM(amount) AS settled_revenue
	, COUNT(order_no) AS order_count
FROM account_change_log FORCE INDEX (PRIMARY)
WHERE is_delete = 0
	AND recharge_status IN (2, 3)
	AND is_pa = 1
	AND channel = 'mshop'
GROUP BY shop_id, user_id;

SET parallel_rows_threshold=0;
DROP TABLE account_change_log;

