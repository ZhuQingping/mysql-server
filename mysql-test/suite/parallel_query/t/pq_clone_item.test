--source include/pq_test.inc
--source include/have_debug.inc

--echo # BUG2022040102546: the pq_clone method of Item_func_coalesce is error
--echo # when its arguments contain aggregation. This is due to the argument
--echo # Item_aggregate_ref is firstly cloned and then reassigned.

create table t1(a int, b int);
insert into t1 values (1, 2), (2, 1), (2, 2), (3, 1), (0, 0);
ANALYZE TABLE t1;

EXPLAIN SELECT COALESCE( SUM(a * b), 0) from t1;
SELECT COALESCE( SUM(a * b), 0) from t1;

--echo # BUG2023021403474: PQ supports icu_version() function
SET @saved_optimize_trace=@@optimizer_switch;
SET SESSION OPTIMIZER_SWITCH = 'subquery_to_derived=on';
EXPLAIN SELECT icu_version(), 1 FROM (VALUES ROW(1)) t0;
SELECT icu_version(), 1 FROM (VALUES ROW(1)) t0;
SET SESSION OPTIMIZER_SWITCH = @saved_optimize_trace;

--echo # BUG2023021503243: PQ disable and support some functions

--echo # PQ not supports row_count()
EXPLAIN SELECT a, row_count() from t1;
--replace_column 2 #
SELECT a, row_count() from t1;

--echo # PQ not supports USER()
explain select USER() from t1;
select USER() from t1;

--echo # PQ not supports CURRENT_USER()
explain select CURRENT_USER() from t1;
select CURRENT_USER() from t1;

--echo # PQ not supports SESSION_USER()
explain select SESSION_USER() from t1;
select SESSION_USER() from t1;

--echo # PQ not supports SYSTEM_USER()
explain select SYSTEM_USER() from t1;
select SYSTEM_USER() from t1;

--echo # BUG2022092200579: PQ supports or not supports some functions
--echo # PQ supports utc_timestamp
EXPLAIN SELECT a, utc_timestamp() from t1;
--replace_column 2 #
SELECT a, utc_timestamp() from t1;

--echo # PQ supports sysdate when --sysdate-is-now is off
EXPLAIN SELECT a, sysdate() from t1;
--replace_column 2 #
SELECT a, sysdate() from t1;

--echo # PQ supports uuid_short
EXPLAIN SELECT a, uuid_short() from t1;
--replace_column 2 #
SELECT a, uuid_short() from t1;

--echo # PQ not supports ps_thread_id()
EXPLAIN SELECT a, ps_thread_id(connection_id()) from t1;
--replace_column 2 #
SELECT a, ps_thread_id(connection_id()) from t1;

--echo # PQ not supports ps_current_thread_id()
EXPLAIN SELECT a, ps_current_thread_id() from t1;
--replace_column 2 #
SELECT a, ps_current_thread_id() from t1;
--echo # PQ not supports row_count
EXPLAIN SELECT a, row_count() from t1;
--replace_column 2 #
SELECT a, row_count() from t1;

drop table t1;

--echo #
--echo # BUG2023021402624: PQ not supports current_role()
--echo #
CREATE TABLE t1 (c0 INT);
CREATE TABLE t2 LIKE t1;
EXPLAIN SELECT 1 FROM t2 NATURAL JOIN t1 WHERE interval(5, 2, current_role()) = 4;
SELECT 1 FROM t2 NATURAL JOIN t1 WHERE interval(5, 2, current_role()) = 4;

EXPLAIN SELECT 1 FROM t2 NATURAL JOIN t1 WHERE interval(5, 2, 6) = 1;
SELECT 1 FROM t2 NATURAL JOIN t1 WHERE interval(5, 2, 6) = 1;

EXPLAIN select current_role() from t1;
select current_role() from t1;

EXPLAIN SELECT interval(5, 2, current_role()) FROM t2 NATURAL JOIN t1 WHERE true;
SELECT interval(5, 2, current_role()) FROM t2 NATURAL JOIN t1 WHERE true;

drop table t1;
drop table t2;

--echo # PTI_literal_underscore_charset_bin_num
CREATE TABLE t1 (id INT PRIMARY KEY, username VARCHAR(50), password_hash BINARY(32));
INSERT INTO t1 (id, username, password_hash) VALUES
(1, 'alice', _binary 0xE3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855),
(2, 'bob', UNHEX(SHA2('bobspassword', 256))),
(3, 'charlie', UNHEX(SHA2('password123', 256)));
--replace_column 10 # 11 #
EXPLAIN SELECT _binary 'abc', id, username, HEX(password_hash) AS password_hash_hex, LENGTH(password_hash) AS hash_length FROM t1;
DROP TABLE t1;

--echo # Item_static_string_func
CREATE TABLE t1 (id INT, val VARCHAR(100));
INSERT INTO t1 VALUES (1, 'test'), (2, 'other');
--replace_column 10 # 11 #
EXPLAIN SELECT id, VERSION() AS mysql_version FROM t1;
--replace_column 2 #
SELECT id, VERSION() AS mysql_version FROM t1;
DROP TABLE t1;

--echo # Item_func_is_ipv6
CREATE TABLE network_devices (
    device_id INT PRIMARY KEY AUTO_INCREMENT,
    device_name VARCHAR(100),
    ip_address VARCHAR(45),
    device_type VARCHAR(50),
    last_seen DATETIME
);
INSERT INTO network_devices (device_name, ip_address, device_type) VALUES
('Router-1', '2001:db8::1', 'router'),
('Server-1', 'fe80::250:56ff:fe96:5d3f', 'server'),
('Switch-1', '192.168.1.1', 'switch'),           -- IPv4
('Firewall-1', '2001:db8:85a3::8a2e:370:7334', 'firewall'),
('Invalid-Device', 'not.an.ip.address', 'unknown');
--replace_column 10 # 11 #
EXPLAIN SELECT
    device_id,
    device_name,
    ip_address,
    device_type,
    CASE
        WHEN IS_IPV6(ip_address) = 1 THEN 'IPv6'
        ELSE 'IPv4 or Invalid'
    END AS ip_version
FROM network_devices
WHERE IS_IPV6(ip_address) = 1;
DROP TABLE network_devices;

--echo # Item_func_is_ipv4
CREATE TABLE network_configurations (
    config_id INT PRIMARY KEY AUTO_INCREMENT,
    device_name VARCHAR(100),
    ip_address VARCHAR(15),
    subnet_mask VARCHAR(15),
    gateway VARCHAR(15),
    dns_server VARCHAR(15),
    config_status ENUM('VALID', 'INVALID', 'PENDING')
);
INSERT INTO network_configurations (device_name, ip_address, subnet_mask, gateway, dns_server) VALUES
('Router-01', '192.168.1.1', '255.255.255.0', '192.168.1.254', '8.8.8.8'),
('Server-01', '10.0.0.100', '255.255.0.0', '10.0.0.1', '10.0.0.53'),
('Switch-01', '172.16.0.1', '255.255.255.240', '172.16.0.14', '1.1.1.1'),
('Invalid-01', '300.400.500.600', '255.255.255.0', '192.168.1.1', '8.8.8.8'),
('Partial-01', '192.168.1', '255.255.255.0', '192.168.1.1', '8.168.1.1');
--replace_column 10 # 11 #
EXPLAIN SELECT
    config_id,
    device_name,
    ip_address,
    subnet_mask,
    gateway,
    dns_server,
    CASE
        WHEN IS_IPV4(ip_address) = 1
         AND IS_IPV4(subnet_mask) = 1
         AND IS_IPV4(gateway) = 1
         AND IS_IPV4(dns_server) = 1
        THEN 'VALID'
        ELSE 'INVALID'
    END AS validation_result,
    CONCAT_WS(', ',
        CASE WHEN IS_IPV4(ip_address) = 0 THEN 'IP地址无效' END,
        CASE WHEN IS_IPV4(subnet_mask) = 0 THEN '子网掩码无效' END,
        CASE WHEN IS_IPV4(gateway) = 0 THEN '网关无效' END,
        CASE WHEN IS_IPV4(dns_server) = 0 THEN 'DNS服务器无效' END
    ) AS error_details
FROM network_configurations;
DROP TABLE network_configurations;

--echo # Item_func_gtid_subset
CREATE TABLE gtid_sets (
    id INT PRIMARY KEY AUTO_INCREMENT,
    set_name VARCHAR(50) NOT NULL,
    gtid_string VARCHAR(500) NOT NULL,
    server_uuid CHAR(36),
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_created_at (created_at)
);
INSERT INTO gtid_sets (set_name, gtid_string, server_uuid) VALUES
('full_set_1', '3E11FA47-71CA-11E1-9E33-C80AA9429562:1-100', UUID()),
('full_set_2', '3E11FA47-71CA-11E1-9E33-C80AA9429562:1-100:200-300', UUID()),
('partial_set_1', '3E11FA47-71CA-11E1-9E33-C80AA9429562:1-50', UUID()),
('partial_set_2', '3E11FA47-71CA-11E1-9E33-C80AA9429562:51-100', UUID()),
('partial_set_3', '3E11FA47-71CA-11E1-9E33-C80AA9429562:10-20:30-40', UUID()),
('empty_set', '', UUID()),
('multi_uuid_set', '3E11FA47-71CA-11E1-9E33-C80AA9429562:1-50,4E11FA47-71CA-11E1-9E33-C80AA9429562:1-30', UUID()),
('gap_set', '3E11FA47-71CA-11E1-9E33-C80AA9429562:1-10:20-30:40-50', UUID());

--replace_column 10 # 11 #
EXPLAIN SELECT GTID_SUBSET('', gtid_string) AS is_subset FROM gtid_sets WHERE set_name = 'full_set_1';

--replace_column 10 # 11 #
EXPLAIN SELECT GTID_SUBTRACT(gtid_string, '') AS missing_in_source FROM gtid_sets WHERE set_name = 'full_set_1';

DROP TABLE gtid_sets;

--echo # Item_func_sign
CREATE TABLE stock_prices (
    symbol VARCHAR(10),
    trade_date DATE,
    open_price DECIMAL(10,2),
    close_price DECIMAL(10,2),
    volume BIGINT
);
INSERT INTO stock_prices VALUES
('AAPL', '2024-01-01', 150.00, 152.50, 1000000),
('AAPL', '2024-01-02', 152.50, 151.75, 950000),
('AAPL', '2024-01-03', 151.75, 153.25, 1100000),
('GOOGL', '2024-01-01', 2800.00, 2795.50, 500000),
('GOOGL', '2024-01-02', 2795.50, 2810.25, 550000),
('GOOGL', '2024-01-03', 2810.25, 2805.00, 520000);
--replace_column 10 # 11 #
EXPLAIN SELECT
    symbol,
    trade_date,
    open_price,
    close_price,
    close_price - open_price AS price_change,
    SIGN(close_price - open_price) AS change_direction,
    volume
FROM stock_prices ORDER BY symbol, trade_date;
DROP TABLE stock_prices;

--echo # Item_func_degrees
CREATE TABLE geographic_points (
    point_id INT PRIMARY KEY AUTO_INCREMENT,
    point_name VARCHAR(100),
    latitude DECIMAL(10,8),
    longitude DECIMAL(11,8),
    altitude DECIMAL(8,2)
);
INSERT INTO geographic_points (point_name, latitude, longitude, altitude) VALUES
('北京天安门', 39.9075000, 116.3972300, 44.0),
('上海东方明珠', 31.2396900, 121.4997200, 468.0),
('广州塔', 23.1063900, 113.3244400, 600.0),
('纽约自由女神', 40.6892470, -74.0445020, 93.0),
('巴黎埃菲尔铁塔', 48.8583700, 2.2944810, 324.0);
--replace_column 10 # 11 #
EXPLAIN SELECT
    p1.point_name AS from_point,
    p2.point_name AS to_point,
    DEGREES(ACOS(
        SIN(RADIANS(p1.latitude)) * SIN(RADIANS(p2.latitude)) +
        COS(RADIANS(p1.latitude)) * COS(RADIANS(p2.latitude)) *
        COS(RADIANS(p2.longitude - p1.longitude))
    )) * 111.319 AS distance_km_approx
FROM geographic_points p1
CROSS JOIN geographic_points p2
WHERE p1.point_name = '北京天安门'
  AND p2.point_name = '上海东方明珠';
DROP TABLE geographic_points;

--echo # PTI_in_sum_expr
CREATE TABLE inventory (
    product_id INT,
    warehouse_id INT,
    quantity INT,
    last_restock DATE
);
--replace_column 10 # 11 #
explain SELECT product_id, warehouse_id, quantity
FROM inventory
WHERE (warehouse_id, quantity) IN (
    SELECT warehouse_id, AVG(quantity)
    FROM inventory
    GROUP BY warehouse_id
    HAVING AVG(quantity) > 50
);
DROP TABLE inventory;

--echo # Item_func_last_day & Item_typecast_year
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    date_string VARCHAR(10),
    event_date DATE,
    value DECIMAL(10,2)
);
INSERT INTO t1 VALUES
(1, '2024-01-15', '2024-01-15', 100.50),
(2, '2023-12-01', '2024-01-31', 200.75),
(3, 'invalid', '2024-02-28', 150.25),
(4, '2025-06-30', '2024-03-31', 300.00);
--replace_column 10 # 11 #
EXPLAIN SELECT
    id,
    date_string,
    CASE
        WHEN CAST(date_string AS YEAR) IS NOT NULL
        THEN CAST(date_string AS YEAR)
        ELSE NULL
    END AS extracted_year,
    event_date,
    LAST_DAY(event_date) AS month_end,
    value,
    CASE
        WHEN event_date = LAST_DAY(event_date)
        THEN 'YES'
        ELSE 'NO'
    END AS is_month_end
FROM t1 ORDER BY id;
DROP TABLE t1;

--echo # Item_func_regexp_substr
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    raw_text VARCHAR(255)
);
INSERT INTO t1 VALUES
(1, 'Order #12345: Amount $199.99'),
(2, 'User: john_doe123, Email: john@example.com'),
(3, 'Phone: (555) 123-4567, Fax: 555-987-6543'),
(4, 'IP Address: 192.168.1.1, Port: 8080'),
(5, 'No special patterns here'),
(6, 'Multiple emails: alice@test.com and bob@work.org');
--replace_column 10 # 11 #
EXPLAIN SELECT
    id,
    raw_text,
    REGEXP_SUBSTR(raw_text, '#\\d+') AS order_number_raw,
    REGEXP_SUBSTR(raw_text, '\\d+', 1, 1) AS first_number,
    REGEXP_SUBSTR(raw_text, '\\d+', 1, 2) AS second_number
FROM t1 WHERE REGEXP_SUBSTR(raw_text, '#\\d+') IS NOT NULL;
DROP TABLE t1;

--echo # PTI_text_literal_underscore_charset&PTI_text_literal_nchar_string
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    ascii_text VARCHAR(100),
    unicode_text VARCHAR(100) CHARACTER SET utf8mb4,
    binary_text VARBINARY(100)
);
INSERT INTO t1 VALUES
(1, 'Regular ASCII text', N'Unicode: 测试中文', _binary '48656C6C6F'),
(2, 'Hello World', _utf8 'UTF8 encoded', _binary '42696E617279'),
(3, 'Test', _latin1 'Latin1 Text', _binary '44617461');
--replace_column 10 # 11 #
EXPLAIN SELECT
    id,
    ascii_text,
    CHARSET(ascii_text) AS ascii_charset,
    unicode_text,
    CHARSET(unicode_text) AS unicode_charset,
    binary_text,
    HEX(binary_text) AS binary_hex,
    _binary 'TEST' AS underscore_binary,
    _utf8 'TEST' AS underscore_utf8,
    _latin1 'TEST' AS underscore_latin1,
    N'测试' AS nchar_chinese
FROM t1;
DROP TABLE t1;

--echo # PTI_variable_aux_set_var & Item_func_get_user_var
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    department VARCHAR(50),
    salary DECIMAL(10,2)
);
INSERT INTO t1 VALUES
(1, 'Alice', 'IT', 60000),
(2, 'Bob', 'HR', 55000),
(3, 'Charlie', 'IT', 65000),
(4, 'David', 'Sales', 70000),
(5, 'Eve', 'IT', 62000);

SET @min_salary = 60000;
--replace_column 10 # 11 #
EXPLAIN SELECT
    id,
    name,
    department,
    salary
FROM t1 WHERE salary >= @min_salary;
