--echo # Item_func_is_uuid
CREATE TABLE uuid_test (
    id INT PRIMARY KEY AUTO_INCREMENT,
    uuid_col VARCHAR(64),
    description VARCHAR(100)
);
INSERT INTO uuid_test (uuid_col, description) VALUES
('6ccd780c-baba-1026-9564-5b8c656024db', 'valid uuid1'),
('12345678-1234-1234-1234-123456789abc', 'valid uuid2'),
('invalid-uuid', 'invalid uuid wrong format'),
('6ccd780c-baba-1026-9564', 'invalid uuid too short'),
('6ccd780c-baba-1026-9564-5b8c656024db-extra', 'invalid uuid too long'),
(NULL, 'empty value'),
('6CCD780C-BABA-1026-9564-5B8C656024DB', 'valid uuid'),
('6ccd780c-baba-1026-9564-5b8c656024dx', 'invalid uuid incorrect char');

let query = SELECT
    id,
    uuid_col,
    description,
    IS_UUID(uuid_col) AS is_valid_uuid,
    CASE
        WHEN IS_UUID(uuid_col) = 1 THEN 'valid uuid'
        WHEN IS_UUID(uuid_col) = 0 THEN 'invalid uuid'
        ELSE 'empty value'
    END AS uuid_status FROM uuid_test;
--replace_column 10 # 11 #
eval explain $query;
eval $query;
DROP TABLE uuid_test;

--echo Item_func_validate_password_strength
CREATE TABLE user_passwords (
    id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50),
    password VARCHAR(100),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
INSERT INTO user_passwords (username, password) VALUES
('user1', '123456'),
('user2', 'Abc123'),
('user3', 'Abc@123456');
let $query = SELECT
    username,
    password,
    VALIDATE_PASSWORD_STRENGTH(password) AS strength_score,
    'Need to change' AS suggestion
FROM user_passwords WHERE VALIDATE_PASSWORD_STRENGTH(password) <= 1;
--replace_column 10 # 11 #
eval explain $query;
eval $query;
DROP TABLE user_passwords;

--echo # Item_cache_row
CREATE TABLE employees (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    salary DECIMAL(10,2),
    department_id INT,
    hire_date DATE
);
CREATE TABLE departments (
    id INT PRIMARY KEY,
    dept_name VARCHAR(50),
    location VARCHAR(50)
);
CREATE TABLE salaries (
    id INT PRIMARY KEY AUTO_INCREMENT,
    employee_id INT,
    year YEAR,
    amount DECIMAL(10,2)
);
INSERT INTO departments VALUES
(1, 'Sales', 'New York'),
(2, 'IT', 'San Francisco'),
(3, 'HR', 'Chicago');

INSERT INTO employees VALUES
(1, 'John Doe', 75000, 1, '2020-01-15'),
(2, 'Jane Smith', 85000, 2, '2019-03-20'),
(3, 'Bob Johnson', 65000, 1, '2021-06-10'),
(4, 'Alice Brown', 95000, 2, '2018-11-05'),
(5, 'Charlie Wilson', 55000, 3, '2022-02-28');

INSERT INTO salaries (employee_id, year, amount) VALUES
(1, 2023, 75000),(1, 2024, 78000),(2, 2023, 85000),(2, 2024, 88000),
(3, 2023, 65000),(3, 2024, 67000),(4, 2023, 95000),(4, 2024, 98000),
(5, 2023, 55000),(5, 2024, 57000);
--replace_column 10 # 11 #
explain SELECT
    e.name,
    e.salary,
    (SELECT dept_name FROM departments d WHERE d.id = e.department_id) AS department_name,
    (SELECT location FROM departments d WHERE d.id = e.department_id) AS department_location
FROM employees e
WHERE e.salary > 60000;
DROP TABLE employees, departments, salaries;

