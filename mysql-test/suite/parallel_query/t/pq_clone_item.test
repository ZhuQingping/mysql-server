--echo # Item_func_connection_id
CREATE TABLE t1 (
    log_id INT AUTO_INCREMENT PRIMARY KEY,
    connection_id BIGINT,
    query_text varchar(100),
    execution_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
INSERT INTO t1 (connection_id, query_text)
VALUES
    (CONNECTION_ID(), 'Test query 1'),
    (CONNECTION_ID(), 'Test query 2'),
    (CONNECTION_ID(), 'Test query 3');
--replace_column 10 # 11 #
EXPLAIN SELECT
    log_id,
    connection_id,
    query_text
FROM t1 WHERE connection_id = CONNECTION_ID() ORDER BY log_id DESC;
DROP TABLE t1;

--echo # Item_func_unix_timestamp & Item_func_found_rows & Item_func_connection_id
CREATE TABLE t1 (
    monitor_id INT AUTO_INCREMENT PRIMARY KEY,
    connection_id BIGINT,
    username VARCHAR(100),
    action_time INT UNSIGNED,
    query_text TEXT,
    rows_found INT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    INDEX idx_username_time (username, action_time)
);
INSERT INTO t1 (connection_id, username, action_time, query_text, rows_found) VALUES
(1001, 'admin@localhost', UNIX_TIMESTAMP('2024-01-22 09:00:00'), 'SELECT * FROM users', 150),
(1002, 'user1@localhost', UNIX_TIMESTAMP('2024-01-22 09:15:00'), 'SELECT * FROM orders', 75),
(1003, CURRENT_USER(), UNIX_TIMESTAMP('2024-01-22 09:30:00'), 'SELECT * FROM products', 200),
(1004, 'admin@localhost', UNIX_TIMESTAMP(), 'INSERT INTO logs VALUES (...)', 1),
(CONNECTION_ID(), 'test@localhost', UNIX_TIMESTAMP('2024-01-22 10:00:00'), 'TEST QUERY', 0);
--disable_result_log
SELECT SQL_CALC_FOUND_ROWS
    FROM_UNIXTIME(action_time) AS action_datetime,
    action_time AS unix_timestamp,
    rows_found,
    UNIX_TIMESTAMP() - action_time AS seconds_ago,
    CASE
        WHEN connection_id = CONNECTION_ID() THEN 'My Connection'
        ELSE 'Other User'
    END AS activity_owner
FROM t1
WHERE action_time > UNIX_TIMESTAMP() - 86400
ORDER BY action_time DESC LIMIT 10;
SELECT FOUND_ROWS();
--enable_result_log
DROP TABLE t1;

--echo # Item_func_benchmark
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    value INT,
    text_value VARCHAR(100)
);
--replace_column 10 # 11 #
EXPLAIN SELECT
    BENCHMARK(50000,
        CASE
            WHEN id % 2 = 0 THEN 'Even'
            ELSE 'Odd'
        END
    ) AS case_performance
FROM t1  LIMIT 1;
DROP TABLE t1;

