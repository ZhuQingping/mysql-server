--echo # Item_func_coercibility
CREATE TABLE coercibility_test (
    id INT PRIMARY KEY,
    col_utf8 VARCHAR(50) CHARACTER SET utf8mb4,
    col_latin1 VARCHAR(50) CHARACTER SET latin1,
    col_ascii VARCHAR(50) CHARACTER SET ascii,
    col_binary VARBINARY(50)
);
INSERT INTO coercibility_test VALUES
(1, 'Hello', 'Hello', 'Hello', 'Hello'),
(2, 'Test', 'Test', 'Test', 'Test'),
(3, 'café', 'café', 'cafe', 'café'),
(4, '你好', 'Nihao', 'nihao', 'nihao');
