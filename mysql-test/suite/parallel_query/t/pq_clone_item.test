--echo # Item_func_bit_xor
CREATE TABLE t1 (id INT, a INT, b INT);
INSERT INTO t1 VALUES (1, 5, 3), (2, 12, 7), (3, 15, 15), (4, 0, 255), (5, 85, 170);
--replace_column 10 # 11 #
explain SELECT id,a,b, a ^ b AS xor_result FROM t1;
--replace_column 10 # 11 #
explain SELECT id,a,b, b >> 1 AS id_right_shift_1 FROM t1;
--replace_column 10 # 11 #
explain SELECT id,a,b, ~b FROM t1;
