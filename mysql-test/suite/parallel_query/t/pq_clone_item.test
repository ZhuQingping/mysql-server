--echo # Item_func_second/Item_func_week/Item_func_yearweek/Item_func_minute
CREATE TABLE system_logs (
    log_id INT PRIMARY KEY AUTO_INCREMENT,
    log_message VARCHAR(200),
    log_time DATETIME DEFAULT CURRENT_TIMESTAMP,
    user_id INT
);
INSERT INTO system_logs (log_message, log_time, user_id) VALUES
('User login', '2024-01-15 09:15:30', 101),
('File uploaded', '2024-01-15 09:30:45', 102),
('Report generated', '2024-01-15 14:20:15', 101),
('System backup', '2024-01-16 02:00:00', 103),
('Error occurred', '2024-01-16 11:45:20', 102),
('Data exported', '2024-01-17 16:30:10', 101);
--replace_column 10 # 11 #
explain SELECT
    log_id,
    log_message,
    log_time,
    SECOND(log_time) AS seconds,
    MINUTE(log_time) AS minutes,
    HOUR(log_time) AS hour,
    WEEK(log_time) AS week_number,
    YEARWEEK(log_time) AS yearweek,
    CONCAT(
        'Week ', WEEK(log_time),
        ', Hour ', HOUR(log_time),
        ':', LPAD(MINUTE(log_time), 2, '0')
    ) AS time_info
FROM system_logs;
--replace_column 10 # 11 #
explain SELECT
    YEARWEEK(log_time) AS year_week,
    COUNT(*) AS logs_count
FROM system_logs GROUP BY YEARWEEK(log_time) ORDER BY year_week;
DROP TABLE system_logs;

--echo # Test with Item about math
CREATE TABLE math_time_test (
    id INT PRIMARY KEY AUTO_INCREMENT,
    value DOUBLE,
    angle_radians DOUBLE,
    angle_degrees DOUBLE,
    event_date DATE,
    log_value DOUBLE,
    description VARCHAR(100)
);
INSERT INTO math_time_test (value, angle_radians, angle_degrees, event_date, log_value, description) VALUES
(1.0, 0.785398, 45.0, '2024-01-15', 2.71828, 'First quarter, 45 degrees'),
(2.0, 1.570796, 90.0, '2024-04-15', 7.38906, 'Second quarter, 90 degrees'),
(3.0, 3.141593, 180.0, '2024-07-15', 20.0855, 'Third quarter, 180 degrees'),
(4.0, 4.712389, 270.0, '2024-10-15', 54.5982, 'Fourth quarter, 270 degrees'),
(0.5, 0.523599, 30.0, '2024-02-29', 1.64872, 'Leap day, 30 degrees'),
(10.0, 0.0, 0.0, '2024-12-31', 22026.5, 'Year end, 0 degrees'),
(0.0, 1.047198, 60.0, '2024-06-15', 1.0, 'Mid year, 60 degrees'),
(0.707107, 0.785398, 45.0, '2024-03-20', 2.02811, 'Spring equinox'),
(-1.0, -0.785398, -45.0, '2024-11-11', 0.367879, 'Negative angle');
--replace_column 10 # 11 #
explain SELECT
    id,
    description,
    event_date,
    QUARTER(event_date) AS quarter,
    angle_degrees,
    TAN(RADIANS(angle_degrees)) AS tangent,
    COT(RADIANS(angle_degrees)) AS cotangent,
    value,
    LN(ABS(value) + 1) AS safe_log,
    LOG10(ABS(value) + 1) AS safe_log10,
    CASE
        WHEN value BETWEEN -1 AND 1 THEN DEGREES(ASIN(value))
        ELSE NULL
    END AS arcsin_degrees,
    EXP(value) AS exponential,
    EXP(LN(ABS(value) + 1)) AS exp_ln_combo
FROM math_time_test;
--replace_column 10 # 11 #
explain SELECT * FROM math_time_test
WHERE QUARTER(event_date) = 2
  AND TAN(RADIANS(angle_degrees)) > 0
  AND LOG10(ABS(value) + 1) < 0.5
  AND EXP(value) < 100;
--replace_column 10 # 11 #
explain SELECT * FROM math_time_test where ATAN2(angle_radians, angle_degrees) > 0;
DROP TABLE math_time_test;

--echo # Item_func_aes_decrypt&Item_func_aes_encrypt
CREATE TABLE users_secure (
    user_id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50) UNIQUE,
    encrypted_email VARBINARY(255),
    encrypted_phone VARBINARY(255),
    encryption_key VARCHAR(64),
    iv VARBINARY(16),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
INSERT INTO users_secure (username, encryption_key, iv) VALUES
('john_doe', 'my_secure_key_2024!', RANDOM_BYTES(16)),
('jane_smith', 'my_secure_key_2024!', RANDOM_BYTES(16)),
('admin_user', 'admin_key_special', RANDOM_BYTES(16)),
('test_user', 'my_secure_key_2024!', RANDOM_BYTES(16));
--replace_column 10 # 11 #
explain SELECT
    user_id,
    username,
    CAST(AES_DECRYPT(encrypted_email, encryption_key, iv) AS CHAR) AS decrypted_email
FROM users_secure
WHERE encrypted_email = AES_ENCRYPT('john_doe@example.com', encryption_key, iv);

--replace_column 10 # 11 #
explain SELECT
    user_id,
    username
FROM users_secure
WHERE encrypted_email IN (
    AES_ENCRYPT('john_doe@example.com', encryption_key, iv),
    AES_ENCRYPT('jane_smith@example.com', encryption_key, iv)
);
DROP TABLE users_secure;

CREATE TABLE user_data_processed (
    user_id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50),
    full_name VARCHAR(100),
    encoded_bio VARCHAR(200),
    profile_collation VARCHAR(50),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
INSERT INTO user_data_processed (username, full_name, encoded_bio, profile_collation) VALUES
('john_doe', 'John Doe', 'QSBzb2Z0d2FyZSBlbmdpbmVlciB3aG8gbG92ZXMgZGF0YWJhc2Vz', 'utf8mb4_general_ci'),
('jane_tech', 'Jane Smith', 'RGF0YSBzY2llbnRpc3Qgc3BlY2lhbGl6aW5nIGluIEFJIGFuZCBNTA==', 'utf8mb4_bin'),
('admin_user', 'Admin User', 'U3lzdGVtIGFkbWluaXN0cmF0b3Igd2l0aCBmdWxsIHByaXZpbGVnZXM=', 'utf8mb4_unicode_ci');
--replace_column 10 # 11 #
explain SELECT
    user_id,
    username,
    full_name,
    ORD(full_name) AS name_first_char_code,
    LOCATE(' ', full_name) AS space_position_in_name,
    profile_collation,
    COLLATION(full_name) AS name_collation,
    LAST_INSERT_ID() AS last_inserted_user_id
FROM user_data_processed;
--replace_column 10 # 11 #
explain SELECT FROM_BASE64('SGVsbG8=') FROM user_data_processed;
DROP TABLE user_data_processed;
