# Test: pq_explain_dop_cap
# Verify EXPLAIN annotations match the runtime DOP execution cap.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (id INT PRIMARY KEY, val INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10),(2,20),(3,30),(4,40);

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;

SET @pq_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');

# DOP0 is accepted by the sysvar contract but is not an executable PQ DOP.
SET SESSION parallel_default_dop=0;
EXPLAIN SELECT * FROM t1;
--replace_regex /cost=[0-9.]+ rows=[0-9.]+/cost=<cost> rows=<rows>/
EXPLAIN FORMAT=TREE SELECT * FROM t1;
--replace_regex /\"query_cost\": \"[^\"]*\"/\"query_cost\": \"<cost>\"/ /\"rows_examined_per_scan\": [0-9]+/\"rows_examined_per_scan\": <rows>/ /\"rows_produced_per_join\": [0-9]+/\"rows_produced_per_join\": <rows>/ /\"read_cost\": \"[^\"]*\"/\"read_cost\": \"<cost>\"/ /\"eval_cost\": \"[^\"]*\"/\"eval_cost\": \"<cost>\"/ /\"prefix_cost\": \"[^\"]*\"/\"prefix_cost\": \"<cost>\"/ /\"data_read_per_join\": \"[^\"]*\"/\"data_read_per_join\": \"<bytes>\"/
EXPLAIN FORMAT=JSON SELECT * FROM t1;

# DOP above the current fullscan execution cap must also explain as serial.
SET SESSION parallel_default_dop=1024;
EXPLAIN SELECT * FROM t1;
--replace_regex /cost=[0-9.]+ rows=[0-9.]+/cost=<cost> rows=<rows>/
EXPLAIN FORMAT=TREE SELECT * FROM t1;
--replace_regex /\"query_cost\": \"[^\"]*\"/\"query_cost\": \"<cost>\"/ /\"rows_examined_per_scan\": [0-9]+/\"rows_examined_per_scan\": <rows>/ /\"rows_produced_per_join\": [0-9]+/\"rows_produced_per_join\": <rows>/ /\"read_cost\": \"[^\"]*\"/\"read_cost\": \"<cost>\"/ /\"eval_cost\": \"[^\"]*\"/\"eval_cost\": \"<cost>\"/ /\"prefix_cost\": \"[^\"]*\"/\"prefix_cost\": \"<cost>\"/ /\"data_read_per_join\": \"[^\"]*\"/\"data_read_per_join\": \"<bytes>\"/
EXPLAIN FORMAT=JSON SELECT * FROM t1;

# Positive in-cap DOP values keep the eligible annotation.
SET SESSION parallel_default_dop=3;
EXPLAIN SELECT * FROM t1;
--replace_regex /cost=[0-9.]+ rows=[0-9.]+/cost=<cost> rows=<rows>/
EXPLAIN FORMAT=TREE SELECT * FROM t1;
--replace_regex /\"query_cost\": \"[^\"]*\"/\"query_cost\": \"<cost>\"/ /\"rows_examined_per_scan\": [0-9]+/\"rows_examined_per_scan\": <rows>/ /\"rows_produced_per_join\": [0-9]+/\"rows_produced_per_join\": <rows>/ /\"read_cost\": \"[^\"]*\"/\"read_cost\": \"<cost>\"/ /\"eval_cost\": \"[^\"]*\"/\"eval_cost\": \"<cost>\"/ /\"prefix_cost\": \"[^\"]*\"/\"prefix_cost\": \"<cost>\"/ /\"data_read_per_join\": \"[^\"]*\"/\"data_read_per_join\": \"<bytes>\"/
EXPLAIN FORMAT=JSON SELECT * FROM t1;

SELECT
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_queries_executed') -
     @pq_executed_before AS explain_executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED)
     FROM performance_schema.global_status
     WHERE variable_name = 'Parallel_queries_fallback') -
     @pq_fallback_before AS explain_fallback_delta;

SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;
