# Adapted commercial pq_kill_query coverage for external KILL QUERY.

--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS pq_kill_query_t;
--enable_warnings

CREATE TABLE pq_kill_query_t (id INT PRIMARY KEY, pad CHAR(40)) ENGINE=InnoDB;
INSERT INTO pq_kill_query_t VALUES (1,'a');
INSERT INTO pq_kill_query_t SELECT id + 1, pad FROM pq_kill_query_t;
INSERT INTO pq_kill_query_t SELECT id + 2, pad FROM pq_kill_query_t;
INSERT INTO pq_kill_query_t SELECT id + 4, pad FROM pq_kill_query_t;
INSERT INTO pq_kill_query_t SELECT id + 8, pad FROM pq_kill_query_t;
INSERT INTO pq_kill_query_t SELECT id + 16, pad FROM pq_kill_query_t;

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=1;

SET @old_debug=@@session.debug;
SET SESSION debug="d,pq_read_threaded_shadow_path";
SET DEBUG_SYNC='pq_read_threaded_worker_started SIGNAL pq_worker_started WAIT_FOR pq_kill_continue TIMEOUT 10';

SET @pq_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');

--let $target_id= `SELECT CONNECTION_ID()`
--send SELECT * FROM pq_kill_query_t

--connect(killer,localhost,root,,)
SET DEBUG_SYNC='now WAIT_FOR pq_worker_started TIMEOUT 10';
--replace_result $target_id TARGET_ID
--eval KILL QUERY $target_id
SET DEBUG_SYNC='now SIGNAL pq_kill_continue';

--connection default
--error ER_QUERY_INTERRUPTED
--reap

SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
    AS executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
    AS fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
    AS workers_delta;

SET DEBUG_SYNC='RESET';
SET SESSION debug=@old_debug;
SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_cost_threshold=10000;

--disconnect killer
--connection default

SELECT COUNT(*) AS serial_count FROM pq_kill_query_t;

DROP TABLE pq_kill_query_t;
