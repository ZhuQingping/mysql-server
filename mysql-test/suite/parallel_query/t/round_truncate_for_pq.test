--source include/pq_test.inc
--echo # Enabling ROUND and TRUNCATE to pq

--echo # Test layout
--echo # First part: testing on DECIMAL columns
--echo # Second part: same on DOUBLE columns
--echo # Within each part, we test ROUND and TRUNCATE

--echo # --------
--echo # DECIMAL
--echo # --------

CREATE TABLE t0 ( a DECIMAL(10,5), b DECIMAL(10,5),c DECIMAL (10,5), type INT);
INSERT INTO t0 VALUES (1.2246,2.54678,3.5446,1),(2.2246,3.54678,9.5446,1),(3.2246,4.54678,8.5446,2),(4.2246,5.54678,7.5446,3),(5.2246,6.54678,6.5446,3);

CREATE TABLE t1 ( a INT, b DECIMAL(15,8), c DECIMAL(15,8));
INSERT INTO t1 VALUES(1,1.3534653,3.243),(2,2.3534653,3.353454),(1,2.3534653,4.5565),(1,14.3534653,43245.35656),(1,15.3534653,766.346546),(1,155.3534653,3656.56),(1,135.3534653,125345.553464);

CREATE TABLE t2 (a DECIMAL(15,8), b DECIMAL(15,8));
INSERT INTO t2 VALUES (999.99,354.656),(499.99,154.656),(699.99,254.656),(599.99,454.656),(399.99,154.656),(NULL,NULL),(1399.99,NULL),(NULL,14.6123);

ANALYZE TABLE t0, t1, t2;

--source suite/parallel_query/include/pq_round_truncate_queries.inc

DROP TABLE t0,t1,t2;

--echo # --------
--echo # DOUBLE
--echo # --------

CREATE TABLE t0 ( a DOUBLE, b DOUBLE,c DOUBLE, type INT);
INSERT INTO t0 VALUES (1.2246,2.54678,3.5446,1),(2.2246,3.54678,9.5446,1),(3.2246,4.54678,8.5446,2),(4.2246,5.54678,7.5446,3),(5.2246,6.54678,6.5446,3);

CREATE TABLE t1 ( a INT, b DOUBLE, c DOUBLE);
INSERT INTO t1 VALUES(1,1.3534653,3.243),(2,2.3534653,3.353454),(1,2.3534653,4.5565),(1,14.3534653,43245.35656),(1,15.3534653,766.346546),(1,155.3534653,3656.56),(1,135.3534653,125345.553464);

CREATE TABLE t2 (a DOUBLE, b DOUBLE);
