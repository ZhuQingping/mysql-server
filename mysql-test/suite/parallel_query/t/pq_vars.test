# Test: pq_vars
# Verify that PQ system variables are visible and have correct defaults.
# This test only checks variable existence and values - no execution impact.

--source include/have_innodb_16k.inc

# Verify PQ system variables exist with expected defaults
SELECT @@session.parallel_query;
SELECT @@session.parallel_default_dop;
SELECT @@session.parallel_cost_threshold;
SELECT @@session.parallel_rows_threshold;
SELECT @@session.parallel_tuple_cost;
SELECT @@session.parallel_setup_cost;
SELECT @@session.parallel_graceful_fallback;
SELECT @@session.parallel_memory_limit;
SELECT @@session.parallel_queue_timeout;
SELECT @@session.parallel_query_experimental_threaded_dop1;
SELECT @@session.parallel_query_experimental_threaded_dop;
SELECT @@session.parallel_query_experimental_threaded_dop4;
SELECT @@session.parallel_query_experimental_groupby_dop1;

# Verify defaults: parallel_query=OFF, dop=4, cost_threshold=10000
--let $pq_default_off = `SELECT @@session.parallel_query`
--echo $pq_default_off

--let $pq_default_dop = `SELECT @@session.parallel_default_dop`
--echo $pq_default_dop

--let $pq_default_cost = `SELECT @@session.parallel_cost_threshold`
--echo $pq_default_cost

--let $pq_default_rows_threshold = `SELECT @@session.parallel_rows_threshold`
--echo $pq_default_rows_threshold

--let $pq_default_tuple_cost = `SELECT @@session.parallel_tuple_cost`
--echo $pq_default_tuple_cost

--let $pq_default_setup_cost = `SELECT @@session.parallel_setup_cost`
--echo $pq_default_setup_cost

--let $pq_default_graceful_fallback = `SELECT @@session.parallel_graceful_fallback`
--echo $pq_default_graceful_fallback

# Verify we can turn parallel_query ON
SET SESSION parallel_query=ON;
SELECT @@session.parallel_query;

# Verify we can adjust dop
SET SESSION parallel_default_dop=2;
SELECT @@session.parallel_default_dop;

# Verify commercial DOP boundary values and invalid values.
SET SESSION parallel_default_dop=0;
SELECT @@session.parallel_default_dop;
SET SESSION parallel_default_dop=1024;
SELECT @@session.parallel_default_dop;
SET SESSION parallel_default_dop=1025;
SHOW WARNINGS;
SELECT @@session.parallel_default_dop;

# Verify commercial memory/queue variables are configurable in the current
# variable contract.
SET SESSION parallel_memory_limit=0;
SELECT @@session.parallel_memory_limit;
SET SESSION parallel_queue_timeout=1;
SELECT @@session.parallel_queue_timeout;
SET SESSION parallel_rows_threshold=0;
SELECT @@session.parallel_rows_threshold;
SET SESSION parallel_tuple_cost=0.0;
SELECT @@session.parallel_tuple_cost;
SET SESSION parallel_setup_cost=0.0;
SELECT @@session.parallel_setup_cost;
SET SESSION parallel_graceful_fallback=OFF;
SELECT @@session.parallel_graceful_fallback;

# Verify experimental threaded DOP=1 execution gate is configurable.
SET SESSION parallel_query_experimental_threaded_dop1=ON;
SELECT @@session.parallel_query_experimental_threaded_dop1;

# Verify experimental threaded DOP=2 execution gate is configurable.
SET SESSION parallel_query_experimental_threaded_dop=ON;
SELECT @@session.parallel_query_experimental_threaded_dop;

# Verify experimental threaded DOP=4 execution gate is configurable.
SET SESSION parallel_query_experimental_threaded_dop4=ON;
SELECT @@session.parallel_query_experimental_threaded_dop4;

# Verify experimental GROUP BY DOP=1 execution gate is configurable.
SET SESSION parallel_query_experimental_groupby_dop1=ON;
SELECT @@session.parallel_query_experimental_groupby_dop1;

# Reset to defaults
SET SESSION parallel_query=OFF;
SET SESSION parallel_default_dop=4;
SET SESSION parallel_rows_threshold=10000;
SET SESSION parallel_tuple_cost=1.5;
SET SESSION parallel_setup_cost=250.0;
SET SESSION parallel_graceful_fallback=ON;
SET SESSION parallel_memory_limit=268435456;
SET SESSION parallel_queue_timeout=0;
SET SESSION parallel_query_experimental_threaded_dop1=OFF;
SET SESSION parallel_query_experimental_threaded_dop=OFF;
SET SESSION parallel_query_experimental_threaded_dop4=OFF;
SET SESSION parallel_query_experimental_groupby_dop1=OFF;
SELECT @@session.parallel_query;
SELECT @@session.parallel_default_dop;
SELECT @@session.parallel_rows_threshold;
SELECT @@session.parallel_tuple_cost;
SELECT @@session.parallel_setup_cost;
SELECT @@session.parallel_graceful_fallback;
SELECT @@session.parallel_memory_limit;
SELECT @@session.parallel_queue_timeout;
SELECT @@session.parallel_query_experimental_threaded_dop1;
SELECT @@session.parallel_query_experimental_threaded_dop;
SELECT @@session.parallel_query_experimental_threaded_dop4;
SELECT @@session.parallel_query_experimental_groupby_dop1;

# Verify global variables are visible
SELECT @@global.parallel_query;
SELECT @@global.parallel_default_dop;
SELECT @@global.parallel_rows_threshold;
SELECT @@global.parallel_tuple_cost;
SELECT @@global.parallel_setup_cost;
SELECT @@global.parallel_graceful_fallback;
SELECT @@global.parallel_query_experimental_threaded_dop1;
SELECT @@global.parallel_query_experimental_threaded_dop;
SELECT @@global.parallel_query_experimental_threaded_dop4;
SELECT @@global.parallel_query_experimental_groupby_dop1;
