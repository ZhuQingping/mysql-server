# Verify row-stream Read() honors leader kill before materializing rows.

--source include/have_innodb_16k.inc
--source include/have_debug.inc

CREATE TABLE pq_leader_row_stream_kill_priority_t (
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO pq_leader_row_stream_kill_priority_t VALUES (1,10),(2,20);

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=1;

SET @stream_attempts_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_attempts');
SET @stream_selected_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_selected');
SET @stream_rows_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_rows');
SET @queries_executed_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_queries_executed');

SET @old_debug=@@session.debug;
SET SESSION debug="d,pq_leader_row_stream_smoke,pq_leader_row_stream_force_kill";
--error ER_QUERY_INTERRUPTED
SELECT id, v FROM pq_leader_row_stream_kill_priority_t WHERE v >= 0;
SET SESSION debug=@old_debug;

SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_attempts') -
  @stream_attempts_before) >= 1 AS stream_attempt_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_selected') -
  @stream_selected_before) >= 1 AS stream_selected_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_leader_row_stream_smoke_rows') -
  @stream_rows_before) AS stream_rows_delta;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_queries_executed') -
  @queries_executed_before) AS queries_executed_delta;

SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
SET SESSION parallel_default_dop=4;

DROP TABLE pq_leader_row_stream_kill_priority_t;
