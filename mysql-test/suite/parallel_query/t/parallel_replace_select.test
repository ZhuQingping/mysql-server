--source include/pq_test.inc
--source include/count_sessions.inc
--source include/elide_costs.inc
SET @old_innodb_lock_wait_timeout = @@global.innodb_lock_wait_timeout;

SET @@global.innodb_lock_wait_timeout = 1;

--echo # -----------------------

--echo # basic testing 

--echo # ----------------------
SET @saved_pq_support_features_switch = @@global.pq_support_features_switch;
set pq_support_features_switch='insert_select=on';

create table t0 (a int);
create table t1 (a int, UNIQUE(a));
insert into t0 values (1),(2),(3);
insert into t1 values (1),(2),(3);

--echo # FOR UPDATE and LOCK IN SHARE MODE disable parallel insert select
--echo # because the locks are not released.
--replace_regex $elide_costs_and_rows
explain format=tree replace into t1 select * from t0;
--replace_regex $elide_costs_and_rows
explain format=tree replace into t1 select * from t0 FOR UPDATE;
--replace_regex $elide_costs_and_rows
explain format=tree replace into t1 select * from t0 LOCK IN SHARE MODE;

drop table t0;

--echo # SELECT ON PK 

alter table t1 add primary key(a);
create table t2 ( a int, UNIQUE(a));
insert into t2 values (1),(2),(3);

--replace_regex $elide_costs_and_rows
explain format=tree replace into t2 select * from t1; 
replace into t2 select * from t1; 
select * from t2;


--echo # SELECT ON 2nd index

alter table t1 drop primary key;
alter table t1 add index(a);

--replace_regex $elide_costs_and_rows
explain format=tree replace into t2 select * from t1; 
replace into t2 select * from t1; 
select * from t2;

drop table t2;

--echo # replace into itself

alter table t1 drop index a;
alter table t1 add primary key(a);

start transaction;
--replace_regex $elide_costs_and_rows
explain format=tree replace into t1 select * from t1; 
replace into t1 select * from t1; 
select * from t1;
rollback;

start transaction;
--replace_regex $elide_costs_and_rows
explain format=tree replace into t1 select a+1 from t1; 
replace into t1 select a+1 from t1; 
select * from t1;

drop table t1;
set pq_support_features_switch = default;

--echo # -------------
--echo # Parallel insert select with concurrent DML
--echo # A: INSERT B: UPDATE C: DELETE
--echo # --------------------
--echo # A 
--echo # Parallel Insert into select with concurrent INSERT 
--echo # 1: with parallel insert 2: without 
--echo # They behave the same.
--echo # ---------------------

--echo # 1

SET GLOBAL pq_support_features_switch='insert_select=on';


create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);


connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
replace into t2 select a from t1;

connection con2;
--echo # Using connection con2
--send INSERT INTO t1 values(85);
connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--reap
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;

select * from t1;
select * from t2;
drop table t1,t2;



--echo # 2

SET GLOBAL pq_support_features_switch='insert_select=off';


create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
replace into t2 select a from t1;

connection con2;
--echo # Using connection con2
--send INSERT INTO t1 values(85);
connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--reap
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;

select * from t1;
select * from t2;
drop table t1,t2;





--echo # --------------------
--echo # B
--echo # Parallel Insert into select with concurrent UPDATE
--echo # 1: with parallel insert 2: without 
--echo # They behave the same.
--echo # ---------------------

--echo # 1

SET GLOBAL pq_support_features_switch='insert_select=on';


create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
replace into t2 select a from t1;

connection con2;
--echo # Using connection con2
--send UPDATE t1 SET a = 85 where a=5;
connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--reap
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;

select * from t1;
select * from t2;
drop table t1,t2;




--echo # 2

SET GLOBAL pq_support_features_switch='insert_select=off';

create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
replace into t2 select a from t1;

connection con2;
--echo # Using connection con2
--send UPDATE t1 SET a = 85 where a=5;
connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--reap
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;

select * from t1;
select * from t2;
drop table t1,t2;




--echo # --------------------
--echo # C
--echo # Parallel Insert into select with concurrent DELETE
--echo # 1: with parallel insert 2: without 
--echo # They behave the same.
--echo # ---------------------

--echo # 1

SET GLOBAL pq_support_features_switch='insert_select=on';


create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
replace into t2 select a from t1;

connection con2;
--echo # Using connection con2
--send DELETE FROM  t1 where a=5;
connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--reap
connection default;
disconnect con1;
disconnect con2;

select * from t1;
select * from t2;
drop table t1,t2;







--echo # 2

SET GLOBAL pq_support_features_switch='insert_select=off';

create table t1 (a int);
create table t2 (b int, UNIQUE(b));
insert into t1 values (1),(3),(5);
insert into t2 values (1),(3),(5);

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
replace into t2 select a from t1;

connection con2;
--echo # Using connection con2
--send DELETE FROM  t1 where a=5;
connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--reap
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;

select * from t1;
select * from t2;
drop table t1,t2;





--echo # A/ INSERTING INTO table t1 with UNIQUE INDEX from t2 
--echo # Locks from inserted-into table prevent the insert 

--echo # 1/a

SET GLOBAL pq_support_features_switch='insert_select=on';
CREATE TABLE t1(a INT,  UNIQUE KEY(a)); 
CREATE TABLE t2(a int);
INSERT INTO t1 VALUES(1), (5), (15), (35);
INSERT INTO t2 values (2),(7),(30),(40),(50); 

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
INSERT INTO t1 values (50);
connection con2;
--echo # Using connection con2
--error ER_LOCK_WAIT_TIMEOUT
replace into t1 select * from t2;
connection con1;
--echo # Using connection con1
rollback;
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;


--echo # 1/b/ 


connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
INSERT INTO t1 values (50);
connection con2;
--echo # Using connection con2
--send replace into t1 select * from t2;
connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--reap
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;

drop table t1,t2;

--echo # 2/a (same as 1/a but without parallel insert select)

SET GLOBAL pq_support_features_switch='insert_select=off';

CREATE TABLE t1(a INT,  UNIQUE KEY(a)); 
CREATE TABLE t2(a int);
INSERT INTO t1 VALUES(1), (5), (15), (35);
INSERT INTO t2 values (2),(7),(30),(40),(50); 




connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
INSERT INTO t1 values (50);
connection con2;
--echo # Using connection con2
--error ER_LOCK_WAIT_TIMEOUT
replace into t1 select * from t2;
connection con1;
--echo # Using connection con1
rollback;
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;

--echo # 2/b (same as 1/b but without parallel insert select)

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
INSERT INTO t1 values (50);
connection con2;
--echo # Using connection con2
--send replace into t1 select * from t2;
connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--reap
--echo # HERE as well
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;

drop table t1,t2;

--echo # B/ INSERTING INTO table t1 into itself with UNIQUE INDEX 
--echo # Locks from inserted-into table prevent the insert 

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

SET GLOBAL pq_support_features_switch='insert_select=on';

CREATE TABLE t1(a INT,  UNIQUE KEY(a)); 
INSERT INTO t1 VALUES(1), (5), (15), (35);

connection con1;
--echo # Using connection con1
start transaction;
INSERT INTO t1 values (85);
connection con2;
--echo # Using connection con2
--send replace into t1 select a + 50 from t1;

connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--reap
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;

drop table t1;


SET GLOBAL pq_support_features_switch='insert_select=off';
connect (con1,localhost,root,,);
connect (con2,localhost,root,,);



CREATE TABLE t1(a INT,  UNIQUE KEY(a)); 
INSERT INTO t1 VALUES(1), (5), (15), (35);

connection con1;
--echo # Using connection con1
start transaction;
INSERT INTO t1 values (85);
connection con2;
--echo # Using connection con2
--send replace into t1 select a + 50 from t1;

connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--reap
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;


--echo # -------------------------
--echo # session one calls 'INSERT ... SELECT a + 50 ...' to the same table, 
--echo # Session two tries to inserts 85
--echo # Session two insert fails because of the duplicate key error.
--echo # --------------------------

drop table  t1;
CREATE TABLE t1(a INT,  UNIQUE KEY(a)); 
INSERT INTO t1 VALUES(1), (5), (15), (35);

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
replace into t1 select a + 50 from t1;

connection con2;
--echo # Using connection con2
--send INSERT INTO t1 values(85);
connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--error ER_DUP_ENTRY
--reap
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;




SET GLOBAL pq_support_features_switch='insert_select=on';

drop table t1;
CREATE TABLE t1(a INT,  UNIQUE KEY(a)); 
INSERT INTO t1 VALUES(1), (5), (15), (35);

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

connection con1;
--echo # Using connection con1
start transaction;
replace into t1 select a + 50 from t1;

connection con2;
--echo # Using connection con2
--send INSERT INTO t1 values(85);
connection con1;
--echo # Using connection con1
commit;
connection con2;
--echo # Using connection con2
--error ER_DUP_ENTRY
--reap
connection default;
--echo # Using connection default
disconnect con1;
disconnect con2;
drop table t1;

SET @@global.innodb_lock_wait_timeout = @old_innodb_lock_wait_timeout;
SET global pq_support_features_switch = @saved_pq_support_features_switch;
--source include/wait_until_count_sessions.inc

