## ISSUE 623

CREATE TABLE t1(a INT);
CREATE TABLE t2(a INT);
INSERT INTO t1 VALUES (1),(2),(3),(4);
INSERT INTO t2 VALUES (1),(2);
CREATE TABLE t0 AS SELECT * FROM t1;
CREATE TABLE t3(a INT, b INT);
INSERT INTO t3 VALUES (1,3), (2,3);
ANALYZE TABLE t1, t2, t0, t3;

EXPLAIN SELECT * FROM t1 WHERE t1.a > (SELECT COUNT(a) AS cnt FROM t2);
SELECT * FROM t1 WHERE t1.a > (SELECT COUNT(a) AS cnt FROM t2);
DROP table t0, t1, t2, t3;

CREATE TABLE t1 (c11 int);
INSERT INTO t1 VALUES (1);
EXPLAIN SELECT * FROM (SELECT (1) alias1, (SELECT alias1) alias2 FROM t1) X ;
SELECT * FROM (SELECT (1) alias1, (SELECT alias1) alias2 FROM t1) X ;
EXPLAIN SELECT alias2 FROM (SELECT (1) alias1, (SELECT alias1) alias2 FROM t1) X ;
SELECT alias2 FROM (SELECT (1) alias1, (SELECT alias1) alias2 FROM t1) X ;
DROP table t1;

CREATE TABLE small (
id INTEGER not null,
PRIMARY KEY (id)
);
CREATE TABLE big (
id INTEGER not null,
PRIMARY KEY (id)
);
INSERT INTO small VALUES (1), (2);
INSERT INTO big VALUES (1), (2), (3), (4);
CREATE VIEW small_view AS
SELECT *, IF (id % 2 = 1, 1, 0) AS is_odd
FROM small;
CREATE VIEW big_view AS
SELECT big.*, small_view.id AS small_id, small_view.is_odd
FROM big LEFT JOIN small_view ON small_view.id = big.id;

EXPLAIN SELECT * FROM big_view;
SELECT * FROM big_view;
select `big`.`id`,`small`.`id` AS `small_id`, if(((`small`.`id` % 2) = 1), 1, 0) AS `is_odd` from `big` left join `small` on `small`.`id` = `big`.`id`;
DROP table small, big;
DROP view small_view, big_view;

CREATE TABLE t1 (id INT);
CREATE TABLE t2 (id INT);
INSERT INTO t1 VALUES (1), (2);
INSERT INTO t2 VALUES (1);
EXPLAIN SELECT *
FROM (SELECT id
FROM t1) AS a
LEFT JOIN
(SELECT id, 2 AS tall
FROM t2) AS b
ON a.id = b.id
WHERE b.tall IS NOT NULL;

SELECT *
FROM (SELECT id
FROM t1) AS a
LEFT JOIN
(SELECT id, 2 AS tall
FROM t2) AS b
ON a.id = b.id
WHERE b.tall IS NOT NULL;

DROP table t1, t2;

# ISSUE: reset_shared_info failed to set m_prebuilt->index

CREATE TABLE employees (
ID INT PRIMARY KEY,
NAME VARCHAR(100),
MANAGER_ID INT,
INDEX (MANAGER_ID),
FOREIGN KEY (MANAGER_ID) REFERENCES employees(ID)
);
INSERT INTO employees VALUES
(333, "Yasmina", NULL),
(198, "John", 333),
(692, "Tarek", 333),
(29, "Pedro", 198),
(4610, "Sarah", 29),
(72, "Pierre", 29),
(123, "Adil", 692);
ANALYZE TABLE employees;

SET @save_big_tables = @@big_tables;
SET big_tables = 1;

let $query = WITH RECURSIVE employees_extended(ID, NAME, PATH)
AS
(
SELECT ID, NAME, CAST(ID AS CHAR(200))
FROM employees
WHERE MANAGER_ID IS NULL
UNION ALL
SELECT S.ID, S.NAME, CONCAT(M.PATH, ",", S.ID)
FROM employees_extended M STRAIGHT_JOIN employees S ON M.ID=S.MANAGER_ID
),
JOHN_ID AS (SELECT ID FROM employees WHERE NAME='John')
SELECT e.* FROM employees_extended e, JOHN_ID
WHERE FIND_IN_SET(JOHN_ID.ID,
PATH)
AND e.ID<>JOHN_ID.ID;

--replace_regex $elide_costs_and_rows
eval EXPLAIN FORMAT=tree $query;
eval $query;

SET @@big_tables = @save_big_tables;
DROP table employees;

--echo #The first_inner_table of Item_view_ref is one derived table. While the previous
--echo #function "find_table_in_local_list" only checks the NO_TMP_TABLE, which leads to
--echo #find first_inner_table failed.
SET @save_optimizer_switch = @@optimizer_switch;
SET optimizer_switch='subquery_to_derived=on,block_nested_loop=off';
CREATE TABLE t1(a INT);
CREATE TABLE t2(a INT);
INSERT INTO t1 VALUES (1),(2),(3),(4);
INSERT INTO t2 VALUES (1),(2);
CREATE TABLE t0 AS SELECT * FROM t1;
CREATE TABLE t3(a INT, b INT);
INSERT INTO t3 VALUES (1,3), (2,3);
ANALYZE TABLE t1, t2, t0, t3;

let query = SELECT /*+NO_BNL()*/ (t2.a + derived_1_0.sum_plus_cnt) AS cnt
FROM t2
     LEFT JOIN (SELECT (derived_2_0.tmp_aggr_1 + derived_2_1.count_a) AS sum_plus_cnt
                FROM (SELECT STRAIGHT_JOIN SUM(t1.a) AS tmp_aggr_1 from t1) derived_2_0
                LEFT JOIN (SELECT COUNT(t1.a) AS count_a from t1) derived_2_1
                ON TRUE) derived_1_0
     ON TRUE;
--replace_regex $elide_costs_and_rows
eval EXPLAIN FORMAT=tree $query;
eval $query;

DROP TABLE t0, t1, t2, t3;
SET @@optimizer_switch=@save_optimizer_switch;

--echo BUG20211111900485 mysqld coredump while running hybrid query test model

CREATE TABLE `t1` (
  `C_KEY` int NOT NULL AUTO_INCREMENT,
  `C_TIME` time DEFAULT NULL,
  `C_DATETIME` datetime DEFAULT NULL,
  `C_TIMESTAMP` timestamp NULL DEFAULT NULL,
  `C_INT_ID` int DEFAULT NULL,
  `C_UINT_ID` int unsigned DEFAULT NULL,
  `C_BIGINT_ID` bigint DEFAULT NULL,
  `C_UBIGINT_ID` bigint unsigned DEFAULT NULL,
  `C_TINYINT_ID` tinyint DEFAULT NULL,
  `C_UTINYINT_ID` tinyint unsigned DEFAULT NULL,
  `C_SMAILLINT_ID` smallint DEFAULT NULL,
  `C_USMALLINT_ID` smallint unsigned DEFAULT NULL,
  `C_MEDIUMINT_ID` mediumint DEFAULT NULL,
  `C_UMEDIUMINT_ID` mediumint unsigned DEFAULT NULL,
  `C_DOUBLE` double DEFAULT NULL,
  `C_DECIMAL` decimal(65,30) DEFAULT NULL,
  `C_UDECIMAL` decimal(65,30) DEFAULT NULL,
  `C_CHARTWO` char(2) DEFAULT NULL,
  `C_VARCHARTWN` varchar(20) NOT NULL,
  `C_VARCHARS` varchar(64) NOT NULL,
  `C_NUMERIC` decimal(28,10) DEFAULT NULL,
  `C_REAL` double NOT NULL,
  `C_FLOAT` float NOT NULL,
  `C_BOOLEAN` tinyint NOT NULL,
  `C_DATE` date NOT NULL,
  `C_VCHAR` varchar(1000) DEFAULT NULL,
  `C_TEXT` text,
  `C_BLOB` blob,
  `C_TINYTEXT` tinytext,
  `C_MEDIUMBLOB` mediumblob,
  `C_LONGBLOB` longblob,
  `C_PART_ID` int DEFAULT NULL,
  PRIMARY KEY (`C_KEY`)
);

create view v1 as select * from t1;
let $query=
select /*+ no_merge(v1) */  C_VARCHARTWN from v1 order by C_VARCHARTWN limit 5;
--replace_regex $elide_costs_and_rows
eval explain format=tree $query;
eval $query;
drop view v1;
drop table t1;

