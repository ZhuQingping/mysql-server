explain
select
   1 as c3
from
  (select
        mod((select 1 from test.v1 order by 1 limit 1), ref_1.c_id)
        as c2
   from
          test.v1 as ref_0
          join
            test.v2 as ref_1
          join test.t1 as ref_2
            on (true)
          on (ref_0.c1 = ref_1.c_credit )
 ) as subq_0;

drop table t1;
drop view v1,v2;

