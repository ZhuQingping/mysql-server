# Verify M11-B PQWR leader decode adapter smoke. The visible DOP2 fullscan gate
# may also launch normal row-stream workers.

--source include/have_innodb_16k.inc

CREATE TABLE pq_commercial_worker_result_adapter_t (
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO pq_commercial_worker_result_adapter_t VALUES
  (1, 10), (2, 20), (3, 30);

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;

SET @worker_result_rows_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_result_smoke_rows');
SET @worker_result_finishes_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_result_smoke_finishes');
SET @worker_result_errors_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_result_smoke_errors');
SET @worker_result_workers_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_result_smoke_workers');
SET @raw_field_rows_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_result_raw_field_smoke_rows');
SET @raw_field_fields_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_result_raw_field_smoke_fields');
SET @raw_field_bytes_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_result_raw_field_smoke_bytes');
SET @raw_field_normal_rejects_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_result_raw_field_smoke_normal_rejects');
SET @raw_field_invalid_rejects_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_result_raw_field_smoke_invalid_rejects');
SET @workers_launched_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_workers_launched');

SET @old_debug=@@session.debug;
SET SESSION debug="+d,pq_exchange_worker_result_smoke";
SELECT id, v FROM pq_commercial_worker_result_adapter_t WHERE v >= 0;
SET SESSION debug=@old_debug;

SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_result_smoke_rows') -
  @worker_result_rows_before) >= 8 AS worker_result_rows_delta_at_least_8;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_result_smoke_finishes') -
  @worker_result_finishes_before) >= 7 AS worker_result_finishes_delta_at_least_7;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_result_smoke_errors') -
  @worker_result_errors_before) >= 1 AS worker_result_errors_delta_at_least_1;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_result_smoke_workers') -
  @worker_result_workers_before) = 1 AS worker_result_workers_delta_is_1;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_result_raw_field_smoke_rows') -
  @raw_field_rows_before) = 1 AS raw_field_rows_delta_is_1;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_result_raw_field_smoke_fields') -
  @raw_field_fields_before) = 3 AS raw_field_fields_delta_is_3;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_worker_result_raw_field_smoke_bytes') -
  @raw_field_bytes_before) = 10 AS raw_field_bytes_delta_is_10;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_result_raw_field_smoke_normal_rejects') -
  @raw_field_normal_rejects_before) = 1 AS raw_field_normal_rejects_delta_is_1;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME =
         'Parallel_worker_result_raw_field_smoke_invalid_rejects') -
  @raw_field_invalid_rejects_before) = 2 AS raw_field_invalid_rejects_delta_is_2;
SELECT (
  (SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
   WHERE VARIABLE_NAME = 'Parallel_workers_launched') -
  @workers_launched_before) AS workers_launched_delta;

SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
SET SESSION parallel_default_dop=4;

DROP TABLE pq_commercial_worker_result_adapter_t;
