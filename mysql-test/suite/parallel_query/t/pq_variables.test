--source include/not_valgrind.inc
--source include/pq_test.inc
--source include/have_debug.inc

set @saved_force_parallel_execute = @@force_parallel_execute;
set @saved_parallel_cost_threshold = @@parallel_cost_threshold;
set @saved_parallel_default_dop = @@parallel_default_dop;
set @saved_parallel_max_threads = @@parallel_max_threads;

create table t1(id int);
insert into t1 select 1;
create table t2(id int);
insert into t2 select 1;

let $loop=10;
while($loop)
{
  eval insert into t1 select id + 1 from t1;
  dec $loop;
}
analyze table t1,t2;

set session force_parallel_execute = true;

--echo ### test parallel_cost_threadhold

set session parallel_cost_threshold = 0;
explain select sum(id) from t1;

set session parallel_cost_threshold = 99999;
explain select sum(id) from t1;


--echo ### test parallel_default_dop
set session parallel_cost_threshold = 0;

set session parallel_default_dop=10;
explain select sum(id) from t1;

set session parallel_default_dop=2;
explain select sum(id) from t1;

set session parallel_default_dop=0;
explain select sum(id) from t1;

set session pq_msg_queue_size=1048578;
select sum(id) from t1;

set session pq_msg_queue_size=10000000;
select avg(id) from t1;

set session pq_msg_queue_spin_lock=101;
select * from t1 where id < 20 limit 100;

set session pq_msg_queue_spin_lock=10000;
select * from t1 where id < 20 limit 100;

--echo ### test parallel hint
set session parallel_default_dop=4;

set session force_parallel_execute = false;

explain select sum(id) from t1;
explain select/*+ PQ() */ sum(id) from t1;
explain select/*+ PQ(10) */ sum(id) from t1;

explain select/*+ PQ(t1) */ * from t1,t2;
explain select/*+ PQ(t1 8) */ * from t1,t2;

alter table t1 add key id_idex(id);
alter table t2 add key id_idex(id);
explain select /*+PQ(t1)*/ t2.* from t1,t2 where t1.id=t2.id;
explain select/*+ PQ(@sub1) SEMIJOIN(@sub1 FIRSTMATCH) */ * from t1 where id in (select /*+ QB_NAME(sub1) */ id from t2);
explain select/*+ PQ(@sub1 16) SEMIJOIN(@sub1 FIRSTMATCH) */ * from t1 where id in (select /*+ QB_NAME(sub1) */ id from t2);

# Test incorrect pq hint degree
explain select /*+PQ(t1 0)*/ t2.* from t1,t2 where t1.id=t2.id;
explain select/*+ PQ(@sub1 0) SEMIJOIN(@sub1 FIRSTMATCH) */ * from t1 where id in (select /*+ QB_NAME(sub1) */ id from t2);
explain select/*+ PQ(@sub1 t2 0) SEMIJOIN(@sub1 FIRSTMATCH) */ * from t1 where id in (select /*+ QB_NAME(sub1) */ id from t2);

--echo ### test force_parallel query
set session parallel_default_dop=4;

set session force_parallel_execute = false;
explain select sum(id) from t1;

set session force_parallel_execute = true;
explain select sum(id) from t1;


--echo ### test parallel max_threads
set session force_parallel_execute = true;
set session parallel_default_dop=4;
SELECT VARIABLE_VALUE INTO @counter FROM performance_schema.session_status WHERE VARIABLE_NAME="PQ_threads_refused";

set global parallel_max_threads = 64;
explain select/*+ PQ(32) */ sum(id) from t1;

set global parallel_max_threads = 16;
explain select/*+ PQ(32) */ sum(id) from t1;
SELECT VARIABLE_VALUE-@counter FROM performance_schema.session_status WHERE VARIABLE_NAME="PQ_threads_refused";

set global parallel_max_threads = 64;
explain select/*+ NO_PQ */ sum(id) from t1;

SELECT /*+ NO_PQ NO_PQ */ 1;
SELECT /*+ NO_PQ PQ() */ 1;
SELECT /*+ PQ() NO_PQ */ 1;

--echo ### test parallel queue_timeout

set global parallel_max_threads=8;
set global debug_pq_worker_stall = true;

connect (con1, localhost, root);
connect (con2, localhost, root);
connect (con3, localhost, root);

--connection con1
--send select/*+ PQ(8) */ sum(id) from t1;

--connection default

--sleep 1
show status like "PQ_threads_running";

--connection con2
--echo ----con2 wait parallel threads 5s-----
set session parallel_queue_timeout=5000;  # 5000ms
--send explain select/*+ PQ(8) */ sum(id) from t1;

--connection con3
--echo ----con3 no wait for parallel threads-----
set session parallel_queue_timeout=0;  # 0ms
--send explain select/*+ PQ(8) */ sum(id) from t1;

--connection default
set global debug_pq_worker_stall = false;

--connection con1
--reap

--connection con2
--echo ----con2 parallel query-----
--reap

--connection con3
--echo ----con3 no parallel query-----
--reap

--connection default
set global parallel_max_threads=64;
set global parallel_default_dop=4;

--connection con1
set session parallel_default_dop=1025;
set session parallel_default_dop=1024;
set session parallel_default_dop=65;
set session parallel_default_dop=64;
set session parallel_default_dop=6;
set global parallel_max_threads=1025;

--connection con2
set session parallel_default_dop=1000;
set session parallel_default_dop=1024;
set session parallel_default_dop=1025;
set session parallel_default_dop=1026;

--connection con1
set @saved_pq_master_enable = @@pq_master_enable;
--error ER_GLOBAL_VARIABLE
set session pq_master_enable=on;
--error ER_WRONG_VALUE_FOR_VAR
set global pq_master_enable=-1;
set global pq_master_enable=off;
set global pq_master_enable=on;
set global pq_master_enable = @saved_pq_master_enable;

disconnect con1;
disconnect con2;
disconnect con3;

--connection default
select VARIABLE_VALUE>1 as pq_executed from performance_schema.global_status where VARIABLE_NAME="PQ_stmt_executed";

set session parallel_default_dop = @saved_parallel_default_dop;
set global parallel_max_threads = @saved_parallel_max_threads;
set session parallel_cost_threshold = @saved_parallel_cost_threshold;
set session force_parallel_execute = @saved_force_parallel_execute;

drop table t1;
drop table t2;
