# Test: pq_stats
# Verify that PQ status variables are visible and track PQ usage.
# Status variables track visible PQ execution, fallback, worker, and row deltas.

--source include/have_innodb_16k.inc

--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings

CREATE TABLE t1 (id INT PRIMARY KEY, val INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,10),(2,20),(3,30),(4,40),(5,50);

# 1. Verify PQ status variables exist.
SELECT COUNT(*) FROM (
  SELECT variable_name FROM performance_schema.global_status
  WHERE variable_name LIKE 'Parallel%'
) AS pq_vars;

# 2. Verify all PQ status variable names are present.
SELECT variable_name FROM performance_schema.global_status
  WHERE variable_name LIKE 'Parallel%'
  ORDER BY variable_name;

# 3. Verify status values are numeric (non-negative)
SELECT COUNT(*) AS numeric_parallel_status_vars
  FROM performance_schema.global_status
  WHERE variable_name LIKE 'Parallel%'
    AND variable_value REGEXP '^[0-9]+$';

SET @pq_executed_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_executed');
SET @pq_fallback_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SET @pq_rows_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_rows_scanned');
SET @pq_workers_before = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_workers_launched');

# 4. Enable PQ for the execution counter checks below.
SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;

# EXPLAIN must not create iterators or increment execution fallback counters.
--replace_column 10 ROWS
EXPLAIN SELECT * FROM t1;
SET @pq_fallback_after_explain = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SELECT @pq_fallback_after_explain - @pq_fallback_before AS fallback_delta;

# Locking reads are ineligible during real execution. EXPLAIN ignores locking
# clauses during contextualization, so verify the execution path via counters.
SELECT * FROM t1 FOR UPDATE;
SELECT * FROM t1 LOCK IN SHARE MODE;
SELECT * FROM t1 FOR SHARE;
SET @pq_fallback_after_locking = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SELECT @pq_fallback_after_locking - @pq_fallback_before AS fallback_delta;

SELECT * FROM t1;

# 5. Default fullscan execution should not increment fallback.
SET @pq_fallback_after_scan = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SELECT @pq_fallback_after_scan - @pq_fallback_before AS fallback_delta;

# 6. Run another PQ-eligible query (SUM aggregate, implicit grouping).
SELECT SUM(val) FROM t1;

# 7. SUM aggregate should not increment fallback.
SET @pq_fallback_after_sum = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SELECT @pq_fallback_after_sum - @pq_fallback_before AS fallback_delta;

# 8. Run a PQ-ineligible query (GROUP BY - should NOT increment fallback).
SELECT val, COUNT(*) FROM t1 GROUP BY val;

# 9. Verify fallback counter did NOT change for ineligible query
SET @pq_fallback_after_group = (
  SELECT CAST(variable_value AS UNSIGNED)
    FROM performance_schema.global_status
    WHERE variable_name = 'Parallel_queries_fallback');
SELECT @pq_fallback_after_group - @pq_fallback_before AS fallback_delta;

# 10. Verify final deltas are stable regardless of previous tests
SELECT
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_executed') - @pq_executed_before
    AS executed_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_queries_fallback') - @pq_fallback_before
    AS fallback_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_rows_scanned') - @pq_rows_before
    AS rows_delta,
  (SELECT CAST(variable_value AS UNSIGNED) FROM performance_schema.global_status
   WHERE variable_name = 'Parallel_workers_launched') - @pq_workers_before
    AS workers_delta;

# Reset
SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;

DROP TABLE t1;
