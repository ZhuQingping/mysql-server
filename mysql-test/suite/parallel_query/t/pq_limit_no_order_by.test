--source include/pq_test.inc

--disable_warnings
DROP DATABASE IF EXISTS limit_test_db;
--enable_warnings
CREATE DATABASE limit_test_db;
USE limit_test_db;

CREATE TABLE t1 (
  id INT PRIMARY KEY AUTO_INCREMENT,
  a INT,
  b VARCHAR(20),
  c DATE
) ENGINE=InnoDB;

CREATE TABLE t2 (
  id INT PRIMARY KEY AUTO_INCREMENT,
  t1_id INT,
  d DECIMAL(10,2),
  e DATETIME,
  INDEX (t1_id)
) ENGINE=InnoDB;

INSERT INTO t1 (a, b, c) VALUES
(1, 'apple', '2023-01-01'),
(2, 'banana', '2023-01-02'),
(3, 'cherry', '2023-01-03'),
(4, 'date', '2023-01-04'),
(5, 'elderberry', '2023-01-05'),
(6, 'fig', '2023-01-06'),
(7, 'grape', '2023-01-07'),
(8, 'honeydew', '2023-01-08'),
(9, 'kiwi', '2023-01-09'),
(10, 'lemon', '2023-01-10');

INSERT INTO t2 (t1_id, d, e) VALUES
(1, 10.5, '2023-01-01 10:00:00'),
(2, 20.3, '2023-01-02 11:00:00'),
(3, 15.7, '2023-01-03 12:00:00'),
(1, 5.2, '2023-01-01 14:00:00'),
(4, 30.1, '2023-01-04 13:00:00'),
(5, 25.9, '2023-01-05 14:00:00'),
(2, 18.6, '2023-01-02 15:00:00'),
(6, 12.4, '2023-01-06 16:00:00'),
(7, 8.7, '2023-01-07 17:00:00'),
(8, 22.0, '2023-01-08 18:00:00');

ANALYZE TABLE t1,t2;

--echo #
--echo # 1. LIMIT in the main query
--echo #

SET optimizer_trace="enabled=on";
EXPLAIN SELECT * FROM t1 LIMIT 3;
SELECT json_extract(trace,"$.steps[*].not_apply_pq_plan") FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE;
SET optimizer_trace="enabled=off";

EXPLAIN SELECT * FROM t1 ORDER BY a DESC LIMIT 3;

--echo #
--echo # 2. LIMIT in the derived table
--echo #

EXPLAIN SELECT * FROM (
  SELECT * FROM t2 LIMIT 4
) AS derived;

EXPLAIN SELECT * FROM (
  SELECT * FROM t2 ORDER BY d DESC LIMIT 4
) AS derived;

--echo #
--echo # 3. LIMIT in the subquery
--echo #

# Scalar subquery
EXPLAIN SELECT id, a, 
  (SELECT d FROM t2 WHERE t1_id = t1.id LIMIT 1) AS first_d
FROM t1;

EXPLAIN SELECT id, a, 
  (SELECT d FROM t2 WHERE t1_id = t1.id ORDER BY d DESC LIMIT 1) AS max_d
FROM t1;

# IN subquery
EXPLAIN SELECT * FROM t1 
WHERE id IN (SELECT t1_id FROM (SELECT t1_id FROM t2 LIMIT 5) AS tmp);

EXPLAIN SELECT * FROM t1 
WHERE id IN (SELECT t1_id FROM (SELECT t1_id FROM t2 ORDER BY d DESC LIMIT 5) AS tmp);

# EXISTS subquery
EXPLAIN SELECT * FROM t1 
WHERE EXISTS (SELECT 1 FROM t2 WHERE t1_id = t1.id LIMIT 1);

EXPLAIN SELECT * FROM t1 
WHERE EXISTS (SELECT 1 FROM t2 WHERE t1_id = t1.id ORDER BY d DESC LIMIT 1);

--echo #
--echo # 4. LIMIT in the JOIN query block
--echo #

# Nested Loop Join
EXPLAIN SELECT /*+ NO_BNL(t1,t2) */ t1.id, t1.b, t2.d 
FROM t1 JOIN t2 ON t1.id = t2.t1_id
LIMIT 3;

EXPLAIN SELECT /*+ NO_BNL(t1,t2) */ t1.id, t1.b, t2.d 
FROM t1 JOIN t2 ON t1.id = t2.t1_id
ORDER BY t2.d DESC
LIMIT 3;

# Hash Join
SET @saved_pq_support_features_switch = @@global.pq_support_features_switch;
SET GLOBAL pq_support_features_switch='hash_join_spill_to_disk=on';

EXPLAIN SELECT t1.id, t1.b, t2.d 
FROM t1 JOIN t2 ON t1.c = CAST(t2.e AS DATE)
LIMIT 4;

EXPLAIN SELECT t1.id, t1.b, t2.d 
FROM t1 JOIN t2 ON t1.c = CAST(t2.e AS DATE)
ORDER BY t1.a ASC, t2.d DESC
LIMIT 4;

SET global pq_support_features_switch = @saved_pq_support_features_switch;

# Left Join
EXPLAIN SELECT t1.id, t1.b, t2.d 
FROM t1 LEFT JOIN t2 ON t1.id = t2.t1_id
LIMIT 5;

EXPLAIN SELECT t1.id, t1.b, t2.d 
FROM t1 LEFT JOIN t2 ON t1.id = t2.t1_id
ORDER BY t1.id DESC, t2.d ASC
LIMIT 5;

--echo #
--echo # 5. LIMIT in aggregate function queries
--echo #

# NO GROUP BY
EXPLAIN SELECT COUNT(*) AS cnt, AVG(d) AS avg_d FROM t2 LIMIT 1;

EXPLAIN SELECT COUNT(*) AS cnt, AVG(d) AS avg_d 
FROM t2 
ORDER BY cnt DESC
LIMIT 1;

# HAS GROUP BY
EXPLAIN SELECT t1_id, SUM(d) AS total_d 
FROM t2 
GROUP BY t1_id
LIMIT 3;

EXPLAIN SELECT t1_id, SUM(d) AS total_d 
FROM t2 
GROUP BY t1_id
ORDER BY total_d DESC
LIMIT 3;

# The ordered-index GROUP BY RBO must reject PQ when its scan estimate is
# worse than the serial plan.  Keep this assertion independent from EXPLAIN
# formatting so all build modes exercise the same optimizer decision.
--disable_query_log
--disable_result_log
SET optimizer_trace="enabled=on";
EXPLAIN SELECT t1_id, SUM(d) AS total_d
FROM t2
GROUP BY t1_id
ORDER BY total_d DESC
LIMIT 3;
let $pq_scan_records = `SELECT trace LIKE '%few records in each group%' FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE`;
SET optimizer_trace="enabled=off";
--enable_result_log
--enable_query_log
if ($pq_scan_records != 1)
{
  --die ordered-index GROUP BY RBO must reject PQ with SCAN_RECORDS
}

--echo #
--echo # 6. LIMIT in UNION queries
--echo #
# Global LIMIT
EXPLAIN (SELECT id, a FROM t1 WHERE a < 5)
UNION
(SELECT id, a FROM t1 WHERE a > 7)
LIMIT 3;

EXPLAIN (SELECT id, a FROM t1 WHERE a < 5)
UNION
(SELECT id, a FROM t1 WHERE a > 7)
ORDER BY a DESC
LIMIT 3;

# Subquery LIMIT
EXPLAIN (SELECT id, a FROM t1 WHERE a < 5 LIMIT 2)
UNION
(SELECT id, a FROM t1 WHERE a > 7 LIMIT 2);

EXPLAIN (SELECT id, a FROM t1 WHERE a < 5 ORDER BY a DESC LIMIT 2)
UNION
(SELECT id, a FROM t1 WHERE a > 7 ORDER BY a ASC LIMIT 2);

--echo #
--echo # 7. Complex nested scenarios
--echo #
# Multi-layer nesting
EXPLAIN SELECT * FROM (
  SELECT t1_id, AVG(d) AS avg_d 
  FROM (
    SELECT * FROM t2 LIMIT 8
  ) AS inner_derived
  GROUP BY t1_id
  LIMIT 3
) AS outer_derived;

EXPLAIN SELECT * FROM (
  SELECT t1_id, AVG(d) AS avg_d 
  FROM (
    SELECT * FROM t2 ORDER BY e ASC LIMIT 8
  ) AS inner_derived
  GROUP BY t1_id
  ORDER BY avg_d DESC
  LIMIT 3
) AS outer_derived
ORDER BY t1_id;

# JOIN + Subquery + aggregate
EXPLAIN SELECT t1.id, t1.b, sub.max_d
FROM t1
JOIN (
  SELECT t1_id, MAX(d) AS max_d 
  FROM t2 
  GROUP BY t1_id
  LIMIT 5
) AS sub ON t1.id = sub.t1_id
LIMIT 3;

EXPLAIN SELECT t1.id, t1.b, sub.max_d
FROM t1
JOIN (
  SELECT t1_id, MAX(d) AS max_d 
  FROM t2 
  GROUP BY t1_id
  ORDER BY max_d DESC
  LIMIT 5
) AS sub ON t1.id = sub.t1_id
ORDER BY t1.b
LIMIT 3;

--echo #
--echo # 8. OFFSET clause
--echo #
EXPLAIN SELECT * FROM t1 LIMIT 3 OFFSET 2;

EXPLAIN SELECT * FROM t1 ORDER BY a DESC LIMIT 3 OFFSET 2;

EXPLAIN SELECT id, a, 
  (SELECT d FROM t2 WHERE t1_id = t1.id LIMIT 1 OFFSET 1) AS second_max_d
FROM t1;

EXPLAIN SELECT id, a, 
  (SELECT d FROM t2 WHERE t1_id = t1.id ORDER BY d DESC LIMIT 1 OFFSET 1) AS second_max_d
FROM t1;

--echo #
--echo # 9. empty result
--echo #

EXPLAIN SELECT * FROM t1 WHERE a > 100 LIMIT 3;

SELECT * FROM t1 WHERE a > 100 LIMIT 3;

EXPLAIN SELECT * FROM t1 WHERE a > 100 ORDER BY a DESC LIMIT 3;

SELECT * FROM t1 WHERE a > 100 ORDER BY a DESC LIMIT 3;

--echo #
--echo # 10. const order by
--echo #
EXPLAIN SELECT * FROM t1 ORDER BY NULL LIMIT 3;

EXPLAIN SELECT /*+ SET_VAR(parallel_limit_no_order_by = on) */ * FROM t1 ORDER BY NULL LIMIT 3;

EXPLAIN SELECT * FROM t1 WHERE a = 8 ORDER BY a DESC LIMIT 3;

EXPLAIN SELECT /*+ SET_VAR(parallel_limit_no_order_by = on) */ * FROM t1 WHERE a = 8 ORDER BY a DESC LIMIT 3;

--echo #
--echo # 11. ORDER BY with the same columns as DISTINCT/GROUP BY
--echo #

EXPLAIN SELECT c, COUNT(*) FROM t1 GROUP BY c ORDER BY c LIMIT 1;

EXPLAIN SELECT DISTINCT c FROM t1 ORDER BY c LIMIT 1;

--echo #
--echo # 12. internal LIMIT
--echo #
EXPLAIN SELECT 1 FROM dual
WHERE EXISTS (SELECT * FROM t1 AS it);

EXPLAIN SELECT 1 as a FROM dual
WHERE NOT EXISTS (SELECT * FROM t1 AS it);

DROP DATABASE limit_test_db;
