--source include/pq_test.inc
--source include/have_debug.inc
--source include/elide_costs.inc

create database pq_test;
use pq_test;

CREATE TABLE t1(f1 INT, f2 INT);
INSERT INTO t1 VALUES
(1,1),(2,2),(3,3);

CREATE TABLE t2(f1 INT NOT NULL, f2 INT NOT NULL, f3 CHAR(200), KEY(f1, f2));
INSERT INTO t2 VALUES
(1,1, 'qwerty'),(1,2, 'qwerty'),(1,3, 'qwerty'),
(2,1, 'qwerty'),(2,2, 'qwerty'),(2,3, 'qwerty'), (2,4, 'qwerty'),(2,5, 'qwerty'),
(3,1, 'qwerty'),(3,4, 'qwerty'),
(4,1, 'qwerty'),(4,2, 'qwerty'),(4,3, 'qwerty'), (4,4, 'qwerty'),
(1,1, 'qwerty'),(1,2, 'qwerty'),(1,3, 'qwerty'),
(2,1, 'qwerty'),(2,2, 'qwerty'),(2,3, 'qwerty'), (2,4, 'qwerty'),(2,5, 'qwerty'),
(3,1, 'qwerty'),(3,4, 'qwerty'),
(4,1, 'qwerty'),(4,2, 'qwerty'),(4,3, 'qwerty'), (4,4, 'qwerty');

ANALYZE TABLE t1;
ANALYZE TABLE t2;

explain SELECT /*+NO_PQ*/ t2.f1, t2.f2, t2.f3 FROM t1,t2 WHERE t1.f1=t2.f1 AND t2.f2 BETWEEN t1.f1 and t1.f2 and t2.f2 + 1 >= t1.f1 + 1;
SELECT /*+NO_PQ*/ t2.f1, t2.f2, t2.f3 FROM t1,t2 WHERE t1.f1=t2.f1 AND t2.f2 BETWEEN t1.f1 and t1.f2 and t2.f2 + 1 >= t1.f1 + 1;

explain SELECT t2.f1, t2.f2, t2.f3 FROM t1,t2 WHERE t1.f1=t2.f1 AND t2.f2 BETWEEN t1.f1 and t1.f2 and t2.f2 + 1 >= t1.f1 + 1;
SELECT t2.f1, t2.f2, t2.f3 FROM t1,t2 WHERE t1.f1=t2.f1 AND t2.f2 BETWEEN t1.f1 and t1.f2 and t2.f2 + 1 >= t1.f1 + 1;

DROP TABLE t1, t2;
CREATE TABLE t1 (
pk int NOT NULL,
col_int_key int NOT NULL,
col_varchar_nokey varchar(1) NOT NULL,
col_varchar_key varchar(1) NOT NULL,
PRIMARY KEY(pk),
KEY col_int_key(col_int_key),
KEY col_varchar_key(col_varchar_key, col_int_key)
) charset utf8mb4 engine=innodb;
INSERT INTO t1 VALUES
(1,7,'a','a'),
(2,0,'v','v'),
(3,9,'c','c'),
(4,3,'m','m'),
(5,2,'a','a'),
(6,1,'d','d'),
(7,8,'y','y'),
(8,6,'t','t'),
(11,7,'a','x'),
(12,0,'v','v'),
(13,9,'c','c'),
(14,3,'m','m'),
(15,2,'a','x'),
(16,1,'d','d'),
(17,8,'y','y'),
(18,6,'t','u'),
(19,6,'t','u');
CREATE TABLE t2 (
pk int NOT NULL,
col_int_key int NOT NULL,
col_varchar_key varchar(1) NOT NULL,
PRIMARY KEY(pk),
KEY col_varchar_key(col_varchar_key, col_int_key)
) charset utf8mb4 engine=innodb;
INSERT INTO t2(pk,col_int_key,col_varchar_key) VALUES
(8,7,'c'),
(11,4,'l'),
(12,7,'b'),
(13,0,'c'),
(14,2,'i'),
(15,9,'h'),
(16,4,'q'),
(17,1,'m'),
(18,9,'b'),
(19,2,'e'),
(20,1,'c'),
(21,7,'z'),
(22,4,'l'),
(23,7,'z'),
(24,0,'c'),
(25,2,'i'),
(26,9,'h'),
(27,4,'q'),
(28,0,'a'),
(29,1,'d');

set optimizer_switch='semijoin=on,loosescan=on,duplicateweedout=off,materialization=off'; 
EXPLAIN SELECT outr.col_varchar_key AS x, outr.pk AS y FROM t1 AS outr WHERE outr.col_varchar_key IN (SELECT innr.col_varchar_key FROM t2 AS innr WHERE innr.col_varchar_key = 'a' OR innr.pk = 8) AND outr.col_varchar_nokey < 't' ORDER BY outr.col_varchar_key, outr.pk;

SELECT /*NO_PQ */ outr.col_varchar_key AS x, outr.pk AS y FROM t1 AS outr WHERE outr.col_varchar_key IN (SELECT innr.col_varchar_key FROM t2 AS innr WHERE innr.col_varchar_key = 'a' OR innr.pk = 8) AND outr.col_varchar_nokey < 't' ORDER BY outr.col_varchar_key, outr.pk;

SELECT outr.col_varchar_key AS x, outr.pk AS y FROM t1 AS outr WHERE outr.col_varchar_key IN (SELECT innr.col_varchar_key FROM t2 AS innr WHERE innr.col_varchar_key = 'a' OR innr.pk = 8) AND outr.col_varchar_nokey < 't' ORDER BY outr.col_varchar_key, outr.pk;

DROP table t1, t2;

--echo In depend-ref join, PQ_single_queue may be generated by one PQ worker, which uses
--echo its MEM_ROOT to allocate space. However, other workers can also utilize this
--echo queue to fetch ctx. Once the worker that generated this queue has finished and
--echo released its MEM_ROOT, other workers can read invalid node from queue; and thus
--echo leading to the crash in BUG2022021400279.

CREATE TABLE `t1` (
  `a` int NOT NULL AUTO_INCREMENT,
  `b` int DEFAULT NULL,
  PRIMARY KEY (`a`)
) ENGINE=InnoDB AUTO_INCREMENT=65537 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY HASH (`a`) PARTITIONS 8 */;

CREATE TABLE `t2` (
  `c1` int DEFAULT NULL,
  KEY `idx` (`c1`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

insert into t1(b) values (1);
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t1(b) select b from t1;
insert into t2(c1) select a from t1;
analyze table t1, t2;

--replace_regex $elide_costs_and_rows
explain format=tree select /*+PQ(t2) */ t1.b from t1 join t2 on t1.a = t2.c1 limit 100, 10;
select /*+PQ(t2) */ t1.b from t1 join t2 on t1.a = t2.c1 limit 100, 10;
drop table t1, t2;

#BUG2023042200006

CREATE TABLE t0 (c1 DATETIME);
CREATE TABLE t1 (c0 BIGINT);
SELECT 1 FROM t0 JOIN t1 ON CAST(X'6F' AS CHAR) = t1.c0 WHERE t0.c1 BETWEEN t1.c0 AND utc_timestamp();

drop table t0;
drop table t1;

drop database pq_test;
