          'Parallel_worker_execute_iterator_smoke_output_fields_cloned') -
     @output_fields_cloned_before) >= 1
       AS worker_execute_output_fields_cloned,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_blocked_result_send') -
     @blocked_result_send_before) = 0 AS worker_execute_not_blocked_result_send,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_result_row_sent') -
     @result_row_sent_before) >= 1 AS worker_execute_result_row_sent,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_result_eof_sent') -
     @result_eof_sent_before) >= 1 AS worker_execute_result_eof_sent,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_result_restored') -
     @result_restored_before) >= 1 AS worker_execute_result_restored,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_blocked_ownership') -
     @blocked_ownership_before) = 0 AS worker_execute_not_blocked_ownership,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_blocked_execute') -
     @blocked_execute_before) >= 1 AS worker_execute_blocked_execute,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_success') -
     @success_before) = 0 AS worker_execute_not_success;

SET SESSION parallel_query=OFF;
SET SESSION parallel_cost_threshold=10000;
SET SESSION parallel_default_dop=4;

DROP TABLE pq_worker_execute_t;
