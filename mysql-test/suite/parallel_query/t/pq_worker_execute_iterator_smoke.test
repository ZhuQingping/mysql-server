          'Parallel_worker_execute_iterator_smoke_iterator_constructed') -
     @iterator_constructed_before) >= 1 AS worker_execute_iterator_constructed,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_root_attached') -
     @root_attached_before) >= 1 AS worker_execute_root_attached,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
