        'Parallel_worker_execute_iterator_smoke_blocked_execute');
SET @success_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_execute_iterator_smoke_success');

SELECT id, v FROM pq_worker_execute_t WHERE v >= 0;

SELECT
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_attempts') -
     @attempts_before) >= 1 AS worker_execute_attempted,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_blocked_clone') -
     @blocked_clone_before) = 0 AS worker_execute_not_blocked_clone,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_blocked_readinfo') -
     @blocked_readinfo_before) = 0 AS worker_execute_not_blocked_readinfo,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_blocked_worker_open') -
     @blocked_worker_open_before) = 0 AS worker_execute_not_blocked_worker_open,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_plan_constructed') -
     @plan_constructed_before) >= 1 AS worker_execute_plan_constructed,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME =
          'Parallel_worker_execute_iterator_smoke_plan_cleaned') -
     @plan_cleaned_before) >= 1 AS worker_execute_plan_cleaned,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME = 'Parallel_worker_join_shape_attempts') -
     @join_shape_attempts_before) >= 1 AS worker_join_shape_attempted,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME = 'Parallel_worker_join_shape_success') -
     @join_shape_success_before) >= 1 AS worker_join_shape_success,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME = 'Parallel_worker_join_shape_unsupported') -
     @join_shape_unsupported_before) = 0 AS worker_join_shape_not_unsupported,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME = 'Parallel_worker_qep_tab_skeleton_attempts') -
     @qep_tab_skeleton_attempts_before) >= 1 AS worker_qep_tab_skeleton_attempted,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME = 'Parallel_worker_qep_tab_skeleton_success') -
     @qep_tab_skeleton_success_before) >= 1 AS worker_qep_tab_skeleton_success,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME = 'Parallel_worker_qep_tab_skeleton_unsupported') -
     @qep_tab_skeleton_unsupported_before) = 0
       AS worker_qep_tab_skeleton_not_unsupported,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
    WHERE VARIABLE_NAME = 'Parallel_worker_qep_tab_table_bind_attempts') -
     @qep_tab_table_bind_attempts_before) >= 1
       AS worker_qep_tab_table_bind_attempted,
  ((SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
