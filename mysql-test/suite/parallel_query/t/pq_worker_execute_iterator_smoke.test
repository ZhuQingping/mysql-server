# Verify the guarded worker ExecuteIteratorQuery contract probe.

--source include/have_innodb_16k.inc

CREATE TABLE pq_worker_execute_t (
  id INT PRIMARY KEY,
  v INT
) ENGINE=InnoDB;
INSERT INTO pq_worker_execute_t VALUES (1,10),(2,20),(3,30);

SET SESSION parallel_query=ON;
SET SESSION parallel_cost_threshold=0;
SET SESSION parallel_default_dop=2;

SET @attempts_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME = 'Parallel_worker_execute_iterator_smoke_attempts');
