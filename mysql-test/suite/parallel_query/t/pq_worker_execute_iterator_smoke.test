  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_smoke_blocked_output_fields');
SET @output_fields_cloned_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_smoke_output_fields_cloned');
SET @blocked_result_send_before = (
  SELECT VARIABLE_VALUE + 0 FROM performance_schema.global_status
  WHERE VARIABLE_NAME =
        'Parallel_worker_execute_iterator_smoke_blocked_result_send');
SET @result_row_sent_before = (
