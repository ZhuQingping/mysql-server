--source include/pq_test.inc
--source include/have_debug.inc
--source include/elide_costs.inc

# DBUG-only coverage is split from pq_agg_distinct so that the normal
# COUNT(DISTINCT) PQ coverage runs in Release, Debug, and ASAN builds.
SET @saved_pq_support_features_switch = @@session.pq_support_features_switch;
SET pq_support_features_switch = 'count_distinct=on';
CALL mtr.add_suppression("alloc space in Batch_buffer_slot::get_next_buffer error");

# For distinct in a worker, the temporary tree must not be assumed to be
# wholly in memory.
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1),(2),(3),(4),(5),(6),(7),(8);
INSERT INTO t1 SELECT a+8 FROM t1;
INSERT INTO t1 SELECT a+16 FROM t1;
INSERT INTO t1 SELECT a+32 FROM t1;
INSERT INTO t1 SELECT a+64 FROM t1;
INSERT INTO t1 VALUE(NULL);
set debug="+d,simulate_low_itemsum_ram_limitation";
EXPLAIN SELECT COUNT(DISTINCT a) FROM t1;
SELECT COUNT(DISTINCT a) FROM t1;
SELECT /*+no_pq */ COUNT(DISTINCT a) FROM t1;
set debug="";
DROP TABLE t1;

# DBUG-injected batch-buffer allocation failure must surface as a PQ error.
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    c1 INT,
    c2 INT
);
INSERT INTO t1 (id, c1, c2) VALUES
(1, 10, 100),
(2, 20, 200),
(3, 30, 300);
SET session debug="+d, bat_buf_is_null";
--error ER_PARALLEL_QUERY_ERROR
SELECT COUNT(DISTINCT c1) from t1;
SET session debug="-d, bat_buf_is_null";
DROP TABLE t1;

SET pq_support_features_switch = @saved_pq_support_features_switch;
