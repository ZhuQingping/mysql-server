# Test: pq_commercial_control_sysvars
# Commercial PQ control/queue sysvar visibility and session contract.

--source include/have_innodb_16k.inc

SELECT @@session.force_parallel_execute;
SELECT @@session.parallel_fail_retry;
SELECT @@session.pq_msg_queue_size;
SELECT @@session.pq_msg_queue_spin_lock;
SELECT @@session.innodb_parallel_select_count;
SELECT @@session.pq_hash_join_max_hash_table_refills;
SELECT @@session.op_over_pq_offset_threshold;

SELECT @@global.force_parallel_execute;
SELECT @@global.parallel_fail_retry;
SELECT @@global.pq_msg_queue_size;
SELECT @@global.pq_msg_queue_spin_lock;
SELECT @@global.innodb_parallel_select_count;
SELECT @@global.pq_hash_join_max_hash_table_refills;
SELECT @@global.op_over_pq_offset_threshold;

SET SESSION force_parallel_execute=ON;
SELECT @@session.force_parallel_execute;
SET SESSION force_parallel_execute=OFF;
SELECT @@session.force_parallel_execute;

SET SESSION parallel_fail_retry=OFF;
SELECT @@session.parallel_fail_retry;
SET SESSION parallel_fail_retry=ON;
SELECT @@session.parallel_fail_retry;

SET SESSION pq_msg_queue_size=1048576;
SELECT @@session.pq_msg_queue_size;
SET SESSION pq_msg_queue_size=1073741824;
SELECT @@session.pq_msg_queue_size;

SET SESSION pq_msg_queue_spin_lock=100;
SELECT @@session.pq_msg_queue_spin_lock;
SET SESSION pq_msg_queue_spin_lock=10000;
SELECT @@session.pq_msg_queue_spin_lock;

SET SESSION innodb_parallel_select_count=OFF;
SELECT @@session.innodb_parallel_select_count;
SET SESSION innodb_parallel_select_count=ON;
SELECT @@session.innodb_parallel_select_count;

SET SESSION pq_hash_join_max_hash_table_refills=1;
SELECT @@session.pq_hash_join_max_hash_table_refills;
SET SESSION pq_hash_join_max_hash_table_refills=999;
SELECT @@session.pq_hash_join_max_hash_table_refills;

SET SESSION op_over_pq_offset_threshold=0;
SELECT @@session.op_over_pq_offset_threshold;
SET SESSION op_over_pq_offset_threshold=1000;
SELECT @@session.op_over_pq_offset_threshold;

SET SESSION force_parallel_execute=DEFAULT;
SET SESSION parallel_fail_retry=DEFAULT;
SET SESSION pq_msg_queue_size=DEFAULT;
SET SESSION pq_msg_queue_spin_lock=DEFAULT;
SET SESSION innodb_parallel_select_count=DEFAULT;
SET SESSION pq_hash_join_max_hash_table_refills=DEFAULT;
SET SESSION op_over_pq_offset_threshold=DEFAULT;

SELECT @@session.force_parallel_execute;
SELECT @@session.parallel_fail_retry;
SELECT @@session.pq_msg_queue_size;
SELECT @@session.pq_msg_queue_spin_lock;
SELECT @@session.innodb_parallel_select_count;
SELECT @@session.pq_hash_join_max_hash_table_refills;
SELECT @@session.op_over_pq_offset_threshold;
