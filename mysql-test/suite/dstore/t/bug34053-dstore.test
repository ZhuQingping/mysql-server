#
# Make sure http://bugs.mysql.com/34053 remains fixed.
#
--source include/have_only_dstore.inc


SET default_storage_engine=Dstore;

# we do not really care about what gets printed, we are only
# interested in getting success or failure according to our
# expectations
-- disable_query_log
-- disable_result_log

CREATE USER 'shane'@'localhost' IDENTIFIED BY '12345';
FLUSH PRIVILEGES;

-- connect (con1,localhost,shane,12345,)

-- connection con1


CREATE TABLE dstore_monitor (a INT) ENGINE=Dstore;
DROP TABLE dstore_monitor;
CREATE TABLE dstore_mem_validate (a INT) ENGINE=Dstore;
DROP TABLE dstore_mem_validate;
CREATE TABLE dstore_sql (a INT) ENGINE=Dstore;
DROP TABLE dstore_sql;
CREATE TABLE dstore_monitorx (a INT) ENGINE=Dstore;
DROP TABLE dstore_monitorx;
CREATE TABLE dstore_monito (a INT) ENGINE=Dstore;
DROP TABLE dstore_monito;
CREATE TABLE xdstore_monitor (a INT) ENGINE=Dstore;
DROP TABLE xdstore_monitor;
CREATE TABLE nnodb_monitor (a INT) ENGINE=Dstore;
DROP TABLE nnodb_monitor;

-- connection default

DROP USER 'shane'@'localhost';

-- disconnect con1
