--source include/have_only_dstore.inc

create database bug2026012840232;
use bug2026012840232;

--error ER_TABLESPACE_CHECK_NOT_IMPLEMENTED
create tablespace ts1 AUTOEXTEND_SIZE=128M FILE_BLOCK_SIZE=1024 ENCRYPTION='Y' ENGINE=dstore;

create tablespace ts2 ENGINE=dstore;

--error ER_TABLESPACE_CHECK_NOT_IMPLEMENTED
alter tablespace ts2 ENCRYPTION='Y';

drop tablespace ts2;
drop database bug2026012840232;
