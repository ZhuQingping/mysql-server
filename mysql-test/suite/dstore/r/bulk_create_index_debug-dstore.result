CREATE PROCEDURE populate_t1()
BEGIN
DECLARE i int DEFAULT 1;
START TRANSACTION;
WHILE (i <= 10000) DO
INSERT INTO t1 VALUES (i, i, CONCAT('a', i));
SET i = i + 1;
END WHILE;
COMMIT;
END|
CREATE TABLE t1(
class   INT,
id      INT,
title   VARCHAR(100)
) ENGINE=Dstore ROW_FORMAT=REDUNDANT;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
SELECT COUNT(*) FROM t1;
COUNT(*)
10000
CREATE INDEX idx_title ON t1(title);
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
# restart
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	note	The storage engine for the table doesn't support check
SELECT * FROM t1 WHERE title = 'a10';
class	id	title
10	10	a10
SELECT * FROM t1 WHERE title = 'a5000';
class	id	title
5000	5000	a5000
SELECT * FROM t1 WHERE title = 'a10000';
class	id	title
10000	10000	a10000
SELECT * FROM t1 WHERE title = 'a10010';
