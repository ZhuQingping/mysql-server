#
# Bug #18010711	UNIQUE PREFIX INDEX ON BINARY COLUMN: FAILING
# ASSERTION: FLEN == LEN
#
CALL mtr.add_suppression("insert dstore index tuple fail");
CALL mtr.add_suppression("insert_index fail");
create table t1 (f1 binary(5)) engine=Dstore;
insert into t1 values ('w'), ('w');
create unique index index_t1 on t1(f1(4)) ALGORITHM=COPY;
ERROR 23000: Duplicate entry 'w' for key 't1.index_t1'
drop table t1;
