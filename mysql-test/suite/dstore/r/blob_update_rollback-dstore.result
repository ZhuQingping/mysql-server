#
# WL#8985:  Refactor compressed BLOB code to facilitate partial
# fetch/update
#
create table t1 (f1 int primary key, f2 blob) engine=Dstore, row_format = compressed;
Warnings:
Warning	1178	The storage engine for the table doesn't support ROW_FORMAT
insert into t1 values (1, repeat('-', 32000));
start transaction;
update t1 set f2 = repeat('+', 64000) where f1 = 1;
rollback;
drop table t1;
