CREATE TABLE t1(
a INT PRIMARY KEY,
b CHAR(10) NOT NULL
)ENGINE=Dstore;
CREATE PROCEDURE test_rollback_t1()
BEGIN
DECLARE i int DEFAULT 1;
START TRANSACTION;
WHILE (i <= 324) DO
UPDATE t1 SET a = 10 WHERE a = 9;
UPDATE t1 SET a = 9 WHERE a = 10;
SET i = i + 1;
END WHILE;
COMMIT;
END|
BEGIN;
insert into t1 values(9, 'a');
COMMIT;
BEGIN;
insert into t1 values(0, 'a');
BEGIN;
insert into t1 values(1, 'a');
BEGIN;
insert into t1 values(2, 'a');
call test_rollback_t1();
BEGIN;
DELETE FROM t1 where a = 9;
insert into t1 values(3, 'a');
insert into t1 values(4, 'a');
insert into t1 values(5, 'a');
insert into t1 values(6, 'a');
insert into t1 values(7, 'a');
ROLLBACK;
BEGIN;
DELETE FROM t1 where a = 9;
COMMIT;
BEGIN;
explain select a from t1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	PRIMARY	4	NULL	4	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a` from `test`.`t1`
select a from t1;
a
COMMIT;
COMMIT;
COMMIT;
COMMIT;
DROP TABLE t1;
DROP PROCEDURE test_rollback_t1;
