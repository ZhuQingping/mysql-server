# ==== Purpose ====
#
# Test DDL lock fast timeout with multiple tables involved
#

--source include/count_sessions.inc

let $lock_wait_timeout_orig=`select @@lock_wait_timeout`;
let $rds_ddl_lock_wait_timeout_orig=`select @@rds_ddl_lock_wait_timeout`;


--echo #
--echo # common settings
--echo #
SET GLOBAL lock_wait_timeout=15;
SET GLOBAL rds_ddl_lock_wait_timeout=10;


--echo #
--echo # prepare
--echo #
CREATE TABLE stu (
sno INT AUTO_INCREMENT PRIMARY KEY,
name CHAR(20) NOT NULL
);
INSERT INTO stu VALUES (NULL, 'foo');

CREATE TABLE grade (
sno INT,
grade INT,
FOREIGN KEY (sno) REFERENCES stu(sno)
);



--echo #
--echo # Scenario 1: Foreign key case which involves two tables
--echo #


--let $ddl_cmd= ALTER TABLE grade DROP FOREIGN KEY grade_ibfk_1


connect(conn1,localhost,root,,);
connect(conn2,localhost,root,,);
connect(conn3,localhost,root,,);
connect(conn4,localhost,root,,);
connect(conn5,localhost,root,,);


--echo # conn1: a ddl blocking operation on grade
connection conn1;
START TRANSACTION;
--eval SELECT * FROM grade


--echo # conn2: a ddl blocking operation on stu
connection conn2;
START TRANSACTION;
--eval INSERT INTO stu VALUES (NULL, "bar")


--echo # conn3: DDL
connection conn3;
--send_eval $ddl_cmd


--echo # conn4: DML which would be blocked by DDL
connection conn4;
# Wait until the above DDL is blocked
--let $wait_condition= select count(*) = 1 from information_schema.processlist where state = "Waiting for table metadata lock" and info = "$ddl_cmd";
--source include/wait_condition.inc
SHOW CREATE TABLE grade;
--send
INSERT INTO grade VALUES(1,1);


--echo # conn1: release lock on grade
connection conn1;
ROLLBACK;
disconnect conn1;


--echo # conn4: Now it can continue
connection conn4;
--reap
SHOW CREATE TABLE grade;
SELECT * FROM grade;
disconnect conn4;


--echo # conn5: Do some DDL which should not be blocked by the DDL
connection conn5;
# Wait until the above DDL is blocked on stu
--let $wait_condition= select count(*) = 1 from information_schema.processlist where state = "Waiting for table metadata lock" and info = "$ddl_cmd";
SHOW CREATE TABLE stu;
INSERT INTO stu VALUES (NULL, "2nd try");
disconnect conn5;


--echo # conn3: DDL timeout
connection conn3;
--error ER_LOCK_WAIT_TIMEOUT
--reap
SHOW CREATE TABLE grade;
SELECT * FROM grade;

--echo # Expect to be 15
SELECT @@session.lock_wait_timeout;
--echo # Expect to be 10
SELECT @@session.rds_ddl_lock_wait_timeout;
--echo # Expect to be default 50
SELECT @@session.innodb_lock_wait_timeout;

disconnect conn3;


--echo # conn2: rollback
connection conn2;
ROLLBACK;
SHOW CREATE TABLE stu;
SELECT * FROM stu;
disconnect conn2;

connection default;


--echo #
--echo # Scenario 2: LOCK TABLE to block DDLs, and verify it works
--echo #
SET GLOBAL lock_wait_timeout=20;
SET GLOBAL rds_ddl_lock_wait_timeout=5;

connect(conn1,localhost,root,,);
connect(conn2,localhost,root,,);
connect(conn3,localhost,root,,);


--echo # conn1: Issue the LOCK TABLE
connection conn1;
LOCK TABLES grade READ, stu WRITE;


--echo # conn2: To run DDL on grade and verify the timeout
connection conn2;
--let conn2_start = `SELECT unix_timestamp(now())`
--send ALTER TABLE grade ADD KEY(grade);


--echo # conn3: To run DDL on stu and verify it won't timeout
connection conn3;
--echo # Make sure this won't timeout too soon
SET SESSION rds_ddl_lock_wait_timeout = 10;
--send ALTER TABLE stu ADD KEY(name);


--echo # conn2: Verify the timeout duration
connection conn2;
--error ER_LOCK_WAIT_TIMEOUT
--reap;
--let conn2_end = `SELECT unix_timestamp(now())`
--let r = `select ("$conn2_end" - "$conn2_start") >= 5`
--echo # conn2 waited for 5 seconds: $r
--let r = `select ("$conn2_end" - "$conn2_start") < 10`
--echo # conn2 waited for less than 10 seconds: $r
SHOW CREATE TABLE grade;

--echo # Expect to be 20
SELECT @@session.lock_wait_timeout;
--echo # Expect to be 5
SELECT @@session.rds_ddl_lock_wait_timeout;
--echo # Expect to be default 50
SELECT @@session.innodb_lock_wait_timeout;

disconnect conn2;


--echo # conn1: Unlock to not block conn3
connection conn1;
UNLOCK TABLES;

disconnect conn1;


--echo # conn3: Verify DDL succeeded
connection conn3;
--reap
SHOW CREATE TABLE stu;

--echo # Expect to be 20
SELECT @@session.lock_wait_timeout;
--echo # Expect to be 10
SELECT @@session.rds_ddl_lock_wait_timeout;
--echo # Expect to be default 50
SELECT @@session.innodb_lock_wait_timeout;

disconnect conn3;


--echo #
--echo # teardown
--echo #
connection default;
DROP TABLE grade, stu;


eval SET GLOBAL lock_wait_timeout = $lock_wait_timeout_orig;
eval SET GLOBAL rds_ddl_lock_wait_timeout = $rds_ddl_lock_wait_timeout_orig;
--source include/wait_until_count_sessions.inc
