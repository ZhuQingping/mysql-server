2	4	3	5	PENDING	1	7
3	4	3	5	ACTIVE	1	7
update t1 set col5='DISABLED' where col1 = 2;
select * from t1;
col1	col2	col3	col4	col5	col6	to_be_deleted
2	4	3	5	DISABLED	1	7
3	4	3	5	ACTIVE	1	7
delete from t1 where col5='DISABLED';
select * from t1;
col1	col2	col3	col4	col5	col6	to_be_deleted
3	4	3	5	ACTIVE	1	7
# conn2: DDL
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
# Table definition is not as expected!
# conn1: commit
COMMIT;
select * from t1;
col1	col2	col3	col4	col5	col6	to_be_deleted
3	4	3	5	ACTIVE	1	7
