1	1
update t2 set a='11' where a = 1;
select a, va from t2;
a	va
11	11
delete from t2 where va = '11';
select a, va from t2;
a	va
# conn2: DDL
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
# conn1: commit
COMMIT;
select a, va from t2;
