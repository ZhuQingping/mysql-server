# common settings
#
SET GLOBAL lock_wait_timeout=10;
SET GLOBAL rds_ddl_lock_wait_timeout=1;
#
# prepare t1 with one row, empty t2 and t3
#
#
# determine ddl command
#
#
# Testing
#
# conn1: a ddl blocking operation
START TRANSACTION;
select a, va from t2;
a	va
# conn2: DDL
alter table t2 ALGORITHM=INPLACE, ADD SPATIAL INDEX(b);
# conn3: DMLs
insert into t2 (a, b) values ('1', ST_GeomFromText('POINT(1 1)'));
select a, va from t2;
a	va
1	1
update t2 set a='11' where a = 1;
select a, va from t2;
a	va
11	11
delete from t2 where va = '11';
select a, va from t2;
a	va
# conn2: DDL
ERROR HY000: Lock wait timeout exceeded; try restarting transaction
# conn1: commit
COMMIT;
select a, va from t2;
a	va
#
# teardown
#
drop table t1;
drop table t2;
drop table t3;
