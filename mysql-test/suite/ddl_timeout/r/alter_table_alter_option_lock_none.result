2	4	3	5	PENDING	1	7
# conn2: DDL
alter table t1 LOCK=SHARED, ALGORITHM=COPY, add column col4_5 varchar(20) not null after col4;
# conn3: DMLs
insert into t1 values (3,4,3,5,"ACTIVE",1,7);
select * from t1;
