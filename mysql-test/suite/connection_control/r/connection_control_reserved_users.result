# Setup
# Install connection_control plugin
INSTALL PLUGIN connection_control SONAME 'CONNECTION_CONTROL_LIB';
INSTALL PLUGIN connection_control_failed_login_attempts SONAME 'CONNECTION_CONTROL_LIB';
SHOW VARIABLES LIKE "%connection_control%";
Variable_name	Value
connection_control_failed_connections_threshold	3
connection_control_max_connection_delay	2147483647
connection_control_min_connection_delay	1000
# Verify normal users.
CREATE USER u1@'%' IDENTIFIED BY '123456';
connect(localhost,u1,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u1'@'localhost' (using password: YES)
connect(localhost,u1,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u1'@'localhost' (using password: YES)
connect(localhost,u1,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u1'@'localhost' (using password: YES)
connect(localhost,u1,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u1'@'localhost' (using password: YES)
connect(localhost,u1,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u1'@'localhost' (using password: YES)
SHOW STATUS LIKE 'Connection_control%';
Variable_name	Value
Connection_control_delay_generated	3
# Verify reserved users.
CREATE USER u2@'%' IDENTIFIED BY '123456';
SET GLOBAL rds_reserved_users = 'u2';
connect(localhost,u2,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u2'@'localhost' (using password: YES)
connect(localhost,u2,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u2'@'localhost' (using password: YES)
connect(localhost,u2,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u2'@'localhost' (using password: YES)
connect(localhost,u2,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u2'@'localhost' (using password: YES)
connect(localhost,u2,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u2'@'localhost' (using password: YES)
SHOW STATUS LIKE 'Connection_control%';
Variable_name	Value
Connection_control_delay_generated	3
# Verify normal user -> reserved user -> normal user
CREATE USER u3@'%' IDENTIFIED BY '123456';
connect(localhost,u3,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u3'@'localhost' (using password: YES)
connect(localhost,u3,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u3'@'localhost' (using password: YES)
connect(localhost,u3,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u3'@'localhost' (using password: YES)
SHOW STATUS LIKE 'Connection_control%';
Variable_name	Value
Connection_control_delay_generated	3
SET GLOBAL rds_reserved_users = 'u3';
connect(localhost,u3,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u3'@'localhost' (using password: YES)
connect(localhost,u3,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u3'@'localhost' (using password: YES)
SHOW STATUS LIKE 'Connection_control%';
Variable_name	Value
Connection_control_delay_generated	3
SET GLOBAL rds_reserved_users = '';
connect(localhost,u3,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u3'@'localhost' (using password: YES)
connect(localhost,u3,wrong,test,MASTER_PORT,MASTER_SOCKET);
ERROR 28000: Access denied for user 'u3'@'localhost' (using password: YES)
SHOW STATUS LIKE 'Connection_control%';
Variable_name	Value
Connection_control_delay_generated	6
# Cleanup.
SET GLOBAL rds_reserved_users = '';
DROP USER u1, u2, u3;
# Uninstall connection_control plugin
UNINSTALL PLUGIN connection_control;
UNINSTALL PLUGIN connection_control_failed_login_attempts;
