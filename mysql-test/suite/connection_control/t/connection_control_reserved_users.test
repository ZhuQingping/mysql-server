--source include/have_debug.inc
--source include/mysql_have_debug.inc

# Make sure that connection_control plugin can be loaded
--source ../inc/have_connection_control_plugin.inc

# Save the initial number of concurrent sessions
--source include/count_sessions.inc

--echo # Setup
--echo # Install connection_control plugin
--source ../inc/install_connection_control_plugin.inc

--connection default
SHOW VARIABLES LIKE "%connection_control%";

--echo # Verify normal users.

CREATE USER u1@'%' IDENTIFIED BY '123456';

--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con1,localhost,u1,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con1,localhost,u1,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con1,localhost,u1,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con1,localhost,u1,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con1,localhost,u1,wrong)

let $start_time= `SELECT UNIX_TIMESTAMP(NOW(6))`;
--connect (con1,localhost,u1,123456)
let $end_time= `SELECT UNIX_TIMESTAMP(NOW(6))`;
let $is_short= `SELECT ($end_time - $start_time) < 1`;
if ($is_short == 1)
{
  --echo Error: Connection delay Error
}
--connection default
--disconnect con1

SHOW STATUS LIKE 'Connection_control%';

--echo # Verify reserved users.

CREATE USER u2@'%' IDENTIFIED BY '123456';
SET GLOBAL rds_reserved_users = 'u2';

--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con2,localhost,u2,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con2,localhost,u2,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con2,localhost,u2,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con2,localhost,u2,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con2,localhost,u2,wrong)

let $start_time= `SELECT UNIX_TIMESTAMP(NOW(6))`;
--connect (con2,localhost,u2,123456)
let $end_time= `SELECT UNIX_TIMESTAMP(NOW(6))`;
let $is_short= `SELECT ($end_time - $start_time) > 1`;
if ($is_short == 1)
{
  --echo Error: Connection delay Error
}
--connection default
--disconnect con2

SHOW STATUS LIKE 'Connection_control%';

--echo # Verify normal user -> reserved user -> normal user

CREATE USER u3@'%' IDENTIFIED BY '123456';

--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con3,localhost,u3,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con3,localhost,u3,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con3,localhost,u3,wrong)

SHOW STATUS LIKE 'Connection_control%';
SET GLOBAL rds_reserved_users = 'u3';

--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con3,localhost,u3,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con3,localhost,u3,wrong)

let $start_time= `SELECT UNIX_TIMESTAMP(NOW(6))`;
--connect (con3,localhost,u3,123456)
let $end_time= `SELECT UNIX_TIMESTAMP(NOW(6))`;
let $is_short= `SELECT ($end_time - $start_time) > 1`;
if ($is_short == 1)
{
  --echo Error: Connection delay Error
}
--connection default
--disconnect con3

SHOW STATUS LIKE 'Connection_control%';
SET GLOBAL rds_reserved_users = '';

--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con3,localhost,u3,wrong)
--replace_result $MASTER_MYSOCK MASTER_SOCKET $MASTER_MYPORT MASTER_PORT
--error ER_ACCESS_DENIED_ERROR
--connect (con3,localhost,u3,wrong)

let $start_time= `SELECT UNIX_TIMESTAMP(NOW(6))`;
--connect (con3,localhost,u3,123456)
let $end_time= `SELECT UNIX_TIMESTAMP(NOW(6))`;
let $is_short= `SELECT ($end_time - $start_time) < 1`;
if ($is_short == 1)
{
  --echo Error: Connection delay Error
}
--connection default
--disconnect con3

SHOW STATUS LIKE 'Connection_control%';


-- echo # Cleanup.
SET GLOBAL rds_reserved_users = '';
DROP USER u1, u2, u3;

--echo # Uninstall connection_control plugin
--source ../inc/uninstall_connection_control_plugin.inc

# Wait till all disconnects are completed.
--source include/wait_until_count_sessions.inc
