       (3,1,'c','c'),(4,8,'m','m'),(5,9,'d','d');
CREATE VIEW v1 AS SELECT * FROM t1;
let $query=
SELECT alias2.col_varchar_nokey FROM v1 AS alias1 RIGHT JOIN t1 AS alias2 ON 1 WHERE alias2.col_varchar_key IN ( SELECT /*+prc_subquery()*/ sq2_alias1.col_varchar_nokey FROM v1 AS sq2_alias1  WHERE sq2_alias1.pk != alias1.col_int_key AND sq2_alias1.col_varchar_key > alias1.col_varchar_key );
SELECT alias2.col_varchar_nokey FROM v1 AS alias1 RIGHT JOIN t1 AS alias2 ON 1 WHERE alias2.col_varchar_key IN ( SELECT sq2_alias1.col_varchar_nokey FROM v1 AS sq2_alias1  WHERE sq2_alias1.pk != alias1.col_int_key AND sq2_alias1.col_varchar_key > alias1.col_varchar_key );
# Show that PTRC is used
--replace_regex /  \(cost.*//
eval EXPLAIN FORMAT=TREE $query;
eval $query;
# a more complex view
DROP VIEW v1;
