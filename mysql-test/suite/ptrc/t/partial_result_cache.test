  inhalt varchar(50),
  KEY tig (ticket),
  FULLTEXT INDEX tix (inhalt)
) ENGINE=InnoDB CHARSET utf8mb4;
INSERT INTO t2 VALUES (1,'foo'),(2,'bar'),(3,'foobar'),(1,'Doobar'),(2,'obar');

INSERT INTO t2 SELECT * FROM t2;
INSERT INTO t2 SELECT * FROM t1;
INSERT INTO t2 SELECT * FROM t2;
INSERT INTO t2 SELECT * FROM t1;

--replace_regex /time.* /time=# / /Memory Usage: [0-9]+ /Memory Usage: # / / \(cost.*//
explain analyze select /*+ prc_join() */ ticket2.id FROM t2 as ttxt,t2 INNER JOIN t1 as ticket2 ON ticket2.id = t2.ticket WHERE ticket2.id = ticket2.ticket and match(ttxt.inhalt) against ('foobar');
drop table t1,t2;

create table t1 (a int, b int, c int, key(a desc, b asc, c desc));
create table t2 (d int, key(d asc));
--disable_query_log
let $i=5;
while($i)
{
    let $j = 5;
    while($j)
    {
        let $k = 5;
        while($k)
        {
            let $l = 5;
            while($l)
            {
                --eval insert into t1 values($k, $j, $i)
                dec $l;
            }
            dec $k;
        }
        dec $j;
    }
    --eval insert into t2 values($i);
    dec $i;
}
--enable_query_log
let $query=
select * from t2, t1 force index(`a`) having c < 3 order by a, b limit 10;
--replace_regex $elide_costs_and_rows
--eval explain format=tree $query
--eval $query

drop table t1;
drop table t2;

create table t(a int, b int);
insert into t values(1,10),(2,20);

create table tt (f1 int, f2 int, KEY f1 (f1));
insert into tt values (1,10),(2,20),(3,30),(4,40);

create table t2(a int, key(a), b int);

set optimizer_switch="block_nested_loop=off";
 
let query1 = SELECT t1.* , ( SELECT count(*) FROM t t2 LEFT JOIN t t3 ON t3.a > t2.a - t1.a ) FROM t t1;
 
let query2=
 select t1.*, (select count(*)
               from (t t2 join t t3)
               left join (t t4 LEFT JOIN (t t5 JOIN t t6) ON t4.a>t5.a-t1.a) on t3.a>t2.a-t1.a)
 from t t1;

let query3=
 SELECT t11.* , ( SELECT max(t1.f1) FROM tt t1 WHERE NOT EXISTS ( SELECT * FROM tt t2 JOIN tt t3 ON t2.f1 < NULL WHERE t1.f1 = t2.f1 AND t1.f1 < t11.a ) ) FROM t t11;

let query4=  select (select t3.b from (t2 as t5 left join (t2 as t3 force index (a) left join t2 as t4 on true) on t3.a=t_.a)) from t2 as t_;

--replace_regex /time.* /time=# / /Memory Usage: [0-9]+ /Memory Usage: # / / \(cost.*//
eval explain format=tree $query1;
eval $query1;

--replace_regex /time.* /time=# / /Memory Usage: [0-9]+ /Memory Usage: # / / \(cost.*//
eval explain format=tree $query2;
eval $query2;

set optimizer_switch=default;

--replace_regex /time.* /time=# / /Memory Usage: [0-9]+ /Memory Usage: # / / \(cost.*//
eval explain format=tree $query3;
eval $query3;

--replace_regex /time.* /time=# / /Memory Usage: [0-9]+ /Memory Usage: # / / \(cost.*//
eval explain format=tree $query4;
eval $query4;

drop table t, tt, t2;