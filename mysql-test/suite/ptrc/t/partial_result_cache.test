--source include/have_debug.inc
--source include/not_have_only_dstore.inc
--source include/elide_costs.inc
CREATE TABLE t1(a int, b int);
INSERT INTO t1 VALUES(1,2),(2,3),(2,3),(2,3),(2,4),(3,1);
CREATE TABLE t2(a int, b int);
INSERT INTO t2 VALUES(1,3),(2,4),(3,4);
INSERT INTO t2 SELECT * FROM t2;
INSERT INTO t2 SELECT * FROM t1;

--echo "test caching of IN(subquery) using IN-to-EXISTS"
SET @old_optimizer_switch = @@optimizer_switch;
SET optimizer_switch='semijoin=off,partial_result_cache=on';
SET rds_partial_result_cache_cost_threshold = 0;
--replace_regex /  \(cost.*//
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b GROUP BY b);
SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b GROUP BY b) ORDER BY a;
# Memory usage is a different number when using ASAN, so we hide it;
# however it is verified in memory_used.test.
--replace_regex /time.* /time=# / /Memory Usage: [0-9]+ /Memory Usage: # / / \(cost.*//
EXPLAIN ANALYZE format=tree SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b GROUP BY b) ORDER BY a;

--echo "test of uncorrelated subquery using IN-to-EXISTS (correlation only in the left argument of IN),"
--echo "the left argument is injected in the subquery's WHERE, so subquery becomes correlated,
--echo "so PTRC is used".
--replace_regex /  \(cost.*//
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT /*+subquery(intoexists)*/ b FROM t2 GROUP BY b);
--echo "same test with materialization: subquery remains non-correlated => no PTRC"
--replace_regex /  \(cost.*//
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT /*+subquery(materialization)*/ b FROM t2 GROUP BY b);

--echo "subquery with aggregation inside"
--replace_regex /  \(cost.*//
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT 0.2 * avg(a) FROM t2 WHERE t2.b > t1.b GROUP BY a);
SELECT * FROM t1 WHERE t1.a in (SELECT 0.2 * avg(a) FROM t2 WHERE t2.b > t1.b GROUP BY a);

--echo "test caching of scalar subquery"
--replace_regex /  \(cost.*//
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a = (SELECT max(a) FROM t2 WHERE t2.b > t1.b);
SELECT * FROM t1 WHERE t1.a = (SELECT max(a) FROM t2 WHERE t2.b > t1.b);
--replace_regex /  \(cost.*//
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b union SELECT a FROM t2 WHERE t2.b > t1.b) ORDER BY 1;
SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b union SELECT a FROM t2 WHERE t2.b > t1.b) ORDER BY 1;

--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT * FROM t1 as tt WHERE tt.a in (SELECT a FROM t2 as tt1 WHERE tt1.b in (SELECT t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));

SELECT * FROM t1 as tt WHERE tt.a in (SELECT a FROM t2 as tt1 WHERE tt1.b in (SELECT t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));

--echo "test cost"
ALTER TABLE t1 ADD index idx(a);
--replace_regex /  \(cost.*//
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b GROUP BY b);
ALTER TABLE t1 ADD index idx1(a, b);
--replace_regex /  \(cost.*//
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b GROUP BY b);

--echo "block PTRC if aggregation if it happens in the outer query"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT a, COUNT(t1.b) FROM t1 GROUP BY a ORDER BY (SELECT SUM(t1.b) FROM t2 LIMIT 1);
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT a, (SELECT SUM(t1.b) FROM t2 LIMIT 1) FROM t1 GROUP BY a;
--echo "but allow PTRC if aggregation happens in the subquery"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT a FROM t1 ORDER BY (SELECT SUM(t1.b+t2.b) FROM t2 LIMIT 1);

--echo "test memory"
SET rds_partial_result_cache_max_mem_size=64*1024;
SELECT * FROM t1 WHERE t1.a = (SELECT max(a) FROM t2 WHERE t2.b > t1.b);
SET debug="+d,ptrc_init_row_buffer_fail";
SELECT * FROM t1 WHERE t1.a = (SELECT max(a) FROM t2 WHERE t2.b > t1.b);
SET rds_partial_result_cache_max_mem_size=default;
SET debug="-d,ptrc_init_row_buffer_fail";

SET rds_partial_result_cache_max_mem_size=default;
SET debug="+d,ptrc_initrowlbuffer_reserver_space_fail";
SET OPTIMIZER_TRACE='enabled=on';
--echo # Turning PQ off, otherwise we don't see the allocation failure in the optimizer trace.
SELECT /*+ NO_PQ */ * FROM t1 WHERE t1.a = (SELECT max(a) FROM t2 WHERE t2.b > t1.b);
--replace_regex /\"cost\":.*/#/ /\"distinct_rows\":.*/\"distinct_rows\":#/ /\"estimate_distinct.*/#/
SELECT * FROM information_schema.optimizer_trace;
SET OPTIMIZER_TRACE='enabled=off';
SET debug="-d,ptrc_initrowlbuffer_reserver_space_fail";

--echo "test_lru"
SET debug="+d,allocate_failure_when_storerow";
SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b GROUP BY b) ORDER BY a;
SET debug="-d,allocate_failure_when_storerow";
SET debug='+d,ptrc_sim_allocate_failure_during_cache';
ALTER TABLE t2 ADD index idx1(a);
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT * FROM t1, t2 WHERE t1.a = t2.a ORDER BY 1,2;
SELECT * FROM t1, t2 WHERE t1.a = t2.a ORDER BY 1,2,3,4;
ALTER TABLE t2 DROP index idx1;
SET debug="-d,ptrc_sim_allocate_failure_during_cache";
SET rds_partial_result_cache_cost_threshold = 1;
SELECT * FROM t1, t2 WHERE t1.a = t2.a ORDER BY 1,2,3,4;

--echo "test hint"
SET optimizer_switch = 'partial_result_cache=off';
--echo "force subquery ptrc"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+prc_subquery(@sub1) */ * FROM t1 as tt WHERE tt.a in (SELECT /*+ qb_name(sub1) */ a FROM t2 as tt1 WHERE tt1.b in (SELECT t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));
--echo "hint is useless because it's about top query which is not a subquery (can't have any cache)"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+prc_subquery() */ * FROM t1 as tt WHERE tt.a in (SELECT a FROM t2 as tt1 WHERE tt1.b in (SELECT /*+ prc_join(t1,t2) */ t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));
--echo "hint works because it's about subquery"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+prc_subquery() */ * FROM t1 as tt WHERE tt.a in (SELECT /*+prc_subquery() */a FROM t2 as tt1 WHERE tt1.b in (SELECT /*+ prc_join(t1,t2) */ t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));
--echo "hint about subquery cannot mention tables (a warning is issued for that)"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT * FROM t1 as tt WHERE tt.a in (SELECT /*+prc_subquery(tt1) */a FROM t2 as tt1 WHERE tt1.b in (SELECT /*+ prc_join(t1,t2) */ t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));
SET optimizer_switch = 'partial_result_cache=on';
SET rds_partial_result_cache_cost_threshold = 0;
--echo "hint is useless"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+no_prc_subquery() */ * FROM t1 as tt WHERE tt.a in (SELECT a FROM t2 as tt1 WHERE tt1.b in (SELECT t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));
--echo "force no ptrc for inner subquery"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+no_prc_subquery(@sub1) */ * FROM t1 as tt WHERE tt.a in (SELECT /*+ qb_name(sub1) */ a FROM t2 as tt1 WHERE tt1.b in (SELECT t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));
--echo "force no ptrc in subquery"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+prc_subquery(@sub1) prc_subquery(@sub1) */ * FROM t1 as tt WHERE tt.a in (SELECT /*+ qb_name(sub1) */ a FROM t2 as tt1 WHERE tt1.b in (SELECT /*+ no_prc_subuqery(t2) */ t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));
--echo "conflict hint"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+no_prc_subquery(@sub1) prc_subquery(@sub1) */ * FROM t1 as tt WHERE 
tt.a in (SELECT /*+ qb_name(sub1) */ a FROM t2 as tt1 WHERE tt1.b in (SELECT /*+ no_prc_join(t2) */ t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));
--echo "Show that hints are printed in the transformed query below EXPLAIN (see the Note 1003 in output)"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TRADITIONAL SELECT /*+no_prc_subquery(@sub1) */ * FROM t1 as tt WHERE 
tt.a in (SELECT /*+ qb_name(sub1) */ a FROM t2 as tt1 WHERE tt1.b in (SELECT /*+ no_prc_join(t2) */ t1.b FROM t1, t2 WHERE t1.a = t2.a AND t1.b = tt.b));

ALTER TABLE t1 DROP INDEX idx;
ALTER TABLE t1 ADD INDEX idx(b);
SET rds_partial_result_cache_cost_threshold = 1;
--echo "no ptrc for NLJ"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT * FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
--echo "only all tables are in hint, ptrc for NLJ will be forced"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+ prc_join(t2) */ * FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+ prc_join(t1) */ * FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+ prc_join(t1,t2) */ * FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+ prc_join() */ * FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
SET rds_partial_result_cache_cost_threshold = 0;
--echo "ptrc for NLJ"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT * FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
--echo "no use if hint on outer tables"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+ no_prc_join(t2) */ * FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
--echo "no ptrc for NLJ"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+ no_prc_join(t1) */ * FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT /*+ no_prc_join() */ * FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
--echo "test rand" 
--echo "no PTRC for join if WHERE contains random functions, because the NL join's might be random then"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT * FROM t1, t2 WHERE t1.b = t2.b AND t1.a + RAND()=t2.a;
ALTER TABLE t1 DROP INDEX idx;
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT * FROM t1, t2 WHERE t1.b = t2.b AND t1.a = t2.a AND t2.a = RAND();
--echo "no PTRC for subquery if left argument of IN is random"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT * FROM t1 WHERE t1.a + RAND() in (SELECT t1.b FROM t2 WHERE t1.a=t2.b GROUP BY t1.b);
--echo "can use PTRC, as no part of the subquery is random (the top query's WHERE has an random part which is unrelated to the subquery)"
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT * FROM t1 WHERE t1.a in (SELECT t1.b FROM t2 WHERE t1.a=t2.b GROUP BY t1.b) and t1.a = RAND();
delimiter $$;
CREATE PROCEDURE proc() BEGIN
SELECT t1.a FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
SELECT t1.a FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
END $$
delimiter ;$$
CALL proc();
delimiter $$;
CREATE FUNCTION func() RETURNS INT DETERMINISTIC BEGIN
DECLARE co INT;
DECLARE s INT;
SELECT count(*) INTO co FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
SELECT sum(t1.a) INTO s FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
RETURN co + s;
END $$
delimiter ;$$
SELECT func() FROM t1;
DROP PROCEDURE proc;
DROP FUNCTION func;
