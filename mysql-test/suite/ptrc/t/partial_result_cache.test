DROP TABLE t1;
DROP TABLE t2;
CREATE TABLE t1(a int, b int);
INSERT INTO t1 VALUES(1,3),(3,4);
CREATE TABLE t2 AS SELECT * FROM t1;
INSERT INTO t2 SELECT * FROM t2;
ALTER TABLE t2 ADD INDEX idx(b);
INSERT INTO t2 SELECT * FROM t2;
SET @save_optimizer_switch = @@optimizer_switch;
SET optimizer_switch='semijoin=on,firstmatch=off,loosescan=off,materialization=off,mrr=off,index_condition_pushdown=off,derived_merge=off,hash_join=off';
SET rds_partial_result_cache_cost_threshold = 0;
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT * FROM t2 WHERE t2.b IN (SELECT t1.a FROM t1, t2 AS t3 WHERE t1.b>t3.b);
SELECT * FROM t2 WHERE t2.b IN (SELECT t1.a FROM t1, t2 AS t3 WHERE t1.b>t3.b);
SET rds_partial_result_cache_cost_threshold = 1;
SELECT * FROM t2 WHERE t2.b IN (SELECT t1.a FROM t1, t2 AS t3 WHERE t1.b>t3.b);
--echo BUG2022042401814: Weedout gives an incorrect result because of PTRC
--echo Following test case tries to simulate PTRC is disabled during execution
--echo when hit ratio is too lower. Here we set check frequency to low value to
--echo make hit ratio be checked with fewer records reading.
SET rds_partial_result_cache_cost_threshold = 0;
SET @old_threshold = @@rds_partial_result_cache_hit_ratio_frequency;
SET rds_partial_result_cache_hit_ratio_frequency = 4;
SELECT * FROM t2 WHERE t2.b IN (SELECT t1.a FROM t1, t2 AS t3 WHERE t1.b>t3.b);
SET rds_partial_result_cache_hit_ratio_frequency = @old_threshold;
SET optimizer_switch = @save_optimizer_switch;
DROP TABLE t1, t2;
--echo BUG2022042401814: Weedout gives an incorrect result because of PTRC
--echo Another weedout case which can check weedout can give a bad result if
--echo PTRC doesn't cache rowid.
CREATE TABLE t(a int);
INSERT INTO t VALUES (1),(2);
CREATE TABLE t1(a int);
INSERT INTO t1 VALUES (1),(2),(3);
INSERT INTO t1 VALUES (1),(2),(3);
let $query=
select /*+ join_order(t1@s,t2@s,t) no_bnl() */ t.a from    t where t.a in (select /*+ no_semijoin(materialization,firstmatch,loosescan) qb_name(s) no_bnl() */ t1.a from t1, t1 as t2 where t1.a=t2.a) ;
SET @save_optimizer_switch = @@optimizer_switch;
SET optimizer_switch='semijoin=on,partial_result_cache=on',rds_partial_result_cache_cost_threshold = 0;

--replace_regex /  \(cost.*//
eval EXPLAIN format=tree $query;
eval $query;
SET optimizer_switch='partial_result_cache=off';
eval $query;
DROP TABLE t1,t;
SET optimizer_switch = @save_optimizer_switch;

--echo "When a free slot is reused from the LRU, we make sure that this slot is big enough for the data to insert; we test it here by having rows of bigger and bigger size"
CREATE TABLE t1(a varchar(1000));
INSERT INTO t1 SELECT REPEAT("b", 2);
INSERT INTO t1 SELECT REPEAT("a", 2);
CREATE TABLE t2(a varchar(1000));
INSERT INTO t2 SELECT REPEAT("a", 1);
INSERT INTO t2 SELECT REPEAT("a", LENGTH(a) + 1) FROM t2;
INSERT INTO t2 SELECT REPEAT("a", LENGTH(a) + 2) FROM t2;
INSERT INTO t2 SELECT REPEAT("a", LENGTH(a) + 4) FROM t2;
INSERT INTO t2 SELECT REPEAT("a", LENGTH(a) + 8) FROM t2;

SET optimizer_switch='semijoin=off,partial_result_cache=on';
SET rds_partial_result_cache_cost_threshold = 0;
SET debug="+d,allocate_failure_when_storerow";
analyze table t1;
analyze table t2;
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=tree SELECT /*+ NO_BNL(t2) */ * FROM t1, t2;
SELECT /*+ NO_BNL(t2) */ * FROM t1, t2;
SET debug="-d,allocate_failure_when_storerow";
DROP TABLE t1, t2;

--echo "test cache keys without matching any rows: show that there are hits even when cached join result is empty"
CREATE TABLE t1(a int, b int);
INSERT INTO t1 VALUES(1,2),(2,3),(2,3),(2,3);
CREATE TABLE t2(a int, b int);
INSERT INTO t2 VALUES(1,3),(3,4);
--replace_regex /time.* /time=# / /Memory Usage: [0-9]+ /Memory Usage: # / / \(cost.*//
EXPLAIN ANALYZE FORMAT=tree SELECT /*+ NO_BNL() */ * FROM t1 STRAIGHT_JOIN t2 WHERE t1.a = t2.a ORDER BY t1.a;
SELECT /*+ NO_BNL() */ * FROM t1 STRAIGHT_JOIN t2 WHERE t1.a = t2.a ORDER BY t1.a;
SELECT /*+ NO_PRC_JOIN() */ * FROM t1 STRAIGHT_JOIN t2 WHERE t1.a = t2.a ORDER BY t1.a;

--echo "Verify that Item_in_subselect::was_null is properly stored in the cache as it"
--echo " is necessary for when the subquery's inner value is NULL. We use NOT IN to"
--echo " trigger the use of was_null"
SET rds_partial_result_cache_cost_threshold = 1;
CREATE TABLE c (
                col_int_nokey INTEGER NOT NULL,
                col_int_key INTEGER GENERATED ALWAYS AS 
                (col_int_nokey + col_int_nokey) VIRTUAL,
                col_varchar_nokey VARCHAR(1) NOT NULL,
                col_varchar_key VARCHAR(2) GENERATED ALWAYS AS
                (CONCAT(col_varchar_nokey, col_varchar_nokey)),
                KEY (col_int_key),
                KEY (col_int_key, col_varchar_key)
               ) ;
INSERT INTO c (
               col_int_nokey,
               col_varchar_nokey
              ) VALUES (8,'m');

CREATE TABLE cc (
                 col_int_nokey INTEGER,
                 col_int_key INTEGER GENERATED ALWAYS AS
                 (col_int_nokey + col_int_nokey) VIRTUAL,
                 col_varchar_nokey VARCHAR(1),
                 col_varchar_key VARCHAR(2) GENERATED ALWAYS AS
                 (CONCAT(col_varchar_nokey, col_varchar_nokey)),
                 KEY (col_int_key),
                 KEY (col_varchar_key),
                 KEY (col_int_key, col_varchar_key),
                 KEY (col_int_key, col_int_nokey),
                 KEY (col_varchar_key, col_varchar_nokey)
                );
INSERT INTO cc (
                col_int_nokey,
                col_varchar_nokey
               ) VALUES (8,'e'),(NULL,NULL),(8,'p');
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=tree SELECT alias2 . col_int_key , alias1 . col_int_nokey , alias2 . col_varchar_key AS field1 FROM ( cc AS alias1 , cc AS alias2 ) WHERE ( alias2 . col_int_key , alias1 . col_int_nokey ) NOT IN ( SELECT /*+prc_subquery() */ SQ1_alias2 . col_int_nokey AS SQ1_field1 , SQ1_alias1 . col_int_key AS SQ1_field2 FROM ( cc AS SQ1_alias1 , c AS SQ1_alias2 ) GROUP BY SQ1_field1 , SQ1_field2 );
SELECT alias2 . col_int_key , alias1 . col_int_nokey , alias2 . col_varchar_key AS field1 FROM ( cc AS alias1 , cc AS alias2 ) WHERE ( alias2 . col_int_key , alias1 . col_int_nokey ) NOT IN ( SELECT /*+prc_subquery() */ SQ1_alias2 . col_int_nokey AS SQ1_field1 , SQ1_alias1 . col_int_key AS SQ1_field2 FROM ( cc AS SQ1_alias1 , c AS SQ1_alias2 ) GROUP BY SQ1_field1 , SQ1_field2 );
SELECT alias2 . col_int_key , alias1 . col_int_nokey , alias2 . col_varchar_key AS field1 FROM ( cc AS alias1 , cc AS alias2 ) WHERE ( alias2 . col_int_key , alias1 . col_int_nokey ) NOT IN ( SELECT SQ1_alias2 . col_int_nokey AS SQ1_field1 , SQ1_alias1 . col_int_key AS SQ1_field2 FROM ( cc AS SQ1_alias1 , c AS SQ1_alias2 ) GROUP BY SQ1_field1 , SQ1_field2 );
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=tree SELECT alias2 . col_int_key , alias1 . col_int_nokey , alias2 . col_varchar_key AS field1 FROM ( cc AS alias1 , cc AS alias2 ) WHERE NOT(alias2.col_int_key >= ANY(SELECT /*+prc_subquery() */ SQ1_alias2 . col_int_nokey AS SQ1_field1 FROM ( cc AS SQ1_alias1 , c AS SQ1_alias2 ) WHERE SQ1_alias1.col_int_key = alias1.col_int_key GROUP BY SQ1_field1));
SELECT alias2 . col_int_key , alias1 . col_int_nokey , alias2 . col_varchar_key AS field1 FROM ( cc AS alias1 , cc AS alias2 ) WHERE NOT(alias2.col_int_key >= ANY(SELECT /*+prc_subquery() */ SQ1_alias2 . col_int_nokey AS SQ1_field1 FROM ( cc AS SQ1_alias1 , c AS SQ1_alias2 ) WHERE SQ1_alias1.col_int_key = alias1.col_int_key GROUP BY SQ1_field1));
SELECT alias2 . col_int_key , alias1 . col_int_nokey , alias2 . col_varchar_key AS field1 FROM ( cc AS alias1 , cc AS alias2 ) WHERE NOT(alias2.col_int_key >= ANY(SELECT SQ1_alias2 . col_int_nokey AS SQ1_field1 FROM ( cc AS SQ1_alias1 , c AS SQ1_alias2 ) WHERE SQ1_alias1.col_int_key = alias1.col_int_key GROUP BY SQ1_field1));
DROP TABLE c, cc;
