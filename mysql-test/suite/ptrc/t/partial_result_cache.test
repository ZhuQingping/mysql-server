SELECT /*+ join_prefix(t2,t3) join_prefix(t4,t5) */ t2.a
FROM t1 AS t2,
     t1 AS t3,
     LATERAL
  (SELECT t4.*
   FROM t1 AS t4,
        t1 AS t5
   WHERE t4.b < t5.b) AS tt
WHERE t2.b > t3.b;
SELECT /*+ join_prefix(t2,t3) join_prefix(t4,t5) */ t2.a
FROM t1 AS t2,
