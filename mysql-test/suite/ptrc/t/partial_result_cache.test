     LATERAL
  (SELECT t4.*
   FROM t1 AS t4,
        t1 AS t5
   WHERE t4.b < t5.b) AS tt
WHERE t2.b > t3.b;
SET optimizer_switch='materialization=off';
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT b FROM t1 WHERE (1+(SELECT t1.a FROM t1 as t2 LIMIT 1))
IN(SELECT t3.b FROM t1 as t3) ORDER BY 1;
SELECT b FROM t1 WHERE (1+(SELECT t1.a FROM t1 as t2 LIMIT 1)) IN
(SELECT t3.b FROM t1 as t3) ORDER BY 1;
SET rds_partial_result_cache_cost_threshold = 1;
--replace_regex /  \(cost.*//
EXPLAIN FORMAT=TREE SELECT b FROM t1 WHERE (1+(SELECT t1.a FROM t1 as t2 LIMIT 1))
IN(SELECT t3.b FROM t1 as t3) ORDER BY 1;
SELECT b FROM t1 WHERE (1+(SELECT t1.a FROM t1 as t2 LIMIT 1)) IN
