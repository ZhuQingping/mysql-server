CREATE PROCEDURE proc() BEGIN
SELECT t1.a FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
SELECT t1.a FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
END $$
