                -> Filter: (t2.a = t1.a)
                    -> Table scan on t2
        -> Result cache : cache keys(t1.a, t2.a)
            -> Filter: (t.a = t1.a)
                -> Table scan on t

select /*+ join_order(t1@s,t2@s,t) no_bnl() */ t.a from    t where t.a in (select /*+ no_semijoin(materialization,firstmatch,loosescan) qb_name(s) no_bnl() */ t1.a from t1, t1 as t2 where t1.a=t2.a) ;
