Note	1276	Field or reference 'test.t1.b' of SELECT #2 was resolved in SELECT #1
SELECT * FROM t1 WHERE t1.a in (SELECT 0.2 * avg(a) FROM t2 WHERE t2.b > t1.b GROUP BY a);
