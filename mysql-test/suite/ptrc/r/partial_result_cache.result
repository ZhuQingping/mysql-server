SET OPTIMIZER_TRACE='enabled=off';
EXPLAIN format=tree
SELECT /*+ join_prefix(t2,t3) join_prefix(t4,t5) */ t2.a
FROM t1 AS t2,
t1 AS t3,
LATERAL
(SELECT t4.*
FROM t1 AS t4,
t1 AS t5
WHERE t4.b < t5.b) AS tt
WHERE t2.b > t3.b;
EXPLAIN
-> Nested loop inner join
    -> Inner hash join (no condition)
        -> Index scan on t4 using idx
        -> Hash
            -> Nested loop inner join
                -> Index scan on t2 using idx
                -> Result cache : cache keys(t2.a, t2.b)
                    -> Filter: (t2.b > t3.b)
                        -> Index range scan on t3 (re-planned for each iteration)
    -> Result cache : cache keys(t2.a, t2.b, t3.b, t4.b)
        -> Filter: (t4.b < t5.b)
            -> Index range scan on t5 (re-planned for each iteration)

