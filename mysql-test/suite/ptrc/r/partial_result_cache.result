CREATE TABLE t1(a int, b int);
INSERT INTO t1 VALUES(1,2),(2,3),(2,3),(2,3),(2,4),(3,1);
CREATE TABLE t2(a int, b int);
INSERT INTO t2 VALUES(1,3),(2,4),(3,4);
INSERT INTO t2 SELECT * FROM t2;
INSERT INTO t2 SELECT * FROM t1;
"test caching of IN(subquery) using IN-to-EXISTS"
SET @old_optimizer_switch = @@optimizer_switch;
SET optimizer_switch='semijoin=off,partial_result_cache=on';
SET rds_partial_result_cache_cost_threshold = 0;
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b GROUP BY b);
EXPLAIN
-> Filter: <in_optimizer>(t1.a,<exists>(select #2))
    -> Table scan on t1
    -> Select #2 (subquery in condition; dependent)
        -> Result cache : cache keys(t1.a, t1.b)
            -> Limit: 1 row(s)
                -> Filter: ((t2.b > t1.b) and (<cache>(t1.a) = t2.b))
                    -> Table scan on t2

Warnings:
Note	1276	Field or reference 'test.t1.b' of SELECT #2 was resolved in SELECT #1
SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b GROUP BY b) ORDER BY a;
a	b
3	1
EXPLAIN ANALYZE format=tree SELECT * FROM t1 WHERE t1.a in (SELECT b FROM t2 WHERE t2.b > t1.b GROUP BY b) ORDER BY a;
EXPLAIN
-> Sort: t1.a 
    -> Filter: <in_optimizer>(t1.a,<exists>(select #2)) 
        -> Table scan on t1 
        -> Select #2 (subquery in condition; dependent)
            -> Result cache : cache keys(t1.a, t1.b) (Cache Hits: 2, Cache Misses: 4, Cache Evictions: 0, Cache Overflows: 0, Memory Usage: # )  (actual time=# loops=6)
                -> Limit: 1 row(s) 
                    -> Filter: ((t2.b > t1.b) and (<cache>(t1.a) = t2.b)) 
                        -> Table scan on t2 

Warnings:
Note	1276	Field or reference 'test.t1.b' of SELECT #2 was resolved in SELECT #1
"test of uncorrelated subquery using IN-to-EXISTS (correlation only in the left argument of IN),"
"the left argument is injected in the subquery's WHERE, so subquery becomes correlated,
"so PTRC is used".
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT /*+subquery(intoexists)*/ b FROM t2 GROUP BY b);
EXPLAIN
-> Filter: <in_optimizer>(t1.a,<exists>(select #2))
    -> Table scan on t1
    -> Select #2 (subquery in condition; dependent)
        -> Result cache : cache keys(t1.a)
            -> Limit: 1 row(s)
                -> Filter: (<cache>(t1.a) = t2.b)
                    -> Table scan on t2

"same test with materialization: subquery remains non-correlated => no PTRC"
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT /*+subquery(materialization)*/ b FROM t2 GROUP BY b);
EXPLAIN
-> Filter: <in_optimizer>(t1.a,t1.a in (select #2))
    -> Table scan on t1
    -> Select #2 (subquery in condition; run only once)
        -> Filter: ((t1.a = `<materialized_subquery>`.b))
            -> Limit: 1 row(s)
                -> Index lookup on <materialized_subquery> using <auto_distinct_key> (b=t1.a)
                    -> Materialize with deduplication
                        -> Table scan on t2

"subquery with aggregation inside"
EXPLAIN format=tree SELECT * FROM t1 WHERE t1.a in (SELECT 0.2 * avg(a) FROM t2 WHERE t2.b > t1.b GROUP BY a);
EXPLAIN
-> Filter: <in_optimizer>(t1.a,<exists>(select #2))
    -> Table scan on t1
    -> Select #2 (subquery in condition; dependent)
        -> Result cache : cache keys(t1.a, t1.b)
            -> Limit: 1 row(s)
                -> Filter: (<cache>(t1.a) = <ref_null_helper>((0.2 * avg(t2.a))))
                    -> Table scan on <temporary>
                        -> Aggregate using temporary table
                            -> Filter: (t2.b > t1.b)
                                -> Table scan on t2

