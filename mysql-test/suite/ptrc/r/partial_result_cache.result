CREATE FUNCTION func() RETURNS INT DETERMINISTIC BEGIN
DECLARE co INT;
DECLARE s INT;
SELECT count(*) INTO co FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
SELECT sum(t1.a) INTO s FROM t1, t2 WHERE t1.a > t2.a AND t1.b = t2.b;
RETURN co + s;
END $$
SELECT func() FROM t1;
