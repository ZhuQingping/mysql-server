"Verify that Item_in_subselect::was_null is properly stored in the cache as it"
" is necessary for when the subquery's inner value is NULL. We use NOT IN to"
" trigger the use of was_null"
SET rds_partial_result_cache_cost_threshold = 1;
CREATE TABLE c (
col_int_nokey INTEGER NOT NULL,
col_int_key INTEGER GENERATED ALWAYS AS 
(col_int_nokey + col_int_nokey) VIRTUAL,
col_varchar_nokey VARCHAR(1) NOT NULL,
col_varchar_key VARCHAR(2) GENERATED ALWAYS AS
(CONCAT(col_varchar_nokey, col_varchar_nokey)),
KEY (col_int_key),
KEY (col_int_key, col_varchar_key)
) ;
INSERT INTO c (
col_int_nokey,
col_varchar_nokey
) VALUES (8,'m');
CREATE TABLE cc (
col_int_nokey INTEGER,
col_int_key INTEGER GENERATED ALWAYS AS
(col_int_nokey + col_int_nokey) VIRTUAL,
col_varchar_nokey VARCHAR(1),
col_varchar_key VARCHAR(2) GENERATED ALWAYS AS
(CONCAT(col_varchar_nokey, col_varchar_nokey)),
KEY (col_int_key),
KEY (col_varchar_key),
KEY (col_int_key, col_varchar_key),
KEY (col_int_key, col_int_nokey),
KEY (col_varchar_key, col_varchar_nokey)
);
INSERT INTO cc (
col_int_nokey,
col_varchar_nokey
) VALUES (8,'e'),(NULL,NULL),(8,'p');
EXPLAIN FORMAT=tree SELECT alias2 . col_int_key , alias1 . col_int_nokey , alias2 . col_varchar_key AS field1 FROM ( cc AS alias1 , cc AS alias2 ) WHERE ( alias2 . col_int_key , alias1 . col_int_nokey ) NOT IN ( SELECT /*+prc_subquery() */ SQ1_alias2 . col_int_nokey AS SQ1_field1 , SQ1_alias1 . col_int_key AS SQ1_field2 FROM ( cc AS SQ1_alias1 , c AS SQ1_alias2 ) GROUP BY SQ1_field1 , SQ1_field2 );
EXPLAIN
-> Filter: <in_optimizer>((alias2.col_int_key,alias1.col_int_nokey),<exists>(select #2) is false)
    -> Inner hash join (no condition)
        -> Index scan on alias2 using col_int_key_2
        -> Hash
            -> Index scan on alias1 using col_int_key_3
    -> Select #2 (subquery in condition; dependent)
        -> Result cache : cache keys(alias1.col_int_nokey, alias2.col_int_key)
            -> Limit: 1 row(s)
                -> Filter: (<if>(outer_field_is_not_null, <is_not_null_test>(SQ1_alias2.col_int_nokey), true) and <if>(outer_field_is_not_null, <is_not_null_test>(SQ1_alias1.col_int_key), true))
                    -> Nested loop inner join
                        -> Filter: <if>(outer_field_is_not_null, ((<cache>(alias2.col_int_key) = SQ1_alias2.col_int_nokey) or <cache>((SQ1_alias2.col_int_nokey is null))), true)
                            -> Table scan on SQ1_alias2
                        -> Filter: <if>(outer_field_is_not_null, ((<cache>(alias1.col_int_nokey) = SQ1_alias1.col_int_key) or (SQ1_alias1.col_int_key is null)), true)
                            -> Alternative plans for IN subquery: Index lookup unless col_int_key IS NULL
                                -> Covering index lookup on SQ1_alias1 using col_int_key (col_int_key=<cache>(alias1.col_int_nokey) or NULL)
                                -> Table scan on SQ1_alias1

SELECT alias2 . col_int_key , alias1 . col_int_nokey , alias2 . col_varchar_key AS field1 FROM ( cc AS alias1 , cc AS alias2 ) WHERE ( alias2 . col_int_key , alias1 . col_int_nokey ) NOT IN ( SELECT /*+prc_subquery() */ SQ1_alias2 . col_int_nokey AS SQ1_field1 , SQ1_alias1 . col_int_key AS SQ1_field2 FROM ( cc AS SQ1_alias1 , c AS SQ1_alias2 ) GROUP BY SQ1_field1 , SQ1_field2 );
