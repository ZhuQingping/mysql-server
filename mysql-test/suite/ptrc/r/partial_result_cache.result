KEY ndx_c_street_2 (c_street_2) USING BTREE,
KEY ndx_c_city (c_city) USING BTREE,
KEY ndx_c_state (c_state) USING BTREE,
KEY ndx_c_zip (c_zip) USING BTREE,
KEY ndx_c_phone (c_phone) USING BTREE,
KEY ndx_c_since (c_since) USING BTREE,
KEY ndx_c_credit (c_credit) USING BTREE,
KEY ndx_c_credit_lim (c_credit_lim) USING BTREE,
KEY ndx_c_discount (c_discount) USING BTREE,
KEY ndx_c_balance (c_balance) USING BTREE,
KEY ndx_c_ytd_payment (c_ytd_payment) USING BTREE,
KEY ndx_c_payment_cnt (c_payment_cnt) USING BTREE,
KEY ndx_c_delivery_cnt (c_delivery_cnt) USING BTREE,
KEY ndx_c_data (c_data) USING BTREE,
KEY ndx_4_5_6 (c_first,c_middle,c_last) USING BTREE,
KEY ndx_7_8 (c_street_1,c_street_2) USING BTREE,
KEY ndx_9_10_11_12 (c_city,c_state,c_zip,c_phone) USING BTREE,
KEY ndx_13_14 (c_since,c_credit) USING BTREE,
KEY ndx_15_16_17_18 (c_credit_lim,c_discount,c_balance,c_ytd_payment) USING BTREE,
KEY ndx_19_20_21 (c_payment_cnt,c_delivery_cnt,c_data) USING BTREE,
KEY ndx_4_7_9_13_15_19 (c_first,c_street_1,c_city,c_since,c_credit_lim,c_payment_cnt) USING BTREE
);
