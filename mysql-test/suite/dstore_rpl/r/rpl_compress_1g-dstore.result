INSERT INTO t1 VALUES (LOAD_FILE('FILE'));
# Iteration 7/8
INSERT INTO t1 VALUES (LOAD_FILE('FILE'));
# Iteration 8/8
INSERT INTO t1 VALUES (LOAD_FILE('FILE'));
COMMIT;

