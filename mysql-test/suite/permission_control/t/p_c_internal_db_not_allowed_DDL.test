DROP FUNCTION f;
DROP PROCEDURE p;
DROP VIEW v1;

#         > test 8: non-super operating DCL
#                   Permission control does not affect the authorization operation.
#-----------------------------------------------------------------------------------
connection default;
CREATE USER 'normal_user'@'%' IDENTIFIED BY '123456';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, RELOAD, CREATE USER ON *.* TO 'normal_user'@'%' WITH GRANT OPTION;
FLUSH PRIVILEGES;
--echo # connect normal_user
connect(conn4,localhost,normal_user,123456,);
CREATE USER 'normal_user2'@'%' IDENTIFIED BY '123456';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, CREATE USER ON *.* TO 'normal_user2'@'%';
FLUSH PRIVILEGES;
query_vertical SELECT user,host,Select_priv,Insert_priv,Update_priv,Delete_priv,Create_priv,Drop_priv FROM mysql.user WHERE user = 'normal_user2';
REVOKE SELECT ON *.* FROM 'normal_user2'@'%';
SELECT user,host,Select_priv FROM mysql.user WHERE user = 'normal_user2';


#        > test 9: Users (not built-in users or non-super users) are
#                  allowed to  perform DML operations on table in the 
#                  `sys`, `mysql`.
#----------------------------------------------------------------------------
connection default;
USE mysql;
--disable_warnings
DROP TABLE IF EXISTS db1;
CREATE TABLE db1 SELECT * FROM db;

DROP TABLE IF EXISTS user1;
CREATE TABLE user1 SELECT * FROM user;
set global rds_internal_schema_dml_control=OFF;

--echo # connect root1
connection conn1;

# 1 Single-TABLE Delete
DELETE FROM mysql.user1 where user='root1';
# 2 Multi-TABLE Deletes
USE mysql;
DELETE mysql.db1, mysql.user1 FROM mysql.user1 INNER JOIN mysql.db1 where user1.User = db1.user;
# 3 Single-TABLE Update
UPDATE mysql.db1 set host='localhost' where user ='root1';
UPDATE sys.sys_config set value='ON' where variable ='diagnostics.allow_i_s_TABLEs';
# 4 Multi-TABLES Updates
USE mysql;
UPDATE mysql.db1, mysql.user1 set user1.host='localhost' where user1.user = db1.user;
# 5 INSERT
INSERT INTO mysql.user1(user, host, ssl_cipher, x509_issuer, x509_subject, authentication_string)
VALUES ('u2', 'h', '', '', '','123456');
# 6 INSERT ... SELECT
INSERT INTO mysql.user1 select * FROM mysql.user where Super_priv='T';
INSERT INTO sys.sys_config SELECT * FROM sys.sys_config where value='T';
REPLACE INTO mysql.user1(user, host, ssl_cipher, x509_issuer, x509_subject, authentication_string)
VALUES ('u2', 'h', '', '', '','*46ABF58B20022A84DF7B2E8B1AC8219C8DA71553');
REPLACE INTO mysql.user1 select * FROM mysql.user  where Super_priv='T';
REPLACE INTO sys.sys_config select * FROM sys.sys_config where value='T';

connection default;
set global rds_internal_schema_dml_control=ON;

#        > test 10: Users (not built-in users or non-super users) are
#                   not allowed to  perform DDL operations on table in the 
#                  `P_S`,'I_S'
#----------------------------------------------------------------------------
--echo # connect root1
connection conn1;
USE performance_schema;
--error ER_DBACCESS_DENIED_ERROR
CREATE TABLE t1(a int);
TRUNCATE TABLE events_statements_summary_by_host_by_event_name;
--error ER_TABLEACCESS_DENIED_ERROR
DROP TABLE socket_summary_by_instance;
USE information_schema;
--error ER_DBACCESS_DENIED_ERROR
CREATE TABLE t1(a int);
--error ER_DBACCESS_DENIED_ERROR
DROP TABLE t1;

connection default;
USE performance_schema;
--error ER_DBACCESS_DENIED_ERROR
CREATE TABLE t1(a int);
--error ER_TABLEACCESS_DENIED_ERROR
DROP TABLE events_statements_summary_by_host_by_event_name;

USE information_schema;
--error ER_DBACCESS_DENIED_ERROR
CREATE TABLE t1(a int);
--error ER_DBACCESS_DENIED_ERROR
DROP TABLE t1;

# end
--disable_warnings
connection default;
disconnect conn1;
disconnect conn2;
disconnect conn3;
disconnect conn4;
DROP USER super_user ,root1, normal_user, normal_user2;
--enable_warnings
--source include/wait_until_count_sessions.inc
source include/force_restart.inc;
