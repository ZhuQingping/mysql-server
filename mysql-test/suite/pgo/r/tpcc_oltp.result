SELECT COUNT(*) AS orphaned_new_orders FROM new_orders no LEFT JOIN orders o ON no.no_o_id = o.o_id AND no.no_d_id = o.o_d_id AND no.no_w_id = o.o_w_id WHERE o.o_id IS NULL;;
