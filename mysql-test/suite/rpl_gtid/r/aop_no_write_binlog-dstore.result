set global rds_maintenance_operation_write_binlog=on;
# [common user]
# This account has the same permission
# as the root account in the production environment.
[connection master]
create user 'test'@'localhost';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, RELOAD, PROCESS, REFERENCES, INDEX, ALTER, SHOW DATABASES, CREATE TEMPORARY TABLES, LOCK TABLES, EXECUTE, REPLICATION SLAVE, REPLICATION CLIENT, CREATE VIEW, SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, CREATE USER, EVENT, TRIGGER, CREATE ROLE, DROP ROLE ON *.* TO `test`@`localhost` WITH GRANT OPTION;
GRANT XA_RECOVER_ADMIN, SYSTEM_VARIABLES_ADMIN ON *.* TO 'test'@'localhost' WITH GRANT OPTION;
create table t2(id int);
insert into t2 values(1);
analyze table t2;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	OK
analyze table t2 update histogram on id;
Table	Op	Msg_type	Msg_text
test.t2	histogram	status	Histogram statistics created for column 'id'.
optimize table t2;
Table	Op	Msg_type	Msg_text
test.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t2	optimize	status	OK
repair table t2;
Table	Op	Msg_type	Msg_text
test.t2	repair	note	The storage engine for the table doesn't support repair
# login into the slave node as user test who does not
# have super & connection_amdin privileges.
include/sync_slave_sql_with_master.inc
# "slave info"
select current_user();
current_user()
test@localhost
set global rds_maintenance_operation_write_binlog=off;
select @@global.rds_maintenance_operation_write_binlog;
@@global.rds_maintenance_operation_write_binlog
0
analyze table t2;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	OK
analyze table t2 update histogram on id;
Table	Op	Msg_type	Msg_text
test.t2	histogram	status	Histogram statistics created for column 'id'.
optimize table t2;
ERROR HY000: The MySQL server is running with the --read-only option so it cannot execute this statement
set global rds_maintenance_operation_write_binlog=on;
analyze table t2;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	OK
analyze table t2 update histogram on id;
Table	Op	Msg_type	Msg_text
test.t2	histogram	status	Histogram statistics created for column 'id'.
analyze table t2;
Table	Op	Msg_type	Msg_text
test.t2	analyze	status	OK
optimize table t2;
ERROR HY000: The MySQL server is running with the --read-only option so it cannot execute this statement
repair table t2;
Table	Op	Msg_type	Msg_text
test.t2	repair	Error	The MySQL server is running with the --read-only option so it cannot execute this statement
test.t2	repair	error	Corrupt
include/assert.inc [No additional transaction is added on slave]
