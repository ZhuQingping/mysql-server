include/master-slave.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
#
# add switch rds_maintenance_operation_write_binlog
# to control ANALYZE/OPTIMIZE/REPAIR write binlog or not
#
# [root] [super & connection_amdin]
# This user has super & connection_amdin privileges, so
# analyze/optimize/repair can be execute on the slave node.
# When rds_maintenance_operation_write_binlog is set to off, these
# commands can not be recorded in binlog file.
# "master info"
[connection master]
drop table if exists t1;
set global rds_maintenance_operation_write_binlog=on;
create table t1(id int);
insert into t1 values(1);
analyze table t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
analyze table t1 update histogram on id;
Table	Op	Msg_type	Msg_text
test.t1	histogram	status	Histogram statistics created for column 'id'.
optimize table t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
repair table t1;
Table	Op	Msg_type	Msg_text
test.t1	repair	note	The storage engine for the table doesn't support repair
# analyze/optimize/repair can not be recorded in binlog file
# after rds_maintenance_operation_write_binlog is set to on.
set global rds_maintenance_operation_write_binlog=off;
insert into t1 values(2);
analyze table t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
analyze table t1 update histogram on id;
Table	Op	Msg_type	Msg_text
test.t1	histogram	status	Histogram statistics created for column 'id'.
optimize table t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
repair table t1;
Table	Op	Msg_type	Msg_text
test.t1	repair	note	The storage engine for the table doesn't support repair
set global rds_maintenance_operation_write_binlog=on;
include/show_binlog_events.inc
