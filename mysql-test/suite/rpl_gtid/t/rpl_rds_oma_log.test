--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/master-slave.inc

--source include/rpl_connection_master.inc
SET @start_master_global_rds_oma_log_file = @@global.rds_oma_log_file;
SET @start_master_global_oma_log = @@global.rds_oma_log;

--replace_result $MYSQL_TMP_DIR master_oma
eval SET GLOBAL rds_oma_log_file= '$MYSQL_TMP_DIR/my_oma1.log';
SET GLOBAL rds_oma_log = ON;
SET timestamp=10;

--source include/rpl_connection_slave.inc
SET @start_slave_global_rds_oma_log_file = @@global.rds_oma_log_file;
SET @start_slave_global_oma_log = @@global.rds_oma_log;

--replace_result $MYSQL_TMP_DIR slave_oma
eval SET GLOBAL rds_oma_log_file= '$MYSQL_TMP_DIR/my_oma2.log';
SET GLOBAL rds_oma_log = ON;
SET timestamp=10;

--source include/rpl_connection_master.inc
--disable_warnings
drop table if exists t1;
--enable_warnings
create table t1(id int);
insert into t1 values(1);
insert into t1 values(2);
insert into t1 values(3);

update t1 set id = 7 where id = 2;

delete from t1 where id = 7;

alter table t1 add column name varchar(10);

create user 'test'@'localhost' IDENTIFIED BY '123456';


let oma_LOG= `SELECT @@global.rds_oma_log_file`;

--perl
   use strict;

   my $file= $ENV{'oma_LOG'} or die("oma log not set");
   my $result=0;
 
   open(FILE, "$file") or die("Unable to open $file: $!");
   if (<FILE>) {
     my $line = $_;
   }
   while (<FILE>) {
     my $line = $_;
 
     if ($line !~ m/^(# Query_time|# Time|Tcp port|# User)|(Source distribution)/) {
       #$line =~ s/Thread_id: \d* Schema:/Thread_id: 0 Schema:/;
       #$line =~ m/(Rows_sent.*) Start.*/;
       print "$line";
     }
   }
   close(FILE);

EOF

--echo
--echo # dump content of OMA log end.
--echo

--source include/sync_slave_sql_with_master.inc

--source include/rpl_connection_slave.inc
select * from t1;
select user,host from mysql.user;
let slave_oma_LOG= `SELECT @@global.rds_oma_log_file`;

#slave rds_oma_log not record any operations
--perl
   use strict;

   my $file= $ENV{'slave_oma_LOG'} or die("oma log not set");
   my $result=0;
 
   open(FILE, "$file") or die("Unable to open $file: $!");
   if (<FILE>) {
     my $line = $_;
   }
   while (<FILE>) {
     my $line = $_;
 
     if ($line !~ m/^(# Query_time|# Time|Tcp port|# User)|(Source distribution)/) {
       #$line =~ s/Thread_id: \d* Schema:/Thread_id: 0 Schema:/;
       #$line =~ m/(Rows_sent.*) Start.*/;
       print "$line";
     }
   }
   close(FILE);

EOF

--echo
--echo # dump content of OMA log end.
--echo

--echo "clean up master"
--source include/rpl_connection_master.inc
drop user 'test'@'localhost';
drop table t1;
SET @@global.rds_oma_log_file = @start_master_global_rds_oma_log_file;
SET @@global.rds_oma_log = @start_master_global_oma_log;

--remove_file $MYSQL_TMP_DIR/my_oma1.log


--echo "clean up slave"
--source include/sync_slave_sql_with_master.inc
--source include/rpl_connection_slave.inc
SET @@global.rds_oma_log_file = @start_slave_global_rds_oma_log_file;
SET @@global.rds_oma_log = @start_slave_global_oma_log;

--remove_file $MYSQL_TMP_DIR/my_oma2.log

--source include/rpl_end.inc
