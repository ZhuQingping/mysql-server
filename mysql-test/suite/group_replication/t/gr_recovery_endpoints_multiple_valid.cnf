!include ../my.cnf

[mysqld.1]
mysqlx=OFF
admin-port=@mysqld.1.loose-mysqlx-port
admin-address=127.0.0.1
default-storage-engine=InnoDB
default_tmp_storage_engine=InnoDB
storage_engine_mode=ONLY_INNODB
disabled_storage_engines=CSV,Memory,Dstore,MyISAM,MRG_MyISAM

[mysqld.2]
default-storage-engine=InnoDB
default_tmp_storage_engine=InnoDB
storage_engine_mode=ONLY_INNODB
disabled_storage_engines=CSV,Memory,Dstore,MyISAM,MRG_MyISAM


