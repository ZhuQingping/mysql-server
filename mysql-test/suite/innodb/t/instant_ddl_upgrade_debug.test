--disable_query_log
CALL mtr.add_suppression("Plugin 'Dstore' init function returned error.");
CALL mtr.add_suppression("Plugin 'Dstore' registration as a STORAGE ENGINE failed.");
CALL mtr.add_suppression("boot dstore failed, ret=-1");
CALL mtr.add_suppression("Check dstore datadir no exists, startup fail");
--enable_query_log
##########################################################################
# Test script to test UPGRADE from older version table (not) having
# INSTANT ADD columns.
#
# This test is to be run in debug mode only and with debug flag
##########################################################################

--source include/have_debug.inc
let $is_debug=1;

--source suite/innodb/t/instant_ddl_upgrade.test
