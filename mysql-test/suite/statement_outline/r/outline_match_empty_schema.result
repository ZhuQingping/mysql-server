create database outline_db;
use outline_db;
create table t1 (a int, key ind_1(a)) engine=Dstore;
create table t2 (a int, key ind_1(a)) engine=Dstore;
create table t3 (a int, key ind_1(a)) engine=Dstore;
insert into t1 values (1),(2),(3),(4);
insert into t2 values (10),(20),(30),(40);
insert into t3 values (1),(2),(10),(50);
call dbms_outln.add_optimizer_outline('outline_db', '', 1, '/*+ MAX_EXECUTION_TIME(1000) */', "select a from outline_db.t3 where outline_db.t3.a in (select a from outline_db.t1 where a <= 3 union select * from outline_db.t2 where a <= 30)");
call dbms_outln.add_optimizer_outline('', '', 3, '/*+ INDEX(t2 ind_1) */', "select a from outline_db.t3 where outline_db.t3.a in (select a from outline_db.t1 where a <= 3 union select * from outline_db.t2 where a <= 30)");
call dbms_outln.show_outline();
