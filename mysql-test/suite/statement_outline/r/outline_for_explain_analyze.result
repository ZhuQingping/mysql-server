set @save_opt_outline_enabled = @@global.rds_opt_outline_enabled;
set global rds_opt_outline_enabled=on;
create database outline_db;
use outline_db;
create table t1(c1 int auto_increment primary key, c2 int, c3 varchar(100), key idx_2(c2), key idx_2_3(c2,c3));
call dbms_outln.add_index_outline('outline_db', '', 1, 'FORCE INDEX', 'idx_2_3', '', 'select c2 from t1 where c2 = 2');
explain select c2 from t1 where c2 = 2;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ref	idx_2_3	idx_2_3	5	const	#	#	Using index
