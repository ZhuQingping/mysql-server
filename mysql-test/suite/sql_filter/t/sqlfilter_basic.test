select * from mysql.rds_sql_filter_rules;
CALL delete_one_sql_filter_rule(0);

--echo #---- case: flush sql filter rules ------
SET GLOBAL rds_sqlfilter_control=on;
CREATE TABLE t1 (iddd INT, name VARCHAR(20));
INSERT INTO t1 VALUES (1,"a"),(2,"b"),(4,"d");
CREATE TABLE t2 (idd int, name VARCHAR(20));
INSERT INTO t2 VALUES (1,"a"),(2,"b");
CREATE TABLE t3 (iddd INT, name VARCHAR(20));

connection conn_rdsAdmin;
--replace_column 1 #
SELECT * FROM mysql.rds_sql_filter_rules;
SELECT * FROM t1 WHERE iddd > 1;

--echo "Add Rules"
insert into mysql.rds_sql_filter_rules(type, max_concurrency, key_str) values('SELECT', 0, 'SELECT~FROM~t1~WHERE~iddd');
insert into mysql.rds_sql_filter_rules(type, max_concurrency, key_str) values('UPDATE', 0, 'UPDATE~t1');
insert into mysql.rds_sql_filter_rules(type, max_concurrency, key_str) values('DELETE', 0, 'DELETE~FROM~t1');
insert into mysql.rds_sql_filter_rules(type, max_concurrency, key_str) values('INSERT', 0, 'INSERT~INTO~t1~VALUES');
insert into mysql.rds_sql_filter_rules(type, max_concurrency, key_str) values('INSERT', 0, 'INSERT~INTO~t3~SELECT');
--replace_column 1 #
SELECT * FROM mysql.rds_sql_filter_rules;

--echo "dbms_sqlfilter.flush_sql_filter"
CALL dbms_sqlfilter.flush_sql_filter();
--replace_column 1 #
CALL dbms_sqlfilter.show_sql_filter();

--echo "Verify Effect"
SET GLOBAL rds_sqlfilter_case_sensitive=on;
connection conn0;
SELECT * FROM t2 WHERE idd > 1 AND name = "a";
--error ER_QUERY_INTERRUPTED
SELECT * FROM t1 WHERE iddd > 1;
update t1 SET name="aa" WHERE iddd=1;
--error ER_QUERY_INTERRUPTED
UPDATE t1 SET name="a" WHERE iddd=1;
SELECT * FROM t1 where iddd = 1;

--error ER_QUERY_INTERRUPTED
INSERT INTO t1 VALUES (6,"d");
INSERT INTO t1 values (6,"d");
SELECT * FROM t1 where iddd > 5;
--error ER_QUERY_INTERRUPTED
DELETE FROM t1 WHERE iddd > 5;
SELECT * FROM t1 where iddd > 5;
delete FROM t1 WHERE iddd > 5;
SELECT * FROM t1 where iddd > 5;
--error ER_QUERY_INTERRUPTED
INSERT INTO t3 SELECT * FROM t1;
INSERT INTO t3 select * FROM t1;
TRUNCATE TABLE t3;

SET GLOBAL rds_sqlfilter_control=off;
--replace_column 1 #
SELECT * FROM mysql.rds_sql_filter_rules;
SELECT * FROM t1 WHERE iddd > 1 AND name = "a";
SELECT * FROM t1 WHERE iddd > 1;
UPDATE t1 SET name="a" WHERE iddd=1;
DELETE FROM t1 WHERE iddd > 5;
INSERT INTO t3 select * FROM t1;
TRUNCATE TABLE t3;
SET GLOBAL rds_sqlfilter_case_sensitive=default;

--replace_column 1 #
SELECT * FROM mysql.rds_sql_filter_rules;

--echo #---- case: drop sql filter rules (valid format) ------
