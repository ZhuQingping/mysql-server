--echo #----------- trigger -----------
call dbms_sqlfilter.add_sql_filter('UPDATE',10,"UPDATE~tmpp1~name","");
call dbms_sqlfilter.add_sql_filter('UPDATE',0,"UPDATE~tmpp2~name","");
--disable_warnings
CREATE TABLE tmpp1 (id int, name VARCHAR(128)) default charset='utf8';
CREATE TABLE tmpp2 (fid int, name VARCHAR(128)) default charset='utf8';
INSERT INTO tmpp1 values(1, '触发器');
INSERT INTO tmpp2 values(1, '测试');

DELIMITER $;
DROP trigger if exists tmpp1_update$
CREATE trigger tmpp1_update
after UPDATE on tmpp1
for each row
begin
    UPDATE tmpp2 SET name=new.name WHERE fid=new.id;
end$
DELIMITER ;$

SELECT * FROM tmpp1;
SELECT * FROM tmpp2;
UPDATE tmpp1 SET name='iu.com' WHERE id=1;
SELECT * FROM tmpp1;
SELECT * FROM tmpp2;
--enable_warnings

DROP table tmpp1;
DROP table tmpp2;

--echo #-----------The object of SQL filter is system database. ----
connection conn0;
SET GLOBAL rds_sqlfilter_control=on;
--echo 1.rds_sqlfilter_sys_table_control is off
set global rds_sqlfilter_sys_table_control = off;

create table tmp1 (a int);
insert into tmp1 values (1);
connection conn_rdsAdmin;
delete from mysql.rds_sql_filter_rules;
connection conn0;
call dbms_sqlfilter.flush_sql_filter();
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~FROM~mysql","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~FROM~sys","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~FROM~information_schema","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~FROM~performance_schema","");
SELECT 1 FROM information_schema.tables LIMIT 1;
SELECT 1 FROM tmp1,information_schema.tables LIMIT 1;
SELECT 1 FROM information_schema.tables,tmp1 LIMIT 1;
--replace_column 1 #
call dbms_sqlfilter.show_sql_filter();

--echo 2.rds_sqlfilter_sys_table_control is on
set GLOBAL rds_sqlfilter_sys_table_control = on;
--error ER_QUERY_INTERRUPTED
SELECT 1 FROM information_schema.tables LIMIT 1;
--error ER_QUERY_INTERRUPTED
SELECT 1 FROM tmp1,information_schema.tables LIMIT 1;
--error ER_QUERY_INTERRUPTED
SELECT 1 FROM information_schema.tables,tmp1 LIMIT 1;

SET @old_rds_sqlfilter_sys_table_control=@@global.rds_sqlfilter_sys_table_control;
drop table tmp1;
