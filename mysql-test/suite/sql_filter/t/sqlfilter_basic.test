CALL mtr.add_suppression("sql filter rules was set exceeding the max length");

CREATE USER 'rds'@'localhost' IDENTIFIED BY '123456';
GRANT ALL PRIVILEGES ON *.* TO 'rds'@'localhost' WITH GRANT OPTION;
GRANT ALL PRIVILEGES ON *.* TO 'rdsAdmin'@'localhost' WITH GRANT OPTION;

connection default;
SET @old_rds_sqlfilter_case_sensitive=@@global.rds_sqlfilter_case_sensitive;
SET @old_rds_sqlfilter_control=@@global.rds_sqlfilter_control;
SET @old_rds_sqlfilter_sys_table_control=@@global.rds_sqlfilter_sys_table_control;

