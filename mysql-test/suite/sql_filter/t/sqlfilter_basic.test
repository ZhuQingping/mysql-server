--echo #----------- store proceduce -----------
--echo # queries inside procedures or functions will not be affected.
connection conn0;
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~SELECT~ORDER~BY","");
CREATE TABLE t_encrypt(c2 INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
                       c3 CHAR(255) Default 'No text',
                       c4 JSON ,
                       c5 INT,
                       c6 INT,
                       KEY idx2 (c6)
                       );
DELIMITER |;
CREATE PROCEDURE read_t_encrypt()
begin
        declare i int default 1;
        while (i <= 5) DO
                SELECT * FROM (SELECT * FROM t_encrypt ORDER BY RAND() LIMIT 1) AS A WHERE A.c2 < 0 ;
                SET i = i + 1;
        end while;
end|
DELIMITER ;|
CALL read_t_encrypt();
connection conn_rdsAdmin;
