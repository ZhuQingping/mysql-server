CREATE TABLE `mesi` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `uuid` VARCHAR(36) NOT NULL,
  `batch_id` VARCHAR(36) NOT NULL,
  `platform_id` int(10) NOT NULL,
  `channel_id` int(10) DEFAULT NULL,
  `template_id` int(10) NOT NULL,
  `title` VARCHAR(64) DEFAULT NULL,
  `send_at` timestamp NULL DEFAULT NULL,
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` timestamp NULL DEFAULT NULL ON UPDATE CURRENT_TIMESTAMP,
  `deleted_at` timestamp NULL DEFAULT NULL,
  `sort` int(9) unsigned NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`) USING BTREE,
  KEY `idx_batch_id` (`batch_id`) USING BTREE,
  KEY `idx_send_at` (`send_at`),
  KEY `idx_uuid` (`uuid`)
) AUTO_INCREMENT=1;
PREPARE select_stmt FROM 'SELECT uuid, send_at FROM ((SELECT id, uuid, send_at FROM `mesi` WHERE platform_id = 1 AND channel_id = 17 AND `deleted_at` IS NULL ) UNION ALL ( SELECT id, uuid, send_at FROM `mesi` WHERE platform_id = 1 AND channel_id = 17 AND `deleted_at` IS NULL ) UNION ALL ( SELECT id, uuid, send_at FROM `mesi` WHERE platform_id = 1 AND channel_id = 17 AND `deleted_at` IS NULL ) UNION ALL ( SELECT id, uuid, send_at FROM `mesi` WHERE platform_id = 1 AND channel_id = 17 AND `deleted_at` IS NULL )) tb WHERE 1 = 1 ORDER BY send_at desc';
EXECUTE select_stmt;
delete from mysql.rds_sql_filter_rules;
call dbms_sqlfilter.flush_sql_filter();
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~UNION~ALL","");

connection conn0;
PREPARE select_stmt FROM 'SELECT uuid, send_at FROM ((SELECT id, uuid, send_at FROM `mesi` WHERE platform_id = 1 AND channel_id = 17 AND `deleted_at` IS NULL ) UNION ALL ( SELECT id, uuid, send_at FROM `mesi` WHERE platform_id = 1 AND channel_id = 17 AND `deleted_at` IS NULL ) UNION ALL ( SELECT id, uuid, send_at FROM `mesi` WHERE platform_id = 1 AND channel_id = 17 AND `deleted_at` IS NULL ) UNION ALL ( SELECT id, uuid, send_at FROM `mesi` WHERE platform_id = 1 AND channel_id = 17 AND `deleted_at` IS NULL )) tb WHERE 1 = 1 ORDER BY send_at desc';
--error ER_QUERY_INTERRUPTED
EXECUTE select_stmt;

call dbms_sqlfilter.add_sql_filter('UPDATE',0,"UPDATE~mesi","");
PREPARE update_stmt FROM 'UPDATE mesi set id = 0 where sort = 9';
--error ER_QUERY_INTERRUPTED
EXECUTE update_stmt;

call dbms_sqlfilter.add_sql_filter('DELETE',0,"DELETE~mesi","");
PREPARE delete_stmt FROM 'DELETE from mesi where id = 0';
--error ER_QUERY_INTERRUPTED
EXECUTE delete_stmt;

--replace_column 1 #
call dbms_sqlfilter.show_sql_filter();

DROP PREPARE select_stmt;
DROP PREPARE update_stmt;
DROP PREPARE delete_stmt;
DROP table mesi;
