SELECT * FROM tab2;
--error ER_SIGNAL_EXCEPTION
insert into mysql.rds_sql_filter_rules (type, max_concurrency, key_str) values ('DELETE', 0, 'DELETE~t666');
connection conn_rdsAdmin;
--replace_column 1 #
select * from mysql.rds_sql_filter_rules;
insert into mysql.rds_sql_filter_rules (type, max_concurrency, key_str) values ('DELETE', 0, 'DELETE~t666');
delete from mysql.rds_sql_filter_rules where key_str = 'DELETE~t666';

delete from mysql.rds_sql_filter_rules;
call dbms_sqlfilter.flush_sql_filter();

--echo #--------- case: force restart while lists have loaded in memory ----
connection conn_rdsAdmin;
SET GLOBAL rds_sqlfilter_control = ON;

CALL dbms_sqlfilter.add_sql_filter("SELECT",0,"SELECT~FROM~t1~WHERE~iddd","");
CALL dbms_sqlfilter.add_sql_filter("UPDATE",0,"UPDATE~t1","");
CALL dbms_sqlfilter.add_sql_filter("DELETE",0,"DELETE~FROM~t1","");
CALL dbms_sqlfilter.add_sql_filter("INSERT",0,"INSERT~INTO~t1~VALUES","");
CALL dbms_sqlfilter.add_sql_filter("INSERT",0,"INSERT~SELECT","");

CREATE TABLE t4 (iddd INT, name VARCHAR(20));

connection conn0;
--error ER_QUERY_INTERRUPTED
INSERT INTO t1 VALUES (6, 'e');
--error ER_QUERY_INTERRUPTED
INSERT INTO t4 SELECT * FROM t1;
--error ER_QUERY_INTERRUPTED
DELETE FROM t1 WHERE iddd > 5;

connection default;
--source include/kill_and_restart_mysqld.inc

SET GLOBAL rds_sqlfilter_control = ON;
--replace_column 1 #
select * from mysql.rds_sql_filter_rules;
--replace_column 1 #
CALL dbms_sqlfilter.show_sql_filter();

--error ER_QUERY_INTERRUPTED
DELETE FROM t1 WHERE iddd > 5;
--replace_column 1 #
CALL dbms_sqlfilter.show_sql_filter();

DROP TABLE t4;

connect(conn_rdsAdmin2, 127.0.0.1, rdsAdmin);
delete from mysql.rds_sql_filter_rules;
CALL dbms_sqlfilter.flush_sql_filter();

##--------- cleanup -----------
