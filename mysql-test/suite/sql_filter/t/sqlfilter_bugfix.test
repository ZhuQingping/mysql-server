--echo # BUG2025090408964 assert failure of dbms_sqlfilter.delete_sql_filter(cast(@delete1 as signed))

--let $TEST_SQL_FILE = $MYSQL_TMP_DIR/BUG2025090408964.sql

--write_file $TEST_SQL_FILE
call dbms_sqlfilter.add_sql_filter("SELECT", 10, "SELECT~FROM~hwsql_new_feature_sql_filter_001~WHErE", "");
select item_id,type,max_concurrency,key_str from mysql.rds_sql_filter_rules where upper(type)='SELECT' and lower(key_str) like '%hwsql_new_feature_sql_filter_001%' order by item_id desc limit 1;
select item_id into @select1 from mysql.rds_sql_filter_rules where upper(type)='SELECT' and lower(key_str) like '%hwsql_new_feature_sql_filter_001%' order by item_id desc limit 1;
call dbms_sqlfilter.delete_sql_filter(cast(@select1 as signed));
select count(*) from mysql.rds_sql_filter_rules where upper(type)='SELECT' and lower(key_str) like '%hwsql_new_feature_sql_filter_001%';
call dbms_sqlfilter.add_sql_filter("update", 1, "update~hwsql_new_feature_sql_filter_001_update1~set~+", "");
select item_id,type,max_concurrency,key_str from mysql.rds_sql_filter_rules where upper(type)='update' and lower(key_str) like '%hwsql_new_feature_sql_filter_001%' order by item_id desc limit 1;
select item_id into @update1 from mysql.rds_sql_filter_rules where upper(type)='UPDATE' and lower(key_str) like '%hwsql_new_feature_sql_filter_001_update1%+%' order by item_id desc limit 1;
call dbms_sqlfilter.delete_sql_filter(cast(@update1 as signed));
select count(*) from mysql.rds_sql_filter_rules where upper(type)='UPDATE' and lower(key_str) like '%hwsql_new_feature_sql_filter_001_update1%+%';
call dbms_sqlfilter.add_sql_filter("delete", 10086, "delete~from~hwsql_new_feature_sql_filter_001_delete1~where~a~<", "");
select item_id,type,max_concurrency,key_str from mysql.rds_sql_filter_rules where upper(type)='DELETE' and lower(key_str) like '%hwsql_new_feature_sql_filter_001_delete1%<%' order by item_id desc limit 1;
select item_id into @delete1 from mysql.rds_sql_filter_rules where upper(type)='DELETE' and lower(key_str) like '%hwsql_new_feature_sql_filter_001_delete1%<%' order by item_id desc limit 1;
call dbms_sqlfilter.delete_sql_filter(cast(@delete1 as signed));
select count(*) from mysql.rds_sql_filter_rules where upper(type)='DELETE' and lower(key_str) like '%hwsql_new_feature_sql_filter_001_delete1%<%';
EOF

--disable_query_log
--disable_result_log
--connect(con1, localhost, root,,)
let $1=10;
while ($1)
{
  --source $TEST_SQL_FILE
  dec $1;
}

--connect(con2, localhost, root,,)
let $1=100;
while ($1)
{
  --source $TEST_SQL_FILE
  dec $1;
}
--enable_query_log
--enable_result_log

--disconnect con1
--disconnect con2

connection default;
select * from mysql.rds_sql_filter_rules;
call dbms_sqlfilter.show_sql_filter();

--remove_file $TEST_SQL_FILE

# input parameter is string function with STRING result type 
call dbms_sqlfilter.add_sql_filter('select', 112, rpad('select~',1024,'b'), '');
select char_length(key_str) from mysql.rds_sql_filter_rules;
select item_id into @select1 from mysql.rds_sql_filter_rules where upper(type)='SELECT' and char_length(key_str) = 1024;
call dbms_sqlfilter.update_sql_filter(@select1, 'select', 112, concat('select~', repeat('a', 6), 'a'), '');
call dbms_sqlfilter.delete_sql_filter(@select1);

# input parameter is a function with INT result type
call dbms_sqlfilter.add_sql_filter('select', ABS(CEILING(-1.234)), 'select~t', '');
select item_id into @int_var from mysql.rds_sql_filter_rules where upper(type)='SELECT' and key_str = 'select~t';
call dbms_sqlfilter.update_sql_filter(STRCMP('a', 'b'), 'select', 1, 'select~t~in', '');
call dbms_sqlfilter.update_sql_filter(FLOOR(@int_var), 'select', bit_length('a'), 'select~t~in', '');
--replace_column 1 #
call dbms_sqlfilter.show_sql_filter();
call dbms_sqlfilter.delete_sql_filter(@int_var);

# input parameter is subquery
call dbms_sqlfilter.add_sql_filter('select', 1, 'select~t', '');
--error ER_OPERAND_COLUMNS
call dbms_sqlfilter.delete_sql_filter((select 1,2));
select item_id into @int_var from mysql.rds_sql_filter_rules where upper(type)='SELECT' and key_str = 'select~t';
call dbms_sqlfilter.delete_sql_filter((select @int_var));

call dbms_sqlfilter.show_sql_filter();

--echo #
--echo # BUG2025092335115 flush_sql_filter not trim white-space character for key_str
--echo #
create table t1(id int);
call dbms_sqlfilter.add_sql_filter('select', 0, 'select~t1~id~ +', '');
call dbms_sqlfilter.add_sql_filter('update', 0, 'update~t1~id~ +', '');
call dbms_sqlfilter.add_sql_filter('delete', 0, 'delete~t1~id~ +', '');
call dbms_sqlfilter.add_sql_filter('insert', 0, 'insert~t1~values~ +', '');
--error ER_QUERY_INTERRUPTED
select * from t1 where id=1+1;
--error ER_QUERY_INTERRUPTED
update t1 set id=1+1;
--error ER_QUERY_INTERRUPTED
delete from t1 where id=1+1;
--error ER_QUERY_INTERRUPTED
insert into t1 values(1+1);

call dbms_sqlfilter.flush_sql_filter();
--error ER_QUERY_INTERRUPTED
select * from t1 where id=1+1;
--error ER_QUERY_INTERRUPTED
update t1 set id=1+1;
--error ER_QUERY_INTERRUPTED
delete from t1 where id=1+1;
--error ER_QUERY_INTERRUPTED
insert into t1 values(1+1);

call delete_one_sql_filter_rule(0);
call delete_one_sql_filter_rule(0);
call delete_one_sql_filter_rule(0);
call delete_one_sql_filter_rule(0);
call dbms_sqlfilter.show_sql_filter();
drop table t1;

SET GLOBAL rds_sqlfilter_control=@old_rds_sqlfilter_control;
--source ../include/sqlfilter_cleanup.inc
