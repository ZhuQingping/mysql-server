--replace_regex /\([0-9]+/(#/
eval call dbms_sqlfilter.update_sql_filter($item_id1,'SELECT',1,"SELECT~t24","");
SET DEBUG_SYNC='dec_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
--send select * from t24;

connection con1;
SET DEBUG_SYNC='match_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue1';
--send select * from t24;

connection con2;
SET DEBUG_SYNC='now WAIT_FOR waiting';
--send select * from t24;

connection con3;
