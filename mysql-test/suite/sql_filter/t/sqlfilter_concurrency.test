--echo #
--echo # Test add_sql_filter/delete_sql_filter/update_sql_filter/flush_sql_filter/show_sql_filter/
--echo # match sqlfilter/dec sqlfilter concurrency
--echo #
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source ../include/sqlfilter_prepare.inc

connect (con1, localhost, root);
connect (con2, localhost, root);
connect (con3, localhost, root);
--echo #
--echo # Test add_sql_filter and add_sql_filter concurrency
--echo #
connection con1;
SET DEBUG_SYNC='add_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
--send call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t1","");

connection con2;
SET DEBUG_SYNC='now WAIT_FOR waiting';
--send call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t2","");

connection con3;
let $wait_condition= SELECT COUNT(*) > 0 FROM information_schema.processlist
                     WHERE info LIKE 'call dbms_sqlfilter.add_sql_filter%' AND
                     state='Waiting for table metadata lock';
source include/wait_condition.inc;
SET DEBUG_SYNC='now SIGNAL continue';

connection con1;
--reap

connection con2;
--reap

call delete_one_sql_filter_rule(0);
call delete_one_sql_filter_rule(0);

--echo #
--echo # Test add_sql_filter and delete_sql_filter concurrency
