--echo #
--echo # Test match sql_filter and match sql_filter concurrency
--echo #
connection default;
--replace_regex /\([0-9]+/(#/
eval call dbms_sqlfilter.update_sql_filter($item_id1,'SELECT',0,"SELECT~t24","");
create table t24 (id int);
insert into t24 values(1);
SET GLOBAL rds_sqlfilter_control=on;

connection con1;
SET DEBUG_SYNC='match_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
--send select * from t24;

connection con2;
SET DEBUG_SYNC='now WAIT_FOR waiting';
--send select * from t24;

connection con3;
SET DEBUG_SYNC='now SIGNAL continue';

connection con1;
--error ER_QUERY_INTERRUPTED
--reap

connection con2;
--error ER_QUERY_INTERRUPTED
--reap

connection con3;
--replace_column 1 #
call dbms_sqlfilter.show_sql_filter();

--echo #
--echo # Test match sql_filter and dec sql_filter concurrency
--echo #
