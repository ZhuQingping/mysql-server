#
# Test add_sql_filter/delete_sql_filter/update_sql_filter/flush_sql_filter/show_sql_filter/
# match sqlfilter/dec sqlfilter concurrency
#
CREATE PROCEDURE delete_one_sql_filter_rule(IN offset_value INT)
begin
declare my_var BIGINT default 1;
select item_id into my_var from mysql.rds_sql_filter_rules limit offset_value,1;
call dbms_sqlfilter.delete_sql_filter(my_var);
end |
#
# Test add_sql_filter and add_sql_filter concurrency
#
SET DEBUG_SYNC='add_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t1","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t2","");;
SET DEBUG_SYNC='now SIGNAL continue';
call delete_one_sql_filter_rule(0);
call delete_one_sql_filter_rule(0);
#
# Test add_sql_filter and delete_sql_filter concurrency
#
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t3","");
SET DEBUG_SYNC='add_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t4","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now SIGNAL continue';
SET DEBUG_SYNC='del_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t5","");;
SET DEBUG_SYNC='now SIGNAL continue';
call delete_one_sql_filter_rule(0);
#
# Test add_sql_filter and update_sql_filter concurrency
#
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t6","");
SET DEBUG_SYNC='add_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t7","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',10,"SELECT~t6","");;
SET DEBUG_SYNC='now SIGNAL continue';
SET DEBUG_SYNC='update_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',0,"SELECT~t6","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t8","");;
SET DEBUG_SYNC='now SIGNAL continue';
call delete_one_sql_filter_rule(0);
call delete_one_sql_filter_rule(0);
call delete_one_sql_filter_rule(0);
#
# Test add_sql_filter and show_sql_filter concurrency
#
SET DEBUG_SYNC='add_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t9","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.show_sql_filter();;
SET DEBUG_SYNC='now SIGNAL continue';
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	0	2	0	SELECT~t9	
SET DEBUG_SYNC='show_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.show_sql_filter();;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t10","");;
SET DEBUG_SYNC='now SIGNAL continue';
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	0	2	0	SELECT~t9	
call delete_one_sql_filter_rule(0);
call delete_one_sql_filter_rule(0);
call dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#
# Test add_sql_filter and flush_sql_filter concurrency
#
SET DEBUG_SYNC='add_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t11","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.flush_sql_filter();;
SET DEBUG_SYNC='now SIGNAL continue';
SET DEBUG_SYNC='flush_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.flush_sql_filter();;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t12","");;
SET DEBUG_SYNC='now SIGNAL continue';
call delete_one_sql_filter_rule(0);
call delete_one_sql_filter_rule(0);
call dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#
# Test delete_sql_filter and detete_sql_filter concurrency
#
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t13","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t14","");
SET DEBUG_SYNC='del_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now SIGNAL continue';
#
# Test delete_sql_filter and update_sql_filter concurrency
#
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t15","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t16","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t17","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t18","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t19","");
# delete_sql_filter and update_sql_filter same sql_filter
SET DEBUG_SYNC='del_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',10,"SELECT~t15","");;
SET DEBUG_SYNC='now SIGNAL continue';
# delete_sql_filter and update_sql_filter not same sql_filter
SET DEBUG_SYNC='del_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',10,"SELECT~t16","");;
SET DEBUG_SYNC='now SIGNAL continue';
# update_sql_filter and delete_sql_filter same sql_filter
SET DEBUG_SYNC='update_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',10,"SELECT~t17","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now SIGNAL continue';
# update_sql_filter and delete_sql_filter not same sql_filter
SET DEBUG_SYNC='update_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',10,"SELECT~t17","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now SIGNAL continue';
call dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	10	2	0	SELECT~t17	
call delete_one_sql_filter_rule(0);
#
# Test delete_sql_filter and show_sql_filter concurrency
#
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t20","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t21","");
SET DEBUG_SYNC='delete_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.show_sql_filter();;
SET DEBUG_SYNC='now SIGNAL continue';
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	0	2	0	SELECT~t21	
SET DEBUG_SYNC='show_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.show_sql_filter();;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now SIGNAL continue';
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	0	2	0	SELECT~t21	
#
# Test delete_sql_filter and flush_sql_filter concurrency
#
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t22","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t23","");
SET DEBUG_SYNC='delete_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.flush_sql_filter();;
SET DEBUG_SYNC='now SIGNAL continue';
SET DEBUG_SYNC='flush_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.flush_sql_filter();;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.delete_sql_filter(#);;
SET DEBUG_SYNC='now SIGNAL continue';
#
# Test update_sql_filter and update_sql_filter concurrency
#
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t24","");
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~t25","");
# udpate same sql_filter
SET DEBUG_SYNC='update_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',10,"SELECT~t24","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',11,"SELECT~t24","");;
SET DEBUG_SYNC='now SIGNAL continue';
# udpate not same sql_filter
SET DEBUG_SYNC='update_sql_filter_after_open_table SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',20,"SELECT~t24","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',11,"SELECT~t25","");;
SET DEBUG_SYNC='now SIGNAL continue';
#
# Test update_sql_filter and show_sql_filter concurrency
#
SET DEBUG_SYNC='update_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',10,"SELECT~t24","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.show_sql_filter();;
SET DEBUG_SYNC='now SIGNAL continue';
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	11	2	0	SELECT~t25	
#	SELECT	0	10	2	0	SELECT~t24	
SET DEBUG_SYNC='show_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.show_sql_filter();;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',10,"SELECT~t24","");;
SET DEBUG_SYNC='now SIGNAL continue';
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	11	2	0	SELECT~t25	
#	SELECT	0	10	2	0	SELECT~t24	
#
# Test update_sql_filter and flush_sql_filter concurrency
#
SET DEBUG_SYNC='update_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',10,"SELECT~t24","");;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.flush_sql_filter();;
SET DEBUG_SYNC='now SIGNAL continue';
SET DEBUG_SYNC='flush_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.flush_sql_filter();;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.update_sql_filter(#,'SELECT',10,"SELECT~t24","");;
SET DEBUG_SYNC='now SIGNAL continue';
#
# Test show_sql_filter and show_sql_filter concurrency
#
SET DEBUG_SYNC='show_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.show_sql_filter();;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.show_sql_filter();;
SET DEBUG_SYNC='now SIGNAL continue';
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	11	2	0	SELECT~t25	
#	SELECT	0	10	2	0	SELECT~t24	
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	11	2	0	SELECT~t25	
#	SELECT	0	10	2	0	SELECT~t24	
#
# Test show_sql_filter and flush_sql_filter concurrency
#
SET DEBUG_SYNC='show_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.show_sql_filter();;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.flush_sql_filter();;
SET DEBUG_SYNC='now SIGNAL continue';
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	11	2	0	SELECT~t25	
#	SELECT	0	10	2	0	SELECT~t24	
SET DEBUG_SYNC='flush_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.flush_sql_filter();;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.show_sql_filter();;
SET DEBUG_SYNC='now SIGNAL continue';
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	11	2	0	SELECT~t25	
#	SELECT	0	10	2	0	SELECT~t24	
#
# Test flush_sql_filter and flush_sql_filter concurrency
#
SET DEBUG_SYNC='flush_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
call dbms_sqlfilter.flush_sql_filter();;
SET DEBUG_SYNC='now WAIT_FOR waiting';
call dbms_sqlfilter.flush_sql_filter();;
SET DEBUG_SYNC='now SIGNAL continue';
#
# Test match sql_filter and match sql_filter concurrency
#
call dbms_sqlfilter.update_sql_filter(#,'SELECT',0,"SELECT~t24","");
create table t24 (id int);
insert into t24 values(1);
SET GLOBAL rds_sqlfilter_control=on;
SET DEBUG_SYNC='match_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
select * from t24;;
SET DEBUG_SYNC='now WAIT_FOR waiting';
select * from t24;;
SET DEBUG_SYNC='now SIGNAL continue';
ERROR 70100: Query execution was interrupted
ERROR 70100: Query execution was interrupted
call dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	11	2	0	SELECT~t25	
#	SELECT	0	0	2	2	SELECT~t24	
#
# Test match sql_filter and dec sql_filter concurrency
#
call dbms_sqlfilter.update_sql_filter(#,'SELECT',1,"SELECT~t24","");
SET DEBUG_SYNC='dec_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue';
select * from t24;;
SET DEBUG_SYNC='match_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue1';
select * from t24;;
SET DEBUG_SYNC='now WAIT_FOR waiting';
select * from t24;;
SET DEBUG_SYNC='now SIGNAL continue1';
ERROR 70100: Query execution was interrupted
ERROR 70100: Query execution was interrupted
call dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	11	2	0	SELECT~t25	
#	SELECT	1	1	2	4	SELECT~t24	
SET DEBUG_SYNC='dec_sql_filter_after_map_lock SIGNAL waiting WAIT_FOR continue2';
select * from t24;;
SET DEBUG_SYNC='now SIGNAL continue2';
SET DEBUG_SYNC='now SIGNAL continue';
ERROR 70100: Query execution was interrupted
id
1
call dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	11	2	0	SELECT~t25	
#	SELECT	0	1	2	5	SELECT~t24	
call delete_one_sql_filter_rule(0);
call delete_one_sql_filter_rule(0);
call dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#
# dbms_sqlfilter.flush_sql_filter() will set m_cur_concur to zero
# in high-concurrency scenarios, m_cur_concur may be reduced to ULONG_MAX
call dbms_sqlfilter.add_sql_filter('SELECT',0,"SELECT~FROM","");
call dbms_sqlfilter.add_sql_filter('SELECT',1,"SELECT~FROM","");
SET DEBUG_SYNC= 'before_reduce_sqlfilter_item_concurrency WAIT_FOR go';
select * from t24;;
select sleep(1);
sleep(1)
0
call delete_one_sql_filter_rule(0);
call dbms_sqlfilter.flush_sql_filter();
SET DEBUG_SYNC= 'now SIGNAL go';
id
1
call dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	1	2	0	SELECT~FROM	
call delete_one_sql_filter_rule(0);
call dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
SET GLOBAL rds_sqlfilter_control=default;
drop table t24;
DROP PROCEDURE delete_one_sql_filter_rule;
