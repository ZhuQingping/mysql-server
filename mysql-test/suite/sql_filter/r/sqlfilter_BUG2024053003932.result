CREATE PROCEDURE delete_one_sql_filter_rule(IN offset_value INT)
begin
declare my_var BIGINT default 1;
select item_id into my_var from mysql.rds_sql_filter_rules limit offset_value,1;
call dbms_sqlfilter.delete_sql_filter(my_var);
end |
set global rds_sqlfilter_control = on;
use test;
CALL dbms_sqlfilter.add_sql_filter("SELECT",0,"SELECT~FROM","");
SELECT * FROM mysql.rds_sql_filter_rules;
item_id	type	max_concurrency	key_str	node_id
#	SELECT	0	SELECT~FROM	
CALL dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	0	2	0	SELECT~FROM	
create table t1(a int);
select * from t1;
ERROR 70100: Query execution was interrupted
drop table t1;
#
# mysql
#
create database mysql_test;
use mysql_test;
SELECT * FROM mysql.rds_sql_filter_rules;
item_id	type	max_concurrency	key_str	node_id
#	SELECT	0	SELECT~FROM	
CALL dbms_sqlfilter.show_sql_filter();
item_id	type	cur_concur	max_concurrency	key_num	cur_reject	key_str	node_id
#	SELECT	0	0	2	1	SELECT~FROM	
create table t1(a int);
select * from t1;
ERROR 70100: Query execution was interrupted
drop table t1;
