#--source include/not_have_only_dstore.inc

--echo # Test: list-list

set @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
set global rds_extended_partitions_enabled = true;
set @loose_partition_restriction=@@rds_loose_partition_restriction;

create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values in (3, 4)(
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values in (5, 6)(
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  )
);

insert into t1(part_no, amount) values(1,1),(1,2),(1,3),(1,4),(1,5),(1,6);
insert into t1(part_no, amount) values(3,1),(3,2),(3,3),(3,4),(3,5),(3,6);
insert into t1(part_no, amount) values(5,1),(5,2),(5,3),(5,4),(5,5),(5,6);

select * from t1;
--replace_column 10 # 11 #
explain select * from t1 where part_no = 1;
--replace_column 10 # 11 #
explain select * from t1 where part_no = 1 and amount = 4;
select * from t1 where amount = 4;
--replace_column 10 # 11 #
explain select * from t1 where amount = 4;

--error ER_NO_PARTITION_FOR_GIVEN_VALUE
insert into t1(part_no, amount) values(1,8);

--error ER_NO_PARTITION_FOR_GIVEN_VALUE
insert into t1(part_no, amount) values(8,1);

select part_no, amount from t1 partition(partno7);
update t1 partition(partno7) set part_no = part_no + 1;
select part_no, amount from t1 partition(partno7);
delete from t1 partition(partno7);
select part_no, amount from t1 partition(partno7);

drop table t1;

# Test : subpartitions

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no) subpartitions 3
(
  partition p0 values in (1, 2),
  partition p1 values in (3, 4),
  partition p2 values in (5, 6)
);

--error ER_PARSE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no) subpartitions 2
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values in (3, 4)(
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values in (5, 6)(
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  )
);

create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no) subpartitions 3
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values in (3, 4)(
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values in (5, 6)(
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  )
);
show create table t1;
drop table t1;

# Test : partition name must be unique within the table.
--error ER_SAME_NAME_PARTITION
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno0 values in (3, 4)
  )
);

--error ER_SAME_NAME_PARTITION
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  ),
  partition p1 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno2 values in (3, 4)
  )
);

--error ER_SAME_NAME_PARTITION
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  ),
  partition p1 values in (1, 2)(
    subpartition p0 values in (1, 2),
    subpartition partno2 values in (3, 4)
  )
);

# Test : number of subpartitions must be same for every part_defination

--error ER_PARSE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  ),
  partition p1 values in (1, 2)(
    subpartition partno2 values in (1, 2)
  )
);

--error ER_PARSE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2)
  ),
  partition p1 values in (1, 2)(
    subpartition partno2 values in (1, 2),
    subpartition partno1 values in (3, 4)
  )
);

# Test : must be defining subpartition defination for list type
--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2)
);

--error ER_PARSE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2) (
    subpartition p0sp0 values in (1)
  ),
  partition p1 values in (3, 4)
);

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2),
  partition p1 values in (3, 4)(
    subpartition p0sp0 values in (1)
  )
);

# Test: list type's value defination is values in

--error ER_PARTITION_WRONG_VALUES_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2) (
    subpartition p0sp0 values less than(3)
  )
);

# Test: expr/value must be INT type

--error ER_VALUES_IS_NOT_INT_TYPE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2) (
    subpartition p0sp0 values in ('XiAN')
  )
);

--error ER_VALUES_IS_NOT_INT_TYPE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (date)
(
  partition p0 values in (1, 2) (
    subpartition p0sp0 values in ('2021-01-01')
  )
);

--error ER_FIELD_TYPE_NOT_ALLOWED_AS_PARTITION_FIELD
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (date)
(
  partition p0 values in (1, 2) (
    subpartition p0sp0 values in (1)
  )
);

create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (dept_no)
subpartition by list (part_no + amount)
(
  partition p0 values in (1, 2) (
    subpartition p0sp0 values in (1,2,3,90,34),
    subpartition p0sp2 values in (4,5,6)
  )
);
show create table t1;
insert into t1(dept_no, part_no, amount) values(1,1,1),(1,1,2);
--error ER_NO_PARTITION_FOR_GIVEN_VALUE
insert into t1(dept_no, part_no, amount) values(2,5,2);
select * from t1 where part_no = 1 and amount = 1;
--replace_column 10 # 11 #
explain select * from t1 where part_no = 1 and amount = 1;
drop table t1;

--echo #
--echo # DDL for list-list
--echo #

# Test: add partition
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition p0sp0 values in (1, 2),
    subpartition p0sp1 values in (3, 4)
  ),
  partition p1 values in (3, 4)(
    subpartition p1sp0 values in (1, 2),
    subpartition p1sp1 values in (3, 4)
  )
);

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
alter table t1 add partition (
  partition p2 values in (5, 6)
);

--error ER_PARTITION_WRONG_VALUES_ERROR
alter table t1 add partition (
  partition p2 values in (5, 6) (
    subpartition p2sp0 values less than (5),
    subpartition p2sp0 values less than (6)
  )
);

--error ER_PARTITION_WRONG_VALUES_ERROR
alter table t1 add partition (
  partition p2 values in (5, 6) (
    subpartition p2sp0 values less than (5),
    subpartition p2sp0 values in (6)
  )
);

--error ER_ADD_PARTITION_SUBPART_ERROR
alter table t1 add partition (
  partition p2 values in (5, 6) (
    subpartition p2sp0 values in (5, 6)
  )
);

--error ER_PARTITION_COLUMN_LIST_ERROR
alter table t1 add partition (
  partition p2 values in (5, 6) (
    subpartition p2sp0 values in ((5,6),(6,7))
  )
);

alter table t1 add partition (
  partition p2 values in (5, 6) (
    subpartition p2sp0 values in (1, 2),
    subpartition p2sp1 values in (3, 4)
  )
);
show create table t1;
alter table t1 remove partitioning;
show create table t1;

--error ER_PARTITION_MGMT_ON_NONPARTITIONED
alter table t1 add partition (
  partition p3 values in (7,8) (
    subpartition p3sp0 values in (1, 2),
    subpartition p3sp1 values in (3, 4)
  )
);
drop table t1;

# Test: converting a Non-partitioned Table to a Partitioned Table

create table t1 (
`a` int ,
`b` int ,
primary Key(a, b));

insert into t1 values(1,1),(2,1),(3,1),(4,1),(111,111),(3333,333);

alter table t1 partition by list(a) subpartition by list(b) (
  partition p0 values in (1, 2, 3, 4) (
    subpartition p0sp0 values in (1),
    subpartition p0sp1 values in (111),
    subpartition p0sp2 values in (333)
  ),
  partition p1 values in (111, 3333) (
    subpartition p1sp0 values in (1),
    subpartition p1sp1 values in (111),
    subpartition p1sp2 values in (333)
  )
);
show create table t1;

select * from t1 partition(p0sp0);
select * from t1 partition(p0);
select * from t1 partition(p1);

--error ER_NO_PARTITION_FOR_GIVEN_VALUE
alter table t1 partition by list(a) subpartition by list(b) (
  partition p0 values in (1, 2, 3, 4) (
    subpartition p0sp0 values in (1),
    subpartition p0sp1 values in (111),
    subpartition p0sp2 values in (333)
  ),
  partition p1 values in (111) (
    subpartition p1sp0 values in (1),
    subpartition p1sp1 values in (111),
    subpartition p1sp2 values in (3)
  )
);

# Test: drop partition

--error ER_DROP_PARTITION_NON_EXISTENT
alter table t1 drop partition p0sp0;
# Currently, we only support copy algorithm for partitioned tables in DStore.
# The default for MySQL for DROP PARTITION is the inplace algorithm.
# The behavior for inplace and copy algorithm is different for drop partition
# (i.e. there is an error for copy).
#alter table t1 drop partition p1;

show create table t1;
select * from t1;
select partition_name, subpartition_name, table_rows from
  information_schema.partitions where table_name = 't1';

--echo # Test for truncate partition

alter table t1 truncate partition p0sp0;
show create table t1;
select * from t1 partition(p0sp0);

insert into t1 values(1, 111),(2, 333);
select * from t1 partition(p0);
alter table t1 truncate partition p0;
select * from t1 partition(p0);

drop table t1;

# Test: for reorganize partition
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values in (3, 4)(
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values in (5, 6)(
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  )
);
--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values in (3, 4)
);

--error ER_PARTITION_WRONG_NO_SUBPART_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values in (3, 4) (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  )
);

--error ER_PARTITION_WRONG_VALUES_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values in (3, 4) (
    subpartition partno0 values less than (1),
    subpartition partno1 values less than (3)
  )
);

--error ER_PARTITION_WRONG_VALUES_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values in (3, 4) (
    subpartition partno0 values in (1,2,4,5,6),
    subpartition partno1 values less than (3)
  )
);

--error ER_PARSE_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values in (3, 4) (
    subpartition p1partno0 values in (1, 2),
    subpartition p1partno1 values in (3, 4),
    subpartition p1partno2 values in (5, 6)
  ),
  partition p3 values in (7, 8) (
    subpartition p3partno0 values in (1, 2),
    subpartition p3partno1 values in (3, 4)
  )
);

--error ER_PARSE_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values in (3, 4) (
    subpartition p1partno0 values in (1, 2),
    subpartition p1partno1 values in (3, 4),
    subpartition p1partno2 values in (5, 6)
  ),
  partition p3 values in (7, 8)
);

# value range can be expanded
alter table t1 reorganize partition p1 into (
  partition p1 values in (3, 4) (
    subpartition p1partno0 values in (1, 2),
    subpartition p1partno1 values in (3, 4),
    subpartition p1partno2 values in (5, 6)
  ),
  partition p3 values in (7, 8) (
    subpartition p3partno0 values in (1, 2),
    subpartition p3partno1 values in (3, 4),
    subpartition p3partno2 values in (5, 6)
  )
);
show create table t1;
drop table t1;

create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values in (3, 4)(
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values in (5, 6)(
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  )
);
insert into t1(part_no, amount) values(1,1),(1,2),(1,3),(1,4),(1,5),(1,6);
insert into t1(part_no, amount) values(3,1),(3,2),(3,3),(3,4),(3,5),(3,6);
insert into t1(part_no, amount) values(5,1),(5,2),(5,3),(5,4),(5,5),(5,6);

# 1. modify partition definition
select * from t1 partition(p1);
select * from t1 partition(partno3);
select * from t1 partition(partno4);
select * from t1 partition(partno5);
alter table t1 reorganize partition p1 into (
  partition p1 values in (3, 4) (
    subpartition partno3 values in (1),
    subpartition partno4 values in (2),
    subpartition partno5 values in (3, 4, 5, 6)
  )
);
show create table t1;
select * from t1 partition(p1);
select * from t1 partition(partno3);
select * from t1 partition(partno4);
select * from t1 partition(partno5);

select * from t1 partition(p0);
select * from t1 partition(partno1);
select * from t1 partition(partno2);
select * from t1 partition(partno3);
alter table t1 reorganize partition p0 into (
  partition p0 values in (1, 2) (
    subpartition partno0 values in (3,4),
    subpartition partno1 values in (1,6),
    subpartition partno2 values in (2,5)
  )
);
show create table t1;
select * from t1 partition(p0);
select * from t1 partition(partno0);
select * from t1 partition(partno1);
select * from t1 partition(partno2);

select * from t1 partition(p2);
select * from t1 partition(partno6);
select * from t1 partition(partno7);
select * from t1 partition(partno8);
alter table t1 reorganize partition p2 into (
  partition p2 values in (5, 6) (
    subpartition partno6 values in (3,4),
    subpartition partno7 values in (1,6),
    subpartition partno8 values in (2,5)
  )
);
show create table t1;
select * from t1 partition(p2);
select * from t1 partition(partno6);
select * from t1 partition(partno7);
select * from t1 partition(partno8);

# 2. merge partition
alter table t1 reorganize partition p1,p2 into (
  partition p1 values in (3, 4, 5, 6) (
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  )
);
show create table t1;
select * from t1 partition(p1);

alter table t1 partition by list (amount) subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values in (3, 4)(
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values in (5, 6)(
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  )
);
alter table t1 reorganize partition p0,p1 into (
  partition p0 values in (1, 2, 3, 4) (
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  )
);
select * from t1;
select * from t1 partition(p0);

alter table t1 partition by list (amount) subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values in (3, 4)(
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values in (5, 6)(
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  ),
  partition p3 values in (7,8,9) (
    subpartition partno9 values in (1, 2),
    subpartition partno10 values in (3, 4),
    subpartition partno11 values in (5, 6)
  )
);
insert into t1(part_no, amount) values(1,7),(2,8),(3,9),(4,7),(5,8),(6,9);
select * from t1 partition(p3);
select * from t1 partition(partno9);
select * from t1 partition(partno10);
select * from t1 partition(partno11);

alter table t1 reorganize partition p0,p1,p2 into (
  partition p0_0 values in (1, 2, 3, 4, 5 ,6) (
    subpartition partno1 values in (1, 2),
    subpartition partno2 values in (3, 4),
    subpartition partno3 values in (5, 6)
  )
);
show create table t1;
select * from t1;
select * from t1 partition(p0_0);
select * from t1 partition(partno1);
select * from t1 partition(partno2);
select * from t1 partition(partno3);

alter table t1 partition by list (amount) subpartition by list (part_no)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values in (3, 4)(
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values in (5, 6)(
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  ),
  partition p3 values in (7,8,9) (
    subpartition partno9 values in (1, 2),
    subpartition partno10 values in (3, 4),
    subpartition partno11 values in (5, 6)
  )
);
set global rds_loose_partition_restriction = 0;
