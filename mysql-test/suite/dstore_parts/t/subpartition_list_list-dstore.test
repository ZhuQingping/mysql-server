# Out of order
create table t1(a int, b int) partition by list(a) subpartition by list(b) (
partition p1 values in (3,7,8,33) (
  subpartition p1sp0 values in (1,10,6,21),
  subpartition p1sp1 values in (3,4,11,23)),
partition p2 values in (4,9,21,6,45) (
  subpartition p2sp0 values in (2,9,12),
  subpartition p2sp1 values in (1,3,10,20,8))
);
insert into t1 values(3,1),(7,10),(8,6),(33,3),(8,11),(8,4),(33,23);
insert into t1 values(4,1),(21,10),(9,2),(9,9),(6,20),(45,20),(21,12);

select * from t1 order by b;
select * from t1 where b > 11  and b < 21 order by b;
--replace_column 10 # 11 #
explain select * from t1 where b > 11  and b < 21 order by b;
drop table t1;

# Test more than one part_fileds
create table t1(a int, b int, c int) partition by list(a) subpartition by list(b+c) (
  partition p0 values in (1,2,4)(
    subpartition p0sp0 values in (3,4,5),
    subpartition p0sp1 values in (11,12,13)
  ),
  partition p1 values in (7,9,10)(
    subpartition p1sp0 values in (7,3,4),
    subpartition p1sp1 values in (23,12,11)
  )
);
insert into t1 values(1,1,2),(2,2,2),(4,5,6),(4,1,12);
insert into t1 values(9,3,4),(9,21,2),(10,5,6),(7,-1,5);

select * from t1 where a > 0 and a < 8 order by a;
--replace_column 10 # 11 #
explain select * from t1 where a > 0 and a < 8 order by a;

# does not prune
select * from t1 where b > 0 and b < 8 order by b;
select * from t1 where b > 0 and b < 8 and c > 0 and c < 4 order by b;
drop table t1;

# part_info->part_expr->get_monotonicity_info() == NON_MONOTONIC
create table t1(a int, b int) partition by list(a) subpartition by list(3-b) (
  partition p0 values in (1,2,4)(
    subpartition p0sp0 values in (3,4,5),
    subpartition p0sp1 values in (11,12,13)
  ),
  partition p1 values in (7,9,10)(
    subpartition p1sp0 values in (7,-3,4),
    subpartition p1sp1 values in (23,-12,11)
  )
);
