insert into t1 values(9,6),(9,-4),(10,15),(7,-20);
select * from t1 where b > -19 and b < 4 order by b;
--replace_column 10 # 11 #
explain select * from t1 where b > -19 and b < 4 order by b;
drop table t1;

create table t1(a int, b int) partition by list(3-b) (
  partition p0 values in (3,4,5),
  partition p1 values in (23,-12,13)
);
