select b from t1 where b > 4;
--replace_column 10 # 11 #
explain select b from t1 where b > 4;
select b from t1 where b is null;
--replace_column 10 # 11 #
explain select b from t1 where b is null;
select b from t1 where b > 19 and b < 22;
