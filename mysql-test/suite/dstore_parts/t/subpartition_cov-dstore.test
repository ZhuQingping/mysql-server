--source include/have_debug.inc
#--source include/not_have_only_dstore.inc

--echo # add partition for RANGE/LIST, it is prohibited using NO_WRITE_TO_BINLOG

create table t1(id int, col1 int, col2 int) partition by list(col1) (
  partition p1 values in (1,2),
  partition p2 values in (3,4)
);

--error ER_NO_BINLOG_ERROR
alter table t1 add partition NO_WRITE_TO_BINLOG (
  partition p3 values in (5,6)
);

alter table t1 partition by hash(col1) subpartition by list(col2) (
  partition p1 (
    subpartition sp1 values in (1)
  )
);

--error ER_NO_BINLOG_ERROR
alter table t1 add partition NO_WRITE_TO_BINLOG (
  partition p2 (
    subpartition sp2 values in (2)
  )
);
drop table t1;

--echo # Test: Sub_partition::clone return nullptr

set @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
set global rds_extended_partitions_enabled = true;

create table t1(id int, col1 int, col2 int) partition by list(col1) subpartition by list(col2) (
  partition p1 values in (1,2) (
    subpartition sp1 values in (1,2),
    subpartition sp2 values in (3,4)
  ),
  partition p2 values in (3,4) (
    subpartition sp3 values in (1,2),
    subpartition sp4 values in (3,4)
  )
);
set session debug='+d,sub_partition_clone_failed';
--error ER_OUTOFMEMORY
alter table t1 add partition (
  partition p1 values in (5,6) (
    subpartition sp5 values in(1,2),
    subpartition sp6 values in (3,4)
  )
);
set session debug='-d,sub_partition_clone_failed';
drop table t1;
set global rds_extended_partitions_enabled = @saved_rds_extended_partitions_enabled;

