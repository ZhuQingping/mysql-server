#--source include/not_have_only_dstore.inc

--echo # Test: RANGE - LIST

SET @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
SET global rds_extended_partitions_enabled = true;

create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (month(date))
subpartition by list (amount)
(
  partition q1_2012 values less than (4) (
        subpartition p0 values in (1, 2),
        subpartition p1 values in (3, 4),
        subpartition p2 values in (5, 6)
  ),
  partition q2_2012 values less than (7) (
        subpartition p3 values in (1, 2),
        subpartition p4 values in (3, 4),
        subpartition p5 values in (5, 6)
  )
);

show create table t1;
insert into t1(date, amount) values
('2023-01-01',1),('2023-05-01',2),
('2023-02-01',3),('2023-06-01',4),
('2023-03-01',5),('2023-04-01',6);

select * from t1;
--replace_column 10 # 11 #
explain select * from t1 where date = '2022-02-23';
--replace_column 10 # 11 #
explain select * from t1 where date = '2022-02-23' and amount = 3;
select * from t1 where amount = 4;
--replace_column 10 # 11 #
explain select * from t1 where amount = 4;

--error ER_NO_PARTITION_FOR_GIVEN_VALUE
insert into t1(date, amount) values ('2023-07-01',1);

--error ER_NO_PARTITION_FOR_GIVEN_VALUE
insert into t1(date, amount) values ('2023-06-01',7);

drop table t1;

# Test : partition name must be unique within the table.
--error ER_SAME_NAME_PARTITION
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10)(
    subpartition partno0 values in (1, 2),
    subpartition partno0 values in (3, 4)
  )
);

--error ER_SAME_NAME_PARTITION
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  ),
  partition p1 values less than (20) (
    subpartition partno0 values in (1, 2),
    subpartition partno2 values in (3, 4)
  )
);

--error ER_SAME_NAME_PARTITION
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  ),
  partition p1 values less than (20) (
    subpartition p0 values in (1, 2),
    subpartition partno2 values in (3, 4)
  )
);

# Test : number of subpartitions must be same for every part_defination
--error ER_PARSE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  ),
  partition p1 values less than (20) (
    subpartition partno2 values in (1, 2)
  )
);

--error ER_PARSE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition partno0 values in (1, 2)
  ),
  partition p1 values less than (20) (
    subpartition partno2 values in (1, 2),
    subpartition partno1 values in (3, 4)
  )
);

# Test : must be defining subpartition defination for list type
--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10)
);

--error ER_PARSE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition p0sp0 values in (1)
  ),
  partition p1 values less than (20)
);

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10),
  partition p1 values less than (MAXVALUE) (
    subpartition p0sp0 values in (1)
  )
);

# Test: list type's value defination is values in

--error ER_PARTITION_WRONG_VALUES_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition p0sp0 values less than(3)
  )
);

# Test: expr/value must be INT type

--error ER_VALUES_IS_NOT_INT_TYPE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (country)
(
  partition p0 values less than (10) (
    subpartition p0sp0 values in ('XiAN')
  )
);

--error ER_VALUES_IS_NOT_INT_TYPE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (date)
(
  partition p0 values less than (10) (
    subpartition p0sp0 values in ('2021-01-01')
  )
);

--error ER_FIELD_TYPE_NOT_ALLOWED_AS_PARTITION_FIELD
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (date)
(
  partition p0 values less than (10) (
    subpartition p0sp0 values in (1)
  )
);

--echo #
--echo # DDL for range-list
--echo #

# Test: add partition
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition p0sp0 values in (1, 2),
    subpartition p0sp1 values in (3, 4)
  ),
  partition p1 values less than (20) (
    subpartition p1sp0 values in (1, 2),
    subpartition p1sp1 values in (3, 4)
  )
);

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
alter table t1 add partition (
  partition p2 values less than (30)
);

--error ER_PARTITION_WRONG_VALUES_ERROR
alter table t1 add partition (
  partition p2 values less than (30) (
    subpartition p2sp0 values less than (5),
    subpartition p2sp0 values less than (6)
  )
);

--error ER_PARTITION_WRONG_VALUES_ERROR
alter table t1 add partition (
  partition p2 values less than (30) (
    subpartition p2sp0 values less than (5),
    subpartition p2sp0 values in (6)
  )
);

--error ER_ADD_PARTITION_SUBPART_ERROR
alter table t1 add partition (
  partition p2 values less than (30) (
    subpartition p2sp0 values in (5, 6)
  )
);

--error ER_PARTITION_COLUMN_LIST_ERROR
alter table t1 add partition (
  partition p2 values less than (30) (
    subpartition p2sp0 values in ((5,6))
  )
);

alter table t1 add partition (
  partition p2 values less than (30) (
    subpartition p2sp0 values in (1, 2),
    subpartition p2sp1 values in (3, 4)
  )
);
show create table t1;
insert into t1(dept_no, part_no) values (23, 4), (24, 1);
select * from t1 partition(p2sp1);
drop table t1;

# Test: converting a Non-partitioned Table to a Partitioned Table

create table t1 (
`a` int ,
`b` int ,
primary Key(a, b));

insert into t1 values(1,1),(2,1),(3,1),(4,1),(111,111),(3333,333);

alter table t1 partition by range(a) subpartition by list(b) (
  partition p0 values less than(100) (
    subpartition p0sp0 values in (1),
    subpartition p0sp1 values in (111),
    subpartition p0sp2 values in (333)
  ),
  partition p1 values less than(maxvalue) (
    subpartition p1sp0 values in (1),
    subpartition p1sp1 values in (111),
    subpartition p1sp2 values in (333)
  )
);
show create table t1;

select * from t1 partition(p0sp0);
select * from t1 partition(p0);
select * from t1 partition(p1);

--error ER_NO_PARTITION_FOR_GIVEN_VALUE
alter table t1 partition by range(a) subpartition by list(b) (
  partition p0 values less than(100) (
    subpartition p0sp0 values in (1),
    subpartition p0sp1 values in (111),
    subpartition p0sp2 values in (333)
  ),
  partition p1 values less than(maxvalue) (
    subpartition p1sp0 values in (1),
    subpartition p1sp1 values in (111),
    subpartition p1sp2 values in (3)
  )
);

# Test: drop partition

--error ER_DROP_PARTITION_NON_EXISTENT
alter table t1 drop partition p0sp0;
# Currently, we only support copy algorithm for partitioned tables in DStore.
# The default for MySQL for DROP PARTITION is the inplace algorithm.
# The behavior for inplace and copy algorithm is different for drop partition
# (i.e. there is an error for copy).
#alter table t1 drop partition p1;

show create table t1;
select * from t1;
select partition_name, subpartition_name, table_rows from information_schema.partitions where table_name = 't1';

--echo # Test for truncate partition

alter table t1 truncate partition p0sp0;
show create table t1;
select * from t1 partition(p0sp0);

insert into t1 values(1, 111),(2, 333);
select * from t1 partition(p0);
alter table t1 truncate partition p0;
select * from t1 partition(p0);

drop table t1;

# Test: reorganize partition
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values less than (20) (
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values less than (maxvalue) (
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  )
);
--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
alter table t1 reorganize partition p1 into (
  partition p1  values less than (20)
);

--error ER_PARTITION_WRONG_NO_SUBPART_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values less than (20) (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  )
);

--error ER_PARTITION_WRONG_VALUES_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values less than (20) (
    subpartition partno0 values less than (1),
    subpartition partno1 values less than (3)
  )
);

--error ER_PARTITION_WRONG_VALUES_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values less than (20) (
    subpartition partno0 values in (1,2,4,5,6),
    subpartition partno1 values less than (3)
  )
);

--error ER_PARSE_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values less than (20) (
    subpartition p1partno0 values in (1, 2),
    subpartition p1partno1 values in (3, 4),
    subpartition p1partno2 values in (5, 6)
  ),
  partition p3 values less than (60) (
    subpartition p3partno0 values in (1, 2),
    subpartition p3partno1 values in (3, 4)
  )
);

--error ER_PARSE_ERROR
alter table t1 reorganize partition p1 into (
  partition p1 values less than (20) (
    subpartition p1partno0 values in (1, 2),
    subpartition p1partno1 values in (3, 4),
    subpartition p1partno2 values in (5, 6)
  ),
  partition p3 values less than (40)
);

--error ER_REORG_PARTITION_NOT_EXIST
alter table t1 reorganize partition p0,p1,p2,p3 into (
  partition p1 values less than (20) (
    subpartition p1partno0 values in (1, 2),
    subpartition p1partno1 values in (3, 4),
    subpartition p1partno2 values in (5, 6)
  )
);

--error ER_DROP_PARTITION_NON_EXISTENT
alter table t1 reorganize partition p1,p3 into (
  partition p1 values less than (20) (
    subpartition p1partno0 values in (1, 2),
    subpartition p1partno1 values in (3, 4),
    subpartition p1partno2 values in (5, 6)
  )
);

# value range can be expanded
--error ER_REORG_OUTSIDE_RANGE
alter table t1 reorganize partition p1 into (
  partition p1 values less than (20) (
    subpartition p1partno0 values in (1, 2),
    subpartition p1partno1 values in (3, 4),
    subpartition p1partno2 values in (5, 6)
  ),
  partition p3 values less than (40) (
    subpartition p3partno0 values in (1, 2),
    subpartition p3partno1 values in (3, 4),
    subpartition p3partno2 values in (5, 6)
  )
);
alter table t1 remove partitioning;
alter table t1 partition by range (dept_no) subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values less than (20) (
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  )
);
alter table t1 reorganize partition p1 into (
  partition p1 values less than (20) (
    subpartition p1partno0 values in (1, 2),
    subpartition p1partno1 values in (3, 4),
    subpartition p1partno2 values in (5, 6)
  ),
  partition p3 values less than (40) (
    subpartition p3partno0 values in (1, 2),
    subpartition p3partno1 values in (3, 4),
    subpartition p3partno2 values in (5, 6)
  )
);
show create table t1;
drop table t1;

create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values less than (20) (
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values less than (maxvalue) (
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  )
);

show create table t1;
insert into t1(dept_no, part_no) values(1,1),(5,2),(6,3),(6,4),(9,5),(9,6);
insert into t1(dept_no, part_no) values(13,1),(13,2),(13,3),(13,4),(13,5),(13,6);
insert into t1(dept_no, part_no) values(20,1),(52,2),(52,3),(52,4),(52,5),(52,6);

select * from t1 partition(partno3);
select * from t1 partition(partno4);
select * from t1 partition(partno5);

alter table t1 reorganize partition p1 into (
  partition p1 values less than (20) (
    subpartition partno3 values in (1),
    subpartition partno4 values in (2),
    subpartition partno5 values in (3, 4, 5, 6)
  )
);
show create table t1;
select * from t1 partition(partno3);
select * from t1 partition(partno4);
select * from t1 partition(partno5);

alter table t1 reorganize partition p1,p2 into (
  partition p1 values less than (maxvalue) (
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  )
);
show create table t1;
select * from t1 partition(p1);

drop table t1;

# Test: exchange partition

create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values less than (20) (
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values less than (maxvalue) (
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  )
);
insert into t1(dept_no, part_no) values(1,1),(5,2),(6,3),(6,4),(9,5),(9,6);
insert into t1(dept_no, part_no) values(13,1),(13,2),(13,3),(13,4),(13,5),(13,6);
insert into t1(dept_no, part_no) values(20,1),(52,2),(52,3),(52,4),(52,5),(52,6);

create table t2 like t1;
alter table t2 remove partitioning;

alter table t1 exchange partition partno7 with table t2;
select * from t1 partition(partno7);
select * from t2;

delete from t2;
insert into t2(dept_no, part_no) values(30, 7), (30, 6);
insert into t1(dept_no, part_no) values(3, 5);
--error ER_NO_PARTITION_FOR_GIVEN_VALUE
alter table t1 exchange partition partno7 with table t2;

alter table t1 exchange partition partno7 with table t2 without validation;
select * from t1 partition(partno7);
select * from t2;

drop table t1, t2;

# Test: analyze partition
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by range (dept_no)
subpartition by list (part_no)
(
  partition p0 values less than (10) (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4),
    subpartition partno2 values in (5, 6)
  ),
  partition p1 values less than (20) (
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4),
    subpartition partno5 values in (5, 6)
  ),
  partition p2 values less than (maxvalue) (
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4),
    subpartition partno8 values in (5, 6)
  )
);
insert into t1(dept_no, part_no) values(1,1),(5,2),(6,3),(6,4),(9,5),(9,6);
insert into t1(dept_no, part_no) values(13,1),(13,2),(13,3),(13,4),(13,5),(13,6);
insert into t1(dept_no, part_no) values(20,1),(52,2),(52,3),(52,4),(52,5),(52,6);

alter table t1 analyze partition partno3, partno8;
select * from t1 partition(partno3);

# Test: check partition
select * from t1 partition(partno1, partno4, partno5);
alter table t1 check partition partno1, partno4, partno5;
select * from t1 partition(partno1, partno4, partno5);

# Test: optimize partition
select * from t1 partition(partno3, partno6, partno8);
alter table t1 optimize partition partno3, partno6, partno8;
select * from t1 partition(partno3, partno6, partno8);

# Test: rebuild partition, only for partiton_name, not for subpartition_name
select * from t1 partition(p0);
alter table t1 rebuild partition p0;
select * from t1 partition(p0);

--error ER_DROP_PARTITION_NON_EXISTENT
alter table t1 rebuild partition partno2;

# Test: repair partition
select * from t1 partition(partno3);
alter table t1 repair partition partno3;
select * from t1 partition(partno3);

# Test: remove partitioning
alter table t1 remove partitioning;
show create table t1;
drop table t1;

# Verify index
create table t1(a int, b int) partition by range(a) subpartition by list(b) (
partition p1 values less than (5) (
  subpartition p1sp0 values in (1,2,3),
  subpartition p1sp1 values in (4,5,6)),
partition p2 values less than (10) (
  subpartition p2sp0 values in (7,8,9),
  subpartition p2sp1 values in (20,21,22))
);
insert into t1 values(3,2),(4,5),(5,8),(6,21),(7,7),(8,9),(6,22);
select * from t1 where a < 5;
--replace_column 10 # 11 #
explain select * from t1 where a < 5;
alter table t1 add index idx(a);
select * from t1 where a < 5;
--replace_column 10 # 11 #
explain select * from t1 where a < 5;
select * from t1 where a = 8;
alter table t1 add index idx1(a, b);
select * from t1 where a = 6 and b = 21;
--replace_column 10 # 11 #
explain select * from t1 where a = 6 and b = 21;
select * from t1 where b = 20;
--replace_column 10 # 11 #
explain select * from t1 where b = 20;
alter table t1 drop index idx;
alter table t1 drop index idx1;
alter table t1 add index idx2(b);
select * from t1 where a = 7;
select * from t1 where b = 2;
drop table t1;

# Test partitioning interval analysis
create table t1(a int, b int) partition by range(a) subpartition by list(b) (
partition p1 values less than (5) (
  subpartition p1sp0 values in (1,2,3),
  subpartition p1sp1 values in (4,5,6)),
partition p2 values less than (10) (
  subpartition p2sp0 values in (7,8,9),
  subpartition p2sp1 values in (20,21,22))
);
insert into t1 values(3,2),(4,5),(5,7),(6,7),(7,20),(8,21),(6,9);
select * from t1 order by b;
select * from t1 where b > 3 and b < 9 order by b;
--replace_column 10 # 11 #
explain select b from t1 where b > 3 and b < 9 order by b;
select * from t1 where b > 4 order by b;
--replace_column 10 # 11 #
explain select b from t1 where b > 4 order by b;
select * from t1 where b is null order by b;
--replace_column 10 # 11 #
explain select b from t1 where b is null order by b;
select * from t1 where b > 19 and b < 22 order by b;
drop table t1;

# Out of order
create table t1(a int, b int) partition by range(a) subpartition by list(b) (
partition p1 values less than (20) (
  subpartition p1sp0 values in (1,10,6,21),
  subpartition p1sp1 values in (3,4,11,23)),
partition p2 values less than (45) (
