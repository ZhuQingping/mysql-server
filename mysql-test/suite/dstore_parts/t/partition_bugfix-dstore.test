--echo #
--echo # BUG2026020333623: When a table is imported, the instance is abnormal. The keywords are
--echo #                   DictSys::AddTableEntry&CdeDdOpenTable&Assertion failure:
--echo #                   cde_dict.cc:300:nameMapIter == m_tables.end.
--echo #

SET @OLD_SQL_MODE=@@SQL_MODE, SQL_MODE='';

DROP TABLE IF EXISTS `rds_instant`;
SET @saved_cs_client     = @@character_set_client;
SET character_set_client = utf8mb4;
CREATE TABLE `rds_instant` (
  `id_col` int NOT NULL,
  `bool_col` tinyint(1) DEFAULT NULL,
  `bit_col` bit(1) DEFAULT NULL,
  `EXTRA_HEALTH` tinyint(1) DEFAULT NULL,
  `smallint_col` smallint DEFAULT NULL,
  `mediumint_col` mediumint DEFAULT NULL,
  `RECYCLE_BIN` int DEFAULT NULL,
  `bigint_col` bigint DEFAULT NULL,
  `decimal_col` decimal(25,5) DEFAULT NULL,
  `PBS` float DEFAULT NULL,
  `double_col` double DEFAULT NULL,
  `RDS_INSTANT` date DEFAULT NULL,
  `datetime_col` datetime(6) DEFAULT NULL,
  `timestamp_col` timestamp(6) NULL DEFAULT NULL,
  `time_col` time(6) DEFAULT NULL,
  `REDO` year DEFAULT NULL,
  `char_col` char(4) CHARACTER SET gb2312 COLLATE gb2312_chinese_ci DEFAULT NULL,
  `varchar_col` varchar(255) CHARACTER SET gb2312 COLLATE gb2312_chinese_ci DEFAULT NULL,
  `SPACEUSAGE` binary(11) DEFAULT NULL,
  `varbinary_col` varbinary(255) DEFAULT NULL,
  `tinyblob_col` tinyblob,
  `SLICEID` blob,
  `mediumblob_col` mediumblob,
  `longblob_col` longblob,
  `tinytext_col` tinytext CHARACTER SET latin1 COLLATE latin1_swedish_ci,
  `text_col` text CHARACTER SET latin1 COLLATE latin1_swedish_ci,
  `mediumtext_col` enum('aaa','bbb','ccc') CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL,
  `longtext_col` longtext CHARACTER SET latin1 COLLATE latin1_swedish_ci,
  `enum_col` enum('aaa','bbb','ccc') CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_bin DEFAULT NULL,
  `set_col` set('111','222','333') CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL,
  UNIQUE KEY `……&*（` (`RECYCLE_BIN`,`RDS_INSTANT`),
  KEY `‘；@@@` (`EXTRA_HEALTH` DESC),
  KEY `《***》` (`smallint_col`),
  KEY `:'\",.` (`mediumint_col`),
  KEY `{[(……)]}` (`RECYCLE_BIN`),
  KEY `+——&*` (`bigint_col`),
  KEY `:\":>..<` (`decimal_col`),
  KEY `~..~` (`RDS_INSTANT`),
  KEY `%^￥￥￥` (`varchar_col`(4) DESC),
  KEY `‘|’‘|’‘|’` (`SPACEUSAGE`),
  KEY `：……”；` (`enum_col`),
  KEY `￥%……&*（` (`set_col` DESC),
  KEY `^&*)&^^^&*()` (`id_col` DESC,`bigint_col` DESC),
  KEY `^*(**&^` (`id_col`,`time_col`),
  KEY `_)(*&^&*((` (`id_col`,`double_col` DESC),
  KEY `)))))((((` (`id_col`),
  KEY `<><><><><>` (`id_col`,`varchar_col`(5) DESC,`RDS_INSTANT` DESC),
  KEY `[[[[]]]]` (`id_col`,`RECYCLE_BIN`,`decimal_col`,`char_col`),
  KEY `%^&*()` (`EXTRA_HEALTH`,`PBS` DESC,`char_col`),
  KEY `funndx_bigint_datetime_col` ((asin(`bigint_col`)),(dayofmonth(`datetime_col`))),
  KEY `funndx_varchar_col` ((reverse(`varchar_col`))),
  KEY `funndx_datetime_date_time_col` ((year(`datetime_col`)),(month(`datetime_col`)),(dayofmonth(`datetime_col`)),(hour(`datetime_col`)),(minute(`time_col`)),(second(`time_col`))),
  KEY `funndx_decimal_col` ((floor(`decimal_col`))),
  KEY `funndx_double_col` (((abs(`double_col`) DIV 100)))
) ENGINE=dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
PARTITION BY RANGE (month(`RDS_INSTANT`))
SUBPARTITION BY HASH (`RECYCLE_BIN`)
SUBPARTITIONS 10
(PARTITION `%^*` VALUES LESS THAN (3) ENGINE = dstore,
 PARTITION `<>?;'` VALUES LESS THAN (6) ENGINE = dstore,
 PARTITION `++--*/\\` VALUES LESS THAN (9) ENGINE = dstore,
 PARTITION `【{】})_` VALUES LESS THAN MAXVALUE ENGINE = dstore);

ALTER TABLE `rds_instant` DISABLE KEYS;

SET character_set_client = @saved_cs_client;

SET SQL_MODE=@OLD_SQL_MODE;
DROP TABLE rds_instant;

--echo # BUG2026020352606 An error occurs when the where condition in the partitioned table query
--echo #                  contains not between and group by is used for grouping.
--echo # BUG2026020353049 When the Avg Aggregation Function and JSON Type Are Included in the Partitioned Table Query,
--echo #                  the Error Message "The JSON binary value contains invalid data" Is Displayed During the Query. 
--echo #

SET @OLD_CHARACTER_SET_CLIENT=@@CHARACTER_SET_CLIENT;
SET @OLD_CHARACTER_SET_RESULTS=@@CHARACTER_SET_RESULTS;
SET @OLD_COLLATION_CONNECTION=@@COLLATION_CONNECTION;
SET NAMES utf8mb4;
SET @OLD_TIME_ZONE=@@TIME_ZONE;
SET TIME_ZONE='+00:00';
SET @OLD_UNIQUE_CHECKS=@@UNIQUE_CHECKS, UNIQUE_CHECKS=0;
SET @OLD_FOREIGN_KEY_CHECKS=@@FOREIGN_KEY_CHECKS, FOREIGN_KEY_CHECKS=0;
SET @OLD_SQL_MODE=@@SQL_MODE, SQL_MODE='';
SET @OLD_SQL_NOTES=@@SQL_NOTES, SQL_NOTES=0;


DROP TABLE IF EXISTS `tbl_1_all_typeindex`;
SET @saved_cs_client     = @@character_set_client;
SET character_set_client = utf8mb4;
CREATE TABLE `tbl_1_all_typeindex` (
  `id_col` int NOT NULL,
  `tinyint_col` tinyint DEFAULT NULL,
  `bool_col` tinyint(1) DEFAULT NULL,
  `smallint_col` smallint DEFAULT NULL,
  `mediumint_col` mediumint DEFAULT NULL,
  `int_col` int DEFAULT NULL,
  `bigint_col` bigint NOT NULL,
  `decimal_col` decimal(25,5) DEFAULT NULL,
  `float_col` float DEFAULT NULL,
  `double_col` double DEFAULT NULL,
  `date_col` date DEFAULT NULL,
  `datetime_col` datetime(6) DEFAULT NULL,
  `timestamp_col` timestamp(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6),
  `time_col` time(6) DEFAULT NULL,
  `year_col` year DEFAULT NULL,
  `char_col` char(4) CHARACTER SET utf8 COLLATE utf8_unicode_ci DEFAULT NULL,
  `varchar_col` varchar(255) CHARACTER SET utf8 COLLATE utf8_unicode_ci DEFAULT NULL,
  `binary_col` binary(11) DEFAULT NULL,
  `varbinary_col` varbinary(255) DEFAULT NULL,
  `tinyblob_col` tinyblob,
  `blob_col` blob,
  `mediumblob_col` mediumblob,
  `longblob_col` longblob,
  `tinytext_col` tinytext CHARACTER SET utf8 COLLATE utf8_unicode_ci,
  `text_col` text CHARACTER SET utf8 COLLATE utf8_unicode_ci,
  `mediumtext_col` mediumtext CHARACTER SET utf8 COLLATE utf8_unicode_ci,
  `longtext_col` longtext CHARACTER SET utf8 COLLATE utf8_unicode_ci,
  `enum_col` enum('aaa','bbb','ccc') CHARACTER SET utf8 COLLATE utf8_unicode_ci DEFAULT NULL,
  `set_col` set('111','222','333') CHARACTER SET utf8 COLLATE utf8_unicode_ci DEFAULT NULL,
  `json_col` json DEFAULT NULL,
  KEY `ndx_tinyint_col` (`tinyint_col`),
  KEY `ndx_smallint_col` (`smallint_col`),
  KEY `ndx_mediumint_col` (`mediumint_col`),
  KEY `ndx_int_col` (`int_col`),
  KEY `ndx_bigint_col` (`bigint_col`),
  KEY `ndx_decimal_col` (`decimal_col`),
  KEY `ndx_float_col` (`float_col`),
  KEY `ndx_double_col` (`double_col`),
  KEY `ndx_date_col` (`date_col`),
  KEY `ndx_datetime_col` (`datetime_col`),
  KEY `ndx_timestamp_col` (`timestamp_col`),
  KEY `ndx_time_col` ((TIME_TO_SEC(`time_col`))),
  KEY `ndx_year_col` (`year_col`),
   KEY `ndx_char_col` (`char_col`(4)),
  KEY `ndx_varchar_col` (`varchar_col`(4)),
  KEY `ndx_binary_col` (`binary_col`),
  KEY `ndx_enum_col` (`enum_col`),
  KEY `ndx_set_col` (`set_col`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
PARTITION BY RANGE ((to_seconds(`datetime_col`) % 100))
SUBPARTITION BY LIST (month(`date_col`))
(PARTITION p1 VALUES LESS THAN (20)
 (SUBPARTITION `EXTRA_HEALTH` VALUES IN (NULL,0,1,2,3) COMMENT = '分区1' ENGINE = Dstore,
  SUBPARTITION q2 VALUES IN (4,5,6) COMMENT = '分区2' ENGINE = Dstore,
  SUBPARTITION q3 VALUES IN (7,8,9) COMMENT = '分区3' ENGINE = Dstore,
  SUBPARTITION q4 VALUES IN (10,11,12) COMMENT = '分区4' ENGINE = Dstore),
 PARTITION `PBS` VALUES LESS THAN (40)
 (SUBPARTITION `REDO` VALUES IN (NULL,0,1,2,3) COMMENT = '分区5' ENGINE = Dstore,
  SUBPARTITION q6 VALUES IN (4,5,6) COMMENT = '分区6' ENGINE = Dstore,
  SUBPARTITION `SLICEID` VALUES IN (7,8,9) COMMENT = '分区7' ENGINE = Dstore,
  SUBPARTITION q8 VALUES IN (10,11,12) COMMENT = '分区8' ENGINE = Dstore),
 PARTITION p3 VALUES LESS THAN (60)
 (SUBPARTITION `RECYCLE_BIN` VALUES IN (NULL,0,1,2,3) COMMENT = '分区9' ENGINE = Dstore,
  SUBPARTITION q10 VALUES IN (4,5,6) COMMENT = '分区10' ENGINE = Dstore,
  SUBPARTITION q11 VALUES IN (7,8,9) COMMENT = '分区11' ENGINE = Dstore,
  SUBPARTITION q12 VALUES IN (10,11,12) COMMENT = '分区12' ENGINE = Dstore),
 PARTITION p4 VALUES LESS THAN (80)
 (SUBPARTITION q13 VALUES IN (NULL,0,1,2,3) COMMENT = '分区13' ENGINE = Dstore,
  SUBPARTITION `SPACEUSAGE` VALUES IN (4,5,6) COMMENT = '分区14' ENGINE = Dstore,
  SUBPARTITION q15 VALUES IN (7,8,9) COMMENT = '分区15' ENGINE = Dstore,
  SUBPARTITION q16 VALUES IN (10,11,12) COMMENT = '分区16' ENGINE = Dstore),
 PARTITION p5 VALUES LESS THAN MAXVALUE
 (SUBPARTITION `RDS_INSTANT` VALUES IN (NULL,0,1,2,3) COMMENT = '分区17' ENGINE = Dstore,
  SUBPARTITION q18 VALUES IN (4,5,6) COMMENT = '分区18' ENGINE = Dstore,
  SUBPARTITION q19 VALUES IN (7,8,9) COMMENT = '分区19' ENGINE = Dstore,
  SUBPARTITION q20 VALUES IN (10,11,12) COMMENT = '分区20' ENGINE = Dstore));
SET character_set_client = @saved_cs_client;


