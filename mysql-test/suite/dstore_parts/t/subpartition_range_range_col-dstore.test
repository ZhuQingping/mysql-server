#Verify alter table error
CREATE TABLE t1(a int, b int) PARTITION BY range columns(a) (
partition p1 VALUES LESS THAN (3),
partition p2 VALUES LESS THAN (4)
);
--error ER_PARTITION_MGMT_ON_NONPARTITIONED
ALTER TABLE t1 ADD PARTITION (PARTITION p3 VALUES LESS THAN (5) (SUBPARTITION p3p0));
--error ER_PARTITION_MGMT_ON_NONPARTITIONED
ALTER TABLE t1 ADD PARTITION (PARTITION p3 VALUES LESS THAN (5) (SUBPARTITION p3p0 VALUES LESS THAN(4)));

CREATE TABLE t2(a int, b int);
--error ER_PARTITION_MGMT_ON_NONPARTITIONED
ALTER TABLE t2 ADD PARTITION (PARTITION p0 VALUES LESS THAN (5));
DROP TABLE t1, t2;

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
CREATE TABLE t1(a int, b int) PARTITION BY range columns(a) SUBPARTITION BY range columns(b) (
partition p1 VALUES LESS THAN (3),
partition p2 VALUES LESS THAN (4)
);
CREATE TABLE t1(a int, b int) PARTITION BY range columns(a)(
partition p1 VALUES LESS THAN (3),
partition p2 VALUES LESS THAN (4)
);
--error ER_PARTITION_MGMT_ON_NONPARTITIONED
ALTER TABLE t1 ADD PARTITION (PARTITION p3 VALUES LESS THAN (5) (SUBPARTITION p3p0));
--error ER_PARTITION_REQUIRES_VALUES_ERROR
ALTER TABLE t1 ADD PARTITION (PARTITION p3);
DROP TABLE t1;
CREATE TABLE t1(a int, b int) PARTITION BY range columns(a) SUBPARTITION BY hash(b) (
partition p1 VALUES LESS THAN (3),
partition p2 VALUES LESS THAN (4)
);
ALTER TABLE t1 ADD PARTITION (PARTITION p3 VALUES LESS THAN (5));
DROP TABLE t1;
CREATE TABLE t3 (
    id INT NOT NULL,
    store_id INT NOT NULL
)
PARTITION BY RANGE columns(store_id) 
SUBPARTITION BY RANGE columns(id) (
    PARTITION p0 VALUES LESS THAN (6) (
    SUBPARTITION q1 VALUES LESS THAN (4),
    SUBPARTITION q2 VALUES LESS THAN (10)
  ),  
    PARTITION p1 VALUES LESS THAN (11) (
    SUBPARTITION q3 VALUES LESS THAN (15),
    SUBPARTITION q4 VALUES LESS THAN (20)
  )
);

--error ER_RANGE_NOT_INCREASING_ERROR
ALTER TABLE t3 ADD PARTITION (PARTITION p3 VALUES LESS THAN (20)(SUBPARTITION q5 VALUES LESS THAN(19), subpartition q6 VALUES LESS THAN(19)));
DROP TABLE t3;

# Verify index
CREATE TABLE t1(a int, b int) PARTITION BY range columns(a) SUBPARTITION BY range columns(b) (
partition p1 VALUES LESS THAN (3) (SUBPARTITION p1sp0 VALUES LESS THAN(3),
                                   SUBPARTITION p1sp1 VALUES LESS THAN (5)),
partition p2 VALUES LESS THAN (10) (SUBPARTITION p2sp0 VALUES LESS THAN(4),
                                    SUBPARTITION p2sp1 VALUES LESS THAN (9))
);
INSERT INTO t1 VALUES(1,2),(2,4),(5,3),(6,8);
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t1 WHERE a < 1;
ALTER TABLE t1 ADD index idx(a);
SELECT * FROM t1 WHERE a < 1;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t1 WHERE a = 2;
SELECT * FROM t1 WHERE a = 2;
ALTER TABLE t1 ADD index idx1(a, b);
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t1 WHERE a = 2 and b = 4;
SELECT * FROM t1 WHERE a = 2 and b = 4;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t1 WHERE b = 4;
SELECT * FROM t1 WHERE b = 4;
ALTER TABLE t1 DROP INDEX idx;
ALTER TABLE t1 DROP INDEX idx1;
ALTER TABLE t1 ADD index idx2(b);
SELECT * FROM t1 WHERE a = 2;
SELECT * FROM t1 WHERE b = 4;
DROP TABLE t1;

CREATE TABLE t1
(
dept_no int,
part_no int,
country varchar(20),
date date,
amount int
)
PARTITION BY RANGE COLUMNS(dept_no)
SUBPARTITION BY RANGE COLUMNS(part_no)
(
PARTITION p0 VALUES LESS THAN (10) (
SUBPARTITION partno0 VALUES LESS THAN (2),
SUBPARTITION partno1 VALUES LESS THAN (4),
SUBPARTITION partno2 VALUES LESS THAN (6)
),
partition p1 VALUES LESS THAN (20) (
SUBPARTITION partno3 VALUES LESS THAN (2),
SUBPARTITION partno4 VALUES LESS THAN (4),
SUBPARTITION partno5 VALUES LESS THAN (6)
),
partition p2 VALUES LESS THAN (maxvalue) (
SUBPARTITION partno6 VALUES LESS THAN (2),
SUBPARTITION partno7 VALUES LESS THAN (4),
SUBPARTITION partno8 VALUES LESS THAN (6)
)
);

show CREATE TABLE t1;
INSERT INTO t1(dept_no, part_no) VALUES(1,1),(5,2),(6,3),(6,4),(9,5);
INSERT INTO t1(dept_no, part_no) VALUES(13,1),(13,2),(13,3),(13,4),(13,5);
INSERT INTO t1(dept_no, part_no) VALUES(20,1),(52,2),(52,3),(52,4),(52,5);
select * from t1 partition(partno3);
ALTER TABLE t1 ANALYZE PARTITION p0, p1, p2;
SELECT partition_name, SUBPARTITION_name, table_rows FROM information_schema.partitions WHERE table_name = 't1';
alter table t1 reorganize partition p1 into (
partition p1 VALUES LESS THAN (20) (
  SUBPARTITION partno3 VALUES LESS THAN (1),
  SUBPARTITION partno4 VALUES LESS THAN (2),
  SUBPARTITION partno5 VALUES LESS THAN (6)
)
);
SELECT * FROM t1 PARTITION(partno3);
ALTER TABLE t1 ANALYZE PARTITION p0, p1, p2;
SELECT partition_name, SUBPARTITION_name, table_rows FROM information_schema.partitions WHERE table_name = 't1';
DROP TABLE t1;

CREATE TABLE t2 (
  a int DEFAULT NULL,
  b int DEFAULT NULL,
  c int DEFAULT NULL,
  d int DEFAULT NULL,
  e int DEFAULT NULL
) PARTITION BY RANGE  COLUMNS(a,b)
SUBPARTITION BY RANGE  COLUMNS(c,d,e)
(PARTITION p1 VALUES LESS THAN (1,2)
 (SUBPARTITION p1_q0 VALUES LESS THAN (1,2,3) ENGINE = DStore,
  SUBPARTITION p1_q1 VALUES LESS THAN (4,5,6) ENGINE = DStore),
 PARTITION p2 VALUES LESS THAN (4,5)
 (SUBPARTITION p2_q0 VALUES LESS THAN (7,8,9) ENGINE = DStore,
  SUBPARTITION p2_q1 VALUES LESS THAN (10,11,12) ENGINE = DStore),
 PARTITION p3 VALUES LESS THAN (6,7)
 (SUBPARTITION p3_q0 VALUES LESS THAN (1,2,3) ENGINE = DStore,
  SUBPARTITION p3_q1 VALUES LESS THAN (4,5,6) ENGINE = DStore));
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t2 WHERE a = 1 AND b = 2 AND c = 4 AND d = 5;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t2 WHERE a > 1 AND b = 2 AND c = 4 AND d = 5;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t2 WHERE a > 1 AND b = 2 AND c = 4 AND d = 5 AND e = 7;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t2 WHERE a = 1 AND b = 2 AND c > 4 AND d = 5;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t2 WHERE a BETWEEN 1 AND 3 AND b BETWEEN 2 AND 6 AND c > 4 AND d = 5;
DROP TABLE t2;
SET global rds_extended_partitions_enabled = @saved_rds_extended_partitions_enabled;
