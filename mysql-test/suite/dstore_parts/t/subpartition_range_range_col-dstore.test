    )
);

# DROP partition

--error ER_DROP_PARTITION_NON_EXISTENT
ALTER TABLE t1 DROP partition p0sp0;

# Currently, we only support copy algorithm for partitioned tables in DStore.
# The default for MySQL for DROP PARTITION is the inplace algorithm.
# The behavior for inplace and copy algorithm is different for drop partition
# (i.e. there is an error for copy).
#ALTER TABLE t1 DROP partition p2;
SHOW CREATE TABLE t1;
SELECT * FROM t1;
ALTER TABLE t1 ANALYZE PARTITION p0, p1;
SELECT partition_name, SUBPARTITION_name, table_rows FROM information_schema.partitions where table_name = 't1';

# truncate partition
SELECT * FROM t1 partition(p1sp1);
ALTER TABLE t1 truncate partition p1sp1;
SHOW CREATE TABLE t1;
SELECT * FROM t1 partition(p1sp1);

SELECT * FROM t1 partition(p1);
ALTER TABLE t1 truncate partition p1;
SHOW CREATE TABLE t1;
SELECT * FROM t1 partition(p1);

DROP TABLE t1;

# reorganize partition
CREATE TABLE t1 (
a int ,
b int ,
Primary Key(a, b));
INSERT INTO t1 VALUES(1,1),(2,1),(3,1),(4,1),(111,111),(3333,333);

ALTER TABLE t1 partition by range columns(a) SUBPARTITION by range columns(b) (
    partition p0 VALUES LESS THAN(100) (
        SUBPARTITION p0sp0 VALUES LESS THAN(6),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    ),
    partition p1 VALUES LESS THAN(1000) (
        SUBPARTITION p1sp0 VALUES LESS THAN(6),
        SUBPARTITION p1sp1 VALUES LESS THAN(1000)
    ),
    partition p2 VALUES LESS THAN(MAXVALUE) (
        SUBPARTITION p2sp0 VALUES LESS THAN(6),
        SUBPARTITION p2sp1 VALUES LESS THAN(1000)
    )
);

# reorganize SUBPARTITION
ALTER TABLE t1 reorganize partition p2 INTO
(
    partition p2 VALUES LESS THAN(maxvalue) (
        SUBPARTITION p2sp0 VALUES LESS THAN(100),
        SUBPARTITION p2sp1 VALUES LESS THAN(1000)
    )
);

SHOW CREATE TABLE t1;
# merge
ALTER TABLE t1 reorganize partition p0,p1 into
(
    partition p0 VALUES LESS THAN(1000) (
        SUBPARTITION p0sp0 VALUES LESS THAN(100),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    )
);

SHOW CREATE TABLE t1;
# splite
ALTER TABLE t1 reorganize partition p0 into
(
    partition p0 VALUES LESS THAN(10) (
        SUBPARTITION p0sp0 VALUES LESS THAN(100),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    ),
    partition p1 VALUES LESS THAN(1000) (
        SUBPARTITION p1sp0 VALUES LESS THAN(100),
        SUBPARTITION p1sp1 VALUES LESS THAN(1000)
    )
);

SHOW CREATE TABLE t1;
DROP TABLE t1;

# exchange partition 

CREATE TABLE tsp (
a int ,
b int ,
Primary Key(a, b));
INSERT INTO tsp VALUES(1,1),(2,1),(3,1),(4,1),(111,111),(3333,333);
ALTER TABLE tsp partition by range columns(a) SUBPARTITION by range columns(b) (
    partition p0 VALUES LESS THAN(100) (
        SUBPARTITION p0sp0 VALUES LESS THAN(6),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    ),
    partition p1 VALUES LESS THAN(1000) (
        SUBPARTITION p1sp0 VALUES LESS THAN(6),
        SUBPARTITION p1sp1 VALUES LESS THAN(1000)
    ),
    partition p2 VALUES LESS THAN(MAXVALUE) (
        SUBPARTITION p2sp0 VALUES LESS THAN(6),
        SUBPARTITION p2sp1 VALUES LESS THAN(1000)
    )
);

create TABLE t like tsp;
ALTER TABLE t remove partitioning;

SELECT * FROM tsp partition(p2sp1);
ALTER TABLE tsp EXCHANGE PARTITION p2sp1 WITH TABLE t;
SHOW CREATE TABLE t;
SHOW CREATE TABLE tsp;

SELECT * FROM tsp partition(p2sp1);
SELECT * FROM t;

DELETE FROM t;
INSERT INTO t VALUES(1023,2000);
--error ER_NO_PARTITION_FOR_GIVEN_VALUE 
ALTER TABLE tsp EXCHANGE PARTITION p2sp1 WITH TABLE t;

ALTER TABLE tsp EXCHANGE PARTITION p2sp1 WITH TABLE t without VALIDATION;
SELECT * FROM tsp PARTITION(p2sp1);
SELECT * FROM t;

DROP TABLE t,tsp;

# check partition 

CREATE TABLE range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE(year(date))
SUBPARTITION BY RANGE COLUMNS(dept_no, part_no, country)
(
  PARTITION p_2020 VALUES LESS THAN (2020) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4, 2, 'east'),
    SUBPARTITION q2_2020 VALUES LESS THAN(7, 4, 'west')
  ),
  PARTITION p_2021 VALUES LESS THAN (2021)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(8, 3, 'north'),
    SUBPARTITION q2_2021 VALUES LESS THAN(13, 4, 'south')
  )
);
INSERT INTO range_range(date) VALUES('2020-04-12');
