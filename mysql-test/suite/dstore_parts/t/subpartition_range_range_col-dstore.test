# DDL
# add partition
CREATE TABLE sales_range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE(year(date))
SUBPARTITION BY RANGE COLUMNS(dept_no, part_no, country)
(
  PARTITION p_2020 VALUES LESS THAN (2020) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4, 2, 'east'),
    SUBPARTITION q2_2020 VALUES LESS THAN(7, 4, 'west')
  ),
  PARTITION p_2021 VALUES LESS THAN (2021)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(8, 3, 'north'),
    SUBPARTITION q2_2021 VALUES LESS THAN(13, 4, 'south')
  )
);
--error ER_ADD_PARTITION_SUBPART_ERROR
ALTER TABLE sales_range_range ADD PARTITION (
    PARTITION p_2022 VALUES LESS THAN(2022) (
    SUBPARTITION q1_2022 VALUES LESS THAN(8, 3, 'north'),
    SUBPARTITION q2_2022 VALUES LESS THAN(13, 4, 'south'),
    SUBPARTITION q1_2022 VALUES LESS THAN(8, 3, 'north')
    )
);

--error ER_SAME_NAME_PARTITION 
ALTER TABLE sales_range_range ADD PARTITION (
    partition p_2022 VALUES LESS THAN(2022) (
    SUBPARTITION q1_2022 VALUES LESS THAN(8, 3, 'north'),
    SUBPARTITION q1_2022 VALUES LESS THAN(13, 4, 'south')
    )
);

--error ER_RANGE_NOT_INCREASING_ERROR
ALTER TABLE sales_range_range add partition (
    partition p_2022 VALUES LESS THAN(2022) (
    SUBPARTITION q1_2022 VALUES LESS THAN(8, 3, 'north'),
    SUBPARTITION q2_2022 VALUES LESS THAN(3, 4, 'south')
    )
);

ALTER TABLE sales_range_range add partition (
    partition p_max VALUES LESS THAN(MAXVALUE) (
    SUBPARTITION pmax_1 VALUES LESS THAN(3, MAXVALUE, 'south'),
    SUBPARTITION pmax_2 VALUES LESS THAN(MAXVALUE, 4, 'south')
    )
);

--error ER_PARTITION_MAXVALUE_ERROR
ALTER TABLE sales_range_range add partition (
    partition p_2024 VALUES LESS THAN(2024) (
    SUBPARTITION q1_2022 VALUES LESS THAN(8, 3, 'north'),
    SUBPARTITION q1_2022 VALUES LESS THAN(3, 4, 'south')
    )
);
DROP table sales_range_range;

# add partition .. without validation
CREATE TABLE t1 (
a int ,
b int ,
Primary Key(a, b));

INSERT INTO t1 VALUES(1,1),(2,1),(3,1),(4,1),(111,111),(3333,333);

ALTER TABLE t1 partition by range(a) (
partition p0 VALUES LESS THAN (12),
partition p1 VALUES LESS THAN (200),
partition p2 VALUES LESS THAN (3334)
);
ALTER TABLE t1 ANALYZE PARTITION p0, p1, p2;
select partition_name, subpartition_name, table_rows from information_schema.partitions where table_name = 't1';
SELECT * FROM t1 partition(p0);

ALTER TABLE t1 partition by range columns(a) SUBPARTITION by range columns(b) (
    partition p0 VALUES LESS THAN(100) (
        SUBPARTITION p0sp0 VALUES LESS THAN(6),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    ),
    partition p1 VALUES LESS THAN(1000) (
        SUBPARTITION p1sp0 VALUES LESS THAN(6),
        SUBPARTITION p1sp1 VALUES LESS THAN(1000)
    ),
    partition p2 VALUES LESS THAN(3334) (
        SUBPARTITION p2sp0 VALUES LESS THAN(6),
        SUBPARTITION p2sp1 VALUES LESS THAN(1000)
    )
);
DROP TABLE t1;
# partition by

CREATE TABLE t1 (
a int ,
b int ,
Primary Key(a, b));
INSERT INTO t1 VALUES(1,1),(2,1),(3,1),(4,1),(111,111),(3333,333);

