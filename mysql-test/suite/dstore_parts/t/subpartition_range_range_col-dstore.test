#--source include/not_have_only_dstore.inc

SET @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
SET global rds_extended_partitions_enabled = true;
--echo #
--echo # Verify range-range
--echo #
CREATE TABLE t2
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE(year(date))
SUBPARTITION BY RANGE COLUMNS(date)
(
  PARTITION p_2021 VALUES LESS THAN (2021) (
    SUBPARTITION q1_2021 VALUES LESS THAN('2021-06-01'),
    SUBPARTITION q2_2021 VALUES LESS THAN('2021-09-01')
    
  ),
  PARTITION p_2022 VALUES LESS THAN (2022)
  (
    SUBPARTITION q1_2022 VALUES LESS THAN('2022-06-01'),
    SUBPARTITION q2_2022 VALUES LESS THAN('2022-09-01')
  )
);
CREATE TABLE t3
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE COLUMNS(dept_no)
SUBPARTITION BY RANGE COLUMNS(date, country)
(
  PARTITION p_2021 VALUES LESS THAN (2021) (
    SUBPARTITION q1_2021 VALUES LESS THAN('2021-06-01', 'XXXX'),
    SUBPARTITION q2_2021 VALUES LESS THAN('2021-09-01', 'YYYY')
    
  ),
  PARTITION p_2022 VALUES LESS THAN (2022)
  (
    SUBPARTITION q1_2022 VALUES LESS THAN('2022-06-01', 'XXXX'),
    SUBPARTITION q2_2022 VALUES LESS THAN('2022-09-01', 'YYYY')
  )
);
DROP TABLE t2, t3;

CREATE TABLE t3 (
    id INT NOT NULL,
    store_id INT NOT NULL
)
PARTITION BY RANGE COLUMNS(store_id) 
SUBPARTITION BY RANGE COLUMNS(id) (
    PARTITION p0 VALUES LESS THAN (6) (
		SUBPARTITION q1 VALUES LESS THAN (4),
		SUBPARTITION q2 VALUES LESS THAN (10)
	),
    PARTITION p1 VALUES LESS THAN (11) (
		SUBPARTITION q3 VALUES LESS THAN (15),
		SUBPARTITION q4 VALUES LESS THAN (20)
	)
);
INSERT INTO t3 VALUES(1,3);
INSERT INTO t3 VALUES(14, 10);
INSERT INTO t3 VALUES(10, 8);
insert into t3 values(16,10);
SELECT * FROM t3;
SELECT * FROM t3 WHERE store_id = 1;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t3 WHERE store_id = 1;
SELECT * FROM t3 WHERE store_id = 3 and id = 1;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t3 WHERE store_id = 3 and id = 1;
SELECT * FROM t3 WHERE store_id = 10 and id = 14;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t3 WHERE store_id = 10 and id = 14;
SELECT * FROM t3 WHERE store_id = 10 and id > 15;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM t3 WHERE store_id = 10 and id > 15;
ALTER TABLE t3 ADD PARTITION (PARTITION p3 VALUES LESS THAN (20)(SUBPARTITION q5 VALUES LESS THAN(15), SUBPARTITION q6 VALUES LESS THAN(19)));
SHOW CREATE TABLE t3;
# Currently, we only support copy algorithm for partitioned tables in DStore.
# The default for MySQL for DROP PARTITION is the inplace algorithm.
# The behavior for inplace and copy algorithm is different for drop partition.
# Copy algorithm will not remove data, but look for a partition where data
# can be moved. Inplace will remove data. As in the documentation:
# DROP PARTITION is supported by native partitioning in-place APIs and may be used with ALGORITHM={COPY|INPLACE}.
# DROP PARTITION with ALGORITHM=INPLACE deletes data stored in the partition and drops the partition. However, DROP PARTITION with
# ALGORITHM=COPY or old_alter_table=ON rebuilds the partitioned table and attempts to move data from the dropped partition to another
# partition with a compatible PARTITION ... VALUES definition. Data that cannot be moved to another partition is deleted.
# After we inplace inplace algorithm - this test will need to be re-recorded. With copy algorithm the value 1 in p0.q1 will remain in
# this table.
ALTER TABLE t3 DROP PARTITION p0;
SELECT * FROM t3;
DROP TABLE t3;

CREATE TABLE sales_range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE COLUMNS(date)
SUBPARTITION BY RANGE COLUMNS(dept_no, part_no)
(
  PARTITION p_2020 VALUES LESS THAN ('2020-12-31') (
    SUBPARTITION q1_2020 VALUES LESS THAN(4, 5),
    SUBPARTITION q2_2020 VALUES LESS THAN(7, 6),
    SUBPARTITION q3_2020 VALUES LESS THAN(10, 12),
    SUBPARTITION q4_2020 VALUES LESS THAN(13, 15)
  ),
  PARTITION p_2021 VALUES LESS THAN ('2021-12-21') (
    SUBPARTITION q1_2021 VALUES LESS THAN(4, 5),
    SUBPARTITION q2_2021 VALUES LESS THAN(7, 6),
    SUBPARTITION q3_2021 VALUES LESS THAN(10, 12),
    SUBPARTITION q4_2021 VALUES LESS THAN(13, 15)
  ),
  PARTITION p_2022 VALUES LESS THAN ('2022-12-31')
  (
    SUBPARTITION q1_2022 VALUES LESS THAN(4, 5),
    SUBPARTITION q2_2022 VALUES LESS THAN(7, 6),
    SUBPARTITION q3_2022 VALUES LESS THAN(10, 12),
    SUBPARTITION q4_2022 VALUES LESS THAN(13, 15)
  )
);
ALTER TABLE sales_range_range ADD PARTITION (
    PARTITION p_2025 VALUES less than ('2025-12-31')
    (
    SUBPARTITION q1_2025 VALUES LESS THAN(4, 5),
    SUBPARTITION q2_2025 VALUES LESS THAN(7, 6),
    SUBPARTITION q3_2025 VALUES LESS THAN(10, 12),
    SUBPARTITION q4_2025 VALUES LESS THAN(13, 15)
  )
);
SHOW CREATE TABLE sales_range_range; 
ALTER TABLE sales_range_range DROP PARTITION p_2025;
SHOW CREATE TABLE sales_range_range; 
ALTER TABLE sales_range_range REORGANIZE PARTITION p_2022 INTO (
    PARTITION p_2026_1 VALUES LESS THAN ('2026-12-31')
    (
    SUBPARTITION q1_2026_1 VALUES LESS THAN(4, 5),
    SUBPARTITION q2_2026_1 VALUES LESS THAN(7, 6),
    SUBPARTITION q3_2026_1 VALUES LESS THAN(10, 12),
    SUBPARTITION q4_2026_1 VALUES LESS THAN(13, 15)
  ),
    PARTITION p_2027_2 VALUES LESS THAN ('2027-12-31')(
    SUBPARTITION q1_2027_2 VALUES LESS THAN(4, 5),
    SUBPARTITION q2_2027_2 VALUES LESS THAN(7, 6),
    SUBPARTITION q3_2027_2 VALUES LESS THAN(10, 12),
    SUBPARTITION q4_2027_2 VALUES LESS THAN(13, 15)
  )
);
SHOW CREATE TABLE sales_range_range; 
INSERT INTO sales_range_range VALUES(1, 3, 'china', '2020-04-05', 1),(5, 5, 'us', '2020-08-06', 2),(9, 11, 'jp', '2021-05-06', 3), (12, 14, 'kr', '2021-11-30', 4);
SELECT * FROM sales_range_range ORDER BY 1, 2, 4;
#ALTER TABLE sales_range_range DISCARD PARTITION q1_2020 TABLESPACE;
#ALTER TABLE sales_range_range IMPORT PARTITION q1_2020 TABLESPACE;
#SELECT * FROM sales_range_range ORDER BY 1, 2, 4;
ALTER TABLE sales_range_range ANALYZE PARTITION q2_2026_1, q1_2021;
ALTER TABLE sales_range_range CHECK PARTITION q2_2026_1, q1_2021;
ALTER TABLE sales_range_range OPTIMIZE PARTITION q2_2027_2, q1_2021;
--echo "REBUILD only adapts to partition but not SUBPARTITION"
ALTER TABLE sales_range_range REBUILD PARTITION p_2026_1;
ALTER TABLE sales_range_range REPAIR PARTITION q2_2026_1, q1_2021;
ALTER TABLE sales_range_range ANALYZE PARTITION p_2020, p_2021, p_2025, q1_2026_1, q1_2027_2;
SELECT partition_name, SUBPARTITION_name, table_rows from information_schema.partitions where table_name = 'sales_range_range';
ALTER TABLE sales_range_range TRUNCATE PARTITION q2_2027_2;
SELECT partition_name, SUBPARTITION_name, table_rows from information_schema.partitions where table_name = 'sales_range_range';
SELECT * FROM sales_range_range ORDER BY 1, 2, 4;
ALTER TABLE sales_range_range TRUNCATE PARTITION p_2026_1;
SELECT * FROM sales_range_range ORDER BY 1, 2, 4;
ALTER TABLE sales_range_range REMOVE PARTITIONING;
SHOW CREATE TABLE sales_range_range; 
SELECT * FROM sales_range_range ORDER BY 1, 2, 4;
DROP TABLE sales_range_range; 

# partition name must be unique within the table.
--error ER_SAME_NAME_PARTITION
CREATE TABLE sales_range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE COLUMNS(date)
SUBPARTITION BY RANGE COLUMNS(dept_no, dept_no, dept_no)
(
  PARTITION p_2020 VALUES LESS THAN ('2020-01-02') (
    SUBPARTITION q1_2020 VALUES LESS THAN(4, 4, 4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7, 7, 7)
  ),
  PARTITION p_2021 VALUES LESS THAN ('2021-04-05')
  (
    SUBPARTITION q1_2020 VALUES LESS THAN(4, 4, 4),
    SUBPARTITION q2_2021 VALUES LESS THAN(7, 7, 7)
  )
);

# number of partitions must be same.
--error ER_PARSE_ERROR 
CREATE TABLE sales_range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE(year(date))
SUBPARTITION BY RANGE COLUMNS(dept_no)
(
  PARTITION p_2020 VALUES LESS THAN (2020) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  ),
  PARTITION p_2021 VALUES LESS THAN (2021)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4)
  )
);

CREATE TABLE sales_range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE(year(date))
SUBPARTITION BY RANGE COLUMNS(dept_no, part_no)
(
  PARTITION p_2020 VALUES LESS THAN (2020) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4, 7),
    SUBPARTITION q2_2020 VALUES LESS THAN(7, maxvalue)
  ),
  PARTITION p_2021 VALUES LESS THAN (2021)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4, 10),
    SUBPARTITION q2_2021 VALUES LESS THAN(7, 9)
  )
);
