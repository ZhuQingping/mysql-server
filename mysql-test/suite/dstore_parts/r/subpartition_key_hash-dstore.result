#
# Test KEY - HASH
#
SET @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
SET global rds_extended_partitions_enabled = true;
create table t1
(
dept_no     int,
part_no     int,
country     varchar(20),
date        date,
amount      int
)
partition by  key(date)
subpartition by  hash(amount)
(
partition dp0 (
subpartition p0,
subpartition p1,
subpartition p2
),
partition dp1
(
subpartition p3,
subpartition p4,
subpartition p5
)
);
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `dept_no` int DEFAULT NULL,
  `part_no` int DEFAULT NULL,
  `country` varchar(20) DEFAULT NULL,
  `date` date DEFAULT NULL,
  `amount` int DEFAULT NULL
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY KEY (`date`)
SUBPARTITION BY HASH (`amount`)
(PARTITION dp0
 (SUBPARTITION p0 ENGINE = Dstore,
  SUBPARTITION p1 ENGINE = Dstore,
  SUBPARTITION p2 ENGINE = Dstore),
 PARTITION dp1
 (SUBPARTITION p3 ENGINE = Dstore,
  SUBPARTITION p4 ENGINE = Dstore,
  SUBPARTITION p5 ENGINE = Dstore)) */
insert into t1(date, amount) values('2021-01-01',1),
('2021-01-02',2),('2021-01-03',3),('2021-01-04',4),
('2021-01-05',5),('2021-01-06',6),('2021-09-01',1),
('2021-09-03',2),('2021-09-05',3),('2021-09-07',4),
('2021-09-21',5),('2021-09-23',6);
