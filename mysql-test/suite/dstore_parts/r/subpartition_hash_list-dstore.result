create table t1(a int, b int) partition by hash(a) subpartition by list(b) (
partition p1 (
subpartition p1sp0 values in (1,2,3),
subpartition p1sp1 values in (4,5,6)),
partition p2 (
subpartition p2sp0 values in (7,8,9,null),
subpartition p2sp1 values in (20,21,22)),
partition p3 (
subpartition p3sp0 values in (11,32),
subpartition p3sp1 values in (0,null,12,45,78,89))
);
