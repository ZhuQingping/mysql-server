# Test: RANGE - LIST
SET @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
SET global rds_extended_partitions_enabled = true;
create table t1
(
dept_no     int,
part_no     int,
country     varchar(20),
date        date,
amount      int
)
partition by range (month(date))
subpartition by list (amount)
(
partition q1_2012 values less than (4) (
subpartition p0 values in (1, 2),
subpartition p1 values in (3, 4),
subpartition p2 values in (5, 6)
),
partition q2_2012 values less than (7) (
subpartition p3 values in (1, 2),
subpartition p4 values in (3, 4),
subpartition p5 values in (5, 6)
)
);
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `dept_no` int DEFAULT NULL,
  `part_no` int DEFAULT NULL,
  `country` varchar(20) DEFAULT NULL,
  `date` date DEFAULT NULL,
  `amount` int DEFAULT NULL
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY RANGE (month(`date`))
SUBPARTITION BY LIST (`amount`)
(PARTITION q1_2012 VALUES LESS THAN (4)
 (SUBPARTITION p0 VALUES IN (1,2) ENGINE = Dstore,
  SUBPARTITION p1 VALUES IN (3,4) ENGINE = Dstore,
  SUBPARTITION p2 VALUES IN (5,6) ENGINE = Dstore),
 PARTITION q2_2012 VALUES LESS THAN (7)
 (SUBPARTITION p3 VALUES IN (1,2) ENGINE = Dstore,
  SUBPARTITION p4 VALUES IN (3,4) ENGINE = Dstore,
  SUBPARTITION p5 VALUES IN (5,6) ENGINE = Dstore)) */
insert into t1(date, amount) values
('2023-01-01',1),('2023-05-01',2),
('2023-02-01',3),('2023-06-01',4),
('2023-03-01',5),('2023-04-01',6);
select * from t1;
dept_no	part_no	country	date	amount
