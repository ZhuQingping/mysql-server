1	SIMPLE	t1	q1_2012_p1	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Using pushed condition ((`test`.`t1`.`amount` = 3) and (`test`.`t1`.`date` = DATE'2022-02-23'))
Warnings:
