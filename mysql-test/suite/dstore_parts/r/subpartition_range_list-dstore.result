1	SIMPLE	t1	q1_2012_p0,q1_2012_p1,q1_2012_p2	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Using pushed condition (`test`.`t1`.`date` = DATE'2022-02-23')
