SET @start_value = @@global.rds_restricted_dynamic_privileges_list;
SELECT @start_value;
@start_value
SYSTEM_VARIABLES_ADMIN
# Simulate malloc fail
SET session debug = "+d, simulate_restricted_dynamic_privileges_list_malloc_fail";
