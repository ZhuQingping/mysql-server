set @save_kMaxChunks = @@global.kMaxChunks;
# Default value
SELECT @save_kMaxChunks;
@save_kMaxChunks
8192
# valid value
set global kMaxChunks = 32;
select @@global.kMaxChunks;
@@global.kMaxChunks
32
set global kMaxChunks = 33;
select @@global.kMaxChunks;
@@global.kMaxChunks
33
set global kMaxChunks = 128;
select @@global.kMaxChunks;
@@global.kMaxChunks
128
set global kMaxChunks = 8000;
select @@global.kMaxChunks;
@@global.kMaxChunks
8000
set global kMaxChunks = 8192;
select @@global.kMaxChunks;
@@global.kMaxChunks
8192
# invalid value
set global kMaxChunks="aaa";
ERROR 42000: Incorrect argument type to variable 'kMaxChunks'
select @@global.kMaxChunks;
@@global.kMaxChunks
8192
set global kMaxChunks=1.1;
ERROR 42000: Incorrect argument type to variable 'kMaxChunks'
select @@global.kMaxChunks;
@@global.kMaxChunks
8192
set session kMaxChunks=1;
ERROR HY000: Variable 'kMaxChunks' is a GLOBAL variable and should be set with SET GLOBAL
select @@global.kMaxChunks;
@@global.kMaxChunks
8192
set global kMaxChunks=31;
