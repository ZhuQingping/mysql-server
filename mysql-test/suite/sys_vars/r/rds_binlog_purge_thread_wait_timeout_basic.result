# Default values
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
@@GLOBAL.rds_binlog_purge_thread_wait_timeout
600
SELECT @@SESSION.rds_binlog_purge_thread_wait_timeout;
ERROR HY000: Variable 'rds_binlog_purge_thread_wait_timeout' is a GLOBAL variable
SET @saved_value = @@global.rds_binlog_purge_thread_wait_timeout;
# Valid values
SET GLOBAL rds_binlog_purge_thread_wait_timeout = 1;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
@@GLOBAL.rds_binlog_purge_thread_wait_timeout
1
