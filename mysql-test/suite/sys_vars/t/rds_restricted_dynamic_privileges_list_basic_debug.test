--source include/have_debug.inc
 
SET @start_value = @@global.rds_restricted_dynamic_privileges_list;
SELECT @start_value;
 
--echo # Simulate malloc fail
SET session debug = "+d, simulate_restricted_dynamic_privileges_list_malloc_fail";
--Error ER_WRONG_ARGUMENTS
SET @@global.rds_restricted_dynamic_privileges_list = "session_variables_admin";
SET session debug = "-d, simulate_restricted_dynamic_privileges_list_malloc_fail";
 
--echo # Restore initial value.
SET @@global.rds_restricted_dynamic_privileges_list = @start_value;
SELECT @@global.rds_restricted_dynamic_privileges_list;