###### mysql-test\t\rds_restricted_dynamic_privileges_control_basic.test ######
#                                                                             #
# Variable Name: rds_restricted_dynamic_privileges_control                    #
# Scope: GLOBAL                                                               #
# Access Type: Dynamic                                                        #
# Data Type: BOOLEAN                                                          #
# Default Value: OFF                                                          #
# Values: ON, OFF                                                             #
###############################################################################
 
--source include/load_sysvars.inc
 
 
############################################################
# START OF rds_restricted_dynamic_privileges_control TESTS #
############################################################
 
 
######################################################################
# Saving initial values of rds_restricted_dynamic_privileges_control #
# variables in a temporary variable                                  #
######################################################################
 
SET @start_rds_restricted_dynamic_privileges_control = @@global.rds_restricted_dynamic_privileges_control;
SELECT @start_rds_restricted_dynamic_privileges_control;
 
##########################################################################
# Display the DEFAULT value of rds_restricted_dynamic_privileges_control #
##########################################################################
 
SET @@global.rds_restricted_dynamic_privileges_control = 1;
SET @@global.rds_restricted_dynamic_privileges_control = DEFAULT;
SELECT @@global.rds_restricted_dynamic_privileges_control;
 
###############################################
#     Verify default value of variable        #
###############################################
 
SET @@global.rds_restricted_dynamic_privileges_control = @start_rds_restricted_dynamic_privileges_control;
SELECT @@global.rds_restricted_dynamic_privileges_control = 0;
 
##################################################################################
# Change the value of rds_restricted_dynamic_privileges_control to a valid value #
##################################################################################
 
SET @@global.rds_restricted_dynamic_privileges_control = 0;
SELECT @@global.rds_restricted_dynamic_privileges_control;
SET @@global.rds_restricted_dynamic_privileges_control = 1;
SELECT @@global.rds_restricted_dynamic_privileges_control;
SET @@global.rds_restricted_dynamic_privileges_control = TRUE;
SELECT @@global.rds_restricted_dynamic_privileges_control;
SET @@global.rds_restricted_dynamic_privileges_control = FALSE;
SELECT @@global.rds_restricted_dynamic_privileges_control;
SET @@global.rds_restricted_dynamic_privileges_control = ON;
SELECT @@global.rds_restricted_dynamic_privileges_control;
SET @@global.rds_restricted_dynamic_privileges_control = OFF;
SELECT @@global.rds_restricted_dynamic_privileges_control;
 
##################################################################################
# Change the value of rds_restricted_dynamic_privileges_control to invalid value #
##################################################################################
 
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_control = -1;
SELECT @@global.rds_restricted_dynamic_privileges_control;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_control = 4294967296;
SELECT @@global.rds_restricted_dynamic_privileges_control;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_control = 10240022115;
SELECT @@global.rds_restricted_dynamic_privileges_control;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_control = 10000.01;
SELECT @@global.rds_restricted_dynamic_privileges_control;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_control = -1024;
SELECT @@global.rds_restricted_dynamic_privileges_control;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_control = 42949672950;
SELECT @@global.rds_restricted_dynamic_privileges_control;
 
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_control = 'test';
SELECT @@global.rds_restricted_dynamic_privileges_control;
 
###################################################################################
# Test if accessing session rds_restricted_dynamic_privileges_control gives error #
###################################################################################
 
--Error ER_GLOBAL_VARIABLE
SET @@session.rds_restricted_dynamic_privileges_control = 0;
SELECT @@rds_restricted_dynamic_privileges_control;
 
##############################################################################
# Check if the value in GLOBAL & SESSION Tables matches values in variable   #
##############################################################################
 
--disable_warnings
SELECT IF(@@global.rds_restricted_dynamic_privileges_control, "ON", "OFF") = VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME='rds_restricted_dynamic_privileges_control';
 
SELECT IF(@@rds_restricted_dynamic_privileges_control, "ON", "OFF") = VARIABLE_VALUE
FROM performance_schema.session_variables
WHERE VARIABLE_NAME='rds_restricted_dynamic_privileges_control';
--enable_warnings
 
########################################################################################################
#    Check if accessing variable with SESSION,LOCAL and without SCOPE points to same session variable  #
########################################################################################################
 
SET @@global.rds_restricted_dynamic_privileges_control = 1;
SELECT @@rds_restricted_dynamic_privileges_control = @@global.rds_restricted_dynamic_privileges_control;
 
###############################################################################################
# Check if rds_restricted_dynamic_privileges_control can be accessed with and without @@ sign #
###############################################################################################
 
--Error ER_GLOBAL_VARIABLE
SET rds_restricted_dynamic_privileges_control = 1;
SELECT @@rds_restricted_dynamic_privileges_control;
--Error ER_PARSE_ERROR
SET local.rds_restricted_dynamic_privileges_control = 1;
--Error ER_UNKNOWN_TABLE
SELECT local.rds_restricted_dynamic_privileges_control;
--Error ER_PARSE_ERROR
SET global.rds_restricted_dynamic_privileges_control = 1;
--Error ER_UNKNOWN_TABLE
SELECT global.rds_restricted_dynamic_privileges_control;
--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT rds_restricted_dynamic_privileges_control = @@session.rds_restricted_dynamic_privileges_control;
 
##############################
#   Restore initial value    #
##############################
 
SET @@global.rds_restricted_dynamic_privileges_control = @start_rds_restricted_dynamic_privileges_control;
 
SELECT @@global.rds_restricted_dynamic_privileges_control;
 
 
#######################################################################
#              END OF rds_restricted_dynamic_privileges_control TESTS                           #
#######################################################################
 