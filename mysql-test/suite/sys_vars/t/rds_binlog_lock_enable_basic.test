--echo #
--echo # rds_binlog_lock_enable
--echo #

SHOW VARIABLES LIKE 'rds_binlog_lock_enable';
SHOW GLOBAL VARIABLES LIKE 'rds_binlog_lock_enable';
SHOW SESSION VARIABLES LIKE 'rds_binlog_lock_enable';

SELECT @@rds_binlog_lock_enable;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@LOCAL.rds_binlog_lock_enable;
SELECT @@GLOBAL.rds_binlog_lock_enable;

--error ER_GLOBAL_VARIABLE
SET @@rds_binlog_lock_enable=0;
--error ER_GLOBAL_VARIABLE
SET @@LOCAL.rds_binlog_lock_enable=0;

SET @@GLOBAL.rds_binlog_lock_enable=0;

SET @@GLOBAL.rds_binlog_lock_enable=1;
