############## mysql-test\t\rds_plan_cache_allow_change_ratio.test ############
#                                                                             #
# Variable Name: rds_plan_cache_allow_change_ratio                            #
# Scope: GLOBAL                                                               #
# Access Type: Session                                                        #
# Data Type: double                                                           #
# Default Value:0.2                                                           #
# Range: 0-DBL_MAX                                                            #
#                                                                             #
# Description: Test Cases of Dynamic System Variable                          #
#              rds_plan_cache_allow_change_ratio that checks the behavior     #
#              of this variable in the following ways                         #
#              * Default Value                                                #
#              * Valid & Invalid values                                       #
#              * Scope & Access method                                        #
#              * Data Integrity                                               #
#                                                                             #
###############################################################################

--source include/load_sysvars.inc

########################################################################
#              START OF rds_plan_cache_allow_change_ratio TESTS        #
########################################################################
SET @start_rds_plan_cache_allow_change_ratio = @@session.rds_plan_cache_allow_change_ratio;
SELECT @start_rds_plan_cache_allow_change_ratio;

########################################################################
#           Display the DEFAULT value of rds_plan_cache_allow_change_ratio         #
########################################################################
SET @@session.rds_plan_cache_allow_change_ratio = 2;
SET @@session.rds_plan_cache_allow_change_ratio = DEFAULT;
SELECT @@session.rds_plan_cache_allow_change_ratio;

###############################################
#     Verify default value of variable        #
###############################################
SET @@rds_plan_cache_allow_change_ratio = @start_rds_plan_cache_allow_change_ratio;
SELECT @@rds_plan_cache_allow_change_ratio = 0.2;

############################################################################
#  Change the value of rds_plan_cache_allow_change_ratio to a valid value  #
############################################################################
SET @@session.rds_plan_cache_allow_change_ratio = 0;
SELECT @@session.rds_plan_cache_allow_change_ratio;
SET @@session.rds_plan_cache_allow_change_ratio = 1;
SELECT @@session.rds_plan_cache_allow_change_ratio;
SET @@session.rds_plan_cache_allow_change_ratio = 0.5;
SELECT @@session.rds_plan_cache_allow_change_ratio;
SET @@session.rds_plan_cache_allow_change_ratio = 100;
SELECT @@session.rds_plan_cache_allow_change_ratio;
SET @@session.rds_plan_cache_allow_change_ratio = -1;
SELECT @@session.rds_plan_cache_allow_change_ratio;
SET @@session.rds_plan_cache_allow_change_ratio = DEFAULT;
SELECT @@session.rds_plan_cache_allow_change_ratio;

SET @@global.rds_plan_cache_allow_change_ratio = 0;
SELECT @@global.rds_plan_cache_allow_change_ratio;
SET @@global.rds_plan_cache_allow_change_ratio = 1;
SELECT @@global.rds_plan_cache_allow_change_ratio;
SET @@global.rds_plan_cache_allow_change_ratio = 0.5;
SELECT @@global.rds_plan_cache_allow_change_ratio;
SET @@global.rds_plan_cache_allow_change_ratio = 100;
SELECT @@global.rds_plan_cache_allow_change_ratio;
SET @@global.rds_plan_cache_allow_change_ratio = -1;
SELECT @@global.rds_plan_cache_allow_change_ratio;
SET @@global.rds_plan_cache_allow_change_ratio = DEFAULT;
SELECT @@global.rds_plan_cache_allow_change_ratio;

############################################################################
#  Change the value of rds_plan_cache_allow_change_ratio to invalid value  #
############################################################################
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_plan_cache_allow_change_ratio = ON;
SELECT @@global.rds_plan_cache_allow_change_ratio;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_plan_cache_allow_change_ratio = 'test';
SELECT @@global.rds_plan_cache_allow_change_ratio;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.rds_plan_cache_allow_change_ratio = ' ';
SELECT @@session.rds_plan_cache_allow_change_ratio;

######################################################################
# Check if the value in GLOBAL & SESSION Tables values in variable   #
######################################################################
--disable_warnings
SELECT @@global.rds_plan_cache_allow_change_ratio = VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME='rds_plan_cache_allow_change_ratio';

SELECT @@session.rds_plan_cache_allow_change_ratio = VARIABLE_VALUE
FROM performance_schema.session_variables
WHERE VARIABLE_NAME='rds_plan_cache_allow_change_ratio';
--enable_warnings

###################################################################
#      Check if TRUE and FALSE values can be used on variable     #
###################################################################
SET @@session.rds_plan_cache_allow_change_ratio = TRUE;
SELECT @@session.rds_plan_cache_allow_change_ratio;
SET @@session.rds_plan_cache_allow_change_ratio = FALSE;
SELECT @@session.rds_plan_cache_allow_change_ratio;

########################################################################################################
#    Check if accessing variable with SESSION,LOCAL and without SCOPE points to same session variable  #
########################################################################################################
SET @@global.rds_plan_cache_allow_change_ratio = 100;
SELECT @@rds_plan_cache_allow_change_ratio = @@global.rds_plan_cache_allow_change_ratio;

#######################################################################################
# Check if rds_plan_cache_allow_change_ratio can be accessed with and without @@ sign #
#######################################################################################
--Error ER_PARSE_ERROR
SET local.rds_plan_cache_allow_change_ratio = 7;
--Error ER_UNKNOWN_TABLE
SELECT local.rds_plan_cache_allow_change_ratio;
--Error ER_PARSE_ERROR
SET global.rds_plan_cache_allow_change_ratio = 8;
--Error ER_UNKNOWN_TABLE
SELECT global.rds_plan_cache_allow_change_ratio;
--Error ER_BAD_FIELD_ERROR
SELECT rds_plan_cache_allow_change_ratio = @@session.rds_plan_cache_allow_change_ratio;

##############################
#   Restore initial value    #
##############################
SET @@global.rds_plan_cache_allow_change_ratio = @start_rds_plan_cache_allow_change_ratio;
SELECT @@global.rds_plan_cache_allow_change_ratio;
SET @@session.rds_plan_cache_allow_change_ratio = @start_rds_plan_cache_allow_change_ratio;
SELECT @@session.rds_plan_cache_allow_change_ratio;

########################################################################
#          END OF rds_plan_cache_allow_change_ratio TESTS              #
########################################################################
