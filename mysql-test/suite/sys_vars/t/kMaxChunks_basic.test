set @save_kMaxChunks = @@global.kMaxChunks;

--echo # Default value
SELECT @save_kMaxChunks;
 
--echo # valid value
set global kMaxChunks = 32;
select @@global.kMaxChunks;
set global kMaxChunks = 33;
select @@global.kMaxChunks;
set global kMaxChunks = 128;
select @@global.kMaxChunks;
set global kMaxChunks = 8000;
select @@global.kMaxChunks;
set global kMaxChunks = 8192;
select @@global.kMaxChunks;

--echo # invalid value
--error ER_WRONG_TYPE_FOR_VAR
set global kMaxChunks="aaa";
select @@global.kMaxChunks;

--error ER_WRONG_TYPE_FOR_VAR
set global kMaxChunks=1.1;
select @@global.kMaxChunks;

--error ER_GLOBAL_VARIABLE
set session kMaxChunks=1;
select @@global.kMaxChunks;

# --error ER_WRONG_VALUE_FOR_VAR
set global kMaxChunks=31;
select @@global.kMaxChunks;

# --error ER_WRONG_VALUE_FOR_VAR
set global kMaxChunks=8193;
select @@global.kMaxChunks;

SET @@global.kMaxChunks = @save_kMaxChunks;
