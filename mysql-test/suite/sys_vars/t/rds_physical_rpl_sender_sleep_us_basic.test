# ulong global

SET @start_global_value = @@global.rds_physical_rpl_sender_sleep_us;

#
# exists as global only
#
select @@global.rds_physical_rpl_sender_sleep_us;
show global variables like 'rds_physical_rpl_sender_sleep_us';
show session variables like 'rds_physical_rpl_sender_sleep_us';
select * from performance_schema.global_variables where variable_name='rds_physical_rpl_sender_sleep_us';
select * from performance_schema.session_variables where variable_name='rds_physical_rpl_sender_sleep_us';

#
# show that it's writable
#
set global rds_physical_rpl_sender_sleep_us=1;
select @@global.rds_physical_rpl_sender_sleep_us;
--error ER_GLOBAL_VARIABLE
set session rds_physical_rpl_sender_sleep_us=1;

#
# incorrect types
#
--error ER_WRONG_TYPE_FOR_VAR
set global rds_physical_rpl_sender_sleep_us=1.1;
--error ER_WRONG_TYPE_FOR_VAR
set global rds_physical_rpl_sender_sleep_us=1e1;
--error ER_WRONG_TYPE_FOR_VAR
set global rds_physical_rpl_sender_sleep_us="xiaoli";

#
# min/max values
#
set global rds_physical_rpl_sender_sleep_us=0;
set global rds_physical_rpl_sender_sleep_us=cast(-1 as unsigned int);
select @@global.rds_physical_rpl_sender_sleep_us;

SET @@global.rds_physical_rpl_sender_sleep_us = @start_global_value;
