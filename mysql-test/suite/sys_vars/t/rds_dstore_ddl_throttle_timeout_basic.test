--source include/load_sysvars.inc

SET @start_global_value = @@global.rds_dstore_ddl_throttle_timeout;
SELECT @start_global_value;

SET @@global.rds_dstore_ddl_throttle_timeout = DEFAULT;
SELECT @@global.rds_dstore_ddl_throttle_timeout;

SET @@global.rds_dstore_ddl_throttle_timeout = 1;
SELECT @@global.rds_dstore_ddl_throttle_timeout;
SET @@global.rds_dstore_ddl_throttle_timeout = 600;
SELECT @@global.rds_dstore_ddl_throttle_timeout;
SET @@global.rds_dstore_ddl_throttle_timeout = 31536000;
SELECT @@global.rds_dstore_ddl_throttle_timeout;

SET @@global.rds_dstore_ddl_throttle_timeout = 0;
SELECT @@global.rds_dstore_ddl_throttle_timeout;
SET @@global.rds_dstore_ddl_throttle_timeout = -1024;
SELECT @@global.rds_dstore_ddl_throttle_timeout;
SET @@global.rds_dstore_ddl_throttle_timeout = 31536001;
SELECT @@global.rds_dstore_ddl_throttle_timeout;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_dstore_ddl_throttle_timeout = 10.5;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_dstore_ddl_throttle_timeout = ON;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_dstore_ddl_throttle_timeout = test;

SELECT @@global.rds_dstore_ddl_throttle_timeout = VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME='rds_dstore_ddl_throttle_timeout';

SET @@global.rds_dstore_ddl_throttle_timeout = @start_global_value;
SELECT @@global.rds_dstore_ddl_throttle_timeout;
