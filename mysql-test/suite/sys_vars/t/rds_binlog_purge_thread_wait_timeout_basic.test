###############################################################################
#                                                                             #
# The basic test of rds_binlog_purge_thread_wait_timeout                      #
#                                                                             #
###############################################################################

--echo # Default values
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@SESSION.rds_binlog_purge_thread_wait_timeout;

SET @saved_value = @@global.rds_binlog_purge_thread_wait_timeout;

--echo # Valid values
SET GLOBAL rds_binlog_purge_thread_wait_timeout = 1;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
SET GLOBAL rds_binlog_purge_thread_wait_timeout = 10;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
SET GLOBAL rds_binlog_purge_thread_wait_timeout = 60;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
SET GLOBAL rds_binlog_purge_thread_wait_timeout = 600;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
SET GLOBAL rds_binlog_purge_thread_wait_timeout = 6000;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
SET GLOBAL rds_binlog_purge_thread_wait_timeout = 31536000;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;

--echo # Invalid values: there shall be warnings about truncation
SET GLOBAL rds_binlog_purge_thread_wait_timeout = -1;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
SET GLOBAL rds_binlog_purge_thread_wait_timeout = 0;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
SET GLOBAL rds_binlog_purge_thread_wait_timeout = 31536001;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;
SET GLOBAL rds_binlog_purge_thread_wait_timeout = 31536010;
SELECT @@GLOBAL.rds_binlog_purge_thread_wait_timeout;

SET GLOBAL rds_binlog_purge_thread_wait_timeout = @saved_value;

