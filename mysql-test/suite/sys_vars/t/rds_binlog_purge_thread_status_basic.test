#
# only global
#
select @@global.rds_binlog_purge_thread_status;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
select @@session.rds_binlog_purge_thread_status;
show global variables like 'rds_binlog_purge_thread_status';
show session variables like 'rds_binlog_purge_thread_status';
--disable_warnings
select * from performance_schema.global_variables where variable_name='rds_binlog_purge_thread_status';
select * from performance_schema.session_variables where variable_name='rds_binlog_purge_thread_status';
--enable_warnings

#
# show that it's read-only
#
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
set global rds_binlog_purge_thread_status=1;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
set session rds_binlog_purge_thread_status=1;

