
# Save initial value
SET @saved_value= @@GLOBAL.rds_purge_binary_logs_asynchronously;

--echo #
--echo # Verify it can be queried corrected in different ways.
--echo #
SELECT @@GLOBAL.rds_purge_binary_logs_asynchronously;
--disable_warnings
SELECT VARIABLE_VALUE FROM performance_schema.global_variables WHERE
  VARIABLE_NAME = 'rds_purge_binary_logs_asynchronously';
--enable_warnings
SHOW GLOBAL VARIABLES LIKE 'rds_purge_binary_logs_asynchronously';

--echo #
--echo # Verify it is not a session variable
--echo #
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@SESSION.rds_purge_binary_logs_asynchronously;
--disable_warnings
SELECT VARIABLE_VALUE FROM performance_schema.session_variables WHERE
  VARIABLE_NAME = 'rds_purge_binary_logs_asynchronously';
--enable_warnings
SHOW SESSION VARIABLES LIKE 'rds_purge_binary_logs_asynchronously';

--error ER_GLOBAL_VARIABLE
SET SESSION rds_purge_binary_logs_asynchronously= FALSE;
SELECT @@global.rds_purge_binary_logs_asynchronously;

--echo #
--echo # Verify it can be set correctly
--echo #
SET GLOBAL rds_purge_binary_logs_asynchronously= true;
SELECT @@global.rds_purge_binary_logs_asynchronously;
--disable_warnings
SELECT VARIABLE_VALUE FROM performance_schema.global_variables WHERE
  VARIABLE_NAME = 'rds_purge_binary_logs_asynchronously';
--enable_warnings

SET GLOBAL rds_purge_binary_logs_asynchronously= false;
SELECT @@global.rds_purge_binary_logs_asynchronously;

SET GLOBAL rds_purge_binary_logs_asynchronously= TRUE;
SELECT @@global.rds_purge_binary_logs_asynchronously;

SET GLOBAL rds_purge_binary_logs_asynchronously= FALSE;
SELECT @@global.rds_purge_binary_logs_asynchronously;

SET GLOBAL rds_purge_binary_logs_asynchronously= ON;
SELECT @@global.rds_purge_binary_logs_asynchronously;

SET GLOBAL rds_purge_binary_logs_asynchronously= OFF;
SELECT @@global.rds_purge_binary_logs_asynchronously;

SET GLOBAL rds_purge_binary_logs_asynchronously= 1;
SELECT @@global.rds_purge_binary_logs_asynchronously;

SET GLOBAL rds_purge_binary_logs_asynchronously= 0;
SELECT @@global.rds_purge_binary_logs_asynchronously;

SET GLOBAL rds_purge_binary_logs_asynchronously= DEFAULT;
SELECT @@global.rds_purge_binary_logs_asynchronously;

--echo #
--echo # It should throw an error when encountering invalid value
--echo #
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL rds_purge_binary_logs_asynchronously= 2;
SELECT @@global.rds_purge_binary_logs_asynchronously;

--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL rds_purge_binary_logs_asynchronously= -1;
SELECT @@global.rds_purge_binary_logs_asynchronously;

--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL rds_purge_binary_logs_asynchronously= NULL;
SELECT @@global.rds_purge_binary_logs_asynchronously;

--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL rds_purge_binary_logs_asynchronously= '';
SELECT @@global.rds_purge_binary_logs_asynchronously;

--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL rds_purge_binary_logs_asynchronously= 'GARBAGE';
SELECT @@global.rds_purge_binary_logs_asynchronously;

# Restore the initial value
SET GLOBAL rds_purge_binary_logs_asynchronously = @saved_value;
