################################################################################
#                                                                              #
# Variable Name: rds_binlog_enable_group_replication                           #
# Scope: GLOBAL                                                                #
# Access Type: Dynamic                                                         #
# Data Type: BOOLEAN                                                           #
# Default Value: FALSE                                                         #
# Valid Values: TRUE, FALSE                                                    #
#                                                                              #
#                                                                              #
################################################################################
--source include/load_sysvars.inc

###########################################################
#           START OF rds_binlog_enable_group_replication TESTS           #
###########################################################


############################################################################
#   Saving initial value of rds_binlog_enable_group_replication in a temporary variable   #
############################################################################

SET @start_value = @@global.rds_binlog_enable_group_replication;
SELECT @start_value;


--echo '#---------------------FN_DYNVARS_004_01-------------------------#'
###############################################
#     Verify default value of variable        #
###############################################

SET @@global.rds_binlog_enable_group_replication = DEFAULT;
SELECT @@global.rds_binlog_enable_group_replication = FALSE;


--echo '#--------------------FN_DYNVARS_004_02------------------------#'
######################################################################
#        Change the value of rds_binlog_enable_group_replication to a valid value   #
######################################################################

SET @@global.rds_binlog_enable_group_replication = ON;
SELECT @@global.rds_binlog_enable_group_replication;
SET @@global.rds_binlog_enable_group_replication = OFF;
SELECT @@global.rds_binlog_enable_group_replication;

--echo '#--------------------FN_DYNVARS_004_03-------------------------#'
######################################################################
#        Change the value of rds_binlog_enable_group_replication to invalid value   #
######################################################################

--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = 2;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = -1;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = TRUEF;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = TRUE_F;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = FALSE0;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = OON;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = ONN;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = OOFF;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = 0FF;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = ' ';
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = " ";
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_binlog_enable_group_replication = '';


--echo '#-------------------FN_DYNVARS_004_04----------------------------#'
########################################################################
#         Test if accessing session rds_binlog_enable_group_replication gives error   #
########################################################################

--Error ER_GLOBAL_VARIABLE
SET @@session.rds_binlog_enable_group_replication = OFF;
--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@session.rds_binlog_enable_group_replication;


--echo '#----------------------FN_DYNVARS_004_05------------------------#'
##############################################################################
# Check if the value in GLOBAL Tables matches values in variable             #
##############################################################################

--disable_warnings
SELECT IF(@@global.rds_binlog_enable_group_replication, "ON", "OFF") = VARIABLE_VALUE 
FROM performance_schema.global_variables 
WHERE VARIABLE_NAME='rds_binlog_enable_group_replication';
--enable_warnings


--echo '#---------------------FN_DYNVARS_004_06----------------------#'
################################################################
#        Check if 0 and 1 values can be used on variable       #
################################################################

SET @@global.rds_binlog_enable_group_replication = 0;
SELECT @@global.rds_binlog_enable_group_replication;
SET @@global.rds_binlog_enable_group_replication = 1;
SELECT @@global.rds_binlog_enable_group_replication;

--echo '#---------------------FN_DYNVARS_004_07----------------------#'
################################################################### 
#      Check if TRUE and FALSE values can be used on variable     #
################################################################### 

SET @@global.rds_binlog_enable_group_replication = TRUE;
SELECT @@global.rds_binlog_enable_group_replication;
SET @@global.rds_binlog_enable_group_replication = FALSE;
SELECT @@global.rds_binlog_enable_group_replication;

--echo '#---------------------FN_DYNVARS_004_08----------------------#'
##############################################################################
#    Check if accessing variable with SESSION,LOCAL and without SCOPE points #
#    to same session variable                                                #
##############################################################################

SET @@global.rds_binlog_enable_group_replication = ON;
SELECT @@rds_binlog_enable_group_replication = @@global.rds_binlog_enable_group_replication;

--echo '#---------------------FN_DYNVARS_004_09----------------------#'
######################################################################
#   Check if rds_binlog_enable_group_replication can be accessed with and without @@ sign #
######################################################################
--Error ER_GLOBAL_VARIABLE
SET rds_binlog_enable_group_replication = ON;
--Error ER_PARSE_ERROR
SET local.rds_binlog_enable_group_replication = OFF;
--Error ER_UNKNOWN_TABLE
SELECT local.rds_binlog_enable_group_replication;
--Error ER_PARSE_ERROR
SET global.rds_binlog_enable_group_replication = ON;
--Error ER_UNKNOWN_TABLE
SELECT global.rds_binlog_enable_group_replication;
--Error ER_BAD_FIELD_ERROR
SELECT rds_binlog_enable_group_replication;
--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@session.rds_binlog_enable_group_replication;



##############################  
#   Restore initial value    #
##############################

SET @@global.rds_binlog_enable_group_replication = @start_value;
SELECT @@global.rds_binlog_enable_group_replication;


####################################################
#       END OF rds_binlog_enable_group_replication TESTS          #
####################################################
