######## mysql-test\t\rds_restricted_dynamic_privileges_list_basic.test #######
#                                                                             #
# Variable Name: rds_restricted_dynamic_privileges_list                       #
# Scope: GLOBAL                                                               #
# Access Type: Dynamic                                                        #
# Data Type: STRING                                                           #
# Default Value: empty string                                                 #
# Values: dyanmic privilege names [priv1,priv2,...]                           #
###############################################################################
 
--source include/load_sysvars.inc
 
#########################################################
# START OF rds_restricted_dynamic_privileges_list TESTS #
#########################################################
 
 
###################################################################
# Saving initial values of rds_restricted_dynamic_privileges_list #
# variables in a temporary variable                               #
###################################################################
 
SET @start_rds_restricted_dynamic_privileges_list = @@global.rds_restricted_dynamic_privileges_list;
SELECT @start_rds_restricted_dynamic_privileges_list;
 
#######################################################################
# Display the DEFAULT value of rds_restricted_dynamic_privileges_list #
#######################################################################
 
SET @@global.rds_restricted_dynamic_privileges_list = "session_variables_admin";
SET @@global.rds_restricted_dynamic_privileges_list = DEFAULT;
SELECT @@global.rds_restricted_dynamic_privileges_list;
 
###############################################
#     Verify default value of variable        #
###############################################
 
SET @@global.rds_restricted_dynamic_privileges_list = @start_rds_restricted_dynamic_privileges_list;
SELECT @@global.rds_restricted_dynamic_privileges_list = "";
 
###############################################################################
# Change the value of rds_restricted_dynamic_privileges_list to a valid value #
###############################################################################
 
SET @@global.rds_restricted_dynamic_privileges_list = "";
SELECT @@global.rds_restricted_dynamic_privileges_list;
SET @@global.rds_restricted_dynamic_privileges_list = "session_variables_admin";
SELECT @@global.rds_restricted_dynamic_privileges_list;
SET @@global.rds_restricted_dynamic_privileges_list = "session_variables_admin,system_variables_admin";
SELECT @@global.rds_restricted_dynamic_privileges_list;
SET @@global.rds_restricted_dynamic_privileges_list = "session_variables_admin,SYSTEM_VARIABLES_ADMIN";
SELECT @@global.rds_restricted_dynamic_privileges_list;
SET @@global.rds_restricted_dynamic_privileges_list = "SeSSion_vARIables_aDMiN,SYstem_varIaBleS_adMin";
SELECT @@global.rds_restricted_dynamic_privileges_list;
# ALL Dyanamic Privileges
SET @@global.rds_restricted_dynamic_privileges_list = "APPLICATION_PASSWORD_ADMIN,AUDIT_ADMIN,BACKUP_ADMIN,BINLOG_ADMIN,BINLOG_ENCRYPTION_ADMIN,CLONE_ADMIN,CONNECTION_ADMIN,ENCRYPTION_KEY_ADMIN,GROUP_REPLICATION_ADMIN,INNODB_REDO_LOG_ENABLE,PERSIST_RO_VARIABLES_ADMIN,REPLICATION_APPLIER,REPLICATION_SLAVE_ADMIN,RESOURCE_GROUP_ADMIN,RESOURCE_GROUP_USER,ROLE_ADMIN,SERVICE_CONNECTION_ADMIN,SESSION_VARIABLES_ADMIN,SET_USER_ID,SHOW_ROUTINE,SYSTEM_USER,SYSTEM_VARIABLES_ADMIN,TABLE_ENCRYPTION_ADMIN,XA_RECOVER_ADMIN";
SELECT @@global.rds_restricted_dynamic_privileges_list;
 
##################################################################################
# Change the value of rds_restricted_dynamic_privileges_list to invalid value #
##################################################################################
 
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = -1;
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = 4294967296;
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "abc";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "SYSTEM";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "SYSTEM_";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "_SYSTEM";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "S_YSTEM";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = " ";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = ",";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "session_variables_admin,";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "session_variables_admin,,system_variables_admin";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "session_variables_admin, ,system_variables_admin";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "session_variables_admin,abc,system_variables_admin";
SELECT @@global.rds_restricted_dynamic_privileges_list;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "session_variables_admin,[/^&#,system_variables_admin";
SELECT @@global.rds_restricted_dynamic_privileges_list;
# Valid names but too long (>1024)
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.rds_restricted_dynamic_privileges_list = "APPLICATION_PASSWORD_ADMIN,AUDIT_ADMIN,BACKUP_ADMIN,BINLOG_ADMIN,BINLOG_ENCRYPTION_ADMIN,CLONE_ADMIN,CONNECTION_ADMIN,ENCRYPTION_KEY_ADMIN,FLUSH_OPTIMIZER_COSTS,FLUSH_STATUS,FLUSH_TABLES,FLUSH_USER_RESOURCES,GROUP_REPLICATION_ADMIN,GROUP_REPLICATION_STREAM,INNODB_REDO_LOG_ENABLE,PASSWORDLESS_USER_ADMIN,PERSIST_RO_VARIABLES_ADMIN,REPLICATION_APPLIER,REPLICATION_SLAVE_ADMIN,RESOURCE_GROUP_ADMIN,RESOURCE_GROUP_USER,ROLE_ADMIN,SERVICE_CONNECTION_ADMIN,SESSION_VARIABLES_ADMIN,SET_USER_ID,SHOW_ROUTINE,SYSTEM_USER,SYSTEM_VARIABLES_ADMIN,TABLE_ENCRYPTION_ADMIN,XA_RECOVER_ADMIN,APPLICATION_PASSWORD_ADMIN,AUDIT_ADMIN,BACKUP_ADMIN,AUTHENTICATION_POLICY_ADMIN,BINLOG_ADMIN,BINLOG_ENCRYPTION_ADMIN,CLONE_ADMIN,CONNECTION_ADMIN,ENCRYPTION_KEY_ADMIN,FLUSH_OPTIMIZER_COSTS,FLUSH_STATUS,FLUSH_TABLES,FLUSH_USER_RESOURCES,GROUP_REPLICATION_ADMIN,GROUP_REPLICATION_STREAM,INNODB_REDO_LOG_ENABLE,PASSWORDLESS_USER_ADMIN,PERSIST_RO_VARIABLES_ADMIN,REPLICATION_APPLIER,REPLICATION_SLAVE_ADMIN,RESOURCE_GROUP_ADMIN,RESOURCE_GROUP_USER,ROLE_ADMIN,SERVICE_CONNECTION_ADMIN,SESSION_VARIABLES_ADMIN,SET_USER_ID,SHOW_ROUTINE,SYSTEM_USER,SYSTEM_VARIABLES_ADMIN,TABLE_ENCRYPTION_ADMIN,XA_RECOVER_ADMIN";
SELECT @@global.rds_restricted_dynamic_privileges_list;
 
###################################################################################
# Test if accessing session rds_restricted_dynamic_privileges_list gives error #
###################################################################################
 
--Error ER_GLOBAL_VARIABLE
SET @@session.rds_restricted_dynamic_privileges_list = "session_variables_admin";
SELECT @@rds_restricted_dynamic_privileges_list;
 
##############################################################################
# Check if the value in GLOBAL & SESSION Tables matches values in variable   #
##############################################################################
 
--disable_warnings
SELECT @@global.rds_restricted_dynamic_privileges_list = VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME='rds_restricted_dynamic_privileges_list';
 
SELECT @@rds_restricted_dynamic_privileges_list = VARIABLE_VALUE
FROM performance_schema.session_variables
WHERE VARIABLE_NAME='rds_restricted_dynamic_privileges_list';
--enable_warnings
 
########################################################################################################
#    Check if accessing variable with SESSION,LOCAL and without SCOPE points to same session variable  #
########################################################################################################
 
SET @@global.rds_restricted_dynamic_privileges_list = "system_variables_admin";
SELECT @@rds_restricted_dynamic_privileges_list = @@global.rds_restricted_dynamic_privileges_list;
 
###############################################################################################
# Check if rds_restricted_dynamic_privileges_list can be accessed with and without @@ sign #
###############################################################################################
 
--Error ER_GLOBAL_VARIABLE
SET rds_restricted_dynamic_privileges_list = "session_variables_admin";
SELECT @@rds_restricted_dynamic_privileges_list;
--Error ER_PARSE_ERROR
SET local.rds_restricted_dynamic_privileges_list = "session_variables_admin";
--Error ER_UNKNOWN_TABLE
SELECT local.rds_restricted_dynamic_privileges_list;
--Error ER_PARSE_ERROR
SET global.rds_restricted_dynamic_privileges_list = "session_variables_admin";
--Error ER_UNKNOWN_TABLE
SELECT global.rds_restricted_dynamic_privileges_list;
--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT rds_restricted_dynamic_privileges_list = @@session.rds_restricted_dynamic_privileges_list;
 
##############################
#   Restore initial value    #
##############################
 
SET @@global.rds_restricted_dynamic_privileges_list = @start_rds_restricted_dynamic_privileges_list;
 
SELECT @@global.rds_restricted_dynamic_privileges_list;
 
 
#######################################################################
#              END OF rds_restricted_dynamic_privileges_list TESTS                           #
#######################################################################
 