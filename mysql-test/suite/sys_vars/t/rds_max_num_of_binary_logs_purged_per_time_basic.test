###############################################################################
#                                                                             #
# The basic test of rds_max_num_of_binary_logs_purged_per_time                #
#                                                                             #
###############################################################################

--echo # Default values
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@SESSION.rds_max_num_of_binary_logs_purged_per_time;

SET @saved_value = @@global.rds_max_num_of_binary_logs_purged_per_time;

--echo # Valid values
SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = 1;
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;
SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = 10;
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;
SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = 100;
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;
SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = 1000;
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;
SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = 10000;
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;
SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = 2147483647;
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;

--echo # Invalid values: there shall be warnings about truncation
SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = -1;
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;
SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = 0;
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;
SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = 2147483648;
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;
SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = 2147483657;
SELECT @@GLOBAL.rds_max_num_of_binary_logs_purged_per_time;

SET GLOBAL rds_max_num_of_binary_logs_purged_per_time = @saved_value;

