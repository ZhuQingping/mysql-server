################### rds_ddl_lock_wait_timeout_basic.test #######################
#                                                                              #
# Variable Name: rds_ddl_lock_wait_timeout                                     #
# Scope: GLOBAL & SESSION                                                      #
# Access Type: Dynamic                                                         #
# Data Type: Numeric                                                           #
# Default Value: 31536000                                                      #
# Range: 1 - 31536000                                                          #
#                                                                              #
#                                                                              #
# Description: Test Cases of Dynamic System Variable                           #
#              "rds_ddl_lock_wait_timeout"                                     #
#              that checks behavior of this variable in the following ways     #
#              * Default Value                                                 #
#              * Valid & Invalid values                                        #
#              * Scope & Access method                                         #
#              * Data Integrity                                                #
#                                                                              #
################################################################################

--source include/load_sysvars.inc

#####################################################################
#           START OF rds_ddl_lock_wait_timeout TESTS                #
#####################################################################

#############################################################
#                 Save initial value                        #
#############################################################

SET @start_global_value = @@global.rds_ddl_lock_wait_timeout;
SELECT @start_global_value;
SET @start_session_value = @@session.rds_ddl_lock_wait_timeout;
SELECT @start_session_value;


#####################################################################
#     Display the DEFAULT value of rds_ddl_lock_wait_timeout        #
#####################################################################

SET @@global.rds_ddl_lock_wait_timeout = 100;
SET @@global.rds_ddl_lock_wait_timeout = DEFAULT;
SELECT @@global.rds_ddl_lock_wait_timeout;

SET @@session.rds_ddl_lock_wait_timeout = 200;
SET @@session.rds_ddl_lock_wait_timeout = DEFAULT;
SELECT @@session.rds_ddl_lock_wait_timeout;


#####################################################################
#     Check the DEFAULT value of rds_ddl_lock_wait_timeout          #
#####################################################################

SET @@global.rds_ddl_lock_wait_timeout = @start_global_value;
SELECT @@global.rds_ddl_lock_wait_timeout = 31536000;
SET @@session.rds_ddl_lock_wait_timeout = @start_session_value;
SELECT @@session.rds_ddl_lock_wait_timeout = 31536000;


###################################################################################
# Change the value of rds_ddl_lock_wait_timeout to a valid value for GLOBAL Scope #
###################################################################################

SET @@global.rds_ddl_lock_wait_timeout = 1;
SELECT @@global.rds_ddl_lock_wait_timeout;
SET @@global.rds_ddl_lock_wait_timeout = 60020;
SELECT @@global.rds_ddl_lock_wait_timeout;
SET @@global.rds_ddl_lock_wait_timeout = 65535;
SELECT @@global.rds_ddl_lock_wait_timeout;
SET @@global.rds_ddl_lock_wait_timeout = 31536000;
SELECT @@global.rds_ddl_lock_wait_timeout;

####################################################################################
# Change the value of rds_ddl_lock_wait_timeout to a valid value for SESSION Scope #
####################################################################################

SET @@session.rds_ddl_lock_wait_timeout = 1;
SELECT @@session.rds_ddl_lock_wait_timeout;
SET @@session.rds_ddl_lock_wait_timeout = 50050;
SELECT @@session.rds_ddl_lock_wait_timeout;
SET @@session.rds_ddl_lock_wait_timeout = 65535;
SELECT @@session.rds_ddl_lock_wait_timeout;
SET @@session.rds_ddl_lock_wait_timeout = 31536000;
SELECT @@session.rds_ddl_lock_wait_timeout;


#####################################################################
# Change the value of rds_ddl_lock_wait_timeout to an invalid value #
#####################################################################
# for global scope
SET @@global.rds_ddl_lock_wait_timeout = 0;
SELECT @@global.rds_ddl_lock_wait_timeout;
SET @@global.rds_ddl_lock_wait_timeout = -1024;
SELECT @@global.rds_ddl_lock_wait_timeout;
SET @@global.rds_ddl_lock_wait_timeout = 31536001;
SELECT @@global.rds_ddl_lock_wait_timeout;
SET @@global.rds_ddl_lock_wait_timeout = 3153600112;
SELECT @@global.rds_ddl_lock_wait_timeout;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_ddl_lock_wait_timeout = 65532.01;
SELECT @@global.rds_ddl_lock_wait_timeout;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_ddl_lock_wait_timeout = ON;
SELECT @@global.rds_ddl_lock_wait_timeout;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_ddl_lock_wait_timeout = OFF;
SELECT @@global.rds_ddl_lock_wait_timeout;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_ddl_lock_wait_timeout = test;
SELECT @@global.rds_ddl_lock_wait_timeout;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_ddl_lock_wait_timeout = " ";
SELECT @@global.rds_ddl_lock_wait_timeout;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.rds_ddl_lock_wait_timeout = ' ';
SELECT @@global.rds_ddl_lock_wait_timeout;

# for session scope
SET @@session.rds_ddl_lock_wait_timeout = 0;
SELECT @@session.rds_ddl_lock_wait_timeout;
SET @@session.rds_ddl_lock_wait_timeout = -2;
SELECT @@session.rds_ddl_lock_wait_timeout;
SET @@session.rds_ddl_lock_wait_timeout = 3176990909;
SELECT @@session.rds_ddl_lock_wait_timeout;
SET @@session.rds_ddl_lock_wait_timeout = 31536001;
SELECT @@session.rds_ddl_lock_wait_timeout;
SET @@session.rds_ddl_lock_wait_timeout = -1024;
SELECT @@session.rds_ddl_lock_wait_timeout;

--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.rds_ddl_lock_wait_timeout = 65532.01;
SELECT @@session.rds_ddl_lock_wait_timeout;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.rds_ddl_lock_wait_timeout = ON;
SELECT @@session.rds_ddl_lock_wait_timeout;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.rds_ddl_lock_wait_timeout = OFF;
SELECT @@session.rds_ddl_lock_wait_timeout;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.rds_ddl_lock_wait_timeout = test;
SELECT @@session.rds_ddl_lock_wait_timeout;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.rds_ddl_lock_wait_timeout = ' ';
SELECT @@session.rds_ddl_lock_wait_timeout;



####################################################################
#   Check if the value in GLOBAL Table matches value in variable   #
####################################################################

--disable_warnings
SELECT @@global.rds_ddl_lock_wait_timeout = VARIABLE_VALUE 
FROM performance_schema.global_variables 
WHERE VARIABLE_NAME='rds_ddl_lock_wait_timeout';
--enable_warnings


####################################################################
#  Check if the value in SESSION Table matches value in variable   #
####################################################################

--disable_warnings
SELECT @@session.rds_ddl_lock_wait_timeout = VARIABLE_VALUE 
FROM performance_schema.session_variables 
WHERE VARIABLE_NAME='rds_ddl_lock_wait_timeout';
--enable_warnings


####################################################################
#     Check if TRUE and FALSE values can be used on variable       #
####################################################################

SET @@global.rds_ddl_lock_wait_timeout = TRUE;
SELECT @@global.rds_ddl_lock_wait_timeout;
SET @@global.rds_ddl_lock_wait_timeout = FALSE;
SELECT @@global.rds_ddl_lock_wait_timeout;


###############################################################################
#  Check if global and session variables are independant of each other        #
###############################################################################

SET @@global.rds_ddl_lock_wait_timeout = 10;
SET @@session.rds_ddl_lock_wait_timeout = 11;
SELECT @@rds_ddl_lock_wait_timeout = @@global.rds_ddl_lock_wait_timeout;


##############################################################################
#    Check if accessing variable with SESSION,LOCAL and without SCOPE points #
#    to same session variable                                                #
##############################################################################

SET @@rds_ddl_lock_wait_timeout = 100;
SELECT @@rds_ddl_lock_wait_timeout = @@local.rds_ddl_lock_wait_timeout;
SELECT @@local.rds_ddl_lock_wait_timeout = @@session.rds_ddl_lock_wait_timeout;


#################################################################################
#   Check if rds_ddl_lock_wait_timeout can be accessed with and without @@ sign #
#################################################################################

SET rds_ddl_lock_wait_timeout = 1;
SELECT @@rds_ddl_lock_wait_timeout;
--Error ER_UNKNOWN_TABLE
SELECT local.rds_ddl_lock_wait_timeout;
--Error ER_UNKNOWN_TABLE
SELECT session.rds_ddl_lock_wait_timeout;
--Error ER_BAD_FIELD_ERROR
SELECT rds_ddl_lock_wait_timeout = @@session.rds_ddl_lock_wait_timeout;


####################################
#     Restore initial value        #
####################################

SET @@global.rds_ddl_lock_wait_timeout = @start_global_value;
SELECT @@global.rds_ddl_lock_wait_timeout;
SET @@session.rds_ddl_lock_wait_timeout = @start_session_value;
SELECT @@session.rds_ddl_lock_wait_timeout;


###################################################
#     END OF rds_ddl_lock_wait_timeout TESTS      #
###################################################

