#
# Test for heap damage lob page
#

--source include/have_debug.inc

call mtr.add_suppression("TupleWithLob is nullptr in rnd_next function, error is 10004");
call mtr.add_suppression("swat hit damage page when fetch blob filed in seq scan");
call mtr.add_suppression("Got error 10004 when reading table");
call mtr.add_suppression("swat hit damage page when fetch blob filed, need to continue to seq scan");
call mtr.add_suppression("Attempting backtrace");

--let $MYSQL_BASEDIR = `SELECT @@basedir`
--let $MYSQLD_DATADIR = `SELECT @@datadir`

create database damage_heap_page_lob;
use damage_heap_page_lob;
create table t1(s blob) engine=Dstore;

insert into t1 values (repeat('a', 30000));

--let $SCHEMA_OF_DSTORE_TABLE = damage_heap_page_lob
--let $NAME_OF_DSTORE_TABLE = t1
--source suite/dstore_swat/include/get_table_lob_segment_id.inc
# segment id in var: $TABLE_LOB_SEG_FILE_ID $TABLE_LOB_SEG_BLOCK_ID

--let $shutdown_server_timeout= 300
--source include/shutdown_mysqld.inc

# make damage page
--disable_query_log
--disable_result_log
--exec $MYSQL_BASEDIR/bin/damagepage -f $TABLE_LOB_SEG_FILE_ID -b $TABLE_LOB_SEG_BLOCK_ID -p $MYSQLD_DATADIR/#mysql_dstore/gs_pdb/PDB_17 -t 1
--enable_result_log
--enable_query_log

--source include/start_mysqld.inc

# should panic when hit damage page
--source include/expect_crash.inc
--error 2013
select count(*) from t1;

# restart using damage page manager
--let $restart_parameters= restart: --dstore_enable_damage_page_manager=on --dstore_report_error_on_damage_page=on
--source include/start_mysqld.inc

--error 8022
select count(*) from t1;
--error 8022
update t1 set s='abc' limit 1;
--error 8022
delete from t1 limit 1;
insert into t1 values('xyz');
--error 8022
select count(*) from t1;

--let $shutdown_server_timeout= 300
--source include/shutdown_mysqld.inc

# restart ignore damage page
--let $restart_parameters= restart: --dstore_enable_damage_page_manager=on
--source include/start_mysqld.inc

select count(*) from t1;
update t1 set s='abc' limit 1;
delete from t1 limit 1;
insert into t1 values('xyz');
select count(*) from t1;

# to reinit damage pages
drop table t1;
create table t1(s blob) engine=Dstore;
insert into t1 values (repeat('a', 30000));
insert into t1 select * from t1;
insert into t1 select * from t1;
insert into t1 select * from t1;
select count(*) from t1;

drop database damage_heap_page_lob;

--let $shutdown_server_timeout= 300
--source include/shutdown_mysqld.inc

--exec rm $MYSQLD_DATADIR/#mysql_dstore/gs_pdb/PDB_17/damage_page_mgr.meta

--let $restart_parameters= restart
--source include/start_mysqld.inc
