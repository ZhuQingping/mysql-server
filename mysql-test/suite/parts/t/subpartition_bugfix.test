use test;
set global rds_extended_partitions_enabled = off;

--error ER_PARTITION_SUBPARTITION_ERROR
create table t1 (
  i_id     integer not null,
  i_name   varchar(24),
  i_price  decimal(5,2),
  i_data   varchar(50),
  i_im_id  integer
)
PARTITION BY HASH (i_id) SUBPARTITION BY RANGE (i_price) SUBPARTITIONS 3;

--error ER_PARTITION_SUBPARTITION_ERROR
create table t1 (
  i_id     integer not null,
  i_name   varchar(24),
  i_price  decimal(5,2),
  i_data   varchar(50),
  i_im_id  integer
)
PARTITION BY HASH (i_id) SUBPARTITION BY LIST (i_price) SUBPARTITIONS 3;

set global rds_extended_partitions_enabled = on;

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1 (
  i_id     integer not null,
  i_name   varchar(24),
  i_price  decimal(5,2),
  i_data   varchar(50),
  i_im_id  integer
)
PARTITION BY HASH (i_id) SUBPARTITION BY RANGE (i_price) SUBPARTITIONS 3;

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1 (
  i_id     integer not null,
  i_name   varchar(24),
  i_price  decimal(5,2),
  i_data   varchar(50),
  i_im_id  integer
)
PARTITION BY HASH (i_id) SUBPARTITION BY LIST (i_price) SUBPARTITIONS 3;

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1 (
  i_id     integer not null,
  i_name   varchar(24),
  i_price  decimal(5,2),
  i_data   varchar(50),
  i_im_id  integer
)
PARTITION BY HASH (i_id) SUBPARTITION BY LIST (i_price) SUBPARTITIONS 3 (
  partition p0,
  partition p1
);

set debug = "+d, no_partitions_for_range";
--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1 (
  i_id     integer not null,
  i_name   varchar(24),
  i_price  decimal(5,2),
  i_data   varchar(50),
  i_im_id  integer
) partition by range (i_id) (
  partition p1 values less than (10),
  partition p2 values less than (20)
);

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1 (
  i_id     integer not null,
  i_name   varchar(24),
  i_price  decimal(5,2),
  i_data   varchar(50),
  i_im_id  integer
) partition by list (i_id) (
  partition p1 values in (1,2,3,4,5),
  partition p2 values in (6,7,8,9)
);

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t3 (
  id int not null,
  store_id int not null
) partition by hash (store_id) subpartition by range(id)
(
  partition p0 (
    subpartition q1 values less than (4),
    subpartition q2 values less than (10)
      ),
  partition p1 (
    subpartition q3 values less than (15),
    subpartition q4 values less than (20)
  )
);

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash (dept_no)
subpartition by list (part_no)
(
  partition p0 (
    subpartition p0partno0 values in (1, 2),
    subpartition p0partno1 values in (3, 4)
  ),
  partition p1 (
    subpartition p1partno0 values in (1, 2),
    subpartition p1partno2 values in (3, 4)
  )
);

set debug = "";

#reset
SET global rds_extended_partitions_enabled = default;
