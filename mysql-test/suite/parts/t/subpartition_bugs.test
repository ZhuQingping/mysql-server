    SUBPARTITION sub3 VALUES in (('aaa2', 2147483647, 'bbba2'),('aacd', 101, 'bbbbbbbbcd'),('aaaa', -2147483648, 'bbbbbbbbbaa'),('aabb', 121, 'bbbbbbbbbb'),('aabb', 15, 'bbbbbbbbbb'),('aabb', 22, 'bbbbbbbbbb'),('aabb', 39, 'bbbbbbbbbb'),('aabb', 43, 'bbbbbbbbbb'),('aabb', 58, 'bbbbbbbbbb'),('aabb', 65, 'bbbbbbbbbb'),('aabb', 76, 'bbbbbbbbbb'),('aabb', 80, 'bbbbbbbbbb'),('aabb', 99, 'bbbbbbbbbb'),('aabb', 100, 'bbbbbbbbbb'))
