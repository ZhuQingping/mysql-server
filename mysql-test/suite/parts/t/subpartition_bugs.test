--source include/not_have_only_dstore.inc

SET @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
SET global rds_extended_partitions_enabled = true;

--echo #
--echo # BUG2023112803703: Multiple MAXVALUEs are not allowed
--echo #
CREATE TABLE t0 (
  a int,
  b int
)
PARTITION BY RANGE (a)
SUBPARTITION BY RANGE (b)
(PARTITION p0 VALUES LESS THAN (10)
 (SUBPARTITION q1 VALUES LESS THAN (5),
  SUBPARTITION q2 VALUES LESS THAN (MAXVALUE)),
 PARTITION p3 VALUES LESS THAN (20)
 (SUBPARTITION q7 VALUES LESS THAN (10),
  SUBPARTITION q8 VALUES LESS THAN (MAXVALUE)));
INSERT INTO t0 VALUES(1,2),(3,5),(15, 20);
SELECT * FROM t0 ORDER BY 1;
DROP TABLE t0;
--error ER_PARTITION_MAXVALUE_ERROR
CREATE TABLE t1 (
  a int DEFAULT NULL,
  b int  DEFAULT NULL
)
PARTITION BY RANGE (a)
(PARTITION p1 VALUES LESS THAN(10),
PARTITION p2 VALUES LESS THAN(MAXVALUE),
PARTITION p3 VALUES LESS THAN (20));
--error ER_PARTITION_MAXVALUE_ERROR
CREATE TABLE t1 (
  a int DEFAULT NULL,
  b int  DEFAULT NULL
)
PARTITION BY RANGE (a)
(PARTITION p1 VALUES LESS THAN(10),
PARTITION p2 VALUES LESS THAN(MAXVALUE),
PARTITION p3 VALUES LESS THAN (MAXVALUE));
--error ER_PARTITION_MAXVALUE_ERROR
CREATE TABLE t0 (
  a int DEFAULT NULL,
  b int  DEFAULT NULL
)
PARTITION BY RANGE (a)
SUBPARTITION BY RANGE (b)
(PARTITION p0 VALUES LESS THAN (10)
 (SUBPARTITION q1 VALUES LESS THAN (MAXVALUE),
  SUBPARTITION q2 VALUES LESS THAN (30)),
 PARTITION p3 VALUES LESS THAN (20)
 (SUBPARTITION q7 VALUES LESS THAN (10),
  SUBPARTITION q8 VALUES LESS THAN (MAXVALUE)));
--error ER_PARTITION_MAXVALUE_ERROR
CREATE TABLE t0 (
  a int DEFAULT NULL,
  b int  DEFAULT NULL
)
PARTITION BY RANGE (a)
SUBPARTITION BY RANGE (b)
(PARTITION p0 VALUES LESS THAN (10)
 (SUBPARTITION q1 VALUES LESS THAN (MAXVALUE),
  SUBPARTITION q2 VALUES LESS THAN (MAXVALUE)),
 PARTITION p3 VALUES LESS THAN (20)
 (SUBPARTITION q7 VALUES LESS THAN (10),
  SUBPARTITION q8 VALUES LESS THAN (MAXVALUE)));

CREATE TABLE t1(id int, a int, b int) PARTITION BY range(a)
SUBPARTITION BY RANGE(b) (
  PARTITION p1 VALUES LESS THAN(9) (SUBPARTITION p1_sp1 VALUES LESS THAN(9), SUBPARTITION p1_sp2 VALUES LESS THAN(MAXVALUE)),
  PARTITION p2 VALUES LESS THAN(19) (SUBPARTITION p2_sp1 VALUES LESS THAN(10),SUBPARTITION p2_sp2 VALUES LESS THAN(20)));
--error ER_NO_PARTITION_FOR_GIVEN_VALUE
INSERT INTO t1 VALUES(1,11,21);
INSERT INTO t1 VALUES(1,8,21);
DROP TABLE t1;

--echo #
--echo # BUG2023120800329: Prune partitions on list columns-range columns is incorrect
--echo #
CREATE TABLE t1 (
  int_col int,
  date_col date,
  varchar_col varchar(255),
  char_col char(4)
)PARTITION BY LIST COLUMNS(varchar_col,int_col)
SUBPARTITION BY RANGE COLUMNS(char_col,date_col)
(
  PARTITION p0 VALUES in ((NULL,NULL))(
    SUBPARTITION sub1 VALUES LESS THAN('aabb',MAXVALUE),
    SUBPARTITION sub2 VALUES LESS THAN('aacd',MAXVALUE),
    SUBPARTITION sub3 VALUES LESS THAN('ab',MAXVALUE)
  ),
  PARTITION p1 VALUES in (('ab',84))(
    SUBPARTITION sub4 VALUES LESS THAN('aabb',MAXVALUE),
    SUBPARTITION sub5 VALUES LESS THAN('aacd',MAXVALUE),
    SUBPARTITION sub6 VALUES LESS THAN('ab',MAXVALUE)
  ),
  PARTITION p2 VALUES in (('bbbbbbbbbb', 121))(
    SUBPARTITION sub7 VALUES LESS THAN('aabb',MAXVALUE),
    SUBPARTITION sub8 VALUES LESS THAN('aacd',MAXVALUE),
    SUBPARTITION sub9 VALUES LESS THAN('ab',MAXVALUE)
  ),
  PARTITION p3 VALUES in (('bbba2', 2147483647))(
    SUBPARTITION sub10 VALUES LESS THAN('aabb',MAXVALUE),
    SUBPARTITION sub11 VALUES LESS THAN('aacd',MAXVALUE),
    SUBPARTITION sub12 VALUES LESS THAN('ab',MAXVALUE)
  )
);

INSERT INTO t1 VALUES(121,'1998-01-03','bbbbbbbbbb','aabb');
--replace_column 11 #
EXPLAIN SELECT * FROM t1 WHERE char_col IN ('aabb','aacd') AND date_col IN ('1998-01-03');
SELECT * FROM t1 WHERE char_col IN ('aabb','aacd') AND date_col IN ('1998-01-03');
CREATE TABLE t2 AS SELECT * FROM t1;
SELECT * FROM t2 WHERE char_col IN ('aabb','aacd') AND date_col IN ('1998-01-03');
DROP TABLE t1, t2;

