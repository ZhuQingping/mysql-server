--echo #
--echo # BUG2024082007281: alter table .. algorithm=inplace with list columns - range columns subpartition table failed.
--echo #
CREATE TABLE t1 (
  int_col int DEFAULT NULL,
  date_col date DEFAULT NULL,
  char_col char(4) NOT NULL,
  varchar_col varchar(255) DEFAULT NULL,
  tinytext_col tinytext,
  longblob_col longblob,
  json_col json DEFAULT NULL
) PARTITION BY LIST COLUMNS(varchar_col,int_col)
SUBPARTITION BY RANGE COLUMNS(char_col,date_col)
(
  PARTITION p0 VALUES in ((NULL,NULL))(
    SUBPARTITION sub1 VALUES LESS THAN('aabb',MAXVALUE)
  )
);
ALTER TABLE t1 DROP tinytext_col,algorithm=inplace;
DROP TABLE t1;

CREATE TABLE t1 (
  int_col int DEFAULT NULL,
  date_col date DEFAULT NULL,
  char_col char(4) NOT NULL,
  varchar_col varchar(255) DEFAULT NULL,
  tinytext_col tinytext,
  longblob_col longblob,
  json_col json DEFAULT NULL
) PARTITION BY LIST COLUMNS(varchar_col,int_col)
SUBPARTITION BY KEY(char_col,date_col)
(
  PARTITION p0 VALUES in ((NULL,NULL))
);
ALTER TABLE t1 DROP tinytext_col,algorithm=inplace;
DROP TABLE t1;

CREATE TABLE t1 (
  int_col int DEFAULT NULL,
  date_col date DEFAULT NULL,
  char_col char(4) NOT NULL,
  varchar_col varchar(255) DEFAULT NULL,
  tinytext_col tinytext,
  longblob_col longblob,
  json_col json DEFAULT NULL
) PARTITION BY KEY(char_col,date_col);
ALTER TABLE t1 DROP tinytext_col,algorithm=inplace;
DROP TABLE t1;

--echo #
--echo #BUG2025072128186
--echo #For a partitioned table with a secondary partition type of RANGE COLUMNS,
--echo #when the WHERE clause of a query includes the use of the IN predicate on the
--echo #subpartition key and the IN predicate contains more than one value,
--echo #partition pruning is incorrect.
--echo #
CREATE TABLE `biz_operation_log` (
  `id` varchar(50)  NOT NULL,
  `addr_id` varchar(50)  DEFAULT NULL ,
  `addr_code` varchar(50)  DEFAULT NULL,
  `company_id` varchar(50)  NOT NULL ,
  `tent_id` varchar(11)  NOT NULL ,
  `crt_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`,`crt_time`,`tent_id`,`company_id`),
  KEY `addr_id` (`addr_id`) USING BTREE,
  KEY `addr_code` (`addr_code`) USING BTREE,
  KEY `idx_tentid_crttime_companyid` (`tent_id`,`crt_time`,`company_id`) USING BTREE
) PARTITION BY RANGE  COLUMNS(crt_time)
SUBPARTITION BY RANGE  COLUMNS(tent_id,company_id)
(PARTITION p2024 VALUES LESS THAN ('2024-01-01')
 (SUBPARTITION p_2024_p248_100001001002001 VALUES LESS THAN ('248','100001001002002'),
  SUBPARTITION p_2024_p248_100001001002005 VALUES LESS THAN ('248','100001001002006'),
  SUBPARTITION p_2024_p248_100001001003001 VALUES LESS THAN ('248','100001001003002'),
  SUBPARTITION p_2024_p248_100001001003002 VALUES LESS THAN ('248','100001001003003'),
  SUBPARTITION p_2024_p248_100001001003003 VALUES LESS THAN ('248','100001001003004'),
  SUBPARTITION p_2024_p248_100001001004001 VALUES LESS THAN ('248','100001001004002'),
  SUBPARTITION p_2024_p249_100002001001 VALUES LESS THAN ('249','100002001002'),
  SUBPARTITION p_2024_p_max VALUES LESS THAN (MAXVALUE,MAXVALUE)),
 PARTITION p2025 VALUES LESS THAN ('2025-01-01')
 (SUBPARTITION p_2025_p248_100001001002001 VALUES LESS THAN ('248','100001001002002'),
  SUBPARTITION p_2025_p248_100001001002005 VALUES LESS THAN ('248','100001001002006'),
  SUBPARTITION p_2025_p248_100001001003001 VALUES LESS THAN ('248','100001001003002'),
  SUBPARTITION p_2025_p248_100001001003002 VALUES LESS THAN ('248','100001001003003'),
  SUBPARTITION p_2025_p248_100001001003003 VALUES LESS THAN ('248','100001001003004'),
  SUBPARTITION p_2025_p248_100001001004001 VALUES LESS THAN ('248','100001001004002'),
  SUBPARTITION p_2025_p249_100002001001 VALUES LESS THAN ('249','100002001002'),
  SUBPARTITION p_2025_p_max VALUES LESS THAN (MAXVALUE,MAXVALUE)),
 PARTITION p2026 VALUES LESS THAN ('2026-01-01')
 (SUBPARTITION p_2026_p248_100001001002001 VALUES LESS THAN ('248','100001001002002'),
  SUBPARTITION p_2026_p248_100001001002005 VALUES LESS THAN ('248','100001001002006'),
  SUBPARTITION p_2026_p248_100001001003001 VALUES LESS THAN ('248','100001001003002'),
  SUBPARTITION p_2026_p248_100001001003002 VALUES LESS THAN ('248','100001001003003'),
  SUBPARTITION p_2026_p248_100001001003003 VALUES LESS THAN ('248','100001001003004'),
  SUBPARTITION p_2026_p248_100001001004001 VALUES LESS THAN ('248','100001001004002'),
  SUBPARTITION p_2026_p249_100002001001 VALUES LESS THAN ('249','100002001002'),
  SUBPARTITION p_2026_p_max VALUES LESS THAN (MAXVALUE,MAXVALUE)),
 PARTITION pmax VALUES LESS THAN (MAXVALUE)
 (SUBPARTITION p_max_p248_100001001002001 VALUES LESS THAN ('248','100001001002002'),
  SUBPARTITION p_max_p248_100001001002005 VALUES LESS THAN ('248','100001001002006'),
  SUBPARTITION p_max_p248_100001001003001 VALUES LESS THAN ('248','100001001003002'),
  SUBPARTITION p_max_p248_100001001003002 VALUES LESS THAN ('248','100001001003003'),
  SUBPARTITION p_max_p248_100001001003003 VALUES LESS THAN ('248','100001001003004'),
  SUBPARTITION p_max_p248_100001001004001 VALUES LESS THAN ('248','100001001004002'),
  SUBPARTITION p_max_p249_100002001001 VALUES LESS THAN ('249','100002001002'),
  SUBPARTITION p_max_p_max VALUES LESS THAN (MAXVALUE,MAXVALUE)));

--replace_column 11 #
EXPLAIN
  SELECT count(0)FROM  biz_operation_log log
    WHERE log.crt_time >= '2024-04-09 09:16:06' AND
          log.crt_time <= '2024-07-08 09:16:06' AND
          log.company_id in ('100001001003001', '100001001003002', '100001001003003') AND
          log.tent_id = '248';

--replace_column 11 #
EXPLAIN
  SELECT count(0)FROM  biz_operation_log log
    WHERE log.company_id in ('100001001003001', '100001001003002', '100001001003003') AND
          log.tent_id = '248';

# Values in IN (xx, xx, xx) is not an orderly.
--replace_column 11 #
EXPLAIN
  SELECT count(0)FROM  biz_operation_log log
    WHERE log.company_id in ('100001001003002', '100001001003001', '100001001003003') AND
          log.tent_id = '248';

--replace_column 11 #
EXPLAIN
  SELECT count(0)FROM  biz_operation_log log
    WHERE log.company_id in ('100001001003003', '100001001003002', '100001001003001') AND
          log.tent_id = '248';

--replace_column 11 #
EXPLAIN
  SELECT count(0)FROM  biz_operation_log log
    WHERE log.company_id in ('100001001003002', '100001001003001') AND
          log.tent_id = '248';

DROP TABLE biz_operation_log;

#reset
SET global rds_extended_partitions_enabled = @saved_rds_extended_partitions_enabled;
