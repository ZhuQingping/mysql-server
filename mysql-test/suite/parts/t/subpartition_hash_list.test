--source include/not_have_only_dstore.inc

--echo # Test: HASH - LIST

SET @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
SET global rds_extended_partitions_enabled = true;

create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash(to_days(date))
subpartition by list(amount)
(
  partition dp0 (
    subpartition p0 values in (1, 2),
    subpartition p1 values in (3, 4),
    subpartition p2 values in (5, 6)
  ),
  partition dp1
  (
    subpartition p3 values in (1, 2),
    subpartition p4 values in (3, 4),
    subpartition p5 values in (5, 6)
  )
);
show create table t1;
insert into t1(date, amount) values('2021-01-01',1),
  ('2021-01-02',2),('2021-01-03',3),('2021-01-04',4),
  ('2021-01-05',5),('2021-01-06',6),('2021-09-01',1),
  ('2021-09-03',2),('2021-09-05',3),('2021-09-07',4),
  ('2021-09-21',5),('2021-09-23',6);

select * from t1 where date in ('2021-01-02', '2021-01-04', '2021-09-23');
--replace_column 10 # 11 #
explain select * from t1 where date in ('2021-01-02', '2021-01-04', '2021-09-23');
select * from t1 where date in ('2021-01-02', '2021-01-04', '2021-09-23') and amount = 4;
--replace_column 10 # 11 #
explain select * from t1 where date in ('2021-01-02', '2021-01-04', '2021-09-23') and amount = 4;
drop table t1;

# Test : partition name must be unique within the table.
--error ER_PARSE_ERROR
create table t1 (a int, b int)
partition by hash (a) partitions 2
subpartition by list (b)
(
  partition p0 (
    subpartition partno0 values in (1, 2),
    subpartition partno0 values in (3, 4)
  ),
  partition p1 (
    subpartition partno0 values in (1, 2),
    subpartition partno0 values in (3, 4)
  ),
);

--error ER_SAME_NAME_PARTITION
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash (dept_no)
subpartition by list (part_no)
(
  partition p0 (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  ),
  partition p1 (
    subpartition partno0 values in (1, 2),
    subpartition partno2 values in (3, 4)
  )
);

--error ER_SAME_NAME_PARTITION
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash (dept_no)
subpartition by list (part_no)
(
  partition p0 (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  ),
  partition p1 (
    subpartition p0 values in (1, 2),
    subpartition partno2 values in (3, 4)
  )
);

# Test : number of subpartitions must be same for every part_defination
--error ER_PARSE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash (dept_no)
subpartition by list (part_no)
(
  partition p0 (
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  ),
  partition p1 (
    subpartition partno2 values in (1, 2)
  )
);

--error ER_PARSE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash (dept_no)
subpartition by list (part_no)
(
  partition p0 (
    subpartition partno0 values in (1, 2)
  ),
  partition p1 (
    subpartition partno2 values in (1, 2),
    subpartition partno1 values in (3, 4)
  )
);

# Test : must be defining subpartition defination for list type
--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash (dept_no)
subpartition by list (part_no)
(
  partition p0
);

--error ER_PARSE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash (dept_no)
subpartition by list (part_no)
(
  partition p0 (
    subpartition p0sp0 values in (1)
  ),
  partition p1
);

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash (dept_no)
subpartition by list (part_no)
(
  partition p0 ,
  partition p1 (
    subpartition p0sp0 values in (1)
  )
);

# Test: list type's value defination is values in

--error ER_PARTITION_WRONG_VALUES_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash (dept_no)
subpartition by list (part_no)
(
  partition p0 (
    subpartition p0sp0 values less than(3)
  )
);

# Test: expr/value must be INT type

--error ER_VALUES_IS_NOT_INT_TYPE_ERROR
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by hash (dept_no)
subpartition by list (country)
(
  partition p0 (
    subpartition p0sp0 values in ('XiAN')
  )
);

--error ER_VALUES_IS_NOT_INT_TYPE_ERROR
