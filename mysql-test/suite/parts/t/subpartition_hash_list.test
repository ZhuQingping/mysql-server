  )
);

# Data loss.
# After the partition definition is changed, data is redistributed and
# data that does not meet the requirements of level-2 partitions is lost.
select * from t1;
drop table t1;

create table t1(a int, b int) partition by hash(a) subpartition by list(b) (
partition p1 (
  subpartition p1sp0 values in (1,2,3),
  subpartition p1sp1 values in (4,5,6)),
partition p2 (
  subpartition p2sp0 values in (7,8,9,null),
  subpartition p2sp1 values in (20,21,22)),
partition p3 (
    subpartition p3sp0 values in (11,32),
    subpartition p3sp1 values in (0,null,12,45,78,89))
);
insert into t1 values(3,4),(4,null),(5,11),(6,1),(7,7),(8,11),(6,2),(3,6),(1,20),(5,32);
insert into t1 values(null,0),(5,null);
select * from t1 where b is null;
--replace_column 10 # 11 #
explain select * from t1 where b is null;
insert into t1 values(17,11),(14,null),(11,45),(20,32),(17,null);
select b from t1 where b is null;
--replace_column 10 # 11 #
explain select b from t1 where b is null;
select * from t1 where a is null and b is null;
--replace_column 10 # 11 #
explain select * from t1 where a is null and b is null;
select * from t1 where a < 20 and b is null;
--replace_column 10 # 11 #
explain select * from t1 where a < 20 and b is null;
select * from t1 where b > 7 and b < 28;
--replace_column 10 # 11 #
explain select * from t1 where b > 7 and b < 28;
select * from t1 where b > 7 and b < 28 and a is null;
--replace_column 10 # 11 #
explain select * from t1 where b > 7 and b < 28 and a is null;
select * from t1 where b > 7 and b < 28 and a > 5;
--replace_column 10 # 11 #
explain select * from t1 where b > 7 and b < 28 and a > 5;
drop table t1;

# DML
create table t1(a int, b int) partition by hash(a) subpartition by list(b) (
partition p1 (
  subpartition p1sp0 values in (1,2,3),
  subpartition p1sp1 values in (4,5,6)),
partition p2 (
  subpartition p2sp0 values in (7,8,9,null),
  subpartition p2sp1 values in (20,21,22)),
partition p3 (
    subpartition p3sp0 values in (11,32),
    subpartition p3sp1 values in (0,null,12,45,78,89))
);
insert into t1 values(3,4),(4,null),(5,11),(6,1),(7,7),(8,11),(6,2),(3,6),(1,20),(5,32);
insert into t1 values(null,0),(5,null);
insert into t1 values(17,11),(14,null),(11,45),(20,32),(17,null);

select * from t1 partition(p1sp0);
select * from t1 partition(p1sp1);
update t1 set b = 5 where a = 6 and b = 1;
select * from t1 partition(p1sp0);
select * from t1 partition(p1sp1);

delete from t1 where a = 6 and b = 5;
select * from t1 partition(p1sp1);
drop table t1;

#reset
SET global rds_extended_partitions_enabled = @saved_rds_extended_partitions_enabled;

