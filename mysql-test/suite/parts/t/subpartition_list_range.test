--source include/not_have_only_dstore.inc

SET @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
SET global rds_extended_partitions_enabled = true;
--echo #
--echo # Verify list-range
--echo #
CREATE TABLE t1
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(dept_no)
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (1,2,3) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  ),
  PARTITION p_2021 VALUES IN (4,5,6,7,8)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4),
    SUBPARTITION q2_2021 VALUES LESS THAN(7)
  )
);
DROP TABLE t1;

CREATE TABLE t3 (
    id INT NOT NULL,
    store_id INT NOT NULL
)
PARTITION BY LIST (id)
SUBPARTITION BY RANGE(store_id) (
  PARTITION p0 VALUES IN (1, 6, 8) (
    SUBPARTITION q1 VALUES LESS THAN (4),
    SUBPARTITION q2 VALUES LESS THAN (10)),
  PARTITION p1 VALUES IN (11, 14) (
    SUBPARTITION q3 VALUES LESS THAN (15),
    SUBPARTITION q4 VALUES LESS THAN (20))
);
INSERT INTO t3 VALUES(1,6);
INSERT INTO t3 VALUES(11, 10),(14, 11);
INSERT INTO t3 VALUES(8,6);
SELECT * FROM t3;
SELECT * FROM t3 WHERE store_id = 6;
--replace_column 11 #
EXPLAIN SELECT * FROM t3 WHERE store_id = 6;
SELECT * FROM t3 WHERE store_id = 6 and id = 1;
--replace_column 11 #
EXPLAIN SELECT * FROM t3 WHERE store_id = 6 and id = 1;
SELECT * FROM t3 WHERE store_id = 11 and id = 14;
--replace_column 11 #
EXPLAIN SELECT * FROM t3 WHERE store_id = 11 and id = 14;
SELECT * FROM t3 WHERE store_id = 10 and id > 10;
--replace_column 11 #
EXPLAIN SELECT * FROM t3 WHERE store_id = 10 and id > 10;
ALTER TABLE t3 ADD PARTITION (PARTITION p3 VALUES IN (20)(SUBPARTITION q5 VALUES LESS THAN(15), SUBPARTITION q6 VALUES LESS THAN(19)));
SHOW CREATE TABLE t3;
ALTER TABLE t3 DROP PARTITION p0;
SELECT * FROM t3;
DROP TABLE t3;

CREATE TABLE t1
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2020,1996) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7),
    SUBPARTITION q3_2020 VALUES LESS THAN(10),
    SUBPARTITION q4_2020 VALUES LESS THAN(13)
  ),
  PARTITION p_2021 VALUES IN (2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4),
    SUBPARTITION q2_2021 VALUES LESS THAN(7),
    SUBPARTITION q3_2021 VALUES LESS THAN(10),
    SUBPARTITION q4_2021 VALUES LESS THAN(13)
  ),
  PARTITION p_2022 VALUES IN (2023,2024)
  (
    SUBPARTITION q1_2022 VALUES LESS THAN(4),
    SUBPARTITION q2_2022 VALUES LESS THAN(7),
    SUBPARTITION q3_2022 VALUES LESS THAN(10),
    SUBPARTITION q4_2022 VALUES LESS THAN(13)
  )
);
ALTER TABLE t1 ADD PARTITION (
    PARTITION p_2025 VALUES IN (2025)
    (
    SUBPARTITION q1_2015 VALUES LESS THAN(4),
    SUBPARTITION q2_2015 VALUES LESS THAN(7),
    SUBPARTITION q3_2015 VALUES LESS THAN(10),
    SUBPARTITION q4_2015 VALUES LESS THAN(13)
  )
);
SHOW CREATE TABLE t1;
ALTER TABLE t1 DROP PARTITION p_2025;
SHOW CREATE TABLE t1;
ALTER TABLE t1 REORGANIZE PARTITION p_2021 INTO (
    PARTITION p_2021_1 VALUES IN (2021)(
    SUBPARTITION q1_2021_1 VALUES LESS THAN(4),
    SUBPARTITION q2_2021_1 VALUES LESS THAN(7),
    SUBPARTITION q3_2021_1 VALUES LESS THAN(10),
    SUBPARTITION q4_2021_1 VALUES LESS THAN(13)
  ),
    PARTITION p_2021_2 VALUES IN (2022)(
    SUBPARTITION q1_2021_2 VALUES LESS THAN(4),
    SUBPARTITION q2_2021_2 VALUES LESS THAN(7),
    SUBPARTITION q3_2021_2 VALUES LESS THAN(10),
    SUBPARTITION q4_2021_2 VALUES LESS THAN(13)
  )
);
SHOW CREATE TABLE t1;
INSERT INTO t1(date) VALUES('2020-04-05'),('2020-08-06'),('2021-05-06');
SELECT * FROM t1;
ALTER TABLE t1 ANALYZE PARTITION q2_2021_1, q1_2022;
ALTER TABLE t1 CHECK PARTITION q2_2021_1, q1_2022;
ALTER TABLE t1 OPTIMIZE PARTITION q2_2021_1, q1_2022;
--echo "REBUILD only adapts to partition but not SUBPARTITION"
ALTER TABLE t1 REBUILD PARTITION p_2021_1;
ALTER TABLE t1 REPAIR PARTITION q2_2021_1, q1_2022;
ALTER TABLE t1 TRUNCATE PARTITION q2_2021_1;
SELECT * FROM t1;
ALTER TABLE t1 TRUNCATE PARTITION p_2021_1;
SELECT * FROM t1;
ALTER TABLE t1 REMOVE PARTITIONING;
SHOW CREATE TABLE t1;
SELECT * FROM t1;
DROP TABLE t1;

# partition name must be unique within the table.
--error ER_SAME_NAME_PARTITION
CREATE TABLE t1
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  ),
  PARTITION p_2021 VALUES IN (2022)
  (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2021 VALUES LESS THAN(7)
  )
);

# number of partitions must be same.
--error ER_PARSE_ERROR
CREATE TABLE t1
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  ),
  PARTITION p_2021 VALUES IN (2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4)
  )
);

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
CREATE TABLE t1
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2021)
);
CREATE TABLE t1
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  ),
  PARTITION p_2021 VALUES IN (2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4),
    SUBPARTITION q2_2021 VALUES LESS THAN(7)
  )
);
INSERT INTO t1(date) VALUES('2021-5-23'),('2022-2-23');
ALTER TABLE t1 ANALYZE PARTITION p_2020, p_2021;
SELECT partition_name, SUBPARTITION_name, table_rows from information_schema.partitions where table_name = 't1';
DROP TABLE t1;

# partition_definition can be different
CREATE TABLE t1
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  ),
  PARTITION p_2021 VALUES IN (2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(8),
    SUBPARTITION q2_2021 VALUES LESS THAN(13)
  )
);
DROP TABLE t1;

--error ER_FIELD_NOT_FOUND_PART_ERROR
CREATE TABLE sales_range_columns_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST COLUMNS(dept_no, part_no)
SUBPARTITION BY RANGE COLUMNS(am)
(
  PARTITION p1 VALUES IN((1000, 1000))(
    SUBPARTITION q1_2019 VALUES LESS THAN(4),
    SUBPARTITION q2_2019 VALUES LESS THAN(7)
  ),
  PARTITION p2 VALUES IN((2000, 2000))(
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  )
);

# range columns
CREATE TABLE sales_range_columns_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST COLUMNS(dept_no, part_no)
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p1 VALUES IN((1000,1000))(
    SUBPARTITION q1_2019 VALUES LESS THAN(4),
    SUBPARTITION q2_2019 VALUES LESS THAN(7)
  ),
  PARTITION p2 VALUES IN((2000,2000))(
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  )
);
DROP TABLE sales_range_columns_range;

# DML
CREATE TABLE t1
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2012,2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  ),
  PARTITION p_2021 VALUES IN (2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(8),
    SUBPARTITION q2_2021 VALUES LESS THAN(13)
  )
);

# insert
INSERT INTO t1 PARTITION (p_2020) VALUES (1, 1, 'china', '2012-01-12', 1);
--error ER_NO_PARTITION_FOR_GIVEN_VALUE
INSERT INTO t1 PARTITION (q2_2020) VALUES (1, 1, 'china', '2012-08-12', 1);
--error ER_NO_PARTITION_FOR_GIVEN_VALUE
INSERT INTO t1 PARTITION (p_2020,q2_2020) VALUES (1, 1, 'china', '2012-08-12', 1);

# update
SELECT * from t1;
UPDATE t1 partition(q1_2020) SET dept_no = dept_no + 1;
SELECT * from t1;

# delete
DELETE FROM t1 partition(q1_2020);
SELECT * from t1;

DROP TABLE t1;

# DDL
# add partition
CREATE TABLE t1
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  ),
  PARTITION p_2021 VALUES IN (2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(8),
    SUBPARTITION q2_2021 VALUES LESS THAN(13)
  )
);

--error ER_ADD_PARTITION_SUBPART_ERROR
ALTER TABLE t1 ADD PARTITION (
    PARTITION p_2022 VALUES IN(2023) (
        SUBPARTITION q1_2022 VALUES LESS THAN(4),
        SUBPARTITION q2_2022 VALUES LESS THAN(7),
        SUBPARTITION q2_2022 VALUES LESS THAN(10),
        SUBPARTITION q2_2022 VALUES LESS THAN(13)
    )
);

--error ER_SAME_NAME_PARTITION
ALTER TABLE t1 ADD PARTITION (
    partition p_2022 VALUES IN(2023) (
        SUBPARTITION q2_2022 VALUES LESS THAN(10),
        SUBPARTITION q2_2022 VALUES LESS THAN(13)
    )
);

--error ER_RANGE_NOT_INCREASING_ERROR
ALTER TABLE t1 add partition (
    partition p_2022 VALUES IN(2023) (
        SUBPARTITION q1_2022 VALUES LESS THAN(15),
        SUBPARTITION q2_2022 VALUES LESS THAN(13)
    )
);

ALTER TABLE t1 add partition (
    partition p_max VALUES IN(2024) (
        SUBPARTITION q1_max VALUES LESS THAN(4),
        SUBPARTITION q2_max VALUES LESS THAN(7)
    )
);
DROP table t1;

# add partition .. without validation
CREATE TABLE t1 (
`a` int ,
`b` int ,
Primary Key(a, b));

INSERT INTO t1 values(1,1),(2,1),(3,1),(4,1),(111,111),(3333,333);

ALTER TABLE t1 partition by list(a) SUBPARTITION by range(b) (
    partition p0 VALUES IN(1,2,3) (
        SUBPARTITION p0sp0 VALUES LESS THAN(6),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    ),
    partition p1 VALUES IN(4) (
        SUBPARTITION p1sp0 VALUES LESS THAN(6),
        SUBPARTITION p1sp1 VALUES LESS THAN(1000)
    ),
    partition p2 VALUES IN(111,3333) (
        SUBPARTITION p2sp0 VALUES LESS THAN(6),
        SUBPARTITION p2sp1 VALUES LESS THAN(1000)
    )
);
DROP TABLE t1;

# partition by
CREATE TABLE t1 (
`a` int ,
`b` int ,
Primary Key(a, b));
INSERT INTO t1 values(1,1),(2,1),(3,1),(4,1),(111,111),(3333,333);

ALTER TABLE t1 partition by list(a) SUBPARTITION by range(b) (
    partition p0 VALUES IN(1,2,3) (
        SUBPARTITION p0sp0 VALUES LESS THAN(6),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    ),
    partition p1 VALUES IN(4,111) (
        SUBPARTITION p1sp0 VALUES LESS THAN(6),
        SUBPARTITION p1sp1 VALUES LESS THAN(1000)
    ),
    partition p2 VALUES IN(3333) (
        SUBPARTITION p2sp0 VALUES LESS THAN(6),
        SUBPARTITION p2sp1 VALUES LESS THAN(1000)
    )
);
ALTER TABLE t1 ANALYZE PARTITION p0,p1,p2;
select partition_name, SUBPARTITION_name, TABLE_rows from information_schema.partitions where table_name = 't1';

--error ER_NO_PARTITION_FOR_GIVEN_VALUE
ALTER TABLE t1 partition by list(a) SUBPARTITION by range(b) (
    partition p0 VALUES IN(1,2,3) (
        SUBPARTITION p0sp0 VALUES LESS THAN(6),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    ),
    partition p1 VALUES IN(4,111,3333) (
        SUBPARTITION p1sp0 VALUES LESS THAN(6),
        SUBPARTITION p1sp1 VALUES LESS THAN(100)
    )
);

# DROP partition

--error ER_DROP_PARTITION_NON_EXISTENT
ALTER TABLE t1 DROP partition p0sp0;

ALTER TABLE t1 DROP partition p2;
SHOW CREATE TABLE t1;
SELECT * FROM t1;
ALTER TABLE t1 ANALYZE PARTITION p0,p1;
SELECT partition_name, SUBPARTITION_name, table_rows FROM information_schema.partitions where table_name = 't1';

# truncate partition
SELECT * FROM t1 partition(p1sp1);
ALTER TABLE t1 truncate partition p1sp1;
SHOW CREATE TABLE t1;
SELECT * FROM t1 partition(p1sp1);

SELECT * FROM t1 partition(p1);
ALTER TABLE t1 truncate partition p1;
SHOW CREATE TABLE t1;
SELECT * FROM t1 partition(p1);

DROP TABLE t1;

# reorganize partition
CREATE TABLE t1 (
`a` int ,
`b` int ,
Primary Key(a, b));
INSERT INTO t1 values(1,1),(2,1),(3,1),(4,1),(111,111),(3333,333);

ALTER TABLE t1 partition by list(a) SUBPARTITION by range(b) (
    partition p0 VALUES IN(1,2,111) (
        SUBPARTITION p0sp0 VALUES LESS THAN(6),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    ),
    partition p1 VALUES IN(3,3333) (
        SUBPARTITION p1sp0 VALUES LESS THAN(6),
        SUBPARTITION p1sp1 VALUES LESS THAN(1000)
    ),
    partition p2 VALUES IN(4) (
        SUBPARTITION p2sp0 VALUES LESS THAN(6),
        SUBPARTITION p2sp1 VALUES LESS THAN(1000)
    )
);

# reorganize SUBPARTITION
ALTER TABLE t1 reorganize partition p2 INTO
(
    partition p2 VALUES IN(4) (
        SUBPARTITION p2sp0 VALUES LESS THAN(100),
        SUBPARTITION p2sp1 VALUES LESS THAN(1000)
    )
);

SHOW CREATE TABLE t1;
# merge
ALTER TABLE t1 reorganize partition p0,p1 into
(
    partition p0 VALUES IN(1,2,111,3,3333) (
        SUBPARTITION p0sp0 VALUES LESS THAN(100),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    )
);

SHOW CREATE TABLE t1;
# splite
ALTER TABLE t1 reorganize partition p0 into
(
    partition p0 VALUES IN(1,111) (
        SUBPARTITION p0sp0 VALUES LESS THAN(100),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    ),
    partition p1 VALUES IN(2,3,3333) (
        SUBPARTITION p1sp0 VALUES LESS THAN(100),
        SUBPARTITION p1sp1 VALUES LESS THAN(1000)
    )
);

SHOW CREATE TABLE t1;
DROP TABLE t1;

# exchange partition

CREATE TABLE tsp (
`a` int ,
`b` int ,
Primary Key(a, b));
INSERT INTO tsp values(1,1),(2,1),(3,1),(4,1),(111,111),(3333,333);
ALTER TABLE tsp partition by list(a) SUBPARTITION by range(b) (
    partition p0 VALUES IN(1,2,111) (
        SUBPARTITION p0sp0 VALUES LESS THAN(6),
        SUBPARTITION p0sp1 VALUES LESS THAN(1000)
    ),
    partition p1 VALUES IN(3,3333) (
        SUBPARTITION p1sp0 VALUES LESS THAN(6),
        SUBPARTITION p1sp1 VALUES LESS THAN(1000)
    ),
    partition p2 VALUES IN(4) (
        SUBPARTITION p2sp0 VALUES LESS THAN(6),
        SUBPARTITION p2sp1 VALUES LESS THAN(1000)
    )
);

create TABLE t like tsp;
ALTER TABLE t remove partitioning;

SELECT * FROM tsp partition(p2sp1);
ALTER TABLE tsp EXCHANGE PARTITION p2sp1 WITH TABLE t;
SHOW CREATE TABLE t;
SHOW CREATE TABLE tsp;

SELECT * FROM tsp partition(p2sp1);
SELECT * FROM t;

DELETE FROM t;
INSERT INTO t values(1023,2000);
--error ER_NO_PARTITION_FOR_GIVEN_VALUE
ALTER TABLE tsp EXCHANGE PARTITION p2sp1 WITH TABLE t;

ALTER TABLE tsp EXCHANGE PARTITION p2sp1 WITH TABLE t without VALIDATION;
SELECT * FROM tsp PARTITION(p2sp1);
SELECT * FROM t;

DROP TABLE t,tsp;

# analyze partition

CREATE TABLE range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2019,2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7),
    SUBPARTITION q3_2020 VALUES LESS THAN(10),
    SUBPARTITION q4_2020 VALUES LESS THAN(13)
  ),
  PARTITION p_2021 VALUES IN (2020,2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4),
    SUBPARTITION q2_2021 VALUES LESS THAN(7),
    SUBPARTITION q3_2021 VALUES LESS THAN(10),
    SUBPARTITION q4_2021 VALUES LESS THAN(13)
  )
);
INSERT INTO range_range(date) VALUES('2020-04-12'),('2019-06-12'),('2019-08-12'),('2019-10-12'),('2021-06-12'),('2021-08-12'),('2021-10-12');
SELECT * FROM range_range;
SHOW CREATE TABLE range_range;
ALTER TABLE range_range ANALYZE PARTITION p_2020,q3_2021;
SELECT * FROM range_range partition(p_2021);
SHOW CREATE TABLE range_range;
DROP TABLE range_range;

