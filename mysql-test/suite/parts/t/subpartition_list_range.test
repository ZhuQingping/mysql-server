# rebuild partition
CREATE TABLE range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7),
    SUBPARTITION q3_2020 VALUES LESS THAN(10),
    SUBPARTITION q4_2020 VALUES LESS THAN(13)
  ),
  PARTITION p_2021 VALUES IN (2019,2020,2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4),
    SUBPARTITION q2_2021 VALUES LESS THAN(7),
    SUBPARTITION q3_2021 VALUES LESS THAN(10),
    SUBPARTITION q4_2021 VALUES LESS THAN(13)
  )
);
INSERT INTO range_range(date) VALUES('2020-04-12'),('2019-06-12'),('2019-08-12'),('2019-10-12'),('2021-06-12'),('2021-08-12'),('2021-10-12');
SELECT * FROM range_range;
SHOW CREATE TABLE range_range;
SELECT * FROM range_range partition(p_2020);
SELECT * FROM range_range partition(q1_2020);
SELECT * FROM range_range partition(q2_2020);
SELECT * FROM range_range partition(q3_2020);
SELECT * FROM range_range partition(q4_2020);
--error ER_DROP_PARTITION_NON_EXISTENT
ALTER TABLE range_range REBUILD PARTITION p_2020,q3_2021;
ALTER TABLE range_range REBUILD PARTITION p_2020;
SELECT * FROM range_range partition(p_2020);
SELECT * FROM range_range partition(q1_2020);
SELECT * FROM range_range partition(q2_2020);
SELECT * FROM range_range partition(q3_2020);
SELECT * FROM range_range partition(q4_2020);
SHOW CREATE TABLE range_range;
DROP TABLE range_range;

# repair partition
CREATE TABLE range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7),
    SUBPARTITION q3_2020 VALUES LESS THAN(10),
    SUBPARTITION q4_2020 VALUES LESS THAN(13)
  ),
  PARTITION p_2021 VALUES IN (2019,2020,2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4),
    SUBPARTITION q2_2021 VALUES LESS THAN(7),
    SUBPARTITION q3_2021 VALUES LESS THAN(10),
    SUBPARTITION q4_2021 VALUES LESS THAN(13)
  )
);
INSERT INTO range_range(date) VALUES('2020-04-12'),('2019-06-12'),('2019-08-12'),('2019-10-12'),('2021-06-12'),('2021-08-12'),('2021-10-12');
SELECT * FROM range_range;
SHOW CREATE TABLE range_range;
ALTER TABLE range_range REPAIR PARTITION p_2020,q3_2021;
SELECT * FROM range_range partition(p_2021);
SHOW CREATE TABLE range_range;
DROP TABLE range_range;

# remove partitioning
CREATE TABLE range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7),
    SUBPARTITION q3_2020 VALUES LESS THAN(10),
    SUBPARTITION q4_2020 VALUES LESS THAN(13)
  ),
  PARTITION p_2021 VALUES IN (2019,2020,2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4),
    SUBPARTITION q2_2021 VALUES LESS THAN(7),
    SUBPARTITION q3_2021 VALUES LESS THAN(10),
    SUBPARTITION q4_2021 VALUES LESS THAN(13)
  )
);
INSERT INTO range_range(date) VALUES('2020-04-12'),('2019-06-12'),('2019-08-12'),('2019-10-12'),('2021-06-12'),('2021-08-12'),('2021-10-12');
SHOW CREATE TABLE range_range;
ALTER TABLE range_range remove partitioning;
SHOW CREATE TABLE range_range;
SELECT * FROM range_range;
DROP TABLE range_range;

# coalesce partition
CREATE TABLE range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY LIST(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES IN (2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7),
    SUBPARTITION q3_2020 VALUES LESS THAN(10),
    SUBPARTITION q4_2020 VALUES LESS THAN(13)
  ),
  PARTITION p_2021 VALUES IN (2019,2020,2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(4),
    SUBPARTITION q2_2021 VALUES LESS THAN(7),
    SUBPARTITION q3_2021 VALUES LESS THAN(10),
    SUBPARTITION q4_2021 VALUES LESS THAN(13)
  )
);
--error ER_COALESCE_ONLY_ON_HASH_PARTITION
ALTER TABLE range_range COALESCE PARTITION 1;
DROP TABLE range_range;
#Verify alter table error
CREATE TABLE t1(a int, b int) PARTITION BY range(a) (
partition p1 values less than (3),
partition p2 values less than (4)
);
--error ER_PARTITION_MGMT_ON_NONPARTITIONED
ALTER TABLE t1 ADD PARTITION (PARTITION p3 VALUES LESS THAN (5) (SUBPARTITION p3p0));
--error ER_PARTITION_MGMT_ON_NONPARTITIONED
ALTER TABLE t1 ADD PARTITION (PARTITION p3 VALUES LESS THAN (5) (SUBPARTITION p3p0 VALUES LESS THAN(4)));

CREATE TABLE t2(a int, b int);
--error ER_PARTITION_MGMT_ON_NONPARTITIONED
ALTER TABLE t2 ADD PARTITION (PARTITION p0 VALUES LESS THAN (5));
DROP TABLE t1, t2;

--error ER_PARTITIONS_MUST_BE_DEFINED_ERROR
CREATE TABLE t1(a int, b int) PARTITION BY list(a) SUBPARTITION BY range(b) (
partition p1 values in (3),
partition p2 values in (4)
);
CREATE TABLE t1(a int, b int) PARTITION BY range(a)(
partition p1 values less than (3),
partition p2 values less than (4)
);
--error ER_PARTITION_MGMT_ON_NONPARTITIONED
ALTER TABLE t1 ADD PARTITION (PARTITION p3 VALUES LESS THAN (5) (SUBPARTITION p3p0));
--error ER_PARTITION_REQUIRES_VALUES_ERROR
ALTER TABLE t1 ADD PARTITION (PARTITION p3);
DROP TABLE t1;
CREATE TABLE t1(a int, b int) PARTITION BY range(a) SUBPARTITION BY hash(b) (
partition p1 values less than (3),
partition p2 values less than (4)
);
ALTER TABLE t1 ADD PARTITION (PARTITION p3 VALUES LESS THAN (5));
DROP TABLE t1;
CREATE TABLE t3 (
    id INT NOT NULL,
    store_id INT NOT NULL
)
PARTITION BY LIST (store_id)
SUBPARTITION BY RANGE(id) (
    PARTITION p0 VALUES IN (6) (
    subpartition q1 values less than (4),
    subpartition q2 values less than (10)
  ),
    PARTITION p1 VALUES IN (11) (
    subpartition q3 values less than (15),
    subpartition q4 values less than (20)
  )
);

--error ER_RANGE_NOT_INCREASING_ERROR
ALTER TABLE t3 ADD PARTITION (PARTITION p3 VALUES IN (20)(subpartition q5 values less than(19), subpartition q6 values less than(19)));
DROP TABLE t3;

# Verify index
CREATE TABLE t1(a int, b int) PARTITION BY list(a) SUBPARTITION BY range(b) (
partition p1 values in (1,2,3)  (subpartition p1sp0 values less than(3),
                                 subpartition p1sp1 values less than (5)),
partition p2 values in (10,11,12) (subpartition p2sp0 values less than(4),
                                   subpartition p2sp1 values less than (9))
);
INSERT INTO t1 VALUES(1,2),(2,4),(3,3),(10,8);
INSERT INTO t1 VALUES(11,2),(12,4),(12,3),(10,8);
--replace_column 11 #
EXPLAIN SELECT * FROM t1 WHERE a < 1;
ALTER TABLE t1 ADD index idx(a);
SELECT * FROM t1 WHERE a < 1;
--replace_column 11 #
EXPLAIN SELECT * FROM t1 WHERE a = 2;
SELECT * FROM t1 WHERE a = 2;
ALTER TABLE t1 ADD index idx1(a, b);
--replace_column 11 #
EXPLAIN SELECT * FROM t1 WHERE a = 2 and b = 4;
SELECT * FROM t1 WHERE a = 2 and b = 4;
--replace_column 11 #
EXPLAIN SELECT * FROM t1 WHERE b = 4;
SELECT * FROM t1 WHERE b = 4;
ALTER TABLE t1 DROP INDEX idx;
ALTER TABLE t1 DROP INDEX idx1;
ALTER TABLE t1 ADD index idx2(b);
SELECT * FROM t1 WHERE a = 2;
SELECT * FROM t1 WHERE b = 4;
DROP TABLE t1;
SET global rds_extended_partitions_enabled = @saved_rds_extended_partitions_enabled;

