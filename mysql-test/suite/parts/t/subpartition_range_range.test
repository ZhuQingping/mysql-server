--error ER_FIELD_NOT_FOUND_PART_ERROR
CREATE TABLE sales_range_columns_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE COLUMNS(dept_no, part_no)
SUBPARTITION BY RANGE COLUMNS(am)
(
  PARTITION p1 VALUES LESS THAN(1000, MAXVALUE)(
    SUBPARTITION q1_2019 VALUES LESS THAN(4),
    SUBPARTITION q2_2019 VALUES LESS THAN(7)
  ),
  PARTITION p2 VALUES LESS THAN(2000, MAXVALUE)(
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  )
);

# range columns
CREATE TABLE sales_range_columns_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE COLUMNS(dept_no, part_no)
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p1 VALUES LESS THAN(1000, MAXVALUE)(
    SUBPARTITION q1_2019 VALUES LESS THAN(4),
    SUBPARTITION q2_2019 VALUES LESS THAN(7)
  ),
  PARTITION p2 VALUES LESS THAN(2000, MAXVALUE)(
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  )
);
DROP TABLE sales_range_columns_range;

# DML
CREATE TABLE sales_range_range
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
PARTITION BY RANGE(year(date))
SUBPARTITION BY RANGE(month(date))
(
  PARTITION p_2020 VALUES LESS THAN (2021) (
    SUBPARTITION q1_2020 VALUES LESS THAN(4),
    SUBPARTITION q2_2020 VALUES LESS THAN(7)
  ),
  PARTITION p_2021 VALUES LESS THAN (2022)
  (
    SUBPARTITION q1_2021 VALUES LESS THAN(8),
    SUBPARTITION q2_2021 VALUES LESS THAN(13)
  )
);

# insert
INSERT INTO sales_range_range PARTITION (p_2020) VALUES (1, 1, 'china', '2012-01-12', 1);
--error ER_NO_PARTITION_FOR_GIVEN_VALUE
INSERT INTO sales_range_range PARTITION (q2_2020) VALUES (1, 1, 'china', '2012-08-12', 1);
--error ER_NO_PARTITION_FOR_GIVEN_VALUE
INSERT INTO sales_range_range PARTITION (p_2020,q2_2020) VALUES (1, 1, 'china', '2012-08-12', 1);

INSERT INTO sales_range_range VALUES (2, 2, 'china', '2012-01-12', 1);
INSERT INTO sales_range_range VALUES (3, 3, 'china', '2020-03-15', 1);
INSERT INTO sales_range_range VALUES (3, 3, 'china', '2021-05-12', 1);
# update
SELECT * from sales_range_range ORDER BY 1, 4;
UPDATE sales_range_range partition(q1_2020) SET dept_no = dept_no + 1;
SELECT * from sales_range_range ORDER BY 1, 4;
--error ER_NO_PARTITION_FOR_GIVEN_VALUE
UPDATE sales_range_range SET date = date_add(date, interval 1 year);
--error ER_NO_PARTITION_FOR_GIVEN_VALUE
UPDATE sales_range_range SET date = date_add(date, interval 10 month);
SELECT * from sales_range_range ORDER BY 1, 4;
ALTER TABLE sales_range_range ANALYZE PARTITION p_2020, p_2021;
SELECT partition_name, SUBPARTITION_name, table_rows from information_schema.partitions where table_name = 'sales_range_range';
UPDATE sales_range_range SET date = date_add(date, interval 3 month);
SELECT * from sales_range_range ORDER BY 1, 4;
ALTER TABLE sales_range_range ANALYZE PARTITION p_2020, p_2021;
SELECT partition_name, SUBPARTITION_name, table_rows from information_schema.partitions where table_name = 'sales_range_range';

# delete
DELETE FROM sales_range_range partition(q1_2020);
SELECT * from sales_range_range ORDER BY 1, 4;
DELETE FROM sales_range_range WHERE date = '2012-04-12';
SELECT * from sales_range_range ORDER BY 1, 4;

DROP TABLE sales_range_range;

