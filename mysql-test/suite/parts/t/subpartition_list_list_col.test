# Test: add partition
create table t1 (a int,b int,c int,d int,e int)
partition by list (a) subpartition by list columns(c,d,e)
(
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);

--error ER_ADD_PARTITION_SUBPART_ERROR
alter table t1 add partition (
  partition p2 values in (5, 6) (
    subpartition p2_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4))
  )
);

--error ER_PARTITION_WRONG_VALUES_ERROR
alter table t1 add partition (
  partition p2 values in (5, 6) (
    subpartition p2sp0 values less than (5),
    subpartition p2sp0 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);

show create table t1;
alter table t1 add partition (
  partition p2 values in (5,6)(
    subpartition p2_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);

show create table t1;
insert into t1 values(1,2,1,1,1),(1,2,2,1,1),(1,2,2,5,3),(1,2,2,7,5),(1,2,2,1,2),(1,2,2,1,1);
insert into t1 values(5,6,1,1,1),(5,6,2,1,1),(5,6,2,5,3),(5,6,2,7,4),(5,6,2,1,2),(5,6,2,1,1);
select * from t1 partition(p2_1) order by a,b,c,d,e;
drop table t1;

# Test: converting a Non-partitioned Table to a Partitioned Table

create table t1 (a int,b int,c int,d int,e int);
insert into t1 values(1,2,1,1,1),(1,2,2,1,1),(1,2,2,5,3),(1,2,2,7,5),(1,2,2,1,2),(1,2,2,1,1);
insert into t1 values(3,4,1,1,1),(3,4,2,1,1),(3,4,2,5,3),(3,4,2,7,4),(3,4,2,1,2),(3,4,2,1,1);

alter table t1 partition by list (a) subpartition by list columns(c,d,e) (
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);
show create table t1;
select * from t1 partition(p0_0) order by a,b,c,d,e;
select * from t1 partition(p0) order by a,b,c,d,e;
select * from t1 partition(p1) order by a,b,c,d,e;

--error ER_NO_PARTITION_FOR_GIVEN_VALUE
alter table t1 partition by list (a) subpartition by list columns(c,d,e) (
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,2,2),(2,7,4))
  )
);

# Test: drop partition

--error ER_DROP_PARTITION_NON_EXISTENT
alter table t1 drop partition p0_0;
alter table t1 drop partition p0;
show create table t1;
select * from t1 order by a,b,c,d,e;
analyze table t1;
select partition_name, subpartition_name, table_rows from
  information_schema.partitions where table_name = 't1';

--echo # Test for truncate partition
select * from t1 partition(p1_0) order by a,b,c,d,e;
alter table t1 truncate partition p1_0;
show create table t1;
select * from t1 partition(p1_0) order by a,b,c,d,e;
insert into t1 values(3,4,2,1,1),(3,4,1,4,4);
select * from t1 partition(p1) order by a,b,c,d,e;
alter table t1 truncate partition p1;
select * from t1 partition(p1) order by a,b,c,d,e;
drop table t1;

# Test: for reorganize partition

create table t1 (a int,b int,c int,d int,e int)
partition by list(a) subpartition by list columns(c,d,e) 
(
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  ),
  partition p2 values in (5,6)(
    subpartition p2_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);
insert into t1 values(1,2,1,1,1),(1,2,2,1,1),(1,2,2,5,3),(1,2,2,7,5),(1,2,1,1,1),(1,2,1,2,1);
insert into t1 values(3,4,1,1,1),(3,4,2,1,1),(3,4,2,5,3),(3,4,2,7,4),(3,4,1,1,1),(3,4,1,2,1);
insert into t1 values(5,6,1,1,1),(5,6,2,1,1),(5,6,2,5,3),(5,6,2,7,4),(5,6,1,1,1),(5,6,1,2,1);

select * from t1 partition(p1_0) order by a,b,c,d,e;
select * from t1 partition(p1_1) order by a,b,c,d,e;

alter table t1 reorganize partition p1 into (
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,2,1),(1,4,4),(2,1,1),(2,1,2)),
    subpartition p1_1 values in ((2,5,3),(2,7,4),(1,1,1),(1,1,2))
  )
);
show create table t1;
select * from t1 partition(p1_0) order by a,b,c,d,e;
select * from t1 partition(p1_1) order by a,b,c,d,e;

alter table t1 reorganize partition p1,p2 into (
  partition p1 values in (3,4,5,6)(
    subpartition p1_0 values in ((1,2,1),(1,4,4),(2,1,1),(2,1,2)),
    subpartition p1_1 values in ((2,5,3),(2,7,4),(1,1,1),(1,1,2))
  )
);
show create table t1;
select * from t1 partition(p1) order by a,b,c,d,e;
drop table t1;

# Error scenario
create table t1 (a int,b int,c int,d int,e int)
partition by list(a) subpartition by list columns(c,d,e) 
(
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  ),
  partition p2 values in (5,6)(
    subpartition p2_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);
insert into t1 values(1,2,1,1,1),(1,2,2,1,1),(1,2,2,5,3),(1,2,2,7,5),(1,2,1,1,1),(1,2,1,2,1);
insert into t1 values(3,4,1,1,1),(3,4,2,1,1),(3,4,2,5,3),(3,4,2,7,4),(3,4,1,1,1),(3,4,1,2,1);
insert into t1 values(5,6,1,1,1),(5,6,2,1,1),(5,6,2,5,3),(5,6,2,7,4),(5,6,1,1,1),(5,6,1,2,1);
set global rds_loose_partition_restriction = 0;
--error ER_REORG_WRONG_VALUES_RANGE
alter table t1 reorganize partition p2 into (
  partition p2 values in (5,6) (
    subpartition p2_0 values in ((1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,5,3),(2,7,4))
  )
);
set global rds_loose_partition_restriction = 1;
alter table t1 reorganize partition p2 into (
  partition p2 values in (5,6) (
    subpartition p2_0 values in ((1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,5,3),(2,7,4))
  )
);
# leading to data loss
select * from t1 order by a,b,c,d,e;
drop table t1;

# Test: exchange partition

create table t1 (a int,b int,c int,d int,e int)
partition by list(a) subpartition by list columns(c,d,e) 
(
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  ),
  partition p2 values in (5,6)(
    subpartition p2_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);
insert into t1 values(1,2,1,1,1),(1,2,2,1,1),(1,2,2,5,3),(1,2,2,7,5),(1,2,1,1,1),(1,2,1,2,1);
insert into t1 values(3,4,1,1,1),(3,4,2,1,1),(3,4,2,5,3),(3,4,2,7,4),(3,4,1,1,1),(3,4,1,2,1);
insert into t1 values(5,6,1,1,1),(5,6,2,1,1),(5,6,2,5,3),(5,6,2,7,4),(5,6,1,1,1),(5,6,1,2,1);

create table t2 like t1;
alter table t2 remove partitioning;

alter table t1 exchange partition p2_0 with table t2;
select * from t1 partition(p2_0) order by a,b,c,d,e;
select * from t2 order by a,b,c,d,e;

delete from t2;
insert into t2 values(1,2,1,1,1),(1,2,2,1,1),(1,2,2,5,3),(1,2,1,1,1),(1,2,1,2,1);
--error ER_ROW_DOES_NOT_MATCH_PARTITION
alter table t1 exchange partition p2_0 with table t2;

alter table t1 exchange partition p2_0 with table t2 without validation;
select * from t1 partition(p2_0) order by a,b,c,d,e;
select * from t2 order by a,b,c,d,e;

drop table t1, t2;

# Test: analyze partition
create table t1 (a int,b int,c int,d int,e int)
partition by list (a) subpartition by list columns(c,d,e) 
(
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  ),
  partition p2 values in (5,6)(
    subpartition p2_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);
insert into t1 values(1,2,1,1,1),(1,2,2,1,1),(1,2,2,5,3),(1,2,2,7,5),(1,2,1,1,1),(1,2,1,2,1);
insert into t1 values(3,4,1,1,1),(3,4,2,1,1),(3,4,2,5,3),(3,4,2,7,4),(3,4,1,1,1),(3,4,1,2,1);
insert into t1 values(5,6,1,1,1),(5,6,2,1,1),(5,6,2,5,3),(5,6,2,7,4),(5,6,1,1,1),(5,6,1,2,1);

alter table t1 analyze partition p1_0, p2_1;
select * from t1 partition(p2_1) order by a,b,c,d,e;

# Test: check partition
select * from t1 partition(p0_1,p1,p2_1);
alter table t1 check partition p0_1, p1, p2_1;
select * from t1 partition(p0_1,p1,p2_1);

# Test: optimize partition
alter table t1 optimize partition p0_1, p1, p2_1;
select * from t1 partition(p0_1,p1,p2_1);

# Test: rebuild partition, only for partiton_name, not for subpartition_name
select * from t1 partition(p0);
alter table t1 rebuild partition p0;
select * from t1 partition(p0);

--error ER_DROP_PARTITION_NON_EXISTENT
alter table t1 rebuild partition p0_1;

# Test: repair partition
select * from t1 partition(p0_1);
alter table t1 repair partition p0_1;
select * from t1 partition(p0_1);

# Test: remove partitioning
alter table t1 remove partitioning;
show create table t1;
drop table t1;

# Test: DDL for partition table
create table t1 (a int,b int,c int,d int,e int)
partition by list(a) subpartition by list columns(c,d,e) 
(
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  ),
  partition p2 values in (5,6)(
    subpartition p2_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);
insert into t1 values(1,2,1,1,1),(1,2,2,1,1),(1,2,2,5,3),(1,2,2,7,5),(1,2,1,1,1),(1,2,1,2,1);
insert into t1 values(3,4,1,1,1),(3,4,2,1,1),(3,4,2,5,3),(3,4,2,7,4),(3,4,1,1,1),(3,4,1,2,1);
insert into t1 values(5,6,1,1,1),(5,6,2,1,1),(5,6,2,5,3),(5,6,2,7,4),(5,6,1,1,1),(5,6,1,2,1);

alter table t1 add column col1 date;
show create table t1;
create index idx1 on t1(c,d,e);
show indexes from t1;
drop table t1;

# Verify index
create table t1 (a int,b int,c int,d int,e int)
partition by list(a) subpartition by list columns(c,d,e) 
(
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  ),
  partition p2 values in (5,6)(
    subpartition p2_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);
insert into t1 values(1,2,1,1,1),(1,2,2,1,1),(1,2,2,5,3),(1,2,2,7,5),(1,2,1,1,1),(1,2,1,2,1);
insert into t1 values(3,4,1,1,1),(3,4,2,1,1),(3,4,2,5,3),(3,4,2,7,4),(3,4,1,1,1),(3,4,1,2,1);
insert into t1 values(5,6,1,1,1),(5,6,2,1,1),(5,6,2,5,3),(5,6,2,7,4),(5,6,1,1,1),(5,6,1,2,1);
--replace_column 10 # 11 #
explain select * from t1 where a < 5;
alter table t1 add index idx(a);
select * from t1 where a < 5 order by a,b,c,d,e;
--replace_column 10 # 11 #
explain select * from t1 where a < 5;
alter table t1 add index idx1(a, b);
select * from t1 where a = 5 and b = 6 order by a,b,c,d,e;
--replace_column 10 # 11 #
explain select * from t1 where a = 5 and b = 6;
alter table t1 drop index idx;
alter table t1 drop index idx1;
alter table t1 add index idx2(c,d);
--replace_column 10 # 11 #
explain select * from t1 where a >= 1 and b = 2 and c = 2;
select * from t1 where a >= 1 and b = 2 and c = 2 order by a,b,c,d,e;
drop table t1;

# Test partitioning interval analysis
create table t1 (a int,b int,c int,d int,e int)
partition by list(a) subpartition by list columns(c,d,e) 
(
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  ),
  partition p2 values in (5,6)(
    subpartition p2_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);
