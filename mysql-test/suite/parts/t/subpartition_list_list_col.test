# null
create table t1 (a int,b int,c int,d int,e int)
partition by list(a) subpartition by list columns(c,d,e) 
(
  partition p0 values in (1,2)(
    subpartition p0_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p0_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,5))
  ),
  partition p1 values in (3,4,null)(
    subpartition p1_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4),(1,4,null)),
    subpartition p1_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  ),
  partition p2 values in (5,6)(
    subpartition p2_0 values in ((1,1,1),(1,1,2),(1,2,1),(1,4,4)),
    subpartition p2_1 values in ((2,1,1),(2,1,2),(2,5,3),(2,7,4))
  )
);
insert into t1 values(1,2,1,1,1),(1,2,2,1,1),(1,2,2,5,3),(1,2,2,7,5),(1,2,1,1,1),(1,2,1,2,1);
insert into t1 values(3,4,1,1,1),(3,4,2,1,1),(3,4,2,5,3),(3,4,2,7,4),(3,4,1,1,1),(3,4,1,2,1);
insert into t1 values(5,6,1,1,1),(5,6,2,1,1),(5,6,2,5,3),(5,6,2,7,4),(5,6,1,1,1),(5,6,1,2,1);
