select * from t1 where a is null and b is null and c = 1 and d = 4 and e is null order by a,b,c,d,e;
--replace_column 10 # 11 #
explain select * from t1 where a is null and b is null and c = 1 and d = 4 and e is null;
select * from t1 where c = 1 and d = 4 and e is null order by a,b,c,d,e;
--replace_column 10 # 11 #
explain select * from t1 where c = 1 and d = 4 and e is null;
drop table t1;

