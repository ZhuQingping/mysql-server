--source include/not_have_only_dstore.inc

SET @saved_rds_extended_partitions_enabled=@@rds_extended_partitions_enabled;
SET global rds_extended_partitions_enabled = true;
set @loose_partition_restriction=@@rds_loose_partition_restriction;

let $part_opt_columns= ;
let $subpart_opt_columns= columns;
--source suite/parts/inc/subpartition_signal_columns.inc

# Test : value type
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  m_date      date,
  d           double
)
partition by list(dept_no)
subpartition by list columns(country, m_date)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (('A', '2021-01-01'), ('B', '2022-01-02')),
    subpartition partno1 values in (('C', '2021-01-01'), ('D', '2022-01-02'))
  ),
  partition p1 values in (3, 4)(
    subpartition partno3 values in (('A', '2021-01-01'), ('B', '2022-01-02')),
    subpartition partno4 values in (('C', '2021-01-01'), ('D', '2022-01-02'))
  ),
  partition p2 values in (5, 6)(
    subpartition partno6 values in (('A', '2021-01-01'), ('B', '2022-01-02')),
    subpartition partno7 values in (('C', '2021-01-01'), ('D', '2022-01-02'))
  )
);
show create table t1; drop table t1;

--error ER_FIELD_TYPE_NOT_ALLOWED_AS_PARTITION_FIELD
create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  m_date      date,
  d           double
)
partition by list(dept_no)
subpartition by list columns(country, d)
(
  partition p0 values in (1, 2)(
    subpartition partno0 values in (('A', 3.1), ('B', 10.1)),
    subpartition partno1 values in (('C', 3.1), ('D', 10.1))
  ),
  partition p1 values in (3, 4)(
    subpartition partno3 values in (('A', 3.1), ('B', 10.1)),
    subpartition partno4 values in (('C', 3.1), ('D', 10.1))
  ),
  partition p2 values in (5, 6)(
    subpartition partno6 values in (('A', 3.1), ('B', 10.1)),
    subpartition partno7 values in (('C', 3.1), ('D', 10.1))
  )
);

create table t1
(
  dept_no     int,
  part_no     int,
  country     varchar(20),
  date        date,
  amount      int
)
partition by list columns(country)
subpartition by list(part_no)
(
  partition p0 values in ('A', 'B')(
    subpartition partno0 values in (1, 2),
    subpartition partno1 values in (3, 4)
  ),
  partition p1 values in ('C', 'D')(
    subpartition partno3 values in (1, 2),
    subpartition partno4 values in (3, 4)
  ),
  partition p2 values in ('E', 'F')(
    subpartition partno6 values in (1, 2),
    subpartition partno7 values in (3, 4)
  )
);
show create table t1; drop table t1;

# cant not support expr
--error ER_PARSE_ERROR
create table t1
(
  dept_no     INT,
  part_no     INT,
  country     varchar(20),
  date        DATE,
  amount      INT
)
partition by list (dept_no)
subpartition by list columns(dept_no + part_no)
(
  partition p0 values in (1,20,31) (
    subpartition p0_europe values in ('FRANCE', 'ITALY'),
    subpartition p0_asia VALUES in ('INDIA', 'PAKISTAN'),
    subpartition p0_americas VALUES in ('US', 'CANADA')
  ),
  partition p1 values in (3,4,21) (
    subpartition p1_europe values in ('FRANCE', 'ITALY'),
    subpartition p1_asia VALUES in ('INDIA', 'PAKISTAN'),
    subpartition p1_americas VALUES in ('US', 'CANADA')
  )
);

