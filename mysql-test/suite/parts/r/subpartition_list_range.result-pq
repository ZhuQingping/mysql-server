) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY LIST (`id`)
SUBPARTITION BY RANGE (`store_id`)
(PARTITION p0 VALUES IN (1,6,8)
 (SUBPARTITION q1 VALUES LESS THAN (4) ENGINE = InnoDB,
  SUBPARTITION q2 VALUES LESS THAN (10) ENGINE = InnoDB),
 PARTITION p1 VALUES IN (11,14)
 (SUBPARTITION q3 VALUES LESS THAN (15) ENGINE = InnoDB,
  SUBPARTITION q4 VALUES LESS THAN (20) ENGINE = InnoDB),
 PARTITION p3 VALUES IN (20)
 (SUBPARTITION q5 VALUES LESS THAN (15) ENGINE = InnoDB,
  SUBPARTITION q6 VALUES LESS THAN (19) ENGINE = InnoDB)) */
