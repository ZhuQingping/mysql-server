CREATE TABLE sales_range_range
(
dept_no     INT,
part_no     INT,
country     varchar(20),
date        DATE,
amount      INT
)
PARTITION BY RANGE COLUMNS(date)
SUBPARTITION BY RANGE COLUMNS(dept_no, part_no)
(
PARTITION p_2020 VALUES LESS THAN ('2020-12-31') (
SUBPARTITION q1_2020 VALUES LESS THAN(4, 5),
SUBPARTITION q2_2020 VALUES LESS THAN(7, 6),
SUBPARTITION q3_2020 VALUES LESS THAN(10, 12),
SUBPARTITION q4_2020 VALUES LESS THAN(13, 15)
),
PARTITION p_2021 VALUES LESS THAN ('2021-12-21') (
SUBPARTITION q1_2021 VALUES LESS THAN(4, 5),
SUBPARTITION q2_2021 VALUES LESS THAN(7, 6),
SUBPARTITION q3_2021 VALUES LESS THAN(10, 12),
SUBPARTITION q4_2021 VALUES LESS THAN(13, 15)
),
PARTITION p_2022 VALUES LESS THAN ('2022-12-31')
(
SUBPARTITION q1_2022 VALUES LESS THAN(4, 5),
SUBPARTITION q2_2022 VALUES LESS THAN(7, 6),
SUBPARTITION q3_2022 VALUES LESS THAN(10, 12),
SUBPARTITION q4_2022 VALUES LESS THAN(13, 15)
)
);
