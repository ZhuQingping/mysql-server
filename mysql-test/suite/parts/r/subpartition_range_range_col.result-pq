CREATE TABLE t2
(
dept_no     INT,
part_no     INT,
country     varchar(20),
date        DATE,
amount      INT
)
PARTITION BY RANGE(year(date))
SUBPARTITION BY RANGE COLUMNS(date)
(
PARTITION p_2021 VALUES LESS THAN (2021) (
SUBPARTITION q1_2021 VALUES LESS THAN('2021-06-01'),
SUBPARTITION q2_2021 VALUES LESS THAN('2021-09-01')
),
PARTITION p_2022 VALUES LESS THAN (2022)
(
SUBPARTITION q1_2022 VALUES LESS THAN('2022-06-01'),
SUBPARTITION q2_2022 VALUES LESS THAN('2022-09-01')
)
);
CREATE TABLE t3
(
dept_no     INT,
part_no     INT,
country     varchar(20),
date        DATE,
amount      INT
)
PARTITION BY RANGE COLUMNS(dept_no)
SUBPARTITION BY RANGE COLUMNS(date, country)
(
PARTITION p_2021 VALUES LESS THAN (2021) (
SUBPARTITION q1_2021 VALUES LESS THAN('2021-06-01', 'XXXX'),
SUBPARTITION q2_2021 VALUES LESS THAN('2021-09-01', 'YYYY')
),
PARTITION p_2022 VALUES LESS THAN (2022)
(
SUBPARTITION q1_2022 VALUES LESS THAN('2022-06-01', 'XXXX'),
SUBPARTITION q2_2022 VALUES LESS THAN('2022-09-01', 'YYYY')
)
);
DROP TABLE t2, t3;
CREATE TABLE t3 (
id INT NOT NULL,
store_id INT NOT NULL
)
PARTITION BY RANGE COLUMNS(store_id) 
SUBPARTITION BY RANGE COLUMNS(id) (
PARTITION p0 VALUES LESS THAN (6) (
SUBPARTITION q1 VALUES LESS THAN (4),
SUBPARTITION q2 VALUES LESS THAN (10)
),
PARTITION p1 VALUES LESS THAN (11) (
SUBPARTITION q3 VALUES LESS THAN (15),
SUBPARTITION q4 VALUES LESS THAN (20)
)
);
