#
# DDL for list-list
#
create table t1
(
dept_no     int,
part_no     int,
country     varchar(20),
date        date,
amount      int
)
partition by list (amount)
subpartition by list (part_no)
(
partition p0 values in (1, 2)(
subpartition p0sp0 values in (1, 2),
subpartition p0sp1 values in (3, 4)
),
partition p1 values in (3, 4)(
subpartition p1sp0 values in (1, 2),
subpartition p1sp1 values in (3, 4)
)
);
alter table t1 add partition (
partition p2 values in (5, 6)
);
ERROR HY000: For LIST partitions each partition must be defined
alter table t1 add partition (
partition p2 values in (5, 6) (
subpartition p2sp0 values less than (5),
subpartition p2sp0 values less than (6)
)
);
ERROR HY000: Only RANGE PARTITIONING can use VALUES LESS THAN in partition definition
alter table t1 add partition (
partition p2 values in (5, 6) (
subpartition p2sp0 values less than (5),
subpartition p2sp0 values in (6)
)
);
ERROR HY000: Only LIST PARTITIONING can use VALUES IN in partition definition
alter table t1 add partition (
partition p2 values in (5, 6) (
subpartition p2sp0 values in (5, 6)
)
);
ERROR HY000: Trying to Add partition(s) with wrong number of subpartitions
alter table t1 add partition (
partition p2 values in (5, 6) (
subpartition p2sp0 values in ((5,6),(6,7))
)
);
ERROR HY000: Inconsistency in usage of column lists for partitioning
alter table t1 add partition (
partition p2 values in (5, 6) (
subpartition p2sp0 values in (1, 2),
subpartition p2sp1 values in (3, 4)
)
);
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `dept_no` int DEFAULT NULL,
  `part_no` int DEFAULT NULL,
  `country` varchar(20) DEFAULT NULL,
  `date` date DEFAULT NULL,
  `amount` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY LIST (`amount`)
SUBPARTITION BY LIST (`part_no`)
(PARTITION p0 VALUES IN (1,2)
 (SUBPARTITION p0sp0 VALUES IN (1,2) ENGINE = InnoDB,
  SUBPARTITION p0sp1 VALUES IN (3,4) ENGINE = InnoDB),
 PARTITION p1 VALUES IN (3,4)
 (SUBPARTITION p1sp0 VALUES IN (1,2) ENGINE = InnoDB,
  SUBPARTITION p1sp1 VALUES IN (3,4) ENGINE = InnoDB),
 PARTITION p2 VALUES IN (5,6)
 (SUBPARTITION p2sp0 VALUES IN (1,2) ENGINE = InnoDB,
  SUBPARTITION p2sp1 VALUES IN (3,4) ENGINE = InnoDB)) */
alter table t1 remove partitioning;
show create table t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `dept_no` int DEFAULT NULL,
  `part_no` int DEFAULT NULL,
  `country` varchar(20) DEFAULT NULL,
  `date` date DEFAULT NULL,
  `amount` int DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
alter table t1 add partition (
partition p3 values in (7,8) (
subpartition p3sp0 values in (1, 2),
subpartition p3sp1 values in (3, 4)
)
);
