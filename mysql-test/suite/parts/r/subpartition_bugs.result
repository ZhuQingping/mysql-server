SUBPARTITION sub2 VALUES LESS THAN('aacd',MAXVALUE),
SUBPARTITION sub3 VALUES LESS THAN('ab',MAXVALUE)
),
PARTITION p1 VALUES in (('ab',84))(
SUBPARTITION sub4 VALUES LESS THAN('aabb',MAXVALUE),
SUBPARTITION sub5 VALUES LESS THAN('aacd',MAXVALUE),
SUBPARTITION sub6 VALUES LESS THAN('ab',MAXVALUE)
),
PARTITION p2 VALUES in (('bbbbbbbbbb', 121))(
SUBPARTITION sub7 VALUES LESS THAN('aabb',MAXVALUE),
SUBPARTITION sub8 VALUES LESS THAN('aacd',MAXVALUE),
SUBPARTITION sub9 VALUES LESS THAN('ab',MAXVALUE)
),
PARTITION p3 VALUES in (('bbba2', 2147483647))(
SUBPARTITION sub10 VALUES LESS THAN('aabb',MAXVALUE),
SUBPARTITION sub11 VALUES LESS THAN('aacd',MAXVALUE),
SUBPARTITION sub12 VALUES LESS THAN('ab',MAXVALUE)
)
);
