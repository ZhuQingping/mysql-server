Note	1003	/* select#1 */ select `test`.`t1`.`int_col` AS `int_col`,`test`.`t1`.`date_col` AS `date_col`,`test`.`t1`.`varchar_col` AS `varchar_col`,`test`.`t1`.`char_col` AS `char_col` from `test`.`t1` where ((`test`.`t1`.`date_col` = DATE'1998-01-03') and (`test`.`t1`.`char_col` in ('aabb','aacd')))
