#
# BUG2023112803703: Multiple MAXVALUEs are not allowed
#
CREATE TABLE t0 (
a int,
b int
)
PARTITION BY RANGE (a)
SUBPARTITION BY RANGE (b)
(PARTITION p0 VALUES LESS THAN (10)
(SUBPARTITION q1 VALUES LESS THAN (5),
SUBPARTITION q2 VALUES LESS THAN (MAXVALUE)),
PARTITION p3 VALUES LESS THAN (20)
(SUBPARTITION q7 VALUES LESS THAN (10),
SUBPARTITION q8 VALUES LESS THAN (MAXVALUE)));
INSERT INTO t0 VALUES(1,2),(3,5),(15, 20);
SELECT * FROM t0 ORDER BY 1;
a	b
1	2
3	5
15	20
DROP TABLE t0;
