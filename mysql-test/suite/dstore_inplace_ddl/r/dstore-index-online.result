SHOW CREATE TABLE employees;
Table	Create Table
employees	CREATE TABLE `employees` (
  `employee_id` varchar(32) NOT NULL,
  `department_id` varchar(32) NOT NULL,
  `country_id` varchar(32) DEFAULT NULL,
  `boss_id` varchar(32) DEFAULT NULL,
  `name` varchar(50) NOT NULL,
  `email` varchar(150) DEFAULT NULL,
  `age` tinyint unsigned DEFAULT NULL,
  `gender` enum('M','F','O') DEFAULT 'O',
  `status` tinyint DEFAULT '1' COMMENT '0:禁用,1:正常,2:冻结',
  `credit_score` int DEFAULT '0',
  `created_at` timestamp NULL DEFAULT CURRENT_TIMESTAMP,
  `age_group` varchar(20) GENERATED ALWAYS AS ((case when (`age` < 18) then _utf8mb4'minor' when (`age` between 18 and 35) then _utf8mb4'youth' when (`age` between 36 and 55) then _utf8mb4'midlife' else _utf8mb4'elderly' end)) VIRTUAL,
  `brief_description` varchar(60000) CHARACTER SET latin1 COLLATE latin1_swedish_ci DEFAULT NULL,
  `j` json DEFAULT NULL,
  PRIMARY KEY (`employee_id`),
  KEY `fk_group` (`department_id`),
  KEY `fk_country` (`country_id`),
  KEY `boss_id` (`boss_id`),
  KEY `idx_name` (`name`),
  KEY `idx_status_created` (`status`,`created_at`),
  KEY `idx_email_created_brief` (`email`(30),`created_at`,`brief_description`(30)),
  KEY `idx_credit_score` (`credit_score` DESC),
  KEY `idx_name_gender_age` (`name`,`gender`,`age_group`),
  KEY `idx_func` ((concat(`employee_id`,`department_id`))),
  CONSTRAINT `employees_fk_1` FOREIGN KEY (`boss_id`) REFERENCES `employees` (`employee_id`) ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT `fk_country` FOREIGN KEY (`country_id`) REFERENCES `countrys` (`country_id`) ON DELETE SET NULL ON UPDATE CASCADE,
  CONSTRAINT `fk_group` FOREIGN KEY (`department_id`) REFERENCES `departments` (`department_id`) ON DELETE CASCADE ON UPDATE CASCADE
) /*!50100 TABLESPACE `tb1` */ ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
