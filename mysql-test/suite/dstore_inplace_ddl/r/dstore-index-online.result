# 11. Test create index scene that not support online yet        #
##################################################################
CREATE TABLE t1 (c1 INT NOT NULL) ENGINE=DSTORE;
ALTER TABLE t1 ADD COLUMN id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT, ADD UNIQUE KEY (id), ALGORITHM=INPLACE, LOCK=NONE;
ERROR 0A000: LOCK=NONE is not supported. Reason: Adding an auto-increment column requires a lock. Try LOCK=SHARED.
DROP TABLE t1;
CREATE TABLE t1(i INT PRIMARY KEY, j JSON) ENGINE=DSTORE;
INSERT INTO t1 VALUES (1,'"2019-1-1"'),(2,'"2019-01-01"'),(3,CAST(DATE'2019-1-1' AS JSON));
INSERT INTO t1(i)values(4);
ALTER TABLE t1 ADD INDEX idx1((CAST(j->'$' AS DATE))), ALGORITHM = INPLACE, LOCK=NONE;
ERROR 0A000: LOCK=NONE is not supported. Reason: Creating index on virtual column based on lob or json type is not supported.. Try LOCK=SHARED.
DROP TABLE t1;
CREATE TABLE t1(i INT PRIMARY KEY, j JSON, j_date DATE AS (CAST(j->>'$' AS DATE)) VIRTUAL ) ENGINE=DSTORE;
INSERT INTO t1 (i,j) VALUES (1,'"2019-1-1"'),(2,'"2019-01-01"'),(3,CAST(DATE'2019-1-1' AS JSON));
ALTER TABLE t1 ADD INDEX idx1(j_date), ALGORITHM = INPLACE, LOCK=NONE;
ERROR 0A000: LOCK=NONE is not supported. Reason: Creating index on virtual column based on lob or json type is not supported.. Try LOCK=SHARED.
DROP TABLE t1;
