CREATE TABLE t1 (c1 INT, c2 INT, c3 INT, c4 VARCHAR(100)) ENGINE=DSTORE;
CREATE PROCEDURE InsertIncrementalData(
IN n INT,
IN start INT,
IN m INT
)
BEGIN
DECLARE i INT DEFAULT 0;
WHILE i < n DO
INSERT INTO t1 (c1, c2, c3, c4)
VALUES (
start + i,
start + i,
start + i,
REPEAT('a', m)
);
SET i = i + 1;
END WHILE;
END //
CALL InsertIncrementalData(100, 1, 100);
SET DEBUG_SYNC = 'dstore_after_one_rowlog_replay_thread_created SIGNAL start_logging WAIT_FOR dml_done';
ALTER TABLE t1
ADD UNIQUE INDEX idx_c1 (c1),
ADD UNIQUE INDEX idx_c2 (c2),
ADD UNIQUE INDEX idx_c3 (c3),
ADD INDEX idx_c4 (c4),
ALGORITHM = INPLACE, LOCK=NONE;
SET DEBUG_SYNC = 'now WAIT_FOR start_logging';
INSERT INTO t1 VALUES (1001,1001,1001,'a'), (1,1003,1003,'b'), (1002,1002,1002,'c');
CALL InsertIncrementalData(3000, 2001, 100);
SET DEBUG_SYNC = 'now SIGNAL dml_done';
ERROR 23000: Duplicate entry '1' for key 't1.idx_c1'
SELECT count(*) FROM t1;
count(*)
3103
