set dstore_ddl_enable_batch_insert_for_inplace_rebuild = on;
# Scenario 1: Table with 0 rows
# Case 1: Default algorithm
CREATE TABLE t1 (c1 INT);
ALTER TABLE t1 ADD COLUMN c2 INT;
DROP TABLE t1;
CREATE TABLE t1 (c1 INT);
ALTER TABLE t1 ADD COLUMN c2 INT, ALGORITHM=DEFAULT;
DROP TABLE t1;
# Case 2: ALGORITHM clause has same value as default
CREATE TABLE t1 (c1 INT);
ALTER TABLE t1 ADD COLUMN c2 INT, ALGORITHM=INPLACE;
DROP TABLE t1;
# Case 3: ALGORITHM clause has different value from default
CREATE TABLE t1 (c1 INT);
ALTER TABLE t1 ADD COLUMN c2 INT, ALGORITHM=INSTANT;
DROP TABLE t1;
# Scenario 2: Table with 1 or more rows
# Case 1: Default algorithm
CREATE TABLE t1 (c1 INT);
INSERT INTO t1 VALUES (1);
ALTER TABLE t1 ADD COLUMN c2 INT;
DROP TABLE t1;
CREATE TABLE t1 (c1 INT);
INSERT INTO t1 VALUES (1);
ALTER TABLE t1 ADD COLUMN c2 INT, ALGORITHM=DEFAULT;
DROP TABLE t1;
# Case 2: ALGORITHM clause has same value as default
CREATE TABLE t1 (c1 INT);
INSERT INTO t1 VALUES (1);
ALTER TABLE t1 ADD COLUMN c2 INT, ALGORITHM=INSTANT;
DROP TABLE t1;
# Case 3: ALGORITHM clause has different value from default
CREATE TABLE t1 (c1 INT);
INSERT INTO t1 VALUES (1);
ALTER TABLE t1 ADD COLUMN c2 INT, ALGORITHM=INPLACE;
DROP TABLE t1;
# Scenario 3: Table with 1 delete-marked record
# Case 1: Default algorithm
CREATE TABLE t1 (c1 INT);
INSERT INTO t1 VALUES (1);
DELETE FROM t1 WHERE c1 = 1;
ALTER TABLE t1 ADD COLUMN c2 INT;
DROP TABLE t1;
CREATE TABLE t1 (c1 INT);
INSERT INTO t1 VALUES (1);
DELETE FROM t1 WHERE c1 = 1;
ALTER TABLE t1 ADD COLUMN c2 INT, ALGORITHM=DEFAULT;
DROP TABLE t1;
# Case 2: ALGORITHM clause has same value as default
CREATE TABLE t1 (c1 INT);
INSERT INTO t1 VALUES (1);
DELETE FROM t1 WHERE c1 = 1;
ALTER TABLE t1 ADD COLUMN c2 INT, ALGORITHM=INPLACE;
DROP TABLE t1;
# Case 3: ALGORITHM clause has different value from default
CREATE TABLE t1 (c1 INT);
INSERT INTO t1 VALUES (1);
DELETE FROM t1 WHERE c1 = 1;
ALTER TABLE t1 ADD COLUMN c2 INT, ALGORITHM=INSTANT;
DROP TABLE t1;
# Scenario 3: Table with blob column
CREATE TABLE t1 (
id INT AUTO_INCREMENT PRIMARY KEY,
data BLOB
) ENGINE=Dstore;
INSERT INTO t1 (data) VALUES (REPEAT('A', 6000));
INSERT INTO t1 (data) VALUES (REPEAT('B', 10));
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
DROP TABLE t1;
set dstore_ddl_enable_batch_insert_for_inplace_rebuild = off;
