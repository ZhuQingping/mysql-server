# Test rebuild table with batch insert
set dstore_ddl_enable_batch_insert_for_inplace_rebuild = on;
--source suite/dstore_inplace_ddl/include/dstore-autoinc-optimize.inc

# Test rebuild table with single insert
set dstore_ddl_enable_batch_insert_for_inplace_rebuild = off;
--source suite/dstore_inplace_ddl/include/dstore-autoinc-optimize.inc

set dstore_ddl_enable_batch_insert_for_inplace_rebuild = default;