--source include/have_debug_sync.inc
--source include/have_only_dstore.inc

# When returning an error code due to a connection kill during the index
# creation process with the rebuild algorithm, a check is added to determine
# if the operation is an ONLINE DDL. If it is not an ONLINE DDL, the OnlineMgr
# is not used, preventing the crash.

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);

--disable_query_log
call mtr.add_suppression("CdeDictStatsFetchFromPs open error");
call mtr.add_suppression("Dict stats save fail for index");
--enable_query_log

connection con1;
SET GLOBAL dstore_online_ddl_enable=OFF;
CREATE DATABASE IF NOT EXISTS db1;
use db1;

CREATE TABLE t1 (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(110),
    age INT,
    email VARCHAR(110)
);

INSERT INTO t1 (name, age, email)
VALUES ('Alice', 30, 'alice.test@example.com'),
	('Bob', 25, 'bob.sample@example.org'),
	('Charlie', 28, 'charlie.demo@example.net'),
	('David', 35, 'david.example@example.co.uk'),
	('Eve', 22, 'eve.test@example.io');

let $SU_CON_ID= `SELECT CONNECTION_ID()`;

SET DEBUG_SYNC = 'WaitRowLogAppendAndApply SIGNAL start_logging WAIT_FOR ddl_continue';
--send ALTER TABLE db1.t1 ADD INDEX idx_name_email (name, email), ALGORITHM=inplace;

connection con2;
SET DEBUG_SYNC = 'now WAIT_FOR start_logging';
--replace_result $SU_CON_ID <CONNECTION_ID>
eval KILL $SU_CON_ID;
SET DEBUG_SYNC = 'now SIGNAL ddl_continue';

--connection con1
--error 2013
reap;
--disconnect con1
--disconnect con2

connect (con1,localhost,root,,);
connect (con2,localhost,root,,);
--connection con1
SET GLOBAL dstore_online_ddl_enable=ON;
let $SU_CON_ID= `SELECT CONNECTION_ID()`;

SET DEBUG_SYNC = 'WaitRowLogAppendAndApply SIGNAL start_logging WAIT_FOR ddl_continue';
--send ALTER TABLE db1.t1 ADD INDEX idx_name_email (name, email), ALGORITHM=inplace;

connection con2;
SET DEBUG_SYNC = 'now WAIT_FOR start_logging';
--replace_result $SU_CON_ID <CONNECTION_ID>
eval KILL $SU_CON_ID;
SET DEBUG_SYNC = 'now SIGNAL ddl_continue';

--connection con1
--error 2013
reap;

connection default;

DROP DATABASE db1;
--disconnect con1
--disconnect con2
