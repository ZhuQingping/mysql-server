--echo # BUG2026031140648 Can not found referenced index after rename column using inplace algorithm
--echo ###############################################################
 
CREATE TABLE `t1` (
  `c9` longtext,
  `c8` smallint(5) unsigned zerofill DEFAULT NULL,
  `c13` decimal(10,0) unsigned zerofill NOT NULL /*!80023 INVISIBLE */,
  `c10` bit(57) DEFAULT NULL,
  `c11` float DEFAULT NULL,
  `c12` tinytext CHARACTER SET ascii COLLATE ascii_general_ci /*!80023 INVISIBLE */,
  `c7` timestamp(2) NULL DEFAULT NULL /*!80023 INVISIBLE */,
  PRIMARY KEY (`c13`),
  UNIQUE KEY `i6` (`c8`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci STATS_PERSISTENT=1 STATS_AUTO_RECALC=0 CHECKSUM=1;
 
CREATE TABLE `t2` (
  `c9` longtext,
  `c8` smallint(5) unsigned zerofill DEFAULT NULL,
  `c13` decimal(10,0) unsigned zerofill NOT NULL /*!80023 INVISIBLE */,
  `c10` bit(57) DEFAULT NULL,
  `c11` float DEFAULT NULL,
  `c12` tinytext CHARACTER SET ascii COLLATE ascii_general_ci /*!80023 INVISIBLE */,
  `c7` timestamp(2) NULL DEFAULT NULL /*!80023 INVISIBLE */,
  PRIMARY KEY (`c13`),
  UNIQUE KEY `i6` (`c10`),
  CONSTRAINT `t2_fk_1` FOREIGN KEY (`c8`) REFERENCES `t1` (`c8`),
  CONSTRAINT `t2_fk_2` FOREIGN KEY (`c13`) REFERENCES `t1` (`c13`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci STATS_PERSISTENT=1 STATS_AUTO_RECALC=0 CHECKSUM=1;
 
CREATE TABLE `t12` (
  `c8` float DEFAULT NULL,
  `c6` year DEFAULT NULL,
  `c3` bit(35) NOT NULL,
  `c4` decimal(10,0) unsigned zerofill DEFAULT NULL,
  `c7` bit(57) DEFAULT NULL,
  UNIQUE KEY `i5` (`c4`,`c3`),
  UNIQUE KEY `i6` (`c7`),
  CONSTRAINT `t12_fk_1` FOREIGN KEY (`c4`) REFERENCES `t2` (`c13`),
  CONSTRAINT `t12_fk_2` FOREIGN KEY (`c7`) REFERENCES `t2` (`c10`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci STATS_PERSISTENT=1 ROW_FORMAT=DYNAMIC;
 
