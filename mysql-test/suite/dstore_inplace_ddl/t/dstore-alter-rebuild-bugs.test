--echo ###############################################################
--echo # BUG2026030441768 Server normal shutdown cause the data loss
--echo ###############################################################
call mtr.add_suppression("heap scan failed during parallel heap scan because statement is cancelled");
call mtr.add_suppression("thread 0 heap scan failed due to: Statements of the current request are canceled by user.");
call mtr.add_suppression("heap scan failed during parallel heap scan.");
CREATE TABLE t1 (c1 int);
INSERT INTO t1 values (1), (3), (2);

--connect(con1,localhost,root)
--connect(con2,localhost,root)
--connection con1
SET DEBUG_SYNC = "parallel_reader_chiled_worker_start wait_for continue1";
--send ALTER TABLE t1 ADD COLUMN c2 longtext;

--sleep 5
--connection con2
--source include/restart_mysqld.inc

SELECT * FROM t1;

DROP TABLE t1;

