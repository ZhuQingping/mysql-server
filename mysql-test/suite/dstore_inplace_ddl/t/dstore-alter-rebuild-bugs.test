CREATE TABLE `t3` (
  `fk_parent_54` date NOT NULL,
  `fk_parent_55` time NOT NULL,
  `fk_parent_56` smallint NOT NULL,
  PRIMARY KEY (`fk_parent_54`,`fk_parent_55`,`fk_parent_56`)
) ENGINE=Dstore DEFAULT CHARSET=ascii PACK_KEYS=1 STATS_AUTO_RECALC=0 CHECKSUM=1;

CREATE TABLE `t0` (
  `fk_child_12` date DEFAULT NULL,
  `fk_child_13` time DEFAULT NULL,
  `fk_child_14` smallint DEFAULT NULL,
  KEY `fk_t3_t0_composite_1773322326542` (`fk_child_12`,`fk_child_13`,`fk_child_14`),
  CONSTRAINT `fk` FOREIGN KEY (`fk_child_12`, `fk_child_13`, `fk_child_14`) REFERENCES `t3` (`fk_parent_54`, `fk_parent_55`, `fk_parent_56`)
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci CHECKSUM=1;

