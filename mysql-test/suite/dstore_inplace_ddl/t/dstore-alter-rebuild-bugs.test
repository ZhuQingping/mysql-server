CREATE TABLE `tt_9` (
  `ipkey` int NOT NULL,
  `d1` double DEFAULT NULL,
  `d2` double DEFAULT NULL,
  `d3` double DEFAULT NULL,
  `i4` int DEFAULT NULL,
  `i5` int NOT NULL AUTO_INCREMENT,
  `lb6` longblob,
  `lt7` longtext,
  `t8` text,
  `d9` double DEFAULT NULL,
  `v10` varchar(29) DEFAULT NULL,
  `v11` varchar(29) DEFAULT NULL,
  `lb12` longblob,
  `c13` char(19) DEFAULT NULL,
  `b14` blob,
  `i15` int DEFAULT NULL,
  `v16` varchar(14) DEFAULT NULL,
  `b17` blob,
  `i18` int DEFAULT NULL,
  `t19` text,
  `mt20` mediumtext,
  `i21` int DEFAULT NULL,
  `i22` int DEFAULT NULL,
  `i23` int DEFAULT NULL,
  `v24` varchar(29) DEFAULT NULL,
  `d25` double DEFAULT NULL,
  `v26` varchar(30) DEFAULT NULL,
  `v27` varchar(15) DEFAULT NULL,
  `c28` char(16) DEFAULT NULL,
  `f29` float DEFAULT NULL,
  `i30` int DEFAULT NULL,
  `c31` char(10) DEFAULT NULL,
  `v32` varchar(27) DEFAULT NULL,
  `g33_rename` int GENERATED ALWAYS AS ((((((((((((((((((((length(`lb6`) + length(`v26`)) + length(`c28`)) + `d2`) + length(`c31`)) + length(`lb12`)) + length(`c31`)) + length(`c13`)) + length(`v26`)) + `i15`) + length(`v27`)) + length(`t8`)) + `d2`) + `d1`) + `i18`) + `d2`) + `i4`) + length(`v32`)) + length(`b14`)) + length(`v26`))) VIRTUAL,
  `g34` int GENERATED ALWAYS AS (((((((((((((((((`d25` + length(`v16`)) + `i4`) + `d2`) + length(`lb12`)) + `i4`) + `i15`) + length(`lb12`)) + length(`t19`)) + `d3`) + length(`c31`)) + `d3`) + `d1`) + length(`v11`)) + `d9`) + length(`b17`)) + `i30`)) VIRTUAL,
  `g35` int GENERATED ALWAYS AS ((((((`i18` + `i15`) + `f29`) + `i30`) + length(`v24`)) + length(`lb6`))) VIRTUAL,
  `lt36` longtext,
  `d37` double DEFAULT NULL,
  `g39` blob GENERATED ALWAYS AS (concat(substr(`v11`,1,13),`d3`,`d9`)) STORED,
  `ltN99` longtext,
  `iN158` int DEFAULT NULL,
  `bN173` blob,
  `ltN11` longtext,
  `tN79` tinyint(1) DEFAULT NULL,
  PRIMARY KEY (`ipkey`),
  KEY `tt_9194_rename` (`c31`,`v32` DESC,`d9`,`i22`,`c28`),
  KEY `tt_9i0` (`i5`,`v32`,`g34`,`i23` DESC,`c13`,`i30`,`c31` DESC,`g33_rename`,`v10`),
  KEY `tt_9511_rename` (`d9`,`i21`,`i18`,`d2`,`g33_rename` DESC,`g35`,`v11`),
  KEY `tt_9540` (`i21`,`g34` DESC,`f29` DESC,`v26`,`v16`)
) ENGINE=Dstore AUTO_INCREMENT=4044 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

