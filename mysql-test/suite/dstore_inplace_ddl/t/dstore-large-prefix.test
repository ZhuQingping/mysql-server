--source include/have_only_dstore.inc

--error ER_DUP_FIELDNAME
CREATE TABLE t1(a int not null,key(a,a)) ENGINE=Dstore DEFAULT CHARSET=latin1;
-- error ER_BLOB_USED_AS_KEY
CREATE TABLE t1(a int,b text,key(b(768))) ENGINE=Dstore DEFAULT CHARSET=latin1;

CREATE TABLE t1(a int not null,b text) ENGINE=Dstore DEFAULT CHARSET=latin1;
INSERT INTO t1 VALUES (1,''),(2,''),(3,''),(4,''),(5,''),(6,''),(7,'');
--error ER_DUP_FIELDNAME
CREATE INDEX t1aa ON t1(a,a);
-- error ER_BLOB_USED_AS_KEY
CREATE INDEX t1b ON t1(b(768));
SHOW CREATE TABLE t1;
SELECT * FROM t1;
DROP TABLE t1;

CREATE TABLE t2(a int primary key, b text) ENGINE=Dstore DEFAULT CHARSET=latin1;
INSERT INTO t2 VALUES (1,''),(2,''),(3,''),(4,''),(5,''),(6,''),(7,'');
--error ER_DUP_FIELDNAME
CREATE INDEX t2aa ON t2(a,a);
-- error ER_BLOB_USED_AS_KEY
CREATE INDEX t2b ON t2(b(768));
SELECT * FROM t2;
DROP TABLE t2;
