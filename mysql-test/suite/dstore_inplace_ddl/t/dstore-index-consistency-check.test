# ==== Purpose ====
#
# Test different mode for data consistency check for online ddl
#
# ==== References ====
#
# FE2025072500119 Support inplace create index for Taurus on Dstore
# FE2025111200338 Support online create index for Taurus on Dstore
#
--source include/have_only_dstore.inc
--source include/have_debug.inc

SET @dstore_online_ddl_check_data_mode_saved= @@dstore_online_ddl_check_data_mode;

CREATE TABLE t1 (c1 int, c2 int);
INSERT INTO t1 VALUES (1, 2), (3, 1), (2, 3);

##########################################################################
--echo Test 1. Mode 1: check online after index build (i.e. BuildParallel)
##########################################################################
SET GLOBAL dstore_online_ddl_check_data_mode = 1;

--connect (conn1,localhost,root,,)
--connection conn1
SET DEBUG_SYNC = 'dstore_row_log_replay_before SIGNAL start_logging WAIT_FOR dml_done';
--send ALTER TABLE t1 ADD INDEX keyc1(c1);

--connect (conn2,localhost,root,,)
--connection conn2
SET DEBUG_SYNC = 'now WAIT_FOR start_logging';
INSERT INTO t1 VALUES (4, 8);
DELETE FROM t1 WHERE c1 = 4;

SET DEBUG_SYNC = 'now SIGNAL dml_done';
--connection conn1
--reap

--exec echo > $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= "Only 1 time data consistency check is founded in error log."
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= "Data consistency check start for index: keyc1"
--let $assert_count= 1
--source include/assert_grep.inc

####################################################################################
--echo Test 2. Mode 2: check online after all row log is applied (i.e. Commit stage)
####################################################################################
SET GLOBAL dstore_online_ddl_check_data_mode = 2;

--connection conn1
SET DEBUG_SYNC = 'dstore_row_log_replay_before SIGNAL start_logging WAIT_FOR dml_done';
--send ALTER TABLE t1 ADD INDEX keyc2(c2);

--connection conn2
SET DEBUG_SYNC = 'now WAIT_FOR start_logging';
INSERT INTO t1 VALUES (4, 6);

SET DEBUG_SYNC = 'now SIGNAL dml_done';
--connection conn1
--reap

--exec echo > $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= "Only 1 time data consistency check is founded in error log."
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= "Data consistency check start for index: keyc2"
--let $assert_count= 1
--source include/assert_grep.inc

###########################################################################
--echo Test 3. Mode 3: check data consistency in all stage of mode 1 and 2.
###########################################################################
SET GLOBAL dstore_online_ddl_check_data_mode = 3;

--connection conn1
SET DEBUG_SYNC = 'dstore_row_log_replay_before SIGNAL start_logging WAIT_FOR dml_done';
--send ALTER TABLE t1 ADD INDEX keyc1c2(c1, c2);

--connection conn2
SET DEBUG_SYNC = 'now WAIT_FOR start_logging';
INSERT INTO t1 VALUES (4, 6);

SET DEBUG_SYNC = 'now SIGNAL dml_done';
--connection conn1
--reap

--exec echo > $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= "Two times data consistency check is founded in error log."
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= "Data consistency check start for index: keyc1c2"
--let $assert_count= 2
--source include/assert_grep.inc

###################################################
--echo Test 4. Mode 4: Not check data consistency
###################################################
SET GLOBAL dstore_online_ddl_check_data_mode = 0;

--connection conn1
SET DEBUG_SYNC = 'dstore_row_log_replay_before SIGNAL start_logging WAIT_FOR dml_done';
--send ALTER TABLE t1 ADD INDEX keyc2c1(c2, c1);

--connection conn2
SET DEBUG_SYNC = 'now WAIT_FOR start_logging';
INSERT INTO t1 VALUES (4, 6);

SET DEBUG_SYNC = 'now SIGNAL dml_done';
--connection conn1
--reap

--exec echo > $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= "Two times data consistency check is founded in error log."
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= "Data consistency check start for index: keyc2c1"
--let $assert_count= 0
--source include/assert_grep.inc

################################################################################
--echo Test 5. If error occur, we do not check data consistency
################################################################################
SET GLOBAL dstore_online_ddl_check_data_mode = 3;
CREATE TABLE t2 (c1 int, c2 int);
INSERT INTO t2 VALUES (1, 1), (1, 1), (1, 1);

--error ER_DUP_ENTRY
ALTER TABLE t2 ADD UNIQUE INDEX keyc2c1(c2, c1);

--exec echo > $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_text= "Two times data consistency check is founded in error log."
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select= "Data consistency check start for index: keyc2c1"
--let $assert_count= 0
--source include/assert_grep.inc
DROP TABLE t2;

################################################################################
--echo Test 6. Test data consistency check fail.
################################################################################

# We can just mock index tuple is not equal with heap tuple

# data consistency check fail after index build parallel finished (Mode 1)
SET GLOBAL dstore_online_ddl_check_data_mode = 1;
SET GLOBAL DEBUG = "+d, mock_data_compare_fail";
--error ER_GET_ERRNO
ALTER TABLE t1 ADD INDEX wrongkey(c1);
SET GLOBAL DEBUG = "-d, mock_data_compare_fail";

# data consistency check fail after all row log is replayed (Mode 2)
SET GLOBAL dstore_online_ddl_check_data_mode = 2;
SET GLOBAL DEBUG = "+d, mock_data_compare_fail";
--error ER_GET_ERRNO
ALTER TABLE t1 ADD INDEX wrongkey(c1);
SET GLOBAL DEBUG = "-d, mock_data_compare_fail";

--echo # Clean Env
--connection default
DROP TABLE t1;
SET GLOBAL dstore_online_ddl_check_data_mode = @dstore_online_ddl_check_data_mode_saved;

################################################################################
--echo Test 7. Test Incremental data check fail when 
################################################################################
SET GLOBAL dstore_online_ddl_check_data_mode = 4;
CREATE TABLE t1 (c1 int, c2 int);
INSERT INTO t1 VALUES (1, 2), (3, 1), (2, 3);

--connection conn1
SET DEBUG_SYNC = 'dstore_row_log_replay_before SIGNAL start_logging WAIT_FOR dml_done';
SET GLOBAL DEBUG = "+d, mock_data_compare_fail";
--send ALTER TABLE t1 ADD INDEX wrongkey(c1);

--sleep 3
--connection conn2
INSERT INTO t1 VALUES (4, 5), (6, 7);
SET DEBUG_SYNC = 'now SIGNAL dml_done';
--connection conn1
--error ER_GET_ERRNO
--reap

SET GLOBAL DEBUG = "-d, mock_data_compare_fail";
DROP TABLE t1;
--disconnect conn1
--disconnect conn2
