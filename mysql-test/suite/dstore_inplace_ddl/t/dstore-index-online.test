CREATE TABLE t1(c2 VARBINARY (12), UNIQUE(c2));
CREATE TABLE IF NOT EXISTS t3 (c1 INT4 UNSIGNED NULL, c2 INT4 UNSIGNED NULL, c3 VARBINARY (12) NULL, FOREIGN KEY (c3) REFERENCES t1(c2));
ALTER TABLE t1 RENAME COLUMN c2 TO c1, ALGORITHM=inplace;
drop table t3,t1;
