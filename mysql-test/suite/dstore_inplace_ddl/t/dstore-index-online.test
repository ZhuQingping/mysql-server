--echo ##################################################################
--echo # 1. Test with dml commit                                        #
--echo ##################################################################
# Online create indexes with other ddl options witch can use inplace algorithm;
# Perform DML with small tuple and linked tuple;
# Rollback transactions and check data and verify resource residues.

--connection default
CREATE TABLESPACE tb1 ENGINE=DSTORE;
--source ../include/reset_test_table.inc

--connect (conn1,localhost,root,,)
--connection conn1
SET DEBUG_SYNC = 'dstore_row_log_replay_before SIGNAL start_logging WAIT_FOR dml_done';

--send
ALTER TABLE employees
    # 1. Rename index
    RENAME INDEX idx_name TO idx_name_new,
    # 2. Rename column
    CHANGE COLUMN created_at created_ts TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    # 3. Drop index
	DROP PRIMARY KEY,
    DROP INDEX idx_status_created,
    # 4. Recreate the deleted index and add a comment to cover Alter_inplace_info::ALTER_INDEX_COMMENT branch.
    ADD INDEX idx_status_created (status, created_ts) COMMENT 'Recreated Index',
    # 5. Creat primary/secondary/prefix/virtual/composite indexes
    ADD PRIMARY KEY (employee_id, name),
    ADD INDEX idx_email_created_brief (email(30), created_ts, brief_description(30)),
	ADD UNIQUE INDEX idx_unique_email (email),
    ADD INDEX idx_name_gender_age (name, gender, age_group),
    ADD INDEX idx_credit_score (credit_score DESC),
    ALGORITHM = INPLACE, LOCK=NONE;

--connect (conn2,localhost,root,,)
--connection conn2
SET DEBUG_SYNC = 'now WAIT_FOR start_logging';
SET GLOBAL debug="+d,not_compress_for_lob";

# Insert a small tuple
INSERT INTO employees (employee_id, department_id, country_id, boss_id, name, email, age, created_at) VALUES
('U006', 'D002', 'C001', 'U001','sunba', 'sunba@example.com', 28, '2024-07-20 14:45:00');
# Insert a linked tuple
INSERT INTO employees (employee_id, department_id, country_id, boss_id, name, email, age, gender, status, credit_score, created_at, brief_description) VALUES
('U007', 'D002', 'C001', 'U001', 'wuming', 'wuming@example.com', 25, 'M', 1, 750, '2024-08-20 15:45:00', repeat('B', 14000));
# Update a small tuple into a small tuple, cover another page update
UPDATE employees SET email = 'zhangsan_new@example.com', brief_description = repeat('I am zhangsan', 600), j = JSON_QUOTE(repeat('A', 3000)) WHERE employee_id = 'U001';
# Update a small tuple , cover lob another page update
UPDATE employees SET email = 'ZhangSan_new@example.com' WHERE employee_id = 'U001';
UPDATE employees SET j = JSON_QUOTE(repeat('A', 6000)) WHERE employee_id = 'U001';
# Update a small tuple into a linked tuple
UPDATE employees SET brief_description = repeat('I am zhangsan', 1000) WHERE employee_id = 'U001';
# Update a linked tuple into a small tupe
UPDATE employees SET brief_description = repeat('I am zhangsan', 10) WHERE employee_id = 'U001';
# Update a linked tuple into a smaller linked tuple
UPDATE employees SET brief_description = repeat('A', 9000) WHERE employee_id = 'U002';
# Update a linked tuple into a same size linked tuple
UPDATE employees SET age = 37 WHERE employee_id = 'U002';
# Update a linked tuple into a bigger linked tuple
UPDATE employees SET brief_description = repeat('A', 23000) WHERE employee_id = 'U002';
# Insert a linked tuple
INSERT INTO employees (employee_id, department_id, country_id, boss_id, name, email, age, gender, status, credit_score, created_at, brief_description) VALUES
('U008', 'D002', 'C001', 'U001', 'zhangyue', 'zhangyue@example.com', 25, 'M', 1, 750, '2024-08-20 15:45:00', repeat('C', 14000));
# Delete a small tuple
DELETE FROM employees WHERE employee_id = 'U003';
# Delete a linked tuple
DELETE FROM employees WHERE employee_id = 'U005';

SELECT table_name,index_name,status,replayed_row_log_items,total_row_log_items FROM INFORMATION_SCHEMA.DSTORE_ONLINE_DDL_PROGRESS ORDER BY index_name;

SET GLOBAL debug="-d,not_compress_for_lob";
SET DEBUG_SYNC = 'now SIGNAL dml_done';

--connection conn1
--reap
SELECT table_name,index_name,status,replayed_row_log_items,total_row_log_items FROM INFORMATION_SCHEMA.DSTORE_ONLINE_DDL_PROGRESS;

# Online create indexes finished, check table definition.
SHOW CREATE TABLE employees;

# Check table data and created indexes.
SELECT employee_id, name, email, age, gender
	, status, credit_score, created_ts, age_group
	, CHAR_LENGTH(brief_description)
FROM employees IGNORE INDEX (PRIMARY)
ORDER BY employee_id;

SELECT employee_id, name
FROM employees FORCE INDEX (PRIMARY);

SELECT status, created_ts
FROM employees FORCE INDEX (idx_status_created);

SELECT email, created_ts
FROM employees FORCE INDEX (idx_email_created_brief)
WHERE email IS NOT NULL;

SELECT name, gender
FROM employees FORCE INDEX (idx_name_gender_age);

SELECT credit_score
FROM employees FORCE INDEX (idx_credit_score);

--disconnect conn1
--disconnect conn2


--echo ##################################################################
--echo # 2. Test with dml rollback                                      #
--echo ##################################################################
# Online create indexes with other ddl options witch can use inplace algorithm;
# Perform DML with small tuple and linked tuple;
# Rollback transactions and check data and verify resource residues.

--connection default
--source ../include/reset_test_table.inc

--connect (conn1,localhost,root,,)
--connection conn1
SET DEBUG_SYNC = 'dstore_row_log_replay_before SIGNAL start_logging WAIT_FOR dml_done';

--send
ALTER TABLE employees
    # 1. Rename index
    RENAME INDEX idx_name TO idx_name_new,
    # 2. Rename column
    CHANGE COLUMN created_at created_ts TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    # 3. Drop index
	DROP PRIMARY KEY,
    DROP INDEX idx_status_created,
    # 4. Recreate the deleted index and add a comment to cover Alter_inplace_info::ALTER_INDEX_COMMENT branch.
    ADD INDEX idx_status_created (status, created_ts) COMMENT 'Recreated Index',
    # 5. Creat primary/secondary/prefix/virtual/composite indexes
    ADD PRIMARY KEY (employee_id, name),
    ADD INDEX idx_email_created_brief (email(30), created_ts, brief_description(30)),
	ADD UNIQUE INDEX idx_unique_email (email),
    ADD INDEX idx_name_gender_age (name, gender, age_group),
    ADD INDEX idx_credit_score (credit_score DESC),
    ALGORITHM = INPLACE, LOCK=NONE;

--connect (conn2,localhost,root,,)
--connection conn2
SET DEBUG_SYNC = 'now WAIT_FOR start_logging';
SET GLOBAL debug="+d,not_compress_for_lob";

BEGIN;
# Insert a small tuple
INSERT INTO employees (employee_id, department_id, country_id, boss_id, name, email, age, created_at) VALUES
('U006', 'D002', 'C001', 'U001','sunba', 'sunba@example.com', 28, '2024-07-20 14:45:00');
# Insert a linked tuple
INSERT INTO employees (employee_id, department_id, country_id, boss_id, name, email, age, gender, status, credit_score, created_at, brief_description) VALUES
('U007', 'D002', 'C001', 'U001', 'wuming', 'wuming@example.com', 25, 'M', 1, 750, '2024-08-20 15:45:00', repeat('B', 14000));
# Update a small tuple into a small tuple, cover another page update
UPDATE employees SET email = 'zhangsan_new@example.com', brief_description = repeat('I am zhangsan', 600), j = JSON_QUOTE(repeat('A', 3000)) WHERE employee_id = 'U001';
# Update a small tuple , cover lob another page update
UPDATE employees SET email = 'ZhangSan_new@example.com' WHERE employee_id = 'U001';
UPDATE employees SET j = JSON_QUOTE(repeat('A', 6000)) WHERE employee_id = 'U001';
# Update a small tuple into a linked tuple
UPDATE employees SET brief_description = repeat('I am zhangsan', 1000) WHERE employee_id = 'U001';
# Update a linked tuple into a small tupe
UPDATE employees SET brief_description = repeat('I am zhangsan', 10) WHERE employee_id = 'U001';
# Update a linked tuple into a smaller linked tuple
UPDATE employees SET brief_description = repeat('A', 9000) WHERE employee_id = 'U002';
# Update a linked tuple into a same size linked tuple
UPDATE employees SET age = 37 WHERE employee_id = 'U002';
# Update a linked tuple into a bigger linked tuple
UPDATE employees SET brief_description = repeat('A', 23000) WHERE employee_id = 'U002';
# Insert a linked tuple
INSERT INTO employees (employee_id, department_id, country_id, boss_id, name, email, age, gender, status, credit_score, created_at, brief_description) VALUES
('U008', 'D002', 'C001', 'U001', 'zhangyue', 'zhangyue@example.com', 25, 'M', 1, 750, '2024-08-20 15:45:00', repeat('C', 14000));
# Delete a small tuple
DELETE FROM employees WHERE employee_id = 'U003';
# Delete a linked tuple
DELETE FROM employees WHERE employee_id = 'U005';
ROLLBACK;

SELECT table_name,index_name,status,replayed_row_log_items,total_row_log_items FROM INFORMATION_SCHEMA.DSTORE_ONLINE_DDL_PROGRESS ORDER BY index_name;

SET GLOBAL debug="-d,not_compress_for_lob";
SET DEBUG_SYNC = 'now SIGNAL dml_done';

--connection conn1
--reap
SELECT table_name,index_name,status,replayed_row_log_items,total_row_log_items FROM INFORMATION_SCHEMA.DSTORE_ONLINE_DDL_PROGRESS;

# Online create indexes finished, check table definition.
SHOW CREATE TABLE employees;

# Check table data and created indexes.
SELECT employee_id, name, email, age, gender
	, status, credit_score, created_ts, age_group
	, CHAR_LENGTH(brief_description)
FROM employees IGNORE INDEX (PRIMARY)
ORDER BY employee_id;

SELECT employee_id, name
FROM employees FORCE INDEX (PRIMARY);

SELECT status, created_ts
FROM employees FORCE INDEX (idx_status_created);

SELECT email, created_ts
FROM employees FORCE INDEX (idx_email_created_brief)
WHERE email IS NOT NULL;

SELECT name, gender
FROM employees FORCE INDEX (idx_name_gender_age);

SELECT credit_score
FROM employees FORCE INDEX (idx_credit_score);

--disconnect conn1
--disconnect conn2

--echo ##################################################################
--echo # 3. Test with reboot and dml rollback(Verify tableId is valid)  #
--echo ##################################################################
# Online create indexes with other ddl options witch can use inplace algorithm;
