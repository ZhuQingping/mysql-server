# case 1 Add TINYINT autoincrement column with inplace algorithm.
CREATE TABLE t1 (a INT) ENGINE=Dstore;
INSERT INTO t1 VALUES(1);
ALTER TABLE t1 ADD id TINYINT AUTO_INCREMENT PRIMARY KEY, AUTO_INCREMENT = 10, ALGORITHM=INPLACE;
SELECT * FROM t1;
DROP TABLE t1;

