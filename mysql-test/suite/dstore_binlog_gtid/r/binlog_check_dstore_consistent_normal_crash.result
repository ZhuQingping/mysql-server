RESET MASTER;
CREATE TABLE t (i INT);
INSERT INTO t VALUES (1);
INSERT INTO t VALUES (2);
INSERT INTO t VALUES (3);
# Kill and restart
# expect rds_binlog_dstore_consistent is ON.
show variables like 'rds_binlog_dstore_consistent';
Variable_name	Value
rds_binlog_dstore_consistent	ON
# expect rds_dstore_missed_gtids is empty
show variables like 'rds_dstore_missed_gtids';
Variable_name	Value
rds_dstore_missed_gtids	
# expect rds_dstore_missed_gtids_on_binlog is empty.
show variables like 'rds_dstore_missed_gtids_on_binlog';
Variable_name	Value
rds_dstore_missed_gtids_on_binlog	
# Kill and restart
# expect rds_binlog_dstore_consistent is ON.
show variables like 'rds_binlog_dstore_consistent';
Variable_name	Value
rds_binlog_dstore_consistent	ON
# expect rds_dstore_missed_gtids is empty
show variables like 'rds_dstore_missed_gtids';
Variable_name	Value
rds_dstore_missed_gtids	
# expect rds_dstore_missed_gtids_on_binlog is empty.
show variables like 'rds_dstore_missed_gtids_on_binlog';
Variable_name	Value
rds_dstore_missed_gtids_on_binlog	
drop table t;
