RESET MASTER;
TRUNCATE mysql.rds_comment;
#
# Modify a system table with InnoDB engine, which
# is not in progress of dstore trx.
#
INSERT INTO mysql.rds_comment (object_type, object_name, comment) VALUES ('DB','test_comment_db','test db comment');
INSERT INTO mysql.rds_comment (object_type, object_name, comment) VALUES ('DB','not_exist_db','test db comment');
# Kill and restart
#
# Expect that rds_binlog_dstore_consistent is on, which indicates
# that the gtid set between binlog and dstore is consistent.
#
show variables like 'rds_binlog_dstore_consistent';
Variable_name	Value
rds_binlog_dstore_consistent	ON
#
# Expect that rds_dstore_missed_gtids is empty.
#
show variables like 'rds_dstore_missed_gtids';
Variable_name	Value
rds_dstore_missed_gtids	
#
# Expect that rds_dstore_missed_gtids_on_binlog is empty.
#
show variables like 'rds_dstore_missed_gtids_on_binlog';
Variable_name	Value
rds_dstore_missed_gtids_on_binlog	
CREATE TABLE t1(a INT);
INSERT INTO t1 VALUES(1);
DROP TABLE t1;
DELETE FROM mysql.rds_comment;
