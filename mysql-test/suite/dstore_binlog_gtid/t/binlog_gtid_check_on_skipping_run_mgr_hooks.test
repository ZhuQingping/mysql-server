# ==== Purpose =======
# Verify that sql statment works as expected on skipping run mgr hooks
# and run after_commit hook.
#
# ==== References ====
#
# US2026010400443 Improve the performance of the master with binlog based semi-sync repilcation
#

--source include/have_binlog_format_row.inc
--source include/have_only_dstore.inc
--source include/have_log_bin.inc
--source include/have_debug.inc
--source include/have_semisync_plugin.inc

--echo #
--echo # Initialization
--echo #
# The following is to prevent a mis-match on windows that has the name of the
# lib ending with 'dll'
--replace_regex /\.dll/.so/
eval INSTALL PLUGIN rpl_semi_sync_source SONAME '$SEMISYNC_SOURCE_PLUGIN';

SELECT @@GLOBAL.rpl_semi_sync_source_wait_point;

reset master;
create table t1 (x int, y int);

--source include/show_binlog_events.inc

insert into t1 values(1,1);
select * from t1;
begin;
insert into t1 values(1,2);
commit;

--source include/show_binlog_events.inc

update t1 set x = 2;
update t1 set x = 3 where y = 1;

--source include/show_binlog_events.inc

delete from t1 where y = 1;
select * from t1;
delete from t1;

--source include/show_binlog_events.inc

drop table t1;

--echo #
--echo # Cleanup
--echo #
UNINSTALL PLUGIN rpl_semi_sync_source;
