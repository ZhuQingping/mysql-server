# ==== Purpose =======
# Verify that a crash occurs before writing GTID information into the WAL, 
# and during recovery, the calculated DStore missed GTIDs is not null.
# ==== References ====
#
# US2025072201182 Write gtid into wal and recovery read gtid from wal.
#

--source include/have_binlog_format_row.inc
--source include/have_only_dstore.inc
--source include/have_log_bin.inc
--source include/have_debug.inc
call mtr.add_suppression("rds_dstore_missed_gtids is");
call mtr.add_suppression(" Plugin 'Dstore' ");
RESET MASTER;
CREATE TABLE t (i INT);
INSERT INTO t VALUES (1);

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--echo # Crash before write gtid info write wal.
set session debug="+d, crash_write_gtid_before_log";
set session gtid_next='9b11f58f-612a-11f0-a4de-0242ac110007:1';
--error 2013
INSERT INTO t VALUES (2);

--source include/wait_until_disconnected.inc

--enable_reconnect
--echo # Restart the master server
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--source include/wait_until_connected_again.inc
--disable_reconnect

--echo # expect one record.
select * from t;

--echo # expect rds_binlog_dstore_consistent is off.
show variables like 'rds_binlog_dstore_consistent';

--echo # expect rds_dstore_missed_gtids is 9b11f58f-612a-11f0-a4de-0242ac110007:1.
show variables like 'rds_dstore_missed_gtids';

--echo # expect rds_dstore_missed_gtids_on_binlog is binlog.000001.

show variables like 'rds_dstore_missed_gtids_on_binlog';

SET GLOBAL rds_binlog_dstore_consistent = ON;
--sleep 1
--echo #
--echo # Expect that rds_binlog_dstore_consistent is on.
--echo #
show variables like 'rds_binlog_dstore_consistent';
--echo #
--echo # Expect that rds_dstore_missed_gtids is empty.
--echo #
show variables like 'rds_dstore_missed_gtids';
--echo #
--echo # Expect that rds_dstore_missed_gtids_on_binlog is empty.
--echo #
show variables like 'rds_dstore_missed_gtids_on_binlog';

--echo #
--echo # Set rds_binlog_dstore_consistent to ON repeatedly,
--echo # expect that there is no error.
--echo #
SET GLOBAL rds_binlog_dstore_consistent = ON;
--echo #
--echo # Expect that rds_binlog_dstore_consistent is on.
--echo #
show variables like 'rds_binlog_dstore_consistent';
--echo #
--echo # Expect that rds_dstore_missed_gtids is empty.
--echo #
show variables like 'rds_dstore_missed_gtids';
--echo #
--echo # Expect that rds_dstore_missed_gtids_on_binlog is empty.
--echo #
show variables like 'rds_dstore_missed_gtids_on_binlog';

--source include/kill_and_restart_mysqld.inc

--echo #
--echo # Expect that rds_binlog_dstore_consistent is on after crash recovery.
--echo #
show variables like 'rds_binlog_dstore_consistent';
--echo #
--echo # Expect that rds_dstore_missed_gtids is empty after crash recovery.
--echo #
show variables like 'rds_dstore_missed_gtids';
--echo #
--echo # Expect that rds_dstore_missed_gtids_on_binlog is empty after
--echo # crash recovery.
--echo #
show variables like 'rds_dstore_missed_gtids_on_binlog';

--echo #
--echo # Set rds_binlog_dstore_consistent to ON when it is ON after
--echo # crash recovery, expect that there is no error.
--echo #
SET GLOBAL rds_binlog_dstore_consistent = ON;
--echo #
--echo # Expect that rds_binlog_dstore_consistent is on.
--echo #
show variables like 'rds_binlog_dstore_consistent';
--echo #
--echo # Expect that rds_dstore_missed_gtids is empty.
--echo #
show variables like 'rds_dstore_missed_gtids';
--echo #
--echo # Expect that rds_dstore_missed_gtids_on_binlog is empty.
--echo #
show variables like 'rds_dstore_missed_gtids_on_binlog';

drop table t;

--source include/restart_mysqld.inc
