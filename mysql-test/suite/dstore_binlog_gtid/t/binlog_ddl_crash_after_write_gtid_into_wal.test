# ==== Purpose =======
# On executing a ddl, make it crash after writing its gtid into wal,
# verify that the ddl is executed successfully and the gtid set
# between binlog and dstore is consistent.
#
# ==== References ====
#
# US2026010400443 Improve the performance of the master with
# binlog based semi-sync repilcation
#

--source include/have_binlog_format_row.inc
--source include/have_only_dstore.inc
--source include/have_log_bin.inc
--source include/have_debug.inc

RESET MASTER;

--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--echo
--echo # Crash after writing trx's gtid into wal.
--echo
set session debug ="+d, crash_write_gtid_after_log";
set session gtid_next = '9b11f58f-612a-11f0-a4de-0242ac110007:1';
--error 2013
CREATE TABLE t1(a INT);

--source include/wait_until_disconnected.inc
--enable_reconnect
--echo
--echo # Restart the master server
--echo
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--source include/wait_until_connected_again.inc
--disable_reconnect

--echo
--echo # Except that the table t1 is created.
--echo
SHOW CREATE TABLE t1;
INSERT INTO t1 VALUES(1);
SELECT * FROM t1;

--echo #
--echo # Expect that rds_binlog_dstore_consistent is on, which indicates
--echo # that the gtid set between binlog and dstore is consistent.
--echo #
show variables like 'rds_binlog_dstore_consistent';
--echo #
--echo # Expect that rds_dstore_missed_gtids is empty.
--echo #
show variables like 'rds_dstore_missed_gtids';
--echo #
--echo # Expect that rds_dstore_missed_gtids_on_binlog is empty.
--echo #
show variables like 'rds_dstore_missed_gtids_on_binlog';
--echo #
--echo # Expect that replication_optimize_for_static_plugin_config is on.
--echo #
show variables like 'replication_optimize_for_static_plugin_config';

# Cleanup
DROP TABLE t1;
