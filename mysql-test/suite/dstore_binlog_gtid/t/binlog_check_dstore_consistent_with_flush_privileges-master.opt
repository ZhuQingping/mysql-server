--enforce_gtid_consistency=on
--gtid_mode=on
--binlog_transaction_dependency_tracking=WRITESET
--dstore_use_histogram_auto_update=off
--rds_dstore_support_binlog_check=on
--storage_engine_mode=only_dstore
--default-storage-engine=Dstore
--default_tmp_storage_engine=Dstore
--disabled_storage_engines=CSV,Memory,InnoDB,MyISAM,MRG_MyISAM
--transaction_isolation=READ-COMMITTED

