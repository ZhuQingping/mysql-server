################################################################################
#
# No uncommitted changes should be visible to a REPEATABLE-READ transaction
#
################################################################################
let $engine = 'Dstore';
--source suite/dstore_engines/rr_trx/include/rr_init.test
SET autocommit = 0;
START TRANSACTION;

--error 0, ER_LOCK_DEADLOCK, ER_LOCK_WAIT_TIMEOUT
SELECT * FROM t1 WHERE `is_uncommitted` > 0;

COMMIT;
drop table if exists statistics;
drop table if exists t1 ;
drop procedure if exists insertRows;