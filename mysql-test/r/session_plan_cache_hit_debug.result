# Phase 4C: cached hit apply failure restores state and falls back
CREATE TABLE pc4c_dbg (c INT, v VARCHAR(16)) ENGINE=InnoDB;
INSERT INTO pc4c_dbg VALUES (10, 'ten'), (20, 'twenty'), (30, 'thirty');
SET SESSION rds_plan_cache=ON;
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
PREPARE stmt FROM 'SELECT v FROM pc4c_dbg WHERE c = ?';
SET @c=10;
EXECUTE stmt USING @c;
v
ten
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
SET SESSION debug='+d,plan_cache_apply_after_bind_fail';
SET @c=20;
EXECUTE stmt USING @c;
v
twenty
SET SESSION debug='-d,plan_cache_apply_after_bind_fail';
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
SET @c=30;
EXECUTE stmt USING @c;
v
thirty
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	1
DEALLOCATE PREPARE stmt;
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	1
DROP TABLE pc4c_dbg;
