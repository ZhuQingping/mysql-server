# PREPARE
call mtr.add_suppression("Too many connections*");
call mtr.add_suppression("The SUPER privilege identifier is deprecated");
# rds reserved user without SUPER privileges.
CREATE USER 'reserved_user_without_super'@'%' IDENTIFIED BY '123456';
GRANT SELECT ON *.* TO 'reserved_user_without_super'@'%' WITH GRANT OPTION;
SHOW GRANTS FOR 'reserved_user_without_super'@'%';
Grants for reserved_user_without_super@%
GRANT SELECT ON *.* TO `reserved_user_without_super`@`%` WITH GRANT OPTION
# rds reserved user with SUPER privileges, although SUPER has been deprecated.
CREATE USER 'reserved_user_with_super'@'%' IDENTIFIED BY '123456';
GRANT SELECT, SUPER ON *.* TO 'reserved_user_with_super'@'%' WITH GRANT OPTION;
SHOW GRANTS FOR 'reserved_user_with_super'@'%';
Grants for reserved_user_with_super@%
GRANT SELECT, SUPER ON *.* TO `reserved_user_with_super`@`%` WITH GRANT OPTION
# rds reserved user with CONN_ADMIN privileges.
CREATE USER 'reserved_user_with_conn_admin'@'%' IDENTIFIED BY '123456';
GRANT SELECT,CONNECTION_ADMIN ON *.* TO 'reserved_user_with_conn_admin'@'%' WITH GRANT OPTION;
SHOW GRANTS FOR 'reserved_user_with_conn_admin'@'%';
Grants for reserved_user_with_conn_admin@%
GRANT SELECT ON *.* TO `reserved_user_with_conn_admin`@`%` WITH GRANT OPTION
GRANT CONNECTION_ADMIN ON *.* TO `reserved_user_with_conn_admin`@`%` WITH GRANT OPTION
# rds reserved user with SERVICE_CONN_ADMIN privileges.
CREATE USER 'reserved_user_with_service_admin'@'%' IDENTIFIED BY '123456';
GRANT SELECT,SERVICE_CONNECTION_ADMIN ON *.* TO 'reserved_user_with_service_admin'@'%' WITH GRANT OPTION;
SHOW GRANTS FOR 'reserved_user_with_service_admin'@'%';
Grants for reserved_user_with_service_admin@%
GRANT SELECT ON *.* TO `reserved_user_with_service_admin`@`%` WITH GRANT OPTION
GRANT SERVICE_CONNECTION_ADMIN ON *.* TO `reserved_user_with_service_admin`@`%` WITH GRANT OPTION
# mysql user with SUPER privileges, although SUPER has been deprecated.
CREATE USER 'normal_user_with_super'@'%' IDENTIFIED BY '123456';
GRANT SELECT, SUPER ON *.* TO 'normal_user_with_super'@'%' WITH GRANT OPTION;
SHOW GRANTS FOR 'normal_user_with_super'@'%';
Grants for normal_user_with_super@%
GRANT SELECT, SUPER ON *.* TO `normal_user_with_super`@`%` WITH GRANT OPTION
# mysql user without SUPER privileges.
CREATE USER 'normal_user_without_super'@'%' IDENTIFIED BY '123456';
GRANT SELECT ON *.* TO 'normal_user_without_super'@'%' WITH GRANT OPTION;
SHOW GRANTS FOR 'normal_user_without_super'@'%';
Grants for normal_user_without_super@%
GRANT SELECT ON *.* TO `normal_user_without_super`@`%` WITH GRANT OPTION
# mysql user with dynamic CONNECTION_ADMIN privileges.
CREATE USER 'normal_user_with_conn_admin'@'%' IDENTIFIED BY '123456';
GRANT SELECT, CONNECTION_ADMIN ON *.* TO 'normal_user_with_conn_admin'@'%' WITH GRANT OPTION;
SHOW GRANTS FOR 'normal_user_with_conn_admin'@'%';
Grants for normal_user_with_conn_admin@%
GRANT SELECT ON *.* TO `normal_user_with_conn_admin`@`%` WITH GRANT OPTION
GRANT CONNECTION_ADMIN ON *.* TO `normal_user_with_conn_admin`@`%` WITH GRANT OPTION
# mysql user with dynamic SERVICE_CONNECTION_ADMIN  privileges.
CREATE USER 'normal_user_with_service_admin'@'%' IDENTIFIED BY '123456';
GRANT SELECT, SERVICE_CONNECTION_ADMIN ON *.* TO 'normal_user_with_service_admin'@'%' WITH GRANT OPTION;
SHOW GRANTS FOR 'normal_user_with_service_admin'@'%';
Grants for normal_user_with_service_admin@%
GRANT SELECT ON *.* TO `normal_user_with_service_admin`@`%` WITH GRANT OPTION
GRANT SERVICE_CONNECTION_ADMIN ON *.* TO `normal_user_with_service_admin`@`%` WITH GRANT OPTION
FLUSH PRIVILEGES;
show variables like 'rds_reserved_users';
Variable_name	Value
rds_reserved_users	reserved_user_with_super,reserved_user_without_super,reserved_user_with_conn_admin,reserved_user_with_service_admin
show variables like 'rds_reserved_connections';
Variable_name	Value
rds_reserved_connections	4
show variables like 'max_connections';
Variable_name	Value
max_connections	5
#
# Prepare 1: The reserved user without SUPER can connect to the database.
#
#
# Prepare 2: The reserved user with SUPER can connect to the database.
#
#
# Prepare 3: The reserved user with CONNECTION_ADMIN can connect to the database.
#
#
# Prepare 4: The reserved user with SERVICE_CONNECTION_ADMIN can connect to the database through master port.
#
#
# Prepare 5: The reserved user with SERVICE_CONNECTION_ADMIN can connect to the database through admin port.
#
#
# Prepare 6: The non-reserved user without SUPER can connect to the database.
#
#
# Prepare 7: The non-reserved user with SUPER can connect to the database.
#
#
# Prepare 8: The non-reserved user with CONNECTION_ADMIN can connect to the database.
#
#
# Prepare 9: The non-reserved user with SERVICE_CONNECTION_ADMIN can connect to the database through master port.
#
#
# Prepare 10: The non-reserved user with SERVICE_CONNECTION_ADMIN can connect to the database through admin port.
#
select count(*) from information_schema.PROCESSLIST where user in ('root','normal_user_with_super','normal_user_without_super','normal_user_with_conn_admin','normal_user_with_service_admin');
count(*)
6
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
select count(*) from information_schema.PROCESSLIST where user in ('reserved_user_with_super','reserved_user_without_super','reserved_user_with_conn_admin','reserved_user_with_service_admin');
count(*)
5
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
show global status like "Admin_threads_connected";
Variable_name	Value
Admin_threads_connected	2
