# 1. Test sync with drop database
SET @saved_rds_permission_control = @@global.rds_permission_control;
SET @saved_rds_sync_comment = @@global.rds_sync_comment;
TRUNCATE mysql.rds_comment;
RESET MASTER;
SET GLOBAL rds_sync_comment = ON;
INSERT INTO mysql.rds_comment (object_type, object_name, comment) VALUES ('DB','test_comment_db','test db comment');
INSERT INTO mysql.rds_comment (object_type, object_name, comment) VALUES ('DB','not_exist_db','test db comment');
CREATE DATABASE test_comment_db;
SELECT object_type, object_name, comment FROM mysql.rds_comment WHERE object_type='DB';
object_type	object_name	comment
DB	not_exist_db	test db comment
DB	test_comment_db	test db comment
DROP DATABASE test_comment_db;
SELECT object_type, object_name, comment FROM mysql.rds_comment WHERE object_type='DB';
object_type	object_name	comment
DB	not_exist_db	test db comment
# 2. Check binlog (rds_comment should not record in binlog)
include/show_binlog_events.inc
