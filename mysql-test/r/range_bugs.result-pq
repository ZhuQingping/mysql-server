set default_storage_engine=innodb;
create table t1 (a int primary key, b int);
insert into t1 values (100,100);
create table t2 (a int, key(a) );
insert into t2 values (101),(102),(103),(104);
analyze table t1,t2;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK
explain format=tree select * from t1, t2 where t1.a=100 and t2.a>=t1.b-20 and t2.a<t1.b;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=0.385 rows=1)
    -> Parallel covering index range scan on t2 using a over (80 <= a < 100)  (cost=0.385 rows=0.25)

select * from t1, t2 where t1.a=100 and t2.a>=t1.b-20 and t2.a<t1.b;
a	b	a
explain format=tree select * from (t1, t1 as t3) left join t2 on t2.a>=t1.b-20 and t2.a<t1.b where t1.a=100;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2, t3  (cost=0.5 rows=1)
    -> Left hash join, hash table shared by worker threads (no condition)  (cost=0.5 rows=0.25)
        -> Parallel table scan on t3  (cost=0.275 rows=0.25)
        -> Hash
            -> Parallel covering index range scan on t2 using a over (80 <= a < 100)  (cost=0.385 rows=0.25)

drop table t1,t2;
CREATE TABLE t0 (c0 INT NOT NULL, c1 INT NOT NULL PRIMARY KEY);
CREATE TABLE t1 (a INT NOT NULL, b INT NOT NULL);
