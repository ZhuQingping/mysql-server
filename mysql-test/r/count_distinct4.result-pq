# case1: COUNT(DISTINCT) includes a field
CREATE TABLE t1 (
id INT AUTO_INCREMENT PRIMARY KEY,
name VARCHAR(50),
age INT,
class VARCHAR(50)
);
INSERT INTO t1 (name, age, class) VALUES 
('Alice', 30, '1'),
('Bob', 25, '1'),
('Charlie', 35, '2'),
('David', 40, '1'),
('Alice', 30, '1'),
('Frank', 29, '1'),
('Grace', 33, '2'),
('Hank', 45, '1'),
('Ivy', 27, '2'),
('John', 38, '1'),
('Alice', 30, '1');
