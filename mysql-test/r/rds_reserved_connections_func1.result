USE mysql;
# prepare
call mtr.add_suppression("Too many connections*");
CREATE USER 'reserved_user_with_super'@'%' IDENTIFIED BY '123456';
GRANT SELECT,SUPER ON *.* TO 'reserved_user_with_super'@'%' WITH GRANT OPTION;
SHOW GRANTS for 'reserved_user_with_super'@'%';
Grants for reserved_user_with_super@%
GRANT SELECT, SUPER ON *.* TO `reserved_user_with_super`@`%` WITH GRANT OPTION
CREATE USER 'reserved_user_without_super'@'%' IDENTIFIED BY '123456';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, RELOAD, PROCESS, REFERENCES, INDEX, ALTER, SHOW DATABASES, CREATE TEMPORARY TABLES, LOCK TABLES, EXECUTE, REPLICATION SLAVE, REPLICATION CLIENT, CREATE VIEW, SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, CREATE USER, EVENT, TRIGGER ON *.* TO 'reserved_user_without_super'@'%' WITH GRANT OPTION;
CREATE USER 'normal_user_with_super'@'%' IDENTIFIED BY '123456';
GRANT SELECT, SUPER ON *.* TO 'normal_user_with_super'@'%' WITH GRANT OPTION;
SHOW GRANTS for 'normal_user_with_super'@'%';
Grants for normal_user_with_super@%
GRANT SELECT, SUPER ON *.* TO `normal_user_with_super`@`%` WITH GRANT OPTION
CREATE USER 'normal_user_without_super'@'%' IDENTIFIED BY '123456';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, RELOAD, PROCESS, REFERENCES, INDEX, ALTER, SHOW DATABASES, CREATE TEMPORARY TABLES, LOCK TABLES, EXECUTE, REPLICATION SLAVE, REPLICATION CLIENT, CREATE VIEW, SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, CREATE USER, EVENT, TRIGGER ON *.* TO 'normal_user_without_super'@'%' WITH GRANT OPTION;
FLUSH PRIVILEGES;
show variables like 'rds_reserved_users';
Variable_name	Value
rds_reserved_users	reserved_user_with_super,reserved_user_without_super
show variables like 'rds_reserved_connections';
Variable_name	Value
rds_reserved_connections	5
show variables like 'max_connections';
Variable_name	Value
max_connections	5
#
# Test 1: The reserved user can connect to the database through the non-extra port.
#
select count(*) from information_schema.PROCESSLIST where user in ('root','normal_user_with_super','normal_user_without_super');
count(*)
1
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
select count(*) from information_schema.PROCESSLIST where user in ('reserved_user_with_super','reserved_user_without_super');
count(*)
1
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
#
# Test 2: The non-reserved user can connect to the database through the non-extra port.
#
select count(*) from information_schema.PROCESSLIST where user in ('root','normal_user_with_super','normal_user_without_super');
count(*)
2
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
select count(*) from information_schema.PROCESSLIST where user in ('reserved_user_with_super','reserved_user_without_super');
count(*)
1
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
#
# Test 3: The number of sessions connected by reserved user(without super) through non-extra port can be
#         up to rds_reserved_connections.
#
select count(*) from information_schema.PROCESSLIST where user in ('root','normal_user_with_super','normal_user_without_super');
count(*)
2
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
select count(*) from information_schema.PROCESSLIST where user in ('reserved_user_with_super','reserved_user_without_super');
count(*)
5
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
ERROR 08004: Too many connections
#
# Test 4: When the rds_reserved_connections resource is consumed, it does not allowed the
#         reserved user to login in, even if you have super permissions.
#
ERROR 08004: Too many connections
#
# Test 5: The number of sessions connected by non-reserved(without super) user through non-extra port can be
#         up to max_connections.
#
select count(*) from information_schema.PROCESSLIST where user in ('root','normal_user_with_super','normal_user_without_super');
count(*)
5
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
select count(*) from information_schema.PROCESSLIST where user in ('reserved_user_with_super','reserved_user_without_super');
count(*)
5
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
ERROR 08004: Too many connections
#
# Test 6: When the max_connections resource is consumed, it allows one
#         normal user(with super) to login in.
#
select count(*) from information_schema.PROCESSLIST where user in ('root','normal_user_with_super','normal_user_without_super');
count(*)
6
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
select count(*) from information_schema.PROCESSLIST where user in ('reserved_user_with_super','reserved_user_without_super');
count(*)
5
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
ERROR HY000: Too many connections
ERROR 08004: Too many connections
select count(*) from information_schema.PROCESSLIST where user in ('root','normal_user_with_super','normal_user_without_super');
count(*)
6
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
select count(*) from information_schema.PROCESSLIST where user in ('reserved_user_with_super','reserved_user_without_super');
count(*)
5
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
#
# Test 7: When the max_connections resource is consumed, it does not affect the 
#         reserved user login in.
#
select count(*) from information_schema.PROCESSLIST where user in ('root','normal_user_with_super','normal_user_without_super');
count(*)
6
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
select count(*) from information_schema.PROCESSLIST where user in ('reserved_user_with_super','reserved_user_without_super');
count(*)
5
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
#
# Test 8: When the rds_reserved_connections resource is consumed, it does not affect the 
#         non-reserved user login in.
#
select count(*) from information_schema.PROCESSLIST where user in ('root','normal_user_with_super','normal_user_without_super');
count(*)
6
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
select count(*) from information_schema.PROCESSLIST where user in ('reserved_user_with_super','reserved_user_without_super');
count(*)
5
Warnings:
Warning	1287	'INFORMATION_SCHEMA.PROCESSLIST' is deprecated and will be removed in a future release. Please use performance_schema.processlist instead
# Cleanup
DROP USER reserved_user_with_super,reserved_user_without_super,normal_user_with_super,normal_user_without_super;
