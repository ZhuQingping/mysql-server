# Phase 4D-5: unsupported eligibility boundaries
CREATE TABLE pc4d_e1 (
id INT PRIMARY KEY,
c INT,
v VARCHAR(16)
) ENGINE=InnoDB;
CREATE TABLE pc4d_e2 (
id INT PRIMARY KEY,
w VARCHAR(16)
) ENGINE=InnoDB;
INSERT INTO pc4d_e1 VALUES
(1, 10, 'one'),
(2, 20, 'two'),
(3, 30, 'three');
INSERT INTO pc4d_e2 VALUES
(1, 'uno'),
(2, 'dos'),
(3, 'tres');
SET @old_rds_plan_cache=@@SESSION.rds_plan_cache;
SET SESSION rds_plan_cache=ON;
# multi-table joins remain unsupported for cached hits
FLUSH STATUS;
PREPARE join_stmt FROM
'SELECT t1.v, t2.w FROM pc4d_e1 t1 JOIN pc4d_e2 t2 ON t2.id = t1.id WHERE t1.id = ?';
SET @id=1;
EXECUTE join_stmt USING @id;
v	w
one	uno
SET @id=2;
EXECUTE join_stmt USING @id;
v	w
two	dos
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
DEALLOCATE PREPARE join_stmt;
# in-query user-variable assignments remain unsupported for cached hits
FLUSH STATUS;
PREPARE assign_stmt FROM
'SELECT @pc4d_seen := v FROM pc4d_e1 WHERE id = ?';
SET @id=1;
EXECUTE assign_stmt USING @id;
@pc4d_seen := v
one
SET @id=2;
EXECUTE assign_stmt USING @id;
@pc4d_seen := v
two
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
DEALLOCATE PREPARE assign_stmt;
# set operations remain unsupported for cached hits
FLUSH STATUS;
PREPARE union_stmt FROM
'SELECT v AS out_col FROM pc4d_e1 WHERE id = ? UNION ALL SELECT w AS out_col FROM pc4d_e2 WHERE id = ?';
SET @id1=1, @id2=2;
EXECUTE union_stmt USING @id1, @id2;
out_col
dos
one
SET @id1=3, @id2=1;
EXECUTE union_stmt USING @id1, @id2;
out_col
three
uno
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
DEALLOCATE PREPARE union_stmt;
# temporary tables remain unsupported for cached hits
CREATE TEMPORARY TABLE pc4d_tmp (
id INT PRIMARY KEY,
v VARCHAR(16)
) ENGINE=InnoDB;
INSERT INTO pc4d_tmp VALUES
(1, 'tmp-one'),
(2, 'tmp-two');
FLUSH STATUS;
PREPARE tmp_stmt FROM 'SELECT v FROM pc4d_tmp WHERE id = ?';
SET @id=1;
EXECUTE tmp_stmt USING @id;
v
tmp-one
SET @id=2;
EXECUTE tmp_stmt USING @id;
v
tmp-two
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
DEALLOCATE PREPARE tmp_stmt;
DROP TEMPORARY TABLE pc4d_tmp;
DROP TABLE pc4d_e2;
DROP TABLE pc4d_e1;
SET SESSION rds_plan_cache=@old_rds_plan_cache;
