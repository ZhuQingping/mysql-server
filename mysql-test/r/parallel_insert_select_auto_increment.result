# Parallel Insert Select and Auto-increment 
# Placed in mysql-test/t/ because there should not be a diff between pq and non-pq
# case 1: Inserted-into table is very large from the start
# INSERT SELECT works on an already large table
# a) without ORDER BY
SET @saved_pq_support_features_switch = @@session.pq_support_features_switch;
set pq_support_features_switch='insert_select=on';
CREATE TABLE t1 (
c1 BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,
c2 BIGINT,
c3 VARCHAR(2048),
INDEX idx1(c2)) Engine=InnoDB;
INSERT INTO t1(c2, c3) VALUES
(1, REPEAT('a', 1024)),
(2, REPEAT('b', 1024)),
(3, REPEAT('c', 1024)),
(4, REPEAT('d', 1024)),
