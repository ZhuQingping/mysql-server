(62, REPEAT('d', 1024)),
(63, REPEAT('d', 1024)),
(64, REPEAT('d', 1024));
start transaction;
INSERT INTO t1(c2, c3) SELECT  c2+100,c3 FROM t1;
INSERT INTO t1(c2, c3) SELECT  c2+200,c3 FROM t1;
# without ORDER BY  on c1 in  INSERT INTO SELECT, 
# SELECT c1,c2 from t1 will return different values with and without pq
# but:
# the MIN and MAX value of the auto-increment counter should be the same 
# there should be as many rows with and without pq 
# The non auto-increment columns should be the same
select min(c1),max(c1),count(c1) from t1;
min(c1)	max(c1)	count(c1)
1	319	256
select c2 from t1 order by c2;
