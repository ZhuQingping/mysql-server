# case 2: As opposed to case 1, the inserted-into table is not large from the start,
# the successive INSERT SELECT will make it large. 
# a) without ORDER BY 
CREATE TABLE t1 (
c1 BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,
c2 BIGINT,
c3 VARCHAR(2048),
INDEX idx1(c2)) Engine=InnoDB;
INSERT INTO t1(c2, c3) VALUES
(1, REPEAT('a', 1024)),
(2, REPEAT('b', 1024)),
(3, REPEAT('c', 1024)),
(4, REPEAT('d', 1024));
start transaction;
INSERT INTO t1(c2, c3) SELECT  c2,c3 FROM t1;
INSERT INTO t1(c2, c3) SELECT  c2,c3 FROM t1;
INSERT INTO t1(c2, c3) SELECT  c2,c3 FROM t1;
INSERT INTO t1(c2, c3) SELECT  c2,c3 FROM t1;
INSERT INTO t1(c2, c3) SELECT  c2,c3 FROM t1;
# without ORDER BY  on c1 in  INSERT INTO SELECT,
# SELECT c1,c2 from t1 will return different values with and without pq
# but:
# the MIN and MAX value of the auto-increment counter should be the same 
# there should be as many rows with and without pq 
# The non auto-increment columns should be the same
select min(c1),max(c1),count(c1) from t1;
min(c1)	max(c1)	count(c1)
1	184	128
select c2 from t1 order by c2;
