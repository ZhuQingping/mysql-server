#
# non-reserved keyword PRODUCT_VERSION can be used as database name
#
CREATE DATABASE PRODUCT_VERSION;
DROP DATABASE PRODUCT_VERSION;
#
# non-reserved keyword PRODUCT_VERSION can be used as table name and colum name
#
CREATE TABLE PRODUCT_VERSION (PRODUCT_VERSION INT);
INSERT INTO PRODUCT_VERSION(PRODUCT_VERSION) VALUES (1);
SELECT PRODUCT_VERSION from PRODUCT_VERSION ORDER BY PRODUCT_VERSION;
PRODUCT_VERSION
1
DROP TABLE PRODUCT_VERSION;
#
# non-reserved keyword PRODUCT_VERSION can be used as procedure lable and user-defined variable name
#
CREATE TABLE t1 (PRODUCT_VERSION INT);
INSERT INTO t1 VALUES (1);
CREATE PROCEDURE p1()
BEGIN
DECLARE PRODUCT_VERSION INT;
SELECT max(t1.PRODUCT_VERSION) INTO PRODUCT_VERSION FROM t1;
SELECT PRODUCT_VERSION;
END|
CREATE PROCEDURE p2()
BEGIN
DECLARE n INT DEFAULT 2;
PRODUCT_VERSION: WHILE n > 0 DO 
SET n = n -1;
END WHILE PRODUCT_VERSION;
END|
CALL p1();
PRODUCT_VERSION
1
call p2();
DROP PROCEDURE p1;
DROP PROCEDURE p2;
DROP TABLE t1;
