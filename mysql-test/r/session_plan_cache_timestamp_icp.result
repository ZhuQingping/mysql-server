# Phase 4D-9: commercial 0010-like timestamp/time ICP boundary
CREATE TABLE pc4d_ti (
id INT PRIMARY KEY,
bigint_col BIGINT NOT NULL,
date_col DATE DEFAULT NULL,
timestamp_col TIMESTAMP(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
time_col TIME(6) DEFAULT NULL,
varchar_col VARCHAR(255) DEFAULT NULL,
KEY ts_time_idx(timestamp_col DESC, time_col DESC),
KEY ts_varchar_idx(timestamp_col DESC, varchar_col(4) DESC)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
