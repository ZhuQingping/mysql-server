SET @old_rds_plan_cache=@@SESSION.rds_plan_cache;
SET SESSION rds_plan_cache=ON;
# timestamp equality-like range with time ICP remains fallback
FLUSH STATUS;
EXPLAIN SELECT date_col, bigint_col FROM pc4d_ti FORCE INDEX (ts_time_idx)
WHERE time_col >= '07:59:59.000000'
    AND timestamp_col BETWEEN '1995-09-02 12:20:00.000000'
                          AND '1995-09-02 12:20:00.000000';
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	pc4d_ti	NULL	range	ts_time_idx	ts_time_idx	14	NULL	#	#	Using index condition
PREPARE timestamp_icp_stmt FROM
'SELECT date_col, bigint_col FROM pc4d_ti FORCE INDEX (ts_time_idx)
    WHERE time_col >= ?
      AND timestamp_col BETWEEN ''1995-09-02 12:20:00.000000'' AND ?';
SET @time_limit='07:59:59.000000';
SET @ts_high='1995-09-02 12:20:00.000000';
EXECUTE timestamp_icp_stmt USING @time_limit, @ts_high;
date_col	bigint_col
SET @time_limit='01:59:59.000000';
