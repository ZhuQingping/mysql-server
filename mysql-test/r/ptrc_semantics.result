CREATE VIEW ptrc_sem_v1 AS
SELECT (pk + 0) AS pk,
(col_int_key + 0) AS col_int_key,
CONCAT(col_varchar_key, '') AS col_varchar_key,
CONCAT(col_varchar_nokey, '') AS col_varchar_nokey
FROM ptrc_sem_view_t1;
EXPLAIN FORMAT=TREE SELECT alias2.col_varchar_nokey
FROM ptrc_sem_v1 AS alias1
RIGHT JOIN ptrc_sem_view_t1 AS alias2 ON TRUE
WHERE alias2.col_varchar_key IN
(SELECT /*+ PRC_SUBQUERY() */ sq1.col_varchar_nokey
FROM ptrc_sem_v1 AS sq1
WHERE sq1.pk != alias1.col_int_key
AND sq1.col_varchar_key > alias1.col_varchar_key)
ORDER BY alias2.pk, alias1.pk;
