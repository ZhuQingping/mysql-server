DROP TABLE ptrc_sem_c, ptrc_sem_cc;
# View-derived cache keys should be found correctly.
CREATE TABLE ptrc_sem_view_t1 (
pk INT NOT NULL AUTO_INCREMENT,
col_int_key INT NOT NULL,
col_varchar_key VARCHAR(1) NOT NULL,
col_varchar_nokey VARCHAR(1) NOT NULL,
PRIMARY KEY (pk),
KEY col_int_key (col_int_key),
KEY col_varchar_key (col_varchar_key, col_int_key)
) ENGINE=InnoDB;
INSERT INTO ptrc_sem_view_t1 VALUES
(1,0,'j','j'),(2,8,'v','v'),(3,1,'c','c'),
(4,8,'m','m'),(5,9,'d','d');
CREATE VIEW ptrc_sem_v1 AS SELECT * FROM ptrc_sem_view_t1;
EXPLAIN FORMAT=TREE SELECT alias2.col_varchar_nokey
FROM ptrc_sem_v1 AS alias1
RIGHT JOIN ptrc_sem_view_t1 AS alias2 ON TRUE
WHERE alias2.col_varchar_key IN
(SELECT /*+ PRC_SUBQUERY() */ sq1.col_varchar_nokey
FROM ptrc_sem_v1 AS sq1
WHERE sq1.pk != alias1.col_int_key
AND sq1.col_varchar_key > alias1.col_varchar_key)
ORDER BY alias2.pk, alias1.pk;
EXPLAIN
-> Sort: alias2.pk, pk
    -> Stream results  (...)
        -> Filter: <in_optimizer>(alias2.col_varchar_key,<exists>(select #2))  (...)
            -> Nested loop left join  (...)
                -> Table scan on alias2  (...)
                -> Result cache : cache keys(alias2.col_varchar_key, alias2.col_varchar_nokey, alias2.pk)  (...)
                    -> Index scan on ptrc_sem_view_t1 using col_varchar_key  (...)
            -> Select #2 (subquery in condition; dependent)
                -> Result cache : cache keys(alias2.col_varchar_key, ptrc_sem_view_t1.col_int_key, ptrc_sem_view_t1.col_varchar_key)
                    -> Limit: 1 row(s)  (...)
                        -> Filter: ((ptrc_sem_view_t1.pk <> ptrc_sem_view_t1.col_int_key) and (ptrc_sem_view_t1.col_varchar_key > ptrc_sem_view_t1.col_varchar_key) and (<cache>(alias2.col_varchar_key) = ptrc_sem_view_t1.col_varchar_nokey))  (...)
                            -> Table scan on ptrc_sem_view_t1  (...)

Warnings:
Note	1276	Field or reference 'alias1.col_int_key' of SELECT #2 was resolved in SELECT #1
Note	1276	Field or reference 'alias1.col_varchar_key' of SELECT #2 was resolved in SELECT #1
SELECT alias2.col_varchar_nokey
FROM ptrc_sem_v1 AS alias1
RIGHT JOIN ptrc_sem_view_t1 AS alias2 ON TRUE
