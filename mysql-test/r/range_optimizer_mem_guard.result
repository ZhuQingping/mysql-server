#
# Range optimizer should not materialize excessive QUICK_RANGE objects.
#
DROP TABLE IF EXISTS t_range_mem_guard;
DROP TABLE IF EXISTS seq_range_mem_guard;
CREATE TABLE seq_range_mem_guard(n INT PRIMARY KEY);
SET SESSION cte_max_recursion_depth=1100;
INSERT INTO seq_range_mem_guard
WITH RECURSIVE cte(n) AS (
SELECT 1
UNION ALL
SELECT n + 1 FROM cte WHERE n < 1024
)
SELECT n FROM cte;
CREATE TABLE t_range_mem_guard (
id INT NOT NULL,
c1 VARCHAR(32) COLLATE utf8mb4_general_ci NOT NULL,
c2 INT NOT NULL,
c3 VARCHAR(32) COLLATE utf8mb4_general_ci NOT NULL,
c4 VARCHAR(32) COLLATE utf8mb4_general_ci NOT NULL,
c5 VARCHAR(32) COLLATE utf8mb4_general_ci NOT NULL,
payload VARCHAR(16),
PRIMARY KEY(id),
KEY k1(c1, c2, c3 DESC, c4 DESC, c5 DESC)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
INSERT INTO t_range_mem_guard
SELECT (a.n - 1) * 64 + b.n,
'x',
1,
CONCAT('a', LPAD(a.n, 5, '0')),
CONCAT('b', LPAD(b.n, 5, '0')),
CONCAT('z', LPAD(b.n, 5, '0')),
'p'
FROM seq_range_mem_guard a
JOIN seq_range_mem_guard b
WHERE a.n <= 128 AND b.n <= 64;
ANALYZE TABLE t_range_mem_guard;
Table	Op	Msg_type	Msg_text
test.t_range_mem_guard	analyze	status	OK
SET SESSION group_concat_max_len=1024 * 1024;
SET SESSION range_optimizer_max_mem_size=8388608;
SELECT GROUP_CONCAT(QUOTE(CONCAT('a', LPAD(n, 5, '0'))) ORDER BY n)
INTO @c3_values
FROM seq_range_mem_guard;
SELECT GROUP_CONCAT(QUOTE(CONCAT('b', LPAD(n, 5, '0'))) ORDER BY n)
INTO @c4_values
FROM seq_range_mem_guard;
SET @range_mem_guard_sql=CONCAT(
'EXPLAIN SELECT * FROM t_range_mem_guard FORCE INDEX(k1) ',
'WHERE c1 = ''x'' AND c2 = 1 ',
'AND c3 IN (', @c3_values, ') ',
'AND c4 IN (', @c4_values, ') ',
'ORDER BY c3 DESC, c4 DESC, c5 DESC'
);
SELECT COUNT(*) AS table_rows,
1024 * 1024 AS expected_range_count
FROM t_range_mem_guard;
table_rows	expected_range_count
8192	1048576
PREPARE range_mem_guard_stmt FROM @range_mem_guard_sql;
EXECUTE range_mem_guard_stmt;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t_range_mem_guard	NULL	index	k1	k1	524	NULL	#	100.00	Using where
SHOW WARNINGS LIMIT 1;
Level	Code	Message
Warning	3170	Memory capacity of 8388608 bytes for 'range_optimizer_max_mem_size' exceeded. Range optimization was not done for this query.
DEALLOCATE PREPARE range_mem_guard_stmt;
SET SESSION range_optimizer_max_mem_size=DEFAULT;
SET SESSION group_concat_max_len=DEFAULT;
SET SESSION cte_max_recursion_depth=DEFAULT;
DROP TABLE t_range_mem_guard;
DROP TABLE seq_range_mem_guard;
