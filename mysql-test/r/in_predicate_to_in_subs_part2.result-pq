#
# MDEV-14835: conversion to TVC with BIGINT or YEAR values
#
SET @@rds_in_predicate_conversion_threshold= 2;
CREATE TABLE t1 (a BIGINT, index idx(a));
CREATE TABLE t2 (y YEAR, index idx(y));
INSERT INTO t1 VALUES (1), (2), (3);
INSERT INTO t2 VALUES (2009), (2010), (2011);
SELECT * FROM t1 WHERE a IN ('1','5','3');
a
1
3
SELECT * FROM t2 WHERE y IN ('2009','2011');
y
2009
2011
DROP TABLE t1,t2;
SET @@rds_in_predicate_conversion_threshold= default;
