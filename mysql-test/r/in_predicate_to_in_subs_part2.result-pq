#
# MDEV-27937: Prepared statement with ? in the list if IN predicate
#
set rds_in_predicate_conversion_threshold=2;
create table t1 (id int, a int, b int, index idx(a));
insert into t1 values (1,3,30), (2,7,70), (3,1,10);
prepare stmt from "
select * from t1 where a in (7, ?, 5, 1);
";
set @var=3;
execute stmt using @var;
id	a	b
1	3	30
2	7	70
3	1	10
deallocate prepare stmt;
prepare stmt from "
select * from t1 where (a,b) in ((7,70), (3,?), (5,50), (1,10));
";
set @var=30;
execute stmt using @var;
id	a	b
1	3	30
2	7	70
3	1	10
deallocate prepare stmt;
drop table t1;
