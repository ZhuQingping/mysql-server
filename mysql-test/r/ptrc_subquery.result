# PTRC correlated subquery runtime smoke
SET @saved_optimizer_switch=@@optimizer_switch;
SET optimizer_switch='partial_result_cache=off,hash_join=off,batched_key_access=off,semijoin=off,materialization=off';
CREATE TABLE ptrc_sq_outer (
id INT PRIMARY KEY,
k INT NULL,
grp INT NOT NULL,
KEY(k),
KEY(grp)
) ENGINE=InnoDB;
CREATE TABLE ptrc_sq_inner (
k INT PRIMARY KEY,
v INT NULL,
KEY(k)
) ENGINE=InnoDB;
CREATE TABLE ptrc_sq_values (
grp INT NOT NULL,
val INT NULL,
KEY(grp)
) ENGINE=InnoDB;
INSERT INTO ptrc_sq_outer VALUES
(1, 1, 10), (2, 2, 20), (3, 1, 10),
(4, 3, 30), (5, 4, 40), (6, NULL, 50);
INSERT INTO ptrc_sq_inner VALUES
(1, 100), (2, 200), (3, NULL), (5, 500);
INSERT INTO ptrc_sq_values VALUES
(10, 1), (10, NULL), (20, NULL), (30, 9), (50, NULL);
# PRC_SUBQUERY should force a deterministic correlated scalar subquery when the switch is off.
EXPLAIN FORMAT=TREE
SELECT o.id,
(SELECT /*+ PRC_SUBQUERY() */ i.v
FROM ptrc_sq_inner AS i
WHERE i.k = o.k) AS scalar_v
FROM ptrc_sq_outer AS o
ORDER BY o.id;
EXPLAIN
-> Index scan on o using PRIMARY  (...)
-> Select #2 (subquery in projection; dependent)
    -> Result cache : cache keys(o.k)
        -> Single-row index lookup on i using PRIMARY (k=o.k)  (...)

Warnings:
Note	1276	Field or reference 'test.o.k' of SELECT #2 was resolved in SELECT #1
SET optimizer_switch='partial_result_cache=on,hash_join=off,batched_key_access=off,semijoin=off,materialization=off';
# NO_PRC_SUBQUERY should keep the original dependent subquery path.
EXPLAIN FORMAT=TREE
SELECT o.id,
(SELECT /*+ NO_PRC_SUBQUERY() */ i.v
FROM ptrc_sq_inner AS i
WHERE i.k = o.k) AS scalar_v
FROM ptrc_sq_outer AS o
ORDER BY o.id;
EXPLAIN
-> Index scan on o using PRIMARY  (...)
-> Select #2 (subquery in projection; dependent)
    -> Single-row index lookup on i using PRIMARY (k=o.k)  (...)

Warnings:
Note	1276	Field or reference 'test.o.k' of SELECT #2 was resolved in SELECT #1
# PRC_SUBQUERY should also wrap IN subqueries so was_null state is cached.
SET optimizer_switch='partial_result_cache=off,hash_join=off,batched_key_access=off,semijoin=off,materialization=off';
EXPLAIN FORMAT=TREE
SELECT o.id,
o.k IN (SELECT /*+ PRC_SUBQUERY() */ v.val
FROM ptrc_sq_values AS v
WHERE v.grp = o.grp) AS in_flag
FROM ptrc_sq_outer AS o
ORDER BY o.id;
EXPLAIN
-> Index scan on o using PRIMARY  (...)
-> Select #2 (subquery in projection; dependent)
    -> Result cache : cache keys(o.grp, o.k)
        -> Limit: 1 row(s)  (...)
            -> Filter: <if>(outer_field_is_not_null, <is_not_null_test>(v.val), true)  (...)
                -> Filter: <if>(outer_field_is_not_null, ((<cache>(o.k) = v.val) or (v.val is null)), true)  (...)
                    -> Index lookup on v using grp (grp=o.grp)  (...)

Warnings:
Note	1276	Field or reference 'test.o.grp' of SELECT #2 was resolved in SELECT #1
# Set-operation subqueries are unsupported in Phase 6 and must fall back.
EXPLAIN FORMAT=TREE
SELECT o.id,
(SELECT /*+ PRC_SUBQUERY() */ i.v
FROM ptrc_sq_inner AS i
WHERE i.k = o.k
UNION ALL
SELECT i.v
FROM ptrc_sq_inner AS i
WHERE i.k = o.k AND i.k < 0) AS union_v
FROM ptrc_sq_outer AS o
ORDER BY o.id;
EXPLAIN
-> Index scan on o using PRIMARY  (...)
-> Select #2 (subquery in projection; dependent)
    -> Append  (...)
        -> Stream results  (...)
            -> Single-row index lookup on i using PRIMARY (k=o.k)  (...)
        -> Stream results  (...)
            -> Filter: (i.k < 0)  (...)
                -> Single-row index lookup on i using PRIMARY (k=o.k)  (...)

Warnings:
Note	1276	Field or reference 'test.o.k' of SELECT #2 was resolved in SELECT #1
Note	1276	Field or reference 'test.o.k' of SELECT #3 was resolved in SELECT #1
# Scalar subquery results should be preserved with repeated outer keys.
SELECT o.id, o.k,
(SELECT /*+ PRC_SUBQUERY() */ i.v
FROM ptrc_sq_inner AS i
WHERE i.k = o.k) AS scalar_v
FROM ptrc_sq_outer AS o
ORDER BY o.id;
id	k	scalar_v
1	1	100
2	2	200
3	1	100
4	3	NULL
5	4	NULL
6	NULL	NULL
# IN subquery NULL and no-match semantics should be preserved.
SELECT o.id, o.k, o.grp,
o.k IN (SELECT /*+ PRC_SUBQUERY() */ v.val
FROM ptrc_sq_values AS v
WHERE v.grp = o.grp) AS in_flag
FROM ptrc_sq_outer AS o
ORDER BY o.id;
id	k	grp	in_flag
1	1	10	1
2	2	20	NULL
3	1	10	1
4	3	30	0
5	4	40	0
6	NULL	50	NULL
# Unsupported set-operation subqueries should still preserve results.
SELECT o.id, o.k,
(SELECT /*+ PRC_SUBQUERY() */ i.v
FROM ptrc_sq_inner AS i
WHERE i.k = o.k
UNION ALL
SELECT i.v
FROM ptrc_sq_inner AS i
WHERE i.k = o.k AND i.k < 0) AS union_v
FROM ptrc_sq_outer AS o
ORDER BY o.id;
id	k	union_v
1	1	100
2	2	200
3	1	100
4	3	NULL
5	4	NULL
6	NULL	NULL
DROP TABLE ptrc_sq_values, ptrc_sq_inner, ptrc_sq_outer;
SET optimizer_switch=@saved_optimizer_switch;
