# Test DD Upgrade
# Run the server with:
#   --initialize-insecure
# 1.3 Restart the server against DDIR - should succeed.
SET SESSION debug= '+d,skip_dd_table_access_check';
SET SESSION debug= '-d,skip_dd_table_access_check';
DD_VERSION=80023
TAURUS_EXTENDED_DD_VERSION=2
# restart failed
# Kill the server
Pattern "Data dictionary upgrade prohibited by the command line option '--no_dd_upgrade'" found
SET SESSION debug= '+d,skip_dd_table_access_check';
SET SESSION debug= '-d,skip_dd_table_access_check';
DD_VERSION=80023
TAURUS_EXTENDED_DD_VERSION=98
include/assert_grep.inc [DD upgraded.]
# restart failed
# Kill the server
Pattern "Downgrade of the extended data dictionary version TAURUS_EXTENDED_DD_VERSION is not supported" found
# Clean up
#
# Cleanup: Restarting the server against default datadir.
