CREATE TABLE t1 (a INT , b INT , c INT , INDEX(a,b,c));
INSERT INTO t1 VALUES (1,100,1),(2,200,1),(3,300,1),(4,10,2),(5,20,2),(6,30,2),(7,110,3),(8,120,3),(9,130,3);
CREATE TABLE t2 (a INT , b INT , c INT , INDEX(a,b,c));
INSERT INTO t2 VALUES (1,110,1),(2,210,1),(4,20,2),(5,30,2),(7,130,3),(8,140,3);
# Subqueries
# Offset pushdown is evaluated for each JOIN object and can therefore be applied to subqueries if a given JOIN object does qualify for OP.
# Both explain  format=tree and actual query output are given since the feature is activated  -- easier to maintain if outputs are produced
# Uncorrelated
# Inner query with LIMIT OFFSET
explain format=tree SELECT * FROM t1 WHERE a > (SELECT a FROM t1 LIMIT 1 OFFSET 1);
EXPLAIN
-> Filter: (t1.a > (select #2))  (cost=*** rows=***)
    -> Covering index range scan on t1 using a over (2 < a)  (cost=*** rows=***)
    -> Select #2 (subquery in condition; run only once)
        -> Limit/Offset: 1/1 row(s), with offset pushdown  (cost=*** rows=***)
            -> Covering index scan on t1 using a  (cost=*** rows=***)

SELECT * FROM t1 WHERE a > (SELECT a FROM t1 LIMIT 1 OFFSET 1);
a	b	c
3	300	1
4	10	2
5	20	2
6	30	2
7	110	3
8	120	3
9	130	3
explain format=tree SELECT * FROM t1 WHERE a > (SELECT a FROM t1 WHERE a>2 LIMIT 1 OFFSET 1);
EXPLAIN
-> Filter: (t1.a > (select #2))  (cost=*** rows=***)
    -> Covering index range scan on t1 using a over (4 < a)  (cost=*** rows=***)
    -> Select #2 (subquery in condition; run only once)
        -> Limit/Offset: 1/1 row(s), with offset pushdown  (cost=*** rows=***)
            -> Covering index range scan on t1 using a over (2 < a)  (cost=*** rows=***)

SELECT * FROM t1 WHERE a > (SELECT a FROM t1 WHERE a>2 LIMIT 1 OFFSET 1);
a	b	c
5	20	2
6	30	2
7	110	3
8	120	3
9	130	3
# Offset pushdown outer query
# add row for non empty output of following SELECT statement
INSERT INTO t1 values (9,131,1);
explain format=tree SELECT * FROM t1 WHERE a = (SELECT max(a) FROM t1 WHERE a > 2) LIMIT 1 OFFSET 1;
EXPLAIN
-> Limit/Offset: 1/1 row(s), with offset pushdown  (cost=*** rows=***)
    -> Covering index lookup on t1 using a (a=(select #2))  (cost=*** rows=***)
        -> Select #2 (subquery in reference key of index access; run only once)
            -> Rows fetched before execution  (cost=*** rows=***)

SELECT * FROM t1 WHERE a = (SELECT max(a) FROM t1 WHERE a > 2) LIMIT 1 OFFSET 1;
a	b	c
9	131	1
DELETE FROM t1 WHERE a=9 AND b=131 AND c=3;
# DOUBLE offset pushdown , both inner and outer queries with LIMIT OFFSET
# add row for non empty output of following SELECT statement
INSERT INTO t1 values (4,10,3),(4,10,3),(4,10,3);
explain format=tree SELECT * FROM t1 WHERE a =(SELECT a FROM t1 WHERE a > 2 LIMIT 1 OFFSET 1) LIMIT 2 OFFSET 3;
EXPLAIN
-> Limit/Offset: 2/3 row(s), with offset pushdown  (cost=*** rows=***)
    -> Covering index lookup on t1 using a (a=(select #2))  (cost=*** rows=***)
        -> Select #2 (subquery in reference key of index access; run only once)
            -> Limit/Offset: 1/1 row(s), with offset pushdown  (cost=*** rows=***)
                -> Covering index range scan on t1 using a over (2 < a)  (cost=*** rows=***)

SELECT * FROM t1 WHERE a = (SELECT a FROM t1 WHERE a > 2 LIMIT 1 OFFSET 1) LIMIT 2 OFFSET 3;
a	b	c
4	10	3
DELETE FROM t1 WHERE a=4 AND b=10 AND c=3;
# Correlated was covered before
# SHOW that JOIN, SELF JOIN do not trigger offset pushdown
explain format=tree SELECT * FROM t1 JOIN t2 LIMIT 1 OFFSET 1;
EXPLAIN
-> Limit/Offset: 1/1 row(s)  (cost=*** rows=***)
    -> Inner hash join (no condition)  (cost=*** rows=***)
        -> Index scan on t1 using a  (cost=*** rows=***)
        -> Hash
            -> Index scan on t2 using a  (cost=*** rows=***)

explain format=tree SELECT * FROM t1 T1, t1 T2 LIMIT 2 OFFSET 10;
EXPLAIN
-> Limit/Offset: 2/10 row(s)  (cost=*** rows=***)
    -> Inner hash join (no condition)  (cost=*** rows=***)
        -> Index scan on T2 using a  (cost=*** rows=***)
        -> Hash
            -> Index scan on T1 using a  (cost=*** rows=***)

# Table function are not compatible with offset pushdown
explain format=tree SELECT * FROM JSON_TABLE('[{"x":2,"y":"8"},{"x":"3","y":"7"},{"x":"4","y":6}]',"$[1]" COLUMNS(xval VARCHAR(100) PATH "$.x", yval VARCHAR(100) PATH "$.y")) AS jt1 LIMIT 100 OFFSET 1;
EXPLAIN
-> Limit/Offset: 100/1 row(s)
    -> Materialize table function

DROP TABLE t1,t2;
# OFFSET exceeds number of rows: When the offset exceed the number of rows returned by the query without offset, offset pushdown still works
CREATE TABLE t1 (a INT, b INT , INDEX(a,b));
INSERT INTO t1 VALUES (1,1),(2,2),(3,4),(8,9);
EXPLAIN format=tree SELECT * FROM t1 LIMIT 1 OFFSET 5;
EXPLAIN
-> Limit/Offset: 1/5 row(s), with offset pushdown  (cost=*** rows=***)
    -> Index scan on t1 using a  (cost=*** rows=***)

SET @save_skipped_rows = (SELECT variable_value FROM performance_schema.global_status WHERE LOWER(variable_name) = 'innodb_rds_rows_skipped_by_offset_pushdown');
SELECT * FROM t1 LIMIT 1 OFFSET 5;
a	b
SELECT variable_value - @save_skipped_rows FROM performance_schema.global_status WHERE LOWER(variable_name) = 'innodb_rds_rows_skipped_by_offset_pushdown';
variable_value - @save_skipped_rows
4
DROP TABLE t1;
#  BUG2023021303672
# failed on assert
# Reason: using qep_tab which points to qep_tab[0] instead of qep_tab[const_table]
# Why: Oversight
CREATE TABLE t0 (c0 INT);
CREATE TABLE t2 (c1 INT PRIMARY KEY);
SELECT 1 FROM t0 LEFT JOIN t2 ON c1 = NULL LIMIT 1 OFFSET 1;
1
drop table t0,t2;
# BUG BUG2023021303643
# failed on assert:
# assert(query_expression()->is_simple() || query_block != query_expression()->global_parameters());
# Reason: materialized table written to disk - materialized tables were filtered by looking at whether it was an innodb table
# Query was a candidate for offset pushdown even though it should not have been.
SET SESSION BIG_TABLES = 1;
explain format=tree   (SELECT 1) UNION (SELECT 1) LIMIT 1 OFFSET 1;
EXPLAIN
-> Limit/Offset: 1/1 row(s)  (cost=1.2..1.2 rows=1)
    -> Table scan on <union temporary>  (cost=0.7..1.2 rows=2)
        -> Union materialize with deduplication  (cost=0.2..0.2 rows=2)
            -> Limit table size: 2 unique row(s)
                -> Rows fetched before execution  (cost=0..0 rows=1)
            -> Limit table size: 2 unique row(s)
                -> Rows fetched before execution  (cost=0..0 rows=1)

(SELECT 1) UNION (SELECT 1) LIMIT 1 OFFSET 1;
1
# Table function
# Offset pushdown not compatible
# table functions is an intrinsic table
# Reads rows using row_search_no_mvcc
# No support for offset pushdown in row_search_no_mvcc
explain format=tree SELECT *
FROM
JSON_TABLE(
'[{"x":2,"y":"8"},{"x":"3","y":"7"},{"x":"4","y":6}]',
"$[*]" COLUMNS(
xval VARCHAR(100) PATH "$.x",
yval VARCHAR(100) PATH "$.y"
         )
) AS  jt LIMIT 1 OFFSET 1;
EXPLAIN
-> Limit/Offset: 1/1 row(s)
    -> Materialize table function

SELECT * FROM JSON_TABLE(
'[{"x":2,"y":"8"},{"x":"3","y":"7"},{"x":"4","y":6}]',
"$[*]" COLUMNS(
xval VARCHAR(100) PATH "$.x",
yval VARCHAR(100) PATH "$.y"
         )
) AS  jt LIMIT 1 OFFSET 1;
xval	yval
3	7
SET SESSION BIG_TABLES =default;
CREATE TABLE employees (
id INT PRIMARY KEY AUTO_INCREMENT,
name VARCHAR(100),
department_id INT,
salary DECIMAL(10,2),
INDEX idx_department_id (department_id)
);
INSERT INTO employees (name, department_id, salary) VALUES
('John', 10, 5000.00),
('Jane', 20, 6000.00),
('Bob', 10, 7000.00),
('Alice', 30, 8000.00),
('Tom', 20, 9000.00);
SET @orig_optimizer_switch = @@optimizer_switch;
SET optimizer_switch = 'mrr=on,mrr_cost_based=off';
EXPLAIN  SELECT * FROM employees  WHERE department_id <30 limit 2 offset 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	employees	NULL	range	idx_department_id	idx_department_id	5	NULL	4	100.00	Using MRR
Warnings:
Note	1003	/* select#1 */ select `test`.`employees`.`id` AS `id`,`test`.`employees`.`name` AS `name`,`test`.`employees`.`department_id` AS `department_id`,`test`.`employees`.`salary` AS `salary` from `test`.`employees` where (`test`.`employees`.`department_id` < 30) limit 1,2
SELECT * FROM employees  WHERE department_id < 30 limit 2 offset 1;
id	name	department_id	salary
2	Jane	20	6000.00
3	Bob	10	7000.00
SET optimizer_switch = @orig_optimizer_switch;
DROP table employees;
