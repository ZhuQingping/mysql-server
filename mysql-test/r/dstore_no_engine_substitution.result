#
# BUG2025092025863: create table ... as select * from ... using wrong engine
#
# Restart the server using ONLY_DSTORE engine mode
SET SQL_MODE='';
CREATE TABLE MyISAM_2_Dstore(i int) ENGINE=MyISAM;
Warnings:
Warning	3161	Storage engine MyISAM is disabled (Table creation is disallowed).
Warning	1266	Using storage engine Dstore for table 'MyISAM_2_Dstore'
SHOW CREATE TABLE MyISAM_2_Dstore;
Table	Create Table
MyISAM_2_Dstore	CREATE TABLE `MyISAM_2_Dstore` (
  `i` int DEFAULT NULL
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
CREATE TABLE InnoDB_2_Dstore ENGINE=InnoDB AS SELECT * FROM MyISAM_2_Dstore;
Warnings:
Warning	3161	Storage engine InnoDB is disabled (Table creation is disallowed).
Warning	1266	Using storage engine Dstore for table 'InnoDB_2_Dstore'
SHOW CREATE TABLE InnoDB_2_Dstore;
Table	Create Table
InnoDB_2_Dstore	CREATE TABLE `InnoDB_2_Dstore` (
  `i` int DEFAULT NULL
) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE MyISAM_2_Dstore;
DROP TABLE InnoDB_2_Dstore;
# restart
