# Test 2:client modify transaction_isolation
create user user_BUG2025092929952_common@localhost;
create user user_BUG2025092929952_super@localhost;
grant super on *.* TO user_BUG2025092929952_super@localhost;
Warnings:
Warning	1287	The SUPER privilege identifier is deprecated
SHOW VARIABLES LIKE 'storage_engine_mode';
Variable_name	Value
storage_engine_mode	ONLY_INNODB
# Test 2.1:when storage_engine_mode == ONLY_INNODB
# common user
show variables like "%transaction_isolation%";
Variable_name	Value
transaction_isolation	REPEATABLE-READ
set session transaction_isolation = 'READ-UNCOMMITTED';
show variables like "%transaction_isolation%";
Variable_name	Value
transaction_isolation	READ-UNCOMMITTED
set session transaction_isolation = 'READ-COMMITTED';
show variables like "%transaction_isolation%";
Variable_name	Value
transaction_isolation	READ-COMMITTED
set session transaction_isolation = 'REPEATABLE-READ';
set global transaction_isolation = 'REPEATABLE-READ';
ERROR 42000: Access denied; you need (at least one of) the SUPER or SYSTEM_VARIABLES_ADMIN privilege(s) for this operation
show variables like "%transaction_isolation%";
Variable_name	Value
transaction_isolation	REPEATABLE-READ
set session transaction_isolation = 'SERIALIZABLE';
show variables like "%transaction_isolation%";
Variable_name	Value
transaction_isolation	SERIALIZABLE
# super user
show variables like "%transaction_isolation%";
Variable_name	Value
transaction_isolation	REPEATABLE-READ
set session transaction_isolation = 'READ-UNCOMMITTED';
show variables like "%transaction_isolation%";
Variable_name	Value
transaction_isolation	READ-UNCOMMITTED
set session transaction_isolation = 'READ-COMMITTED';
show variables like "%transaction_isolation%";
Variable_name	Value
transaction_isolation	READ-COMMITTED
set session transaction_isolation = 'REPEATABLE-READ';
show variables like "%transaction_isolation%";
Variable_name	Value
transaction_isolation	REPEATABLE-READ
set session transaction_isolation = 'SERIALIZABLE';
show variables like "%transaction_isolation%";
Variable_name	Value
transaction_isolation	SERIALIZABLE
