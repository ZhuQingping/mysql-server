2	SUBQUERY	tinytable	NULL	index	NULL	a	5	NULL	3	100.00	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`tinytable`.`a` AS `a` from `test`.`tinytable` where (`test`.`tinytable`.`a` = (/* select#2 */ select 0.29 from `test`.`tinytable` limit 1))
select * from tinytable where a = (select 0.29 from tinytable limit 1);
