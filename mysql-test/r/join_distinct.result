#
# test case: this optimization only support:
#            - nested loop inner join + distinct
#            - nested loop outer join + distinct
#            do not support:
#            - nested loop semi join + distinct
#            - nested loop anti join + distinct
#            - hash join + distinct
#            - batched key access + distinct
#
CREATE TABLE t1(a INT);
INSERT INTO t1 VALUES(0),(1),(2),(5),(6);
INSERT INTO t1 VALUES(0),(1),(2),(5),(6);
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
# Optimization work for nested loop inner join + distinct
SET optimizer_switch='block_nested_loop=OFF';
# with optimization, handler_read status
SET optimizer_switch="nlj_distinct_optimize=ON";
EXPLAIN FORMAT=TREE SELECT DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 1 = tt3.a JOIN t1 AS tt4 ON tt3.a=tt4.a ORDER BY 1;
EXPLAIN
-> Sort: tt1.a
    -> Table scan on <temporary>  (cost=X rows=X)
        -> Temporary table with deduplication  (cost=X rows=X)
            -> Nested loop inner join with distinct optimization  (cost=X rows=X)
                -> Nested loop inner join with distinct optimization  (cost=X rows=X)
                    -> Nested loop inner join with distinct optimization  (cost=X rows=X)
                        -> Table scan on tt1  (cost=X rows=X)
                        -> Table scan on tt2  (cost=X rows=X)
                    -> Filter: ((tt2.a + 1) = tt3.a)  (cost=X rows=X)
                        -> Table scan on tt3  (cost=X rows=X)
                -> Limit: 1 row(s)  (cost=X rows=X)
                    -> Filter: (tt4.a = tt3.a)  (cost=X rows=X)
                        -> Table scan on tt4  (cost=X rows=X)

FLUSH STATUS;
SELECT DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 1 = tt3.a JOIN t1 AS tt4 ON tt3.a=tt4.a ORDER BY 1;
