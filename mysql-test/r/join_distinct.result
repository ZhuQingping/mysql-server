# Customer encounter performance regression for "Multi-join + distinct" scenario
# when they upgrade from MySQL 5.7 to GaussDB(for MySQL) 8.0.22. The reason is
# that MySQL 8.0 (>=8.0.16) new Volcano iterator executor do not apply distinct
# optimization for this scenario, even if optimizer already mark "Distinct".
# Refer to MySQL old version (5.7) optimization ideas, we can stop scan nested
# loop join inner table when find out one new matched record. We introduce new
# optimizer switch variable "nlj_distinct_optimize" to enable/disable this optimization.
#
# test case: session level hint updateable optimizer switch variable "nlj_distinct_optimize"
#
SELECT @@optimizer_switch;
@@optimizer_switch
index_merge=on,index_merge_union=on,index_merge_sort_union=on,index_merge_intersection=on,engine_condition_pushdown=on,index_condition_pushdown=on,mrr=on,mrr_cost_based=on,block_nested_loop=on,batched_key_access=off,materialization=on,semijoin=on,loosescan=on,firstmatch=on,duplicateweedout=on,subquery_materialization_cost_based=on,use_index_extensions=on,condition_fanout_filter=on,derived_merge=on,use_invisible_indexes=off,skip_scan=on,hash_join=on,subquery_to_derived=off,prefer_ordering_index=on,hypergraph_optimizer=off,derived_condition_pushdown=on,dstore_use_histogram_range_estimation=on,simplify_count_not_null=on,offset_pushdown=on,nlj_distinct_optimize=on,partial_result_cache=on,left_join_elimination=on,dstore_enable_indexscan=on,aggregate_pushdown=on
SET @origin_optimizer_switch=@@optimizer_switch;
SET @origin_dstore_use_histogram_auto_update=@@global.dstore_use_histogram_auto_update;
SET GLOBAL dstore_use_histogram_auto_update=OFF;
SET SESSION optimizer_switch="nlj_distinct_optimize=ON";
SELECT LOCATE('nlj_distinct_optimize=on', @@session.optimizer_switch);
LOCATE('nlj_distinct_optimize=on', @@session.optimizer_switch)
645
SET SESSION optimizer_switch="nlj_distinct_optimize=OFF";
SELECT LOCATE('nlj_distinct_optimize=off', @@session.optimizer_switch);
LOCATE('nlj_distinct_optimize=off', @@session.optimizer_switch)
645
SET @origin_global_optimizer_switch=@@global.optimizer_switch;
SET GLOBAL optimizer_switch="nlj_distinct_optimize=ON";
SELECT LOCATE('nlj_distinct_optimize=on', @@global.optimizer_switch);
LOCATE('nlj_distinct_optimize=on', @@global.optimizer_switch)
645
SET GLOBAL optimizer_switch="nlj_distinct_optimize=OFF";
SELECT LOCATE('nlj_distinct_optimize=off', @@global.optimizer_switch);
LOCATE('nlj_distinct_optimize=off', @@global.optimizer_switch)
645
SELECT/*+ SET_VAR(optimizer_switch="nlj_distinct_optimize=ON") */ LOCATE('nlj_distinct_optimize=on', @@session.optimizer_switch);
LOCATE('nlj_distinct_optimize=on', @@session.optimizer_switch)
645
SELECT/*+ SET_VAR(optimizer_switch="nlj_distinct_optimize=OFF") */ LOCATE('nlj_distinct_optimize=off', @@session.optimizer_switch);
LOCATE('nlj_distinct_optimize=off', @@session.optimizer_switch)
645
#
# test case: we can check this optimization worked by explain format=tree or explain analyze.
#            "Nested loop inner join distinct" and "Nested loop left join distinct" means
#            distinct optimization worked. Explain traditional and json format can not help
#            to check the optimization work or not.
#
CREATE TABLE t1(a INT);
INSERT INTO t1 VALUES(1),(2),(5),(6);
INSERT INTO t1 VALUES(1),(2),(5),(6);
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
SET optimizer_switch='block_nested_loop=OFF';
EXPLAIN SELECT/*+ SET_VAR(optimizer_switch="nlj_distinct_optimize=ON") */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	tt1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using temporary
1	SIMPLE	tt2	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Distinct
1	SIMPLE	tt3	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Distinct
Warnings:
Note	1003	/* select#1 */ select /*+ SET_VAR(optimizer_switch='nlj_distinct_optimize=ON') */ distinct `test`.`tt1`.`a` AS `a` from `test`.`t1` `tt1` join `test`.`t1` `tt2` join `test`.`t1` `tt3` where ((`test`.`tt2`.`a` + 3) = `test`.`tt3`.`a`)
EXPLAIN SELECT/*+ SET_VAR(optimizer_switch="nlj_distinct_optimize=OFF") */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	tt1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using temporary
1	SIMPLE	tt2	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Distinct
1	SIMPLE	tt3	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Distinct
Warnings:
Note	1003	/* select#1 */ select /*+ SET_VAR(optimizer_switch='nlj_distinct_optimize=OFF') */ distinct `test`.`tt1`.`a` AS `a` from `test`.`t1` `tt1` join `test`.`t1` `tt2` join `test`.`t1` `tt3` where ((`test`.`tt2`.`a` + 3) = `test`.`tt3`.`a`)
EXPLAIN FORMAT=TREE SELECT/*+ SET_VAR(optimizer_switch="nlj_distinct_optimize=ON") */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
EXPLAIN
-> Table scan on <temporary>  (cost=X rows=X)
    -> Temporary table with deduplication  (cost=X rows=X)
        -> Nested loop inner join with distinct optimization  (cost=X rows=X)
            -> Nested loop inner join with distinct optimization  (cost=X rows=X)
                -> Table scan on tt1  (cost=X rows=X)
                -> Table scan on tt2  (cost=X rows=X)
            -> Limit: 1 row(s)  (cost=X rows=X)
                -> Filter: ((tt2.a + 3) = tt3.a)  (cost=X rows=X)
                    -> Table scan on tt3  (cost=X rows=X)

