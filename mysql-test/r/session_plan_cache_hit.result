# Phase 4C: minimal cached hit for prepared single-table SELECT
CREATE TABLE pc4c_t (c INT, v VARCHAR(16)) ENGINE=InnoDB;
INSERT INTO pc4c_t VALUES (10, 'ten'), (20, 'twenty'), (30, 'thirty');
SET SESSION rds_plan_cache=ON;
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
PREPARE stmt FROM 'SELECT v FROM pc4c_t WHERE c = ?';
SET @c=10;
EXECUTE stmt USING @c;
v
ten
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
SET @c=20;
EXECUTE stmt USING @c;
v
twenty
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	1
SET @c=30;
EXECUTE stmt USING @c;
v
thirty
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	2
DEALLOCATE PREPARE stmt;
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	2
DROP TABLE pc4c_t;
