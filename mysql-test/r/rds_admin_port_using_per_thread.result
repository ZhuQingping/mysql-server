# PREPARE
# create user without SUPER privileges.
CREATE USER 'user_without_service_admin'@'%' IDENTIFIED BY '123456';
GRANT SELECT ON *.* TO 'user_without_service_admin'@'%' WITH GRANT OPTION;
SHOW GRANTS FOR 'user_without_service_admin'@'%';
Grants for user_without_service_admin@%
GRANT SELECT ON *.* TO `user_without_service_admin`@`%` WITH GRANT OPTION
# create user with SERVICE_CONN_ADMIN privileges.
CREATE USER 'user_with_service_admin'@'%' IDENTIFIED BY '123456';
GRANT SELECT,SERVICE_CONNECTION_ADMIN ON *.* TO 'user_with_service_admin'@'%' WITH GRANT OPTION;
SHOW GRANTS FOR 'user_with_service_admin'@'%';
Grants for user_with_service_admin@%
GRANT SELECT ON *.* TO `user_with_service_admin`@`%` WITH GRANT OPTION
GRANT SERVICE_CONNECTION_ADMIN ON *.* TO `user_with_service_admin`@`%` WITH GRANT OPTION
SET @global_rds_admin_port_using_per_thread =  @@global.rds_admin_port_using_per_thread;
SET @global_threadpool_enabled =  @@global.threadpool_enabled;
# Test 1: when threadpool enable, rds_admin_port_using_per_thread
#         controls whether admin connection to use per thread.
set global threadpool_enabled=ON;
show variables like 'threadpool_enabled';
Variable_name	Value
threadpool_enabled	ON
show variables like 'rds_admin_port_using_per_thread';
Variable_name	Value
rds_admin_port_using_per_thread	OFF
SHOW GLOBAL STATUS LIKE 'Threads_connected';
Variable_name	Value
Threads_connected	1
SHOW GLOBAL STATUS LIKE 'THREADPOOL_ACTIVE_CONNECTIONS';
Variable_name	Value
Threadpool_active_connections	0
SHOW GLOBAL STATUS LIKE 'Threads_connected';
Variable_name	Value
Threads_connected	2
SHOW GLOBAL STATUS LIKE 'THREADPOOL_ACTIVE_CONNECTIONS';
Variable_name	Value
Threadpool_active_connections	1
SHOW GLOBAL STATUS LIKE 'Threads_connected';
Variable_name	Value
Threads_connected	3
SHOW GLOBAL STATUS LIKE 'THREADPOOL_ACTIVE_CONNECTIONS';
Variable_name	Value
Threadpool_active_connections	2
set global rds_admin_port_using_per_thread=ON;
SHOW GLOBAL STATUS LIKE 'Threads_connected';
Variable_name	Value
Threads_connected	4
SHOW GLOBAL STATUS LIKE 'THREADPOOL_ACTIVE_CONNECTIONS';
Variable_name	Value
Threadpool_active_connections	2
SHOW GLOBAL STATUS LIKE 'Threads_connected';
Variable_name	Value
Threads_connected	5
SHOW GLOBAL STATUS LIKE 'THREADPOOL_ACTIVE_CONNECTIONS';
Variable_name	Value
Threadpool_active_connections	3
# Test 2: when threadpool disable, normal connection and admin connection
#         can connect success.
set global threadpool_enabled=OFF;
SHOW GLOBAL STATUS LIKE 'Threads_connected';
Variable_name	Value
Threads_connected	6
SHOW GLOBAL STATUS LIKE 'THREADPOOL_ACTIVE_CONNECTIONS';
Variable_name	Value
Threadpool_active_connections	3
SHOW GLOBAL STATUS LIKE 'Threads_connected';
Variable_name	Value
Threads_connected	7
SHOW GLOBAL STATUS LIKE 'THREADPOOL_ACTIVE_CONNECTIONS';
Variable_name	Value
Threadpool_active_connections	3
set global rds_admin_port_using_per_thread=OFF;
SHOW GLOBAL STATUS LIKE 'Threads_connected';
Variable_name	Value
Threads_connected	8
SHOW GLOBAL STATUS LIKE 'THREADPOOL_ACTIVE_CONNECTIONS';
Variable_name	Value
Threadpool_active_connections	3
SHOW GLOBAL STATUS LIKE 'Threads_connected';
Variable_name	Value
Threads_connected	9
SHOW GLOBAL STATUS LIKE 'THREADPOOL_ACTIVE_CONNECTIONS';
Variable_name	Value
Threadpool_active_connections	3
connect(127.0.0.1,user_with_service_admin,123456,mysql,1501,MYSQL_SOCK);
ERROR HY000: Too many connections
# Cleanup
SET @@global.rds_admin_port_using_per_thread = @global_rds_admin_port_using_per_thread;
SET @@global.threadpool_enabled = @global_threadpool_enabled;
DROP USER user_without_service_admin, user_with_service_admin;
