#
# BUG2025082924708: ASAN: HEAP-USE-AFTER-FREE IN Item_default_value::bind_fields ON FIRST EXECUTION
#
CREATE TABLE t1 (
id int NOT NULL,
bigint_field bigint DEFAULT NULL
);
PREPARE stmt0 FROM 'SELECT DEFAULT(bigint_field) FROM t1';
EXECUTE stmt0;
DEFAULT(bigint_field)
EXECUTE stmt0;
DEFAULT(bigint_field)
EXECUTE stmt0;
DEFAULT(bigint_field)
DEALLOCATE PREPARE stmt0;
DROP TABLE t1;
CREATE TABLE t (a INT,
b INT,
c INT DEFAULT 77,
d INT GENERATED ALWAYS AS (DEFAULT(c)));
INSERT INTO t VALUES(1,2,3,DEFAULT);
prepare stmt0 from "INSERT INTO t VALUES(?,?,?,DEFAULT(c))";
set @a = 1;
set @b = 2;
set @c = 3;
execute stmt0 using @a, @b, @c;
execute stmt0 using @a, @b, @c;
SELECT * FROM t;
a	b	c	d
1	2	3	77
1	2	3	77
1	2	3	77
DEALLOCATE PREPARE stmt0;
prepare stmt0 from "INSERT INTO t VALUES(?,?,?,DEFAULT)";
set @a = 1;
set @b = 2;
set @c = 3;
execute stmt0 using @a, @b, @c;
execute stmt0 using @a, @b, @c;
SELECT * FROM t;
a	b	c	d
1	2	3	77
1	2	3	77
1	2	3	77
1	2	3	77
1	2	3	77
DEALLOCATE PREPARE stmt0;
DROP TABLE t;
