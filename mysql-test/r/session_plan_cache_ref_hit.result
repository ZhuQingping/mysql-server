# Phase 4D-1: cached hit for prepared ref access
CREATE TABLE pc4d_ref (
id INT PRIMARY KEY,
c INT,
v VARCHAR(16),
KEY c_idx(c)
) ENGINE=InnoDB;
INSERT INTO pc4d_ref VALUES
(1, 10, 'ten-a'),
(2, 20, 'twenty'),
(3, 10, 'ten-b'),
(4, 30, 'thirty');
SET SESSION rds_plan_cache=ON;
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
# primary-key eq_ref/const lookup is eligible for 4D-1 cached hits
PREPARE pk_stmt FROM 'SELECT v FROM pc4d_ref WHERE id = ?';
SET @p=1;
EXECUTE pk_stmt USING @p;
v
ten-a
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	0
SET @p=2;
EXECUTE pk_stmt USING @p;
v
twenty
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	1
SET @p=4;
EXECUTE pk_stmt USING @p;
v
thirty
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	2
DEALLOCATE PREPARE pk_stmt;
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	2
# secondary non-unique ref lookup is eligible for 4D-1 cached hits
PREPARE ref_stmt FROM 'SELECT id, v FROM pc4d_ref WHERE c = ?';
SET @p=10;
EXECUTE ref_stmt USING @p;
id	v
1	ten-a
3	ten-b
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	2
SET @p=20;
EXECUTE ref_stmt USING @p;
id	v
2	twenty
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	3
SET @p=30;
EXECUTE ref_stmt USING @p;
id	v
4	thirty
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	1
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	4
DEALLOCATE PREPARE ref_stmt;
SHOW STATUS LIKE 'Cached_plan_count';
Variable_name	Value
Cached_plan_count	0
SHOW STATUS LIKE 'Cached_plan_hits';
Variable_name	Value
Cached_plan_hits	4
DROP TABLE pc4d_ref;
