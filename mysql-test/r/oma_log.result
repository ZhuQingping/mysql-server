ALTER EVENT event1 RENAME TO event0;
DROP EVENT event0;
CRATE TABLE t1;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near 'CRATE TABLE t1' at line 1
