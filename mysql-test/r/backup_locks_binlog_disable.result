#-----------------------------------------------------------------------
# Test sql_log_bin = 1 and rds_binlog_lock_enable = OFF
#-----------------------------------------------------------------------
SET PERSIST_ONLY rds_binlog_lock_enable=0;
# Restart server and check if server starts
# restart:
SELECT @@global.rds_binlog_lock_enable;
@@global.rds_binlog_lock_enable
0
