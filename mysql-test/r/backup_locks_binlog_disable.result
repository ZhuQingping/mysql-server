#-----------------------------------------------------------------------
# No backup locks are allowed in stored routines
#-----------------------------------------------------------------------
CREATE PROCEDURE p2()
BEGIN
LOCK BINLOG FOR BACKUP;
END|
ERROR 0A000: LOCK is not allowed in stored procedures
CREATE FUNCTION f2() RETURNS INT DETERMINISTIC
BEGIN
LOCK BINLOG FOR BACKUP;
RETURN 1;
END|
ERROR 0A000: LOCK is not allowed in stored procedures
