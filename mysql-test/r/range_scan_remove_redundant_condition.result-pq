CREATE TABLE t1(a INT,  b INT, INDEX(b));
INSERT INTO t1 VALUES (1,2),(2,3),(3,3),(4,3);
CREATE TABLE t2(a INT,  b INT, INDEX(a,b));
INSERT INTO t2 VALUES (1,2),(2,3),(3,3),(4,3);
ANALYZE TABLE t1, t2;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK
#
# Test that redundant condition in not removed when we disable redundant condition removal
#
set rds_empty_redundant_check_in_range_scan=false;
explain format=tree SELECT b FROM t1 WHERE b > 2;
EXPLAIN
-> Gather: 4 workers, parallel scan on t1  (cost=*** rows=***)
    -> Filter: (t1.b > 2)  (cost=*** rows=***.75)
        -> Parallel covering index range scan on t1 using b over (2 < b)  (cost=*** rows=***.75)

explain format=tree SELECT a, b FROM t2 WHERE a = 2 AND b < 2;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: ((t2.a = 2) and (t2.b < 2))  (cost=*** rows=***.25)
        -> Parallel covering index range scan on t2 using a over (a = 2 AND NULL < b < 2)  (cost=*** rows=***.25)

explain format=tree SELECT a, b FROM t2 WHERE 2 = a AND b < 2;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: ((t2.a = 2) and (t2.b < 2))  (cost=*** rows=***.25)
        -> Parallel covering index range scan on t2 using a over (a = 2 AND NULL < b < 2)  (cost=*** rows=***.25)

explain format=tree SELECT a, b FROM t2 WHERE a = 2 AND 2 < b;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: ((t2.a = 2) and (2 < t2.b))  (cost=*** rows=***.25)
        -> Parallel covering index range scan on t2 using a over (a = 2 AND 2 < b)  (cost=*** rows=***.25)

# between with condition
explain format=tree SELECT * FROM t2 WHERE a BETWEEN 2 and 3;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: (t2.a between 2 and 3)  (cost=*** rows=***.5)
        -> Parallel covering index range scan on t2 using a over (2 <= a <= 3)  (cost=*** rows=***.5)

# BETWEEN and type conversion
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "b" AND 5;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: (t2.a between 'b' and 5)  (cost=*** rows=***)
        -> Parallel index scan on t2 using a  (cost=*** rows=***)

Warnings:
Warning	1292	Truncated incorrect DOUBLE value: 'b'
SELECT * FROM t2 WHERE a BETWEEN "b" AND 5;
a	b
1	2
2	3
3	3
4	3
Warnings:
Warning	1292	Truncated incorrect DOUBLE value: 'b'
Warning	1292	Truncated incorrect DOUBLE value: 'b'
Warning	1292	Truncated incorrect DOUBLE value: 'b'
Warning	1292	Truncated incorrect DOUBLE value: 'b'
Warning	1292	Truncated incorrect DOUBLE value: 'b'
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND "5";
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: (t2.a between '2' and '5')  (cost=*** rows=***.75)
        -> Parallel covering index range scan on t2 using a over (2 <= a <= 5)  (cost=*** rows=***.75)

explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND 5;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: (t2.a between '2' and 5)  (cost=*** rows=***.75)
        -> Parallel covering index range scan on t2 using a over (2 <= a <= 5)  (cost=*** rows=***.75)

explain format=tree SELECT * FROM t2 WHERE a BETWEEN 2 AND "5";
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: (t2.a between 2 and '5')  (cost=*** rows=***.75)
        -> Parallel covering index range scan on t2 using a over (2 <= a <= 5)  (cost=*** rows=***.75)

explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2.0" AND "5";
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: (t2.a between '2.0' and '5')  (cost=*** rows=***.75)
        -> Parallel covering index range scan on t2 using a over (2 <= a <= 5)  (cost=*** rows=***.75)

explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND "5.0";
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: (t2.a between '2' and '5.0')  (cost=*** rows=***.75)
        -> Parallel covering index range scan on t2 using a over (2 <= a <= 5)  (cost=*** rows=***.75)

#
# Now enable redundant condition removal
#
set rds_empty_redundant_check_in_range_scan=true;
explain format=tree SELECT b FROM t1 WHERE b > 2;
EXPLAIN
-> Gather: 4 workers, parallel scan on t1  (cost=*** rows=***)
    -> Parallel covering index range scan on t1 using b over (2 < b)  (cost=*** rows=***.75)

# works whether b OP cond or cond OP b
explain format=tree SELECT a, b FROM t2 WHERE a = 2 AND b < 2;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (a = 2 AND NULL < b < 2)  (cost=*** rows=***.25)

explain format=tree SELECT a, b FROM t2 WHERE 2 = a AND b < 2;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (a = 2 AND NULL < b < 2)  (cost=*** rows=***.25)

explain format=tree SELECT a, b FROM t2 WHERE a = 2 AND 2 < b;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (a = 2 AND 2 < b)  (cost=*** rows=***.25)

# Empty IS NULL in WHERE clause
explain format=tree  SELECT * FROM  t2 WHERE a IS NULL AND b > 5;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (a = NULL AND 5 < b)  (cost=*** rows=***.25)

explain format=tree  SELECT * FROM  t2 WHERE a IS NULL AND b > 5 LIMIT 100 OFFSET 1;
EXPLAIN
-> Limit/Offset: 100/1 row(s)  (cost=*** rows=***)
    -> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
        -> Limit: 101 row(s)  (cost=*** rows=***.25)
            -> Parallel covering index range scan on t2 using a over (a = NULL AND 5 < b)  (cost=*** rows=***.25)

# between condition removal
explain format=tree SELECT * FROM t2 WHERE a BETWEEN 2 and 3;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (2 <= a <= 3)  (cost=*** rows=***.5)

# BETWEEN and type conversion
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "b" AND 5;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Filter: (t2.a between 'b' and 5)  (cost=*** rows=***)
        -> Parallel index scan on t2 using a  (cost=*** rows=***)

Warnings:
Warning	1292	Truncated incorrect DOUBLE value: 'b'
SELECT * FROM t2 WHERE a BETWEEN "b" AND 5;
a	b
1	2
2	3
3	3
4	3
Warnings:
Warning	1292	Truncated incorrect DOUBLE value: 'b'
Warning	1292	Truncated incorrect DOUBLE value: 'b'
Warning	1292	Truncated incorrect DOUBLE value: 'b'
Warning	1292	Truncated incorrect DOUBLE value: 'b'
Warning	1292	Truncated incorrect DOUBLE value: 'b'
explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND "5";
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (2 <= a <= 5)  (cost=*** rows=***.75)

explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND 5;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (2 <= a <= 5)  (cost=*** rows=***.75)

explain format=tree SELECT * FROM t2 WHERE a BETWEEN 2 AND "5";
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (2 <= a <= 5)  (cost=*** rows=***.75)

explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2.0" AND "5";
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (2 <= a <= 5)  (cost=*** rows=***.75)

explain format=tree SELECT * FROM t2 WHERE a BETWEEN "2" AND "5.0";
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (2 <= a <= 5)  (cost=*** rows=***.75)

# Empty IS NULL in WHERE clause
explain format=tree  SELECT * FROM  t2 WHERE a IS NULL AND b > 5;
EXPLAIN
-> Gather: 4 workers, parallel scan on t2  (cost=*** rows=***)
    -> Parallel covering index range scan on t2 using a over (a = NULL AND 5 < b)  (cost=*** rows=***.25)

explain format=tree  SELECT * FROM  t2 WHERE a IS NULL AND b > 5 LIMIT 100 OFFSET 1;
EXPLAIN
-> Limit/Offset: 100/1 row(s)  (cost=*** rows=***)
