# Test tpcc Q34 (simulated) (FE2025041500028)
#
CREATE TABLE bmsql_stock (
s_w_id INT NOT NULL,
s_i_id int NOT NULL,
s_quantity SMALLINT,
PRIMARY KEY(s_w_id, s_i_id)
);
INSERT INTO bmsql_stock VALUES (316, 5, 10),(316, 9, 10),(317, 12, 351), (316, 1, 9999);
ANALYZE TABLE bmsql_stock;
Table	Op	Msg_type	Msg_text
test.bmsql_stock	analyze	status	OK
CREATE TABLE bmsql_order_line (
ol_w_id INT NOT NULL,
ol_d_id TINYINT NOT NULL,
ol_o_id INT NOT NULL,
ol_i_id INT,
ol_number TINYINT NOT NULL,
PRIMARY KEY(ol_w_id , ol_d_id , ol_o_id , ol_number)
);
INSERT INTO bmsql_order_line VALUES (316, 7, 90, 5, 34);
ANALYZE TABLE bmsql_order_line;
Table	Op	Msg_type	Msg_text
test.bmsql_order_line	analyze	status	OK
CREATE TABLE bmsql_district (
d_w_id INT NOT NULL,
d_id TINYINT NOT NULL,
d_next_o_id INT,
PRIMARY KEY (d_w_id , d_id)
);
INSERT INTO bmsql_district VALUES (316, 7, 100);
ANALYZE TABLE bmsql_district;
Table	Op	Msg_type	Msg_text
test.bmsql_district	analyze	status	OK
# first no condition removal
set rds_empty_redundant_check_in_range_scan=false;
EXPLAIN format=tree SELECT count(*) AS low_stock FROM ( 
SELECT s_w_id, s_i_id, s_quantity FROM
bmsql_stock WHERE s_w_id = 316 AND s_quantity < 10 AND
s_i_id IN ( SELECT ol_i_id FROM 
bmsql_district JOIN bmsql_order_line ON ol_w_id = d_w_id AND
ol_d_id = d_id AND ol_o_id >= d_next_o_id - 20 AND
ol_o_id < d_next_o_id WHERE d_w_id = 316 AND d_id = 7 ) ) AS L ;
EXPLAIN
-> Aggregate: count(`<temporary>`.low_stock)  (cost=0.925 rows=1)
    -> Gather: 4 workers, parallel scan on bmsql_order_line, bmsql_stock  (cost=0.525 rows=4)
        -> Aggregate: count(`<temporary>`.low_stock)  (cost=0.525 rows=1)
            -> Hash semijoin, hash table shared by worker threads (bmsql_order_line.ol_i_id = bmsql_stock.s_i_id)  (cost=0.5 rows=0.25)
                -> Filter: (bmsql_stock.s_quantity < 10)  (cost=0.276 rows=0.25)
                    -> Parallel index lookup on bmsql_stock using PRIMARY (s_w_id=316)  (cost=0.276 rows=0.75)
                -> Hash
                    -> Filter: ((bmsql_order_line.ol_d_id = 7) and (bmsql_order_line.ol_w_id = 316) and (bmsql_order_line.ol_o_id >= <cache>((bmsql_district.d_next_o_id - 20))) and (bmsql_order_line.ol_o_id < bmsql_district.d_next_o_id))  (cost=0.385 rows=0.25)
                        -> Parallel index range scan on bmsql_order_line using PRIMARY over (ol_w_id = 316 AND ol_d_id = 7 AND 80 <= ol_o_id < 100)  (cost=0.385 rows=0.25)

# with condition removal
set rds_empty_redundant_check_in_range_scan=true;
EXPLAIN format=tree SELECT count(*) AS low_stock FROM ( 
SELECT s_w_id, s_i_id, s_quantity FROM
bmsql_stock WHERE s_w_id = 316 AND s_quantity < 10 AND
s_i_id IN ( SELECT ol_i_id FROM 
bmsql_district JOIN bmsql_order_line ON ol_w_id = d_w_id AND
ol_d_id = d_id AND ol_o_id >= d_next_o_id - 20 AND
ol_o_id < d_next_o_id WHERE d_w_id = 316 AND d_id = 7 ) ) AS L ;
EXPLAIN
-> Aggregate: count(`<temporary>`.low_stock)  (cost=0.925 rows=1)
    -> Gather: 4 workers, parallel scan on bmsql_order_line, bmsql_stock  (cost=0.525 rows=4)
        -> Aggregate: count(`<temporary>`.low_stock)  (cost=0.525 rows=1)
            -> Hash semijoin, hash table shared by worker threads (bmsql_order_line.ol_i_id = bmsql_stock.s_i_id)  (cost=0.5 rows=0.25)
                -> Filter: (bmsql_stock.s_quantity < 10)  (cost=0.276 rows=0.25)
                    -> Parallel index lookup on bmsql_stock using PRIMARY (s_w_id=316)  (cost=0.276 rows=0.75)
                -> Hash
                    -> Parallel index range scan on bmsql_order_line using PRIMARY over (ol_w_id = 316 AND ol_d_id = 7 AND 80 <= ol_o_id < 100)  (cost=0.385 rows=0.25)

DROP TABLE bmsql_district, bmsql_order_line, bmsql_stock;
