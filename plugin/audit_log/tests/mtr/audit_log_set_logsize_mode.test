###-------------------------------------------------------------
###    action:
###          Use various mode  setting audit_log_rotate_on_size and  audit_log_rotations
###    confirm:
###          there are two cases:
###          1.show variables like "audit%",   audit_log_rotate_on_size and  audit_log_rotations  is correct
###-------------------------------------------------------------



show variables like '%audit_log_rota%';


#test for big size
set global audit_log_rotate_on_size=4096*4096*4096;
show variables like '%audit_log_rota%';


#test for small size
set global audit_log_rotate_on_size=4096*1;
show variables like '%audit_log_rota%';

#test for error size
set global audit_log_rotate_on_size=4096*0;
show variables like '%audit_log_rota%';

#Consistent with -master.opt
set global audit_log_rotate_on_size =16777216;
show variables like '%audit_log_rota%';



#test for big error size
set global audit_log_rotations=10*10*10;
show variables like '%audit_log_rota%';


#test for addition and subtraction
set global audit_log_rotations=990+9-1+1;
show variables like '%audit_log_rota%';


#Consistent with -master.opt
set global audit_log_rotations=5;
show variables like '%audit_log_rota%';

