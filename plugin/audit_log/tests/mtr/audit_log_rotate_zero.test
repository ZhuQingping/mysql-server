let $MYSQLD_DATADIR= `select @@datadir`;
let MYSQLD_DATADIR= $MYSQLD_DATADIR;

#the rotate size is big enough thus it will not rotate automatic
set global audit_log_force_rotate=ON;
set global audit_log_force_rotate=ON;
set global audit_log_force_rotate=ON;
set global audit_log_force_rotate=ON;
set global audit_log_force_rotate=ON;

--let file_count= 0;
--let file_pattern= $MYSQLD_DATADIR."/test_audit.log.[0-9]";

perl;
  my @files = glob($ENV{'file_pattern'});
  my $file_count = scalar(@files);
  print "File count: $file_count\n";
EOF
