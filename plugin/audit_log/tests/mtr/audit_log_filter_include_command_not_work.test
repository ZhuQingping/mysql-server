# Merge BUG2024112524891 from TaurusDB

let $MYSQLD_DATADIR= `select @@datadir`;
let $log_file=$MYSQLD_DATADIR/test_audit.log;

set global audit_log_include_commands='select,create_table,insert';
select @@audit_log_include_commands;
set global audit_log_policy=ALL;
drop database if exists auditlog_test;
create database auditlog_test;
use auditlog_test;
create table tb_audit_log_001(a int);
insert into tb_audit_log_001 values(1),(2),(3);
select * from tb_audit_log_001;
drop database auditlog_test;

--source audit_log_echo.inc

set global audit_log_include_commands=NULL;
set global audit_log_policy=NONE;
