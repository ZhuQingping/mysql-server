

# setup some user accounts

CREATE USER 'user1'@'127.0.0.1' IDENTIFIED BY 'password1';
CREATE USER 'user22'@'%' IDENTIFIED BY 'password1';
CREATE USER '22user'@'LOCALHOST' IDENTIFIED BY 'password1';
CREATE USER 'admin'@'%' IDENTIFIED BY 'password1';
CREATE USER 'us,er1'@'localhost' IDENTIFIED BY 'password1';


let $MYSQLD_DATADIR= `select @@datadir`;
let $log_file=$MYSQLD_DATADIR/test_audit.log;

SET GLOBAL audit_log_flush=ON;
--remove_file $log_file
SET GLOBAL audit_log_flush=ON;

# log nothing
SET GLOBAL audit_log_include_accounts= '';
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL audit_log_exclude_accounts= '';
--source audit_log_filter_events.inc

#log everything
SET GLOBAL audit_log_include_accounts= NULL;
SET GLOBAL audit_log_exclude_accounts= NULL; 

# testing include all user expect special user 'us,er1', expect log all user expect 'us,er1'
SET GLOBAL audit_log_include_accounts= 'user1@%%,user22@%%,22user@%%,admin@%%';
# testing duplicate user
SET GLOBAL audit_log_include_accounts= 'user1@%%,user1@%%,user22@%%,user22@%%,22user@%%,admin@%%';
--source audit_log_filter_events.inc

# log everything
SET GLOBAL audit_log_include_accounts= NULL;

--source audit_log_filter_events.inc

# testing exclude all user expect special user 'us,er1', expect log only 'us,er1'
SET GLOBAL audit_log_exclude_accounts= 'user1@%%,user22@%%,22user@%%,admin@%%';

--source audit_log_filter_events.inc

SET GLOBAL audit_log_exclude_accounts= NULL;

# testing case sensitivity
SET GLOBAL audit_log_include_accounts= '22user@%%,User22@%%';
SET GLOBAL audit_log_include_accounts= 'USER22@%%';
SET GLOBAL audit_log_include_accounts= 'us%@%%';

--source audit_log_filter_events.inc

# testing include incorrect format user
SET GLOBAL audit_log_include_accounts= '22user111,User22111';
SET GLOBAL audit_log_include_accounts= '1234USER22%%';
SET GLOBAL audit_log_include_accounts= '@user@%%';
select @@audit_log_include_accounts;
select @@audit_log_exclude_accounts;

--source audit_log_filter_events.inc

#testing include/exclude user corner case
--echo #testing include/exclude user corner case
SET GLOBAL audit_log_include_accounts= NULL;
SET GLOBAL audit_log_exclude_accounts= NULL;


SET GLOBAL audit_log_include_accounts= NULL;
SET GLOBAL audit_log_exclude_accounts= '';

--source audit_log_filter_events.inc

SET GLOBAL audit_log_exclude_accounts= NULL;
SET GLOBAL audit_log_include_accounts= '';

--source audit_log_filter_events.inc

#init status
SET GLOBAL audit_log_include_accounts= NULL;
SET GLOBAL audit_log_exclude_accounts= NULL;
--source audit_log_echo.inc

# cleanup users
DROP USER 'user1'@'127.0.0.1';
DROP USER 'user22'@'%';
DROP USER '22user'@'localhost';
DROP USER 'admin'@'%';
DROP USER 'us,er1'@'localhost';
