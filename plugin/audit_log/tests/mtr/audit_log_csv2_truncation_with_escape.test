--source include/have_debug.inc

call mtr.add_suppression(".*Out of memory in Audit Log.*");
call mtr.add_suppression(".*Attempting backtrace.*");

--echo # FE2022112400392: Oversized SQL statements can be recorded in audit logs.
# This is a test case for the feature: FE2022112400392.
# Related design documents and details are available at the following link:
# https://clouddevops.huawei.com/workitem/FE2022112400392
# SQL statement escape operation will always be turned on.

--echo # ------------------------------Case 1----------------------------------------------
--echo # > System Variable:
--echo # > audit_log_format = CSV2, audit_log_csv2_escape = ON,
--echo # > audit_log_csv2_truncation = OFF, audit_log_csv2_old_separated_format = ON;
--echo # > When the memory application for audit logs fails, mysqld crashes.
--echo # 1.1 Set variable value.
SET @@global.audit_log_csv2_escape = ON;
SELECT @@global.audit_log_csv2_escape;
SET @@global.audit_log_csv2_truncation = OFF;
SELECT @@global.audit_log_csv2_truncation;
SET @@global.audit_log_csv2_old_separated_format = ON;
SELECT @@global.audit_log_csv2_old_separated_format;

--echo # 1.2 Actively crash.
--disable_warnings
DROP TABLE IF EXISTS `employee_tb`;
--enable_warnings
SET debug = "+d, simulate_audit_log_buffer_malloc_fail";
--source include/expect_crash.inc
CREATE TABLE IF NOT EXISTS `employee_tb`(`employee_id` INT UNSIGNED AUTO_INCREMENT,`employee_name` VARCHAR(100) NOT
NULL,`employee_title` VARCHAR(100) NOT NULL,`birthdate` VARCHAR(100) NOT NULL,PRIMARY KEY (`employee_id`))ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4;
INSERT INTO `employee_tb` (`employee_name`, `employee_title`, `birthdate`) VALUES
("Zhang San", "General Director", "2020-01-01"),("Love Dollar Lisi", "Product Manager", "2020-01-02"),
("Dadao Wangwu", "Entrance Guard", "2020-01-03"),("Hen Nanchi", "Main Cook", "2020-01-04"),
("Shangdaren Kongyiji", "Student", "2020-01-05"),("Abudurezeke Aosiman", "Test Engineer", "2020-01-06"),
("Li Si", "Chief", "2020-01-07"),("Jiandao Wangmazi", "Product Manager", "2020-01-08"),
("Zhu Zhu", "Entrance Guard", "2020-01-09"),("Doge Du", "Cook", "2020-01-10"),("Xunger", "Student", "2020-01-11"),
("Shaonian Runtu", "Test Engineer", "2020-01-12"),("James Solos", "General Director", "2020-01-13"),
("Zhao Si", "General Director", "2020-01-14"),("Liu Jiannan", "Chief", "2020-01-15"),("Lao Yu", "Cook", "2020-01-16"),
("James Cameron", "Director", "2020-01-17"),("Wu Shifu", "Entrance Guard", "2020-01-18");

--echo # 1.3 Checking error log.
--let SEARCH_FILE = $MYSQL_TMP_DIR/error.log
--let SEARCH_PATTERN =Out of memory in Audit Log
--source include/search_pattern.inc

--echo # 1.4 Restart the server.
--source include/crash_restart.inc

--echo # ------------------------------Case 2----------------------------------------------
--echo # > System Variable:
--echo # > audit_log_format = CSV2, audit_log_csv2_escape = ON,
--echo # > audit_log_csv2_truncation = OFF, audit_log_csv2_old_separated_format = OFF;
--echo # > When the memory application for audit logs fails, mysqld crashes.
--echo # 2.1 Set variable value.
SET @@global.audit_log_csv2_escape = ON;
SELECT @@global.audit_log_csv2_escape;
SET @@global.audit_log_csv2_truncation = OFF;
SELECT @@global.audit_log_csv2_truncation;
SET @@global.audit_log_csv2_old_separated_format = OFF;
SELECT @@global.audit_log_csv2_old_separated_format;

--echo # 2.2 Actively crash again.
--disable_warnings
DROP TABLE IF EXISTS `employee_tb`;
--enable_warnings
SET debug = "+d, simulate_audit_malloc_fail";
--source include/expect_crash.inc
CREATE TABLE IF NOT EXISTS `employee_tb`(`employee_id` INT UNSIGNED AUTO_INCREMENT,`employee_name` VARCHAR(100) NOT
NULL,`employee_title` VARCHAR(100) NOT NULL,`birthdate` VARCHAR(100) NOT NULL,PRIMARY KEY (`employee_id`))ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4;
