--echo # 3.4 Checking error log.
--let SEARCH_FILE = $MYSQL_TMP_DIR/error.log
--let SEARCH_PATTERN =Audit Log: The new memory required
--source include/search_pattern.inc

--echo # 3.5 Restart the server.
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--echo "restarting mysqld server."
--enable_reconnect
--source include/wait_until_connected_again.inc
--disable_reconnect

--echo # ------------------------------Case 4----------------------------------------------
--echo # > System Variable:
--echo # > audit_log_format = CSV2, audit_log_csv2_escape = ON,
--echo # > audit_log_csv2_truncation = ON, audit_log_csv2_old_separated_format = OFF;
