

# setup some user accounts

CREATE USER 'user1'@'127.0.0.1' IDENTIFIED BY 'password1';
CREATE USER 'user22'@'%' IDENTIFIED BY 'password1';
CREATE USER '22user'@'LOCALHOST' IDENTIFIED BY 'password1';
CREATE USER 'admin'@'%' IDENTIFIED BY 'password1';
CREATE USER 'us,er1'@'localhost' IDENTIFIED BY 'password1';

# test set/unset filter

SET GLOBAL audit_log_anonymized_ip= '127.0.0.%, 127.0.%';
SELECT @@audit_log_anonymized_ip;
SET GLOBAL audit_log_anonymized_ip= '127.0.0.% 127.0.%';
SELECT @@audit_log_anonymized_ip;
SET GLOBAL audit_log_anonymized_ip= '';
SELECT @@audit_log_anonymized_ip;
SET GLOBAL audit_log_anonymized_ip= '127.%';
SELECT @@audit_log_anonymized_ip;
SET GLOBAL audit_log_anonymized_ip= NULL;
SELECT @@audit_log_anonymized_ip;

#test ipv6

SET GLOBAL audit_log_anonymized_ip= '2001:0db8:86a3:08d3:1319:8a2e:0370:7344';
SELECT @@audit_log_anonymized_ip;

SET GLOBAL audit_log_anonymized_ip= '2001:db8:0:0:0:8a2e:370:7334';
SELECT @@audit_log_anonymized_ip;

SET GLOBAL audit_log_anonymized_ip= '2001:0db8:85a3::8a2e:0370:7334';
SELECT @@audit_log_anonymized_ip;

let $MYSQLD_DATADIR= `select @@datadir`;
let $log_file=$MYSQLD_DATADIR/test_audit.log;

SET GLOBAL audit_log_flush=ON;
--remove_file $log_file
SET GLOBAL audit_log_flush=ON;

# anonymized_ip start with 127
SET GLOBAL audit_log_anonymized_ip= '127.%';

--source audit_log_filter_events.inc

# anonymized_ip start with 127.0.0
SET GLOBAL audit_log_anonymized_ip= '127.0.0.%';

--source audit_log_filter_events.inc

# anonymized_ip start with 127.1, expect no anonymized_ip
SET GLOBAL audit_log_anonymized_ip= '127.1.%';

--source audit_log_filter_events.inc

# anonymized_ip = NULL expect no anonymized_ip
SET GLOBAL audit_log_anonymized_ip= 'NULL';
--source audit_log_filter_events.inc

# anonymized_ip start with 126 128 expect no anonymized_ip
SET GLOBAL audit_log_anonymized_ip= '126.% 128.%';
--source audit_log_filter_events.inc

--source audit_log_echo.inc

# cleanup users
DROP USER 'user1'@'127.0.0.1';
DROP USER 'user22'@'%';
DROP USER '22user'@'localhost';
DROP USER 'admin'@'%';
DROP USER 'us,er1'@'localhost';
SET GLOBAL audit_log_anonymized_ip= NULL;
