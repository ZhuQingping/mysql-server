###-------------------------------------------------------------
###    action:
###          uninstall plugin audit_log and install plugin audit_log
###    confirm:
###          there are two cases:
###          1. audit_log_ can be correct install and uninstall
###-------------------------------------------------------------


##################### frist loop ######################## 


#for Capital
UNINSTALL PLUGIN AUDIT_LOG;
--source include/disconnect_connections.inc

INSTALL PLUGIN audit_log SONAME 'audit_log.so';

show variables like "audit_log%";

#for Lowercase 
uninstall plugin audit_log;
--source include/disconnect_connections.inc

install plugin audit_log soname 'audit_log.so';

show variables like "audit_log%";

#Mix lowercase and Capital
unINSTALL PLugIN AUDIT_LOG;
--source include/disconnect_connections.inc

INstaLL PLugIN AUDIT_LOG SONAME 'audit_log.so';

show variables like "audit_log%";

