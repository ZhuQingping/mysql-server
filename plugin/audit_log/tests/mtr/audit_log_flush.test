let $MYSQLD_DATADIR= `select @@datadir`;
let MYSQLD_DATADIR= $MYSQLD_DATADIR;

#the rotate size is big enough thus it will not rotate automatic
set global audit_log_force_rotate=ON;

#remove the log file
--remove_files_wildcard $MYSQLD_DATADIR test_audit.log*

#reopen audit.log
set global audit_log_flush=ON;
set global audit_log_flush=ON;
set global audit_log_flush=ON;

perl;
  eval "use Text::CSV; 1" or exit 0;
  my $p = Text::CSV->new({ binary => 1, sep_char => ',' });
  open my $file, $ENV{'MYSQLD_DATADIR'} . '/test_audit.log' or die "Could not open log: $!";
  while ($p->getline($file)) {};
  if (not $p->eof) {
    die "CSV parse error " . $p->error_diag();
  }
  close $file;
EOF
--remove_files_wildcard $MYSQLD_DATADIR test_audit.log

--echo success
