CREATE TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(50)
);
PREPARE stmt1 FROM 'INSERT INTO t1 VALUES (?, ?)';
SET @id = 1;
SET @name = 'test';
EXECUTE stmt1 USING @id, @name;
PREPARE stmt2 FROM 'SELECT * FROM t1 WHERE id = ?';
SET @search_id = 1;
EXECUTE stmt2 USING @search_id;
id	name
1	test
PREPARE stmt3 FROM 'UPDATE t1 SET name = ? WHERE id = ?';
SET @new_name = 'updated';
SET @update_id = 1;
EXECUTE stmt3 USING @new_name, @update_id;
DEALLOCATE PREPARE stmt1;
DEALLOCATE PREPARE stmt2;
DEALLOCATE PREPARE stmt3;
DROP TABLE t1;
