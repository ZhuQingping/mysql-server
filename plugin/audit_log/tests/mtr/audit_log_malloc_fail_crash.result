call mtr.add_suppression(".*Out of memory in Audit Log.*");
call mtr.add_suppression(".*Attempting backtrace.*");
# FE2022112400392: Oversized SQL statements can be recorded in audit logs.
# > System Variable: audit_log_format != CSV2.
# > When memory allocation for audit logs fails, mysqld always crashes.
# ------------------------------Case 1----------------------------------------------
# 1.1 Set variable value.
SET @@global.audit_log_csv2_truncation = ON;
SET @@global.audit_log_csv2_escape = ON;
SET @@global.audit_log_csv2_old_separated_format = ON;
show variables like '%audit_log%';
Variable_name	Value
audit_log_anonymized_ip	
audit_log_buffer_size	1048576
audit_log_csv2_escape	ON
audit_log_csv2_old_separated_format	ON
audit_log_csv2_truncation	ON
audit_log_exclude_accounts	
audit_log_exclude_commands	
audit_log_exclude_databases	
audit_log_file	test_audit.log
audit_log_flush	OFF
audit_log_force_rotate	OFF
audit_log_format	CSV
audit_log_handler	FILE
audit_log_include_accounts	
audit_log_include_commands	
audit_log_include_databases	
audit_log_policy	ALL
audit_log_rotate_on_size	0
audit_log_rotations	0
audit_log_strategy	SYNCHRONOUS
audit_log_syslog_facility	LOG_USER
audit_log_syslog_ident	taurus-audit
audit_log_syslog_priority	LOG_INFO
audit_log_thread_safe	ON
SET debug = "+d, simulate_audit_malloc_fail";
# 1.2 Actively crash.
DROP TABLE IF EXISTS `employee_tb`;
CREATE TABLE IF NOT EXISTS `employee_tb`(`employee_id` INT UNSIGNED AUTO_INCREMENT,`employee_name` VARCHAR(100) NOT
NULL,`employee_title` VARCHAR(100) NOT NULL,`birthdate` VARCHAR(100) NOT NULL,PRIMARY KEY (`employee_id`))ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4;
