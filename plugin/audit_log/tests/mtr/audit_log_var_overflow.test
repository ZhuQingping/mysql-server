#
# test bug, if the exclude/include account/database/command is too long
# to truncate 

show variables like 'audit_log_include_accounts';

set global audit_log_include_accounts=REPEAT('a', 500);

set global audit_log_include_accounts=NULL;

show variables like 'audit_log_exclude_accounts';

set global audit_log_exclude_accounts=REPEAT('a', 500);

set global audit_log_exclude_accounts=NULL;

show variables like 'audit_log_include_databases';

set global audit_log_include_databases=REPEAT('a', 500);

set global audit_log_include_databases=NULL;

show variables like 'audit_log_exclude_databases';

set global audit_log_exclude_databases=REPEAT('a', 500);

set global audit_log_exclude_databases=NULL;

show variables like 'audit_log_include_commands';

set global audit_log_include_commands=REPEAT('a', 500);

set global audit_log_include_commands=NULL;

show variables like 'audit_log_exclude_commands';

set global audit_log_exclude_commands=REPEAT('a', 500);

set global audit_log_exclude_commands=NULL;
