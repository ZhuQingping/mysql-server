# restart: --skip-grant-tables
SET GLOBAL audit_log_flush=ON;
SET GLOBAL audit_log_flush=ON;
create database audit_test;
use audit_test;
CREATE TABLE t1 (c1 INT, c2 CHAR(20));
INSERT INTO t1 VALUES (1,'a'),(2,'b'),(3,'c');
SELECT * FROM t1;
DROP TABLE t1;
PREPARE stmt1 FROM 'SELECT 1';
EXECUTE stmt1;
SHOW STATUS LIKE 'audit_log%';
DROP DATABASE audit_test;
# expect audit nothing when skip-grant-tables=ON
set global audit_log_flush= ON;
