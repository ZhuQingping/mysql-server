###-------------------------------------------------------------
###    action:
###          set  audit_log_rotate_on_size and audit_log_rotations
###    confirm:
###          there are two cases:
###          1.show variables like "audit%", audit_log_rotate_on_size and audit_log_rotations  is correct
###-------------------------------------------------------------




show variables like '%audit_log_rota%';


#test for big size
set global audit_log_rotate_on_size=4096000000000;
show variables like '%audit_log_rota%';

#test for small size
set global audit_log_rotate_on_size=4096;
show variables like '%audit_log_rota%';

#test for error size
set global audit_log_rotate_on_size=4095;
show variables like '%audit_log_rota%';

#Consistent with -master.opt
set global audit_log_rotate_on_size =16777216;
show variables like '%audit_log_rota%';

#test for small size
set global audit_log_rotations=0;
show variables like '%audit_log_rota%';

#test for small size
set global audit_log_rotations=1;
show variables like '%audit_log_rota%';

#test for big size
set global audit_log_rotations=999;
show variables like '%audit_log_rota%';

#test for big error size
set global audit_log_rotations=1000;
show variables like '%audit_log_rota%';


#Consistent with -master.opt
set global audit_log_rotations=5;
show variables like '%audit_log_rota%';

