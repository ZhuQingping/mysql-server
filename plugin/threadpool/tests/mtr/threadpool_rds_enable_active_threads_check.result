call mtr.add_suppression("Threadpool could create additional thread to handle queries");
SET GLOBAL threadpool_enable_active_threads_check = OFF;
SHOW GLOBAL VARIABLES LIKE "threadpool_enable_active_threads_check";
Variable_name	Value
threadpool_enable_active_threads_check	OFF
SELECT SLEEP(3);
SELECT SLEEP(1);
SHOW GLOBAL STATUS LIKE "Threadpool_active_threads";
Variable_name	Value
Threadpool_active_threads	1
SLEEP(3)
0
SLEEP(1)
0
SET GLOBAL threadpool_enable_active_threads_check = ON;
SHOW GLOBAL VARIABLES LIKE "threadpool_enable_active_threads_check";
Variable_name	Value
threadpool_enable_active_threads_check	ON
SELECT SLEEP(3);
SELECT SLEEP(1);
SLEEP(3)
0
SLEEP(1)
0
SHOW GLOBAL STATUS LIKE "Threadpool_active_threads";
Variable_name	Value
Threadpool_active_threads	1
