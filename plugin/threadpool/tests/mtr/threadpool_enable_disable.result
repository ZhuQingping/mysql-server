call mtr.add_suppression("Threadpool could create additional thread to handle queries");
SET GLOBAL threadpool_enabled = ON;
SHOW GLOBAL VARIABLES LIKE "threadpool_enabled";
Variable_name	Value
threadpool_enabled	ON
SELECT 1;
1
1
SHOW GLOBAL STATUS LIKE "Threadpool_active_threads";
Variable_name	Value
Threadpool_active_threads	1
SET GLOBAL threadpool_enabled = OFF;
SHOW GLOBAL VARIABLES LIKE "threadpool_enabled";
Variable_name	Value
threadpool_enabled	OFF
SELECT 1;
1
1
SHOW GLOBAL STATUS LIKE "Threadpool_active_threads";
Variable_name	Value
Threadpool_active_threads	0
SET GLOBAL threadpool_enabled = ON;
