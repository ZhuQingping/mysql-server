+# Check write audit log is thread safe
+# if audit_log_thread_safe is ON.
+--source include/have_debug.inc
+
+--echo # Create user and prepare table
+CREATE USER 'normal_user'@'%' IDENTIFIED BY 'password';
+GRANT ALL PRIVILEGES ON test.* TO 'normal_user'@'%';
+
+CREATE TABLE tt(a text, b text, c text, d text);
+--let SEARCH_FILE= $MYSQL_TMP_DIR/error.log
+SET @audit_log_force_rotate_saved = @@audit_log_force_rotate;
+
+connect (con1,localhost,normal_user,password,test,);
+connect (con2,localhost,root);
+connect (con3,localhost,root);
+
+let query=INSERT INTO tt VALUES(
+'',
+'',
+'',
+'');
+
+connection con2;
+SET GLOBAL debug='+d,audit_log_rotate_pause';
+
+--echo # Trigger 'audit_log_flush' thread asynchronous rotate audit log
+connection con1;
+--disable_query_log
+eval $query;
+eval $query;
+--enable_query_log
+
+--echo # Verify that audit log rotate suspended
+connection default;
+select sleep(1);
+--let SEARCH_PATTERN= Audit log rotate suspended
+--source include/search_pattern.inc
+
+connection con3;
+SET debug='';
+--send SET GLOBAL audit_log_force_rotate=ON
+
+--echo # Verify that audit log rotate resumed
+connection default;
+select sleep(11);
+--let SEARCH_PATTERN= Audit log rotate resumed
+--source include/search_pattern.inc
+
+--echo # Verify SET GLOBAL audit_log_force_rotate=ON succeed
+connection con3;
+--reap
+
+# cleanup
+connection default;
+SET GLOBAL debug='';
+SET GLOBAL audit_log_force_rotate=@audit_log_force_rotate_saved;
+disconnect con1;
+disconnect con2;
+disconnect con3;
+DROP TABLE tt;
+DROP USER 'normal_user'@'%';
