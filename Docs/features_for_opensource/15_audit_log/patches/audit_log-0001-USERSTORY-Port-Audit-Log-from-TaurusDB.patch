+# Check audit log may be write into non-audit-log(like binlog, slow log, etc)
+# if audit_log_thread_safe is OFF.
+--source include/have_debug.inc
+
+--echo # Create user and prepare table
+CREATE USER 'normal_user'@'%' IDENTIFIED BY 'password';
+GRANT ALL PRIVILEGES ON test.* TO 'normal_user'@'%';
+
+CREATE TABLE tt(a text, b text, c text, d text);
+
+connect (con1,localhost,normal_user,password,test,);
+connect (con2,localhost,root);
+connect (con3,localhost,root);
+
+let query=INSERT INTO tt VALUES(
+'',
+'',
+'',
+'');
+
+connection con2;
+SET GLOBAL debug='+d,audit_log_rotate_pause';
+
+--echo # Trigger 'audit_log_flush' thread asynchronous rotate audit log
+connection con1;
+--disable_query_log
+eval $query;
+eval $query;
+--enable_query_log
+
+--echo # Verify that audit log rotate suspended
+connection default;
+select sleep(1);
+--let SEARCH_FILE= $MYSQL_TMP_DIR/error.log
+--let SEARCH_PATTERN= Audit log rotate suspended
+--source include/search_pattern.inc
+
+--echo # Crash occur since close audit log failed
+connection con3;
+SET debug='';
+--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
+# 2013 - CR_SERVER_LOST
+--error 2013
+SET GLOBAL audit_log_force_rotate=ON;
+--source include/wait_until_disconnected.inc
+
+--enable_reconnect
+--echo # Restart the master server
+--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
+--source include/wait_until_connected_again.inc
+--disable_reconnect
+
+# cleanup
+DROP TABLE tt;
+DROP USER 'normal_user'@'%';
