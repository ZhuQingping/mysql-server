+SET GLOBAL audit_log_anonymized_ip= NULL;
+SELECT @@audit_log_anonymized_ip;
+
+#test ipv6
+
+SET GLOBAL audit_log_anonymized_ip= '2001:0db8:86a3:08d3:1319:8a2e:0370:7344';
+SELECT @@audit_log_anonymized_ip;
+
+SET GLOBAL audit_log_anonymized_ip= '2001:db8:0:0:0:8a2e:370:7334';
+SELECT @@audit_log_anonymized_ip;
+
+SET GLOBAL audit_log_anonymized_ip= '2001:0db8:85a3::8a2e:0370:7334';
