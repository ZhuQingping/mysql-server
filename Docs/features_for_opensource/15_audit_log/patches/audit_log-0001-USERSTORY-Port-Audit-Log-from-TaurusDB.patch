diff --git a/mysql-test/r/audit_log_bug_2023021303358.result b/mysql-test/r/audit_log_bug_2023021303358.result
new file mode 100644
index 00000000000..7211026f5b1
--- /dev/null
+++ b/mysql-test/r/audit_log_bug_2023021303358.result
@@ -0,0 +1,34 @@
+# BUGFIX: When innodb_force_recovery=1 and then install the audit log
+# plugin, the database crashes.
+
+# ------------------------------Case 1----------------------------------------------
+SET debug = "+d, simulate_audit_account_map_nullptr";
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+# The mysqld process is normal, and the PLUGINS table does not contain the audit_log plugin information.
+SELECT * FROM INFORMATION_SCHEMA.PLUGINS WHERE `PLUGIN_NAME`='audit_log';
+PLUGIN_NAME	PLUGIN_VERSION	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_TYPE_VERSION	PLUGIN_LIBRARY	PLUGIN_LIBRARY_VERSION	PLUGIN_AUTHOR	PLUGIN_DESCRIPTION	PLUGIN_LICENSE	LOAD_OPTION
+SET debug = "-d, simulate_audit_account_map_nullptr";
+
+# ------------------------------Case 2----------------------------------------------
+SET debug = "+d, simulate_audit_database_map_nullptr";
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+# The mysqld process is normal, and the PLUGINS table does not contain the audit_log plugin information.
+SELECT * FROM INFORMATION_SCHEMA.PLUGINS WHERE `PLUGIN_NAME`='audit_log';
+PLUGIN_NAME	PLUGIN_VERSION	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_TYPE_VERSION	PLUGIN_LIBRARY	PLUGIN_LIBRARY_VERSION	PLUGIN_AUTHOR	PLUGIN_DESCRIPTION	PLUGIN_LICENSE	LOAD_OPTION
+SET debug = "-d, simulate_audit_database_map_nullptr";
+
+# ------------------------------Case 3----------------------------------------------
+SET debug = "+d, simulate_audit_command_map_nullptr";
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+# The mysqld process is normal, and the PLUGINS table does not contain the audit_log plugin information.
+SELECT * FROM INFORMATION_SCHEMA.PLUGINS WHERE `PLUGIN_NAME`='audit_log';
+PLUGIN_NAME	PLUGIN_VERSION	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_TYPE_VERSION	PLUGIN_LIBRARY	PLUGIN_LIBRARY_VERSION	PLUGIN_AUTHOR	PLUGIN_DESCRIPTION	PLUGIN_LICENSE	LOAD_OPTION
+SET debug = "-d, simulate_audit_command_map_nullptr";
+# restart: --innodb_force_recovery=0
+call mtr.add_suppression("Skip updating information_schema metadata in InnoDB read-only mode.");
+call mtr.add_suppression("Skip re-populating collations and character sets tables in InnoDB read-only mode.");
+call mtr.add_suppression("Skipped updating resource group metadata in InnoDB read only mode.");
+call mtr.add_suppression("innodb_force_recovery is on. We do not allow database modifications by the user. Shut down mysqld and edit my.cnf to set innodb_force_recovery=0");
diff --git a/mysql-test/r/audit_log_crash_innodb_force_recovery.result b/mysql-test/r/audit_log_crash_innodb_force_recovery.result
new file mode 100644
index 00000000000..475fba1aa35
--- /dev/null
+++ b/mysql-test/r/audit_log_crash_innodb_force_recovery.result
@@ -0,0 +1,77 @@
+# BUGFIX: When innodb_force_recovery=1 and then install the
+# audit log plugin, the database crashes.
+
+# ----------------------------Case 1.1------------------------------------
+SET debug = "+d, simulate_audit_account_map_nullptr";
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+# The mysqld process is normal, and the PLUGINS table does not contain the
+# audit_log plugin information.
+SELECT * FROM INFORMATION_SCHEMA.PLUGINS WHERE `PLUGIN_NAME`='audit_log';
+PLUGIN_NAME	PLUGIN_VERSION	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_TYPE_VERSION	PLUGIN_LIBRARY	PLUGIN_LIBRARY_VERSION	PLUGIN_AUTHOR	PLUGIN_DESCRIPTION	PLUGIN_LICENSE	LOAD_OPTION
+SET debug = "-d, simulate_audit_account_map_nullptr";
+
+# ----------------------------Case 1.2------------------------------------
+SET debug = "+d, simulate_audit_database_map_nullptr";
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+# The mysqld process is normal, and the PLUGINS table does not contain the
+# audit_log plugin information.
+SELECT * FROM INFORMATION_SCHEMA.PLUGINS WHERE `PLUGIN_NAME`='audit_log';
+PLUGIN_NAME	PLUGIN_VERSION	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_TYPE_VERSION	PLUGIN_LIBRARY	PLUGIN_LIBRARY_VERSION	PLUGIN_AUTHOR	PLUGIN_DESCRIPTION	PLUGIN_LICENSE	LOAD_OPTION
+SET debug = "-d, simulate_audit_database_map_nullptr";
+
+# ----------------------------Case 1.3------------------------------------
+SET debug = "+d, simulate_audit_command_map_nullptr";
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+# The mysqld process is normal, and the PLUGINS table does not contain the
+# audit_log plugin information.
+SELECT * FROM INFORMATION_SCHEMA.PLUGINS WHERE `PLUGIN_NAME`='audit_log';
+PLUGIN_NAME	PLUGIN_VERSION	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_TYPE_VERSION	PLUGIN_LIBRARY	PLUGIN_LIBRARY_VERSION	PLUGIN_AUTHOR	PLUGIN_DESCRIPTION	PLUGIN_LICENSE	LOAD_OPTION
+SET debug = "-d, simulate_audit_command_map_nullptr";
+
+# BUGFIX: When innodb_force_recovery=1 and System variables
+# related to the audit log are set in the configuration file. Then install
+# the audit log plugin, the database crashes.
+
+# ----------------------------Case 2.1------------------------------------
+# restart: --plugin_load= --innodb_force_recovery=1 --loose_audit_log_exclude_accounts=root@%
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+
+# ----------------------------Case 2.2------------------------------------
+# restart: --plugin_load= --innodb_force_recovery=1 --loose_audit_log_include_accounts=root@%
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+
+# ----------------------------Case 2.3------------------------------------
+# restart: --plugin_load= --innodb_force_recovery=1 --loose_audit_log_exclude_databases=test
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+
+# ----------------------------Case 2.4------------------------------------
+# restart: --plugin_load= --innodb_force_recovery=1 --loose_audit_log_include_databases=test
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+
+# ----------------------------Case 2.5------------------------------------
+# restart: --plugin_load= --innodb_force_recovery=1 --loose_audit_log_exclude_commands=create_db
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+
+# ----------------------------Case 2.6------------------------------------
+# restart: --plugin_load= --innodb_force_recovery=1 --loose_audit_log_include_commands=create_db
+INSTALL PLUGIN audit_log SONAME 'audit_log.so';
+ERROR HY000: Error installing plugin 'audit_log': got 'Operation not permitted' writing to mysql.plugin
+
