diff --git a/plugin/audit_log/file_logger.cc b/plugin/audit_log/file_logger.cc
new file mode 100644
index 00000000000..0e05bb3786b
--- /dev/null
+++ b/plugin/audit_log/file_logger.cc
@@ -0,0 +1,366 @@
+/* Copyright (C) 2012 Monty Program Ab
+
+   This program is free software; you can redistribute it and/or modify
+   it under the terms of the GNU General Public License as published by
+   the Free Software Foundation; version 2 of the License.
+
+   This program is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+   GNU General Public License for more details.
+
+   You should have received a copy of the GNU General Public License
+   along with this program; if not, write to the Free Software
+   Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301,
+   USA */
+
+#include <my_sys.h>
+#include <my_thread_local.h>
+#include <mysql/plugin.h>
+
+#include <cstring>
+#include <thread>  // std::this_thread::wait_for
+
+#include "audit_log.h"
+#include "logger.h"
+#include "my_securec.h"
+#include "mysql/psi/mysql_cond.h"
+#include "mysql/psi/mysql_mutex.h"
+
+extern char *mysql_data_home;
+
+#ifndef FLOGGER_NO_PSI
+#define flogger_mutex_init(A, B, C) \
+  if ((B)->thread_safe) mysql_mutex_init(A, &((B)->lock), C)
+
+#define flogger_mutex_destroy(A) \
+  if ((A)->thread_safe) mysql_mutex_destroy(&((A)->lock))
+
+#define flogger_mutex_lock(A) \
+  if ((A)->thread_safe) mysql_mutex_lock(&((A)->lock))
+
+#define flogger_mutex_unlock(A) \
+  if ((A)->thread_safe) mysql_mutex_unlock(&((A)->lock))
+#else
+#define flogger_mutex_init(A, B, C) \
+  if ((B)->thread_safe) pthread_mutex_init(&((B)->lock.m_mutex), C)
+
+#define flogger_mutex_destroy(A) \
+  if ((A)->thread_safe) pthread_mutex_destroy(&((A)->lock.m_mutex))
+
+#define flogger_mutex_lock(A) \
+  if ((A)->thread_safe) pthread_mutex_lock(&((A)->lock.m_mutex))
+
+#define flogger_mutex_unlock(A) \
+  if ((A)->thread_safe) pthread_mutex_unlock(&((A)->lock.m_mutex))
+#endif /*!FLOGGER_NO_PSI*/
+
+#if defined(HAVE_PSI_INTERFACE) && !defined(FLOGGER_NO_PSI)
+/* These belong to the service initialization */
+static PSI_mutex_key key_LOCK_logger_service;
+static PSI_mutex_info mutex_list[] = {
+    {&key_LOCK_logger_service, "file_logger::lock", PSI_FLAG_SINGLETON,
+     PSI_VOLATILITY_UNKNOWN, PSI_DOCUMENT_ME}};
+#else
+#define key_LOCK_logger_service 0
+#endif /*HAVE_PSI_INTERFACE && !FLOGGER_NO_PSI*/
+
+using LSFS = struct logger_handle_st {
+  File file;
+  char path[FN_REFLEN];
+  uint64 size_limit;
+  unsigned int rotations;
+  size_t path_len;
+  mysql_mutex_t lock;
+  int thread_safe;
+};
+
+#define LOG_FLAGS (O_APPEND | O_CREAT | O_WRONLY)
+
+static unsigned int n_dig(unsigned int i) {
+  return (i == 0) ? 0 : ((i < 10) ? 1 : ((i < 100) ? 2 : 3));
+}
+
+LOGGER_HANDLE *logger_open(const char *path, unsigned long long size_limit,
+                           unsigned int rotations, int thread_safe,
+                           logger_prolog_func_t header) {
+  LOGGER_HANDLE new_log, *l_perm;
+  MY_STAT stat_arg;
+  char buf[128];
+  size_t len;
+
+  /*
+    I don't think we ever need more rotations,
+    but if it's so, the rotation procedure should be adapted to it.
+  */
+  if (rotations > 999) {
+    return nullptr;
+  }
+
+  new_log.rotations = rotations;
+  new_log.size_limit = size_limit;
+  new_log.path_len = strlen(fn_format(static_cast<char *>(new_log.path), path,
+                                      mysql_data_home, "", MY_UNPACK_FILENAME));
+  new_log.thread_safe = thread_safe;
+
+  if (new_log.path_len + n_dig(rotations) + 1 > FN_REFLEN) {
+    errno = ENAMETOOLONG;
+    /* File path too long */
+    return nullptr;
+  }
+
+  if ((new_log.file =
+           my_open(static_cast<char *>(new_log.path), LOG_FLAGS, 0666)) < 0) {
+    errno = my_errno();
+    /* Check errno for the cause */
+    return nullptr;
+  }
+
+  if (my_fstat(new_log.file, &stat_arg) != 0) {
+    errno = my_errno();
+    my_close(new_log.file, MYF(0));
+    new_log.file = -1;
+    return nullptr;
+  }
+
+  if ((l_perm = static_cast<LOGGER_HANDLE *>(
+           my_malloc(key_memory_audit_log_logger_handle, sizeof(LOGGER_HANDLE),
+                     MYF(0)))) == nullptr) {
+    my_close(new_log.file, MYF(0));
+    new_log.file = -1;
+    return nullptr; /* End of memory */
+  }
+  *l_perm = new_log;
+
+  flogger_mutex_init(key_LOCK_logger_service, l_perm, MY_MUTEX_INIT_FAST);
+
+  len = header(&stat_arg, static_cast<char *>(buf), sizeof(buf));
+  my_write(l_perm->file, (uchar *)buf, len, MYF(0));  // NOLINT
+
+  return l_perm;
+}
+
+int logger_close(LOGGER_HANDLE *log, logger_epilog_func_t footer) {
+  int result;
+  File file = log->file;
+  char buf[128];
+  size_t len;
+
+  len = footer(static_cast<char *>(buf), sizeof(buf));
+  my_write(file, (uchar *)buf, len, MYF(0));  // NOLINT
+
+  flogger_mutex_destroy(log);
+  my_free(log);
+  if ((result = my_close(file, MYF(0))) != 0) {
+    errno = my_errno();
+  }
+  return result;
+}
+
+int logger_reopen(LOGGER_HANDLE *log, logger_prolog_func_t header,
+                  logger_epilog_func_t footer) {
+  int result = 0;
+  MY_STAT stat_arg;
+  char buf[128];
+  size_t len;
+
+  flogger_mutex_lock(log);
+
+  len = footer(static_cast<char *>(buf), sizeof(buf));
+  my_write(log->file, (uchar *)buf, len, MYF(0));  // NOLINT
+
+  /*
+   When close is called, whatever it fails or not,
+   fd will be recycled and reused by the system,
+   so just open the new file
+  */
+  result = my_close(log->file, MY_WME);
+  DBUG_EXECUTE_IF("audit_reopen_close_failed", result = -1;);
+  if (result) {
+    sql_print_warning(
+        "Can not close the old audit log file for reopen. errno: %d",
+        my_errno());
+  }
+
+  if ((log->file = my_open(log->path, LOG_FLAGS, MY_WME)) < 0) {
+    errno = my_errno();
+    result = 1;
+    goto error;
+  }
+
+  if ((result = my_fstat(log->file, &stat_arg)) != 0) {
+    errno = my_errno();
+    goto error;
+  }
+
+  len = header(&stat_arg, static_cast<char *>(buf), sizeof(buf));
+  my_write(log->file, (uchar *)buf, len, MYF(0));  // NOLINT
+
+error:
+  flogger_mutex_unlock(log);
+
+  return result;
+}
+
+static char *logname(LOGGER_HANDLE *log, char *buf, size_t buf_len,
+                     unsigned int n_log) {
+  my_snprintf(buf + log->path_len, buf_len, buf_len, ".%0*u",
+              n_dig(log->rotations), n_log);
+  return buf;
+}
+
+static int do_rotate(LOGGER_HANDLE *log) {
+  char namebuf[FN_REFLEN];
+  int result;
+  unsigned int i;
+  char *buf_old, *buf_new, *tmp;
+
+  if (log->rotations == 0) {
+    return 0;
+  }
+
+  my_memcpy(static_cast<char *>(namebuf), log->path_len,
+            static_cast<char *>(log->path), log->path_len);
+
+  buf_new = logname(log, static_cast<char *>(namebuf), sizeof(namebuf),
+                    log->rotations);
+  buf_old = static_cast<char *>(log->path);
+  for (i = log->rotations - 1; i > 0; i--) {
+    logname(log, buf_old, FN_REFLEN, i);
+    if (access(buf_old, F_OK) == 0 &&
+        (result = my_rename(buf_old, buf_new, MYF(0))) != 0) {
+      goto exit;
+    }
+    tmp = buf_old;
+    buf_old = buf_new;
+    buf_new = tmp;
+  }
+  /*
+   When close is called, whatever it fails or not,
+   fd will be recycled and reused by the system,
+   so just open the new file. Since file has been
+   closed, assign invalid fd to file to avoid write
+   into other files.
+  */
+  result = my_close(log->file, MY_WME);
+  log->file = -1;
+  DBUG_EXECUTE_IF("audit_rotate_close_failed", result = -1;);
+  if (result) {
+    sql_print_warning(
+        "Can not close the old audit log file for rotate. errno: %d",
+        my_errno());
+  }
+
+  DBUG_EXECUTE_IF("audit_log_rotate_pause", {
+    sql_print_warning("Audit log rotate suspended");
+    /* sleep 10 seconds here */
+    std::this_thread::sleep_for(std::chrono::microseconds{10000000});
+    sql_print_warning("Audit log rotate resumed");
+  });
+
+  namebuf[log->path_len] = 0;  // NOLINT
+  result = my_rename(static_cast<char *>(namebuf),
+                     logname(log, static_cast<char *>(log->path), FN_REFLEN, 1),
+                     MYF(0));
+  log->file = my_open(namebuf, LOG_FLAGS, MY_WME);
+  // ensure the current file name unchanged
+  memset(log->path + log->path_len, 0, FN_REFLEN - log->path_len);
+
+exit:
+  errno = my_errno();
+  return static_cast<int>(log->file < 0 || result != 0);
+}
+
+int logger_vprintf(LOGGER_HANDLE *log, const char *fmt, va_list argptr) {
+  int result;
+  my_off_t filesize;
+  char cvtbuf[1024];
+  size_t n_bytes;
+
+  flogger_mutex_lock(log);
+  if (log->rotations > 0) {
+    if ((filesize = my_tell(log->file, MYF(0))) == static_cast<my_off_t>(-1) ||
+        (static_cast<unsigned long long>(filesize) >= log->size_limit &&
+         do_rotate(log) != 0)) {
+      result = -1;
+      errno = my_errno();
+      goto exit; /* Log rotation needed but failed */
+    }
+  }
+
+  n_bytes = vsnprintf(static_cast<char *>(cvtbuf), sizeof(cvtbuf), fmt, argptr);
+  if (n_bytes >= sizeof(cvtbuf)) {
+    n_bytes = sizeof(cvtbuf) - 1;
+  }
+
+  result = my_write(log->file, (uchar *)cvtbuf, n_bytes, MYF(0));  // NOLINT
+
+exit:
+  flogger_mutex_unlock(log);
+  return result;
+}
+
+int logger_write(LOGGER_HANDLE *log, const char *buffer, size_t size,
+                 log_record_state_t state) {
+  int result;
+  my_off_t filesize;
+
+  flogger_mutex_lock(log);
+
+  result = my_write(log->file, (const uchar *)buffer, size, MYF(0));
+
+  if (state == LOG_RECORD_COMPLETE && log->rotations > 0) {
+    if ((filesize = my_tell(log->file, MYF(0))) == static_cast<my_off_t>(-1) ||
+        (static_cast<unsigned long long>(filesize) >= log->size_limit &&
+         do_rotate(log) != 0)) {
+      result = -1;
+      errno = my_errno();
+      goto exit; /* Log rotation needed but failed */
+    }
+  }
+
+exit:
+  flogger_mutex_unlock(log);
+  return result;
+}
+
+int logger_rotate(LOGGER_HANDLE *log) {
+  int result;
+  flogger_mutex_lock(log);
+  my_off_t filesize = my_tell(log->file, MYF(0));
+  if (filesize == static_cast<my_off_t>(0)) {
+    flogger_mutex_unlock(log);
+    return 0;
+  }
+  result = do_rotate(log);
+  flogger_mutex_unlock(log);
+  return result;
+}
+
+int logger_printf(LOGGER_HANDLE *log, const char *fmt, ...) {
+  int result;
+  va_list args;
+  va_start(args, fmt);                      // NOLINT
+  result = logger_vprintf(log, fmt, args);  // NOLINT
+  va_end(args);                             // NOLINT
+  return result;
+}
+
+void logger_init_mutexes() {
+#if defined(HAVE_PSI_INTERFACE) && !defined(FLOGGER_NO_PSI) && \
+    !defined(FLOGGER_NO_THREADSAFE)
+  mysql_mutex_register(AUDIT_LOG_PSI_CATEGORY,
+                       static_cast<PSI_mutex_info *>(mutex_list),
+                       array_elements(mutex_list));
+#endif /*HAVE_PSI_INTERFACE && !FLOGGER_NO_PSI*/
+}
+
+int logger_sync(LOGGER_HANDLE *log) { return my_sync(log->file, MYF(0)); }
+
+void logger_set_size_limit(LOGGER_HANDLE *log, unsigned long long size_limit) {
+  log->size_limit = size_limit;
+}
+
+void logger_set_rotations(LOGGER_HANDLE *log, unsigned int rotations) {
+  log->rotations = rotations;
+}
