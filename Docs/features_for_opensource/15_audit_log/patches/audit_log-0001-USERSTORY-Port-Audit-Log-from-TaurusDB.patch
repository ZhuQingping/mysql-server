+                               const char *value);
+static char *make_timestamp(char *buf, size_t buf_len, time_t t) {
+  struct tm tm;
+
+  my_memset(&tm, sizeof(tm), 0, sizeof(tm));
+  strftime(buf, buf_len, "%FT%T UTC", gmtime_r(&t, &tm));
+
+  return buf;
+}
