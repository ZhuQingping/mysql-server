+/*
+ *   Print the socket err msg to error log.
+ *   */
+void vio_get_err_msg(int error, char *buf) {
+  const char *error_str;
+  switch (error) {
+    case EBADF:
+      error_str = "The argument sockfd is an invalid file descriptor.(EBADF)";
+      break;
+    case ECONNREFUSED:
+      error_str =
+          "A remote host refused to allow the network "
+          "connection.(ECONNREFUSED)";
+      break;
+    case EFAULT:
+      error_str =
+          "The receive buffer pointer(s) point outside the process's address "
+          "space.(EFAULT)";
+      break;
+    case EINTR:
+      error_str =
+          "The receive was interrupted by delivery of a signal "
+          "before any data were available.(EINTR)";
+      break;
+    case EINVAL:
+      error_str = "Invalid argument passed.(EINVAL)";
+      break;
+    case ENOMEM:
+      error_str = "Could not allocate memory for recvmsg().(ENOMEM)";
+      break;
+    case ENOTCONN:
+      error_str = "The socket is not connected.(ENOTCONN)";
+      break;
+    case ENOTSOCK:
+      error_str =
+          "The file descriptor sockfd does not refer to a socket.(ENOTSOCK)";
+      break;
+    case ETIMEDOUT:
+      error_str = "Connection timed out.(ETIMEDOUT)";
+      break;
+    case EPIPE:
+      error_str = "Connection reset by peer.(EPIPE)";
+      break;
+    case ECONNRESET:
+      error_str = "Connection reset by peer.(ECONNRESET)";
+      break;
+    default:
+      error_str = "Others errors.";
+  }
+
+  DBUG_ASSERT(strlen(error_str) < VIO_ERRMSG_SIZE);
+
+  memcpy(buf, error_str, strlen(error_str));
+  buf[strlen(error_str)] = '\0';
+}
+
 /*
   Buffered read: if average read size is small it may
   reduce number of syscalls.
-- 
2.23.0

