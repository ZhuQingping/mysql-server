diff --git a/mysql-test/suite/sys_vars/r/rds_conn_log_error_verbosity_basic.result b/mysql-test/suite/sys_vars/r/rds_conn_log_error_verbosity_basic.result
new file mode 100644
index 00000000000..b76e4d70c08
--- /dev/null
+++ b/mysql-test/suite/sys_vars/r/rds_conn_log_error_verbosity_basic.result
@@ -0,0 +1,32 @@
+set @save_rds_conn_log_error_verbosity = @@global.rds_conn_log_error_verbosity;
+# Default value
+SELECT @save_rds_conn_log_error_verbosity;
+@save_rds_conn_log_error_verbosity
+0
+# valid value
+set global rds_conn_log_error_verbosity = 0;
+select @@global.rds_conn_log_error_verbosity;
+@@global.rds_conn_log_error_verbosity
+0
+set global rds_conn_log_error_verbosity = 1;
+select @@global.rds_conn_log_error_verbosity;
+@@global.rds_conn_log_error_verbosity
+1
+set global rds_conn_log_error_verbosity = 2;
+select @@global.rds_conn_log_error_verbosity;
+@@global.rds_conn_log_error_verbosity
+2
+set global rds_conn_log_error_verbosity = 3;
+Warnings:
+Warning	1292	Truncated incorrect rds_conn_log_error_verbosity value: '3'
+select @@global.rds_conn_log_error_verbosity;
+@@global.rds_conn_log_error_verbosity
+2
