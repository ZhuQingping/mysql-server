+class Get_conn_err_msg_test : public ::testing::Test {};
+TEST_F(Get_conn_err_msg_test, get_conn_err_msg_test) {
+  char buf[VIO_ERRMSG_SIZE];
+  vio_get_err_msg(EBADF, buf);
+  EXPECT_EQ(
+      0,
+      strcmp(buf, "The argument sockfd is an invalid file descriptor.(EBADF)"));
+  vio_get_err_msg(ECONNREFUSED, buf);
+  EXPECT_EQ(0, strcmp(buf,
+                      "A remote host refused to allow the network "
+                      "connection.(ECONNREFUSED)"));
+  vio_get_err_msg(EFAULT, buf);
+  EXPECT_EQ(0, strcmp(buf,
+                      "The receive buffer pointer(s) point outside the "
+                      "process's address space.(EFAULT)"));
+
+  vio_get_err_msg(EINTR, buf);
+  EXPECT_EQ(0, strcmp(buf,
+                      "The receive was interrupted by delivery of a signal "
+                      "before any data were available.(EINTR)"));
+
+  vio_get_err_msg(EINVAL, buf);
+  EXPECT_EQ(0, strcmp(buf, "Invalid argument passed.(EINVAL)"));
+
+  vio_get_err_msg(ENOMEM, buf);
+  EXPECT_EQ(0, strcmp(buf, "Could not allocate memory for recvmsg().(ENOMEM)"));
+
+  vio_get_err_msg(ENOTCONN, buf);
+  EXPECT_EQ(0, strcmp(buf, "The socket is not connected.(ENOTCONN)"));
+
+  vio_get_err_msg(ENOTSOCK, buf);
+  EXPECT_EQ(
+      0,
+      strcmp(
+          buf,
+          "The file descriptor sockfd does not refer to a socket.(ENOTSOCK)"));
+
+  vio_get_err_msg(ETIMEDOUT, buf);
+  EXPECT_EQ(0, strcmp(buf, "Connection timed out.(ETIMEDOUT)"));
+
+  vio_get_err_msg(EPIPE, buf);
+  EXPECT_EQ(0, strcmp(buf, "Connection reset by peer.(EPIPE)"));
+
+  vio_get_err_msg(ECONNRESET, buf);
+  EXPECT_EQ(0, strcmp(buf, "Connection reset by peer.(ECONNRESET)"));
+
+  vio_get_err_msg(0, buf);
+  EXPECT_EQ(0, strcmp(buf, "Others errors."));
+}
