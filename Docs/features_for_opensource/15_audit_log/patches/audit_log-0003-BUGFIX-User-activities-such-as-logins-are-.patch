+void conn_info_print(ConnectLogType log_type, const char *format, ...) {
+  /* rds_conn_log_error_verbosity value range:0, 1, 2 */
+  switch (rds_conn_log_error_verbosity) {
+    case 0:  // not log conn info to err log
+      return;
+    case 1:  // log abnormal conn info to err log
+      if (log_type != ConnectLogType::ABNORMAL) return;
+      break;
+    case 2:  // log abnornal and normal conn info to err log
+      break;
+    default:  // never go to this logic
+      DBUG_ASSERT(false);
+      break;
+  }
+
+  char buff[MYSQL_ERRMSG_SIZE];
+  va_list args;
+  va_start(args, format);
+  (void)vsnprintf(buff, sizeof(buff), format, args);
+  va_end(args);
+  LogErr(WARNING_LEVEL, ER_RPL_IO_THREAD_KILLED, debug_info_prefix, buff);
+}
