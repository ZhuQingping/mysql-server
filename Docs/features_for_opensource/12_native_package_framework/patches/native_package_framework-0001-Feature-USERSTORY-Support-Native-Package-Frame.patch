+/**
+  PSI memory detect interface;
+*/
+class PSI_memory_base {
+ public:
+  PSI_memory_base(PSI_memory_key key) : m_key(key) {}
+
+  virtual ~PSI_memory_base() {}
+
+  /* Getting */
