diff --git a/mysql-test/suite/rds/r/native_procedure_bugfix.result b/mysql-test/suite/rds/r/native_procedure_bugfix.result
new file mode 100644
index 00000000000..94533640bef
--- /dev/null
+++ b/mysql-test/suite/rds/r/native_procedure_bugfix.result
@@ -0,0 +1,25 @@
+# BUGFIX : mysqld crash in debug mode. Native packages should not be included in stored procedure or function or trigger.
+CREATE FUNCTION func() RETURNS INT
+BEGIN
+call mysql.dummy();
+RETURN 0;
+END|
+ERROR HY000: Explicit or implicit commit is not allowed in stored function or trigger.
+CREATE FUNCTION func() RETURNS INT
+BEGIN
+call mysql.dummy_3(1, 'huawei', 99.9);
+RETURN 0;
+END|
+ERROR HY000: Explicit or implicit commit is not allowed in stored function or trigger.
+CREATE TRIGGER add_outline_after_insert
+AFTER INSERT ON t1 FOR EACH ROW
+BEGIN
+call mysql.dummy();
+END|
+ERROR HY000: Explicit or implicit commit is not allowed in stored function or trigger.
+CREATE TRIGGER show_outline_after_insert
+AFTER INSERT ON t1 FOR EACH ROW
+BEGIN
+call mysql.dummy_3(2, 'amazon', 99.9);
+END|
+ERROR HY000: Explicit or implicit commit is not allowed in stored function or trigger.
