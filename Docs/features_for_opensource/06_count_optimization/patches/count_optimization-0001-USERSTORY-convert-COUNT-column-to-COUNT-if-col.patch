+# FEATURE convert COUNT(col) to COUNT(*) if "col" is not nullable
+create table t1(a int not null, b int, index(b));
+show create table t1;
+Table	Create Table
+t1	CREATE TABLE `t1` (
+  `a` int NOT NULL,
+  `b` int DEFAULT NULL,
+  KEY `b` (`b`)
+) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
+insert into t1 values (1,1),(2,2),(3,3),(5,3),(8,3),(4,-1);
+analyze table t1 update histogram on b;
+Table	Op	Msg_type	Msg_text
+test.t1	histogram	status	Histogram statistics created for column 'b'.
+analyze table t1;
+Table	Op	Msg_type	Msg_text
+test.t1	analyze	status	OK
+create view v1 as select a,a+1 as c,b from t1;
+# First the feature is off, then it is on. There are two things to observe in the "on" case, in EXPLAIN output:
+# - the rewrite to count(0), in the 'Note' line
+# - the "using index", which appears for most queries. Those for which it does not appear, have a good reason:
+# even after the simplification to count(0) there remains reasons why the index on 'b' is not enough (see comments
+# further down).
+set rds_simplify_count_not_null=1-1;
+select @@rds_simplify_count_not_null;
+@@rds_simplify_count_not_null
+0
+# Optimal case, using index only
+explain select count(*) from t1 where b>1;
