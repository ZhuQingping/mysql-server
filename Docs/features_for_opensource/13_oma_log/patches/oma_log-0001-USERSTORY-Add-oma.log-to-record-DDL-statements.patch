+bool Query_logger::oma_log_write(THD *thd, const char *query,
+                                 size_t query_length) {
+  assert(opt_oma_log);
+
+  /* Early return if no log handlers are registered */
+  if (!(*oma_log_handler_list)) return false;
+
+  /*
+   Format user/host information string in the format:
+   "username[user] @ hostname [ip]"
+  */
+  char user_host_buff[MAX_USER_HOST_SIZE + 1];
+  Security_context *sctx = thd->security_context();
+  LEX_CSTRING sctx_user = sctx->user();
+  LEX_CSTRING sctx_host = sctx->host();
+  LEX_CSTRING sctx_ip = sctx->ip();
+
+  strxnmov(user_host_buff, MAX_USER_HOST_SIZE, sctx->priv_user().str, "[",
+           sctx_user.length ? sctx_user.str : "", "] @ ",
+           sctx_host.length ? sctx_host.str : "", " [",
+           sctx_ip.length ? sctx_ip.str : "", "]", NullS);
+
+  /* Calculate query timing metrics */
+  ulonglong current_utime = my_micro_time();
+  ulonglong query_utime, lock_utime;
+  if (thd->start_utime) {
+    query_utime = (current_utime - thd->start_utime);  // Total execution time
+    lock_utime = (thd->utime_after_lock - thd->start_utime);  // Lock wait time
+  } else {
+    query_utime = 0;
+    lock_utime = 0;
+  }
+
+  /*
+    Handle special cases for stored procedures/functions/events to avoid logging
+    potentially sensitive information in the body.
+  */
+  std::stringstream ss_query;
+  if (thd->lex->sql_command == SQLCOM_CREATE_PROCEDURE ||
+      thd->lex->sql_command == SQLCOM_CREATE_SPFUNCTION) {
+    // Already verified in log_oma_applicable
+    assert(thd->lex->sphead != nullptr);
+    ss_query << "CREATE "
+             << (thd->lex->sql_command == SQLCOM_CREATE_PROCEDURE ? "PROCEDURE "
+                                                                  : "FUNCTION ")
+             << thd->lex->sphead->m_name.str << " ... ";
+  } else if (thd->lex->sql_command == SQLCOM_CREATE_EVENT) {
+    // Already verified in log_oma_applicable
+    assert(thd->lex->event_parse_data != nullptr);
+    ss_query << "CREATE EVENT " << thd->lex->event_parse_data->name.str
+             << " ... ";
+  } else {
+    /* For regular queries, log the complete text */
+    ss_query << std::string(query, query_length);
+  }
+
+  /* Acquire read lock for thread-safe access to log handlers */
+  mysql_rwlock_rdlock(&LOCK_logger);
+
+  bool error = false;
+
+  /* Dispatch to all registered log handlers */
+  for (Log_event_handler **current_handler = oma_log_handler_list;
+       *current_handler;) {
+    error |= (*current_handler++)
+                 ->log_oma(thd, current_utime,
+                           (thd->start_time.tv_sec * 1000000ULL) +
+                               thd->start_time.tv_usec,
+                           user_host_buff, query_utime, lock_utime,
+                           ss_query.str().c_str(), ss_query.str().size());
+  }
+
+  /* Release lock */
+  mysql_rwlock_unlock(&LOCK_logger);
+
+  return error;
+}
