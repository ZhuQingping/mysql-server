+   variable is modified to enable/disable logging.
+
+   @param self Pointer to the system variable structure
+   @param thd Thread handler (used for activation)
+   @param type Type of variable being set (GLOBAL/SESSION)
+
+   @retval true if an error occurred during state change
+   @retval false if state was successfully updated
+ */
+static bool fix_oma_log_state(sys_var *, THD *thd, enum_var_type) {
+  bool new_state = opt_oma_log, res = false;
+
+  /* Early return if current state matches requested state */
+  if (query_logger.is_log_file_enabled(QUERY_LOG_OMA) == new_state)
+    return false;
+
+  /* Release global lock during file operations */
+  mysql_mutex_unlock(&LOCK_global_system_variables);
+
+  if (!new_state) {
+    /* Deactivate logging handler */
+    query_logger.deactivate_log_handler(QUERY_LOG_OMA);
+  } else {
+    /* Activate logging handler with thread context */
+    res = query_logger.activate_log_handler(thd, QUERY_LOG_OMA);
+  }
+
+  /* Reacquire global lock */
+  mysql_mutex_lock(&LOCK_global_system_variables);
+
+  /* Maintain consistency - disable if activation failed */
+  if (res) opt_oma_log = false;
+
+  return res;
+}
