+/**
+   Handles the update operation for the OMA (Operating and Maintenance
+   Assistant) log file path. This function is called when the oma_log_file
+   system variable is modified.
+
+   @param self Pointer to the system variable structure
+   @param thd Thread handler (unused in this context)
+   @param type Type of variable being set (GLOBAL/SESSION)
+
+   @retval true if an error occurred during log file update
+   @retval false if log file was successfully updated
+ */
+static bool fix_oma_log_file(sys_var *, THD *, enum_var_type) {
+  bool res;
+
+  /* Handle DEFAULT value assignment */
+  if (!opt_oma_logname)  // SET ... = DEFAULT
+  {
+    char buff[FN_REFLEN];
+    /* Generate default log file path */
+    opt_oma_logname =
+        my_strdup(key_memory_LOG_name, make_query_log_name(buff, QUERY_LOG_OMA),
+                  MYF(MY_FAE + MY_WME));
+    if (!opt_oma_logname) return true;  // Memory allocation failed
+  }
+
+  /* Update log file path in query logger */
+  res = query_logger.set_log_file(QUERY_LOG_OMA);
+
+  /* If logging is active, reopen the log file with new path */
+  if (opt_oma_log) {
+    /* Temporarily release global lock during file operations */
+    mysql_mutex_unlock(&LOCK_global_system_variables);
+
+    if (!res) /* Successful path update - reopen log file */
+      res = query_logger.reopen_log_file(QUERY_LOG_OMA);
+    else
+      /* Path update failed - deactivate logging */
+      query_logger.deactivate_log_handler(QUERY_LOG_OMA);
+
+    /* Reacquire global lock */
+    mysql_mutex_lock(&LOCK_global_system_variables);
+  }
+
+  /* Disable logging if any operation failed */
+  if (res) opt_oma_log = false;
+
+  return res;
+}
