+static bool log_oma_applicable(THD *thd, bool &log_rewritten_query) {
+  assert(nullptr != thd);
+
+  /* Skip failed or rolled back queries */
+  if (thd->transaction_rollback_request || thd->is_error()) {
+    return false;
+  }
+
+  log_rewritten_query = false;
+
+  switch (thd->lex->sql_command) {
+    /*
+      Special cases that are always logged:
+      - CALL statements (log original CALL, not desensitized content)
+      - LOCK/UNLOCK TABLE commands
+    */
+    case SQLCOM_CALL:
+    case SQLCOM_LOCK_TABLES:
+    case SQLCOM_UNLOCK_TABLES:
+      return true;
+
+    /* Only log valid stored procedures/functions */
+    case SQLCOM_CREATE_PROCEDURE:
+    case SQLCOM_CREATE_SPFUNCTION:
+      return (thd->lex->sphead != nullptr);
+
+    /* Only log valid event definitions */
+    case SQLCOM_CREATE_EVENT:
+      return (thd->lex->event_parse_data != nullptr);
+
+    /* Only log specific FLUSH variants that acquire locks */
+    case SQLCOM_FLUSH:
+      return (thd->lex->type & (REFRESH_READ_LOCK | REFRESH_FOR_EXPORT));
+
+    default:
+      break;
+  }
+
+  /* Classify DDL commands */
+  ddl_command_type ddl_type = get_ddl_command_type(thd);
+
+  /*
+    For privilege-related commands, use rewritten query that has
+    sensitive information (like passwords) removed
+  */
+  log_rewritten_query = (ddl_type == DDLCOM_PRIVI);
+
+  /* Log all DDL commands except those classified as NONE */
+  return (ddl_type != DDLCOM_NONE);
+}
+
+void log_oma(THD *thd, bool force_write) {
+  /* Early return if OMA logging is disabled */
+  if (!opt_oma_log) return;
+
+  /* Forced logging path (bypasses all checks) */
+  if (unlikely(force_write)) {
+    assert(thd != nullptr);
+    THD_STAGE_INFO(thd, stage_logging_oma);
+    query_logger.oma_log_write(thd, thd->query().str, thd->query().length);
+    return;
+  }
+
+  /* Normal logging path with applicability checks */
+  bool log_rewritten_query = false;
+  if (log_oma_applicable(thd, log_rewritten_query)) {
+    THD_STAGE_INFO(thd, stage_logging_oma);
+    /* Use rewritten query for privilege commands if available */
+    if (log_rewritten_query && thd->rewritten_query().length()) {
+      query_logger.oma_log_write(thd, thd->rewritten_query().ptr(),
+                                 thd->rewritten_query().length());
+    } else {
+      /* Fall back to original query text */
+      query_logger.oma_log_write(thd, thd->query().str, thd->query().length);
+    }
+  }
+}
