+bool File_query_log::write_oma(THD *thd, ulonglong current_utime,
+                               ulonglong query_start_utime,
+                               const char *user_host, ulonglong query_utime,
+                               ulonglong lock_utime, const char *sql_text,
+                               size_t sql_text_len) {
+  char buff[80], *end;
+  char query_time_buff[22 + 7], lock_time_buff[22 + 7];
+  size_t buff_len;
+  end = buff;
+
+  mysql_mutex_lock(&LOCK_log);
+  assert(is_open());
+
+  if (!(specialflag & SPECIAL_SHORT_LOG_FORMAT)) {
+    char my_timestamp[iso8601_size];
+
+    make_iso8601_timestamp(my_timestamp, current_utime,
+                           iso8601_sysvar_logtimestamps);
+
+    /* Write timestamp line to log */
+    buff_len = snprintf(buff, sizeof(buff), "# Time: %s\n", my_timestamp);
+    /* Note that my_b_write() assumes it knows the length for this */
+    if (my_b_write(&log_file, (uchar *)buff, buff_len)) goto err;
+
+    /* Write user/host and thread ID information */
+    buff_len = snprintf(buff, 32, "%5u", thd->thread_id());
+    if (my_b_printf(&log_file, "# User@Host: %s  Id: %s\n", user_host, buff) ==
+        (uint)-1)
+      goto err;
+  }
+
+  /* Convert microsecond times to seconds with 6 decimal places */
+  sprintf(query_time_buff, "%.6f", ulonglong2double(query_utime) / 1000000.0);
+  sprintf(lock_time_buff, "%.6f", ulonglong2double(lock_utime) / 1000000.0);
+
+  /* Write query metrics (execution time, lock time, rows processed) */
+  if (my_b_printf(&log_file,
+                  "# Query_time: %s  Lock_time: %s"
+                  " Rows_sent: %lu  Rows_examined: %lu\n",
+                  query_time_buff, lock_time_buff,
+                  (ulong)thd->get_sent_row_count(),
+                  (ulong)thd->get_examined_row_count()) == (uint)-1) {
+    goto err;
+  }
+
+  /* Write database context if it has changed */
+  if (thd->db().str &&
+      strncmp(thd->db().str, db, thd->db().length)) {  // Database changed
+    if (my_b_printf(&log_file, "use %s;\n", thd->db().str) == (uint)-1)
+      goto err;
+    my_stpcpy(db, thd->db().str);
+  }
+
+  /*
+    The timestamp used to only be set when the query had checked the
+    start time.
+  */
+  end = my_stpcpy(end, ",timestamp=");
+  end = longlong10_to_str(query_start_utime / 1000000, end, 10);
+
+  /* Write SET timestamp command if needed */
+  if (end != buff) {
+    *end++ = ';';
+    *end = '\n';
+    if (my_b_write(&log_file, pointer_cast<const uchar *>("SET "), 4) ||
+        my_b_write(&log_file, (uchar *)buff + 1, (uint)(end - buff)))
+      goto err;
+  }
+
+  /* Write the actual SQL query and closing semicolon */
+  if (my_b_write(&log_file, pointer_cast<const uchar *>(sql_text),
+                 sql_text_len) ||
+      my_b_write(&log_file, pointer_cast<const uchar *>(";\n"), 2) ||
+      flush_io_cache(&log_file))
+    goto err;
+
+  mysql_mutex_unlock(&LOCK_log);
+  return false;
+err:
+  check_and_print_write_error();
+  mysql_mutex_unlock(&LOCK_log);
+  return true;
+}
