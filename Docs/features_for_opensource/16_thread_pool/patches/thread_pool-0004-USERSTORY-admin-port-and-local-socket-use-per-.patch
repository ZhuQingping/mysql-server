+
+connect(tcp_conn4,127.0.0.1,root,,,$MASTER_MYPORT);
+SHOW GLOBAL STATUS LIKE 'Threads_connected';
+SHOW GLOBAL STATUS LIKE 'THREADPOOL_ACTIVE_CONNECTIONS';
+
+connection default;
+set global threadpool_enabled=ON;
+connect(tcp_conn5,127.0.0.1,root,,,$MASTER_MYPORT);
+disconnect tcp_conn5;
+
+connection default;
+set global threadpool_enabled=OFF;
+connect(tcp_conn5,127.0.0.1,root,,,$MASTER_MYPORT);
+disconnect tcp_conn5;
+--echo # Cleanup
+
+connection default;
+SET @@global.rds_local_socket_using_per_thread = @global_rds_local_socket_using_per_thread;
+SET @@global.threadpool_enabled = @global_threadpool_enabled;
+disconnect socket_conn1;
+disconnect socket_conn2;
+disconnect socket_conn3;
+disconnect socket_conn4;
+disconnect tcp_conn1;
+disconnect tcp_conn2;
+disconnect tcp_conn3;
+disconnect tcp_conn4;
+
+# Wait till we reached the initial number of concurrent sessions
+--source include/wait_until_count_sessions.inc
+
