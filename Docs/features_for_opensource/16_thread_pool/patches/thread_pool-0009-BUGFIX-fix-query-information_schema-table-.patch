+SELECT * FROM information_schema.thread_pool_waits LIMIT 1;
+REASON	COUNT
+#	#
+SET GLOBAL threadpool_enabled = OFF;
+SHOW GLOBAL VARIABLES LIKE "threadpool_enabled";
+Variable_name	Value
+threadpool_enabled	OFF
+SELECT * FROM information_schema.thread_pool_groups;
+GROUP_ID	CONNECTIONS	THREADS	ACTIVE_THREADS	STANDBY_THREADS	LOWPRIO_QUEUE_LENGTH	HIGHPRIO_QUEUE_LENGTH	HAS_LISTENER	IS_STALLED	THREADPOOL_SIZE	CPU_COUNT	CPU_TIME	WAIT_TIME	DEQUEUED EVENTS	EVENT_COUNT	IO_EVENT_COUNT
+SELECT * FROM information_schema.thread_pool_stats;
+GROUP_ID	THREAD_CREATIONS	THREAD_CREATIONS_DUE_TO_STALL	WAKES	WAKES_DUE_TO_STALL	THROTTLES	STALLS	POLLS_BY_LISTENER	POLLS_BY_WORKER	DEQUEUES_BY_LISTENER	DEQUEUES_BY_WORKER	KICKUPS	THREAD_CREATIONS_QUEUE_PUT_CONNECTION	THREAD_CREATIONS_WAIT_BEGIN	THREAD_CREATIONS_SINGLE_LISTENER	THREAD_CREATION_ATTEMPTS	THREAD_REMOVES	CPU_TIMER	EVENTS_HANDLED_CUR
+SELECT * FROM information_schema.thread_pool_queues;
+GROUP_ID	POSITION	PRIORITY	CONNECTION_ID	QUEUEING_TIME_MICROSECONDS	QUEUEING_HTIME_MICROSECONDS	TICKETS	KICKUP
+SELECT * FROM information_schema.thread_pool_waits;
+REASON	COUNT
+SET GLOBAL threadpool_enabled = @orig_threadpool_enabled;
+SELECT * FROM information_schema.thread_pool_groups LIMIT 1;
+GROUP_ID	CONNECTIONS	THREADS	ACTIVE_THREADS	STANDBY_THREADS	LOWPRIO_QUEUE_LENGTH	HIGHPRIO_QUEUE_LENGTH	HAS_LISTENER	IS_STALLED	THREADPOOL_SIZE	CPU_COUNT	CPU_TIME	WAIT_TIME	DEQUEUED EVENTS	EVENT_COUNT	IO_EVENT_COUNT
+#	#	#	#	#	#	#	#	#	#	#	#	#	#	#	#
+SELECT * FROM information_schema.thread_pool_stats LIMIT 1;
+GROUP_ID	THREAD_CREATIONS	THREAD_CREATIONS_DUE_TO_STALL	WAKES	WAKES_DUE_TO_STALL	THROTTLES	STALLS	POLLS_BY_LISTENER	POLLS_BY_WORKER	DEQUEUES_BY_LISTENER	DEQUEUES_BY_WORKER	KICKUPS	THREAD_CREATIONS_QUEUE_PUT_CONNECTION	THREAD_CREATIONS_WAIT_BEGIN	THREAD_CREATIONS_SINGLE_LISTENER	THREAD_CREATION_ATTEMPTS	THREAD_REMOVES	CPU_TIMER	EVENTS_HANDLED_CUR
+#	#	#	#	#	#	#	#	#	#	#	#	#	#	#	#	#	#	#
+SELECT * FROM information_schema.thread_pool_queues LIMIT 1;
+GROUP_ID	POSITION	PRIORITY	CONNECTION_ID	QUEUEING_TIME_MICROSECONDS	QUEUEING_HTIME_MICROSECONDS	TICKETS	KICKUP
+SELECT * FROM information_schema.thread_pool_waits LIMIT 1;
+REASON	COUNT
+#	#
