+inline unsigned long long int my_cputime_clock() {
+#ifdef HAVE_CLOCK_GETTIME
+  struct timespec tp;
+  clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &tp);
+  return (static_cast<unsigned long long int>(tp.tv_sec) * 1000000 +
+          static_cast<unsigned long long int>(tp.tv_nsec) / 1000);
+#else
+  return clock();
+#endif /* HAVE_CLOCK_GETTIME */
+}
