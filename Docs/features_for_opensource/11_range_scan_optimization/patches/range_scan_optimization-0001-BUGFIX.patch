index 00000000000..7749a73ea81
--- /dev/null
+++ b/mysql-test/r/range_bugs.result
@@ -0,0 +1,25 @@
+set default_storage_engine=innodb;
+create table t1 (a int primary key, b int);
+insert into t1 values (100,100);
+create table t2 (a int, key(a) );
+insert into t2 values (101),(102),(103),(104);
+analyze table t1,t2;
+Table	Op	Msg_type	Msg_text
+test.t1	analyze	status	OK
+test.t2	analyze	status	OK
+explain format=tree select * from t1, t2 where t1.a=100 and t2.a>=t1.b-20 and t2.a<t1.b;
+EXPLAIN
+-> Filter: ((t2.a >= <cache>(('100' - 20))) and (t2.a < '100'))  (cost=0.46 rows=1)
+    -> Covering index range scan on t2 using a over (80 <= a < 100)  (cost=0.46 rows=1)
+
+select * from t1, t2 where t1.a=100 and t2.a>=t1.b-20 and t2.a<t1.b;
+a	b	a
+explain format=tree select * from (t1, t1 as t3) left join t2 on t2.a>=t1.b-20 and t2.a<t1.b where t1.a=100;
+EXPLAIN
+-> Left hash join (no condition)  (cost=0.92 rows=1)
+    -> Table scan on t3  (cost=0.35 rows=1)
+    -> Hash
+        -> Filter: ((t2.a >= <cache>(('100' - 20))) and (t2.a < '100'))  (cost=0.46 rows=1)
+            -> Covering index range scan on t2 using a over (80 <= a < 100)  (cost=0.46 rows=1)
+
+drop table t1,t2;
diff --git a/mysql-test/t/range_bugs.test b/mysql-test/t/range_bugs.test
new file mode 100644
index 00000000000..47e2465dc11
--- /dev/null
+++ b/mysql-test/t/range_bugs.test
@@ -0,0 +1,17 @@
+# BUGFIX range optimizer scanning too many index cells in TPC-C
+
+set default_storage_engine=innodb;
+create table t1 (a int primary key, b int);
+insert into t1 values (100,100);
+create table t2 (a int, key(a) );
+insert into t2 values (101),(102),(103),(104);
+
+analyze table t1,t2;
+
+explain format=tree select * from t1, t2 where t1.a=100 and t2.a>=t1.b-20 and t2.a<t1.b;
+select * from t1, t2 where t1.a=100 and t2.a>=t1.b-20 and t2.a<t1.b;
+
+# Similar case, but within an ON condition of a LEFT JOIN
+explain format=tree select * from (t1, t1 as t3) left join t2 on t2.a>=t1.b-20 and t2.a<t1.b where t1.a=100;
+
+drop table t1,t2;
\ No newline at end of file
diff --git a/sql/sql_optimizer.cc b/sql/sql_optimizer.cc
index f7584027275..ac977923250 100644
--- a/sql/sql_optimizer.cc
+++ b/sql/sql_optimizer.cc
@@ -5365,8 +5365,22 @@ bool JOIN::make_join_plan() {
     // Detect tables that are functionally dependent on const values.
     if (extract_func_dependent_tables()) return true;
   }
-  // Possibly able to create more sargable predicates from const rows.
-  if (const_tables && sargables) update_sargable_from_const(sargables);
+
+  if (const_tables) {
+    // Some items inside conditions may now become constants, if they only
+    // depend on columns of constant tables.
+    if (where_cond && (where_cond->used_tables() & const_table_map)) {
+      where_cond->update_used_tables();
+    }
+    for (uint i = const_tables; i < primary_tables; ++i) {
+      auto cond = join_tab[i].join_cond();
+      if (cond && (cond->used_tables() & const_table_map)) {
+        cond->update_used_tables();
+      }
+    }
+    // Possibly able to create more sargable predicates from const rows.
+    if (sargables) update_sargable_from_const(sargables);
+  }
 
   // Make a first estimate of the fanout for each table in the query block.
   if (estimate_rowcount()) return true;
