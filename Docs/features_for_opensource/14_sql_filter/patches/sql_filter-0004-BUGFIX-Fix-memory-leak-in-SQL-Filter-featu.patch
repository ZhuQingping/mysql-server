 mysql-test/suite/sql_filter/t/sqlfilter_basic.test   | 4 ++--
 sql/sql_filter/sql_filter_cache.cc                   | 7 ++++++-
 sql/sql_filter/sql_filter_cache.h                    | 8 ++++++--
 sql/sql_filter/sql_filter_proc.cc                    | 8 --------
 sql/sql_filter/sql_filter_table.cc                   | 4 ----
 sql/sql_filter/sql_filter_table_common.h             | 2 --
 7 files changed, 16 insertions(+), 21 deletions(-)

