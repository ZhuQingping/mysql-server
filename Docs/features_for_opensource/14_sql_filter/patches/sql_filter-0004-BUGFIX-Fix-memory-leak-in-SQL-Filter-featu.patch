 #	SELECT	0	0	2	0	select~format	
-EXPLAIN FORMAT=TREE SELECT a, b FROM tt1 WHERE a=1;
+EXPLAIN FORMAT=TREE SELECT /*+ SET_VAR(optimizer_switch='engine_condition_pushdown=off') */ a, b FROM tt1 WHERE a=1;
 EXPLAIN
 -> Filter: (tt1.a = 1)
     -> Table scan on tt1
@@ -488,7 +488,7 @@ call dbms_sqlfilter.add_sql_filter('SELECT',0,"select~analyze","");
 call dbms_sqlfilter.show_sql_filter();
