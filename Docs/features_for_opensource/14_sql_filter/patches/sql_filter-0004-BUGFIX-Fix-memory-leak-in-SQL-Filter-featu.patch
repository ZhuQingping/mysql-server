-EXPLAIN ANALYZE SELECT a, b FROM tt1 WHERE a=1;
+EXPLAIN ANALYZE SELECT /*+ SET_VAR(optimizer_switch='engine_condition_pushdown=off') */ a, b FROM tt1 WHERE a=1;
 EXPLAIN
 -> Filter: (tt1.a = 1) 
     -> Table scan on tt1 
