+  // set global rds_node_id = NULL.
+  if (var->save_result.string_value.str == nullptr) return true;
+
+  // The length of rds_node_id should not be greater than 36.
+  if (check_string_char_length(to_lex_cstring(var->save_result.string_value),
+                               "", MAX_NODE_ID, system_charset_info, true)) {
+    my_error(ER_WRONG_VALUE_FOR_VAR, MYF(0), self->name.str,
+             var->save_result.string_value.str);
