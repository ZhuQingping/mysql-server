+
+LEX_CSTRING SQL_FILTER_PROC_SCHEMA = {C_STRING_WITH_LEN("dbms_sqlfilter")};
+
+/* Singleton instance for add_sql_filter */
+Proc *Sqlfilter_proc_add::instance() {
+  static Proc *proc = new Sqlfilter_proc_add(key_memory_Sql_filter);
+
+  return proc;
+}
