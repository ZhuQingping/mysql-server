+CREATE PROCEDURE delete_one_sql_filter_rule(IN offset_value INT)
+begin
+declare my_var BIGINT default 1;
+select item_id into my_var from mysql.rds_sql_filter_rules limit offset_value,1;
+call dbms_sqlfilter.delete_sql_filter(my_var);
+end |
+#
+# only rdsAdmin could insert/update/delete mysql.rds_sql_filter_rules table.
+#
+create user 'user1'@'%';
+GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, RELOAD, PROCESS, REFERENCES, INDEX, ALTER, SHOW DATABASES, CREATE TEMPORARY TABLES, LOCK TABLES, EXECUTE, REPLICATION SLAVE, REPLICATION CLIENT, CREATE VIEW, SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, CREATE USER, EVENT, TRIGGER, CREATE ROLE, DROP ROLE ON *.* TO `user1`@`%` WITH GRANT OPTION;
+CREATE user 'user2'@'%';
+grant all privileges on *.* to 'user2'@'%';
+call dbms_sqlfilter.add_sql_filter("select", 10, "select~t","");
+# common user can not execute add_sql_filter/delete_sql_filter/flush_sql_filter
+call dbms_sqlfilter.add_sql_filter("select", 10, "select~t","");
+ERROR 42000: Access denied; you need (at least one of) the SUPER privilege(s) for this operation
