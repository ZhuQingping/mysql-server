+#
+# test add_sql_filter/update_sql_filter/delete_sql_filter not record to binlog
+#
+CREATE PROCEDURE delete_one_sql_filter_rule(IN offset_value INT)
+begin
+declare my_var BIGINT default 1;
+select item_id into my_var from mysql.rds_sql_filter_rules limit offset_value,1;
+call dbms_sqlfilter.delete_sql_filter(my_var);
+end |
+RESET MASTER;
+#
+# excute all sql filter interface: add_sql_filter/update_sql_filter/delete_sql_filter/flush_sql_filter/show_sql_filter
+#
+call dbms_sqlfilter.add_sql_filter("select", 10, "select~t","");
+call dbms_sqlfilter.update_sql_filter(#,'SELECT',100,"SELECT~t6","");
+call dbms_sqlfilter.flush_sql_filter();
+call dbms_sqlfilter.show_sql_filter();
+Item_id	Type	Cur_concur	Max_concur	Key_num	Block_query_num	Key_str	Node_id
+#	SELECT	0	100	2	0	SELECT~t6	
+call dbms_sqlfilter.delete_sql_filter(#);
+create table t(id int);
+drop table t;
+#
+# Show binlog events, no mysql.rds_sql_filter_rules
+#
+show binlog events;
+Log_name	Pos	Event_type	Server_id	End_log_pos	Info
+taurusbin.000001	4	Format_desc	1	126	Server ver: 8.0.41-250900-debug, Binlog ver: 4
+taurusbin.000001	126	Previous_gtids	1	157	
+taurusbin.000001	157	Anonymous_Gtid	1	234	SET @@SESSION.GTID_NEXT= 'ANONYMOUS'
+taurusbin.000001	234	Query	1	344	use `test`; create table t(id int) /* xid=# */
+taurusbin.000001	344	Anonymous_Gtid	1	421	SET @@SESSION.GTID_NEXT= 'ANONYMOUS'
+taurusbin.000001	421	Query	1	547	use `test`; DROP TABLE `t` /* generated by server */ /* xid=# */
+DROP PROCEDURE delete_one_sql_filter_rule;
