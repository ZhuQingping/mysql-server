+  KEY `fkey_history_2` (`h_w_id`,`h_d_id`),
+  CONSTRAINT `fkey_history_1` FOREIGN KEY (`h_c_w_id`, `h_c_d_id`, `h_c_id`) REFERENCES `customer` (`c_w_id`, `c_d_id`, `c_id`),
+  CONSTRAINT `fkey_history_2` FOREIGN KEY (`h_w_id`, `h_d_id`) REFERENCES `district` (`d_w_id`, `d_id`)
+) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
+SHOW CREATE TABLE item;
+Table	Create Table
+item	CREATE TABLE `item` (
+  `i_id` int NOT NULL,
+  `i_im_id` int DEFAULT NULL,
+  `i_name` varchar(24) DEFAULT NULL,
+  `i_price` decimal(5,2) DEFAULT NULL,
+  `i_data` varchar(50) DEFAULT NULL,
+  PRIMARY KEY (`i_id`)
+) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
+SHOW CREATE TABLE new_orders;
+Table	Create Table
+new_orders	CREATE TABLE `new_orders` (
+  `no_o_id` int NOT NULL,
+  `no_d_id` tinyint NOT NULL,
