index 00000000000..7117b3c629f
--- /dev/null
+++ b/mysql-test/suite/pgo/include/tpcc_prepare.inc
@@ -0,0 +1,75 @@
+########################################################################
+#
+# SUMMARY
+#
+#   Create and populate table(s) using the TPC-C schema
+#
+# USAGE
+#   --source suite/pgo/include/tpcc_prepare.inc
+#
+########################################################################
+
+--disable_query_log
+--disable_result_log
+--disable_abort_on_error
+
+--exec unzip -qo $MYSQLTEST_VARDIR/std_data/tpcc10.zip -d $MYSQL_TMP_DIR
+
+SET @OLD_UNIQUE_CHECKS=@@UNIQUE_CHECKS, UNIQUE_CHECKS=0;
+SET @OLD_FOREIGN_KEY_CHECKS=@@FOREIGN_KEY_CHECKS, FOREIGN_KEY_CHECKS=0;
+
+DROP DATABASE IF EXISTS tpcc10;
+
+CREATE DATABASE tpcc10;
+USE tpcc10;
+--echo # load tpcc data
+--exec $MYSQL --show-warnings --user=root tpcc10 < $MYSQL_TMP_DIR/tpcc10/customer.sql
+--exec $MYSQL --show-warnings --user=root tpcc10 < $MYSQL_TMP_DIR/tpcc10/district.sql
+--exec $MYSQL --show-warnings --user=root tpcc10 < $MYSQL_TMP_DIR/tpcc10/history.sql
+--exec $MYSQL --show-warnings --user=root tpcc10 < $MYSQL_TMP_DIR/tpcc10/item.sql
+--exec $MYSQL --show-warnings --user=root tpcc10 < $MYSQL_TMP_DIR/tpcc10/new_orders.sql
+--exec $MYSQL --show-warnings --user=root tpcc10 < $MYSQL_TMP_DIR/tpcc10/order_line.sql
+--exec $MYSQL --show-warnings --user=root tpcc10 < $MYSQL_TMP_DIR/tpcc10/orders.sql
+--exec $MYSQL --show-warnings --user=root tpcc10 < $MYSQL_TMP_DIR/tpcc10/stock.sql
+--exec $MYSQL --show-warnings --user=root tpcc10 < $MYSQL_TMP_DIR/tpcc10/warehouse.sql
+
+--exec rm -rf $MYSQL_TMP_DIR/tpcc10
+
+SET FOREIGN_KEY_CHECKS=@OLD_FOREIGN_KEY_CHECKS;
+SET UNIQUE_CHECKS=@OLD_UNIQUE_CHECKS;
+
+--echo # analyze tables
+ANALYZE TABLE customer;
+ANALYZE TABLE district;
+ANALYZE TABLE history;
+ANALYZE TABLE item;
+ANALYZE TABLE new_orders;
+ANALYZE TABLE order_line;
+ANALYZE TABLE orders;
+ANALYZE TABLE stock;
+ANALYZE TABLE warehouse;
+
+--enable_result_log
+--enable_query_log
+--enable_abort_on_error
+
+--echo # check table
+SHOW CREATE TABLE customer;
+SHOW CREATE TABLE district;
+SHOW CREATE TABLE history;
+SHOW CREATE TABLE item;
+SHOW CREATE TABLE new_orders;
+SHOW CREATE TABLE order_line;
+SHOW CREATE TABLE orders;
+SHOW CREATE TABLE stock;
+SHOW CREATE TABLE warehouse;
+
+SELECT COUNT(*) FROM customer;
+SELECT COUNT(*) FROM district;
+SELECT COUNT(*) FROM history;
+SELECT COUNT(*) FROM item;
+SELECT COUNT(*) FROM new_orders;
+SELECT COUNT(*) FROM order_line;
+SELECT COUNT(*) FROM orders;
+SELECT COUNT(*) FROM stock;
+SELECT COUNT(*) FROM warehouse;
diff --git a/mysql-test/suite/pgo/include/tpcc_run.inc b/mysql-test/suite/pgo/include/tpcc_run.inc
new file mode 100644
index 00000000000..7ed0dd8b7b1
--- /dev/null
+++ b/mysql-test/suite/pgo/include/tpcc_run.inc
@@ -0,0 +1,97 @@
+##############################################################################
+#
+# SUMMARY
+#
+#   Run TPC-C test on table(s) created by tpcc_prepare.inc
+#
+# USAGE
+#
+#   let loop=10
+#   --source suite/pgo/include/tpcc_run.inc
+#
+##############################################################################
+
+USE tpcc10;
+
+if (!$loop)
+{
+  let $loop = 50;
+}
+
+--disable_query_log
+--disable_result_log
+
+--echo loop : $loop
+while ($loop)
+{
+    let $warehouse_id = `SELECT FLOOR(1 + RAND() * 10)`;
+    let $district_id = `SELECT FLOOR(1 + RAND() * 10)`;
+    let $customer_id = `SELECT FLOOR(1 + RAND() * 3000)`;
+    let $item_id = `SELECT FLOOR(1 + RAND() * 100000)`;
+    let $order_id = `SELECT FLOOR(3000 + RAND() * 10000)`;
+
+    --echo # do new order
+    BEGIN;
+    --eval SELECT d_next_o_id, d_tax FROM district WHERE d_id = $district_id AND d_w_id = $warehouse_id FOR UPDATE;
+    --eval UPDATE district SET d_next_o_id = d_next_o_id + 1 WHERE d_id = $district_id AND d_w_id = $warehouse_id
+    --eval INSERT INTO orders (o_id, o_d_id, o_w_id, o_c_id, o_entry_d, o_carrier_id, o_ol_cnt, o_all_local) VALUES ($order_id, $district_id, $warehouse_id, $customer_id, NOW(), NULL, 5, 1);
+    --eval INSERT INTO new_orders (no_o_id, no_d_id, no_w_id) VALUES ($order_id, $district_id, $warehouse_id);
+    --eval SELECT i_price, i_name, i_data FROM item WHERE i_id = $item_id;
+    --eval SELECT s_quantity, s_data, s_dist_01, s_dist_02, s_dist_03, s_dist_04, s_dist_05, s_dist_06, s_dist_07, s_dist_08, s_dist_09, s_dist_10 FROM stock WHERE s_i_id = $item_id AND s_w_id = $warehouse_id FOR UPDATE;
+    # insert order_line
+    let $i = 1;
+    while ($i <= 5) {
+        --eval INSERT INTO order_line (ol_o_id, ol_d_id, ol_w_id, ol_number, ol_i_id, ol_supply_w_id, ol_quantity, ol_amount, ol_dist_info) VALUES ($order_id, $district_id, $warehouse_id, $i, $item_id, $warehouse_id, 5, 10.50, 'dist_info')
+        inc $i;
+        inc $item_id;
+    }
+    # update stock
+    --eval UPDATE stock SET s_quantity = s_quantity - 5 WHERE s_i_id = $item_id AND s_w_id = $warehouse_id;
+    COMMIT;
+
+    --echo # do payment
+    BEGIN;
+    --eval UPDATE warehouse SET w_ytd = w_ytd + 100 WHERE w_id = $warehouse_id;
+    --eval UPDATE district SET d_ytd = d_ytd + 100 WHERE d_id = $district_id AND d_w_id = $warehouse_id;
+    --eval SELECT count(c_id) FROM customer WHERE c_w_id = $warehouse_id AND c_d_id = $district_id;
+    --eval SELECT c_first, c_middle, c_last, c_street_1, c_street_2, c_city, c_state, c_zip, c_phone, c_credit, c_credit_lim, c_discount, c_balance, c_since FROM customer WHERE c_w_id = $warehouse_id AND c_d_id = $district_id AND c_id = $customer_id FOR UPDATE;
+    --eval UPDATE customer SET c_balance = c_balance - 100, c_ytd_payment = c_ytd_payment + 100 WHERE c_id = $customer_id AND c_d_id = $district_id AND c_w_id = $warehouse_id;
+    --eval INSERT INTO history (h_c_id, h_c_d_id, h_c_w_id, h_d_id, h_w_id, h_date, h_amount, h_data) VALUES ($customer_id, $district_id, $warehouse_id, $district_id, $warehouse_id, NOW(), 100, 'Payment');
+    COMMIT;
+
+    --echo # do order stat
+    BEGIN;
+    --eval SELECT count(c_id) FROM customer WHERE c_w_id = $warehouse_id AND c_d_id = $district_id AND c_last = "ABLEABLEANTI";
+    --eval SELECT c_balance, c_first, c_middle, c_last FROM customer WHERE c_w_id = $warehouse_id AND c_d_id = $district_id AND c_last = "ABLEABLEANTI" ORDER BY c_first;
+    --eval SELECT o_id, o_carrier_id, o_entry_d FROM orders WHERE o_w_id = $warehouse_id AND o_d_id = $district_id AND o_c_id = $customer_id ORDER BY o_id DESC LIMIT 1;
+    --eval SELECT o_id, o_entry_d, COALESCE(o_carrier_id,0) FROM orders WHERE o_w_id = $warehouse_id AND o_d_id = $district_id AND o_c_id = $customer_id AND o_id = (SELECT MAX(o_id) FROM orders WHERE o_w_id = $warehouse_id AND o_d_id = $district_id AND o_c_id = $customer_id);
+    --eval SELECT ol_i_id, ol_supply_w_id, ol_quantity, ol_amount, ol_delivery_d FROM order_line WHERE ol_w_id = $warehouse_id AND ol_d_id = $district_id AND ol_o_id = $order_id;
+    COMMIT;
+
+    --echo # do delivery
+    BEGIN;
+    --eval SELECT COALESCE(MIN(no_o_id),0) FROM new_orders WHERE no_d_id = $district_id AND no_w_id = $warehouse_id;
+    --eval SELECT no_o_id INTO @order_id FROM new_orders WHERE no_w_id = $warehouse_id AND no_d_id = $district_id ORDER BY no_o_id ASC LIMIT 1;
+    --eval UPDATE orders SET o_carrier_id = 1 WHERE o_id = $order_id AND o_d_id = $district_id AND o_w_id = $warehouse_id;
+    --eval UPDATE order_line SET ol_delivery_d = NOW() WHERE ol_o_id = $order_id AND ol_d_id = $district_id AND ol_w_id = $warehouse_id;
+    --eval DELETE FROM new_orders WHERE no_o_id = $order_id AND no_d_id = $district_id AND no_w_id = $warehouse_id;
+    --eval SELECT SUM(ol_amount) FROM order_line WHERE ol_o_id = $order_id AND ol_d_id = $district_id AND ol_w_id = $warehouse_id;
+    --eval UPDATE customer SET c_balance = c_balance + 100 , c_delivery_cnt = c_delivery_cnt + 1 WHERE c_id = $customer_id AND c_d_id = $district_id AND c_w_id = $warehouse_id;
+    COMMIT;
+
+    --echo # do stock level
+    BEGIN;
+    --eval SELECT d_next_o_id FROM district WHERE d_id = $district_id AND d_w_id = $warehouse_id;
+    --eval SELECT DISTINCT ol_i_id FROM order_line WHERE ol_w_id = $warehouse_id AND ol_d_id = $district_id AND ol_o_id < $order_id AND ol_o_id >= 1500;
+    --eval SELECT COUNT(*) FROM stock WHERE s_w_id = $warehouse_id AND s_i_id = $item_id AND s_quantity < 10;
+    COMMIT;
+
+    dec $loop;
+}
+
+--enable_result_log
+--enable_query_log
+
+--echo # check data
+--eval SELECT COUNT(*) AS orphaned_new_orders FROM new_orders no LEFT JOIN orders o ON no.no_o_id = o.o_id AND no.no_d_id = o.o_d_id AND no.no_w_id = o.o_w_id WHERE o.o_id IS NULL;
+--eval SELECT COUNT(*) AS inconsistent_stock FROM stock WHERE s_quantity < 0;
diff --git a/mysql-test/suite/pgo/my.cnf b/mysql-test/suite/pgo/my.cnf
new file mode 100644
index 00000000000..8ab17fc3bcc
--- /dev/null
+++ b/mysql-test/suite/pgo/my.cnf
@@ -0,0 +1,174 @@
+# my.cnf for the PGO training suite. This should be as close as
+# possible to my.cnf used on production systems, with the exception of
+# resource consumption, because resources on build slaves are usually
+# limited. That is why buffer sizes are left at their default values.
+
+!include include/default_client.cnf
+
+[mysqld.1]
+
+connect-timeout=60
+
+# When binary logging is enabled, this variable controls whether
+# stored function creators can be trusted not to create stored
+# functions that will cause unsafe events to be written to the binary log.
+# Set it to 1 so that no restrictions are enforced on
+# stored function creation.
+log-bin-trust-function-creators=1
+
+# Running MTR with --mem causes var directories to be created in memory.
+# Set innodb-buffer-pool-size and innodb-redo-log-capacity to a lower
+# value because running tests in parallel, on the ramdisk may consume
+# excessive memory.
+innodb-buffer-pool-size=24M
+innodb-redo-log-capacity=10M
+# MAINTAINER:
+# the loose- syntax is to make sure the cnf file is also
+# valid when building without the performance schema.
+
+# Run tests with the performance schema instrumentation
+loose-enable-performance-schema
+# Run tests with a small number of instrumented objects
+# to limit memory consumption with MTR
+loose-performance-schema-accounts-size=100
+loose-performance-schema-digests-size=200
+loose-performance-schema-hosts-size=100
+loose-performance-schema-users-size=100
+loose-performance-schema-setup-actors-size=100
+loose-performance-schema-setup-objects-size=100
+
+loose-performance-schema-events-waits-history-size=10
+loose-performance-schema-events-waits-history-long-size=10000
+loose-performance-schema-events-stages-history-size=10
+loose-performance-schema-events-stages-history-long-size=1000
+loose-performance-schema-events-statements-history-size=10
+loose-performance-schema-events-statements-history-long-size=1000
+loose-performance-schema-events-transactions-history-size=10
+loose-performance-schema-events-transactions-history-long-size=1000
+loose-performance-schema-session-connect-attrs-size=2048
+
+# Enable everything, for maximun code exposure during testing
+
+loose-performance-schema-instrument='%=ON'
+
+loose-performance-schema-consumer-events-stages-current=ON
+loose-performance-schema-consumer-events-stages-history=ON
+loose-performance-schema-consumer-events-stages-history-long=ON
+loose-performance-schema-consumer-events-statements-cpu=ON
+loose-performance-schema-consumer-events-statements-current=ON
+loose-performance-schema-consumer-events-statements-history=ON
+loose-performance-schema-consumer-events-statements-history-long=ON
+loose-performance-schema-consumer-events-transactions-current=ON
+loose-performance-schema-consumer-events-transactions-history=ON
+loose-performance-schema-consumer-events-transactions-history-long=ON
+loose-performance-schema-consumer-events-waits-current=ON
+loose-performance-schema-consumer-events-waits-history=ON
+loose-performance-schema-consumer-events-waits-history-long=ON
+loose-performance-schema-consumer-global-instrumentation=ON
+loose-performance-schema-consumer-thread-instrumentation=ON
+
+# Set LOG_ERROR_VERBOSITY to 3 as default for MTR tests. This will
+# make sure that even note messeges are getting logged in mysqld error
+# log file. The note messages will contain important information and
+# will be useful while debugging an issue as well.
+log-error-verbosity=3
+storage_engine_mode=BOTH_STORAGE_ENGINE
+rds_permission_control=OFF
+loose-rds_restricted_dynamic_privileges_control=OFF
+loose-rds_extended_partitions_enabled = ON
+loose-rds_disable_user_defined_functions = OFF
+
+bind-address=0.0.0.0
+binlog-ignore-db=information_schema
+binlog_format=ROW
+character_set_server=UTF8MB4
+default_storage_engine=Dstore
+innodb_stats_include_delete_marked=ON
+enforce_gtid_consistency=ON
+expire_logs_days=1
+explicit_defaults_for_timestamp=OFF
+gtid_mode=on
+
+innodb_file_per_table=ON
+innodb_flush_method=O_DIRECT
+
+log_bin_trust_function_creators=ON
+log_slave_updates=true
+
+master_info_repository=TABLE
+max_binlog_size=67108864
+
+relay-log=rds_mysql-relay-bin
+replicate_ignore_db=information_schema
+
+skip-name-resolve
+
+slave_parallel_workers=2
+slow_query_log=ON
+
+sql_mode=NO_ENGINE_SUBSTITUTION,STRICT_ALL_TABLES
+sync_binlog=1
+
+slave_parallel_type=LOGICAL_CLOCK
+performance_schema=OFF
+
+block_encryption_mode=aes-128-cbc
+binlog_error_action=ABORT_SERVER
+
+relay_log_info_repository=FILE
+local_infile=ON
+skip_external_locking=ON
+max_allowed_packet=1073741824
+
+innodb_flush_neighbors=0
+innodb_io_capacity=12000
+innodb_io_capacity_max=24000
+
+innodb_page_cleaners=16
+
+innodb_adaptive_hash_index=1
+
+threadpool_enabled=ON
+threadpool_size=128
+
+transaction_isolation=READ-COMMITTED
+table_open_cache=16384
+table_open_cache_instances=64
+thread_cache_size=128
+
+dstore_buffer=131072
+dstore_buffer_lru_partition=256
+dstore_check_point_timeout=60
+dstore_maintenance_work_mem=65536
+dstore_ncores=2770
+dstore_log_min_messages=7
+dstore_fold_period=0
+dstore_fold_level=0
+dstore_lock_hash_table_size=28160
+dstore_lock_table_partition_num=16
+dstore_enable_lazy_lock=false
+dstore_vfs_tenant_isolation_config_path=null
+dstore_num_obj_space_mgr_workers=5
+dstore_prob_of_extension_threshold=1
+dstore_wal_level=2
+dstore_recovery_worker_num=1
+dstore_synchronous_commit=true
+dstore_wal_file_size=3221225472
+dstore_wal_buffers=131072
+dstore_wal_flush_timeout=300
+dstore_wal_read_buffer_size=536870912
+dstore_wal_redo_buffer_size=268435456
+dstore_wal_writer_cpu_bind=48
+dstore_wal_keep_segments=16
+dstore_bg_wal_writer_min_bytes=51200
+dstore_wal_each_write_lenghth_limit=524288
+dstore_disable_btree_page_recycle=false
+dstore_deadlock_time_interval=20000
+dstore_bg_disk_writer_slave_num=1
+dstore_bg_page_writer_sleep_millisecond=2000
+dstore_wal_throttling_size=838860800
+dstore_max_io_capacity_kb=1048576
+dstore_bulk_read_ring_size=16384
+dstore_bulk_write_ring_size=2097152
+dstore_csn_thread_bind_cpu=33
+dstore_enable_perf_timers=false
