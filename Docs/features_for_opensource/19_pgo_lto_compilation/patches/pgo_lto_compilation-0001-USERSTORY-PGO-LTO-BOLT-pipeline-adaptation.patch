diff --git a/mysql-test/suite/pgo/r/tpcc_oltp.result b/mysql-test/suite/pgo/r/tpcc_oltp.result
new file mode 100644
index 00000000000..eccd780f7fd
--- /dev/null
+++ b/mysql-test/suite/pgo/r/tpcc_oltp.result
@@ -0,0 +1,454 @@
+SELECT @@dstore_buffer;
+@@dstore_buffer
+131072
+SELECT @@sql_mode;
+@@sql_mode
+STRICT_ALL_TABLES,NO_ENGINE_SUBSTITUTION
+SELECT @@performance_schema;
+@@performance_schema
+0
+# load tpcc data
+# analyze tables
+# check table
+SHOW CREATE TABLE customer;
+Table	Create Table
+customer	CREATE TABLE `customer` (
+  `c_id` int NOT NULL,
+  `c_d_id` tinyint NOT NULL,
+  `c_w_id` smallint NOT NULL,
+  `c_first` varchar(16) DEFAULT NULL,
+  `c_middle` char(2) DEFAULT NULL,
+  `c_last` varchar(16) DEFAULT NULL,
+  `c_street_1` varchar(20) DEFAULT NULL,
+  `c_street_2` varchar(20) DEFAULT NULL,
+  `c_city` varchar(20) DEFAULT NULL,
+  `c_state` char(2) DEFAULT NULL,
+  `c_zip` char(9) DEFAULT NULL,
+  `c_phone` char(16) DEFAULT NULL,
+  `c_since` datetime DEFAULT NULL,
+  `c_credit` char(2) DEFAULT NULL,
+  `c_credit_lim` bigint DEFAULT NULL,
+  `c_discount` decimal(4,2) DEFAULT NULL,
+  `c_balance` decimal(12,2) DEFAULT NULL,
+  `c_ytd_payment` decimal(12,2) DEFAULT NULL,
+  `c_payment_cnt` smallint DEFAULT NULL,
+  `c_delivery_cnt` smallint DEFAULT NULL,
+  `c_data` varchar(8192) DEFAULT NULL,
+  PRIMARY KEY (`c_w_id`,`c_d_id`,`c_id`),
+  KEY `idx_customer` (`c_w_id`,`c_d_id`,`c_last`,`c_first`,`c_id`),
+  CONSTRAINT `fkey_customer_1` FOREIGN KEY (`c_w_id`, `c_d_id`) REFERENCES `district` (`d_w_id`, `d_id`)
+) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
+SHOW CREATE TABLE district;
+Table	Create Table
+district	CREATE TABLE `district` (
+  `d_id` tinyint NOT NULL,
+  `d_w_id` smallint NOT NULL,
+  `d_name` varchar(10) DEFAULT NULL,
+  `d_street_1` varchar(20) DEFAULT NULL,
