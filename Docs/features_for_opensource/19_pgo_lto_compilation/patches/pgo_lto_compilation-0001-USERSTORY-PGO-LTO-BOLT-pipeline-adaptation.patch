diff --git a/mysql-test/suite/pgo/include/sysbench_prepare.inc b/mysql-test/suite/pgo/include/sysbench_prepare.inc
new file mode 100644
index 00000000000..c84d02bed0d
--- /dev/null
+++ b/mysql-test/suite/pgo/include/sysbench_prepare.inc
@@ -0,0 +1,50 @@
+########################################################################
+#
+# SUMMARY
+#
+#   Create and populate table(s) using the sysbench OLTP schema
+#
+# USAGE
+#
+#   let $tables=10;
+#   --source suite/pgo/include/sysbench_prepare.inc
+#
+#   $tables defaults to 1.
+#
+########################################################################
+
+if (!$tables)
+{
+  let $tables = 1;
+}
+
+--disable_query_log
+while ($tables)
+{
+  eval CREATE TABLE sbtest$tables(
+    id INTEGER NOT NULL AUTO_INCREMENT,
+    k INTEGER DEFAULT '0' NOT NULL,
+    c CHAR(120) DEFAULT '' NOT NULL,
+    pad CHAR(60) DEFAULT '' NOT NULL,
+    PRIMARY KEY (id)) ENGINE=Dstore;
+  eval INSERT INTO sbtest$tables(id, k, c, pad) VALUES
+    (1, FLOOR(1 + RAND() * 1048576),
+    CONCAT(REPEAT(CONCAT(FLOOR(RAND()*100000000000), '-'), 9), FLOOR(RAND()*100000000000)),
+    CONCAT(REPEAT(CONCAT(FLOOR(RAND()*100000000000), '-'), 4), FLOOR(RAND()*100000000000)));
+  # Generate 2^20 = 1048576 rows
+  let $i = 0;
+  let $base = 1;
+  while ($i < 20)
+  {
+    eval INSERT INTO sbtest$tables(id, k, c, pad)
+      SELECT $base + id, FLOOR(1 + RAND() * 1048576), c, pad FROM sbtest$tables;
+    inc $i;
+    let $base = $base * 2;
+  }
+
+  eval CREATE INDEX k_$tables ON sbtest$tables(k);
+  eval ANALYZE TABLE sbtest$tables;
+
+  dec $tables;
+}
+--enable_query_log
diff --git a/mysql-test/suite/pgo/include/sysbench_run.inc b/mysql-test/suite/pgo/include/sysbench_run.inc
new file mode 100644
index 00000000000..bfde4c4b29e
--- /dev/null
+++ b/mysql-test/suite/pgo/include/sysbench_run.inc
@@ -0,0 +1,101 @@
+
+##############################################################################
+#
+# SUMMARY
+#
+#   Run sysbench OLTP RW benchmark on table(s) created by sysbench_prepare.inc
+#
+# USAGE
+#
+#   let $tables=10;
+#   let transactions=10000
+#   --source suite/pgo/include/sysbench_run.inc
+#
+#   $tables defaults to 1.
+#
+#   $transactions defaults to 500 (should take about 30 seconds on a
+#   PGO-enabled build).
+#
+##############################################################################
+
+if (!$tables)
+{
+  let $tables = 1;
+}
+
+if (!$transactions)
+{
+  let $transactions = 500;
+}
+
+--disable_query_log
+--disable_result_log
+
+while ($transactions)
+{
+  START TRANSACTION;
+
+  # Point SELECTs
+  let $table=`SELECT FLOOR(1 + (RAND() * $tables))`;
+  let $pscount=10;
+  while ($pscount)
+  {
+    let $id=`SELECT FLOOR(1 + RAND() * 1048576)`;
+    eval SELECT * FROM sbtest$table WHERE id=$id;
+    dec $pscount;
+  }
+
+  # Simple range
+  let $table=`SELECT FLOOR(1 + (RAND() * $tables))`;
+  let $id=`SELECT FLOOR(1 + RAND() * 1048576)`;
+  eval SELECT c FROM sbtest$table WHERE id BETWEEN $id and $id+100;
+
+  # Sum range
+  let $table=`SELECT FLOOR(1 + (RAND() * $tables))`;
+  let $id=`SELECT FLOOR(1 + RAND() * 1048576)`;
+  eval SELECT SUM(k) FROM sbtest$table WHERE id BETWEEN $id and $id+100;
+
+  # Order range
+  let $table=`SELECT FLOOR(1 + (RAND() * $tables))`;
+  let $id=`SELECT FLOOR(1 + RAND() * 1048576)`;
+  eval SELECT c FROM sbtest$table WHERE id BETWEEN $id and $id+100 ORDER BY c;
+
+  # Distinct range
+  let $table=`SELECT FLOOR(1 + (RAND() * $tables))`;
+  let $id=`SELECT FLOOR(1 + RAND() * 1048576)`;
+  eval SELECT DISTINCT c FROM sbtest$table WHERE id BETWEEN $id and $id+100 ORDER BY c;
+
+  # Index update
+  let $table=`SELECT FLOOR(1 + (RAND() * $tables))`;
+  let $id=`SELECT FLOOR(1 + RAND() * 1048576)`;
+  eval UPDATE sbtest$table SET k=k+1 WHERE id=$id;
+
+  # Non-index update
+  let $table=`SELECT FLOOR(1 + (RAND() * $tables))`;
+  let $id=`SELECT FLOOR(1 + RAND() * 1048576)`;
+  eval UPDATE sbtest$table
+    SET c=CONCAT(REPEAT(CONCAT(FLOOR(RAND()*100000000000), '-'), 9), FLOOR(RAND()*100000000000))
+    WHERE id=$id;
+
+  # DELETE
+  let $table=`SELECT FLOOR(1 + (RAND() * $tables))`;
+  let $id=`SELECT FLOOR(1 + RAND() * 1048576)`;
+  eval DELETE FROM sbtest$table WHERE id=$id;
+
+  # INSERT
+  eval INSERT INTO sbtest$table VALUES
+    ($id, FLOOR(1 + RAND() * 1048576),
+    CONCAT(REPEAT(CONCAT(FLOOR(RAND()*100000000000), '-'), 9), FLOOR(RAND()*100000000000)),
+    CONCAT(REPEAT(CONCAT(FLOOR(RAND()*100000000000), '-'), 4), FLOOR(RAND()*100000000000)));
+
+  COMMIT;
+
+  dec $transactions;
+}
+
+# Reset transactions, so we don't use its current value (0) on repeated
+# inclusions
+let $transactions=;
+
+--enable_result_log
+--enable_query_log
