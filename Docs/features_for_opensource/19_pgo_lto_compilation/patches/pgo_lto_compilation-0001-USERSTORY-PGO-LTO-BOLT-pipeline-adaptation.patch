+) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
+SHOW CREATE TABLE history;
+Table	Create Table
+history	CREATE TABLE `history` (
+  `h_c_id` int DEFAULT NULL,
+  `h_c_d_id` tinyint DEFAULT NULL,
+  `h_c_w_id` smallint DEFAULT NULL,
