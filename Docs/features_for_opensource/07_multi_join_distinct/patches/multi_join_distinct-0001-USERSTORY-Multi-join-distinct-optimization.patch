+--source include/have_only_dstore.inc
+# Nested loop join and distinct optimization.
+
+--echo # Customer encounter performance regression for "Multi-join + distinct" scenario
+--echo # when they upgrade from MySQL 5.7 to GaussDB(for MySQL) 8.0.22. The reason is
+--echo # that MySQL 8.0 (>=8.0.16) new Volcano iterator executor do not apply distinct
+--echo # optimization for this scenario, even if optimizer already mark "Distinct".
+
+# For example: 
+# mysql> explain select distinct tt1.a from tt1, tt1 as tt2, tt1 as tt3;
+# +----+-------------+-------+------------+-------+---------------+------+---------+------+------+----------+------------------------------+
+# | id | select_type | table | partitions | type  | possible_keys | key  | key_len | ref  | rows | filtered | Extra                        |
+# +----+-------------+-------+------------+-------+---------------+------+---------+------+------+----------+------------------------------+
+# |  1 | SIMPLE      | tt1   | NULL       | index | a             | a    | 5       | NULL |    3 |   100.00 | Using index; Using temporary |
+# |  1 | SIMPLE      | tt2   | NULL       | index | NULL          | a    | 5       | NULL |    3 |   100.00 | Using index; Distinct        |
+# |  1 | SIMPLE      | tt3   | NULL       | index | NULL          | a    | 5       | NULL |    3 |   100.00 | Using index; Distinct        |
+# +----+-------------+-------+------------+-------+---------------+------+---------+------+------+----------+------------------------------+
+
+--echo # Refer to MySQL old version (5.7) optimization ideas, we can stop scan nested
+--echo # loop join inner table when find out one new matched record. We introduce new
+--echo # system variable "rds_nlj_distinct_optimize" to enable/disable this optimization.
+
+--echo #
+--echo # test case: session level hint updateable variable "rds_nlj_distinct_optimize"
+--echo #
+
+# default value
+SHOW VARIABLES LIKE 'rds_nlj_distinct_optimize';
+SET @rds_nlj_distinct_optimize_save=@@rds_nlj_distinct_optimize;
+
+SET @origin_dstore_use_histogram_auto_update=@@global.dstore_use_histogram_auto_update;
+SET GLOBAL dstore_use_histogram_auto_update=OFF;
+
+# session variable
+SET @@SESSION.rds_nlj_distinct_optimize=ON;
+SELECT @@SESSION.rds_nlj_distinct_optimize;
+SET @@SESSION.rds_nlj_distinct_optimize=OFF;
+SELECT @@SESSION.rds_nlj_distinct_optimize;
+
+# update global variable
+SET GLOBAL rds_nlj_distinct_optimize=ON;
+SELECT @@GLOBAL.rds_nlj_distinct_optimize;
+SET GLOBAL rds_nlj_distinct_optimize=OFF;
+SELECT @@GLOBAL.rds_nlj_distinct_optimize;
+SET GLOBAL rds_nlj_distinct_optimize=@rds_nlj_distinct_optimize_save;
+
+# variable hint updateable
+SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=ON) */ @@SESSION.rds_nlj_distinct_optimize;
+SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=OFF) */ @@SESSION.rds_nlj_distinct_optimize;
+
+--echo #
+--echo # test case: we can check this optimization worked by explain format=tree or explain analyze.
+--echo #            "Nested loop inner join distinct" and "Nested loop left join distinct" means
+--echo #            distinct optimization worked. Explain traditional and json format can not help
+--echo #            to check the optimization work or not.
+--echo #
+
+# Prepare table and data
+CREATE TABLE t1(a INT);
+INSERT INTO t1 VALUES(1),(2),(5),(6);
+INSERT INTO t1 VALUES(1),(2),(5),(6);
+ANALYZE TABLE t1;
+
+# Disable hash join
+SET optimizer_switch='block_nested_loop=OFF';
+
+# Nested loop inner join + distinct
+let $query1= SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=ON) */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+let $query2= SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=OFF) */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+
+# Explain traditional format keep same
+--replace_column 10 # 11 #
+eval EXPLAIN $query1;
+--replace_column 10 # 11 #
+eval EXPLAIN $query2;
+
+# Explain tree format are different
+--replace_regex /\(cost=\d+(\.\d+)?(\.\.\d+(\.\d+)?)?\s+rows=\d+(\.\d+)?\)/(cost=X rows=X)/
+eval EXPLAIN FORMAT=TREE $query1;
+--replace_regex /\(cost=\d+(\.\d+)?(\.\.\d+(\.\d+)?)?\s+rows=\d+(\.\d+)?\)/(cost=X rows=X)/
+eval EXPLAIN FORMAT=TREE $query2;
+
+# Explain analyze are different
+--replace_regex /\(cost=.*rows=.*\)\s*\(actual time=.*rows=.*(loops=.*)\)/(cost=X rows=X) (actual time=X rows=X loops=X)/
+eval EXPLAIN ANALYZE $query1;
+--replace_regex /\(cost=.*rows=.*\)\s*\(actual time=.*rows=.*(loops=.*)\)/(cost=X rows=X) (actual time=X rows=X loops=X)/
+eval EXPLAIN ANALYZE $query2;
+
+# Nested loop outer join + distinct
+let $query3= SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=ON) */ DISTINCT tt1.a FROM t1 AS tt1 LEFT JOIN t1 AS tt2 ON tt1.a + 6 > tt2.a LEFT JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+let $query4= SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=OFF) */ DISTINCT tt1.a FROM t1 AS tt1 LEFT JOIN t1 AS tt2 ON tt1.a + 6 > tt2.a LEFT JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+
+# Explain traditional format keep same
+--replace_column 10 # 11 #
+eval EXPLAIN $query3;
+--replace_column 10 # 11 #
+eval EXPLAIN $query4;
+
+# Explain tree format are different
+--replace_regex /\(cost=\d+(\.\d+)?(\.\.\d+(\.\d+)?)?\s+rows=\d+(\.\d+)?\)/(cost=X rows=X)/
+eval EXPLAIN FORMAT=TREE $query3;
+--replace_regex /\(cost=\d+(\.\d+)?(\.\.\d+(\.\d+)?)?\s+rows=\d+(\.\d+)?\)/(cost=X rows=X)/
+eval EXPLAIN FORMAT=TREE $query4;
+
+# Explain analyze are different
+--replace_regex /\(cost=.*rows=.*\)\s*\(actual time=.*rows=.*(loops=.*)\)/(cost=X rows=X) (actual time=X rows=X loops=X)/
+eval EXPLAIN ANALYZE $query3;
+--replace_regex /\(cost=.*rows=.*\)\s*\(actual time=.*rows=.*(loops=.*)\)/(cost=X rows=X) (actual time=X rows=X loops=X)/
+eval EXPLAIN ANALYZE $query4;
+
+--echo #
+--echo # test case: when this optimization worked, scan less records can get distinct result,
+--echo #            then query runs faster compared with no this optimization
+--echo #
+
+--echo # with optimization, handler_read status
+--replace_regex /\(cost=\d+(\.\d+)?(\.\.\d+(\.\d+)?)?\s+rows=\d+(\.\d+)?\)/(cost=X rows=X)/
+eval EXPLAIN FORMAT=TREE $query1;
+FLUSH STATUS;
+eval $query1;
+SELECT SUM(VARIABLE_VALUE) INTO @with_optimize_read1 FROM performance_schema.session_status WHERE VARIABLE_NAME LIKE 'Handler_read%';
+
+--replace_regex /\(cost=\d+(\.\d+)?(\.\.\d+(\.\d+)?)?\s+rows=\d+(\.\d+)?\)/(cost=X rows=X)/
+eval EXPLAIN FORMAT=TREE $query3;
+FLUSH STATUS;
+eval $query3;
+SELECT SUM(VARIABLE_VALUE) INTO @with_optimize_read2 FROM performance_schema.session_status WHERE VARIABLE_NAME LIKE 'Handler_read%';
+
+--echo # without optimization, handler_read status
+--replace_regex /\(cost=\d+(\.\d+)?(\.\.\d+(\.\d+)?)?\s+rows=\d+(\.\d+)?\)/(cost=X rows=X)/
+eval EXPLAIN FORMAT=TREE $query2;
+FLUSH STATUS;
+eval $query2;
+SELECT SUM(VARIABLE_VALUE) INTO @without_optimize_read1 FROM performance_schema.session_status WHERE VARIABLE_NAME LIKE 'Handler_read%';
+
+--replace_regex /\(cost=\d+(\.\d+)?(\.\.\d+(\.\d+)?)?\s+rows=\d+(\.\d+)?\)/(cost=X rows=X)/
+eval EXPLAIN FORMAT=TREE $query4;
+FLUSH STATUS;
+eval $query4;
+SELECT SUM(VARIABLE_VALUE) INTO @without_optimize_read2 FROM performance_schema.session_status WHERE VARIABLE_NAME LIKE 'Handler_read%';
+
+--echo # following check always true
+SELECT IF(@with_optimize_read1 < @without_optimize_read1, 'TRUE', 'FALSE') AS 'check'; 
+SELECT IF(@with_optimize_read2 < @without_optimize_read2, 'TRUE', 'FALSE') AS 'check'; 
+
+# Cleanup
+DROP TABLE t1;
+SET optimizer_switch=DEFAULT;
+
+--echo #
+--echo # test case: this optimization only support:
+--echo #            - nested loop inner join + distinct
+--echo #            - nested loop outer join + distinct
+--echo #            do not support:
+--echo #            - nested loop semi join + distinct
+--echo #            - nested loop anti join + distinct
