+/**
+  Check whether can do distinct optimization for nested loop join.
+
+  @param[in] join_type what kind of join we are executing
+  @param[in] inner_tables tablemap of nested loop join inner tables.
+  @param[in] join pointer of JOIN plan
+  @retval true if we can do distinct optimization for nested loop join, false
+  otherwise.
+*/
+static bool CheckNljDistinctOptimze(JoinType join_type,
+                                    qep_tab_map inner_tables,
+                                    const JOIN *join) {
+  DBUG_ASSERT(join);
+  // Distinct optimization only support Inner or Outer join type. No need to do
+  // distinct optimization for anti-join or semi-join, since access inner table
+  // will stop immediately once find/not find one record.
+  bool inner_not_used_in_distinct = false;
+  if (join_type == JoinType::INNER || join_type == JoinType::OUTER) {
+    inner_not_used_in_distinct = true;
+    plan_idx first_idx = NO_PLAN_IDX;
+    /* Access all inner tables, check whether table not used in distinct. */
+    for (QEP_TAB *tab : TablesContainedIn(join, inner_tables)) {
+      first_idx = (NO_PLAN_IDX == first_idx) ? tab->idx() : first_idx;
+      inner_not_used_in_distinct =
+          (inner_not_used_in_distinct && tab->not_used_in_distinct);
+    }
+#ifndef DBUG_OFF
+    if (inner_not_used_in_distinct && (first_idx != NO_PLAN_IDX)) {
+      // If we can do distinct optimization for nested loop join inner table,
+      // then all tables after current table in the slice should not used in
+      // distinct.
+      bool distinct_optimize = true;
+      for (uint i = first_idx; i < join->primary_tables; i++) {
+        distinct_optimize =
+            (distinct_optimize && join->qep_tab[i].not_used_in_distinct);
+      }
+      assert(distinct_optimize);
+    }
+#endif
+  }
+  return inner_not_used_in_distinct;
