+SET rds_nlj_distinct_optimize=ON;
+let $query= SELECT DISTINCT tt1.a FROM t1 AS tt1 LEFT JOIN t1 AS tt2 ON TRUE LEFT JOIN t1 AS tt3 ON tt2.a + 1 = tt3.a LEFT JOIN t1 AS tt4 ON tt3.a=tt4.a ORDER BY 1;
+--replace_regex /\(cost=\d+(\.\d+)?(\.\.\d+(\.\d+)?)?\s+rows=\d+(\.\d+)?\)/(cost=X rows=X)/
+eval EXPLAIN FORMAT=TREE $query;
+eval $query;
+let $query= SELECT DISTINCT table1.pk FROM t2 AS table1 LEFT JOIN t2 AS table2 ON table1.f2=table2.f3 WHERE table2.f1 IS NULL;
+--replace_regex /\(cost=\d+(\.\d+)?(\.\.\d+(\.\d+)?)?\s+rows=\d+(\.\d+)?\)/(cost=X rows=X)/
