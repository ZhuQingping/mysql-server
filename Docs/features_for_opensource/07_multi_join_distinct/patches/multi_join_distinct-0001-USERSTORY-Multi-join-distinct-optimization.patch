+--source include/distinct_optimize_check.inc
+
+let $query= SELECT DISTINCT table1.pk FROM t2 AS table1 LEFT JOIN t2 AS table2 ON table1.f2=table2.f3 WHERE table2.f1 IS NULL;
+--source include/distinct_optimize_check.inc
+
+--echo # Optimization not work for left hash join + distinct
