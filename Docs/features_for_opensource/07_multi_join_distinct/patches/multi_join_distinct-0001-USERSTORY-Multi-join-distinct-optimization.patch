@@ -0,0 +1,1316 @@
+# Customer encounter performance regression for "Multi-join + distinct" scenario
+# when they upgrade from MySQL 5.7 to GaussDB(for MySQL) 8.0.22. The reason is
+# that MySQL 8.0 (>=8.0.16) new Volcano iterator executor do not apply distinct
+# optimization for this scenario, even if optimizer already mark "Distinct".
+# Refer to MySQL old version (5.7) optimization ideas, we can stop scan nested
+# loop join inner table when find out one new matched record. We introduce new
+# system variable "rds_nlj_distinct_optimize" to enable/disable this optimization.
+#
+# test case: session level hint updateable variable "rds_nlj_distinct_optimize"
+#
+SHOW VARIABLES LIKE 'rds_nlj_distinct_optimize';
+Variable_name	Value
+rds_nlj_distinct_optimize	ON
+SET @rds_nlj_distinct_optimize_save=@@rds_nlj_distinct_optimize;
+SET @origin_dstore_use_histogram_auto_update=@@global.dstore_use_histogram_auto_update;
+SET GLOBAL dstore_use_histogram_auto_update=OFF;
+SET @@SESSION.rds_nlj_distinct_optimize=ON;
+SELECT @@SESSION.rds_nlj_distinct_optimize;
+@@SESSION.rds_nlj_distinct_optimize
+1
+SET @@SESSION.rds_nlj_distinct_optimize=OFF;
+SELECT @@SESSION.rds_nlj_distinct_optimize;
+@@SESSION.rds_nlj_distinct_optimize
+0
+SET GLOBAL rds_nlj_distinct_optimize=ON;
+SELECT @@GLOBAL.rds_nlj_distinct_optimize;
+@@GLOBAL.rds_nlj_distinct_optimize
+1
+SET GLOBAL rds_nlj_distinct_optimize=OFF;
+SELECT @@GLOBAL.rds_nlj_distinct_optimize;
+@@GLOBAL.rds_nlj_distinct_optimize
+0
+SET GLOBAL rds_nlj_distinct_optimize=@rds_nlj_distinct_optimize_save;
+SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=ON) */ @@SESSION.rds_nlj_distinct_optimize;
+@@SESSION.rds_nlj_distinct_optimize
+1
+SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=OFF) */ @@SESSION.rds_nlj_distinct_optimize;
+@@SESSION.rds_nlj_distinct_optimize
+0
+#
+# test case: we can check this optimization worked by explain format=tree or explain analyze.
+#            "Nested loop inner join distinct" and "Nested loop left join distinct" means
+#            distinct optimization worked. Explain traditional and json format can not help
+#            to check the optimization work or not.
+#
+CREATE TABLE t1(a INT);
+INSERT INTO t1 VALUES(1),(2),(5),(6);
+INSERT INTO t1 VALUES(1),(2),(5),(6);
+ANALYZE TABLE t1;
+Table	Op	Msg_type	Msg_text
+test.t1	analyze	status	OK
+SET optimizer_switch='block_nested_loop=OFF';
+EXPLAIN SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=ON) */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	SIMPLE	tt1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using temporary
+1	SIMPLE	tt2	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Distinct
+1	SIMPLE	tt3	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Distinct
+Warnings:
+Note	1003	/* select#1 */ select /*+ SET_VAR(rds_nlj_distinct_optimize='ON') */ distinct `test`.`tt1`.`a` AS `a` from `test`.`t1` `tt1` join `test`.`t1` `tt2` join `test`.`t1` `tt3` where ((`test`.`tt2`.`a` + 3) = `test`.`tt3`.`a`)
+EXPLAIN SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=OFF) */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	SIMPLE	tt1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using temporary
+1	SIMPLE	tt2	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Distinct
+1	SIMPLE	tt3	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Distinct
+Warnings:
+Note	1003	/* select#1 */ select /*+ SET_VAR(rds_nlj_distinct_optimize='OFF') */ distinct `test`.`tt1`.`a` AS `a` from `test`.`t1` `tt1` join `test`.`t1` `tt2` join `test`.`t1` `tt3` where ((`test`.`tt2`.`a` + 3) = `test`.`tt3`.`a`)
+EXPLAIN FORMAT=TREE SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=ON) */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+EXPLAIN
+-> Table scan on <temporary>  (cost=X rows=X)
+    -> Temporary table with deduplication  (cost=X rows=X)
+        -> Nested loop inner join with distinct optimization  (cost=X rows=X)
+            -> Nested loop inner join with distinct optimization  (cost=X rows=X)
+                -> Table scan on tt1  (cost=X rows=X)
+                -> Table scan on tt2  (cost=X rows=X)
+            -> Limit: 1 row(s)  (cost=X rows=X)
+                -> Filter: ((tt2.a + 3) = tt3.a)  (cost=X rows=X)
+                    -> Table scan on tt3  (cost=X rows=X)
+
+EXPLAIN FORMAT=TREE SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=OFF) */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+EXPLAIN
+-> Table scan on <temporary>  (cost=X rows=X)
+    -> Temporary table with deduplication  (cost=X rows=X)
+        -> Nested loop inner join  (cost=X rows=X)
+            -> Nested loop inner join  (cost=X rows=X)
+                -> Table scan on tt1  (cost=X rows=X)
+                -> Table scan on tt2  (cost=X rows=X)
+            -> Limit: 1 row(s)  (cost=X rows=X)
+                -> Filter: ((tt2.a + 3) = tt3.a)  (cost=X rows=X)
+                    -> Table scan on tt3  (cost=X rows=X)
+
+EXPLAIN ANALYZE SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=ON) */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+EXPLAIN
+-> Table scan on <temporary>  (cost=X rows=X) (actual time=X rows=X loops=X)
+    -> Temporary table with deduplication  (cost=X rows=X) (actual time=X rows=X loops=X)
+        -> Nested loop inner join with distinct optimization  (cost=X rows=X) (actual time=X rows=X loops=X)
+            -> Nested loop inner join with distinct optimization  (cost=X rows=X) (actual time=X rows=X loops=X)
+                -> Table scan on tt1  (cost=X rows=X) (actual time=X rows=X loops=X)
+                -> Table scan on tt2  (cost=X rows=X) (actual time=X rows=X loops=X)
+            -> Limit: 1 row(s)  (cost=X rows=X) (actual time=X rows=X loops=X)
+                -> Filter: ((tt2.a + 3) = tt3.a)  (cost=X rows=X) (actual time=X rows=X loops=X)
+                    -> Table scan on tt3  (cost=X rows=X) (actual time=X rows=X loops=X)
+
+EXPLAIN ANALYZE SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=OFF) */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+EXPLAIN
+-> Table scan on <temporary>  (cost=X rows=X) (actual time=X rows=X loops=X)
+    -> Temporary table with deduplication  (cost=X rows=X) (actual time=X rows=X loops=X)
+        -> Nested loop inner join  (cost=X rows=X) (actual time=X rows=X loops=X)
+            -> Nested loop inner join  (cost=X rows=X) (actual time=X rows=X loops=X)
+                -> Table scan on tt1  (cost=X rows=X) (actual time=X rows=X loops=X)
+                -> Table scan on tt2  (cost=X rows=X) (actual time=X rows=X loops=X)
+            -> Limit: 1 row(s)  (cost=X rows=X) (actual time=X rows=X loops=X)
+                -> Filter: ((tt2.a + 3) = tt3.a)  (cost=X rows=X) (actual time=X rows=X loops=X)
+                    -> Table scan on tt3  (cost=X rows=X) (actual time=X rows=X loops=X)
+
+EXPLAIN SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=ON) */ DISTINCT tt1.a FROM t1 AS tt1 LEFT JOIN t1 AS tt2 ON tt1.a + 6 > tt2.a LEFT JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	SIMPLE	tt1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using temporary
+1	SIMPLE	tt2	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Distinct
+1	SIMPLE	tt3	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Distinct
+Warnings:
+Note	1003	/* select#1 */ select /*+ SET_VAR(rds_nlj_distinct_optimize='ON') */ distinct `test`.`tt1`.`a` AS `a` from `test`.`t1` `tt1` left join `test`.`t1` `tt2` on(((`test`.`tt1`.`a` + 6) > `test`.`tt2`.`a`)) left join `test`.`t1` `tt3` on(((`test`.`tt2`.`a` + 3) = `test`.`tt3`.`a`)) where true
+EXPLAIN SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=OFF) */ DISTINCT tt1.a FROM t1 AS tt1 LEFT JOIN t1 AS tt2 ON tt1.a + 6 > tt2.a LEFT JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	SIMPLE	tt1	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using temporary
+1	SIMPLE	tt2	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Distinct
+1	SIMPLE	tt3	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using where; Distinct
+Warnings:
+Note	1003	/* select#1 */ select /*+ SET_VAR(rds_nlj_distinct_optimize='OFF') */ distinct `test`.`tt1`.`a` AS `a` from `test`.`t1` `tt1` left join `test`.`t1` `tt2` on(((`test`.`tt1`.`a` + 6) > `test`.`tt2`.`a`)) left join `test`.`t1` `tt3` on(((`test`.`tt2`.`a` + 3) = `test`.`tt3`.`a`)) where true
+EXPLAIN FORMAT=TREE SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=ON) */ DISTINCT tt1.a FROM t1 AS tt1 LEFT JOIN t1 AS tt2 ON tt1.a + 6 > tt2.a LEFT JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+EXPLAIN
+-> Table scan on <temporary>  (cost=X rows=X)
+    -> Temporary table with deduplication  (cost=X rows=X)
+        -> Nested loop left join with distinct optimization  (cost=X rows=X)
+            -> Nested loop left join with distinct optimization  (cost=X rows=X)
+                -> Table scan on tt1  (cost=X rows=X)
+                -> Filter: ((tt1.a + 6) > tt2.a)  (cost=X rows=X)
+                    -> Table scan on tt2  (cost=X rows=X)
+            -> Filter: ((tt2.a + 3) = tt3.a)  (cost=X rows=X)
+                -> Table scan on tt3  (cost=X rows=X)
+
+EXPLAIN FORMAT=TREE SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=OFF) */ DISTINCT tt1.a FROM t1 AS tt1 LEFT JOIN t1 AS tt2 ON tt1.a + 6 > tt2.a LEFT JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+EXPLAIN
+-> Table scan on <temporary>  (cost=X rows=X)
+    -> Temporary table with deduplication  (cost=X rows=X)
+        -> Nested loop left join  (cost=X rows=X)
+            -> Nested loop left join  (cost=X rows=X)
+                -> Table scan on tt1  (cost=X rows=X)
+                -> Filter: ((tt1.a + 6) > tt2.a)  (cost=X rows=X)
+                    -> Table scan on tt2  (cost=X rows=X)
+            -> Filter: ((tt2.a + 3) = tt3.a)  (cost=X rows=X)
