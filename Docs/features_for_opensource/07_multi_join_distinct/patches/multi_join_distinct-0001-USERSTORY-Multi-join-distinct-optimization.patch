+-> Table scan on <temporary>  (cost=X rows=X)
+    -> Temporary table with deduplication  (cost=X rows=X)
+        -> Nested loop inner join  (cost=X rows=X)
+            -> Nested loop inner join  (cost=X rows=X)
+                -> Table scan on tt1  (cost=X rows=X)
+                -> Table scan on tt2  (cost=X rows=X)
+            -> Limit: 1 row(s)  (cost=X rows=X)
+                -> Filter: ((tt2.a + 3) = tt3.a)  (cost=X rows=X)
+                    -> Table scan on tt3  (cost=X rows=X)
+
+EXPLAIN ANALYZE SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=ON) */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+EXPLAIN
+-> Table scan on <temporary>  (cost=X rows=X) (actual time=X rows=X loops=X)
+    -> Temporary table with deduplication  (cost=X rows=X) (actual time=X rows=X loops=X)
+        -> Nested loop inner join with distinct optimization  (cost=X rows=X) (actual time=X rows=X loops=X)
+            -> Nested loop inner join with distinct optimization  (cost=X rows=X) (actual time=X rows=X loops=X)
+                -> Table scan on tt1  (cost=X rows=X) (actual time=X rows=X loops=X)
+                -> Table scan on tt2  (cost=X rows=X) (actual time=X rows=X loops=X)
+            -> Limit: 1 row(s)  (cost=X rows=X) (actual time=X rows=X loops=X)
+                -> Filter: ((tt2.a + 3) = tt3.a)  (cost=X rows=X) (actual time=X rows=X loops=X)
+                    -> Table scan on tt3  (cost=X rows=X) (actual time=X rows=X loops=X)
+
+EXPLAIN ANALYZE SELECT/*+ SET_VAR(rds_nlj_distinct_optimize=OFF) */ DISTINCT tt1.a FROM t1 AS tt1 JOIN t1 AS tt2 JOIN t1 AS tt3 ON tt2.a + 3 = tt3.a;
+EXPLAIN
