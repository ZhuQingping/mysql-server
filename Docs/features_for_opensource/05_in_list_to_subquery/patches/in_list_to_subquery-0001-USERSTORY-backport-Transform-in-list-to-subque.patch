+drop table t1;
+#
+# MDEV-24840: union of TVCs in IN subquery
+#
+create table t1 (a int, index idx(a)) engine=myisam;
+insert into t1 values (3), (7), (1);
+select a from t1 where a in (select 7 union select 8);
+a
+7
