+bool Item_func_in::fill_transform_tmp_table(THD *thd, TABLE *tmp_table) {
+  // Check if table has already filled.
+  if (tmp_table->is_created()) {
+    return false;
+  }
+
+  int res = 0;
+  bool is_list_of_rows = args[0]->type() == Item::ROW_ITEM;
+
+  // Temporary table created might have invisible fields such as hash_field
+  // for blob.
+  Field **tmp_visible_field = tmp_table->visible_field_ptr();
+
+  DBUG_EXECUTE_IF("simulate_in_predicate_to_in_sub_fill_tmp_table_failed",
+                  goto err;);
+
+  if (instantiate_tmp_table(thd, tmp_table)) goto err;
+  // Insert rows into temporary tables. In order to make table stats be
+  // correct, rows are inserted anyway here to make EXPLAIN show correct
+  // estimated rows.
+  for (uint i = 1; i < arg_count; i++) {
+    if (is_list_of_rows) {
+      Item_row *row_list = (Item_row *)(args[i]);
+      for (uint col = 0; col < row_list->cols(); col++) {
+        Item *col_item = row_list->element_index(col);
+        if (col_item->save_in_field(tmp_visible_field[col], true) != TYPE_OK) {
+          goto err;
+        }
+      }
+    } else {
+      if (args[i]->save_in_field(tmp_visible_field[0], true) != TYPE_OK)
+        goto err;
+    }
+    res = tmp_table->file->ha_write_row(tmp_table->record[0]);
+    // Ignore duplicated values
+    if (res != 0 && res != HA_ERR_FOUND_DUPP_KEY) goto err;
+  }
+
+  return false;
+
+err:
+  // Try to reprepare without transform.
+  ask_to_reprepare(thd);
+  // Disable transform for re-preapre.
+  thd->lex->disable_in_predicate_transform_to_subq = true;
+  return true;
+}
