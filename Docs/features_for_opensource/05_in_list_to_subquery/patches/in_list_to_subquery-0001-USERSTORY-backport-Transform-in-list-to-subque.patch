+// Create a tempoary table according to IN-list.
+static TABLE *convert_in_list_to_temp_table(THD *thd, Item **args) {
+  // Push all non-constant fields to a temporary list
+  mem_root_deque<Item *> fields(thd->mem_root);
+  if (args[0]->type() == Item::ROW_ITEM) {
+    for (uint col = 0; col < args[0]->cols(); col++) {
+      if (fields.push_back(args[0]->element_index(col))) return nullptr;
+    }
+  } else if (fields.push_back(args[0]))
+    return nullptr;
+  assert(fields.size() == args[0]->cols());
+
+  // Create temporary table
+  Temp_table_param *tmp_table_param;
+  if (!(tmp_table_param = new (thd->mem_root) Temp_table_param)) return nullptr;
+  tmp_table_param->skip_create_table = true;
+  Query_block *current_select = thd->lex->current_query_block();
+  count_field_types(current_select, tmp_table_param, fields, false, true);
+
+  DBUG_EXECUTE_IF("simulate_in_predicate_to_in_sub_create_tmp_table_failed",
+                  return nullptr;);
+
+  TABLE *tmp_table =
+      create_tmp_table(thd, tmp_table_param, fields, nullptr, true, true,
+                       current_select->active_options() | TMP_TABLE_ALL_COLUMNS,
+                       HA_POS_ERROR, "");
+  if (!tmp_table) return nullptr;
+  // BLOB might create one more invisible field such as hash_field.
+
+  Field **reg_field;
+  bool key_start = true;
+  const uint keyno = tmp_table->s->keys - 1;
+  // Register Key for each of fields so that update_ref_and_keys can find the
+  // Key created.
+  for (reg_field = tmp_table->s->field; *reg_field; reg_field++) {
+    if (key_start) (*reg_field)->key_start.set_bit(keyno);
+    key_start = false;
+    (*reg_field)->part_of_key.set_bit(keyno);
+    (*reg_field)->set_flag(PART_KEY_FLAG);
+  }
+  // Make keys visible.
+  tmp_table->s->keys_in_use.set_bit(keyno);
+  tmp_table->s->visible_indexes.set_bit(keyno);
+  // During TABLE::process_index_hints, keys_in_use_for_query will be set.
+
+  tmp_table->s->tmp_table = NON_TRANSACTIONAL_TMP_TABLE;
+
+  return tmp_table;
+}
