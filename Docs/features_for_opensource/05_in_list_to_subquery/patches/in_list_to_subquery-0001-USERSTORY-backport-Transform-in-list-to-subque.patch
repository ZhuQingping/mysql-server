+SELECT A.bigint_col, A.char_col FROM tt A WHERE A.char_col IN (NULL,'aaaa',NULL,'aacd') XOR A.bigint_col BETWEEN 50 AND 92 GROUP BY 1, 2;
+bigint_col	char_col
+-9223372036854775808	aaaa
+-9223372036854775808	aacd
