+// Fill Table_ref and select list into Query_block.
+static bool add_table_and_select_list(THD *thd, Query_block *sq_select,
+                                      TABLE *tmp_table, Item *in_predicate) {
+  char buff[NAME_LEN + 1];
+  LEX_CSTRING table_name;
+  table_name.length = snprintf_s(buff, sizeof(buff), sizeof(buff) - 1,
+                                 "<in_predicate_%d>", sq_select->select_number);
+  table_name.str = thd->strmake(buff, table_name.length);
+  LEX_CSTRING db_name = thd->db();
+  if (!db_name.str || is_infoschema_db(db_name.str, db_name.length)) {
+    char buff2[NAME_LEN + 1];
+    db_name.length = snprintf_s(buff2, sizeof(buff2), sizeof(buff2) - 1,
+                                "<in_predicate_db>");
+    db_name.str = thd->strmake(buff2, db_name.length);
+  }
+  Table_ident *ti;
+  if (!(ti = new (thd->mem_root) Table_ident(db_name, table_name))) {
+    return true;
+  }
+  Table_ref *values_tab;
+  if (!(values_tab = sq_select->add_table_to_list(thd, ti, table_name.str, 0,
+                                                  TL_READ, MDL_SHARED_READ))) {
+    return true;
+  }
+  values_tab->set_privileges(SELECT_ACL);
+  values_tab->table = tmp_table;
+  values_tab->set_transformed_in_predicate(in_predicate);
+  // core dump when get row count;
+  tmp_table->pos_in_table_list = values_tab;
+  tmp_table->alias = table_name.str;
+  sq_select->add_joined_table(values_tab);
+  sq_select->context.table_list =
+      sq_select->context.first_name_resolution_table =
+          sq_select->get_table_list();
+
+  // Add SELECT * into select list
+  Item_asterisk *wild;
+  if (!(wild = new (thd->mem_root)
+            Item_asterisk(POS(), values_tab->db, values_tab->table_name))) {
+    return true;
+  }
+  wild->context = &sq_select->context;
+  sq_select->add_item_to_list(wild);
+  sq_select->with_wild++;
+  return false;
+}
