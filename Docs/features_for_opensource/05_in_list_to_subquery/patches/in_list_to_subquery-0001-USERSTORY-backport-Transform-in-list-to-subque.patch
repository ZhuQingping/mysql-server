+/**
+ * Check if this IN-predicate can be transformed in IN-subquery
+ * @param thd The context of the statement
+ * @return
+ *   true     if transformation can be made
+ *   false    otherwise
+ */
+bool Item_func_in::is_applicable_to_convert_into_subq(
+    THD *thd, Opt_trace_object *in_predicate_work) {
+  // If execute failed, disable transform for re-prepare.
+  if (thd->lex->disable_in_predicate_transform_to_subq) {
+    return false;
+  }
+
+  // where clause which has OR condition can not transform to semi-join,
+  // which cause performance degree, so we disable it.
+  Item *where_cond = thd->lex->current_query_block()->where_cond();
+  if (where_cond && where_cond->type() == Item::COND_ITEM) {
+    Item_cond *cnd = static_cast<Item_cond *>(where_cond);
+    if (cnd->functype() == COND_OR_FUNC) return false;
+  }
+
+  bool is_row_list = args[1]->type() == Item::ROW_ITEM;
+  uint values_count = arg_count - 1;
+
+  if (is_row_list) values_count *= ((Item_row *)(args[1]))->cols();
+
+  if (thd->variables.rds_in_subquery_conversion_threshold > values_count) {
+    in_predicate_work->add("done", false);
+    in_predicate_work->add_utf8("reason", "In-list threshold is too big");
+    return false;
+  }
+
+  // Only support the following statements.
+  if (!(thd->lex->sql_command == SQLCOM_SELECT ||
+        thd->lex->sql_command == SQLCOM_INSERT_SELECT ||
+        thd->lex->sql_command == SQLCOM_REPLACE_SELECT)) {
+    in_predicate_work->add("done", false);
+    in_predicate_work->add_utf8(
+        "reason", "Current command is not supported for In-list conversion");
+    return false;
+  }
+
+  // Do not support stored procedure or trigger.
+  if (!(thd->stmt_arena->is_regular() || thd->stmt_arena->is_stmt_prepare())) {
+    in_predicate_work->add("done", false);
+    in_predicate_work->add_utf8(
+        "reason",
+        "Stored_procedure or trigger is not supported for In-list conversion");
+    return false;
+  }
+
+  // not in will lead a decrease of performance.
+  if (negated) {
+    in_predicate_work->add("done", false);
+    in_predicate_work->add_utf8("reason", "Not-in-list is not supported");
+    return false;
+  }
+
+  // Only IN list has all constant items can be converted.
+  if (!is_const_or_param_with_same_type(args, arg_count, in_predicate_work)) {
+    return false;
+  }
+
+  // if no key can be use, will lead a decrease of performance.
+  if (!is_args_in_key_parts(args)) {
+    in_predicate_work->add("done", false);
+    in_predicate_work->add_utf8("reason",
+                                "None of args has one index for reference");
+    return false;
+  }
+
+  return true;
+}
+
+/**
+  This functions is used to convert IN/NOT IN predicate into a subquery if
+  optimizer considers it's necessary. When number of elements in IN/NOT IN
+  predicate is over threshold, such a predicate will be converted.
+
+  @param[in] thd pointer of THD
+  @retval Pointer of an Item_in_subselect object, otherwise Item_func_in will
+          be returned if any error happens during convertion.
+*/
+Item *Item_func_in::in_predicate_to_in_subs_transformer(THD *thd) {
+  if (thd->variables.rds_in_subquery_conversion_threshold == 0) return this;
+
+  Opt_trace_context *const trace = &thd->opt_trace;
+  Opt_trace_object trace_wrapper(trace);
+  Opt_trace_object in_predicate_work(trace, "in_to_subquery_conversion");
+  in_predicate_work.add("item", this);
+
+  if (!is_applicable_to_convert_into_subq(thd, &in_predicate_work)) {
+    return this;
+  }
+
+  // Ignore error.
+  Dummy_error_handler error_handler;
+  thd->push_internal_handler(&error_handler);
+  auto error_handler_guard =
+      create_scope_guard([thd] { thd->pop_internal_handler(); });
+
+  DBUG_EXECUTE_IF("simulate_in_predicate_to_in_sub_oom", return this;);
+
+  Opt_trace_array trace_steps(trace, "steps");
+  TABLE *tmp_table = convert_in_list_to_temp_table(thd, args);
+  if (!tmp_table) {
+    trace_steps.end();
+    in_predicate_work.add("done", false);
+    in_predicate_work.add_utf8("reason", "Fail to create In-list tmp table");
+    return this;
+  }
+
+  LEX *lex = thd->lex;
+  Query_block *current_select = lex->current_query_block();
+  // TODO:
+  // If supporting to convert IN/NOT IN predicate into a subquery for
+  // CTX_HAVING in the future, you needs to reset properties'value of
+  // current_select about HAVING when coverting failed. Because in
+  // Item_in_subselect::Item_in_subselect() function, it would change properties
+  // of current_select about HAVING.
+  DBUG_ASSERT(current_select->parsing_place != CTX_HAVING);
+  // Construct Query_block for current subquery
+  Query_block *sq_select = lex->new_query(current_select);
+
+  auto cleanup_and_restore_guard =
+      create_scope_guard([thd, tmp_table, sq_select] {
+        if (sq_select) {
+          // current exclude_level have close_tmp_table and free_tmp_table
+          sq_select->master_query_expression()->exclude_level();
+        } else {
+          if (tmp_table) {
+            close_tmp_table(tmp_table);
+            free_tmp_table(tmp_table);
+          }
+        }
+      });
+
+  if (!sq_select ||
+      DBUG_EVALUATE_IF("simulate_in_predicate_to_subs_new_query_failed", true,
+                       false)) {
+    if (sq_select && tmp_table) {
+      close_tmp_table(tmp_table);
+      free_tmp_table(tmp_table);
+    }
+    return this;
+  }
+
+  // Fill transform tmp table immediately is it's a regular query.
+  if (thd->stmt_arena->is_regular() &&
+      fill_transform_tmp_table(thd, tmp_table)) {
+    trace_steps.end();
+    in_predicate_work.add("done", false);
+    in_predicate_work.add_utf8("reason", "Fail to fill tmp table");
+    return this;
+  }
+
+  if (add_table_and_select_list(thd, sq_select, tmp_table, this) ||
+      DBUG_EVALUATE_IF("simulate_in_predicate_to_subs_add_table_failed", true,
+                       false)) {
+    trace_steps.end();
+    in_predicate_work.add("done", false);
+    in_predicate_work.add_utf8("reason", "Fail to add table to query_block");
+    return this;
+  }
+  // Make Item_in_subslect structure
+  Item_in_subselect *in_subs;
+  if (!(in_subs = new (thd->mem_root) Item_in_subselect(args[0], sq_select))) {
+    return this;
+  }
+  // Here value_transform should be assigned with proper value for IN and NOT
+  // IN. Generally, such a transformation is done during parse stage.
+  // Reference function PTI_context::itemize and
+  // Item_exists_subselect::truth_transformer for more details pls.
+  if (negated) in_subs->value_transform = BOOL_NEGATED;
+  if (need_apply_is_true) in_subs->apply_is_true();
+  sq_select->parsing_place = current_select->parsing_place;
+  if (in_subs->fix_fields(thd, (Item **)&in_subs) ||
+      DBUG_EVALUATE_IF("simulate_in_predicate_to_in_subs_fix_in_subs_failed",
+                       true, false)) {
+#ifndef DBUG_OFF
+    size_t sj_candidates_size_before = 0, sj_candidates_size_after = 0;
+#endif
+    DBUG_EXECUTE_IF(
+        "simulate_in_predicate_to_in_subs_fix_in_subs_failed",
+        sj_candidates_size_before = current_select->get_sj_candidates_size(););
+    current_select->pop_sj_candidates(in_subs);
+    DBUG_EXECUTE_IF(
+        "simulate_in_predicate_to_in_subs_fix_in_subs_failed",
+        sj_candidates_size_after = current_select->get_sj_candidates_size();
+        assert(sj_candidates_size_before == (sj_candidates_size_after + 1)););
+    trace_steps.end();
+    in_predicate_work.add("done", false);
+    in_predicate_work.add_utf8("reason", "Item_in_subselect fix failed");
+    return this;
+  }
+  trace_steps.end();
+  in_predicate_work.add("done", true);
+
+  cleanup_and_restore_guard.release();
+
+  return in_subs;
+}
