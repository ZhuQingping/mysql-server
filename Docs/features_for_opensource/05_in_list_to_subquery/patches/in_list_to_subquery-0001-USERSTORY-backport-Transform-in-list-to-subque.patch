+/**
+  pop the last collection of subqueries candidate for semijoin.
+
+  @param sub_select         Pointer to Item_exists_subselect.
+*/
+void Query_block::pop_sj_candidates(Item_exists_subselect *sub_select) {
+  if (sj_candidates->size() == 0) {
+    return;
+  }
+  auto last = sj_candidates->at(sj_candidates->size() - 1);
+  if (last == sub_select) {
+    sj_candidates->pop_back();
+  }
+}
