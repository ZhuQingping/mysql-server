+Note	1003	/* select#1 */ select `performance_schema`.`global_status`.`VARIABLE_NAME` AS `Variable_name`,`performance_schema`.`global_status`.`VARIABLE_VALUE` AS `Value` from `<in_predicate_db>`.`<in_predicate_2>` join `performance_schema`.`global_status` where (`performance_schema`.`global_status`.`VARIABLE_NAME` = `<in_predicate_db>`.`<in_predicate_2>`.`VARIABLE_NAME`)
