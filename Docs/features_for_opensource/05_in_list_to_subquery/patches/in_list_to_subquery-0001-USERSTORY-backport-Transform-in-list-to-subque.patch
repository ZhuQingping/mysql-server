--- /dev/null
+++ b/mysql-test/t/in_predicate_to_in_subs_basic.test
@@ -0,0 +1,38 @@
+--source include/have_only_innodb.inc
+--source include/not_windows.inc
+
+SET @rds_in_predicate_conversion_threshold_backup = @@global.rds_in_predicate_conversion_threshold;
+
+# exists as global only
+--replace_column 1 #
+select @@global.rds_in_predicate_conversion_threshold;
+
+select @@session.rds_in_predicate_conversion_threshold;
+--replace_column 2 #
+show global variables like 'rds_in_predicate_conversion_threshold';
+--replace_column 2 #
+show session variables like 'rds_in_predicate_conversion_threshold';
+--replace_column 2 #
+select * from performance_schema.global_variables where variable_name='rds_in_predicate_conversion_threshold';
+--replace_column 2 #
+select * from performance_schema.session_variables where variable_name='rds_in_predicate_conversion_threshold';
+--replace_column 2 #
+
+# show that it's writable
+set global rds_in_predicate_conversion_threshold=1;
+select @@global.rds_in_predicate_conversion_threshold;
+set global rds_in_predicate_conversion_threshold=128;
+select @@global.rds_in_predicate_conversion_threshold;
+set session rds_in_predicate_conversion_threshold=1;
+
+# incorrect types
+--error ER_WRONG_TYPE_FOR_VAR
+set global rds_in_predicate_conversion_threshold=1.1;
+--error ER_WRONG_TYPE_FOR_VAR
+set global rds_in_predicate_conversion_threshold=1e1;
+--error ER_WRONG_TYPE_FOR_VAR
+set global rds_in_predicate_conversion_threshold="foo";
+
+set global rds_in_predicate_conversion_threshold=-1;
+
+SET @@global.rds_in_predicate_conversion_threshold = @rds_in_predicate_conversion_threshold_backup;
diff --git a/mysql-test/t/in_predicate_to_in_subs_bugs.test b/mysql-test/t/in_predicate_to_in_subs_bugs.test
new file mode 100644
index 00000000000..d235b260a6f
--- /dev/null
+++ b/mysql-test/t/in_predicate_to_in_subs_bugs.test
@@ -0,0 +1,59 @@
+--source include/have_only_innodb.inc
+
+--echo #
+--echo # BUGFIX: IN-list conversion causes an incorrect result
+--echo #
+CREATE TABLE tt (
+  bigint_col bigint NOT NULL,
+  char_col char(4),
+  KEY ndx_char_col (char_col)
+);
+
+INSERT INTO tt VALUES(0,NULL),(9223372036854775807,'aaa2'),(79,NULL),(13,NULL),(16,NULL),(-9223372036854775808,'aaaa'),(-9223372036854775808,'aabb'),(-9223372036854775808,'aacd'),(245,'ab'),(110,'ab'),(92,'ab'),(50,NULL),(38,NULL);
+
+SET rds_in_predicate_conversion_threshold=0;
+SELECT A.bigint_col, A.char_col FROM tt A WHERE A.char_col IN (NULL,'aaaa',NULL,'aacd') XOR A.bigint_col BETWEEN 50 AND 92 GROUP BY 1, 2;
+
+SET rds_in_predicate_conversion_threshold=1;
+--replace_column 10 # 11 #
+EXPLAIN SELECT A.bigint_col, A.char_col FROM tt A WHERE A.char_col IN (NULL,'aaaa',NULL,'aacd') XOR A.bigint_col BETWEEN 50 AND 92 GROUP BY 1, 2;
+SELECT A.bigint_col, A.char_col FROM tt A WHERE A.char_col IN (NULL,'aaaa',NULL,'aacd') XOR A.bigint_col BETWEEN 50 AND 92 GROUP BY 1, 2;
+DROP TABLE tt;
+
+--echo #
+--echo # BUGFIX: IN-list conversion causes mysqld crashed
+--echo #
+
+--connect(con1,localhost,root,,*NO-ONE*)
+connection con1;
+set rds_in_predicate_conversion_threshold = 1;
+explain select VARIABLE_NAME Variable_name, VARIABLE_VALUE Value from performance_schema.global_status where VARIABLE_NAME in('Threads_connected','Admin_threads_connected','Resserved_threads_connected');
+
+--connect(con2,localhost,root,,*NO-ONE*)
+connection con2;
+set rds_in_predicate_conversion_threshold = 1;
+use test;
+explain select VARIABLE_NAME Variable_name, VARIABLE_VALUE Value from performance_schema.global_status where VARIABLE_NAME in('Threads_connected','Admin_threads_connected','Resserved_threads_connected');
+
+--connect(con3,localhost,root,,*NO-ONE*)
+connection con3;
+set rds_in_predicate_conversion_threshold = 1;
+use information_schema;
+explain select VARIABLE_NAME Variable_name, VARIABLE_VALUE Value from performance_schema.global_status where VARIABLE_NAME in('Threads_connected','Admin_threads_connected','Resserved_threads_connected');
+
+--connect(con4,localhost,root,,*NO-ONE*)
+connection con4;
+set rds_in_predicate_conversion_threshold = 1;
+set debug="+d,simulate_in_predicate_to_subs_add_table_failed";
+explain select VARIABLE_NAME Variable_name, VARIABLE_VALUE Value from performance_schema.global_status where VARIABLE_NAME in('Threads_connected','Admin_threads_connected','Resserved_threads_connected');
+set debug="-d,simulate_in_predicate_to_subs_add_table_failed";
+
+set debug="+d,simulate_in_predicate_to_subs_new_query_failed";
+explain select VARIABLE_NAME Variable_name, VARIABLE_VALUE Value from performance_schema.global_status where VARIABLE_NAME in('Threads_connected','Admin_threads_connected','Resserved_threads_connected');
+set debug="";
+
+connection default;
+disconnect con1;
+disconnect con2;
+disconnect con3;
+disconnect con4;
diff --git a/mysql-test/t/in_predicate_to_in_subs_part1.test b/mysql-test/t/in_predicate_to_in_subs_part1.test
new file mode 100644
index 00000000000..2347c889768
--- /dev/null
+++ b/mysql-test/t/in_predicate_to_in_subs_part1.test
@@ -0,0 +1,468 @@
+--source include/have_only_innodb.inc
+
+# The aim of this testcase is to test in predicate transform to in subselect
+#
+# case 0, Test sys vars.
+# case 1, Simple query with (not) in predicate, args[0] is a single item.
+# case 2, Simple query with (not) in predicate, args[0] is a item row.
+# case 3, Simple query with (not) in predicate, args contains non-constant item.
+# case 4, Duplicate value in in predicate.
+# case 5, Simulate all kinds of error handling.
+# case 6, Test transform only execute in where and having clause.
+# case 7, Simple query with more than one in predicate.
+# case 8, Union (all) with in predicate.
+# case 9, CTE with in predicate.
+# case 10, Derived table (subquery) with in predicate.
+# case 11, Create view with in predicate.
+# case 12, Test query already exists semijoin.
+# case 13, Test item type cast(NULL value).
+# case 14, Test opt_trace.
+# case 15, Test dummy error handler.
+# case 16, Test prepared stmt, Stored procedure,trigger.
+# case 17, Test insert_select, replace_select.
+# case 18, Test generated column.
+# case 19, Test partition table, temporary table.
+# case 20, Test use keys, not in.
+# case 21, Const field in arg list.
+# case 22, Test type holder.
+# case 23, Test rollback if execute fails.
+# case 24, re-prepare when type is not compatible.
+# case 25, re-prepare when fill tmp table fail.
+#
+
+source include/have_debug.inc;
+set optimizer_trace_max_mem_size = 1024 * 1024;
+
+create table t1 (a int primary key not null, b int);
+create table t2 (a int, b int);
+insert into t1 values (1,2), (4,6), (9,7), (3,1), (2,5), (7,8);
+insert into t2 select * from t1;
+analyze table t1,t2;
+--let explain='traditional,tree'
+
+--echo # Case 0. Simple query with in predicate, args[0] is a single item.
+set rds_in_predicate_conversion_threshold = 0;
+--let $query = select * from t1 where a in (1,2);
+--source include/explain_and_query.inc
+set rds_in_predicate_conversion_threshold = 1;
+--let $query = select * from t1 where a in (1,2);
+--source include/explain_and_query.inc
+
+set rds_in_predicate_conversion_threshold = 5;
+--let $query = select * from t1 where a in (1,2,3,4,5);
+--source include/explain_and_query.inc
+
+set rds_in_predicate_conversion_threshold = 6;
+--let $query = select * from t1 where a in (1,2,3,4,5);
+--source include/explain_and_query.inc
+
+set rds_in_predicate_conversion_threshold = 6;
+--let $query = select * from t1 where (a,b) in ((1,2),(2,3),(3,4));
+--source include/explain_and_query.inc
+
+set rds_in_predicate_conversion_threshold = 7;
+--let $query = select * from t1 where (a,b) in ((1,2),(2,3),(3,4));
+--source include/explain_and_query.inc
+set rds_in_predicate_conversion_threshold = 2;
+
+--echo # Case 1. Simple query with in predicate, args[0] is a single item.
+--let $query = select * from t1 where a in (1,2);
+--source include/explain_and_query.inc
+--let $query = select * from t2 where a in (1,2);
+--source include/explain_and_query.inc
+
+--echo # Simple query with not in predicate, args[0] is a single item.
+--let $query = select * from t1 where a not in (1,2);
+--source include/explain_and_query.inc
+--let $query = select * from t2 where a not in (1,2);
+--source include/explain_and_query.inc
+
+
+--echo # Case 2. Simple query with in predicate, args[0] is a item row.
+--let $query = select * from t1 where (a,b) in ((1,2), (2,5));
+--source include/explain_and_query.inc
+
+--echo # Simple query with not in predicate, args[0] is a item row.
+--let $query = select * from t1 where (a,b) not in ((1,2), (2,5));
+--source include/explain_and_query.inc
+
+
+--echo # Case 3. Simple query with (not) in predicate, args contains non-constant item.
+--let $query = select * from t1 where (a,b) in ((1,now()), (2,5));
+--source include/explain_and_query.inc
+
+
+--echo # Case 4. Duplicate value in in predicate.
+--let $query = select * from t1 where a in (1,1,1,2,3,4,5,6,7,8);
+--source include/explain_and_query.inc
+
+--let $query = select * from t1 where (a,b) in ((1,2),(1,2),(2,3),(2,5));
+--source include/explain_and_query.inc
+
+
+--echo # Case 5. Simulate create tmp table failed.
+--let $explain_backup= $explain
+--let $query = select * from t1 where a in (1,2);
+--let $explain="traditional,opt_trace"
+SET DEBUG='+d,simulate_in_predicate_to_in_sub_create_tmp_table_failed';
+--source include/explain_and_query.inc
+SET DEBUG='';
+
+--echo # Simulate fix Item_in_subs failed.
+--let $query = select * from t1 where a in (1,2);
