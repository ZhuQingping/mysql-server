+// True means all arguments are all const or param items.
+static bool is_const_or_param_with_same_type(Item **args, const uint arg_count,
+                                             Opt_trace_object *trace) {
+  bool is_list_of_rows = args[0]->type() == Item::ROW_ITEM;
+  Item_row *row0 = nullptr;
+  if (is_list_of_rows) row0 = (Item_row *)args[0];
+  std::string type_conv = "Args have different data type";
+  std::string incorrect_args =
+      "Elements in IN-list must be const or parameters";
+  for (uint i = 1; i < arg_count; i++) {
+    // skip check param its already const.
+    if (is_list_of_rows) {
+      DBUG_ASSERT(row0);
+      Item_row *row_list = (Item_row *)(args[i]);
+      for (uint col = 0; col < row_list->cols(); col++) {
+        Item *col_item = row_list->element_index(col);
+        // In order to make semijoin work in the same way as
+        // Item_func_in::val_xxx after type conversion, here we must make sure
+        // result_type() to be the same in order to avoid type conversion.
+        if (row0->element_index(col)->result_type() !=
+            col_item->result_type()) {
+          trace->add("done", false);
+          trace->add_utf8("reason", type_conv.data());
+          return false;
+        }
+        if (!col_item->const_item() && col_item->type() != Item::PARAM_ITEM) {
+          trace->add("done", false);
+          trace->add_utf8("reason", incorrect_args.data());
+          return false;
+        }
+      }
+    } else {
+      if (args[0]->result_type() != args[i]->result_type()) {
+        trace->add("done", false);
+        trace->add_utf8("reason", type_conv.data());
+        return false;
+      }
+
+      if (!args[i]->const_item() && args[i]->type() != Item::PARAM_ITEM) {
+        trace->add("done", false);
+        trace->add_utf8("reason", incorrect_args.data());
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+static bool can_index_used_for_ref(Field *field) {
+  TABLE *table = field->table;
+  for (uint j = 0; j < table->s->keys; j++) {
+    KEY *key = &table->key_info[j];
+    if (field->key_start.is_set(j) &&
+        // Following index can't be used for REF scan, here we need ignore
+        // them so as to avoid performance regression.
+        !(key->flags & (HA_FULLTEXT | HA_SPATIAL)))
+      return true;
+  }
+  return false;
+}
+
+// True means in predicate has possible keys.
+static bool is_args_in_key_parts(Item **args) {
+  bool is_list_of_rows = args[0]->type() == Item::ROW_ITEM;
+  if (is_list_of_rows) {
+    Item_row *row_list = (Item_row *)(args[0]);
+    for (uint col = 0; col < row_list->cols(); col++) {
+      Item *col_item = row_list->element_index(col)->real_item();
+      if (col_item->type() != Item::FIELD_ITEM) {
+        continue;
+      }
+      Item_field *item_field = dynamic_cast<Item_field *>(col_item);
+      if (item_field->field->key_start.to_ulonglong() != 0 &&
+          can_index_used_for_ref(item_field->field))
+        return true;
+    }
+    return false;
+  } else {
+    Item *arg = args[0]->real_item();
+    if (arg->type() != Item::FIELD_ITEM) {
+      return false;
+    }
+    Item_field *item_field = dynamic_cast<Item_field *>(arg);
+    if (item_field->field->key_start.to_ulonglong() != 0 &&
+        can_index_used_for_ref(item_field->field))
+      return true;
+
+    return false;
+  }
+}
