index 00000000000..5fb7895714b
--- /dev/null
+++ b/mysql-test/r/in_predicate_to_in_subs_part1.result
@@ -0,0 +1,2165 @@
+set optimizer_trace_max_mem_size = 1024 * 1024;
+create table t1 (a int primary key not null, b int);
+create table t2 (a int, b int);
+insert into t1 values (1,2), (4,6), (9,7), (3,1), (2,5), (7,8);
+insert into t2 select * from t1;
+analyze table t1,t2;
+Table	Op	Msg_type	Msg_text
+test.t1	analyze	status	OK
+test.t2	analyze	status	OK
+# Case 0. Simple query with in predicate, args[0] is a single item.
+set rds_in_predicate_conversion_threshold = 0;
+# Explain and execute query: select * from t1 where a in (1,2);
+set @explain = 'traditional,tree';;
+EXPLAIN select * from t1 where a in (1,2);;
+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	SIMPLE	t1	NULL	range	PRIMARY	PRIMARY	4	NULL	#	#	Using where
+Warnings:
+Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a`,`test`.`t1`.`b` AS `b` from `test`.`t1` where (`test`.`t1`.`a` in (1,2))
+EXPLAIN FORMAT=tree select * from t1 where a in (1,2);;
+EXPLAIN
+-> Filter: (t1.a in (1,2))  (cost=*** rows=***)
+    -> Index range scan on t1 using PRIMARY over (a = 1) OR (a = 2)  (cost=*** rows=***)
+
+select * from t1 where a in (1,2);;
+a	b
+1	2
+2	5
+set rds_in_predicate_conversion_threshold = 1;
+# Explain and execute query: select * from t1 where a in (1,2);
+set @explain = 'traditional,tree';;
+EXPLAIN select * from t1 where a in (1,2);;
+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	SIMPLE	t1	NULL	ALL	PRIMARY	NULL	NULL	NULL	#	#	NULL
+1	SIMPLE	<in_predicate_2>	NULL	eq_ref	<auto_distinct_key>	<auto_distinct_key>	4	test.t1.a	#	#	IN-list converted
+Warnings:
+Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a`,`test`.`t1`.`b` AS `b` from `test`.`<in_predicate_2>` join `test`.`t1` where (`test`.`<in_predicate_2>`.`a` = `test`.`t1`.`a`)
+EXPLAIN FORMAT=tree select * from t1 where a in (1,2);;
+EXPLAIN
+-> Nested loop inner join  (cost=*** rows=***)
+    -> Table scan on t1  (cost=*** rows=***)
+    -> Single-row index lookup on <in_predicate_2> using <auto_distinct_key> (a=t1.a)  (cost=*** rows=***)
+
+select * from t1 where a in (1,2);;
+a	b
+1	2
+2	5
+set rds_in_predicate_conversion_threshold = 5;
+# Explain and execute query: select * from t1 where a in (1,2,3,4,5);
+set @explain = 'traditional,tree';;
+EXPLAIN select * from t1 where a in (1,2,3,4,5);;
+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	SIMPLE	t1	NULL	ALL	PRIMARY	NULL	NULL	NULL	#	#	NULL
+1	SIMPLE	<in_predicate_2>	NULL	eq_ref	<auto_distinct_key>	<auto_distinct_key>	4	test.t1.a	#	#	IN-list converted
+Warnings:
+Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a`,`test`.`t1`.`b` AS `b` from `test`.`<in_predicate_2>` join `test`.`t1` where (`test`.`<in_predicate_2>`.`a` = `test`.`t1`.`a`)
+EXPLAIN FORMAT=tree select * from t1 where a in (1,2,3,4,5);;
+EXPLAIN
+-> Nested loop inner join  (cost=*** rows=***)
+    -> Table scan on t1  (cost=*** rows=***)
+    -> Single-row index lookup on <in_predicate_2> using <auto_distinct_key> (a=t1.a)  (cost=*** rows=***)
+
+select * from t1 where a in (1,2,3,4,5);;
+a	b
+1	2
+2	5
+3	1
+4	6
+set rds_in_predicate_conversion_threshold = 6;
+# Explain and execute query: select * from t1 where a in (1,2,3,4,5);
+set @explain = 'traditional,tree';;
+EXPLAIN select * from t1 where a in (1,2,3,4,5);;
+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	SIMPLE	t1	NULL	range	PRIMARY	PRIMARY	4	NULL	#	#	Using where
+Warnings:
+Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a`,`test`.`t1`.`b` AS `b` from `test`.`t1` where (`test`.`t1`.`a` in (1,2,3,4,5))
+EXPLAIN FORMAT=tree select * from t1 where a in (1,2,3,4,5);;
+EXPLAIN
+-> Filter: (t1.a in (1,2,3,4,5))  (cost=*** rows=***)
+    -> Index range scan on t1 using PRIMARY over (a = 1) OR (a = 2) OR (3 more)  (cost=*** rows=***)
+
+select * from t1 where a in (1,2,3,4,5);;
+a	b
+1	2
+2	5
+3	1
+4	6
+set rds_in_predicate_conversion_threshold = 6;
+# Explain and execute query: select * from t1 where (a,b) in ((1,2),(2,3),(3,4));
+set @explain = 'traditional,tree';;
+EXPLAIN select * from t1 where (a,b) in ((1,2),(2,3),(3,4));;
+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	SIMPLE	t1	NULL	ALL	PRIMARY	NULL	NULL	NULL	#	#	Using where
+1	SIMPLE	<in_predicate_2>	NULL	eq_ref	<auto_distinct_key>	<auto_distinct_key>	9	test.t1.a,test.t1.b	#	#	IN-list converted
+Warnings:
+Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a`,`test`.`t1`.`b` AS `b` from `test`.`<in_predicate_2>` join `test`.`t1` where ((`test`.`<in_predicate_2>`.`b` = `test`.`t1`.`b`) and (`test`.`<in_predicate_2>`.`a` = `test`.`t1`.`a`))
+EXPLAIN FORMAT=tree select * from t1 where (a,b) in ((1,2),(2,3),(3,4));;
+EXPLAIN
+-> Nested loop inner join  (cost=*** rows=***)
+    -> Filter: (t1.b is not null)  (cost=*** rows=***)
+        -> Table scan on t1  (cost=*** rows=***)
