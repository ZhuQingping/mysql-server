index c7717a9f03a..826f4b1c94c 100644
--- a/mysql-test/suite/dstore_main/r/offset_pushdown-dstore.result
+++ b/mysql-test/suite/dstore_main/r/offset_pushdown-dstore.result
@@ -1208,3 +1208,29 @@ yval VARCHAR(100) PATH "$.y"
 xval	yval
 3	7
 SET SESSION BIG_TABLES =default;
+CREATE TABLE employees (
