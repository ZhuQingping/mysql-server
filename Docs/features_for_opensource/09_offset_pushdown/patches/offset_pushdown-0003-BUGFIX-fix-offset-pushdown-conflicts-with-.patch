From b85d7ab78a5d021b12a6eaf3139ede4d08812a11 Mon Sep 17 00:00:00 2001
From: songliyong <songliyong@contributor>


Date: Thu, 20 Nov 2025 19:11:06 +0800
Subject: [PATCH] BUGFIX fix offset pushdown conflicts with mrr issue

Issue:
----------
MRR will sort the rows, so we will get different
result with and without offset pushdown.

Solution:
----------
disable offset pushdown when ds-mrr is working.
---
 mysql-test/r/offset_pushdown.result           | 26 +++++++++++++++++++
 .../r/offset_pushdown-dstore.result           | 26 +++++++++++++++++++
 .../dstore_main/t/offset_pushdown-dstore.test | 25 ++++++++++++++++++
 mysql-test/t/offset_pushdown.test             | 25 ++++++++++++++++++
 sql/sql_select.cc                             |  4 ++-
 storage/dstore/handler/ha_cde.cc              |  2 ++
 storage/innobase/handler/ha_innodb.cc         |  2 ++
 7 files changed, 109 insertions(+), 1 deletion(-)

diff --git a/mysql-test/r/offset_pushdown.result b/mysql-test/r/offset_pushdown.result
index 5d89dd7bf20..e3f5c492ab8 100644
--- a/mysql-test/r/offset_pushdown.result
+++ b/mysql-test/r/offset_pushdown.result
@@ -1212,3 +1212,29 @@ yval VARCHAR(100) PATH "$.y"
 xval	yval
 3	7
 SET SESSION BIG_TABLES =default;
+CREATE TABLE employees (
+id INT PRIMARY KEY AUTO_INCREMENT,
+name VARCHAR(100),
+department_id INT,
+salary DECIMAL(10,2),
+INDEX idx_department_id (department_id)
+);
+INSERT INTO employees (name, department_id, salary) VALUES
+('John', 10, 5000.00),
+('Jane', 20, 6000.00),
+('Bob', 10, 7000.00),
+('Alice', 30, 8000.00),
+('Tom', 20, 9000.00);
+SET @orig_optimizer_switch = @@optimizer_switch;
+SET optimizer_switch = 'mrr=on,mrr_cost_based=off';
+EXPLAIN  SELECT * FROM employees  WHERE department_id <30 limit 2 offset 1;
+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	SIMPLE	employees	NULL	range	idx_department_id	idx_department_id	5	NULL	4	100.00	Using MRR
+Warnings:
+Note	1003	/* select#1 */ select `test`.`employees`.`id` AS `id`,`test`.`employees`.`name` AS `name`,`test`.`employees`.`department_id` AS `department_id`,`test`.`employees`.`salary` AS `salary` from `test`.`employees` where (`test`.`employees`.`department_id` < 30) limit 1,2
+SELECT * FROM employees  WHERE department_id < 30 limit 2 offset 1;
+id	name	department_id	salary
+2	Jane	20	6000.00
+3	Bob	10	7000.00
+SET optimizer_switch = @orig_optimizer_switch;
+DROP table employees;
