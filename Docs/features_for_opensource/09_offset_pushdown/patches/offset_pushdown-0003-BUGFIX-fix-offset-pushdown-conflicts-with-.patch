@@ -624,3 +624,28 @@ explain format=tree SELECT *
          )
        ) AS  jt LIMIT 1 OFFSET 1;
 SET SESSION BIG_TABLES =default;
+
+# conflict with MRR
+CREATE TABLE employees (
+    id INT PRIMARY KEY AUTO_INCREMENT,
+    name VARCHAR(100),
+    department_id INT,
+    salary DECIMAL(10,2),
+    INDEX idx_department_id (department_id)
