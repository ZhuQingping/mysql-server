diff --git a/mysql-test/suite/dstore_main/t/offset_pushdown-dstore.test b/mysql-test/suite/dstore_main/t/offset_pushdown-dstore.test
index 1f371e837ab..642c9629b39 100644
--- a/mysql-test/suite/dstore_main/t/offset_pushdown-dstore.test
