+#  READ UNCOMMITTED
+#  SKIP LOCKED
+#  NO WAIT
+# SERIALIZABLE
+# FOR UPDATE with serializable - all read rows have an x-lock -> equivalent to FOR UPDATE with RR
+# LOCK IN SHARE MODE with serializable - read rows have a s-lock - no different to LOCK IN SHARE MODE with RR
+# To keep track of the number of rows skipped by offset pushdown we use:
+# SET @save_skipped_rows = (SELECT variable_value FROM performance_schema.global_status WHERE LOWER(variable_name) = 'innodb_rds_rows_skipped_by_offset_pushdown');
+# SELECT query
