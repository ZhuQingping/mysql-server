+INSERT INTO t_gap VALUES (31);
+# next key locking
+INSERT INTO t_gap VALUES (11);
+ERROR HY000: Lock wait timeout exceeded; try restarting transaction
+INSERT INTO t_gap VALUES (29);
+ERROR HY000: Lock wait timeout exceeded; try restarting transaction
+# gap lock
+INSERT INTO t_gap VALUES (18);
+ERROR HY000: Lock wait timeout exceeded; try restarting transaction
+INSERT INTO t_gap VALUES (23);
+ERROR HY000: Lock wait timeout exceeded; try restarting transaction
+rollback;
+rollback;
+DROP TABLE t_gap;
+# UPDATE statement  locks and gaps locks
+# --------------------
+# Without OP
+# --------------------
