+DROP TABLE t1;
+# ------------
+# Multi values index and offset pushdown
+# The three ways that can  trigger the use of the multivalue index (MEMBER OF() JSON_CONTAINS() JSON_OVERLAPS()) cannot
+# be pushed down by ICP or by rds_empty_redundant_check_in_range_scan
+# Multi values index won't be used together with offset pushdown until that changes
+# ------------
+CREATE TABLE customers (
+id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY,
+modified DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+custinfo JSON
+);
