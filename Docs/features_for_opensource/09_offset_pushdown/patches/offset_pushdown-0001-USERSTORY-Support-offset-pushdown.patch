+(NULL, '2022-04-19 10:15:45', '{"user":"Ted","user_id":56,"zipcode":[94507,94582]}');
+# add multi value index
+ALTER TABLE customers ADD INDEX zips( (CAST(custinfo->'$.zipcode' AS UNSIGNED ARRAY)) );
