+# Offset pushdown supports merged derived tables
+SET big_tables = 1;
+# use dstore if we materialize
+explain format=tree SELECT  * FROM  (SELECT * FROM t1) d  LIMIT 100 OFFSET 1;
+EXPLAIN
+-> Limit/Offset: 100/1 row(s), with offset pushdown  (cost=X rows=X)
+    -> Table scan on t1  (cost=X rows=X)
+
+SELECT  * FROM  (SELECT * FROM t1) d  LIMIT 100 OFFSET 1;
