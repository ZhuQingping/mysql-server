+INSERT INTO t1 SELECT key1+@d, key2+@d, key3+@d, key4+@d,
+key5+@d, key6+@d, key7+@d, key8+@d FROM t1;
+SET @d=@d*2;
+INSERT INTO t1 SELECT key1+@d, key2+@d, key3+@d, key4+@d,
+key5+@d, key6+@d, key7+@d, key8+@d FROM t1;
+SET @d=@d*2;
+INSERT INTO t1 SELECT key1+@d, key2+@d, key3+@d, key4+@d,
