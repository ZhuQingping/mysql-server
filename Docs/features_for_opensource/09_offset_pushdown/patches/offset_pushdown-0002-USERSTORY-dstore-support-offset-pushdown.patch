+    -> Filter: ((t1.a = 2) and (t1.b = 2))  (cost=X rows=X)
+        -> Intersect rows sorted by row ID  (cost=X rows=X)
+            -> Index range scan on t1 using a over (a = 2)  (cost=X rows=X)
+            -> Index range scan on t1 using b over (b = 2)  (cost=X rows=X)
+
+DROP TABLE t1;
+# 1/b/ Using union() - OR clause disabled with offset pushdown
+# Redundant range condition is not compatible with using union
+# the where clause is going to stay - even if there is no where clause
+# which seems unlikely offset pushdown is not compatible with it anyways (grep shows)
+CREATE TABLE t1
+(
+key1 INT NOT NULL,
