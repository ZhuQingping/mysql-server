diff --git a/mysql-test/suite/ptrc/r/partial_result_cache.result b/mysql-test/suite/ptrc/r/partial_result_cache.result
index 31a46697562..5814b8d862f 100644
--- a/mysql-test/suite/ptrc/r/partial_result_cache.result
+++ b/mysql-test/suite/ptrc/r/partial_result_cache.result
@@ -3723,3 +3723,106 @@ d	a	b	c
 5	1	1	2
 drop table t1;
 drop table t2;
+create table t(a int, b int);
+insert into t values(1,10),(2,20);
+create table tt (f1 int, f2 int, KEY f1 (f1));
+insert into tt values (1,10),(2,20),(3,30),(4,40);
+create table t2(a int, key(a), b int);
+set optimizer_switch="block_nested_loop=off";
+explain format=tree SELECT t1.* , ( SELECT count(*) FROM t t2 LEFT JOIN t t3 ON t3.a > t2.a - t1.a ) FROM t t1;
+EXPLAIN
+-> Table scan on t1 
+-> Select #2 (subquery in projection; dependent)
+    -> Result cache : cache keys(t1.a)
+        -> Aggregate: count(0) 
+            -> Nested loop left join 
+                -> Table scan on t2 
+                -> Result cache : cache keys(t1.a, t2.a) 
+                    -> Filter: (t3.a > (t2.a - t1.a)) 
+                        -> Table scan on t3 
+
+Warnings:
+Note	1276	Field or reference 'test.t1.a' of SELECT #2 was resolved in SELECT #1
+SELECT t1.* , ( SELECT count(*) FROM t t2 LEFT JOIN t t3 ON t3.a > t2.a - t1.a ) FROM t t1;
+a	b	( SELECT count(*) FROM t t2 LEFT JOIN t t3 ON t3.a > t2.a - t1.a )
+1	10	3
+2	20	4
+explain format=tree select t1.*, (select count(*)
+from (t t2 join t t3)
+left join (t t4 LEFT JOIN (t t5 JOIN t t6) ON t4.a>t5.a-t1.a) on t3.a>t2.a-t1.a)
+from t t1;
+EXPLAIN
+-> Table scan on t1 
+-> Select #2 (subquery in projection; dependent)
+    -> Result cache : cache keys(t1.a)
+        -> Aggregate: count(0) 
+            -> Nested loop left join 
+                -> Nested loop inner join 
+                    -> Table scan on t2 
+                    -> Result cache : cache keys(t1.a, t2.a) 
+                        -> Table scan on t3 
+                -> Result cache : cache keys(t1.a, t2.a, t3.a) 
+                    -> Nested loop left join 
+                        -> Filter: (t3.a > (t2.a - t1.a)) 
+                            -> Table scan on t4 
+                        -> Result cache : cache keys(t1.a, t2.a, t3.a, t4.a) 
+                            -> Nested loop inner join 
+                                -> Filter: (t4.a > (t5.a - t1.a)) 
+                                    -> Table scan on t5 
+                                -> Result cache : cache keys(t1.a, t2.a, t3.a, t4.a, t5.a) 
+                                    -> Table scan on t6 
+
+Warnings:
+Note	1276	Field or reference 'test.t1.a' of SELECT #2 was resolved in SELECT #1
+Note	1276	Field or reference 'test.t1.a' of SELECT #2 was resolved in SELECT #1
+select t1.*, (select count(*)
+from (t t2 join t t3)
+left join (t t4 LEFT JOIN (t t5 JOIN t t6) ON t4.a>t5.a-t1.a) on t3.a>t2.a-t1.a)
+from t t1;
+a	b	(select count(*)
+from (t t2 join t t3)
+left join (t t4 LEFT JOIN (t t5 JOIN t t6) ON t4.a>t5.a-t1.a) on t3.a>t2.a-t1.a)
+1	10	19
+2	20	32
+set optimizer_switch=default;
+explain format=tree SELECT t11.* , ( SELECT max(t1.f1) FROM tt t1 WHERE NOT EXISTS ( SELECT * FROM tt t2 JOIN tt t3 ON t2.f1 < NULL WHERE t1.f1 = t2.f1 AND t1.f1 < t11.a ) ) FROM t t11;
+EXPLAIN
+-> Table scan on t11 
+-> Select #2 (subquery in projection; dependent)
+    -> Result cache : cache keys(t11.a)
+        -> Aggregate: max(t1.f1) 
+            -> Nested loop antijoin 
+                -> Index scan on t1 using f1 
+                -> Result cache : cache keys(t1.f1, t11.a) 
+                    -> Nested loop inner join 
+                        -> Filter: ((t1.f1 < t11.a) and (t1.f1 < NULL)) 
+                            -> Covering index lookup on t2 using f1 (f1=t1.f1) 
+                        -> Result cache : cache keys(t1.f1, t11.a, t2.f1) 
+                            -> Index scan on t3 using f1 
+
+Warnings:
+Note	1276	Field or reference 'test.t1.f1' of SELECT #3 was resolved in SELECT #2
+Note	1276	Field or reference 'test.t1.f1' of SELECT #3 was resolved in SELECT #2
+Note	1276	Field or reference 'test.t11.a' of SELECT #3 was resolved in SELECT #1
+SELECT t11.* , ( SELECT max(t1.f1) FROM tt t1 WHERE NOT EXISTS ( SELECT * FROM tt t2 JOIN tt t3 ON t2.f1 < NULL WHERE t1.f1 = t2.f1 AND t1.f1 < t11.a ) ) FROM t t11;
+a	b	( SELECT max(t1.f1) FROM tt t1 WHERE NOT EXISTS ( SELECT * FROM tt t2 JOIN tt t3 ON t2.f1 < NULL WHERE t1.f1 = t2.f1 AND t1.f1 < t11.a ) )
+1	10	4
+2	20	4
+explain format=tree select (select t3.b from (t2 as t5 left join (t2 as t3 force index (a) left join t2 as t4 on true) on t3.a=t_.a)) from t2 as t_;
+EXPLAIN
+-> Index scan on t_ using a 
+-> Select #2 (subquery in projection; dependent)
+    -> Result cache : cache keys(t_.a)
+        -> Nested loop left join 
+            -> Index scan on t5 using a 
+            -> Result cache : cache keys(t_.a) 
+                -> Nested loop left join 
+                    -> Index lookup on t3 using a (a=t_.a) 
+                    -> Result cache : cache keys(t3.a, t3.b, t_.a) 
+                        -> Index scan on t4 using a 
+
+Warnings:
+Note	1276	Field or reference 'test.t_.a' of SELECT #2 was resolved in SELECT #1
+select (select t3.b from (t2 as t5 left join (t2 as t3 force index (a) left join t2 as t4 on true) on t3.a=t_.a)) from t2 as t_;
+(select t3.b from (t2 as t5 left join (t2 as t3 force index (a) left join t2 as t4 on true) on t3.a=t_.a))
+drop table t, tt, t2;
