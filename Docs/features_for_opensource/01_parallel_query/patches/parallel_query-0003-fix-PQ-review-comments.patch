       is_parser_item(false),
       is_expensive_cache(-1),
@@ -167,7 +166,6 @@ Item::Item(THD *thd, const Item *item)
       orig_name(item->orig_name),
       max_length(item->max_length),
       marker(MARKER_NONE),
-      saved_marker(MARKER_NONE),
       cmp_context(item->cmp_context),
       is_parser_item(false),
       is_expensive_cache(-1),
@@ -196,7 +194,6 @@ Item::Item(const POS &)
       orig_name(),
       max_length(0),
       marker(MARKER_NONE),
-      saved_marker(MARKER_NONE),
