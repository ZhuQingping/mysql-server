diff --git a/sql/item.h b/sql/item.h
index 928c1286a26..c003c39b25b 100644
--- a/sql/item.h
+++ b/sql/item.h
@@ -2741,13 +2741,6 @@ class Item : public Parse_tree_node {
   */
   virtual bool mark_field_in_map(uchar *arg [[maybe_unused]]) { return false; }
 
-  template <typename T>
-  inline void swap_var_value(T &v1, T &v2) {
-    T vv = v1;
-    v1 = v2;
-    v2 = vv;
-  }
-
  protected:
   /**
     Helper function for mark_field_in_map(uchar *arg).
@@ -3525,31 +3518,31 @@ class Item : public Parse_tree_node {
     end - as a following phase may change it.
   */
   item_marker marker;
-  item_marker saved_marker;
-
-  /**
-    After the Query_expression::prepare function invokes
-    Table_ref::setup_materialized_derived_tmp_table to create the materialize
-    temporary table for the derived table, it calls prepare_query_term to
-    recalculate and update the m_nullable attribute of Items involved in set
-    operations. To ensure that PQ cloning creates temporary tables based on the
-    original m_nullable values (keeping the null_fields count consistent with
-    the temporary table corresponding to orig). It is necessary to save and
-    restore the m_nullable.
-  */
-  bool saved_nullable{false};
-  bool has_saved_derived_info{false};
+  using pq_derived_info_t = struct {
+    item_marker marker{MARKER_NONE};
+    /**
+      After the Query_expression::prepare function invokes
+      Table_ref::setup_materialized_derived_tmp_table to create the materialize
+      temporary table for the derived table, it calls prepare_query_term to
+      recalculate and update the m_nullable attribute of Items involved in set
+      operations. To ensure that PQ cloning creates temporary tables based on
+      the original m_nullable values (keeping the null_fields count consistent
+      with the temporary table corresponding to orig). It is necessary to save
+      and restore the m_nullable.
+    */
+    bool nullable{false};
+  };
+  std::optional<pq_derived_info_t> m_saved_pq_derived_info;
 
-  inline void save_derived_info() {
-    saved_marker = marker;
-    saved_nullable = m_nullable;
-    has_saved_derived_info = true;
+  inline void save_pq_derived_info() {
+    m_saved_pq_derived_info = {marker, m_nullable};
   }
 
-  inline void swap_derived_info() {
-    if (!has_saved_derived_info) return;
-    swap_var_value<item_marker>(marker, saved_marker);
-    swap_var_value<bool>(m_nullable, saved_nullable);
+  inline void swap_pq_derived_info() {
+    if (m_saved_pq_derived_info.has_value()) {
+      std::swap(marker, m_saved_pq_derived_info->marker);
+      std::swap(m_nullable, m_saved_pq_derived_info->nullable);
+    }
   }
 
   Item_result cmp_context;  ///< Comparison context
