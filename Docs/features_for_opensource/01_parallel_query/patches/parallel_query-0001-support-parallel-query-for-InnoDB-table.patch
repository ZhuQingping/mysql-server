+PQSubqueryExecution Query_expression::subquery_suite_for_parallel_query()
+    const {
+  /*
+    PQ has supported several types of subqueries, such that
+      - UNCACHEABLE_DEPENDENT, no support
+      - lateral, no support
+      - RECURSIVE, no support
+      - derived table, support
+      - uncorrelated scalar subquery, support
+      - other cases, no support
+  */
+  if (m_lateral_deps || is_recursive()) {
+    return PQSubqueryExecution::kImpossible;
+  }
+
+  // derived table
+  if (!item)
+    return (uncacheable & UNCACHEABLE_DEPENDENT)
+               ? PQSubqueryExecution::kImpossible
+               : PQSubqueryExecution::kOnceByLeader;
+
+  // For uncachable subquery (eg. the subquery contains random contents), we
+  // should not let leader execute it and then cache its value.
+  if (!uncacheable) {
+    // uncorrelated scalar subquery
+    if (item->substype() == Item_subselect::SINGLEROW_SUBS) {
+      return down_cast<Item_singlerow_subselect *>(item)->is_maxmin()
+                 ? PQSubqueryExecution::kImpossible
+                 : PQSubqueryExecution::kOnceByLeader;
+    }
+  }
+  if ((item->substype() == Item_subselect::EXISTS_SUBS ||
+       item->substype() == Item_subselect::SINGLEROW_SUBS) &&
+      !is_union()) {
+    if (uncacheable == UNCACHEABLE_DEPENDENT &&
+        first_query_block()->m_suite_for_pq &&
+        current_thd->pq_support_features_switch_flag(
+            PQ_SUPPORT_FEATURES_SWITCH_CORRELATED_SUBQUERY)) {
+      // Correlated subquery.
+      switch (place()) {
+        case CTX_WHERE:
+        case CTX_ON:  // in fact, if ON is not later moved to WHERE by
+                      // simplify_joins(), we'll reject it in
+                      // choose_parallel_tables().
+        case CTX_HAVING:
+        case CTX_SELECT_LIST:
+        case CTX_ORDER_BY:
+        case CTX_GROUP_BY:
+          break;  // accepted
+        default:
+          return PQSubqueryExecution::kImpossible;
+      }
+      // Cloning a list of CTE definitions is not implemented
+      if (m_with_clause != nullptr) return PQSubqueryExecution::kImpossible;
+      // A limitation to simplify implementation: no subquery or derived table
+      // inside the subquery. But derived tables inside the subquery are
+      // accepted (occurs in TPC-DS Q1-10-81).
+      auto iu = first_query_block()->first_inner_query_expression();
+      while (iu && iu->derived_table && iu->uncacheable == 0)
+        iu = iu->next_query_expression();
+      if (iu) return PQSubqueryExecution::kImpossible;
+      return PQSubqueryExecution::kMultipleByWorkers;
+    }
+    if (uncacheable == 0) return PQSubqueryExecution::kOnceByLeader;
+  }
+
+  return PQSubqueryExecution::kImpossible;
+}
