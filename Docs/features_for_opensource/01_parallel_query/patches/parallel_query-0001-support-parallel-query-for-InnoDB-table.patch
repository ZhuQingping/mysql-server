diff --git a/mysql-test/suite/parallel_query/t/parallel_replace_select_behavior_changes.test b/mysql-test/suite/parallel_query/t/parallel_replace_select_behavior_changes.test
new file mode 100644
index 00000000000..e703a7455dc
--- /dev/null
+++ b/mysql-test/suite/parallel_query/t/parallel_replace_select_behavior_changes.test
@@ -0,0 +1,288 @@
+# PARALLEL INSERT INTO SELECT BEHAVIOR CHANGES
+--source include/pq_test.inc
+--source include/count_sessions.inc
+SET @old_innodb_lock_wait_timeout = @@global.innodb_lock_wait_timeout;
+
+SET @@global.innodb_lock_wait_timeout = 1;
+
+
+CREATE TABLE t1(a INT); 
+INSERT INTO t1 VALUES(1), (5), (15), (35);
+
+CREATE TABLE t2 (a int, UNIQUE(a));
+INSERT INTO t2 values (5);
+
+--echo # -------------------------
+
+--echo # Behavior difference 1
+
+--echo # If pq_support_features_switch insert_select is on, there aren't any locks placed on t1 when doing an
+--echo # REPLACE INTO t2 SELECT from table t1, which means that it is possible to update t1 in another transaction
+--echo # which is not possible initially because of the locks on t1. In addition, while SELECT * FROM t1 will fetch the 
+--echo # snapshot from the start of the transaction in the first connection. SELECT * FROM t1 LOCK IN SHARE MODE will
+--echo # however fetch the freshest snapshot of t1 and will show the updated row.
+SET @saved_pq_support_features_switch = @@global.pq_support_features_switch;
+SET GLOBAL pq_support_features_switch='insert_select=on';
+connect (con1,localhost,root,,);
+connect (con2,localhost,root,,);
+
+connection con1;
+--echo # Using connection con1
+start transaction;
+replace into t2 select * from t1;
+connection con2;
+--echo # Using connection con2
+start transaction;
+UPDATE t1 SET a = 300 WHERE a = 1;
+commit;
+connection con1;
+--echo # Using connection con1
+SELECT * FROM t1;
+SELECT * FROM t1 LOCK IN SHARE MODE;
+
+commit;
+
+
+connection default;
+--echo # Using connection default
+disconnect con1;
+disconnect con2;
+
+
+
+
+--echo # ---------------------------
+
+
+--echo # BEHAVIOR DIFFERENCE 2
+
+--echo # With locks on the selected-from table, REPLACE SELECT must wait until UPDATE,INSERT and DELETE
+--echo # statements on the selected-from table are done. Without locks (pq_support_features_switch insert_select=on),
+--echo # REPLACE INTO SELECT does not need to wait anymore. 
+
+
+--echo # a/ INSERT 
+
+
+drop table t2;
+drop table t1;
+CREATE TABLE t1(a INT); 
+INSERT INTO t1 VALUES(1), (5), (15), (35);
+CREATE TABLE t2 (a int, UNIQUE(a));
+INSERT INTO t2 values (5);
+
+
+connect (con1,localhost,root,,);
+connect (con2,localhost,root,,);
+
+connection con1;
+--echo # Using connection con1
+start transaction;
+INSERT INTO t1 values (100);
+connection con2;
+--echo # Using connection con2
+start transaction;
+replace into t2 select * from t1;
+select * from t2;
+commit;
+connection con1;
+--echo # Using connection con1
+
+commit;
+
+connection default;
+--echo # Using connection default
+disconnect con1;
+disconnect con2;
+
+
+
+drop table t1;
+
+drop table t2; 
+
+CREATE TABLE t1(a INT); 
+INSERT INTO t1 VALUES(1), (5), (15), (35);
+CREATE TABLE t2 (a int, UNIQUE(a));
+INSERT INTO t2 values (5);
+
+SET GLOBAL pq_support_features_switch='insert_select=off';
+connect (con1,localhost,root,,);
+connect (con2,localhost,root,,);
+
+connection con1;
+--echo # Using connection con1
+start transaction;
+INSERT INTO t1 values (100);
+connection con2;
+--echo # Using connection con2
+start transaction;
+--error ER_LOCK_WAIT_TIMEOUT
+replace into t2 select * from t1;
+select * from t2;
+commit;
+connection con1;
+--echo # Using connection con1
+
+commit;
+
+connection default;
+--echo # Using connection default
+disconnect con1;
+disconnect con2;
+drop table t1,t2;
+
+--echo # a/ UPDATE
+
+--echo # without locks
+
+
+CREATE TABLE t1(a INT); 
+INSERT INTO t1 VALUES(1), (5), (15), (35);
+CREATE TABLE t2 (a int, UNIQUE(a));
+INSERT INTO t2 values (5);
+
+SET GLOBAL pq_support_features_switch='insert_select=on';
+
+connect (con1,localhost,root,,);
+connect (con2,localhost,root,,);
+
+connection con1;
+--echo # Using connection con1
+start transaction;
+UPDATE t1 set a = 123 where a =35;
+connection con2;
+--echo # Using connection con2
+start transaction;
+replace into t2 select * from t1;
+select * from t2;
+commit;
+connection con1;
+--echo # Using connection con1
+
+commit;
+
+connection default;
+--echo # Using connection default
+disconnect con1;
+disconnect con2;
+
+
+--echo # with locks
+
+drop table t1;
+
+drop table t2; 
+CREATE TABLE t2 (a int, UNIQUE(a));
+INSERT INTO t2 values (5);
+
+
+CREATE TABLE t1(a INT); 
+INSERT INTO t1 VALUES(1), (5), (15), (35);
+
+SET GLOBAL pq_support_features_switch='insert_select=off';
+connect (con1,localhost,root,,);
+connect (con2,localhost,root,,);
+
+connection con1;
+--echo # Using connection con1
+start transaction;
+UPDATE t1 set a = 123 where a =35;
+connection con2;
+--echo # Using connection con2
+start transaction;
+--error ER_LOCK_WAIT_TIMEOUT
+replace into t2 select * from t1;
+select * from t2;
+commit;
+connection con1;
+--echo # Using connection con1
+
+commit;
+
+connection default;
+--echo # Using connection default
+disconnect con1;
+disconnect con2;
+drop table t1,t2;
+
+
+
+--echo # a/ DELETE
+
+--echo # without locks
+
+
+CREATE TABLE t1(a INT); 
+INSERT INTO t1 VALUES(1), (5), (15), (35);
+CREATE TABLE t2 (a int, UNIQUE(a));
+INSERT INTO t2 values (5);
+
+SET GLOBAL pq_support_features_switch='insert_select=on';
+
+connect (con1,localhost,root,,);
+connect (con2,localhost,root,,);
+
+connection con1;
+--echo # Using connection con1
+start transaction;
+DELETE FROM t1 where a =35;
+connection con2;
+--echo # Using connection con2
+start transaction;
+replace into t2 select * from t1;
+select * from t2;
+commit;
+connection con1;
+--echo # Using connection con1
+
+commit;
+
+connection default;
+--echo # Using connection default
+disconnect con1;
+disconnect con2;
+
+
+--echo # with locks
+
+drop table t1;
+
+drop table t2; 
+CREATE TABLE t2 (a int, UNIQUE(a));
+INSERT INTO t2 values (5);
+
+
+CREATE TABLE t1(a INT); 
+INSERT INTO t1 VALUES(1), (5), (15), (35);
+
+SET GLOBAL pq_support_features_switch='insert_select=off';
+connect (con1,localhost,root,,);
+connect (con2,localhost,root,,);
+
+connection con1;
+--echo # Using connection con1
+start transaction;
+DELETE FROM t1 where a =35;
+connection con2;
+--echo # Using connection con2
+start transaction;
+--error ER_LOCK_WAIT_TIMEOUT
+replace into t2 select * from t1;
+select * from t2;
+commit;
+connection con1;
+--echo # Using connection con1
+
+commit;
+
+connection default;
+--echo # Using connection default
+disconnect con1;
+disconnect con2;
+drop table t1,t2;
+
+
+SET @@global.innodb_lock_wait_timeout = @old_innodb_lock_wait_timeout;
+SET global pq_support_features_switch = @saved_pq_support_features_switch;
+--source include/wait_until_count_sessions.inc
diff --git a/mysql-test/suite/parallel_query/t/pq_abort.test b/mysql-test/suite/parallel_query/t/pq_abort.test
new file mode 100644
index 00000000000..a9ac24b8b8a
--- /dev/null
+++ b/mysql-test/suite/parallel_query/t/pq_abort.test
@@ -0,0 +1,64 @@
+--source include/pq_test.inc
+--source include/have_debug.inc
+
+create table t1(id int, a varchar(10));
+insert into t1 values(1, 'aa'), (2, 'bb');
+
+set @saved_force_parallel_execute = @@force_parallel_execute;
+
+set session force_parallel_execute = 1;
+explain select * from t1 limit 1;
+select * from t1 limit 1;
+show status like "PQ_memory_used";
+
+SET parallel_graceful_fallback = off;
+--source ../include/pq_abort.inc
+
+SET parallel_graceful_fallback = on;
+--source ../include/pq_abort.inc
+SET parallel_graceful_fallback = default;
+
+set session debug="";
+explain select * from t1 limit 1;
+select * from t1 limit 1;
+show status like "PQ_memory_used";
+
+drop table t1;
+
+# Case from opt_hints.test.
+# BUG: this query has two tables, which cannot run parallelly,
+# but dsmrr_init don't know pq is disabled.
+CREATE TABLE t1(f1 INT, f2 INT);
+INSERT INTO t1 VALUES
+(1,1),(2,2),(3,3);
+
+CREATE TABLE t2(f1 INT NOT NULL, f2 INT NOT NULL, f3 CHAR(200), KEY(f1, f2));
+INSERT INTO t2 VALUES
+(1,1, 'qwerty'),(1,2, 'qwerty'),(1,3, 'qwerty'),
+(2,1, 'qwerty'),(2,2, 'qwerty'),(2,3, 'qwerty'), (2,4, 'qwerty'),(2,5, 'qwerty'),
+(3,1, 'qwerty'),(3,4, 'qwerty'),
+(4,1, 'qwerty'),(4,2, 'qwerty'),(4,3, 'qwerty'), (4,4, 'qwerty'),
+(1,1, 'qwerty'),(1,2, 'qwerty'),(1,3, 'qwerty'),
+(2,1, 'qwerty'),(2,2, 'qwerty'),(2,3, 'qwerty'), (2,4, 'qwerty'),(2,5, 'qwerty'),
+(3,1, 'qwerty'),(3,4, 'qwerty'),
+(4,1, 'qwerty'),(4,2, 'qwerty'),(4,3, 'qwerty'), (4,4, 'qwerty');
+
+CREATE TABLE t3 (f1 INT NOT NULL, f2 INT, f3 VARCHAR(32),
+                 PRIMARY KEY(f1), KEY f2_idx(f1), KEY f3_idx(f3));
+INSERT INTO t3 VALUES
+(1, 1, 'qwerty'), (2, 1, 'ytrewq'),
+(3, 2, 'uiop'), (4, 2, 'poiu'), (5, 2, 'lkjh'),
+(6, 2, 'uiop'), (7, 2, 'poiu'), (8, 2, 'lkjh'),
+(9, 2, 'uiop'), (10, 2, 'poiu'), (11, 2, 'lkjh'),
+(12, 2, 'uiop'), (13, 2, 'poiu'), (14, 2, 'lkjh');
+INSERT INTO t3 SELECT f1 + 20, f2, f3 FROM t3;
+INSERT INTO t3 SELECT f1 + 40, f2, f3 FROM t3;
+
+SELECT /*+ BKA() */ t2.f1, t2.f2, t2.f3 FROM t1,t2
+WHERE t1.f1=t2.f1 AND t2.f2 BETWEEN t1.f1 and t1.f2 and t2.f2 + 1 >= t1.f1 + 1;
+
+drop table t1, t2, t3;
+set session force_parallel_execute = @saved_force_parallel_execute;
+
+--let $wait_counter= 10000
+--source include/restart_mysqld.inc
diff --git a/mysql-test/suite/parallel_query/t/pq_agg_distinct.test b/mysql-test/suite/parallel_query/t/pq_agg_distinct.test
new file mode 100644
index 00000000000..59f92f0e4a8
--- /dev/null
+++ b/mysql-test/suite/parallel_query/t/pq_agg_distinct.test
@@ -0,0 +1,249 @@
+--source include/pq_test.inc
+--source include/elide_costs.inc
+
+SET @saved_pq_support_features_switch = @@session.pq_support_features_switch;
+SET pq_support_features_switch = 'count_distinct=on';
+
+--disable_query_log
+CALL mtr.add_suppression("[Parallel query]*");
+--enable_query_log
+
+CREATE TABLE t1 (a int, b int);
+let $1=64;
+--disable_query_log
+
+while($1)
+{
+  let $2=32;
+	while($2)
+	{
+		eval INSERT INTO t1 VALUES (MOD($1, 23), MOD(133, $2));
+		dec $2;
+	}
+	dec $1;
+}
+
+--enable_query_log
+
+# count(distinct)
+
+let $query = select count(distinct a) from t1;
+let $no_pq_query = select /*+ no_pq */ count(distinct a) from t1;
+--replace_column 10 # 11 #
+eval explain $query;
+--replace_regex $elide_pq_costs_and_time_and_row_estimate
+eval explain analyze $query;
+eval $query;
+eval $no_pq_query;
+
+let $query = select count(distinct a) from t1 group by b;
+let $no_pq_query = select /*+ no_pq */ count(distinct a) from t1 group by b;
+--replace_column 10 # 11 #
+eval explain $query;
+--replace_regex $elide_pq_costs_and_time_and_row_estimate
+eval explain analyze $query;
+eval $query;
+eval $no_pq_query;
+
+drop table t1;
+
+# more than one args in Item_sum_count
+create table t1(n1 int, n2 int, s char(20), vs varchar(20), t text);
+insert into t1 values (1,11, 'one','eleven', 'eleven'),
+ (1,11, 'one','eleven', 'eleven'),
+ (2,11, 'two','eleven', 'eleven'),
+ (2,12, 'two','twevle', 'twelve'),
+ (2,13, 'two','thirteen', 'foo'),
+ (2,13, 'two','thirteen', 'foo'),
+ (2,13, 'two','thirteen', 'bar'),
+ (NULL,13, 'two','thirteen', 'bar'),
+ (2,NULL, 'two','thirteen', 'bar'),
+ (2,13, NULL,'thirteen', 'bar'),
+ (2,13, 'two',NULL, 'bar'),
+ (2,13, 'two','thirteen', NULL);
+
+explain select count(distinct n1,n2) from t1;
+select count(distinct n1,n2) from t1;
+select /*+ no_pq */ count(distinct n1,n2) from t1;
+
+explain select count(distinct n1,s) from t1;
+select count(distinct n1,s) from t1;
+select /*+ no_pq */ count(distinct n1,s) from t1;
+
+explain select count(distinct s,n1,vs) from t1;
+select count(distinct s,n1,vs) from t1;
+select /*+ no_pq */ count(distinct s,n1,vs) from t1;
+
+# text fields does not use pq
+explain select count(distinct s,t) from t1;
+select count(distinct s,t) from t1;
+select /*+ no_pq */ count(distinct s,t) from t1;
+
+# more than one count(distinct) in select_list
+explain select count(distinct n1), count(distinct n2) from t1;
+select count(distinct n1), count(distinct n2) from t1;
+select /*+ no_pq */ count(distinct n1), count(distinct n2) from t1;
+
+# arg's type is varchar
+explain select count(distinct vs) from t1;
+select count(distinct vs) from t1;
+select /*+ no_pq */ count(distinct vs) from t1;
+
+drop table t1;
+
+# tree->is_in_memory() is false. The whole tree is not in memory.
+CREATE TABLE t1 (a INT);
+INSERT INTO t1 VALUES (1),(2),(3),(4),(5),(6),(7),(8);
+INSERT INTO t1 SELECT a+8 FROM t1;
+INSERT INTO t1 SELECT a+16 FROM t1;
+INSERT INTO t1 SELECT a+32 FROM t1;
+INSERT INTO t1 SELECT a+64 FROM t1;
+INSERT INTO t1 VALUE(NULL);
+FLUSH STATUS;
