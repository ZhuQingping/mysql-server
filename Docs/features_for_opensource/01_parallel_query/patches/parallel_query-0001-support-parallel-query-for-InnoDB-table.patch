+  case when false then subq_0.c1 else subq_0.c1 end as c3
+from
+  (select
+        ref_0.C_STREET_2 as c1,
+        ref_0.C_BIT as c2
+      from
+        t10 as ref_0
+      ) as subq_0
+
+group by 1,2,3
+order by 1,2,3;
+
+create view tx_cmplx_005 as select
+  cast(nullif(rtrim(subq_7.c2), subq_0.c5) as char) as c0,
+  subq_7.c4 as c1
+from
+  (select
+          ref_0.c_last as c5
+        from
+          t5 as ref_0
+        ) as subq_0
+    left join (select
+          2 as c2,
+          case when (true)
+                    or (((((true)
+                            or (ref_1.C_END is not NULL))
+                          and (((((EXISTS (
+                                          select
+                                              ref_2.c_street_1 as c0
+                                            from
+                                              t4 as ref_15
+                                            where (ref_2.c_zip is NULL)
+                                            ))
+                                        or (true)
+                                  and false)))
+                            or (ref_2.c_data is NULL))))) then ref_2.c_credit else ref_2.c_credit end
+             as c4
+        from
+          t10 as ref_1
+              left join t4 as ref_2
+              on (false)
+            inner join t12 as ref_3
+            on false
+        where (((ref_1.C_CREDIT is NULL)
+              or (ref_2.c_credit is not NULL)))
+          and (ref_1.C_PHONE is NULL)
+        ) as subq_7
+    on true;
+
+create view tx_cmplx_006 as select
+  subq_0.c4 as c1,
+  subq_0.c4 as c2
+from
+  (select
+          ref_0.C_BIT as c4
+        from
+          t10 as ref_0
+        where (ref_0.C_YTD_PAYMENT is not NULL)
+        ) as subq_0
+    left join (select
+          ref_3.C_FIRST as c0
+        from
+          t12 as ref_1
+            inner join t2 as ref_2
+                right join t10 as ref_3
+                on (ref_2.id_col = ref_3.C_ID )
+            on true
+        where false
+        ) as subq_1
+    on (false)
+group by 1,2;
+
+
+--echo #BUGFIX: when view is included into lateral dependent subquery,
+--echo #the first_inner_table in Item_view_ref may be referred to the table in
+--echo #the lateral query, thus we should disable this view in parallel query.
+
+let query = select
+  ref_0.c_w_id as c0
+from
+  t0_sub_1 as ref_0
+  inner join t4 as ref_1
+where (EXISTS (
+        select
+            ref_1.c_street_1 as c0
+          from
+            tx_cmplx_006 as ref_11,
+            lateral (select
+                  ref_0.c_d_id as c0
+                from
+                  (SELECT 1 AS c1, ref_0.c_middle AS c2
+										FROM t4 ref_1
+											LEFT JOIN t4 ON ref_0.c_middle = ref_1.c_credit
+										WHERE 1 IS NOT NULL) as ref_12
+                where (ref_12.c2 is NULL)
+                ) as subq_3)
+          )
+		or (ref_1.c_credit_lim is not NULL) limit 10;
+
+analyze tables t0, t1, t10, t11, t12, t2, t4, t5;
+
+--replace_regex $elide_costs_and_rows
+eval explain format=tree $query;
+# As this is run with PQ, the output is not deterministic. We hide the result. It is ok as the bug was about an error message.
+--disable_result_log
+eval $query;
+--enable_result_log
