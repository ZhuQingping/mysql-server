+
+# BUGFIX
+
+CREATE TABLE t1 (c0 INT);
+INSERT INTO t1 (c0) VALUES (1918),(1938);
+CREATE TABLE t12 (c0 INT, c1 INT, c2 INT);
+CREATE TABLE t72 (c0 INT, c3 INT);
+CREATE TABLE t23 (c0 INT AS (1) VIRTUAL, c1 INT, c4 INT);
+INSERT INTO t23 (c1, c4) VALUES (53302558,196),(53302558,196),(286897839,244),(53302558,196),(286897839,244);
+
+explain SELECT (SELECT sum(t72.c0) FROM t72 JOIN t12 ON 1 = t12.c1 GROUP BY t12.c2, t72.c0) FROM LATERAL (SELECT count(*) FROM (SELECT t72.c3 FROM t72) x(x) JOIN ((SELECT 2) UNION (SELECT 1)) y(y) ON TRUE) z(z) JOIN t23 ON ((SELECT 1 FROM t1) UNION (SELECT t23.c0 FROM t72)) = t23.c4;
+
+SELECT (SELECT sum(t72.c0) FROM t72 JOIN t12 ON 1 = t12.c1 GROUP BY t12.c2, t72.c0) FROM LATERAL (SELECT count(*) FROM (SELECT t72.c3 FROM t72) x(x) JOIN ((SELECT 2) UNION (SELECT 1)) y(y) ON TRUE) z(z) JOIN t23 ON ((SELECT 1 FROM t1) UNION (SELECT t23.c0 FROM t72)) = t23.c4;
+
