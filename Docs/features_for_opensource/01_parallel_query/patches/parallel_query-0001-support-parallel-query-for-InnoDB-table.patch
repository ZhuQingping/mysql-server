+Item_subselect *Item_subselect::pq_clone_common(THD *thd, Query_block *select) {
+  Item_subselect *new_item;
+  switch (substype()) {
+    case SINGLEROW_SUBS:
+      new_item = new (thd->pq_mem_root) Item_singlerow_subselect();
+      break;
+    case EXISTS_SUBS:
+      new_item = new (thd->pq_mem_root) Item_exists_subselect();
+      break;
+    default:
+      assert(false);
+      new_item = nullptr;
+  }
+
+  if (!new_item || new_item->pq_copy_from(thd, select, this)) {
+    return nullptr;
+  }
+  if (unit->uncacheable) {
+    // Correlated subq uses the unit's _copy_ made by top unit's
+    // pq_dup_select().
+    if (auto new_query_block = unit->first_query_block()->pq_last_clone()) {
+      auto new_unit = new_query_block->master_query_expression();
+      // check that this new unit is not yet taken:
+      assert(new_unit && new_unit->item == nullptr);
+      new_item->unit = new_unit;
+      // test consistency of the matching of units:
+      assert(new_unit->first_query_block()->select_number ==
+             unit->first_query_block()->select_number);
+      new_unit->item = new_item;
+    } else {
+      /*
+        This means we have not found a unit to link to. It is abnormal. But it
+        can happen: if we have WHERE subq OR true_condition, WHERE is copied
+        to saved_where_cond at the end of resolution, then WHERE is emptied
+        during optimization, thus the subquery is _not_ validated for PQ when
+        we decide if we want to do PQ, then in pq_dup_select() the unit is not
+        cloned (as it's not suitable for cloning it's skipped by
+        list_query_blocks_to_clone(), it is treated as a "non-PQ subquery")),
+        then we clone saved_where_cond (instead of where_cond - alas), which
+        still contains the subquery.
+      */
+      return nullptr;  // failure, retry without PQ if possible.
+    }
+  }
+
+  // clone subquery
+  if (subquery) {
+    auto new_subquery_with_result = subquery->pq_clone(thd, new_item);
+    if (!new_subquery_with_result) return nullptr;
+    new_item->subquery.reset(new_subquery_with_result);
+    if (unit->uncacheable) {
+      Query_result_subquery *new_query_result;
+      switch (substype()) {
+        case SINGLEROW_SUBS:
+          new_query_result =
+              new (thd->pq_mem_root) Query_result_scalar_subquery(new_item);
+          break;
+        case EXISTS_SUBS:
+          new_query_result =
+              new (thd->pq_mem_root) Query_result_exists_subquery(new_item);
+          break;
+        default:
+          assert(false);
+          new_query_result = nullptr;
+      }
+      if (!new_query_result || new_item->subquery->change_query_result(
+                                   thd, new_item, new_query_result))
+        return nullptr;
+    }
+  }
+  return new_item;
+}
