+/**
+  Check if a statement should be restarted without parallel query. This is a
+  fallback mechanism that is used to catch queries that failes to execute using
+  parallel query, but can be executed without parallel query. The conditions for
+  restarting a query is currently:
+
+  1) The error ER_PARALLEL_FAIL_INIT must have been raised.
+  2) The statement must be a SQL command.
+  3) The error must happend before we start sending results to the client.
+
+  Currently, 2 and 3 is implied by 1. But we keep 2 and 3 as a safeguard if
+  suddenly ER_PARALLEL_FAIL_INIT starts to be raised from other places in the
+  code (as of writing, it is only raised one place in the code).
+
+  Note that this is mostly a copy-paste of the function
+  "check_secondary_engine_statement", and any changes that happens there should
+  probably be applied to this function as well.
+
+  @param thd            the session
+  @param parser_state   the parser state
+  @param query_string   the query to reprepare and execute
+  @param query_length   the length of the query
+*/
+static void retry_without_parallel_query(THD *thd, Parser_state *parser_state,
+                                         const char *query_string,
+                                         size_t query_length) {
+  if (!thd->variables.parallel_fail_retry) {
+    // This feature is disabled by the system variable, so just return.
+    return;
+  }
+
+  // Only restart the statement if a non-fatal error was raised.
+  if (!thd->is_error() || thd->is_killed() || thd->is_fatal_error()) return;
+
+  const Sql_condition *error_condition = thd->get_stmt_da()->error_condition();
+  if (error_condition == nullptr ||
+      error_condition->mysql_errno() != ER_PARALLEL_FAIL_INIT) {
+    return;
+  }
+
+  // Only SQL DML commands can be restarted.
+  if (thd->lex->m_sql_cmd == nullptr || !thd->lex->m_sql_cmd->is_dml()) return;
+
+  // The query cannot be restarted if it had started executing, since
+  // it may have started sending results to the client.
+  if (thd->lex->is_exec_completed()) return;
+
+  // Forget about the error raised in the previous attempt at preparing the
+  // query.
+  thd->clear_error();
+
+  // Tell performance schema that the statement is restarted.
+  MYSQL_END_STATEMENT(thd->m_statement_psi, thd->get_stmt_da());
+  thd->m_statement_psi = MYSQL_START_STATEMENT(
+      &thd->m_statement_state, com_statement_info[thd->get_command()].m_key,
+      thd->db().str, thd->db().length, thd->charset(), nullptr);
+
+  // Reset the statement digest state.
+  thd->m_digest = &thd->m_digest_state;
+  thd->m_digest->reset(thd->m_token_array, max_digest_length);
+
+  // Reset the parser state.
+  thd->set_query(query_string, query_length);
+  parser_state->reset(query_string, query_length);
+
+  // Disable the general log. The query was written to the general log in the
+  // first attempt to execute it. No need to write it twice.
+  const uint64_t saved_option_bits = thd->variables.option_bits;
+  thd->variables.option_bits |= OPTION_LOG_OFF;
+
+  // Set parallel_cost_threshold to the max value to avoid parallel query being
+  // chosen again.
+  auto saved_parallel_cost_threshold = thd->variables.parallel_cost_threshold;
+  thd->variables.parallel_cost_threshold = ULONG_MAX;
+  thd->no_pq = true;
+
+  // Restart the statement.
+  thd->retry_without_pq = true;
+
+  dispatch_sql_command(thd, parser_state, /*clean_pq_variables=*/true);
+
+  // Restore the variables that was temporarily changed.
+  thd->variables.option_bits = saved_option_bits;
+  thd->variables.parallel_cost_threshold = saved_parallel_cost_threshold;
+}
