+bool Item_subselect::eq(const Item *item, bool cmp) const {
+  if (this == item) return true;
+
+  /*
+    Outside of PQ, Item_subselect are never cloned, so the test above is good
+    enough. In PQ, things are more complicated, as there are clones.
+    super::eq() is not very good as it uses name comparison and subquery items
+    don't always have names. So we try a little harder: if one item is a clone
+    of the other, they are the same.
+  */
+  if (item->type() != Item::SUBSELECT_ITEM) return false;
+
+  auto compared_item = down_cast<const Item_subselect *>(item);
+
+  if (this->substype() != compared_item->substype()) return false;
+
+  if (this->m_pq_last_clone.second == compared_item ||
+      compared_item->m_pq_last_clone.second == this)
+    return true;
+
+  return super::eq(item, cmp);
+}
