diff --git a/mysql-test/suite/parallel_query/include/pq_divide_derived_setup.inc b/mysql-test/suite/parallel_query/include/pq_divide_derived_setup.inc
new file mode 100644
index 00000000000..f77d6c003e2
--- /dev/null
+++ b/mysql-test/suite/parallel_query/include/pq_divide_derived_setup.inc
@@ -0,0 +1,43 @@
+# Some setup which is common to the variants of pq_divide_derived*.test
+
+create database pq_test;
+use pq_test;
+
+# Materialize derived table, and leave filtering condition on it (to test ref access).
+SET @@optimizer_switch="derived_merge=off,derived_condition_pushdown=off";
+
+create table t1(
+        id int primary key auto_increment,
+        col1 varchar(100),
+        col2 int
+ )engine= innodb;
+
+--disable_query_log
+# With the table definition, our derived table has 2730 rows per page. We need
+# more rows, to have at least two data pages, so that at least two
+# workers can share the job. Here we have ~6 pages.
+ let $loop=100;
+ while($loop)
+ {
+  eval insert into t1(col1, col2) values(repeat('test', 20), $loop);
+  dec $loop;
+ }
+--enable_query_log
+
+show variables like 'force_parallel_execute';
+flush status;
+
+select @@internal_tmp_mem_storage_engine;
+
+let $query_full = select sum(prod) from (select t1.id*t2.id as prod from t1, t1 as t2) as derived;
+let $query_ref = select sum(prod) from (select t1.id*t2.id as prod from t1, t1 as t2) as derived where prod=33;
+
+# Same with more rows, to test when memory limit is exceeded in Temptable engine
+let $query_full_big = select sum(prod) from (select t1.id*t2.id as prod from t1, t1 as t2, t1 as t3) as derived;
+let $query_ref_big = select sum(prod) from (select t1.id*t2.id as prod from t1, t1 as t2, t1 as t3) as derived where prod=33;
+
+# Returns 1 if Temptable engine wrote to mmap-ed file
+let $check_disk_alloc=
+SELECT count_alloc > 0
+FROM performance_schema.memory_summary_global_by_event_name
+WHERE event_name = 'memory/temptable/physical_disk';
diff --git a/mysql-test/suite/parallel_query/include/pq_on_disk_hash_join.inc b/mysql-test/suite/parallel_query/include/pq_on_disk_hash_join.inc
new file mode 100644
index 00000000000..d4740948d6b
--- /dev/null
+++ b/mysql-test/suite/parallel_query/include/pq_on_disk_hash_join.inc
@@ -0,0 +1,130 @@
+# A set of queries that is reused multiple times in pq_hash_join.test
+
+# Do a reconnect so that any changes to global variables
+# (like vfd_max_open_files) becomes visible.
+--disconnect default
+--connect (default,localhost,root,,test)
+ANALYZE TABLE t1;
+
+### Test inner join
+
+# Make sure that the IO statistics are empty.
+TRUNCATE performance_schema.file_summary_by_event_name;
+
+SELECT COUNT_STAR = 0 FROM performance_schema.file_summary_by_event_name
+WHERE EVENT_NAME LIKE "%hash_join%";
+
+--replace_regex /cost=[0-9e\.\+]+/cost=***/  /rows=[0-9e\.\+]+/rows=***/
+EXPLAIN FORMAT=tree SELECT /*+ PQ(t2) */ COUNT(*) FROM t1 JOIN t1 t2 ON t1.s = t2.s;
+
+# Before sending EOF after executing the hash join, open a new connection and
+# look at the performance schema to see that the number of open files is equal
+# to or below vfd_max_open_files.
+SET debug_sync = "before_send_eof SIGNAL stats_ready
+                  WAIT_FOR main_thread_continue";
+--send SELECT /*+ PQ(t2) */ COUNT(*) FROM t1 JOIN t1 t2 ON t1.s = t2.s;
+
+--connect (stats_connection, localhost, root,,test)
+SET debug_sync = "now WAIT_FOR stats_ready";
+SELECT
+  COUNT(*) BETWEEN FLOOR(@@vfd_max_open_files * 0.9) AND @@vfd_max_open_files,
+  @@vfd_max_open_files
+FROM performance_schema.file_instances
+WHERE EVENT_NAME LIKE "%hash_join%" AND OPEN_COUNT > 0;
+SET debug_sync = "now SIGNAL main_thread_continue";
+
+--connection default
+--reap
+
+
+SELECT COUNT_STAR > 0 FROM performance_schema.file_summary_by_event_name
+WHERE EVENT_NAME LIKE "%hash_join%";
+
+
+### Test outer join
+
+TRUNCATE performance_schema.file_summary_by_event_name;
+
+SELECT COUNT_STAR = 0 FROM performance_schema.file_summary_by_event_name
+WHERE EVENT_NAME LIKE "%hash_join%";
+
+--replace_regex /cost=[0-9e\.\+]+/cost=***/  /rows=[0-9e\.\+]+/rows=***/
+EXPLAIN FORMAT=tree SELECT COUNT(*) FROM t1 LEFT JOIN t1 t2 ON t1.s = t2.s;
+SET debug_sync = "before_send_eof SIGNAL stats_ready
+                  WAIT_FOR main_thread_continue";
+--send SELECT COUNT(*) FROM t1 LEFT JOIN t1 t2 ON t1.s = t2.s;
+
+--connection stats_connection
+SET debug_sync = "now WAIT_FOR stats_ready";
+SELECT
+  COUNT(*) BETWEEN FLOOR(@@vfd_max_open_files * 0.9) AND @@vfd_max_open_files,
+  @@vfd_max_open_files
+FROM performance_schema.file_instances
+WHERE EVENT_NAME LIKE "%hash_join%" AND OPEN_COUNT > 0;
+SET debug_sync = "now SIGNAL main_thread_continue";
+
+--connection default
+--reap
+
+SELECT COUNT_STAR > 0 FROM performance_schema.file_summary_by_event_name
+WHERE EVENT_NAME LIKE "%hash_join%";
+
+### Test semijoin
+
+TRUNCATE performance_schema.file_summary_by_event_name;
+
+SELECT COUNT_STAR = 0 FROM performance_schema.file_summary_by_event_name
+WHERE EVENT_NAME LIKE "%hash_join%";
+
+SET optimizer_switch = "materialization=off";
+--replace_regex /cost=[0-9e\.\+]+/cost=***/  /rows=[0-9e\.\+]+/rows=***/
+EXPLAIN FORMAT=tree SELECT COUNT(*) FROM t1 WHERE t1.s IN (SELECT s FROM t1 t2);
+SET debug_sync = "before_send_eof SIGNAL stats_ready
+                  WAIT_FOR main_thread_continue";
+--send SELECT COUNT(*) FROM t1 WHERE t1.s IN (SELECT s FROM t1 t2);
+
+--connection stats_connection
+SET debug_sync = "now WAIT_FOR stats_ready";
+SELECT
+  COUNT(*) BETWEEN FLOOR(@@vfd_max_open_files * 0.9) AND @@vfd_max_open_files,
+  @@vfd_max_open_files
+FROM performance_schema.file_instances
+WHERE EVENT_NAME LIKE "%hash_join%" AND OPEN_COUNT > 0;
+SET debug_sync = "now SIGNAL main_thread_continue";
+
+--connection default
+--reap
+
+SELECT COUNT_STAR > 0 FROM performance_schema.file_summary_by_event_name
+WHERE EVENT_NAME LIKE "%hash_join%";
+
+### Test antijoin
+
+TRUNCATE performance_schema.file_summary_by_event_name;
+
+SELECT COUNT_STAR = 0 FROM performance_schema.file_summary_by_event_name
+WHERE EVENT_NAME LIKE "%hash_join%";
+
+--replace_regex /cost=[0-9e\.\+]+/cost=***/  /rows=[0-9e\.\+]+/rows=***/
+EXPLAIN FORMAT=tree SELECT COUNT(*) FROM t1 WHERE t1.s NOT IN (SELECT s FROM t1 t2);
+SET debug_sync = "before_send_eof SIGNAL stats_ready
+                  WAIT_FOR main_thread_continue";
+--send SELECT COUNT(*) FROM t1 WHERE t1.s NOT IN (SELECT s FROM t1 t2);
+
+--connection stats_connection
+SET debug_sync = "now WAIT_FOR stats_ready";
+SELECT
+  COUNT(*) BETWEEN FLOOR(@@vfd_max_open_files * 0.9) AND @@vfd_max_open_files,
+  @@vfd_max_open_files
+FROM performance_schema.file_instances
+WHERE EVENT_NAME LIKE "%hash_join%" AND OPEN_COUNT > 0;
+SET debug_sync = "now SIGNAL main_thread_continue";
+
+--connection default
+--reap
+
+SELECT COUNT_STAR > 0 FROM performance_schema.file_summary_by_event_name
+WHERE EVENT_NAME LIKE "%hash_join%";
+
+SET optimizer_switch = DEFAULT;
+--disconnect stats_connection
