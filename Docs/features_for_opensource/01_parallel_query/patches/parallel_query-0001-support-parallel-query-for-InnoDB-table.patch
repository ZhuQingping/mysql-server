index ca3f7058f4b..114ab8c30ac 100644
--- a/sql/item_subselect.cc
+++ b/sql/item_subselect.cc
@@ -545,6 +545,28 @@ bool Item_subselect::fix_fields(THD *thd, Item **ref) {
 
   if (check_stack_overrun(thd, STACK_MIN_SIZE, (uchar *)&res)) return true;
 
+  if ((substype() != SINGLEROW_SUBS) && (substype() != EXISTS_SUBS)) {
+    /*
+      Subqueries can be transformed from "ANY/ALL/SOME" in two cases:
+        1) transform "ANY/ALL" to "SELECT (MIN)". Then one item_sum is formed to
+           evaluate the aggregation. As PQ leader has to rebuild the item_sum
+           and the upper query needs it, it is complex for our current PQ clone
+           paradigm and we disable it.
+        2) transform "ANY/ALL" to "MIN(SELECT)". Then one item_maxmin_subselect
+           is formed as unit->item. As we have not cloned this item, we should
+           also disable PQ. Then, subquery_suite_for_parallel_query() can
+           capture it.
+
+        the line below disables PQ for the subquery; and PQ is also disabled for
+        the outer query by having Item_func_not_all in the list of non-clonable,
+        PQ-unsupported item classes.
+    */
+    for (auto sl = unit->first_query_block(); sl; sl = sl->next_query_block()) {
+      sl->m_suite_for_pq = false;
+      sl->pq_unsuite_info = PQUnsuiteInfo::SUBQUERY_TRANS;
+    }
+  }
+
   if (!(res = subquery->prepare(thd))) {
     // all transformation is done (used by prepared statements)
     changed = true;
@@ -663,6 +685,40 @@ bool Item_subselect::exec(THD *thd) {
   trace_exec.add_select_number(unit->first_query_block()->select_number);
   Opt_trace_array trace_steps(trace, "steps");
 
+  // If the subquery has been executed or assigned, PQ worker can directly
+  // return as the result has been cached.
+  assert(unit);
+  if ((unit->is_executed() || assigned()) &&
+      unit->outer_query_block()->parallel_exec && !unit->uncacheable) {
+    // If the outer query is marked as "parallel execute", then the
+    // included subquery in "Item_subselect" is sure to be suitable for PQ.
+    assert(unit->subquery_suite_for_parallel_query() ==
+           PQSubqueryExecution::kOnceByLeader);
+    switch (substype()) {
+      case SINGLEROW_SUBS: {
+#ifndef NDEBUG
+        auto origin_item = down_cast<Item_singlerow_subselect *>(unit->item);
+        auto cloned_item = down_cast<Item_singlerow_subselect *>(this);
+        assert(origin_item && cloned_item);
+        for (uint i = 0; i < max_columns; i++) {
+          assert(origin_item->element_index(i) ==
+                 cloned_item->element_index(i));
+        }
+#endif  // NDEBUG
+      } break;
+      case EXISTS_SUBS: {
+        // synchronize value
+        auto origin_item = down_cast<Item_exists_subselect *>(unit->item);
+        auto cloned_item = down_cast<Item_exists_subselect *>(this);
+        cloned_item->pq_share_value(origin_item);
+      } break;
+      default:
+        assert(false);
+    }
