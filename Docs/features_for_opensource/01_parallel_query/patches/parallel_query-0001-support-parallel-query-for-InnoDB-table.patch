+## Aggr. limit 
+CREATE TABLE t1 (a int, b int); 
+
+let $1=64;
+--disable_query_log
+
+while($1) 
+{
+  let $2=32;
+	while($2)
+	{
+		eval INSERT INTO t1 VALUES (MOD($1, 23), MOD(133, $2)); 
+		dec $2;
+	}
+	dec $1; 
+}
+
+--enable_query_log
+
