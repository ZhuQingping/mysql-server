+# BUGFIX
+CREATE TABLE t0 (c0 BIT(58), UNIQUE INDEX i0 (c0));
+CREATE TABLE t1 (c0 INT);
+SELECT 1 FROM (SELECT count(*) FROM (SELECT 1) x(x) JOIN t1 ON TRUE) y(y) LEFT JOIN t0 ON t0.c0 = field(y.y, 'a') JOIN t1 ON TRUE;
+
+drop table t0;
