+  KEY ndx_15_16_17_18 (c_credit_lim,c_discount,c_balance,c_ytd_payment) USING BTREE,
+  KEY ndx_19_20_21 (c_payment_cnt,c_delivery_cnt,c_data) USING BTREE,
+  KEY ndx_4_7_9_13_15_19 (c_first,c_street_1,c_city,c_since,c_credit_lim,c_payment_cnt) USING BTREE
+) partition by range(c_d_id)
+subpartition by key(c_w_id) subpartitions 10
+(
+  partition p1 values less than (15),
+  partition p2 values less than (30),
+  partition p3 values less than (50),
+  partition p4 values less than maxvalue
+);
+insert into t0_range_key_subpartition select * from t0;
+
+CREATE TABLE t0_hash_partition_p1 (
+  c_id int NOT NULL,
+  c_d_id int NOT NULL,
+  c_w_id int NOT NULL,
+  c_first varchar(16) DEFAULT NULL,
+  c_middle char(2) DEFAULT NULL,
+  c_last varchar(16) DEFAULT NULL,
+  c_street_1 varchar(20) DEFAULT NULL,
+  c_street_2 varchar(20) DEFAULT NULL,
+  c_city varchar(20) DEFAULT NULL,
+  c_state char(2) DEFAULT NULL,
+  c_zip char(9) DEFAULT NULL,
+  c_phone char(16) DEFAULT NULL,
+  c_since timestamp NOT NULL DEFAULT '1970-01-01 16:00:01',
+  c_credit char(2) DEFAULT NULL,
+  c_credit_lim decimal(12,2) DEFAULT NULL,
+  c_discount decimal(4,4) DEFAULT NULL,
+  c_balance decimal(12,2) DEFAULT NULL,
+  c_ytd_payment decimal(12,2) DEFAULT NULL,
+  c_payment_cnt int DEFAULT NULL,
+  c_delivery_cnt int DEFAULT NULL,
+  c_data varchar(500) DEFAULT NULL,
+  PRIMARY KEY (c_w_id,c_d_id,c_id),
+  KEY Customer_100W_key (c_w_id,c_d_id,c_last,c_first),
+  KEY ndx_c_id (c_id) USING BTREE,
+  KEY ndx_c_d_id (c_d_id) USING BTREE,
+  KEY ndx_c_w_id (c_w_id) USING BTREE,
+  KEY ndx_c_first (c_first) USING BTREE,
+  KEY ndx_c_middle (c_middle) USING BTREE,
+  KEY ndx_c_last (c_last) USING BTREE,
+  KEY ndx_c_street_1 (c_street_1) USING BTREE,
+  KEY ndx_c_street_2 (c_street_2) USING BTREE,
+  KEY ndx_c_city (c_city) USING BTREE,
+  KEY ndx_c_state (c_state) USING BTREE,
+  KEY ndx_c_zip (c_zip) USING BTREE,
+  KEY ndx_c_phone (c_phone) USING BTREE,
+  KEY ndx_c_since (c_since) USING BTREE,
+  KEY ndx_c_credit (c_credit) USING BTREE,
+  KEY ndx_c_credit_lim (c_credit_lim) USING BTREE,
+  KEY ndx_c_discount (c_discount) USING BTREE,
+  KEY ndx_c_balance (c_balance) USING BTREE,
+  KEY ndx_c_ytd_payment (c_ytd_payment) USING BTREE,
+  KEY ndx_c_payment_cnt (c_payment_cnt) USING BTREE,
+  KEY ndx_c_delivery_cnt (c_delivery_cnt) USING BTREE,
+  KEY ndx_c_data (c_data) USING BTREE,
+  KEY ndx_4_5_6 (c_first,c_middle,c_last) USING BTREE,
+  KEY ndx_7_8 (c_street_1,c_street_2) USING BTREE,
+  KEY ndx_9_10_11_12 (c_city,c_state,c_zip,c_phone) USING BTREE,
+  KEY ndx_13_14 (c_since,c_credit) USING BTREE,
+  KEY ndx_15_16_17_18 (c_credit_lim,c_discount,c_balance,c_ytd_payment) USING BTREE,
+  KEY ndx_19_20_21 (c_payment_cnt,c_delivery_cnt,c_data) USING BTREE,
+  KEY ndx_4_7_9_13_15_19 (c_first,c_street_1,c_city,c_since,c_credit_lim,c_payment_cnt) USING BTREE
+) partition by hash(c_id) partitions 1;
+
+
+insert into t0_hash_partition_p1 select * from t0;
+
+create view t0_range_key_subpartition_sub_view as select * from t0_range_key_subpartition where c_d_id < 15 and c_w_id=2 union all select * from t0_range_key_subpartition where c_d_id > 15 and c_d_id<30 and c_w_id=1 union all select * from t0_range_key_subpartition where c_d_id > 30 and  c_d_id<50 and c_w_id=1;
+
+create view t0_hash_partition_p1_view  as select * from t0_hash_partition_p1;
+
+create view t0_partition_sub_view_mixed_001 as select * from t0_range_partition where c_d_id <15 Union all select * from t0_list_partition where c_w_id in (0,2) union all select * from t0_key_partition where c_w_id = 4 union all select * from t0_linear_hash_partition where c_w_id = 5 union select * from t0_hash_partition where c_w_id =8;
+
+--echo #BUGFIX: the view query is located into one outer query that is optimized to
+--echo #produce zero-result, then we have not set the shared structure of view, leading to
+--echo #the coredump when creating access path.
+
+let query = select
+ref_12.c_delivery_cnt AS c0
+FROM   (SELECT sub_1.id as c13
+        FROM   t0_sub_1 AS ref_0
+               LEFT JOIN  (select 1 from t0_sub_1 inner join t0_sub_union as ref_1 on (false)) AS sub_1(id)
+                      ON ( false )
+        WHERE  ref_0.c_id IS NOT NULL) AS subq_0
+       LEFT JOIN (SELECT ref_2.c_credit AS c0
+                  FROM   t0_hash_partition_p1 AS ref_2
+                         LEFT JOIN t0_hash_partition_p1 AS ref_3
+                                ON ( Pi() IS NOT NULL )) AS subq_2
+                 LEFT JOIN t0_sub_union AS ref_11
+                           RIGHT JOIN t0_hash_partition_p1 AS ref_12
+                                   ON ( ( ( true )
+                                          AND ( ref_12.c_discount IS NULL ) )
+                                        AND ( false ) )
+                        ON ( true )
+              ON ( ( ref_11.c_street_1 IS NOT NULL )
+                   AND ( ref_11.c_w_id IS NULL ) )
+WHERE  ( subq_0.c13 IS NULL )
+GROUP  BY 1
+ORDER  BY 1;
+
+--replace_regex $elide_costs_and_rows
+eval explain format=tree $query;
+eval $query;
+
+--echo #BUGFIX: reset NULL row flag will lead hash join read
+--echo #uncorrect data which should be a NULL-complemented row after
+--echo #re-fill hash table.
+
+SET @save_join_buffer_size = @@join_buffer_size;
+SET @@join_buffer_size = 16384;
+--replace_regex $elide_costs_and_rows
+EXPLAIN FORMAT=tree SELECT /*+ JOIN_ORDER(ref_4, t0) */ ref_6.c0 AS c1, ref_5.c_since AS c3 FROM t5 AS ref_4 RIGHT JOIN t0 AS ref_5 RIGHT JOIN tx_cmplx_005 AS ref_6 ON (ref_5.c_city = ref_6.c0) ON (true) INNER JOIN t0_sub_1 AS ref_15 ON (true) LIMIT 47486, 3;
+SELECT /*+ JOIN_ORDER(ref_4, t0) */ ref_6.c0 AS c1, ref_5.c_since AS c3 FROM t5 AS ref_4 RIGHT JOIN t0 AS ref_5 RIGHT JOIN tx_cmplx_005 AS ref_6 ON (ref_5.c_city = ref_6.c0) ON (true) INNER JOIN t0_sub_1 AS ref_15 ON (true) LIMIT 47486, 3;
+SET @@join_buffer_size= @save_join_buffer_size;
+
+--echo #BUGFIX: reset NULL row flag will lead hash join core
+--echo #in storing row ID which should be a NULL-complemented row after
+--echo #re-fill hash table;
+
+let query = select  
+  subq_0.c2 as c0, 
+  subq_1.c2 as c1, 
+  subq_1.c2 as c2, 
+  subq_2.c0 as c3
+from 
+  (select  
+            ref_0.C_MIDDLE as c0, 
+            ref_1.c_middle as c1, 
+            ref_0.C_PHONE as c2
+          from 
+            t10 as ref_0
+              inner join t0_sub_1 as ref_1
+              on (false)
+          where false
+          ) as subq_0
+      right join (select  
+            ref_2.c_d_id as c0, 
+            ref_2.c_street_2 as c1, 
+            ref_2.c_id as c2
+          from 
+            t0 as ref_2
+          ) as subq_1
+      on (subq_1.c2 is not NULL)
+    right join (select  
+          lpad(
+            ref_4.c_middle,
+            log2(
+              locate(
+                ref_4.c_middle,
+                ref_4.c_street_1)),
+            ref_4.c_middle) as c0
+        from 
+          t5 as ref_4
+            inner join tx_cmplx_003 as ref_5
+            on (ref_5.c6 is not NULL)
+        where ref_4.c_state is NULL
+        ) as subq_2
+    on (EXISTS (
+        select  
+            subq_2.c0 as c0, 
+            pi() as c1, 
+            ref_6.c_w_id as c2, 
+            subq_0.c1 as c3
+          from 
+            t0_sub_union as ref_6
+          where ref_6.c_middle is NULL
+          ))
+where EXISTS (
+  select  
+      ref_17.C_END as c0
+    from 
+      tx_cmplx_005 as ref_12
+          right join t5 as ref_13
+              right join tx_cmplx_004 as ref_14
+              on (ref_13.c_city = ref_14.c3 )
+            inner join tx_cmplx_004 as ref_15
+              left join t12 as ref_16
+              on (true)
+            on (true)
+          on (ref_16.C_STREET_2 is not NULL)
+        right join t12 as ref_17
+          right join t0_sub_1 as ref_18
+          on (true)
+        on (ref_12.c1 = ref_18.c_street_1 )
+    where (EXISTS (
+        select  
+            ref_15.c2 as c0, 
+            ref_15.c3 as c1, 
+            pi() as c2, 
+            subq_1.c1 as c3
+          from 
+            t0 as ref_19
+                  inner join tx_cmplx_005 as ref_20
+                  on (false)
+                left join tx_cmplx_001 as ref_21
+                on (false)
+              inner join t5 as ref_22
+              on ((ref_20.c1 is NULL) and (ref_21.c2 is NULL))
+          where (mod(
+                ref_17.C_PAYMENT_CNT,
+                ref_19.c_d_id) is not NULL)
+          )) 
+      or (ref_16.C_SINCE is NULL)
+    )
+
+group by 1,2,3,4
+order by 1,2,3,4;
+
+--disable_warnings
+--replace_regex $elide_costs_and_rows
+eval EXPLAIN FORMAT=tree $query;
+eval $query;
+--enable_warnings
+
+set @opt_sw_save= @@optimizer_switch;
+set optimizer_switch = 'derived_merge=off';
+
+--echo BUGFIX: table subq_0 contains two columns c1 and c2, while
+--echo we alias subq_0.c2 as c1. When the query contains group by c2, PQ worker
+--echo resolves to error column.
+
+let query = SELECT
+subq_0.c2 AS c1,
+subq_0.c2 AS c2,
+(CASE
+  WHEN false THEN subq_0.c1
+  ELSE subq_0.c1
+ end ) AS c3
+FROM (SELECT ref_0.c_street_2 AS c1,
+             ref_0.c_bit AS c2
+      FROM   t10 ref_0) subq_0
+GROUP BY
+  subq_0.c2,
+  subq_0.c2,
+  (CASE
+    WHEN false THEN subq_0.c1
+    ELSE subq_0.c1
+   end)
+ORDER BY
+  subq_0.c2,
+  subq_0.c2,
+  (CASE
+    WHEN false THEN subq_0.c1
+    ELSE subq_0.c1
+  end);
+
+--replace_regex $elide_costs_and_rows
+eval EXPLAIN FORMAT=tree $query;
+eval $query;
+
+let query = select
+  40 as c0
+from
+  (select
+        ref_0.c1 as c0,
+        ref_2.c3 as c1,
+        pi() as c2
+      from
+        tx_cmplx_004 as ref_0
+          inner join t1 as ref_1
+            right join tx_cmplx_004 as ref_2
+            on (true)
+          on ((((ref_1.c_first is NULL)
+                  and (ref_2.c3 is NULL))
+                and ((ref_2.c2 is not NULL)
+                  or (false)))
+              or (true))
+      where (pi() is not NULL)
+        and (ref_0.c1 is NULL)
+      ) as subq_0
+where true
+group by 1
+order by 1;
+
+--replace_regex $elide_costs_and_rows
+eval EXPLAIN FORMAT=tree $query;
+eval $query;
+
+DROP tables t0, t1, t10, t11, t12, t2, t4, t5;
+DROP VIEW tx_cmplx_001, tx_cmplx_002, tx_cmplx_003, tx_cmplx_004, tx_cmplx_005, tx_cmplx_006;
+DROP VIEW t0_sub_1, t0_sub_union;
+
+DROP tables t0_range_partition, t0_list_partition, t0_hash_partition, t0_linear_hash_partition, t0_key_partition;
+DROP tables t0_range_key_subpartition, t0_hash_partition_p1;
+DROP VIEW t0_range_key_subpartition_sub_view, t0_hash_partition_p1_view, t0_partition_sub_view_mixed_001;
+
+set sql_mode = @saved_sql_mode;
+set optimizer_switch = @opt_sw_save;
+
+--source include/restore_opt_switch_after_turn_off_join_elimination.inc
