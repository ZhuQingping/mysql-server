+      from
+        (
+          select set_col, date_col from t2
+          UNION ALL
+          select set_col, date_col from t2 order by 1 desc, 2 limit 1000
+        ) dt
+        inner join CTE1 a ON dt.set_col = a.c1
+    )
+    select
+      set_col
+    from
+      CTE2
+  );
+
+drop table t1,t2;
