+class Slice_map_cell : public Map_cell<Slices_mngr *> {
+ public:
+  Slices_mngr *get(const PQ_ref_key &ref_key) override {
+    mysql_mutex_lock(&m_mutex);
+    KV *e = head;
+    while (e != nullptr) {
+      if (*(e->key) == ref_key) break;
+      e = e->next;
+    }
+    mysql_mutex_unlock(&m_mutex);
+    if (e)
+      return e->value;
+    else
+      return nullptr;
+  }
+};
