+### row saving, which will result in uncorrect result with missing some rows.
+CREATE TABLE t1 (i INTEGER);
+CREATE TABLE t2 (i INTEGER);
+
+--disable_query_log
+let $i=100;
+while ($i)
+{
+  eval insert into t1 values($i);
+  dec $i;
+}
+INSERT INTO t2 SELECT * FROM t1;
+--enable_query_log
+ANALYZE TABLE t1, t2;
+
+SET @save_optimizer_switch= @@optimizer_switch;
+SET @save_pq_hash_join_max_hash_table_refills= @@pq_hash_join_max_hash_table_refills;
+SET optimizer_switch="materialization=off";
+SET join_buffer_size = 128;
+SET pq_hash_join_max_hash_table_refills = 999999999;
+
+--replace_regex /cost=[0-9e\.\+]+/cost=***/  /rows=[0-9e\.\+]+/rows=***/
+EXPLAIN FORMAT=tree SELECT * FROM t1 WHERE t1.i IN (SELECT t2.i FROM t2) order by t1.i limit 5;
+SELECT * FROM t1 WHERE t1.i IN (SELECT t2.i FROM t2) order by t1.i limit 5;
+
+SET @@optimizer_switch = @save_optimizer_switch;
+SET join_buffer_size = DEFAULT;
+SET @@pq_hash_join_max_hash_table_refills = @save_pq_hash_join_max_hash_table_refills;
+DROP TABLE t1,t2;
+
+### If non-inner hash join needs re-fill hash table, it will enable saving file.
+### For the last re-fill hash table, if the shared hash table is not full and also
+### not empty, it need disable saving file.
+CREATE TABLE t1 (i BIGINT NOT NULL);
+CREATE TABLE t2 (i BIGINT NOT NULL);
+
+INSERT INTO t1 SELECT RAND(1) * 10000000;
+INSERT INTO t1 SELECT RAND(2) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(3) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(4) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(5) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(6) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(7) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(8) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(9) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(10) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(11) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(12) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(13) * 10000000 FROM t1;
+INSERT INTO t1 SELECT RAND(14) * 10000000 FROM t1;
+INSERT INTO t2 SELECT RAND(15) * 10000000 FROM t1;
+
+ANALYZE TABLE t1, t2;
+SET @save_optimizer_switch= @@optimizer_switch;
+SET optimizer_switch="materialization=off";
+
+EXPLAIN FORMAT=tree SELECT * FROM t1 WHERE i NOT IN (SELECT /*+ PQ() */ i FROM t2) ORDER BY t1.i LIMIT 2;
+SELECT * FROM t1 WHERE i NOT IN (SELECT /*+ PQ() */ i FROM t2) ORDER BY t1.i LIMIT 2;
+
+### Disable reject duplicate keys in parallel-aware hash join.
+### Because before inserting into the shared hash table, it will check whether the
+### shared hash table contains the key, but it don't get a lock. While other worker
+### may be modifying the shared hash table.
+--replace_regex /cost=[0-9e\.\+]+/cost=***/  /rows=[0-9e\.\+]+/rows=***/
+EXPLAIN FORMAT=tree SELECT * FROM t1 WHERE i NOT IN (SELECT /*+ PQ(64) */ i FROM t2) ORDER BY t1.i LIMIT 2;
+SELECT * FROM t1 WHERE i NOT IN (SELECT /*+ PQ(64) */ i FROM t2) ORDER BY t1.i LIMIT 2;
+
+SET @@optimizer_switch = @save_optimizer_switch;
+DROP TABLE t1,t2;
+
+--echo #
+--echo # BUGFIX For parallel-aware hash join, if cut table is under the
+--echo #                  WEEDOUT, it will result duplicate results. Because for
+--echo #                  workers, it just remove duplicate in worker, not between
+--echo #                  workers. So WEEDOUT can not contain cut table.
+--echo #                  Due to this scenario is related to big distribution and
+--echo #                  big data, only related execution plan is displayed here.
+
+SET @@optimizer_switch = @save_optimizer_switch;
+
+CREATE TABLE t1 (
+  id_col int NOT NULL AUTO_INCREMENT,
+  mediumint_col mediumint DEFAULT NULL,
+  decimal_col decimal(25,5) DEFAULT NULL,
+  PRIMARY KEY (id_col DESC),
+  KEY ndx_mediumint_decimal_col (mediumint_col DESC, decimal_col DESC)
+) ENGINE=InnoDB AUTO_INCREMENT=114 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
+
+CREATE TABLE t2 (
+  id_col int NOT NULL AUTO_INCREMENT,
+  mediumint_col mediumint DEFAULT NULL,
+  decimal_col decimal(25,5) DEFAULT NULL,
+  PRIMARY KEY (id_col DESC)
+) ENGINE=InnoDB AUTO_INCREMENT=114 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
+
+CREATE TABLE t3 (
+  id_col int NOT NULL,
+  mediumint_col mediumint DEFAULT NULL,
+  decimal_col decimal(25,5) DEFAULT NULL,
+  float_col float DEFAULT NULL,
+  datetimelist_col datetime(6) NOT NULL,
+  PRIMARY KEY (datetimelist_col DESC, id_col DESC),
+  KEY ndx_decimal_float_col (datetimelist_col DESC, decimal_col DESC, float_col DESC)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
+
+SET optimizer_switch="loosescan=off,firstmatch=off";
+
+--echo # The origin execution plan choose C as cut table. After fixed, the cut table can
+--echo # not under WEEDOUT
+let $query = WITH A AS (SELECT /*+PQ(C, B)*/ A.decimal_col, A.mediumint_col FROM t1 A JOIN t2 B ON A.decimal_col = B.decimal_col AND A.mediumint_col = B.mediumint_col WHERE (A.decimal_col, A.mediumint_col) = ANY (SELECT decimal_col, mediumint_col FROM t3 C WHERE (C.datetimelist_col = '1984-02-01 00:00:00' OR C.datetimelist_col = '1984-02-29 23:59:59') AND C.decimal_col > 0.00000)) SELECT /*+join_order(A,C,B)*/ A.decimal_col, RADIANS(A.mediumint_col) FROM A WHERE A.mediumint_col > 1 ORDER BY 1, 2;
+
+--replace_regex /cost=[0-9e\.\+]+/cost=***/  /rows=[0-9e\.\+]+/rows=***/
+eval EXPLAIN FORMAT=tree $query;
+
+SET @@optimizer_switch = @save_optimizer_switch;
+drop table t1, t2, t3;
+
+--echo #
+--echo # BUGFIX PQ remaining workers assertion error
+--echo #
+CREATE TABLE t0 (c0 INT UNIQUE KEY);
+CREATE TABLE t1 (c0 INT);
+INSERT INTO t0(c0) VALUES (1),(2),(3),(4),(5);
+INSERT INTO t1(c0) VALUES (1);
+ANALYZE TABLE t0, t1;
+let $query = SELECT ((SELECT 1 FROM t1 JOIN t0) UNION (SELECT 1 WHERE t0.c0 = 1)) FROM t0;
+
+--echo # Verify that we have a parallel hash join under a dependent subquery.
+--replace_regex /cost=[0-9e\.\+]+/cost=***/  /rows=[0-9e\.\+]+/rows=***/
+eval EXPLAIN FORMAT=tree $query;
+eval $query;
+DROP TABLE t0, t1;
+
+#
+# BUGFIX zero-length values hits an assertion
+#
+# In order to create a zero-length value, we need:
+# - A collation with PAD SPACE.
+# - A string with no length.
+# - A data type with max length == 0.
+CREATE TABLE t (s VARCHAR(0) COLLATE utf8mb4_bin);
+INSERT INTO t VALUES ("");
+let $query = SELECT * FROM t JOIN t t2 ON t.s = t2.s;
+
+--replace_regex /cost=[0-9e\.\+]+/cost=***/  /rows=[0-9e\.\+]+/rows=***/
+eval EXPLAIN FORMAT=tree $query;
+eval $query;
+
+# Set debug flags to increase code coverage.
+SET SESSION debug="+d, force_bloom_filter_miss";
+eval $query;
+SET SESSION debug="-d, force_bloom_filter_miss";
+
+DROP TABLE t;
+
+--echo #
+--echo # Test parallel-aware hash join with spill to disk.
+--echo #
+CREATE TABLE t1 (i INTEGER NOT NULL, s VARCHAR(255) NOT NULL);
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID();
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+INSERT INTO t1 SELECT RAND() * 2147483647, UUID() FROM t1;
+
+ANALYZE TABLE t1;
+
+# UUID() should be random enough to not give any duplicate values. Also, reduce
+# join_buffer_size to make sure that spill-to-disk is triggered.
+SET GLOBAL join_buffer_size = 128;
+
+# Do a set of tests with parallel-aware hash join with spill to disk, where we
+# change the value of vfd_max_open_files.
+SET GLOBAL vfd_max_open_files = 1;
+--source ../include/pq_on_disk_hash_join.inc
+
+SET GLOBAL vfd_max_open_files = 256;
+--source ../include/pq_on_disk_hash_join.inc
+
+SET GLOBAL vfd_max_open_files = DEFAULT;
+--source ../include/pq_on_disk_hash_join.inc
+
+# Do the same test, but now with spill to disk disabled for parallel hash join.
+SET GLOBAL pq_support_features_switch='hash_join_spill_to_disk=off';
+--source ../include/pq_on_disk_hash_join.inc
+
+SET GLOBAL join_buffer_size = DEFAULT;
+
+# Note: The default is currently OFF, but MTR will set it to ON using command
+# line argument. So if we reset it to DEFAULT, "check-testcase" will fail saying
+# that it has not been reset properly (it should have been reset to the value it
+# had at the start of the test).
+SET GLOBAL pq_support_features_switch='hash_join_spill_to_disk=on';
+
+# Reconnect so that changes to the global variables are visible for the next
+# test.
+--disconnect default
+--connect (default,localhost,root,,test)
+
+DROP TABLE t1;
+
+--echo #
+--echo # BUGFIX
+--echo #
+# We want to create the following query plan:
+#
+#           Parallel-aware hash join
+#           | (probe)              | (build)
+#          t3            parallel-oblivious hash join
+#                        | (probe)                  | (build)
+#                       t2                          t1
+#
+# In addition, we want the shared hash table in the parallel-aware hash join to
+# only store rows with zero length and zero-length hash table keys. In order to
+# create a zero-length values, we only select columns from t3. To create
+# zero-length hash table keys, we simply join without any join condition.
+CREATE TABLE t (i INTEGER NOT NULL);
+INSERT INTO t SELECT 0;
+INSERT INTO t SELECT 0 FROM t;
+INSERT INTO t SELECT 0 FROM t;
+INSERT INTO t SELECT 0 FROM t;
+INSERT INTO t SELECT 0 FROM t;
+INSERT INTO t SELECT 0 FROM t;
+INSERT INTO t SELECT 0 FROM t;
+INSERT INTO t SELECT 0 FROM t;
+
+ANALYZE TABLE t;
+
+# Reduce the join buffer size so that we more easily can verify an effective
+# bugfix without having a very large test table.
+SET join_buffer_size = 128;
+
+# Clean the performance schema table so we start with a clean state.
+TRUNCATE performance_schema.memory_summary_global_by_event_name;
+SELECT HIGH_NUMBER_OF_BYTES_USED
+FROM performance_schema.memory_summary_global_by_event_name
+WHERE EVENT_NAME LIKE "%hash_join%";
+
+--replace_regex /cost=[0-9e\.\+]+/cost=***/  /rows=[0-9e\.\+]+/rows=***/
+EXPLAIN FORMAT=tree SELECT /*+ PQ(t3 1) */ SUM(t3.i) FROM t JOIN t t2 JOIN t t3;
+SELECT /*+ PQ(t3 1) */ SUM(t3.i) FROM t JOIN t t2 JOIN t t3;
+
+# See that the memory usage is well below one megabyte. Before the bugfix, this
+# would grow approx. 2 megabytes, so a limit of 0.5 megabyte should clearly
+# indicate an effective bugfix.
+SELECT HIGH_NUMBER_OF_BYTES_USED < 500 * 1000
+FROM performance_schema.memory_summary_global_by_event_name
+WHERE EVENT_NAME LIKE "%hash_join%";
+
+SET join_buffer_size = DEFAULT;
+SET pq_hash_join_max_hash_table_refills = DEFAULT;
+DROP TABLE t;
+--echo # BUGFIX
+--echo #
+--echo # The following test case is probably way more complex than it needs to
+--echo # be, but I haven't found any way to simplify it further. What we want to
+--echo # achieve is a parallel-aware hash join below a weedout, where the build
+--echo # input contains a parallel-oblivious hash join with a materialize iterator
+--echo # as its probe input. In ASCII art, we want something that looks like this:
+--echo #
+--echo #              weedout
+--echo #                 |
+--echo #      hash join, parallel-aware
+--echo #      |                       |
+--echo #  hash join                  t3
+--echo #  |       |
+--echo #  t1  materialize
+--echo #          |
+--echo #         t2
+--echo #
+CREATE TABLE t1 (s VARCHAR(255), INDEX idx (s));
+INSERT INTO t1 SELECT UUID();
+INSERT INTO t1 SELECT UUID() FROM t1;
+INSERT INTO t1 SELECT UUID() FROM t1;
+INSERT INTO t1 SELECT UUID() FROM t1;
+INSERT INTO t1 SELECT UUID() FROM t1;
+INSERT INTO t1 SELECT UUID() FROM t1;
+INSERT INTO t1 SELECT UUID() FROM t1;
+INSERT INTO t1 SELECT UUID() FROM t1;
+INSERT INTO t1 SELECT UUID() FROM t1;
+
+CREATE TABLE t2 (i INTEGER);
+INSERT INTO t2 SELECT RAND(1) * 1000 FROM t1 LIMIT 27;
+
+CREATE TABLE t3 (i INTEGER, INDEX idx (i));
+INSERT INTO t3 SELECT IF(RAND(1) > 0.5, NULL, RAND(1) * 1000) FROM t1 LIMIT 50;
+
+CREATE TABLE t4 (i INTEGER);
+INSERT INTO t4 SELECT 1 FROM t1 LIMIT 27;
+
+CREATE VIEW view1 AS
+  SELECT 1 FROM t1
+  UNION ALL
+  SELECT 1 FROM t1;
+
+CREATE VIEW view2 AS
+  SELECT
+  subq_1.c0 AS c1
+  FROM
+    (SELECT pi() AS c0, subq_0.c0 AS c1 FROM
+      (t2 LEFT JOIN
+        (SELECT 1 AS c0 FROM t3 ref_1 WHERE (ref_1.i IS NULL)) subq_0
+      ON (subq_0.c0 IS NOT NULL))) subq_1
+  GROUP BY subq_1.c1, subq_1.c0;
+
+CREATE VIEW view3 AS
+  SELECT
+    subq_0.c2 AS c2
+  FROM
+  (SELECT
+    i AS c2 FROM t4) subq_0
+  GROUP BY subq_0.c2
+  ORDER BY subq_0.c2;
+
+ANALYZE TABLE t1, t2, t3, t4;
+
+let $query = SELECT /*+ PQ(ref_12 4) */
+  1
+FROM
+  view1 AS ref_9
+  INNER JOIN t1 AS ref_11 ON (false)
+  RIGHT JOIN t1 AS ref_12
+  LEFT JOIN view2 AS ref_13
+  INNER JOIN t1 AS ref_14 ON (true)
+    ON (EXISTS (
+      SELECT
+        ref_15.c2 AS c0
+      FROM
+        view3 AS ref_15
+      WHERE ref_14.s IS NOT NULL))
+  ON (ref_13.c1 IS NOT NULL);
+
+# to preserve plans:
+--source include/turn_off_join_elimination.inc
+
+eval EXPLAIN FORMAT=tree $query;
+--echo # We only want to see that we do not hit any assertion,
+--echo # so disable the result log.
+--disable_result_log
+eval $query;
+--enable_result_log
+
+--source include/restore_opt_switch_after_turn_off_join_elimination.inc
+DROP VIEW view1, view2, view3;
+DROP TABLE t1, t2, t3, t4;
diff --git a/mysql-test/suite/parallel_query/t/pq_hash_join_error.test b/mysql-test/suite/parallel_query/t/pq_hash_join_error.test
