+(SELECT 1 FROM (SELECT schema() FROM t1) x(x) RIGHT JOIN t0 ON x.x = current_date()) UNION (SELECT 1);
+SELECT 1 FROM (SELECT schema() FROM t1) x(x) RIGHT JOIN t0 ON x.x = now();
+
+drop table t0;
