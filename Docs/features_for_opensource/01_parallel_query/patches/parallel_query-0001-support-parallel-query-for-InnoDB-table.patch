+bool Item_row::eq(const Item *cmp_item, bool binary_cmp) const {
+  // cmp_item may be a ref item, thus we use its real item.
+  Item *item = const_cast<Item *>(cmp_item)->real_item();
+  if (this == item) return true;
+  if (item->type() != Item::ROW_ITEM) return false;
+  const auto row_item = down_cast<const Item_row *>(item);
+  if (arg_count != row_item->arg_count) return false;
+
+  for (uint i = 0; i < arg_count; i++) {
+    if (!items[i]->eq(row_item->items[i], binary_cmp)) return false;
+  }
+  return super::eq(item, binary_cmp);
+}
+
 void Item_row::update_used_tables() {
   used_tables_cache = 0;
   m_accum_properties = 0;
