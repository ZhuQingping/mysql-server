+/**********************************************************************
+ *  check the table can be dropped with recyclebin.
+ *   @return error number */
+int handler::ha_check_support_recyclebin(
+    /*======================*/
+    const char *name,         /*!< in: table name */
+    bool &support_recyclebin, /*!< out: whether the table support recyclebin */
+    const dd::Table *dd_table) {
+  char norm_name[FN_REFLEN];
+  dict_table_t *table = NULL;
+  int err = 0;
+  THD *thd = ha_thd();
+  bool has_fts = false;
+  bool is_fil_per_table = true;
+  bool is_tablespace_discard = false;
+  const dd::Table *tab = &(dd_table->table());
+  const dd::Partition *part = reinterpret_cast<const dd::Partition *>(dd_table);
+
+  DBUG_ENTER("handler::ha_check_support_recyclebin");
+
+  dd::cache::Dictionary_client *client = dd::get_dd_client(thd);
+  dd::cache::Dictionary_client::Auto_releaser releaser(client);
+
+  if (dd_table_is_partitioned(*dd_table)) {
+    dd::Partition *dd_part = dd_table->leaf_partitions().front();
+    tab = &(dd_part->table());
+    part = reinterpret_cast<const dd::Partition *>(dd_part);
+    std::string partition;
+    /* Build the partition name. */
+    dict_name::build_partition(dd_part, partition);
+    std::string part_table;
+    /* Build the partitioned table name. */
+    dict_name::build_table("", name, partition, false, false, part_table);
+
+    if (part_table.length() >= FN_REFLEN ||
+        DBUG_EVALUATE_IF("recyclebin_partition_1", 1, 0)) {
+      return HA_ERR_INTERNAL_ERROR;
+    }
+
+    normalize_table_name(norm_name, part_table.c_str());
+  } else {
+    normalize_table_name(norm_name, name);
+  }
+
+  err = dd_table_open_on_dd_obj(
+      thd, client, *tab,
+      (!dd_table_is_partitioned(*tab)
+           ? nullptr
+           : reinterpret_cast<const dd::Partition *>(part)),
+      norm_name, table, nullptr);
+
+  if (err == 0 && !table) {
+    err = HA_ERR_NO_SUCH_TABLE;
+    support_recyclebin = false;
+    if (table) {
+      dd_table_close(table, thd, nullptr, false);
+    }
+    DBUG_RETURN(err);
+  } else if (err) {
+    support_recyclebin = false;
+    if (table) {
+      dd_table_close(table, thd, nullptr, false);
+    }
+    DBUG_RETURN(err);
+  }
+
+  has_fts = dd_table_contains_fulltext(*dd_table);
+  is_fil_per_table = dict_table_is_file_per_table(table);
+  is_tablespace_discard = dict_table_is_discarded(table);
+
+  dd_table_close(table, thd, nullptr, false);
+
+  support_recyclebin = !has_fts && is_fil_per_table && !is_tablespace_discard;
+
+  DBUG_RETURN(err);
+}
