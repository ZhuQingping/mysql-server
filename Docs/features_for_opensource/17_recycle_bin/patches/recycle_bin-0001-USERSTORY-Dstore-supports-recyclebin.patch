+--source include/have_only_dstore.inc
+#
+# Test for recycle func of case_sensitive instance
+#
+
+let $MYSQLD_BASE_DIR = `select @@basedir`;
+
+--echo # Stop the MTR default mysqld.
+--source include/shutdown_mysqld.inc
+
+--echo #
+--echo # Initialize a temporary database that uses lower_case_table_names=1.
+--echo #
+--write_file $MYSQL_TMP_DIR/boot.sql
+CREATE DATABASE test;
+EOF
+
+let $MYSQL_DATA_DIR = $MYSQL_TMP_DIR/data;
+--mkdir $MYSQL_DATA_DIR
+
+let NEW_CMD = $MYSQLD --no-defaults --initialize-insecure --lc_messages_dir=$MYSQL_SHAREDIR --basedir=$MYSQLD_BASE_DIR --datadir=$MYSQL_DATA_DIR --init-file=$MYSQL_TMP_DIR/boot.sql --dstore_tenant_config=$MYSQL_DSTORE_TENANT_CONFIG_FILE --console --lower_case_table_names=1 </dev/null>>$MYSQL_TMP_DIR/bootstrap.log 2>&1;
+--exec $NEW_CMD
+
+--echo #
+--echo # Start the DB server with the lower_case_table_names=1
+--echo #
+
+--replace_result $MYSQL_DATA_DIR MYSQL_DATA_DIR
+--let $restart_parameters="restart: --datadir=$MYSQL_DATA_DIR --lower_case_table_names=1"
+--source include/start_mysqld.inc
+
+--echo # New lower_case_table_names=1
+select @@lower_case_table_names;
+
+connect (root, 127.0.0.1, root,,);
+
+# connect root
+connection root;
+set rds_recycle_bin_mode=on;
+
+create database DB1;
+show databases;
+use DB1;
+create table TABLE_T1(id int);
+
+drop table TABLE_T1;
+--replace_column 2 # 5 # 6 #
+call dbms_recyclebin.show_tables();
+let $table_t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);
+
+SET SESSION debug="+d,recyclebin_restore_alloc_fail_03";
+--replace_result $table_t1_name_in_recyclebin table_t1
+--error ER_PREPARE_RECYCLE_TABLE_ERROR
+eval call dbms_recyclebin.restore_table('$table_t1_name_in_recyclebin', "DB1", "TABLE_T1");
+SET SESSION debug="-d,recyclebin_restore_alloc_fail_03";
+
+SET SESSION debug="+d,recyclebin_restore_alloc_fail_04";
+--replace_result $table_t1_name_in_recyclebin table_t1
+--error ER_PREPARE_RECYCLE_TABLE_ERROR
+eval call dbms_recyclebin.restore_table('$table_t1_name_in_recyclebin', "DB1", "TABLE_T1");
+SET SESSION debug="-d,recyclebin_restore_alloc_fail_04";
+
+--replace_result $table_t1_name_in_recyclebin table_t1
+eval call dbms_recyclebin.restore_table('$table_t1_name_in_recyclebin', "DB1", "TABLE_T1");
+show tables;
+
+drop table table_t1;
+let $table_t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);
+--replace_result $table_t1_name_in_recyclebin table_t1
+eval call dbms_recyclebin.restore_table('$table_t1_name_in_recyclebin');
+show tables;
+
+drop table table_t1;
+let $table_t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);
+--replace_result $table_t1_name_in_recyclebin table_t1
+eval call dbms_recyclebin.restore_table('$table_t1_name_in_recyclebin', "db1", "table_t1");
+show tables;
+
+drop table table_t1;
+let $table_t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);
+--replace_result $table_t1_name_in_recyclebin table_t1
+eval call dbms_recyclebin.restore_table('$table_t1_name_in_recyclebin', "db1", "TABLE_T1");
+show tables;
+
+drop table table_t1;
+let $table_t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);
+--replace_result $table_t1_name_in_recyclebin table_t1
+eval call dbms_recyclebin.restore_table('$table_t1_name_in_recyclebin', "DB1", "table_t1");
+show tables;
+
+drop table TABLE_T1;
+call dbms_recyclebin.restore_db("db1");
+drop table TABLE_T1;
+call dbms_recyclebin.restore_db("DB1");
+drop table TABLE_T1;
+call dbms_recyclebin.restore_db("db1", "db1");
+drop table TABLE_T1;
+call dbms_recyclebin.restore_db("db1", "DB1");
+drop table TABLE_T1;
+call dbms_recyclebin.restore_db("DB1", "db1");
+show tables;
+drop database DB1;
+let $table_t1_name_in_recyclebin = query_get_value(call dbms_recyclebin.show_tables(), TABLE, 1);
+--replace_result $table_t1_name_in_recyclebin table_t1
+eval call dbms_recyclebin.purge_table('$table_t1_name_in_recyclebin');
+
+drop database __recyclebin__;
+create database __recyclebin__ default character set utf8mb4;
+
+--echo #
+--echo # Cleanup
+--echo #
+--let $restart_parameters= restart:
+--source include/restart_mysqld.inc
+
+SELECT @@lower_case_table_names;
+
+--force-rmdir $MYSQL_DATA_DIR
+--remove_file $MYSQL_TMP_DIR/boot.sql
