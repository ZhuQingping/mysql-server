+
+call dbms_recyclebin.restore_db('DB_RECYCLE');
+show tables;
+--replace_column 2 # 5 # 6 #
+call dbms_recyclebin.show_tables();
+
+drop table T0;
+--replace_column 2 # 5 # 6 #
+call dbms_recyclebin.show_tables();
+
+call dbms_recyclebin.restore_db('db_recycle');
+show tables;
+--replace_column 2 # 5 # 6 #
+call dbms_recyclebin.show_tables();
+
+use db_recycle;
+drop table t0;
+call dbms_recyclebin.restore_db('DB_RECYCLE', 'db_recycle');
+call dbms_recyclebin.restore_db('db_recycle', 'DB_RECYCLE');
+show tables;
+use DB_RECYCLE;
+show tables;
+
+connection default;
+set global rds_recycle_bin_mode=OFF;
+drop database db_recycle;
+drop database DB_RECYCLE;
+drop database __recyclebin__;
+CREATE DATABASE IF NOT EXISTS __recyclebin__ DEFAULT CHARACTER SET utf8mb4;
+
+--echo #
+--echo # Cleanup
+--echo #
+--let $restart_parameters= restart:
+--source include/restart_mysqld.inc
+
+SELECT @@lower_case_table_names;
+
+--force-rmdir $MYSQL_DATA_DIR
+--remove_file $MYSQL_TMP_DIR/boot.sql
