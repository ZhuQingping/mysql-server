+SET SESSION debug="+d,recyclebin_copy_with_cs_fail_02";
+--replace_result $t1_name_in_recyclebin t1
+--error ER_NATIVE_PROC_PARAMETER_MISMATCH
+eval call dbms_recyclebin.restore_table('$t1_name_in_recyclebin');
+SET SESSION debug="-d,recyclebin_copy_with_cs_fail_02";
+SET SESSION debug="+d,recyclebin_copy_with_cs_fail_03";
+--replace_result $t1_name_in_recyclebin t1
+--error ER_NATIVE_PROC_PARAMETER_MISMATCH
+eval call dbms_recyclebin.restore_table('$t1_name_in_recyclebin', 'db_recycle', 't1');
+SET SESSION debug="-d,recyclebin_copy_with_cs_fail_03";
+SET SESSION debug="+d,recyclebin_copy_with_cs_fail_04";
+--replace_result $t1_name_in_recyclebin t1
+--error ER_NATIVE_PROC_PARAMETER_MISMATCH
+eval call dbms_recyclebin.restore_table('$t1_name_in_recyclebin', 'db_recycle', 't1');
+SET SESSION debug="-d,recyclebin_copy_with_cs_fail_04";
+
+SET SESSION debug="+d,recyclebin_restore_db_fail_after_commit";
+--replace_result $t1_name_in_recyclebin t1
+--error ER_UNKNOWN_ERROR
+eval call dbms_recyclebin.restore_db('db_recycle', 'db_recycle');
+--error ER_NATIVE_PROC_PARAMETER_MISMATCH
+eval call dbms_recyclebin.restore_db('db_recycle', '');
+SET SESSION debug="-d,recyclebin_restore_db_fail_after_commit";
+
+show tables;
+
+set global rds_recycle_bin_mode=OFF;
+set rds_recycle_bin_mode=OFF;
+drop database db_recycle;
