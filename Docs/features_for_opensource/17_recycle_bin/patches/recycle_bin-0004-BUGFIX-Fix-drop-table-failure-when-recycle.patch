 .../suite/recyclebin/r/recycle_table.result   | 63 +++++++++++++++++++
 .../recyclebin/t/recycle_table-dstore.test    | 48 ++++++++++++++
 .../suite/recyclebin/t/recycle_table.test     | 48 ++++++++++++++
 sql/sql_rename.cc                             |  3 +
 sql/sql_table.cc                              |  2 +-
 6 files changed, 226 insertions(+), 1 deletion(-)

