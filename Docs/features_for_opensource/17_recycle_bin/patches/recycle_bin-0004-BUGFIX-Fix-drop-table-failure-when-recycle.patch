 create database __recyclebin__ default character set utf8mb4;
+------------------------------------------------------
+BUGFIX The table drop fails when the table name is too long and contains foreign keys.
+------------------------------------------------------
+use test;
+create table create_create_create_create_create_create_ddl_test_5 (
+id INT PRIMARY KEY,
+info VARCHAR(20)
+) ENGINE=Dstore;
+create table create_create_create_create_create_ddl_test_10 (
+c_id INT PRIMARY KEY,
+p_id INT,
+FOREIGN KEY (p_id) REFERENCES create_create_create_create_create_create_ddl_test_5(id)
+) ENGINE=Dstore;
+drop table create_create_create_create_create_ddl_test_10;
+call dbms_recyclebin.show_tables();
+SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
+__recyclebin__	#	test	create_create_create_create_create_ddl_test_10	#	#
+create table create_create_create_create_create_ddl_test_10 (
+c_id INT PRIMARY KEY,
+p_id INT,
+CONSTRAINT `create_create_create_create_create_ddl_test_100000_fk_1` FOREIGN KEY (`c_id`) REFERENCES `create_create_create_create_create_create_ddl_test_5` (`id`) ON DELETE CASCADE
+) ENGINE=Dstore;
+drop table create_create_create_create_create_ddl_test_10;
+call dbms_recyclebin.show_tables();
+SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
+__recyclebin__	#	test	create_create_create_create_create_ddl_test_10	#	#
+__recyclebin__	#	test	create_create_create_create_create_ddl_test_10	#	#
+SET SESSION debug="+d,recyclebin_after_rename_before_drop_fk_fail";
+create table create_create_create_create_create_ddl_test_10 (
+c_id INT PRIMARY KEY,
+p_id INT,
+FOREIGN KEY (p_id) REFERENCES create_create_create_create_create_create_ddl_test_5(id)
+) ENGINE=Dstore;
+show create table create_create_create_create_create_ddl_test_10;
+Table	Create Table
+create_create_create_create_create_ddl_test_10	CREATE TABLE `create_create_create_create_create_ddl_test_10` (
+  `c_id` int NOT NULL,
+  `p_id` int DEFAULT NULL,
+  PRIMARY KEY (`c_id`),
+  KEY `p_id` (`p_id`),
+  CONSTRAINT `create_create_create_create_create_ddl_test_10_fk_1` FOREIGN KEY (`p_id`) REFERENCES `create_create_create_create_create_create_ddl_test_5` (`id`)
+) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
+drop table create_create_create_create_create_ddl_test_10;
+ERROR HY000: Failed to recycle table to the recycle bin.
+show create table create_create_create_create_create_ddl_test_10;
+Table	Create Table
+create_create_create_create_create_ddl_test_10	CREATE TABLE `create_create_create_create_create_ddl_test_10` (
+  `c_id` int NOT NULL,
+  `p_id` int DEFAULT NULL,
+  PRIMARY KEY (`c_id`),
+  KEY `p_id` (`p_id`),
+  CONSTRAINT `create_create_create_create_create_ddl_test_10_fk_1` FOREIGN KEY (`p_id`) REFERENCES `create_create_create_create_create_create_ddl_test_5` (`id`)
+) ENGINE=Dstore DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
+SET SESSION debug="-d,recyclebin_after_rename_before_drop_fk_fail";
+drop table create_create_create_create_create_ddl_test_10;
+call dbms_recyclebin.show_tables();
+SCHEMA	TABLE	ORIGIN_SCHEMA	ORIGIN_TABLE	RECYCLED_TIME	PURGE_TIME
+__recyclebin__	#	test	create_create_create_create_create_ddl_test_10	#	#
+__recyclebin__	#	test	create_create_create_create_create_ddl_test_10	#	#
+__recyclebin__	#	test	create_create_create_create_create_ddl_test_10	#	#
+drop table create_create_create_create_create_create_ddl_test_5;
+drop database __recyclebin__;
+create database __recyclebin__ default character set utf8mb4;
 set rds_recycle_bin_mode=OFF;
 set global rds_recycle_bin_mode=OFF;
 drop database db_recycle;
