+bool Abstract_table_impl::recycle_bin_drop_column(const String_type &name) {
+  for (Column *c : m_columns) {
+    if (my_strcasecmp(system_charset_info, name.c_str(), c->name().c_str()) ==
+        0) {
+      m_columns.recycle_bin_remove(down_cast<Column_impl *>(c));
+      return true;
+    }
+  }
+
+  return false;
