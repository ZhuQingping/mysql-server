--- a/sql/opt_explain.cc
+++ b/sql/opt_explain.cc
@@ -2038,8 +2038,11 @@ bool explain_single_table_modification(THD *explain_thd, const THD *query_thd,
   if (!other && !select->is_empty_query()) {
     for (Query_expression *unit = select->first_inner_query_expression(); unit;
          unit = unit->next_query_expression()) {
-      // Derived tables and const subqueries are already optimized
-      if (!unit->is_optimized() &&
+      /* Derived tables and const subqueries are already optimized. Unless this
+         is a derived table which has been eliminated by join elimination, in
+         which case we needn't optimize its body. Apart from this exception, we
+         are going to optimize all remaining subqueries here. */
+      if (!unit->is_optimized() && unit->derived_table == nullptr &&
