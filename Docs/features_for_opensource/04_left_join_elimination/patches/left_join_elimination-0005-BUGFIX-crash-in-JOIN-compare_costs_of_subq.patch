   }
-  // As all tables get fresh maps, there is no risk of conflict between old
-  // and new maps so we can forget about old maps:
+  /* As all tables get fresh maps, there is no risk of conflict between old
+     and new maps so we can forget about old maps. Moreover, we have not yet
+     done join elimination (which happens at the end of the resolution of the
+     top Query_block, so, after all derived-table merging which is the caller
+     here), so there are no gaps in table maps yet, neither in the merged
+     query block nor in this parent one; the renumbering by using consecutive
+     values as is done here, is thus correct. */
   m_hwm_free_tableno = leaf_table_count;
+  assert(m_eliminated_tables == 0);
 }
 
