+id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
+1	PRIMARY	t2	NULL	ALL	NULL	NULL	NULL	NULL	3	100.00	Using temporary
+2	DEPENDENT SUBQUERY	t1	NULL	ALL	NULL	NULL	NULL	NULL	1	100.00	NULL
+Warnings:
+Note	1276	Field or reference 'test.ref_49.medal_now' of SELECT #2 was resolved in SELECT #1
+Note	1003	/* select#1 */ select distinct ((case when exists(/* select#2 */ select `test`.`ref_49`.`medal_now` from `test`.`t1`) then 1 else 0 end) is null) AS `(CASE WHEN EXISTS (SELECT ref_49.medal_now FROM t1) THEN 1 ELSE 0 END) IS NULL` from `test`.`t2`
+SELECT DISTINCT
+(CASE WHEN EXISTS (SELECT ref_49.medal_now FROM t1) THEN 1 ELSE 0 END) IS NULL
+FROM t2 LEFT JOIN t3 AS ref_49 ON TRUE;
+(CASE WHEN EXISTS (SELECT ref_49.medal_now FROM t1) THEN 1 ELSE 0 END) IS NULL
+0
