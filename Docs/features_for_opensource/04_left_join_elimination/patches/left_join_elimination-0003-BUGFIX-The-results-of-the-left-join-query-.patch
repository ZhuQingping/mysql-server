diff --git a/sql/item.cc b/sql/item.cc
index 5223adf44fa..0fe993e8efa 100644
--- a/sql/item.cc
+++ b/sql/item.cc
@@ -8941,6 +8941,10 @@ bool Item_default_value::fix_fields(THD *thd, Item **) {
   // Always allow a "read" from the default value.
   field->table->mark_column_used(field, MARK_COLUMNS_READ);
 
+  if (table_ref != nullptr && table_ref->query_block != nullptr &&
+      field->table->is_nullable())
+    table_ref->query_block->add_base_options(OPTION_DEFAULT_WEAK_COLUMN);
+
   return false;
 }
 
