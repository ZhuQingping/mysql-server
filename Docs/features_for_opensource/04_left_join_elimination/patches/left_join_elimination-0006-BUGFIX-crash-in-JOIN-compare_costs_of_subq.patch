index aba30539612..5ffb10f0d19 100644
--- a/mysql-test/r/join_elimination.result
+++ b/mysql-test/r/join_elimination.result
@@ -1815,6 +1815,31 @@ GROUP BY t.a, computed_col
 ) AS derived;
 COUNT(1)
 1
