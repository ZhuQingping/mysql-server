From 7b5ee97196637922a4f565ab5f28c15c25f26ea3 Mon Sep 17 00:00:00 2001
From: Guilhem Bichot <guilhem.bichot@contributor>


Date: Wed, 18 Mar 2026 17:55:54 +0100
Subject: [PATCH] BUGFIX crash in
 JOIN::compare_costs_of_subquery_strategies

While working on this bug, I discovered another problem, also related
to aggregates vs left join elimination.

Item_subselect::compile() does not dive into its underlying subquery.
So, we cannot reliably find, in a subquery Item, what the aggregates
really depend on.

Fix: skip elimination in this case. Note that this is not about the
plain and common:
select aggregate(...) from t1 left join t2 ...
neither about
select (select aggregate-in-subq(...) ...) from t1 left join t2 ...
but rather about the less common:
select (select aggregate-in-top-q(...) ...) from t1 left join t2 ...
where 'aggregate' has the left-join query as aggregation query.
---
 mysql-test/include/join_elimination.inc       |  7 ++++++
 mysql-test/r/join_elimination.result          | 25 +++++++++++++++++++
 .../r/join_elimination-dstore.result          | 25 +++++++++++++++++++
 sql/sql_join_elimination.cc                   | 16 +++++++++++-
 4 files changed, 72 insertions(+), 1 deletion(-)

diff --git a/mysql-test/include/join_elimination.inc b/mysql-test/include/join_elimination.inc
index c352acb32ab..b0c96c5fba4 100644
--- a/mysql-test/include/join_elimination.inc
+++ b/mysql-test/include/join_elimination.inc
@@ -703,6 +703,13 @@ SELECT COUNT(1) FROM
 eval EXPLAIN $query;
 eval $query;
 
+--echo # Fix for a bug: it's not possible to get reliable used_tables information of an aggregate which is inside a subquery of our query block. We block this situation in code, otherwise we would not notice that t2 is used in count() and eliminate it, which would be wrong.
+explain select distinct (select count(t2.a+0) from t1 t0) from t1 left join t1 t2 on t1.a=t2.a;
+--echo # It's also not possible to set reliable used_tables information after eliminating; so we cannot eliminate t1 here; count() would still pretend it depends on t2.
+explain select distinct (select count(t1.a+0) from t1 t0) from t1 left join t1 t2 on t1.a=t2.a;
+--echo # Here the aggregate in the subquery, is not an aggregate from the POV of the query block where the left join is, so there is no problem.
+explain select distinct (select count(t0.a+0) from t1 t0) from t1 left join t1 t2 on t1.a=t2.a;
+
 --echo # Without GROUP BY, and with composite unique key:
 
 CREATE TABLE u (a INT, b INT, c INT NOT NULL, UNIQUE (a,b));
