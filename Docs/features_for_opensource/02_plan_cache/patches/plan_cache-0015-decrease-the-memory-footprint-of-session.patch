-void invalidate_cached_plan(THD *thd, SELECT_LEX *select) {
+/// Throws away an already cached plan.
+void invalidate_cached_plan(SELECT_LEX *select) {
   JOIN *plan = select->cached_plan;
   if (!plan) return;
 
@@ -1530,17 +1535,46 @@ void invalidate_cached_plan(THD *thd, SELECT_LEX *select) {
   // failures.
 
