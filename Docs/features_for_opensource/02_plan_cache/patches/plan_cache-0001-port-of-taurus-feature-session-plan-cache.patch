+SELECT @@global.rds_plan_cache_allow_change_ratio;
+SET @@global.rds_plan_cache_allow_change_ratio = 100;
+SELECT @@global.rds_plan_cache_allow_change_ratio;
+SET @@global.rds_plan_cache_allow_change_ratio = -1;
+SELECT @@global.rds_plan_cache_allow_change_ratio;
