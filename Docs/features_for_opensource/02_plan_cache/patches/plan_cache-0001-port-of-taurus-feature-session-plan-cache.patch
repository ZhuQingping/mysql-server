+// PLAN_CACHE_PORT Note that in Taurus this function has additional code for
+// Partial Table Result Cache (PTRC) and for NDP, which are not present in the
+// mysql+dstore branch.
+bool TABLE::pq_copy(THD *thd, void *select_arg [[maybe_unused]], TABLE *orig) {
+#ifdef PLAN_CACHE_TAURUS
+  SELECT_LEX *select = static_cast<SELECT_LEX *>(select_arg);
+#endif  // PLAN_CACHE_PORT unused
+  possible_quick_keys = orig->possible_quick_keys;
+  covering_keys = orig->covering_keys;
+  key_read = orig->key_read;
+  null_row = orig->null_row;
+  if (orig->is_nullable()) {
+    set_nullable();
+  }
+
+  if (part_info) {
+    part_info->pq_copy_from(orig->part_info);
+  }
+
+  file->pushed_idx_cond_keyno = orig->file->pushed_idx_cond_keyno;
+  file->pushed_idx_cond = nullptr;
+  // needs deep copy
+  // PLAN_CACHE_PORT: using new function clone_if_transient() instead of
+  // pq_clone()
+  if (orig->file->pushed_idx_cond &&
+      !(file->pushed_idx_cond =
+            clone_if_transient(thd, orig->file->pushed_idx_cond)))
+    return true;
+
+  /*
+    Partial result cache is decided in ptrc::CreateAccessPath(), in a
+    cost-based way. So this is called for the single-threaded initial plan,
+    and for the leader's and workers' plans. So the copies used by these
+    threads must have good enough statistics:
+  */
+  file->stats.records = orig->file->stats.records;
+  return false;
+}
