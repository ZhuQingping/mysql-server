+/**
+   Set QEP_TAB's table_ref. If we can find TABLE_LIST in resolved leaf tables
+   through table_no, then we directly set the found one as QEP_TAB's table_ref
+   because the table_no is unique. Otherwise, we clone one TABLE_LIST and assign
+   it as table_ref.
+
+   @param thd Thread handler.
+   @param cloned_join The cloned JOIN object.
+   @param tab The QEP_TAB to be filled with table_ref.
+   @param orig_tbl The filled table_ref in original plan
+
+   @returns true if clone error, and otherwise false.
+*/
+static bool pq_set_table_ref(THD *thd [[maybe_unused]], JOIN *cloned_join,
+                             QEP_TAB *tab, TABLE_LIST *orig_tbl) {
+  TABLE_LIST *tbl = nullptr;
+#ifdef PLAN_CACHE_TAURUS
+  SELECT_LEX *select = cloned_join->select_lex;  // PLAN_CACHE_PORT unused
+#endif
+  for (TABLE_LIST *tr = cloned_join->tables_list; tr; tr = tr->next_leaf) {
+    if (tr->tableno() == orig_tbl->tableno()) {
+      tbl = tr;
+      break;
+    }
+  }
+
+  // PLAN_CACHE_PORT in plan cache this should not be needed: plan cache is
+  // disabled if there is more than one table.
+#ifdef PLAN_CACHE_TAURUS
+  if (!tbl) {
+    // This case can occur for a TABLE_LIST created for a
+    // semijoin-materialized temporary table. Indeed, in pq_dup_select() we
+    // create clones of the TABLE_LISTs in leaf_tables list. But if semijoin
+    // materialization is used, an additional TABLE_LIST exists out of this
+    // list, created by the optimization process. Thus every worker needs to
+    // clone it when it clones the relevant QEP_TAB, which is done here.
+    tbl = new (thd->pq_mem_root) TABLE_LIST();
+    if (!tbl) return true;
+    tbl->pq_copy(thd, orig_tbl);
+    tbl->select_lex = select;
+    tbl->table = tab->table();
+    tbl->table->pos_in_table_list = tbl;
+    tab->table_ref = tbl;
+    tbl->next_name_resolution_table =
+        select->context.first_name_resolution_table;
+    select->context.first_name_resolution_table = tbl;
+  }
+#endif
+
+  assert(tbl);
+  tab->table_ref = tbl;
+  return false;
+}
