+INSERT INTO cols(i1) SELECT b2 FROM source;
+
+set rds_plan_cache = 1;
+prepare stmt_sh1 from 'SELECT 1 FROM cols HAVING SUM(s1)=1';
+execute stmt_sh1;
+execute stmt_sh1;
+deallocate prepare stmt_sh1;
