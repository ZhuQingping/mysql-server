+// PLAN_CACHE_PORT Note that in Taurus this function is much more complex due
+// to : USERSTORY Support for partition-level MDL locks and concurrency
+// control. If one day this feature is ported to the mysql+dstore branch, a
+// code conflict will occur and suggest the necessary update.
+bool partition_info::pq_copy_from(partition_info *part_info) {
+  bitmap_copy(&read_partitions, &part_info->read_partitions);
+  bitmap_copy(&lock_partitions, &part_info->lock_partitions);
+  return false;
+}
