+class Clone_plan_RAII {
+ public:
+  explicit Clone_plan_RAII(THD *thd)
+      : m_thd(thd),
+        save_want_privilege(m_thd->want_privilege),
+        save_allow_sum_func(m_thd->lex->allow_sum_func)
+#ifdef PLAN_CACHE_TAURUS
+        ,
+        save_pq_mem_root(m_thd->pq_mem_root)
+#endif
+  {
+#ifdef PLAN_CACHE_TAURUS
+    m_thd->pq_mem_root = m_thd->mem_root;
+#endif
+    m_thd->want_privilege = SELECT_ACL;
+#ifdef PLAN_CACHE_TAURUS
+    m_thd->lex->select_lex->pq_try_clone_item = true;
+#endif
+    m_thd->lex->allow_sum_func |= ((nesting_map)1)
+                                  << m_thd->lex->select_lex->nest_level;
+  }
+  ~Clone_plan_RAII() {
+    m_thd->want_privilege = save_want_privilege;
+#ifdef PLAN_CACHE_TAURUS
+    m_thd->lex->select_lex->pq_try_clone_item = false;
+#endif
+    m_thd->lex->allow_sum_func = save_allow_sum_func;
+#ifdef PLAN_CACHE_TAURUS
+    m_thd->pq_mem_root = save_pq_mem_root;
+#endif
+  }
+
+ private:
+  THD *m_thd;
+  ulonglong save_want_privilege;
+  nesting_map save_allow_sum_func;
+#ifdef PLAN_CACHE_TAURUS
+  MEM_ROOT *save_pq_mem_root;  // PLAN_CACHE_PORT unused (no pq_mem_root in THD)
+#endif
