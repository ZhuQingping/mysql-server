+// PLAN_CACHE_PORT Here some functions copied from PQ and adapted to the fact
+// that we do not use Item::pq_clone().
+
+// PLAN_CACHE_PORT this is what replaces Item's pq_clone() functions.
+static Item *clone_if_transient(THD *thd, Item *i);
+
+// Again to reduce noisy changes:
+#define pq_mem_root mem_root   // no PQ mem_root
+#define item_ptr item_initial  // has been renamed in .41
+
+// Note that for each cloned class (ORDER, Temp_table_param, JOIN, etc), the
+// PQ cloning code below (taken from the Taurus branch) should be further
+// adapted to also copy any new members added to these classes between .22 and
+// .41. This effort is left to when the PQ clone code will be ported.
+
+/*
+ * clone order structure
+ */
+static ORDER *pq_dup_order(THD *thd, SELECT_LEX *select [[maybe_unused]],
+                           ORDER *orig) {
+  ORDER *order = new (thd->pq_mem_root) ORDER();
+  if (!order) return nullptr;
+  order->next = nullptr;
+
+  // PLAN_CACHE_PORT By adding a small restriction (see
+  // hidden_items_from_optimization in this file), we ensure that orig->item
+  // points into the Query_block's ref_item_array, and that such array contains
+  // only permanent items. This makes it much simpler to clone an Item used by
+  // an ORDER object: we do not need to clone it: it's a permanent Item, at a
+  // permanent place in the array.
+
+  order->item_ptr = orig->item_ptr;
+  order->item = orig->item;
+
+#ifndef NDEBUG
+  // check they're permanent indeed
+  auto &transient_items =
+      thd->lex->current_query_block()
+          ->cached_plan->plan_cache_exec_context->transient_items;
+  assert(transient_items.count(order->item_ptr) == 0);
+  assert(transient_items.count(*order->item) == 0);
+#endif
+
+  order->direction = orig->direction;
+  order->in_field_list = orig->in_field_list;
+  order->used_alias = orig->used_alias;
+  order->field_in_tmp_table = nullptr;
+  order->buff = nullptr;
+  order->used = 0;
+  order->depend_map = 0;
+  // PLAN_CACHE_PORT this member does not exist in .41 anymore
+#ifdef PLAN_CACHE_TAURUS
+  order->is_position = orig->is_position;
+#endif
+  order->is_explicit = orig->is_explicit;
+
+  return order;
+}
