 sql/sql_plan_cache.cc                         |  64 +++++++++--
 sql/sql_plan_cache.h                          |   7 +-
 5 files changed, 318 insertions(+), 11 deletions(-)

diff --git a/mysql-test/include/session_plan_cache.inc b/mysql-test/include/session_plan_cache.inc
index f8e674dbf99..3abe7d4875a 100644
--- a/mysql-test/include/session_plan_cache.inc
+++ b/mysql-test/include/session_plan_cache.inc
@@ -5,6 +5,11 @@
 # We will test "flush global status"; if mysqld has already executed some other mtr tests and they used plan cache, this status will contain effects from those other tests,
 --source include/restart_mysqld.inc
 
+# This helps with two things:
+# - there is OPTIMIZE TABLE in this test; if the auto-update runs at the same time we can get a deadlock error (as in BUGFIX)
+# - the plan in explain_distinct_ranges is unstable, probably due to the auto-update.
+set global dstore_use_histogram_auto_update=off;
+
 # PLAN_CACHE_PORT dstore does not support index merge, partitioning, so we have an include file which is run twice, once for innodb, once for dstore.
 
 connect (con_analyze,localhost,root,,test,,); # Will be used to test ANALYZE TABLE
@@ -617,6 +622,7 @@ set optimizer_switch='mrr=off';
 execute stmt using @a;
 --replace_regex /  \"cost\".*// /  \"cost_for_plan\".*//
 select * from information_schema.optimizer_trace;
+set optimizer_switch=default;
 
