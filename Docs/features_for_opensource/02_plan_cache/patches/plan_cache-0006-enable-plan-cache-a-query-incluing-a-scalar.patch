From b6ae57df07bd0d74b4b309dfe9e81e54930e77ec Mon Sep 17 00:00:00 2001
From: Guilhem Bichot <guilhem.bichot@contributor>

Date: Thu, 7 Aug 2025 14:34:59 +0200
Subject: [PATCH] enable plan_cache, a query incluing a scalar
 subquery in select filed, and in the where clause contains a condition
 judgment as length(BLOB)<?, the query will return a wrong result set after
 using cached plan for several times.

This is to fix the "other scenario" in the bug report, which
experienced a wrong order.

The 'reverse' oroperty of the index scanning got lost: it was not
recorded while caching the plan. Now we record it and restore it when
applying the plan.

While at it, we add yet another check that test_quick_select()
selected the same access path as it did originally: on top of
comparing the type of range access and also the chosen index, we also
compare the number of columns which will be read from the index.
---
 mysql-test/include/session_plan_cache.inc     | 32 +++++++++++++++
 mysql-test/r/session_plan_cache.result        | 39 +++++++++++++++++++
 .../dstore_main/r/session_plan_cache.result   | 39 +++++++++++++++++++
 sql/sql_plan_cache.cc                         | 13 +++++++
 sql/sql_plan_cache.h                          |  2 +
 5 files changed, 125 insertions(+)

diff --git a/mysql-test/include/session_plan_cache.inc b/mysql-test/include/session_plan_cache.inc
index d6bb0216022..abddaa44004 100644
--- a/mysql-test/include/session_plan_cache.inc
+++ b/mysql-test/include/session_plan_cache.inc
@@ -1712,4 +1712,36 @@ SHOW STATUS LIKE '%Cached_plan%';
 DROP PREPARE stmt1;
 DROP TABLE t_general_test;
 
+--echo # Second problem in BUGFIX ('reverse' property of index access was lost)
+
+CREATE TABLE tbl_1_all_type2index_desc (
+  id_col INT NOT NULL AUTO_INCREMENT,
+  bool_col TINYINT(1) DEFAULT NULL,
+  bigint_col BIGINT NOT NULL,
+  varchar_col VARCHAR(255)  DEFAULT NULL,
+  UNIQUE KEY (id_col DESC),
+  KEY ndx_bigint_varchar_col (bigint_col DESC, varchar_col(4) DESC)
+) AUTO_INCREMENT=114 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
+
+INSERT INTO tbl_1_all_type2index_desc VALUES 
+  (66 ,0, 9223372036854775807,'bbba2'),
+  (103,0, 13                 ,NULL   );
+
+PREPARE stmt FROM "WITH A AS (SELECT bool_col, bigint_col 
+	     	  	      FROM tbl_1_all_type2index_desc AS A 
+			      WHERE A.bool_col = ? and A.bigint_col > ?
+			      ORDER BY 1,2) 
+                   SELECT * FROM A";
+
+set @col1='1';
+set @col2=300;
+EXECUTE stmt USING @col1,@col2;
+set @col1='0';set @col2=-1000;
+EXECUTE stmt USING @col1,@col2;
+EXECUTE stmt USING @col1,@col2;
+SHOW STATUS LIKE '%Cached_plan%';
+
+DROP PREPARE stmt;
+DROP TABLE tbl_1_all_type2index_desc;
+
 set rds_plan_cache = @old_plan_cache;
