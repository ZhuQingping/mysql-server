diff --git a/sql/sql_plan_cache.cc b/sql/sql_plan_cache.cc
index b009cc51e1c..0b6f7e3295f 100644
--- a/sql/sql_plan_cache.cc
+++ b/sql/sql_plan_cache.cc
@@ -1886,6 +1886,10 @@ bool Exec_context::fill(THD *thd, JOIN *join, QEP_TAB *cached_qep_tab) {
     quick_keys_map.merge(get_quick_key_map(quick));
     cached_qep_tab->table_ref->opt_hints_table->index_merge.get_key_map()
         ->merge(quick_keys_map);
+    if (quick->type == AccessPath::INDEX_RANGE_SCAN) {
+      index_range_scan_is_reverse = quick->index_range_scan().reverse;
+    }
+    quick_used_key_parts = get_used_key_parts(quick);
 #ifdef PLAN_CACHE_TAURUS
     // PLAN_CACHE_PORT this "quick" has never been created, no need to delete
     delete quick;  // it's not needed anymore.
@@ -2290,6 +2294,15 @@ static int reinit_qep_tab_properties(QEP_TAB *qt) {
       if (qck && qck->type == join->plan_cache_exec_context->quick_type) {
         Key_map new_key_map [[maybe_unused]] = get_quick_key_map(qck);
         assert(new_key_map == join->plan_cache_exec_context->quick_keys_map);
+        if (qck->type == AccessPath::INDEX_RANGE_SCAN) {
+          if (join->plan_cache_exec_context->index_range_scan_is_reverse) {
+            bool ret = make_reverse(get_used_key_parts(qck), qck);
+            if (ret) return 1;
+          }
+        }
+        if (join->plan_cache_exec_context->quick_used_key_parts !=
+            get_used_key_parts(qck))
+          return 1;
         qt->set_range_scan(qck);
         qt->set_type(calc_join_type(qck));
       } else
diff --git a/sql/sql_plan_cache.h b/sql/sql_plan_cache.h
index 8801fe0d51f..778825c39a8 100644
--- a/sql/sql_plan_cache.h
+++ b/sql/sql_plan_cache.h
@@ -59,6 +59,8 @@ struct Exec_context {
       OPTIMIZER_SWITCH_HYPERGRAPH_OPTIMIZER;
 
   Key_map quick_keys_map{0};
+  bool index_range_scan_is_reverse{false};
+  uint quick_used_key_parts{0};
   Temp_table_param *tmp_table_param{nullptr};
   ulonglong optimizer_switch{0};
   const CHARSET_INFO *character_set_client;
