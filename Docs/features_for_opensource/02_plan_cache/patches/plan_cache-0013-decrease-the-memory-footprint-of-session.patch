 mysql-test/r/session_plan_cache.result        | 185 ++++++++++++++++++
 mysql-test/r/session_plan_cache_debug.result  |   7 +
 .../dstore_main/r/session_plan_cache.result   | 175 +++++++++++++++++
 .../r/session_plan_cache_debug.result         |   8 +
