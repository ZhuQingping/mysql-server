@@ -878,7 +887,9 @@ insert into tbl1 values(1,'02:59:59.000000'),(2,'00:00:00.000000'),(3,'24:59:59.
 # If you want to study this test, first grep for BUGFIX further down.
 prepare stmt from "SELECT time_col FROM tbl1 WHERE time_col = ? limit 10";
 set @col3='02:59:59.000000';execute stmt USING @col3;
