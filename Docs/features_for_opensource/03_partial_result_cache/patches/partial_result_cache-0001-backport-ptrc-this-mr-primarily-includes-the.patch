+  auto rec_size =
+      record_buffer ? record_buffer->record_size() : prebuilt->mysql_row_len;
+  UNIV_MEM_INVALID(buf, rec_size);
+
+  auto tbl = prebuilt->m_mysql_table;
+  if (tbl) {
+    auto sz = std::min<size_t>(tbl->s->null_bytes, rec_size);
+    if (sz) {
+      /*
+        The first bytes of 'buf' represent the "NULL bytes", one bit for each
+        nullable column. But for a non-nullable column, its bit will never be
+        set. However, hash join code hashes NULL bytes, including such bit
+        (see StoreFromTableBuffers()). This is also true for bits of
+        non-existent columns (like if there are 7 columns, the 8th bit is
+        never set). For repeatability of hashing, and silencing of Valgrind,
+        we set those "phantom bits" to 0 once for all.
+      */
+      memset(buf, '\0', sz);
+    }
+  }
 
