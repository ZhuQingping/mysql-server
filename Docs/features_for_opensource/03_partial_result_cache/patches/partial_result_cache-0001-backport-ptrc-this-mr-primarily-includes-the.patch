+CREATE VIEW `t0_sub_1` AS select `t0`.`c_id` AS `c_d_id`,`t0`.`c_d_id` AS
+  `c_id`,(case when ((`t0`.`c_w_id` / 2) = 0) then 1 else 2 end) AS
+  `c_w_id`,`t0`.`c_middle` AS `c_middle`,`t0`.`c_street_1` AS
+  `c_street_1`,`t0`.`c_credit` AS `c_credit` from `t0` FORCE INDEX (PRIMARY)
+  where ((`t0`.`c_id` = 1) or (`t0`.`c_d_id` = 2) or (`t0`.`c_w_id` = 3));
+ANALYZE TABLE t10, t12, t0;
+let $query = SELECT 1
+FROM
+  (SELECT ref_0.C_STATE AS c0,
+          pi() AS c1
+   FROM t10 AS ref_0
+   WHERE EXISTS
+       (SELECT ref_0.C_D_ID AS c1,
+               ref_2.c1 AS c8
+        FROM
+          (SELECT `subq_0`.`c4` AS `c1`
+           FROM (
+                   (SELECT `ref_0`.`C_BIT` AS `c4`
+                    FROM `t10` `ref_0`
+                    WHERE (`ref_0`.`C_YTD_PAYMENT` IS NOT NULL)) `subq_0`
+                 LEFT JOIN
+                   (SELECT `ref_3`.`C_FIRST` AS `c0`
+                    FROM (`t12` `ref_1`
+                          JOIN `t10` `ref_3` on(TRUE))
+                    WHERE FALSE) `subq_1` on(FALSE))
+           GROUP BY `subq_0`.`c4`,
