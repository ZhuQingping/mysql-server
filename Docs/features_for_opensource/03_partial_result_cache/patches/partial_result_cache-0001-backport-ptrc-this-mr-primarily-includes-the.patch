+void Opt_hints_qb::apply_ptrc_hints(JOIN *join, table_map *force_tab_map,
+                                    table_map *ignore_tab_map,
+                                    bool *force_subquery_ptrc,
+                                    bool *force_no_subquery_ptrc,
