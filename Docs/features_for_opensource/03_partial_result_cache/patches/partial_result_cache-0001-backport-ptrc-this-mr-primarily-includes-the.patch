+void Item_subselect::get_item_params(const THD *,
+                                     Dependent_item_params *params) {
+  /*
+    We are looking into this subquery for an outer reference. The test on
+    nest_level is necessary in case of deep nesting:
+    SELECT #1 (SELECT #2 (SELECT #3 t2.a+t1.a FROM t3) FROM t2) FROM t1
+    imagine we are setting up PTRC to cache the result of #2. We walk #2
+    to find references to #1 (cache keys). These may be in #3 too, so the
+    walk uses WALK_SUBQUERY. When we are in #3, we find t2.a ; as it is an
+    outer reference it has depended_from!=0 (==#2). But we must not
+    collect it, as it is not outer _to_#2_.
+
+    IN(subquery) deserves a special discussion. In something like
+
+    (t1.col+(SELECT t1.col2 FROM ..)) IN (SELECT ...),
+
+    assuming we want to cache the result of IN, t1.col and t1.col2 must be
+    found as "cache keys". Item_in_subselect::walk() will travel left_expr and
+    Item_subselect; its walk on left_expr will look for references which are
+    higher-up than the subquery's unit, thus will find t1.col2 and t1.col1.
+  */
+  WalkItem(this, enum_walk::PREFIX | enum_walk::SUBQUERY,
+           [params](Item *item_inner) {
+             Item *item = item_inner->real_item();
+             if (item->type() == Item::FIELD_ITEM) {
+               auto item_field = down_cast<Item_field *>(item);
+               /*
+                 This test is more reliable than depended_from, which is
+                 sometimes set only for Item_ref and not the underlying
+                 Item_field-s.
+               */
+               if (item_field->table_ref &&
+                   item_field->table_ref->query_block->nest_level <
+                       params->nest_level) {
+                 // Tables might come from father or grandfather etc.
+                 Query_block *sl = item_field->table_ref->query_block;
+                 Query_block *pl = params->first_select;
+                 while (pl) {
+                   if (pl != sl)
+                     pl = pl->outer_query_block();
+                   else
+                     break;
+                 }
+                 if (pl) params->parameters.insert(item_field->field);
+               }
+             }
+             return false;
+           });
+}
