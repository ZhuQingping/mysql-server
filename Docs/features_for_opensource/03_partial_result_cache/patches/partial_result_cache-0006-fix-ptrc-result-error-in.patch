@@ -778,3 +779,38 @@ INSERT INTO t2 SELECT * FROM t1;
 --replace_regex /time.* /time=# / /Memory Usage: [0-9]+ /Memory Usage: # / / \(cost.*//
 explain analyze select /*+ prc_join() */ ticket2.id FROM t2 as ttxt,t2 INNER JOIN t1 as ticket2 ON ticket2.id = t2.ticket WHERE ticket2.id = ticket2.ticket and match(ttxt.inhalt) against ('foobar');
 drop table t1,t2;
