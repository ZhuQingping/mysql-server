From d053c95e8613b2483603f369eb7cab68886b7c97 Mon Sep 17 00:00:00 2001
From: wangjin <wangjin53@contributor>

Date: Thu, 4 Dec 2025 20:44:37 +0800
Subject: [PATCH] fix PTRC result error in
 parallel_query.pq_reverse_index_scan
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Issue:
Execute parallel_query.pq_reverse_index_scan; the serial/parallel results are
inconsistent with those of community version 8.0.41.
 select * from t2, t1 force index(`a`) having c < 3 order by a, b limit 10;
 d      a       b       c
@@ -325,11 +319,11 @@
 3      1       1       2
 4      1       1       2
 5      1       1       2
-5      1       1       2
-4      1       1       2
-3      1       1       2
-2      1       1       2
 1      1       1       2
+2      1       1       2
+3      1       1       2
+4      1       1       2
+5      1       1       2

Analysis:
It was confirmed to be caused by PTRC. The PQ branch enables PTRC by default,
and if this feature is disabled the results are consistent with the community
version.
The root cause lies in the HashJoinRowBuffer::StoreRow function, where different
rows with the same key are inserted into the singly linked list corresponding to
that key from the head. After a ptrc key match, however, rows are read from head
to tail. This results in rows that were originally later being read first,
causing the returned row order to differ from the case without ptrc matching. If
a LIMIT is applied to restrict the number of rows, this may lead to inconsistent
results.

Fix:
To ensure that the time complexity of inserting a row in the
HashJoinRowBuffer::StoreRow function is O(1), the tail node is cached for each
key, and insertion logic based on the tail node is added to
HashJoinRowBuffer::StoreRow. In addition, to avoid affecting non‑PTRC scenarios,
the HashMap definition was not modified; instead, a new HashMap was introduced
to store the tail node of the linked list corresponding to each key.
---
 .../suite/ptrc/r/partial_result_cache.result  | 26 +++++++++
 .../suite/ptrc/t/partial_result_cache.test    | 36 ++++++++++++
 sql/iterators/hash_join_buffer.cc             | 56 +++++++++++++++++--
 sql/iterators/hash_join_buffer.h              | 13 ++++-
 sql/partial_result_cache.cc                   |  2 +-
 5 files changed, 126 insertions(+), 7 deletions(-)

diff --git a/mysql-test/suite/ptrc/r/partial_result_cache.result b/mysql-test/suite/ptrc/r/partial_result_cache.result
index 13667e19943..780c68d4e8d 100644
--- a/mysql-test/suite/ptrc/r/partial_result_cache.result
+++ b/mysql-test/suite/ptrc/r/partial_result_cache.result
@@ -3647,3 +3647,29 @@ EXPLAIN
         -> Covering index lookup on t2 using tig (ticket=ticket2.id) 
 
 drop table t1,t2;
+create table t1 (a int, b int, c int, key(a desc, b asc, c desc));
+create table t2 (d int, key(d asc));
+explain format=tree select * from t2, t1 force index(`a`) having c < 3 order by a, b limit 10;
+EXPLAIN
+-> Limit: 10 row(s)  (...)
+    -> Nested loop inner join  (...)
+        -> Sort: t1.a, t1.b  (...)
+            -> Filter: (t1.c < 3)  (...)
+                -> Index scan on t1 using a  (...)
+        -> Result cache : cache keys(t1.a, t1.b, t1.c)  (...)
+            -> Index scan on t2 using d  (...)
+
+select * from t2, t1 force index(`a`) having c < 3 order by a, b limit 10;
+d	a	b	c
+1	1	1	2
+2	1	1	2
+3	1	1	2
+4	1	1	2
+5	1	1	2
+1	1	1	2
+2	1	1	2
+3	1	1	2
+4	1	1	2
+5	1	1	2
+drop table t1;
+drop table t2;
