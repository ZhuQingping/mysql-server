diff --git a/storage/dstore/dml/cde_dml.cc b/storage/dstore/dml/cde_dml.cc
index 8ec1e5c5374..722cc29f40c 100644
--- a/storage/dstore/dml/cde_dml.cc
+++ b/storage/dstore/dml/cde_dml.cc
@@ -1020,7 +1020,8 @@ int cde_dml_api::ReadIndexOnly(cde_isolation_level_t isolationLevel, uchar *buf,
     dstoreHandler->dstore_heap_ctid = itup->GetHeapCtid();
 
     /* handle locking read */
-    if (dstoreHandler->select_lock_type != LOCK_NONE) {
+    if (dstoreHandler->select_lock_type != LOCK_NONE &&
+        !dstoreHandler->table_handler->is_temporary()) {
       if (dstoreHandler->sql_stat_start) {
         if (CdeLockTable(
                 dstoreHandler->select_lock_type == LOCK_S ? LOCK_IS : LOCK_IX,
@@ -1040,8 +1041,7 @@ int cde_dml_api::ReadIndexOnly(cde_isolation_level_t isolationLevel, uchar *buf,
       int error = CdeLockTuple(isolationLevel, snapShotData,
                                dstoreHandler->rel_info->rd_storage_releation,
                                &ctid, &tuple, needWait);
-      if (error != CDE_OK || tuple == nullptr) {
-        TupleInterface::DestroyTuple(tuple, CdeFreeMemForDtuple);
+      if (error != CDE_OK) {
         if (error == HA_ERR_RECORD_DELETED) {
           continue;
         }
@@ -1053,6 +1053,7 @@ int cde_dml_api::ReadIndexOnly(cde_isolation_level_t isolationLevel, uchar *buf,
         return error;
       }
 
+      CDE_ASSERT(tuple != nullptr);
       TupleInterface::DestroyTuple(tuple, CdeFreeMemForDtuple);
       tuple = nullptr;
     }
@@ -1189,7 +1190,7 @@ int cde_dml_api::ReadFullRow(cde_isolation_level_t isolationLevel, uchar *buf,
       int error = CdeLockTuple(isolationLevel, snapShotData,
                                dstore_handler->rel_info->rd_storage_releation,
                                extremeCtid, &tuple, needWait);
-      if (error != CDE_OK || tuple == nullptr) {
+      if (error != CDE_OK) {
         TupleInterface::DestroyTuple(tuple, CdeFreeMemForDtuple);
         tuple = nullptr;
         if (error == HA_ERR_RECORD_DELETED) {
@@ -1210,6 +1211,7 @@ int cde_dml_api::ReadFullRow(cde_isolation_level_t isolationLevel, uchar *buf,
         return error;
       }
 
+      CDE_ASSERT(tuple != nullptr);
       if (ha->skip_row_for_offset_pushdown()) {
         ha->increment_scanned_offset();
         TupleInterface::DestroyTuple(tuple, CdeFreeMemForDtuple);
