+`c6` time /*!50606 STORAGE MEMORY */ DEFAULT NULL /*!80023 INVISIBLE */ COMMENT 'asdf',
+`vc7` year GENERATED ALWAYS AS (coalesce(`c0`,0)) STORED,
+`c8` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP /*!80023 INVISIBLE */,
+`vc9` varchar(500) GENERATED ALWAYS AS (coalesce(cast(`c0` as char(30) charset utf8mb4),_utf8mb4'default')) STORED,
+UNIQUE KEY `i1` ((_utf8mb4'2004-02-17 00:33:28')) USING BTREE,
+UNIQUE KEY `i2` ((_utf8mb4'1970-01-01 01:00:00'),(-(1755512592))),
+UNIQUE KEY `i5` ((_utf8mb4'T_')) /*!80000 INVISIBLE */,
