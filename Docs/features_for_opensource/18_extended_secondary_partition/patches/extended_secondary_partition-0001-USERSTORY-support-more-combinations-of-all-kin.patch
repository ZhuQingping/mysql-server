+ (SUBPARTITION p0 VALUES IN (1,2) ENGINE = InnoDB,
+  SUBPARTITION p1 VALUES IN (3,4) ENGINE = InnoDB,
+  SUBPARTITION p2 VALUES IN (5,6) ENGINE = InnoDB),
+ PARTITION dp1
