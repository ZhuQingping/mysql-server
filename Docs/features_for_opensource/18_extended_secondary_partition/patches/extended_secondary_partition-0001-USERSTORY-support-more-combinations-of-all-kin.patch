+--error 1
+--exec $MYSQLD_CMD --datadir=$DDIR --no-console --log-error=$MYSQLD_LOG --debug=+d,force_taurus_dd_version_upgrade,dd_version_upgrade_test,upgrade_version_set_fail
+
