+static bool check_alter_part_table(const THD *thd, const Alter_info *alter_info,
+                                   const partition_info *part_info,
+                                   const partition_info *tab_part_info) {
+  assert(part_info);
+  if (part_info->part_type != tab_part_info->part_type &&
+      part_info->part_type != partition_type::NONE) {
+    /*
+      Hash partitions can be altered without parser finds out about
+      that it is HASH partitioned. So no error here.
+    */
+    if (part_info->part_type == partition_type::RANGE) {
+      my_error(ER_PARTITION_WRONG_VALUES_ERROR, MYF(0), "RANGE", "LESS THAN");
+    } else if (part_info->part_type == partition_type::LIST) {
+      assert(part_info->part_type == partition_type::LIST);
+      my_error(ER_PARTITION_WRONG_VALUES_ERROR, MYF(0), "LIST", "IN");
+    } else if (tab_part_info->part_type == partition_type::RANGE) {
+      my_error(ER_PARTITION_REQUIRES_VALUES_ERROR, MYF(0), "RANGE",
+               "LESS THAN");
+    } else {
+      assert(tab_part_info->part_type == partition_type::LIST);
+      my_error(ER_PARTITION_REQUIRES_VALUES_ERROR, MYF(0), "LIST", "IN");
+    }
+    goto err;
+  }
+  if (part_info->partitions.is_empty()) {
+    if (tab_part_info->part_type == partition_type::RANGE) {
+      my_error(ER_PARTITIONS_MUST_BE_DEFINED_ERROR, MYF(0), "RANGE");
+      goto err;
+    } else if (tab_part_info->part_type == partition_type::LIST) {
+      my_error(ER_PARTITIONS_MUST_BE_DEFINED_ERROR, MYF(0), "LIST");
+      goto err;
+    }
+  }
+  if ((tab_part_info->column_list &&
+       part_info->num_columns != tab_part_info->num_columns) ||
+      (!tab_part_info->column_list &&
+       (tab_part_info->part_type == partition_type::RANGE ||
+        tab_part_info->part_type == partition_type::LIST) &&
+       part_info->num_columns != 1U) ||
+      (!tab_part_info->column_list &&
+       tab_part_info->part_type == partition_type::HASH &&
+       part_info->num_columns != 0)) {
+    my_error(ER_PARTITION_COLUMN_LIST_ERROR, MYF(0));
+    goto err;
+  }
+  if (alter_info->flags & Alter_info::ALTER_ADD_PARTITION) {
+    /*
+      We allow quite a lot of values to be supplied by defaults, however we
+      must know the number of new partitions in this case.
+    */
+    if (thd->lex->no_write_to_binlog &&
+        tab_part_info->part_type != partition_type::HASH) {
+      my_error(ER_NO_BINLOG_ERROR, MYF(0));
+      goto err;
+    }
+    if (tab_part_info->defined_max_value) {
+      my_error(ER_PARTITION_MAXVALUE_ERROR, MYF(0));
+      goto err;
+    }
+    if (part_info->is_subpart_info()) {
+      if (part_info->num_parts != tab_part_info->num_parts) {
+        my_error(ER_ADD_PARTITION_SUBPART_ERROR, MYF(0));
+        goto err;
+      }
+    }
+  }
+  return false;
+err:
+  return true;
+}
+
+/*
+  Remove subpartitions for one partition as well as Subpartition.
+
+  @param[in] thd Pointer of THD
+  @param[in] sub_part_info sub partition info
+  @param[in/out] part_it Iterator for sub_partitions
+  @param[in/out] sub_it Iterator for Subpartition
+  @param[in] main_part_id index of current main partition
+  @param[in] is_first True means to remove all of subpartitions of first
+  main partition.
+
+  @retval True means error happens. Otherwise false.
+*/
+static bool remove_sub_partitions(const THD *thd, partition_info *sub_part_info,
+                                  List_iterator<partition_element> &part_it,
+                                  List_iterator<Sub_partition> &sub_it,
+                                  uint main_part_id, bool is_first) {
+  if (!(sub_part_info && sub_part_info->get_parent()->is_sub_partitioned()))
+    return false;
+  uint num_parts = sub_part_info->num_parts;
+  do {
+    part_it.remove();
+    part_it++;
+  } while (--num_parts > 0);
+  // Replace the first subpartitions
+  if (is_first) {
+    Sub_partition *sub = new (thd->mem_root) Sub_partition(
+        down_cast<sub_partition_info *>(sub_part_info), main_part_id);
+    if (!sub) return true;
+    sub_it.replace(sub);
+  } else {
+    sub_it.remove();
+  }
+  return false;
+}
+
+/*
+  Move iterator to the subpartition position for next partition.
+
+  @param[in] sub_part_info sub partition info
+  @param[in/out] part_it Iterator for sub_partitions
+  @param[in/out] prev_part_it Iterator used to append sub_partitions after it
+
+  @retval void
+*/
+static void advance_sub_partitions(
+    partition_info *sub_part_info, List_iterator<partition_element> &part_it,
+    List_iterator<partition_element> &prev_part_it) {
+  if (!(sub_part_info && sub_part_info->get_parent()->is_sub_partitioned()))
+    return;
+  uint num_parts = sub_part_info->num_parts;
+  do {
+    prev_part_it++;
+    part_it++;
+  } while (--num_parts > 0);
+}
+
+/*
+  Append subpartitions to sub_partition_info::partitions after the removed
+  partition.
+
+  @param[in] sub_part_info sub partition info
+  @param[in] subpartitions sub-partitions which should be appended after
+  prev_part_it
+  @param[in/out] part_it Iterator for sub_partitions
+  @param[in/out] prev_part_it Iterator used to append sub_partitions after it
+  @param[in/out] sub_it Iterator for Subpartition
+  @param[in] main_part_id index of current main partition
+  @param[in] is_first True means first sub-partition to append.
+
+  @retval True means error happens. Otherwise false.
+*/
+static bool append_sub_partitions(
+    const THD *thd, partition_info *sub_part_info,
+    List<partition_element> &subpartitions,
+    List_iterator<partition_element> &part_it,
+    List_iterator<partition_element> &prev_part_it,
+    List_iterator<Sub_partition> &sub_it, uint main_part_id, bool is_first) {
+  if (!(sub_part_info && sub_part_info->get_parent()->is_sub_partitioned()))
+    return false;
+  uint num_parts = sub_part_info->num_parts;
+  List_iterator<partition_element> sub_part_it(subpartitions);
+  uint j = 0;
+  part_it = prev_part_it;
+  do {
+    partition_element *sub_part_elem = sub_part_it++;
+    sub_part_elem->part_state = PART_TO_BE_ADDED;
+    if (prev_part_it.is_before_first()) {
+      sub_part_info->partitions.push_front(sub_part_elem);
+      part_it++;
+    } else
+      part_it.after(sub_part_elem);
+    prev_part_it++;
+  } while (++j < num_parts);
+  part_it++;
+
+  if (!is_first) {
+    Sub_partition *sub = new (thd->mem_root) Sub_partition(
+        down_cast<sub_partition_info *>(sub_part_info), main_part_id);
+    if (!sub) return true;
+    sub_it.after(sub);
+  }
+
+  return false;
+}
+
+static bool create_subpart_info(const THD *thd, partition_info *alt_part_info,
+                                partition_info *tab_part_info) {
+  assert(tab_part_info->is_sub_partitioned());
+  sub_partition_info *sub_clone =
+      new (thd->mem_root) sub_partition_info(alt_part_info);
+  if (!sub_clone) return true;
+  alt_part_info->sub_part_info = sub_clone;
+  alt_part_info->sub_part_info->part_type =
+      tab_part_info->sub_part_info->part_type;
+  alt_part_info->sub_part_info->num_parts = tab_part_info->get_num_subparts();
+  alt_part_info->has_sub_part = true;
+  alt_part_info->sub_part_info->column_list =
+      tab_part_info->sub_part_info->column_list;
+  return false;
+}
