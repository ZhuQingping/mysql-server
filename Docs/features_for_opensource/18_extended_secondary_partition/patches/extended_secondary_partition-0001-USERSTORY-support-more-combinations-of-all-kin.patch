+
+void partition_info::fix_subs_val_array_pointers() {
+  assert(is_sub_partitioned());
+
+  uint i = 0;
+  if (partition.subpartitions.is_empty()) return;
+  List_iterator<Sub_partition> it(partition.subpartitions);
+  do {
+    Sub_partition *sub_part = it++;
+    // Here we need reset index because Alter table might mess the part_id
+    // during remove and append subpartition operation.
+    sub_part->index = i;
+    sub_part->fix_val_array_pointer();
+  } while (++i < num_parts);
+}
+
+void Sub_partition::fix_val_array_pointer() {
+  uint num_cols = 1;
+  if (part_info->column_list) num_cols = part_info->part_field_list.elements;
+  uint offset = index * part_info->num_parts * num_cols;
+  if (part_info->part_type == partition_type::RANGE) {
+    if (part_info->column_list)
+      range_col_array = part_info->range_col_array + offset;
+    else
+      range_int_array = part_info->range_int_array + offset;
+  }
+};
+
+Sub_partition *Sub_partition::clone(THD *thd, uint part_id, bool reset) {
+  Sub_partition *clone = new (thd->mem_root) Sub_partition(*this);
+  if (!clone || DBUG_EVALUATE_IF("sub_partition_clone_failed", true, false)) {
+    mem_alloc_error(sizeof(Sub_partition));
+    return nullptr;
+  }
+
+  if (reset) {
+    range_int_array = nullptr;
+    list_array = nullptr;
+    range_col_array = nullptr;
+    list_col_array = nullptr;
+    num_list_values = 0;
+    has_null_value = false;
+    has_null_part_id = 0;
+    index = part_id;
+  }
+  return clone;
+}
+
+void sub_partition_info::fix_val_array_pointer(int sub_id) {
+  Sub_partition *sub_part = m_parent->partition.subpartitions[sub_id];
+  range_int_array = sub_part->range_int_array;
+  list_array = sub_part->list_array;
+  range_col_array = sub_part->range_col_array;
+  list_col_array = sub_part->list_col_array;
+  defined_max_value = sub_part->defined_max_value;
+  if (part_type == partition_type::LIST) {
+    num_list_values = sub_part->num_list_values;
+    has_null_value = sub_part->has_null_value;
+    has_null_part_id = sub_part->has_null_part_id;
+  }
+}
+
+/*
+  1. If rds_extended_partitions_enabled = 0,
+  - partition tables are valid, including range / list / key / hash.
+  - some subpartition tables are valid, including range-hash / range-key /
+      list-key / list-hash
+  - some subpartition tables are invalid, including
+      key-key/key-hash/key-range/key-list/
+      hash-hash/hash-key/hash-range/hash-list
+
+  2. If rds_extended_partitions_enabled = 1,
+  - partition table are valid, incluing range / list / key / hash.
+  - all supartition tables are valid, including
+      range-hash/range-key
+      list-key/list-hash
+      key-key/key-hash/key-range/key-list
+      hash-hash/hash-key/hash-range/hash-list
+*/
+bool validate_partition_type(partition_info *part_info) {
+  if (part_info && part_info->is_sub_partitioned() &&
+      !extended_partitions_enabled &&
+      (part_info->part_type == partition_type::HASH ||
+       part_info->sub_part_info->part_type != partition_type::HASH)) {
+    return false;
+  }
+  return true;
+}
