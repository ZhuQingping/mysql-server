From e9f2cfcb48d55d8ec98e2fe540476ace253aee36 Mon Sep 17 00:00:00 2001
From: xuemengjiao <xuemengjiao@contributor>


Date: Fri, 20 Mar 2026 14:44:35 +0800
Subject: [PATCH] BUGFIX when subpartition type is list/range and no
 define part_def, mysqld crashed.

Problem:
When create subpartition table and subpartition type is list/range, but no define part definition,
mysqld crash at fix_parser_data function becuase part_elem is nullptr.

Fix:

In PT_partition::contextualize function, when part_defs is nullptr, if there are subpartitions
and the subpartition types are RANGE and LIST partitioning, an error is reported.
---
 .../r/subpartition_bugfix-dstore.result       | 114 ++++++++++++++++
 .../t/subpartition_bugfix-dstore.test         | 128 ++++++++++++++++++
 .../suite/parts/r/subpartition_bugfix.result  | 114 ++++++++++++++++
 .../parts/r/subpartition_bugfix.result-pq     | 114 ++++++++++++++++
 .../suite/parts/t/subpartition_bugfix.test    | 128 ++++++++++++++++++
 sql/parse_tree_partitions.cc                  |  17 +++
 sql/partition_info.cc                         |  12 +-
 7 files changed, 626 insertions(+), 1 deletion(-)

diff --git a/mysql-test/suite/dstore_parts/r/subpartition_bugfix-dstore.result b/mysql-test/suite/dstore_parts/r/subpartition_bugfix-dstore.result
index d640c8e912f..e64265d457d 100644
--- a/mysql-test/suite/dstore_parts/r/subpartition_bugfix-dstore.result
+++ b/mysql-test/suite/dstore_parts/r/subpartition_bugfix-dstore.result
@@ -647,4 +647,118 @@ subpartition sub3 values in (2000),
 subpartition sub4 values in (2002)));
 ERROR HY000: It only supports to mix RANGE/LIST partitioning with HASH/KEY partitioning for subpartitioning when rds_extended_partitions_enabled is disabled.
 DROP DATABASE test1;
+#
+# BUGFIX : subpartition typs is list or range and not define part_def and mysql will crashed.
+#
+use test;
+set global rds_extended_partitions_enabled = off;
