+/* -------------------------------------------------------------------------
+ * Helper: obtain the current CPU context via getcontext(3).
+ * Safe to call outside a signal handler.
+ * ---------------------------------------------------------------------- */
+static int capture_context(ucontext_t *uc) { return getcontext(uc); }
+
